<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/title_container"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.dux.text.DuxTextView
            android:textSize="13sp"
            android:textColor="@color/TextTertiary"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.bytedance.dux.image.DuxImageView
            android:id="@+id/iv_title_icon"
            android:visibility="gone"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:src="@drawable/dux_ic_required"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/prefix_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/et_input"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/et_input"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="15sp"
        android:textColor="@color/TextPrimary"
        android:textColorHint="@color/TextQuaternary"
        android:id="@+id/et_input"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:cursorVisible="true"
        android:textCursorDrawable="@drawable/dux_form_cursor"
        android:layout_marginEnd="17dp"
        app:layout_constraintEnd_toStartOf="@+id/iv_clear"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/prefix_container"
        app:layout_constraintTop_toBottomOf="@+id/title_container"
        app:layout_goneMarginEnd="0dp"
        app:layout_goneMarginStart="0dp"
        app:layout_goneMarginTop="0dp"/>
    <com.bytedance.dux.image.DuxImageView
        android:id="@+id/iv_clear"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/dux_ic_close_full"
        android:layout_marginEnd="17dp"
        app:layout_constraintBottom_toBottomOf="@+id/et_input"
        app:layout_constraintEnd_toStartOf="@+id/iv_action"
        app:layout_constraintTop_toTopOf="@+id/et_input"
        app:layout_goneMarginEnd="0dp"/>
    <com.bytedance.dux.image.DuxImageView
        android:id="@+id/iv_action"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_s_s_scan_outlined"
        android:layout_marginEnd="17dp"
        app:layout_constraintBottom_toBottomOf="@+id/et_input"
        app:layout_constraintEnd_toStartOf="@+id/tv_action"
        app:layout_constraintTop_toTopOf="@+id/et_input"
        app:layout_goneMarginEnd="0dp"/>
    <com.bytedance.dux.text.DuxTextView
        android:textSize="15sp"
        android:textColor="@color/TextTertiary"
        android:id="@+id/tv_action"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="17dp"
        app:layout_constraintBottom_toBottomOf="@+id/et_input"
        app:layout_constraintEnd_toEndOf="@+id/suffix_container"
        app:layout_constraintTop_toTopOf="@+id/et_input"
        app:layout_goneMarginEnd="0dp"/>
    <RelativeLayout
        android:id="@+id/suffix_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/et_input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/et_input"/>
    <com.bytedance.dux.divider.DuxDivider
        android:id="@+id/divider"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:dividerStyle="primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_input"/>
    <com.bytedance.dux.text.DuxTextView
        android:textSize="11sp"
        android:textColor="@color/Negative"
        android:id="@+id/tv_error_tips"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_counter"
        app:layout_constraintStart_toStartOf="@+id/divider"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
    <com.bytedance.dux.text.DuxTextView
        android:textSize="11sp"
        android:textColor="@color/TextQuaternary"
        android:id="@+id/tv_input_tips"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="@+id/divider"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
    <com.bytedance.dux.text.DuxTextView
        android:textSize="12sp"
        android:textColor="@color/TextQuaternary"
        android:layout_gravity="end"
        android:id="@+id/tv_counter"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
</merge>
