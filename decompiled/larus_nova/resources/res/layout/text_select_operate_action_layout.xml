<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="36dp">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/static_white"
        android:id="@+id/image_ocr_selection_action_name"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Lark_IM_ImageToText_Copy_Button_Mobile"
        android:includeFontPadding="false"/>
    <View
        android:id="@+id/image_ocr_selection_action_split"
        android:background="@color/static_white_20"
        android:layout_width="0.5dp"
        android:layout_height="36dp"
        android:layout_centerHorizontal="true"/>
</LinearLayout>
