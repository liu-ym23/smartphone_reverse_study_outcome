<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="32dp">
    <com.facebook.drawee.view.SimpleDraweeView
        android:layout_gravity="start"
        android:id="@+id/banner_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:id="@+id/banner_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <android.widget.Space
            android:id="@+id/left_safe_area"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"/>
        <HorizontalScrollView
            android:id="@+id/banner_scroll_view"
            android:scrollbars="none"
            android:clickable="false"
            android:longClickable="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toLeftOf="@+id/right_safe_area"
            android:layout_toRightOf="@+id/left_safe_area"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/right_safe_area"
            android:layout_toEndOf="@+id/left_safe_area">
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/banner_scroll_content"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <com.bytedance.android.live.core.widget.HSImageView
                    android:id="@+id/banner_user_honor_badge"
                    android:layout_width="30dp"
                    android:layout_height="14dp"
                    android:layout_marginRight="4dp"
                    android:layout_marginEnd="4dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:id="@+id/banner_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
            </LinearLayout>
        </HorizontalScrollView>
        <android.widget.Space
            android:id="@+id/right_safe_area"
            android:layout_width="26dp"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/clickable_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
