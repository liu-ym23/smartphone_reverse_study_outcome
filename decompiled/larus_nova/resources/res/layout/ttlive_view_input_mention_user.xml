<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/mention_user_avatar_container"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:layout_constraintBottom_toTopOf="@+id/mention_user_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.livesdk.widget.TransparentCircleIconView
            android:id="@+id/mention_user_avatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:circleCenterLeftMargin="48dp"
            app:circleCenterTopMargin="48dp"
            app:placeholderImage="@drawable/my_live_default_avatar"
            app:roundAsCircle="true"/>
        <ImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/mention_user_active"
            android:visibility="visible"
            android:layout_width="16dp"
            android:layout_height="16dp"/>
        <ImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/mention_user_selected"
            android:background="@drawable/ttlive_mention_user_checked_icon"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"/>
    </FrameLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="#161823"
        android:id="@+id/mention_user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mention_user_avatar_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
