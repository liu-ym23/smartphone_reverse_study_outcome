<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/container"
    android:clipChildren="false"
    android:layout_width="68dp"
    android:layout_height="72dp">
    <FrameLayout
        android:clipChildren="false"
        android:layout_width="48dp"
        android:layout_height="48dp">
        <TextView
            android:textSize="9dp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center_horizontal"
            android:layout_gravity="end|top"
            android:id="@+id/limit_text"
            android:background="@drawable/ttlive_bg_time_limit"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginTop="-7dp"
            android:layout_marginRight="-4dp"
            android:text="@string/time_limit"
            android:layout_marginEnd="-4dp"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/panel_action_btn"
            android:layout_width="48dp"
            android:layout_height="48dp"/>
        <ImageView
            android:layout_gravity="end|top"
            android:id="@+id/red_dot"
            android:visibility="gone"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:src="@drawable/ttlive_img_red_dot"/>
    </FrameLayout>
    <TextView
        android:textSize="11dp"
        android:textColor="#b3000000"
        android:gravity="center"
        android:id="@+id/panel_action_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
</LinearLayout>
