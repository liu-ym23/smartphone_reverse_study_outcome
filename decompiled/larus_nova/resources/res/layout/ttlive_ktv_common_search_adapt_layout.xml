<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.ktv.common.search.view.CommonSearchEnterView
        android:id="@+id/search_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toTopOf="@+id/feedback_container"
        app:layout_constraintTop_toTopOf="parent"
        app:search_enter_enable_font_scale="true"/>
    <com.bytedance.android.live.ktv.common.search.view.CommonSearchResultView
        android:id="@+id/search_result"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="60dp"
        app:layout_constraintBottom_toTopOf="@+id/feedback_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/feedback_container"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="12sp"
            android:textColor="#80ffffff"
            android:layout_gravity="center_vertical"
            android:id="@+id/search_go_feedback_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_ktv_search_panel_feedback_hint_1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#fe2c55"
            android:layout_gravity="center_vertical"
            android:id="@+id/search_go_feedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_ktv_search_panel_feedback_hint_2"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
