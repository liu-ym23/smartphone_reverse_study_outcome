<?xml version="1.0" encoding="utf-8"?>
<com.larus.profile.impl.view.ProfileEditPerfRootLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/edit_profile_cancel"
        android:paddingTop="?attr/larus_dp_18"
        android:paddingBottom="?attr/larus_dp_18"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_edit_bot_cancel"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_primary_50"
        android:id="@+id/edit_profile_confirm"
        android:paddingTop="?attr/larus_dp_18"
        android:paddingBottom="?attr/larus_dp_18"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_edit_bot_done"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/edit_profile_cancel"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/edit_profile_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_setting_profile_title"
        app:layout_constraintBottom_toBottomOf="@+id/edit_profile_cancel"
        app:layout_constraintEnd_toStartOf="@+id/edit_profile_confirm"
        app:layout_constraintStart_toEndOf="@+id/edit_profile_cancel"
        app:layout_constraintTop_toTopOf="@+id/edit_profile_cancel"/>
    <com.larus.bmhome.view.RoundAvatarImageView
        android:id="@+id/edit_profile_avatar"
        android:layout_width="?attr/larus_dp_110"
        android:layout_height="?attr/larus_dp_110"
        android:layout_marginTop="?attr/larus_dp_30"
        android:contentDescription="@string/larus_accessibility_profile_profilePhoto"
        app:avatar_placeholder="@drawable/larus_common_ui_avatar_placeholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_profile_title"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/edit_profile_avatar_icon"
        android:layout_width="?attr/larus_dp_32"
        android:layout_height="?attr/larus_dp_32"
        app:layout_constraintBottom_toBottomOf="@+id/edit_profile_avatar"
        app:layout_constraintEnd_toEndOf="@+id/edit_profile_avatar"
        app:srcCompat="@drawable/larus_ic_add_header"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/edit_profile_nickname_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_24"
        android:text="@string/larus_setting_profile_nickname_title"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintStart_toStartOf="@+id/edit_profile_username_editor"
        app:layout_constraintTop_toBottomOf="@+id/edit_profile_avatar"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="?attr/larus_sp_17"
        android:gravity="start|center_vertical"
        android:id="@+id/edit_profile_nickname_editor"
        android:background="@drawable/larus_bg_settings_edit_nickname"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginTop="?attr/larus_dp_8"
        android:hint="@string/larus_setting_profile_nickname_placeholder"
        android:maxLines="1"
        android:singleLine="true"
        android:maxLength="40"
        android:textAlignment="viewStart"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_56"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/edit_profile_nickname_title"
        style="@style/larus_EditTextStyle"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_17"
        android:gravity="start|center_vertical"
        android:id="@+id/edit_profile_nickname_display_only"
        android:background="@drawable/larus_bg_settings_edit_nickname"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:singleLine="true"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_56"
        app:layout_constraintBottom_toBottomOf="@+id/edit_profile_nickname_editor"
        app:layout_constraintEnd_toEndOf="@+id/edit_profile_nickname_editor"
        app:layout_constraintStart_toStartOf="@+id/edit_profile_nickname_editor"
        app:layout_constraintTop_toTopOf="@+id/edit_profile_nickname_editor"
        style="@style/larus_EditTextStyle"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/edit_profile_clear_nickname"
        android:paddingTop="?attr/larus_dp_18"
        android:paddingBottom="?attr/larus_dp_18"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_56"
        android:layout_height="?attr/larus_dp_56"
        android:contentDescription="@string/larus_accessibility_search_clearText"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/edit_profile_nickname_editor"
        app:layout_constraintEnd_toEndOf="@+id/edit_profile_nickname_editor"
        app:layout_constraintTop_toTopOf="@+id/edit_profile_nickname_editor"
        app:srcCompat="@drawable/larus_ic_name_edit_clear"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/edit_profile_nickname_error_hint_icon"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_14"
        android:layout_height="?attr/larus_dp_14"
        android:layout_marginTop="?attr/larus_dp_6"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintStart_toStartOf="@+id/edit_profile_nickname_editor"
        app:layout_constraintTop_toBottomOf="@+id/edit_profile_nickname_editor"
        app:srcCompat="@drawable/larus_ic_name_err_tip"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_13"
        android:textColor="@color/larus_danger_50"
        android:id="@+id/edit_profile_nickname_error_hint"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/larus_setting_profile_nickname_error"
        android:textAlignment="viewStart"
        android:layout_marginStart="?attr/larus_dp_4"
        app:layout_constraintBottom_toBottomOf="@+id/edit_profile_nickname_error_hint_icon"
        app:layout_constraintEnd_toEndOf="@+id/edit_profile_nickname_editor"
        app:layout_constraintStart_toEndOf="@+id/edit_profile_nickname_error_hint_icon"
        app:layout_constraintTop_toTopOf="@+id/edit_profile_nickname_error_hint_icon"
        app:layout_goneMarginStart="?attr/larus_dp_4"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/edit_profile_nickname_error_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="edit_profile_nickname_error_hint_icon, edit_profile_nickname_error_hint"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/edit_profile_username_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_30"
        android:text="@string/larus_setting_profile_username_title"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintStart_toStartOf="@+id/edit_profile_username_editor"
        app:layout_constraintTop_toBottomOf="@+id/edit_profile_nickname_editor"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="?attr/larus_sp_17"
        android:gravity="start|center_vertical"
        android:id="@+id/edit_profile_username_editor"
        android:background="@drawable/larus_bg_settings_edit_nickname"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginTop="?attr/larus_dp_8"
        android:hint="@string/larus_setting_profile_username_placeholder"
        android:maxLines="1"
        android:singleLine="true"
        android:maxLength="16"
        android:textAlignment="viewStart"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_56"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/edit_profile_username_title"
        style="@style/larus_EditTextStyle"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_17"
        android:gravity="start|center_vertical"
        android:id="@+id/edit_profile_username_display_only"
        android:background="@drawable/larus_bg_settings_edit_nickname"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:singleLine="true"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_56"
        app:layout_constraintBottom_toBottomOf="@+id/edit_profile_username_editor"
        app:layout_constraintEnd_toEndOf="@+id/edit_profile_username_editor"
        app:layout_constraintStart_toStartOf="@+id/edit_profile_username_editor"
        app:layout_constraintTop_toTopOf="@+id/edit_profile_username_editor"
        style="@style/larus_EditTextStyle"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/edit_profile_clear_username"
        android:paddingTop="?attr/larus_dp_18"
        android:paddingBottom="?attr/larus_dp_18"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_56"
        android:layout_height="?attr/larus_dp_56"
        android:contentDescription="@string/larus_accessibility_search_clearText"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/edit_profile_username_editor"
        app:layout_constraintEnd_toEndOf="@+id/edit_profile_username_editor"
        app:layout_constraintTop_toTopOf="@+id/edit_profile_username_editor"
        app:srcCompat="@drawable/larus_ic_name_edit_clear"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/edit_profile_username_available_icon"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/edit_profile_username_editor"
        app:layout_constraintEnd_toEndOf="@+id/edit_profile_username_editor"
        app:layout_constraintTop_toTopOf="@+id/edit_profile_username_editor"
        app:srcCompat="@drawable/larus_ic_username_available"/>
    <ProgressBar
        android:id="@+id/edit_profile_username_loading_icon"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:layout_marginEnd="?attr/larus_dp_16"
        android:indeterminateTint="@color/larus_neutral_50"
        app:layout_constraintBottom_toBottomOf="@+id/edit_profile_username_editor"
        app:layout_constraintEnd_toEndOf="@+id/edit_profile_username_editor"
        app:layout_constraintTop_toTopOf="@+id/edit_profile_username_editor"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_13"
        android:textColor="@color/larus_neutral_50"
        android:id="@+id/edit_profile_username_hint"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_4"
        android:text="@string/larus_setting_profile_username_tips"
        android:textAlignment="viewStart"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintEnd_toEndOf="@+id/edit_profile_username_editor"
        app:layout_constraintStart_toStartOf="@+id/edit_profile_username_editor"
        app:layout_constraintTop_toBottomOf="@+id/edit_profile_username_editor"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/edit_profile_username_error_hint_icon"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_14"
        android:layout_height="?attr/larus_dp_14"
        android:layout_marginTop="?attr/larus_dp_6"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintStart_toStartOf="@+id/edit_profile_username_editor"
        app:layout_constraintTop_toBottomOf="@+id/edit_profile_username_editor"
        app:srcCompat="@drawable/larus_ic_name_err_tip"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_13"
        android:textColor="@color/larus_danger_50"
        android:id="@+id/edit_profile_username_error_hint"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"
        android:layout_marginStart="?attr/larus_dp_4"
        app:layout_constraintBottom_toBottomOf="@+id/edit_profile_username_error_hint_icon"
        app:layout_constraintEnd_toEndOf="@+id/edit_profile_username_editor"
        app:layout_constraintStart_toEndOf="@+id/edit_profile_username_error_hint_icon"
        app:layout_constraintTop_toTopOf="@+id/edit_profile_username_error_hint_icon"
        app:layout_goneMarginStart="?attr/larus_dp_4"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/edit_profile_username_error_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="edit_profile_username_error_hint_icon, edit_profile_username_error_hint"/>
</com.larus.profile.impl.view.ProfileEditPerfRootLayout>
