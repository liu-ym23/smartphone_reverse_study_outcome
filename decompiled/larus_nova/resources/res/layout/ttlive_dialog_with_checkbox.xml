<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17sp"
        android:gravity="center_horizontal"
        android:id="@+id/main_title"
        android:paddingLeft="16dp"
        android:paddingTop="32dp"
        android:paddingRight="16dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        style="@style/ttlive_live_dialog_title"/>
    <TextView
        android:textSize="14sp"
        android:gravity="center"
        android:id="@+id/sub_title"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:includeFontPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        style="@style/ttlive_live_dialog_message"/>
    <CheckBox
        android:textColor="@color/ttlive_live_dialog_message"
        android:layout_gravity="center"
        android:id="@+id/live_dialog_check_box"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:text="不再提醒"
        style="@style/ttlive_open_platform_check_box_style"/>
</LinearLayout>
