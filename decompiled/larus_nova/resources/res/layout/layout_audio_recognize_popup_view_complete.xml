<?xml version="1.0" encoding="utf-8"?>
<com.ss.android.lark.keyboard.plugin.tool.voice.audio2.widget.AudioPopupBackground xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/audio_recognize_popup_view_bg"
    android:background="@color/bg_body_overlay"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/audio_recognize_popup_view_ai_recycler_view"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/UDText.Body2"
        android:id="@+id/audio_record_popup_view_duration_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/UDText.Body2"
        android:textColor="@color/text_placeholder"
        android:id="@+id/audio_recognize_popup_view_hint_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/Lark_IM_AudioMsg_TapHoldToRecord_Text"
        app:layout_constraintBottom_toTopOf="@+id/audio_recognize_popup_view_main_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.larksuite.component.universe_design.button.UDButton
        android:gravity="center"
        android:id="@+id/audio_recognize_popup_view_main_button"
        android:layout_width="108dp"
        android:layout_height="108dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:ud_backgroundColor="@color/function_info_content_pressed"
        app:ud_isRadiusAdjustBounds="true"
        app:ud_radius="round"/>
    <com.ss.android.lark.keyboard.plugin.tool.voice.audio2.widget.AudioRotatableButton
        android:id="@+id/audio_recognize_popup_view_cancel_button"
        android:visibility="gone"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:btn_iconZh="@drawable/ic_undo_outlined"
        app:btn_text="@string/Lark_IM_AudioToTextSelectLangugage_Cancel_Button"
        app:layout_constraintBottom_toBottomOf="@+id/audio_recognize_popup_view_main_button"
        app:layout_constraintEnd_toStartOf="@+id/audio_recognize_popup_view_main_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/audio_recognize_popup_view_main_button"/>
    <com.ss.android.lark.keyboard.plugin.tool.voice.audio2.widget.AudioRotatableButton
        android:id="@+id/audio_recognize_popup_view_send_button"
        android:visibility="gone"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        app:btn_iconColor="@color/ud_B500"
        app:btn_iconZh="@drawable/ud_icon_send_colorful"
        app:btn_text="@string/Lark_Legacy_Send"
        app:btn_textColor="@color/text_link_normal"
        app:layout_constraintBottom_toBottomOf="@+id/audio_recognize_popup_view_cancel_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/audio_recognize_popup_view_main_button"
        app:layout_constraintTop_toTopOf="@+id/audio_recognize_popup_view_cancel_button"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/UDText.Body2"
        android:textColor="@color/ud_N600"
        android:id="@+id/audio_recognize_popup_view_switch_language"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:drawablePadding="2dp"
        app:drawableEndCompat="@drawable/ud_icon_down_bold_outlined"
        app:drawableTint="@color/icon_n2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/audio_recognize_popup_view_main_button"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/audio_recognize_popup_view_delete_button"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="center"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/audio_recognize_popup_view_switch_language"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/audio_recognize_popup_view_switch_language"
        app:srcCompat="@drawable/ud_icon_delete_outlined"
        app:tint="@color/icon_n2"/>
</com.ss.android.lark.keyboard.plugin.tool.voice.audio2.widget.AudioPopupBackground>
