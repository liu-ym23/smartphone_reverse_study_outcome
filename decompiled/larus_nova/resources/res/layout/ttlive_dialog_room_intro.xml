<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_broadcast_pre_room_intro"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_std_text_black_1"
        android:gravity="center"
        android:id="@+id/title_view"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/ttlive_live_room_intro"
        android:includeFontPadding="false"
        android:alpha="0.7"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@color/ttlive_std_line_black_3"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_std_text_black_1"
            android:gravity="start|center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_live_room_intro_switch"
            android:includeFontPadding="false"
            android:layout_weight="1"/>
        <com.bytedance.android.uicomponent.compoundbutton.TranslucentSwitch
            android:theme="@style/ThemeOverlay.UiComponent.Switch.Light"
            android:id="@+id/switch_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <View
        android:background="@color/ttlive_std_line_black_3"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_intro"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_std_text_black_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_broadcast_room_intro_desc"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/image_view"
            android:background="@drawable/ttlive_bg_broadcast_room_intro_demo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:actualImageScaleType="fitCenter"
            app:placeholderImage="@drawable/ttlive_bg_broadcast_room_intro_demo"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_edit"
        android:paddingBottom="16dp"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:paddingTop="30dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/ttlive_avatar_view"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginRight="12dp"
                app:actualImageScaleType="fitXY"
                app:roundAsCircle="true"/>
            <com.bytedance.android.live.uikit.layout.WrapLineFlowLayout
                android:id="@+id/tags_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hSpacing="8dp"
                app:vSpacing="12dp"/>
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:src="@drawable/ttlive_broadcast_room_intro_edit_left"/>
            <ImageView
                android:layout_gravity="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:src="@drawable/ttlive_broadcast_room_intro_edit_right"
                android:scaleType="centerInside"/>
            <com.bytedance.android.livesdk.widget.TextCorrectionEditText
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_std_text_black_1"
                android:id="@+id/edit_view"
                android:background="@null"
                android:paddingBottom="20dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginRight="16dp"
                android:inputType="textMultiLine"
                android:imeOptions="actionDone"/>
            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_std_text_black_1"
                android:id="@+id/text_view"
                android:paddingBottom="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginRight="16dp"/>
        </FrameLayout>
        <com.bytedance.android.uicomponent.button.UIButton
            android:id="@+id/btn_submit"
            android:layout_width="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="16dp"
            android:text="@string/ttlive_save_and_update"
            style="@style/uicomponent_button_style_primary_l"/>
    </LinearLayout>
</LinearLayout>
