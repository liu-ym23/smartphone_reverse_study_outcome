<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_mg_star_atlas_agreement_dialog"
    android:padding="20dp"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/ttlive_v_mg_star_atlas_agreement_dialog_title"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#bf161823"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ttlive_v_mg_star_atlas_agreement_dialog_desc"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <CheckBox
            android:id="@+id/center_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            style="@style/ttlive_minigame_star_agreement_check_box"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#bf161823"
            android:gravity="center_vertical"
            android:id="@+id/agreement_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_v_mg_star_atlas_agreement_dialog_content"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <TextView
        android:textSize="15dp"
        android:textColor="#80ffffff"
        android:gravity="center"
        android:id="@+id/agree_btn"
        android:background="@drawable/ttlive_bg_mg_agree_star_altas_disable_btn"
        android:layout_width="240dp"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:text="@string/ttlive_v_mg_star_atlas_agreement_dialog_btn"/>
</LinearLayout>
