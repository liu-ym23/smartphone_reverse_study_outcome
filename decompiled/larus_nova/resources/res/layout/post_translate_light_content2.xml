<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/translate_root_view"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/translate_divider"
        android:background="@color/line_divider_default"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.ss.android.lark.chatbase.view.post.PostChatView
        android:id="@+id/translate_post"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/translate_divider"
        app:layout_goneMarginTop="0dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_caption"
        android:gravity="center"
        android:id="@+id/translation_feedback_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/Lark_Chat_TranslationFeedbackRateButton"
        android:includeFontPadding="false"
        android:drawablePadding="4.17dp"
        android:drawableEnd="@drawable/ic_svg_pointer2"
        android:layout_marginEnd="40dp"
        app:layout_constraintEnd_toStartOf="@+id/translate_more_action"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/translate_post"
        app:layout_goneMarginEnd="0dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/translate_more_action"
        android:padding="@dimen/dp_4"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/translation_feedback_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintTop_toTopOf="@+id/translation_feedback_tv"
        app:layout_goneMarginTop="24dp"
        app:srcCompat="@drawable/ud_icon_more_outlined"
        app:tint="@color/icon_n2"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/divider_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="translate_divider"/>
</androidx.constraintlayout.widget.ConstraintLayout>
