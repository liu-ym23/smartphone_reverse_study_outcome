<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="36dp">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/coupon_back_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/commerce_color_FE2C55"
            android:layout_gravity="center_vertical"
            android:id="@+id/coupon_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginStart="12dp"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/color_80161823"
            android:ellipsize="end"
            android:gravity="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:maxLines="1"
            android:drawableRight="@drawable/shopping_coupon_back_arrow"
            android:layout_weight="1"
            android:drawableEnd="@drawable/shopping_coupon_back_arrow"
            android:layout_marginEnd="8dp"/>
    </LinearLayout>
</merge>
