<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/dora_content"
    android:background="@color/larus_base_1_overlay"
    android:paddingLeft="?attr/larus_dp_24"
    android:paddingRight="?attr/larus_dp_24"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ScrollView
        android:id="@+id/dora_g_env_observe_auth_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="?attr/larus_dp_24"
        app:layout_constraintBottom_toTopOf="@+id/dora_g_env_observe_auth_private_btn_container"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/dora_g_env_observe_auth_img"
                android:layout_width="?attr/larus_dp_72"
                android:layout_height="?attr/larus_dp_72"
                android:src="@null"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/neutral_100"
                android:gravity="center"
                android:id="@+id/dora_g_env_observe_auth_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_20"
                android:text="@string/larus_dora_lab_environmental_observation_cn"
                android:textAlignment="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dora_g_env_observe_auth_img"/>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_16"
                android:textColor="@color/neutral_50"
                android:gravity="center"
                android:id="@+id/dora_g_env_observe_auth_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="?attr/larus_dp_16"
                android:layout_marginTop="?attr/larus_dp_12"
                android:layout_marginRight="?attr/larus_dp_16"
                android:text="@string/larus_dora_environmental_observation_onboarding_text_1_cn"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dora_g_env_observe_auth_title"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/dora_g_env_observe_auth_private_tips_container"
                android:background="@null"
                android:paddingLeft="?attr/larus_dp_16"
                android:paddingTop="?attr/larus_dp_16"
                android:paddingRight="?attr/larus_dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_40"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dora_g_env_observe_auth_desc">
                <com.larus.dora.impl.view.DoraTextView
                    android:textSize="?attr/larus_sp_15"
                    android:textColor="@color/neutral_100"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_environmental_observation_onboarding_privacy_title_cn"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_8">
                    <ImageView
                        android:layout_width="?attr/larus_dp_18"
                        android:layout_height="?attr/larus_dp_18"
                        android:src="@null"/>
                    <com.larus.dora.impl.view.DoraTextView
                        android:textSize="?attr/larus_sp_15"
                        android:textColor="@color/neutral_70"
                        android:gravity="center_vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_dora_environmental_observation_onboarding_privacy_text_1_cn"
                        android:layout_marginStart="?attr/larus_dp_8"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_8">
                    <ImageView
                        android:layout_width="?attr/larus_dp_18"
                        android:layout_height="?attr/larus_dp_18"
                        android:src="@null"/>
                    <com.larus.dora.impl.view.DoraTextView
                        android:textSize="?attr/larus_sp_15"
                        android:textColor="@color/neutral_70"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_dora_environmental_observation_onboarding_privacy_text_2_cn"
                        android:layout_marginStart="?attr/larus_dp_8"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_8"
                    android:layout_marginBottom="?attr/larus_dp_34">
                    <ImageView
                        android:layout_width="?attr/larus_dp_18"
                        android:layout_height="?attr/larus_dp_18"
                        android:src="@null"/>
                    <com.larus.dora.impl.view.DoraTextView
                        android:textSize="?attr/larus_sp_15"
                        android:textColor="@color/neutral_70"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_dora_environmental_observation_onboarding_privacy_text_3_cn"
                        android:layout_marginStart="?attr/larus_dp_8"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dora_g_env_observe_auth_private_btn_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_12"
            android:textColor="@color/larus_neutral_50"
            android:id="@+id/dora_g_env_observe_auth_private"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_environmental_observation_onboarding_privacy_announcement_cn"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/dora_g_env_observe_auth_btn_line"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_16"
            android:layout_marginBottom="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dora_g_env_observe_auth_private">
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/larus_neutral_100"
                android:gravity="center"
                android:id="@+id/dora_g_env_observe_auth_private_disagree"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxHeight="?attr/larus_dp_56"
                android:minHeight="?attr/larus_dp_56"
                android:text="@string/larus_dora_environmental_observation_onboarding_disagree_cn"
                android:layout_weight="1"/>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/larus_static_white"
                android:gravity="center"
                android:id="@+id/dora_g_env_observe_auth_private_agree"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxHeight="?attr/larus_dp_56"
                android:minHeight="?attr/larus_dp_56"
                android:text="@string/larus_dora_environmental_observation_onboarding_agree_cn"
                android:layout_weight="1"
                android:layout_marginStart="?attr/larus_dp_12"/>
        </LinearLayout>
        <include
            android:id="@+id/dora_g_onboarding_bottom_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dora_g_env_observe_auth_private"
            layout="@layout/larus_dora_g_onboarding_bottom_btn_layout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
