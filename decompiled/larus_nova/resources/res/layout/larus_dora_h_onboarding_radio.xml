<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dora_onboarding_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="?attr/larus_dp_44">
    <FrameLayout
        android:id="@+id/dora_onboarding_top_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/dora_onboarding_radio_text"
        app:layout_constraintTop_toTopOf="parent">
        <com.larus.common_ui.video.VideoPlayView
            android:layout_gravity="center"
            android:id="@+id/dora_onboarding_radio_mv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="?attr/larus_dp_390"/>
    </FrameLayout>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_23"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center_horizontal"
        android:id="@+id/dora_onboarding_radio_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_32"
        android:layout_marginRight="?attr/larus_dp_32"
        android:text="@string/larus_dora_h_onboarding_walkie_title_cn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"/>
    <com.larus.dora.impl.view.DoraUrlSpanTextView
        android:textSize="?attr/larus_sp_16"
        android:textColor="?attr/larus_neutral_50"
        android:gravity="center_horizontal"
        android:id="@+id/dora_onboarding_radio_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_32"
        android:layout_marginTop="?attr/larus_dp_20"
        android:layout_marginRight="?attr/larus_dp_32"
        android:lineSpacingMultiplier="1.2"
        app:larus_linkColor="?attr/larus_neutral_100"
        app:larus_linkUnderLine="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dora_onboarding_radio_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
