<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/larus_bg_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_push_reminder_dialog_close"
        android:layout_width="?attr/larus_dp_30"
        android:layout_height="?attr/larus_dp_30"
        android:layout_marginTop="?attr/larus_dp_13"
        android:layout_marginEnd="?attr/larus_dp_13"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/larus_bg_close_dialog"/>
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/tv_push_reminder_dialog_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_56"
        app:layout_constraintEnd_toEndOf="@+id/tv_push_reminder_dialog_button"
        app:layout_constraintHeight_min="?attr/larus_dp_33"
        app:layout_constraintStart_toStartOf="@+id/tv_push_reminder_dialog_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="?attr/larus_dp_358"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/larus_neutral_50"
        android:gravity="center"
        android:id="@+id/tv_push_reminder_dialog_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_2"
        app:layout_constraintEnd_toEndOf="@+id/tv_push_reminder_dialog_button"
        app:layout_constraintHeight_min="?attr/larus_dp_21"
        app:layout_constraintStart_toStartOf="@+id/tv_push_reminder_dialog_button"
        app:layout_constraintTop_toBottomOf="@+id/tv_push_reminder_dialog_title"
        app:layout_constraintWidth_max="?attr/larus_dp_358"/>
    <com.larus.common_ui.widget.ShadowLayout
        android:id="@+id/shadow_push_bubble_3"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_72"
        android:layout_marginLeft="?attr/larus_dp_47"
        android:layout_marginTop="?attr/larus_dp_47"
        android:layout_marginRight="?attr/larus_dp_47"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_push_reminder_dialog_subtitle"
        app:layout_constraintWidth_max="?attr/larus_dp_296"
        app:ux_shadow_color="#14000000"
        app:ux_shadow_offset_x="?attr/larus_dp_0"
        app:ux_shadow_offset_y="?attr/larus_dp_1"
        app:ux_shadow_radius="?attr/larus_dp_16"
        app:ux_shadow_size="?attr/larus_dp_6">
        <View
            android:id="@+id/tv_push_bubble_3"
            android:background="@drawable/larus_bg_bubble_3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="?attr/larus_dp_6"/>
    </com.larus.common_ui.widget.ShadowLayout>
    <com.larus.common_ui.widget.ShadowLayout
        android:id="@+id/shadow_push_bubble_2"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_76"
        android:layout_marginLeft="?attr/larus_dp_39"
        android:layout_marginTop="?attr/larus_dp_34"
        android:layout_marginRight="?attr/larus_dp_39"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_push_reminder_dialog_subtitle"
        app:layout_constraintWidth_max="?attr/larus_dp_312"
        app:ux_shadow_color="#0f000000"
        app:ux_shadow_offset_x="?attr/larus_dp_0"
        app:ux_shadow_offset_y="?attr/larus_dp_1"
        app:ux_shadow_radius="?attr/larus_dp_16"
        app:ux_shadow_size="?attr/larus_dp_6">
        <View
            android:id="@+id/tv_push_bubble_2"
            android:background="@drawable/larus_bg_bubble_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="?attr/larus_dp_6"/>
    </com.larus.common_ui.widget.ShadowLayout>
    <com.larus.common_ui.widget.ShadowLayout
        android:id="@+id/shadow_push_bubble_1"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_98"
        android:layout_marginLeft="?attr/larus_dp_23"
        android:layout_marginTop="?attr/larus_dp_10"
        android:layout_marginRight="?attr/larus_dp_23"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_push_reminder_dialog_subtitle"
        app:layout_constraintWidth_max="?attr/larus_dp_344"
        app:ux_shadow_color="#14000000"
        app:ux_shadow_offset_x="?attr/larus_dp_0"
        app:ux_shadow_offset_y="?attr/larus_dp_2"
        app:ux_shadow_radius="?attr/larus_dp_16"
        app:ux_shadow_size="?attr/larus_dp_14">
        <FrameLayout
            android:id="@+id/tv_push_bubble_1"
            android:background="@drawable/larus_bg_bubble_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="?attr/larus_dp_14"/>
    </com.larus.common_ui.widget.ShadowLayout>
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/tv_push_reminder_dialog_button"
        android:background="@drawable/larus_open_push_reminder_dialog_button"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_38"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_34"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shadow_push_bubble_3"
        app:layout_constraintWidth_max="?attr/larus_dp_358"/>
</androidx.constraintlayout.widget.ConstraintLayout>
