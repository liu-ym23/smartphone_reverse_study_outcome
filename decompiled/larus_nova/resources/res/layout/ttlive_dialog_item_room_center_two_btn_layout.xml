<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/room_center_button_layout"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:layout_marginLeft="16dp"
    android:layout_marginTop="24dp"
    android:layout_marginRight="16dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp">
    <Button
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_room_center_btn_text_black"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/room_center_button_left"
        android:background="@drawable/ttlive_bg_room_center_dialog_btn_left"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginRight="1dp"
        android:maxLines="1"
        android:lines="1"
        android:layout_weight="1"
        android:textAllCaps="false"
        android:layout_marginEnd="1dp"/>
    <View
        android:id="@+id/middle_btn_line"
        android:background="#1e161823"
        android:layout_width="0.5dp"
        android:layout_height="match_parent"/>
    <Button
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_room_center_btn_text_black"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/room_center_button_middle"
        android:background="@drawable/ttlive_bg_room_center_dialog_btn_right"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="1dp"
        android:maxLines="1"
        android:lines="1"
        android:layout_weight="1"
        android:textAllCaps="false"
        android:layout_marginStart="1dp"/>
    <Button
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_room_center_btn_text_black"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/room_center_button_right"
        android:background="@drawable/ttlive_bg_room_center_dialog_btn_right"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="1dp"
        android:maxLines="1"
        android:lines="1"
        android:layout_weight="1"
        android:textAllCaps="false"
        android:layout_marginStart="1dp"/>
</LinearLayout>
