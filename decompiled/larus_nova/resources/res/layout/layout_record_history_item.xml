<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/neutral_100"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxLines="1"
        android:layout_marginStart="20dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/tag"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="20dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/danger_50"
        android:id="@+id/tag"
        android:background="@drawable/bg_recording"
        android:paddingTop="3dp"
        android:paddingBottom="?attr/larus_dp_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingStart="?attr/larus_dp_6"
        android:paddingEnd="?attr/larus_dp_6"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/upload_container"
        app:layout_constraintStart_toEndOf="@+id/title"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="20dp"/>
    <FrameLayout
        android:id="@+id/upload_container"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/upload_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/larus_ic_upload"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"/>
        <com.larus.avlink.record.page.UploadProgressView
            android:layout_gravity="center"
            android:id="@+id/upload_progress"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"/>
    </FrameLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/neutral_50"
        android:id="@+id/time_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/content_summary"
        app:layout_constraintEnd_toStartOf="@+id/upload_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_goneMarginBottom="16dp"
        app:layout_goneMarginEnd="20dp"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/neutral_50"
        android:ellipsize="end"
        android:id="@+id/content_summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:maxLines="2"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_divider"
        app:layout_constraintEnd_toStartOf="@+id/upload_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/time_text"
        app:layout_goneMarginEnd="20dp"/>
    <View
        android:id="@+id/bottom_divider"
        android:background="@color/neutral_transparent_2"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
