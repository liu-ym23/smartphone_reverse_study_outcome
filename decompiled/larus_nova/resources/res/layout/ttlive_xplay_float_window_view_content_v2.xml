<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/xplay_float_expanded_container"
        android:background="@drawable/ttlive_xplay_cast_float_dialog_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView
            android:id="@+id/xplay_float_icon_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:foreground="@drawable/ttlive_xplay_cast_float_dialog_icon_mask"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/xplay_float_icon_iv"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:scaleType="centerCrop"
                app:actualImageScaleType="centerInside"/>
        </androidx.cardview.widget.CardView>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/xplay_float_audience_container"
            android:background="@drawable/ttlive_xplay_cast_float_dialog_audience_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/xplay_float_icon_container"
            app:layout_constraintStart_toEndOf="@+id/xplay_float_icon_container"
            app:layout_constraintTop_toTopOf="@+id/xplay_float_icon_container">
            <ImageView
                android:id="@+id/xplay_float_audience_icon_iv"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/ttlive_xplay_cast_float_dialog_audience_icon"
                android:layout_marginStart="4dp"/>
            <com.bytedance.dux.text.DuxTextView
                android:textSize="10sp"
                android:textColor="#99ffffff"
                android:id="@+id/xplay_float_audience_num_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="6dp"/>
        </LinearLayout>
        <com.bytedance.dux.text.DuxTextView
            android:textSize="11sp"
            android:textColor="@color/white"
            android:id="@+id/xplay_float_clear_tips_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="取消清屏"
            android:alpha="0.8"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/xplay_float_icon_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toEndOf="@+id/xplay_float_icon_container"
            app:layout_constraintTop_toTopOf="@+id/xplay_float_icon_container"/>
        <ImageView
            android:id="@+id/xplay_float_fold_iv"
            android:layout_width="wrap_content"
            android:layout_height="10dp"
            android:src="@drawable/ttlive_xplay_cast_float_message_dialog_fold"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="@+id/xplay_float_icon_container"
            app:layout_constraintEnd_toEndOf="@+id/xplay_float_icon_container"
            app:layout_constraintStart_toStartOf="@+id/xplay_float_icon_container"
            app:layout_constraintTop_toTopOf="@+id/xplay_float_icon_container"/>
        <FrameLayout
            android:id="@+id/xplay_float_message_container"
            android:layout_width="230dp"
            android:layout_height="146dp"
            android:layout_marginTop="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/xplay_float_icon_container"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.livesdk.chatroom.ui.NoMoreSpaceTextView
        android:textSize="11sp"
        android:textStyle="normal"
        android:layout_gravity="start"
        android:id="@+id/xplay_float_fold_message_text"
        android:background="@drawable/ttlive_xplay_cast_float_dialog_fold_bg"
        android:padding="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxWidth="230dp"
        android:lineSpacingExtra="2dp"
        android:alpha="0"
        android:translationY="-8dp"
        android:textDirection="anyRtl"
        android:textAlignment="viewStart"/>
</LinearLayout>
