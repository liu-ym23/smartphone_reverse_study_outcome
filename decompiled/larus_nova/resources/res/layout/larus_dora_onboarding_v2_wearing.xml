<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dora_onboarding_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.dora.impl.view.DoraMovieView
        android:layout_gravity="center"
        android:id="@+id/dora_onboarding_wearing_mv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_121"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_23"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center_horizontal"
        android:id="@+id/dora_onboarding_wearing_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_32"
        android:layout_marginRight="?attr/larus_dp_16"
        android:text="@string/larus_dora_onboarding_guide_1_title_cn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dora_onboarding_wearing_mv"/>
    <TextView
        android:textSize="?attr/larus_sp_16"
        android:textColor="@color/larus_neutral_50"
        android:gravity="center_horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginRight="?attr/larus_dp_16"
        android:text="@string/larus_dora_onboarding_guide_1_desc_cn"
        android:lineSpacingMultiplier="1.2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dora_onboarding_wearing_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
