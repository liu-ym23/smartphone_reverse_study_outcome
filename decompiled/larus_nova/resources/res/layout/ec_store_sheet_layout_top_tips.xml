<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/ec_store_shell_expand_top_tips_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="1">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/ec_store_shell_expand_top_tips_line"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:src="@drawable/ec_shop_top_tips_line_light_up"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ec_ec_store_shell_expand_top_tips_wrapper"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="2dp">
            <TextView
                android:textSize="12dp"
                android:textColor="#e6ffffff"
                android:id="@+id/ec_store_shell_expand_top_tips_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
            <com.bytedance.android.ec.core.widget.ECLottieAnimationView
                android:id="@+id/ec_store_shell_expand_top_tips_arrow"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:rotation="180"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/ec_store_shell_collapse_top_tips_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/ec_store_shell_collapse_top_tips_line"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/ec_shop_top_tips_line_light_new"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ec_ec_store_shell_collapse_top_tips_wrapper"
            android:layout_width="match_parent"
            android:layout_height="28dp">
            <TextView
                android:textSize="12dp"
                android:textColor="#e6ffffff"
                android:id="@+id/ec_store_shell_collapse_top_tips_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
            <com.bytedance.android.ec.core.widget.ECLottieAnimationView
                android:id="@+id/ec_store_shell_collapse_top_tips_arrow"
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
