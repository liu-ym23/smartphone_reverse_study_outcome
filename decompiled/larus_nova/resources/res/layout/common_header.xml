<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/facade_round_top_xxl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/bg_float_base">
        <com.larksuite.component.ui.imageview.LKUIRoundedImageView
            android:id="@+id/avatar_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="14dp"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true"
            android:layout_marginStart="18dp"
            app:civ_radius="@dimen/space_kit_len_6"
            app:layout_constraintBottom_toTopOf="@+id/headerDivider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_title"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_kit_len_8"
            android:layout_marginRight="@dimen/space_kit_len_8"
            android:maxLines="1"
            android:layout_weight="1"/>
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/right_action"
            android:layout_width="@dimen/space_kit_len_40"
            android:layout_height="@dimen/space_kit_len_40"
            android:layout_marginEnd="@dimen/space_kit_len_8">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/right_icon"
                android:clickable="false"
                android:layout_width="@dimen/space_kit_len_24"
                android:layout_height="@dimen/space_kit_len_24"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ud_icon_close_circle_colorful"/>
        </FrameLayout>
    </LinearLayout>
    <View
        android:id="@+id/headerDivider"
        android:background="@color/line_divider_default"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_kit_len_half"/>
</LinearLayout>
