<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab"
        android:layout_width="190dp"
        android:layout_height="match_parent"
        app:tabBackground="@null"
        app:tabGravity="fill"
        app:tabIndicator="@drawable/ttlive_apply_top_tab_indicator"
        app:tabIndicatorColor="@color/ttlive_black"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="2dp"
        app:tabPaddingEnd="2dp"
        app:tabPaddingStart="2dp"
        app:tabSelectedTextColor="@color/ttlive_black"
        app:tabTextAppearance="@style/InteractTextStyle"
        app:tabTextColor="#4c000000"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:id="@+id/anchor_operation_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/img_search"
            android:padding="4dp"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/ttlive_search_icon"
            android:layout_marginEnd="12dp"/>
        <FrameLayout
            android:id="@+id/set"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginRight="12dp"
            android:layout_marginEnd="12dp">
            <View
                android:layout_gravity="center"
                android:background="@drawable/ttlive_icon_apply_setting"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <View
                android:layout_gravity="end|top"
                android:id="@+id/setting_guide_dot"
                android:background="@drawable/ttlive_interact_audience_setting_guide_dot"
                android:visibility="gone"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginRight="2dp"
                android:layout_marginEnd="2dp"/>
        </FrameLayout>
        <View
            android:layout_gravity="center"
            android:id="@+id/close"
            android:background="@drawable/ttlive_icon_apply_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginRight="12dp"
            android:layout_marginEnd="12dp"/>
    </LinearLayout>
    <TextView
        android:textSize="14dp"
        android:gravity="center"
        android:layout_gravity="end"
        android:id="@+id/admin_operation"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/ttlive_interact_apply_link"
        android:paddingEnd="16dp"/>
</FrameLayout>
