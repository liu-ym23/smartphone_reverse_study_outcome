<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.bytedance.ee.bear.bitable.infoarch.header.BitableHeaderContainer
        android:id="@+id/bitable_header_container"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.bytedance.ee.bear.bitable.core.nested.PinWrapperLinearLayout
        android:orientation="vertical"
        android:id="@+id/bitable_pin_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.ee.bear.bitable.infoarch.view.BitableViewContainer
            android:id="@+id/bitable_view_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:pin="true"/>
        <com.bytedance.ee.bear.bitable.infoarch.toolbar.BitableToolbarContainer
            android:id="@+id/bitable_toolbar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:pin="false"/>
    </com.bytedance.ee.bear.bitable.core.nested.PinWrapperLinearLayout>
</merge>
