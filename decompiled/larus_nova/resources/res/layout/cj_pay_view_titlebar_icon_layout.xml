<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cj_pay_titlebar_root_view"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cj_pay_height_50">
    <ImageView
        android:id="@+id/cj_pay_back_view"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="@dimen/cj_pay_padding_12"
        android:src="?attr/cj_pay_action_bar_arrow_icon"
        android:scaleType="centerCrop"
        android:layout_centerVertical="true"
        android:contentDescription="@string/cj_pay_close_text"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
        android:gravity="center"
        android:id="@+id/cj_pay_left_text_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_24"
        android:singleLine="true"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="?attr/cj_pay_action_bar_text_color"
        android:id="@+id/cj_pay_title_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/cj_pay_title_info_ll"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/cj_pay_title_info_iv"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
            android:id="@+id/cj_pay_title_info_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/cj_pay_right_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/cj_pay_padding_12"
        android:scaleType="centerCrop"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/cj_pay_color_blue"
        android:gravity="center"
        android:id="@+id/cj_pay_right_text_view"
        android:paddingLeft="6dp"
        android:paddingRight="12dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</RelativeLayout>
