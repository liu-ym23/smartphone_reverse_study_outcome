<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larksuite.component.universe_design.shadow.UDShadowLayout
        android:layout_gravity="end|bottom"
        android:id="@+id/switch_card_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/UDShadow.S4.Down">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:background="@drawable/bitable_card_page_index_bg"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginBottom="26dp"
            android:layout_marginEnd="16dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/pre_record"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:layout_width="48dp"
                android:layout_height="46dp"
                android:tint="@color/facade_selector_icon_n1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                app:srcCompat="@drawable/ud_icon_left_outlined"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_title"
                android:gravity="center"
                android:id="@+id/record_index"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="32dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/next_record"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:layout_width="48dp"
                android:layout_height="46dp"
                android:tint="@color/facade_selector_icon_n1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                app:srcCompat="@drawable/ud_icon_right_outlined"/>
        </LinearLayout>
    </com.larksuite.component.universe_design.shadow.UDShadowLayout>
</merge>
