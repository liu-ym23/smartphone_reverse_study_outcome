<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/loading_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_flow_feed_loading_view"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/load_error"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/iv_error_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/icon_flow_feed_disconnect"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/ud_N1000"
            android:id="@+id/tv_error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/LarkIM_Common_LoadFailed_EmptyState"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="16sp"
            android:textColor="#ffffff"
            android:id="@+id/btn_retry"
            android:background="@drawable/icon_flow_error_retry_btn"
            android:paddingLeft="28dp"
            android:paddingTop="11dp"
            android:paddingRight="28dp"
            android:paddingBottom="11dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/LarkIM_Common_Retry_Button"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/load_empty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/empty_image"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/icon_flow_feed_empty"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/ud_N1000"
            android:ellipsize="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="16dp"
            android:text="@string/LarkIM_Feed_UserChats_Empty"
            android:maxLines="1"
            android:layout_marginEnd="32dp"/>
    </LinearLayout>
</RelativeLayout>
