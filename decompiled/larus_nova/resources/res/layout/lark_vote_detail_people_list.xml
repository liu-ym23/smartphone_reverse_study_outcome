<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ud_N00"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/vote_facade_close"
            android:visibility="visible"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="10dp"
            android:tint="@color/ud_N800"
            android:layout_marginStart="16dp"
            app:srcCompat="@drawable/ud_icon_close_outlined"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.larksuite.framework.ui.SpareLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="44dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/vote_facade_close">
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/text_title"
                    android:ellipsize="end"
                    android:id="@+id/vote_facade_title"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginTop="26dp"
                    android:layout_marginBottom="10dp"
                    android:maxLines="1"
                    android:layout_marginEnd="0dp"/>
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/text_title"
                    android:id="@+id/voted_num"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginTop="26dp"
                    android:layout_marginBottom="10dp"/>
            </com.larksuite.framework.ui.SpareLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/vote_people_list"
        android:background="@color/ud_N00"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
