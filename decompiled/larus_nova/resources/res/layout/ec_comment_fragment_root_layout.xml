<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/page_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/title_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="45dp"/>
        <FrameLayout
            android:id="@+id/stat_container"
            android:layout_width="match_parent"
            android:layout_height="30dp"/>
        <FrameLayout
            android:id="@+id/tag_list_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <FrameLayout
            android:id="@+id/bottom_product_card_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/load_and_empty_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/page_container">
        <include
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/ec_commerce_product_comment_nodata_layout"/>
        <com.bytedance.android.ec.core.widget.DoubleColorBallStatusView
            android:layout_gravity="center"
            android:id="@+id/ec_comment_double_color_ball"
            android:visibility="visible"
            android:layout_width="28dp"
            android:layout_height="28dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/old_title_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/float_window_ll"
        android:background="@color/transparent"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageButton
            android:layout_gravity="end|bottom"
            android:id="@+id/to_top_btn"
            android:background="#00ff0000"
            android:visibility="gone"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="10dp"
            android:src="@drawable/ec_comment_to_top_btn"/>
        <ImageButton
            android:layout_gravity="end|bottom"
            android:id="@+id/mode_switch_button_new"
            android:background="#00ff0000"
            android:visibility="gone"
            android:layout_width="64dp"
            android:layout_height="64dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
