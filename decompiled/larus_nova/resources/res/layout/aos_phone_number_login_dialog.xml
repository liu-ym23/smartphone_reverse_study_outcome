<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/dialog_content"
        android:background="@drawable/aos_phone_number_login_dialog_bg"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginTop="32dp"
            android:src="@drawable/aos_phone_number_login_avatar"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#161823"
            android:layout_gravity="center_horizontal"
            android:id="@+id/aos_phone_number_login_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/aos_phone_number_login_title"/>
        <TextView
            android:textSize="13sp"
            android:id="@+id/aos_phone_number_login_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/confirm_btn"
            android:background="@drawable/aos_phone_number_login_btn_bg"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="32dp"
            android:text="@string/aos_phone_number_btn_text"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#fe2c55"
            android:layout_gravity="center_horizontal"
            android:id="@+id/use_another_account_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/aos_phone_number_use_another_btn_text"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp"/>
    </LinearLayout>
</LinearLayout>
