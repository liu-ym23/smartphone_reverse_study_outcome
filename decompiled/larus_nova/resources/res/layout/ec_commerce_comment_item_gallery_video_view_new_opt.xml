<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gallery_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.shopping.api.video.ECVideoPlayerView
        android:id="@+id/ec_gallery_video_player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="66dp"
        app:delayInitPlayer="true"
        app:keepScreenOnPlaying="true"
        app:playerSceneName="ecom_content#comment_gallery"/>
    <View
        android:background="@drawable/commerce_bg_comment_gallery_content_new"
        android:layout_width="match_parent"
        android:layout_height="371dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/gallery_ec_play_iv"
        android:background="@drawable/commerce_ic_play_block_play_new"
        android:visibility="gone"
        android:layout_width="72dp"
        android:layout_height="72dp"
        app:layout_constraintBottom_toBottomOf="@+id/ec_gallery_video_player_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ec_gallery_video_player_view"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/white"
        android:id="@+id/ec_duration_divider"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="35dp"
        android:text="/"
        app:layout_constraintBottom_toTopOf="@+id/gallery_pb_media_progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="24sp"
        android:textColor="@color/ec_color_white_90"
        android:id="@+id/gallery_tv_media_progress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/ec_duration_divider"
        app:layout_constraintEnd_toStartOf="@+id/ec_duration_divider"
        app:layout_constraintTop_toTopOf="@+id/ec_duration_divider"/>
    <TextView
        android:textSize="24sp"
        android:textColor="@color/ec_color_white_50"
        android:id="@+id/gallery_tv_media_duration"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/ec_duration_divider"
        app:layout_constraintStart_toEndOf="@+id/ec_duration_divider"
        app:layout_constraintTop_toTopOf="@+id/ec_duration_divider"/>
    <SeekBar
        android:id="@+id/gallery_pb_media_progress"
        android:paddingLeft="0dp"
        android:paddingTop="11dp"
        android:paddingRight="0dp"
        android:paddingBottom="11dp"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_marginBottom="41dp"
        android:progressDrawable="@drawable/commerce_comment_gallery_media_progress_bar_new"
        android:thumb="@drawable/ec_comment_video_progress_bar_dot"
        android:splitTrack="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@android:style/Widget.ProgressBar.Horizontal"/>
    <com.bytedance.android.ec.core.widget.ECStatusView
        android:id="@+id/gallery_loading_status_view"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginBottom="66dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
