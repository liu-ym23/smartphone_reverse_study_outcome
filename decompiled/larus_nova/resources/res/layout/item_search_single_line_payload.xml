<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/larus_white_bg_item_middle"
    android:paddingLeft="?attr/larus_dp_16"
    android:paddingTop="?attr/larus_dp_6"
    android:paddingRight="?attr/larus_dp_16"
    android:paddingBottom="?attr/larus_dp_6"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?attr/larus_dp_40">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/image_search_avatar"
        android:layout_width="?attr/larus_dp_28"
        android:layout_height="?attr/larus_dp_28"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingEnd="?attr/larus_dp_28">
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/larus_neutral_100"
            android:ellipsize="end"
            android:id="@+id/text_search_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="10dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/payload_pin_icon"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/payload_pin_icon"
            android:background="@drawable/larus_icon_pin_fill"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_16"
            android:layout_height="?attr/larus_dp_16"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/text_search_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/text_search_title"
            app:layout_constraintTop_toTopOf="@+id/text_search_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/larus_neutral_50"
        android:id="@+id/text_search_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"/>
</LinearLayout>
