<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/facade_rectangle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/facade_selector_item_transparent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/space_kit_len_48">
        <com.larksuite.component.universe_design.checkbox.UDCheckBox
            android:id="@+id/check_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            app:ud_checkbox_size="normal"/>
        <FrameLayout
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_kit_len_12">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cell_item"
                android:background="@drawable/bitable_card_field_item_bg_normal"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/space_kit_len_24"
                android:paddingStart="@dimen/space_kit_len_12"
                android:paddingEnd="@dimen/space_kit_len_12">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/icon_done"
                    android:visibility="gone"
                    android:layout_width="@dimen/space_kit_len_10"
                    android:layout_height="@dimen/space_kit_len_10"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/icon_ring"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ud_icon_list_check_bold_outlined"
                    app:tint="@color/static_white"/>
                <com.bytedance.ee.bear.bitable.common.widgets.common.RingView
                    android:id="@+id/icon_ring"
                    android:visibility="visible"
                    android:layout_width="@dimen/space_kit_len_10"
                    android:layout_height="@dimen/space_kit_len_10"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tv_name"
                    app:layout_constraintStart_toEndOf="@+id/icon_done"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_title"
                    android:ellipsize="end"
                    android:id="@+id/tv_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginStart="@dimen/space_kit_len_6"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/icon_ring"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/more_operation_icon"
            android:padding="@dimen/space_kit_len_14"
            android:layout_width="@dimen/space_kit_len_48"
            android:layout_height="@dimen/space_kit_len_48"
            android:tint="@color/icon_n3"
            android:layout_marginEnd="@dimen/space_kit_len_2"
            app:srcCompat="@drawable/ud_icon_more_vertical_outlined"/>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:background="@color/line_border_card"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_kit_len_divider"/>
</LinearLayout>
