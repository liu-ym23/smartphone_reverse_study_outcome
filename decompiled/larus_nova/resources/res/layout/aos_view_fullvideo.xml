<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.awemeopen.infra.base.image.AoImageView
        android:id="@+id/fullvideo_play_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/fullvideo_videoview_wrapper_rl"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/fullvideo_videoview_wrapper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <com.bytedance.awemeopen.infra.base.player.AoVideoView
                android:id="@+id/fullvideo_videoview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <com.bytedance.awemeopen.apps.framework.player.EdgeTransparentView
            android:id="@+id/videoview_top_mask"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/fullvideo_videoview_wrapper"/>
        <com.bytedance.awemeopen.apps.framework.player.EdgeTransparentView
            android:id="@+id/videoview_bottom_mask"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@+id/fullvideo_videoview_wrapper"/>
    </RelativeLayout>
    <com.bytedance.awemeopen.infra.base.image.AoImageView
        android:id="@+id/fullvideo_play_foreground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
