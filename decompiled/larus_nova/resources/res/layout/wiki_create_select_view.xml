<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:background="@drawable/facade_round_top_xxl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/bg_body">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/select_recycler"
        android:paddingTop="@dimen/space_kit_len_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_kit_len_16"
        android:paddingEnd="@dimen/space_kit_len_16"/>
    <View
        android:background="@color/line_divider_default"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_kit_len_half"/>
    <TextView
        android:textSize="@dimen/space_kit_font_14"
        android:textColor="@color/text_title"
        android:gravity="center"
        android:id="@+id/cancel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_kit_len_49"
        android:text="@string/Doc_Facade_Cancel"/>
</LinearLayout>
