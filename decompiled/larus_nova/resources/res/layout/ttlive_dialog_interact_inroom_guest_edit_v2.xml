<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_dialog_inroom_user"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_black"
        android:gravity="center"
        android:id="@+id/change"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="@string/ttlive_interact_change"/>
    <View
        android:background="#f1f1f2"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_black"
        android:gravity="center"
        android:id="@+id/delete"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="@string/ttlive_core_share_dialog_action_delete"/>
    <View
        android:background="#f1f1f2"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_black"
        android:gravity="center"
        android:id="@+id/cancel"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="@string/ttlive_cancel"/>
</LinearLayout>
