<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="16dp"
    android:paddingRight="20dp"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ttlive_mid_bottom_item_area_height">
    <TextView
        android:textSize="15sp"
        android:textColor="@color/ttlive_ps_panel_word_75_gray"
        android:id="@+id/public_screen_helper_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_public_screen_helper"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/public_screen_helper_red_dot"
        android:background="@drawable/ttlive_ps_panel_red_dot"
        android:visibility="gone"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginLeft="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/public_screen_helper_text"
        app:layout_constraintLeft_toRightOf="@+id/public_screen_helper_text"
        app:layout_constraintTop_toTopOf="@+id/public_screen_helper_text"/>
    <ImageView
        android:background="@drawable/ttlive_ps_panel_arrow"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
