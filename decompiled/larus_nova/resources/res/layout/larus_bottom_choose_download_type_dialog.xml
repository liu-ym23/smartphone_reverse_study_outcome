<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/record_download_type_summary"
        android:background="@drawable/larus_bg_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_56"
        android:text="@string/larus_audioTrans_downloadSummary_button"
        android:fontFamily="sans-serif-medium"/>
    <View
        android:background="@color/larus_base_1_overlay"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_1"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/record_download_type_text"
        android:background="@color/larus_base_2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_56"
        android:text="@string/larus_audioTrans_downloadRecord_button"
        android:fontFamily="sans-serif-medium"/>
    <View
        android:background="@color/larus_base_1_overlay"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_1"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/record_download_type_audio"
        android:background="@color/larus_base_2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_56"
        android:text="@string/larus_audioTrans_downloadAudio_button"
        android:fontFamily="sans-serif-medium"/>
    <View
        android:background="@color/larus_base_1_overlay"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_8"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center_horizontal"
        android:id="@+id/bottom_cancel"
        android:background="@color/larus_base_2"
        android:paddingTop="?attr/larus_dp_15"
        android:paddingBottom="?attr/larus_dp_17"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/larus_cancel"
        android:fontFamily="sans-serif-medium"/>
</LinearLayout>
