<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/ttlive_bg_ensure_kick_dialog"
        android:layout_width="270dp"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_live_dialog_title"
            android:gravity="center"
            android:id="@+id/hint_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#000000"
            android:gravity="left"
            android:id="@+id/hint_content"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:id="@+id/divider_horizontal"
            android:background="@color/ttlive_core_hs_s9"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/btn_left"
                android:layout_width="0dp"
                android:layout_height="43.5dp"
                android:text="@string/ttlive_text_cancel"
                android:layout_weight="1"/>
            <View
                android:id="@+id/divider_vertical"
                android:background="@color/ttlive_core_hs_s9"
                android:layout_width="1dp"
                android:layout_height="43.5dp"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/btn_right"
                android:layout_width="0dp"
                android:layout_height="43.5dp"
                android:text="@string/ttlive_text_ensure"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
