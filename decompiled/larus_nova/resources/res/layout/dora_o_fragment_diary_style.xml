<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/dora_o_bg_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/style_list"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:overScrollMode="never"
        android:layout_marginStart="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toTopOf="@+id/style_add_button"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/style_add_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:layout_marginStart="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:ocardlistitem_cardType="type_normal"
        app:ocardlistitem_showCardBg="false"
        app:ocardlistitem_showTitle="true"/>
    <ProgressBar
        android:id="@+id/style_loading"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_32"
        android:layout_height="?attr/larus_dp_32"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_15"
        android:textColor="@color/dora_o_text_secondary"
        android:id="@+id/style_error_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_dora_o_diary_style_load_failed"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/style_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</androidx.constraintlayout.widget.ConstraintLayout>
