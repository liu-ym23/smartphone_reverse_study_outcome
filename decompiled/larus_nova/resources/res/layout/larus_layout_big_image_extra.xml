<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/big_image_extra_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_44">
        <ImageView
            android:id="@+id/back"
            android:layout_width="?attr/larus_dp_38"
            android:layout_height="?attr/larus_dp_38"
            android:src="@drawable/larus_bg_big_close_page"
            android:contentDescription="@string/larus_accessibility_icon_close"
            android:layout_marginStart="?attr/larus_dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="?attr/larus_dp_12"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/indicator"
            android:layout_width="?attr/larus_dp_150"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/larus_dp_2"
            android:layout_marginRight="?attr/larus_dp_2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/sourceIconV2"
            android:padding="?attr/larus_dp_8"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_36"
            android:layout_height="?attr/larus_dp_36"
            android:src="@drawable/larus_layout_big_image_extra_link"
            android:contentDescription="@string/larus_accessibility_imageSearch_openSourcePage"
            android:layout_marginEnd="?attr/larus_dp_6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|top"
            android:id="@+id/more"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/larus_common_slide_more"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/source"
            android:background="@drawable/larus_bg_big_image_icon"
            android:paddingLeft="?attr/larus_dp_12"
            android:paddingTop="?attr/larus_dp_10"
            android:paddingRight="?attr/larus_dp_12"
            android:paddingBottom="?attr/larus_dp_10"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_38"
            android:layout_marginEnd="?attr/larus_dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/sourceIcon"
                android:layout_width="?attr/larus_dp_16"
                android:layout_height="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_4"
                app:roundBottomEnd="true"
                app:roundBottomStart="true"
                app:roundTopEnd="true"
                app:roundTopStart="true"
                app:roundedCornerRadius="?attr/larus_dp_4"/>
            <TextView
                android:textSize="?attr/larus_dp_13"
                android:textColor="@color/larus_static_white"
                android:id="@+id/sourceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:layout_gravity="start|bottom"
        android:id="@+id/like"
        android:background="@drawable/larus_bg_big_image_icon"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_38"
        android:layout_height="?attr/larus_dp_38"
        android:layout_marginBottom="?attr/larus_dp_46"
        android:src="@drawable/larus_ic_like_white"
        android:layout_marginStart="?attr/larus_dp_16"/>
    <ImageView
        android:layout_gravity="start|bottom"
        android:id="@+id/dislike"
        android:background="@drawable/larus_bg_big_image_icon"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_38"
        android:layout_height="?attr/larus_dp_38"
        android:layout_marginBottom="?attr/larus_dp_46"
        android:src="@drawable/larus_ic_dislike_white"
        android:layout_marginStart="?attr/larus_dp_68"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="start|bottom"
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_12">
        <TextView
            android:textSize="?attr/larus_dp_15"
            android:textColor="@color/larus_static_white"
            android:id="@+id/tv_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/source_domain_container"
            app:layout_constraintStart_toStartOf="@+id/bottom_container"/>
        <TextView
            android:textSize="?attr/larus_dp_12"
            android:textColor="@color/larus_neutral_30"
            android:id="@+id/desc_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_26"
            app:layout_constraintBottom_toTopOf="@+id/iv_container"
            app:layout_constraintStart_toStartOf="parent"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/source_domain_container"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_23"
            android:layout_marginBottom="?attr/larus_dp_2"
            app:layout_constraintBottom_toTopOf="@+id/iv_container"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:id="@+id/source_domain_icon"
                android:layout_width="?attr/larus_dp_14"
                android:layout_height="?attr/larus_dp_15"
                android:src="@drawable/larus_ic_source_domain_link"/>
            <TextView
                android:textSize="?attr/larus_dp_15"
                android:textColor="@color/static_white_transparent_4"
                android:ellipsize="end"
                android:id="@+id/source_domain_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="?attr/larus_dp_200"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_marginStart="?attr/larus_dp_4"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/iv_container"
            android:paddingTop="?attr/larus_dp_14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:id="@+id/iv_ai_beautify"
                android:background="@drawable/larus_bg_big_image_icon"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_44"
                android:src="@drawable/larus_ic_ai_beautify_white"
                android:layout_marginEnd="?attr/larus_dp_8"/>
            <com.larus.bmhome.bigimg.download.CommonDownLoadLayout
                android:id="@+id/download_layout"
                android:background="@drawable/larus_bg_big_image_icon"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_44"
                android:contentDescription="@string/larus_accessibility_save"
                android:layout_marginEnd="?attr/larus_dp_8"
                app:larus_showText="false"/>
            <ImageView
                android:id="@+id/share"
                android:background="@drawable/larus_bg_big_image_icon"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_44"
                android:src="@drawable/larus_ic_share_white_filled"
                android:scaleType="center"
                android:contentDescription="@string/larus_accessibility_icon_share"/>
        </LinearLayout>
        <com.larus.bmhome.view.CreationOperateContainerView
            android:id="@+id/creation_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/fl_lynx_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</FrameLayout>
