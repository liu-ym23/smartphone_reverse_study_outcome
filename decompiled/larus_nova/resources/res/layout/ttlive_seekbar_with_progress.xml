<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12dp"
        android:textColor="#80ffffff"
        android:id="@+id/seek_bar_progress_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@+id/seek_bar_with_progress"
        app:layout_constraintEnd_toEndOf="@+id/seek_bar_with_progress"
        app:layout_constraintStart_toStartOf="@+id/seek_bar_with_progress"/>
    <SeekBar
        android:id="@+id/seek_bar_with_progress"
        android:background="@color/transparent"
        android:paddingLeft="21dp"
        android:paddingRight="21dp"
        android:longClickable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="3dp"
        android:max="100"
        android:progressDrawable="@drawable/ttlive_seek_bar_with_progress_bg"
        android:thumb="@drawable/ttlive_ktv_seek_bar_with_progress_thumb"
        android:paddingStart="21dp"
        android:paddingEnd="21dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
