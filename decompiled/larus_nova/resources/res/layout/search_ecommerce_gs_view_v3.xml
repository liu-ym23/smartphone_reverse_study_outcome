<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gsContainerLayout"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/gs_linear_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/gs_atmosphere"
            android:layout_width="match_parent"
            android:layout_height="27dp"
            android:layout_marginStart="4dp">
            <com.bytedance.lighten.loader.SmartImageView
                android:id="@+id/gs_slogan_image"
                android:layout_width="167dp"
                android:layout_height="27dp"
                app:actualImageScaleType="fitCenter"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/gs_sales_info"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="7dp"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="4dp"
                android:layout_alignParentEnd="true"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/countdown_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp">
                    <com.bytedance.lighten.loader.SmartImageView
                        android:id="@+id/touxiang1"
                        android:padding="1dp"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="3dp"
                        android:elevation="3dp"
                        app:actualImageScaleType="fitCenter"
                        app:layout_constraintVertical_bias="0.5"/>
                    <com.bytedance.lighten.loader.SmartImageView
                        android:id="@+id/touxiang2"
                        android:padding="1dp"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="-9dp"
                        android:elevation="2dp"
                        app:actualImageScaleType="fitCenter"
                        app:layout_constraintVertical_bias="0.5"/>
                    <com.bytedance.lighten.loader.SmartImageView
                        android:id="@+id/touxiang3"
                        android:padding="1dp"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="-8dp"
                        android:elevation="1dp"
                        app:actualImageScaleType="fitCenter"
                        app:layout_constraintVertical_bias="0.5"/>
                    <com.ss.android.ugc.aweme.discover.commodity.holder.guidesearch.customview.NumberScrollContainer
                        android:orientation="horizontal"
                        android:id="@+id/numberScrollContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_marginLeft="4dp"/>
                    <com.bytedance.ies.dmt.ui.widget.DmtTextView
                        android:textSize="11dp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:id="@+id/suffixText"
                        android:paddingRight="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="人正在抢"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <include
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="4dp"
                android:layout_marginBottom="6dp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                layout="@layout/search_commodity_product_only_free_order_title_layout2"/>
        </RelativeLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/containerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <FrameLayout
                android:id="@+id/Bottom_background"
                android:background="@drawable/bottom_search_guidesearch_bg_light"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="3dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.ss.android.ugc.aweme.discover.commodity.view.BezierView
                android:id="@+id/bezierView"
                android:layout_width="match_parent"
                android:layout_height="168dp"
                app:curPosition="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tabNumber="4"/>
            <com.bytedance.ies.dmt.ui.widget.tablayout.DmtTabLayout
                android:id="@+id/gsTabLayout"
                android:padding="0dp"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_marginTop="3dp"
                app:layout_constraintEnd_toStartOf="@+id/jumpLinkView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tabBackground="@null"
                app:tabIndicatorColor="@color/transparent"
                app:tabIndicatorHeight="0dp"
                app:tabPaddingBottom="0dp"
                app:tabPaddingEnd="0dp"
                app:tabPaddingStart="0dp"
                app:tabPaddingTop="0dp"
                app:tabSelectedTextColor="@color/TextPrimary"
                app:tabTextColor="@color/TextTertiary"/>
            <com.bytedance.ies.dmt.ui.widget.DmtTextView
                android:textSize="13sp"
                android:textColor="@color/TextSecondary"
                android:id="@+id/jumpLinkView"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableEnd="@drawable/search_gs_jumplink_arrow"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/gsTabLayout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/gsTabLayout"/>
            <View
                android:id="@+id/tabMaskView"
                android:background="@drawable/search_commodity_gs_tab_mask_bg"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/jumpLinkView"
                app:layout_constraintEnd_toStartOf="@+id/jumpLinkView"
                app:layout_constraintTop_toTopOf="@+id/jumpLinkView"/>
            <com.ss.android.ugc.aweme.discover.commodity.holder.guidesearch.customview.NoneScrollViewPager
                android:id="@+id/gsViewPager"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/gs_ai_info"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/gsTabLayout"/>
            <com.ss.android.ugc.aweme.discover.commodity.holder.guidesearch.GSAIGuideInfoView
                android:id="@+id/gs_ai_info"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/gsViewPager"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</FrameLayout>
