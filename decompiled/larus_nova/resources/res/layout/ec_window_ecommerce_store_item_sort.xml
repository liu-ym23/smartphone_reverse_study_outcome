<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:id="@+id/lr_layout"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/shopping_std_text_modal_6"
        android:id="@+id/tv_sort"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_sort"
        android:paddingTop="0.5dp"
        android:visibility="gone"
        android:layout_width="16sp"
        android:layout_height="16sp"
        android:layout_marginLeft="2dp"
        android:src="@drawable/ecommerce_store_ic_sort_unselect_new"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/tv_sort"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_red_dot"
        android:visibility="gone"
        android:layout_width="4sp"
        android:layout_height="4sp"
        android:layout_marginTop="-1sp"
        android:src="@drawable/ec_shop_sort_red_dot"
        app:layout_constraintLeft_toRightOf="@+id/tv_sort"
        app:layout_constraintTop_toTopOf="@+id/tv_sort"/>
</androidx.constraintlayout.widget.ConstraintLayout>
