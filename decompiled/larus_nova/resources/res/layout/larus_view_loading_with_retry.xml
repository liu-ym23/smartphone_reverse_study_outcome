<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/top_blank"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="2"/>
    <ProgressBar
        android:layout_gravity="center_horizontal"
        android:id="@+id/loading_progress"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:indeterminateTint="?attr/larus_neutral_50"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/refresh_btn"
        android:layout_width="?attr/larus_dp_60"
        android:layout_height="?attr/larus_dp_60"
        android:src="@drawable/larus_ic_refresh_white"
        app:tint="?attr/larus_neutral_100"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/tips_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_24">
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_100"
            android:id="@+id/refresh_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_primary_50"
            android:id="@+id/action_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="?attr/larus_dp_4"/>
    </LinearLayout>
    <View
        android:id="@+id/bottom_blank"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="3"/>
</merge>
