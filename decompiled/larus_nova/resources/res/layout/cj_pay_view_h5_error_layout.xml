<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cj_pay_loading_error_layout"
    android:background="@color/cj_pay_color_white"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/cj_pay_error_icon_layout"
        android:layout_width="@dimen/cj_pay_height_58"
        android:layout_height="@dimen/cj_pay_height_58"
        android:layout_marginTop="107dp"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/cj_pay_error_icon"
            android:layout_width="@dimen/cj_pay_height_58"
            android:layout_height="@dimen/cj_pay_height_58"
            android:src="@drawable/cj_pay_icon_pay_timeout"
            android:scaleType="centerCrop"/>
    </FrameLayout>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/cj_pay_color_black_34"
        android:id="@+id/cj_pay_error_tip"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginTop="16dp"
        android:text="@string/cj_pay_network_error"
        android:singleLine="true"
        android:layout_below="@+id/cj_pay_error_icon_layout"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:id="@+id/cj_pay_reconnect_shadow_btn"
        android:paddingLeft="@dimen/cj_pay_padding_4"
        android:paddingRight="@dimen/cj_pay_padding_4"
        android:paddingBottom="@dimen/cj_pay_padding_8"
        android:visibility="gone"
        android:layout_width="@dimen/cj_pay_height_188"
        android:layout_height="@dimen/cj_pay_height_52"
        android:layout_alignTop="@+id/cj_pay_reconnect_btn"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/cj_pay_font_size_17"
        android:textColor="@color/cj_pay_color_white"
        android:gravity="center"
        android:id="@+id/cj_pay_reconnect_btn"
        android:background="@drawable/cj_pay_bg_red_btn_radis_4"
        android:layout_width="@dimen/cj_pay_height_180"
        android:layout_height="@dimen/cj_pay_height_44"
        android:layout_marginTop="20dp"
        android:text="@string/cj_pay_reconnect"
        android:layout_below="@+id/cj_pay_error_tip"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
