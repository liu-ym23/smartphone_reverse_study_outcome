<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.widget.roundcorner.RoundCornerLinearlayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_vertical"
    android:orientation="vertical"
    android:id="@+id/ttlive_input_content_decoration_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginTop="7dp"
    android:layout_marginRight="16dp"
    android:layout_marginBottom="14dp"
    android:minHeight="60dp"
    app:ttlive_allRadius="12dp">
    <FrameLayout
        android:id="@+id/ttlive_input_content_top_decoration"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="35dp">
        <ImageView
            android:id="@+id/ttlive_input_content_decoration_gradient"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:scaleType="fitXY"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="top|left"
                android:id="@+id/ttlive_input_content_decoration_head"
                android:visibility="gone"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="8dp"/>
            <TextView
                android:textSize="11dp"
                android:textColor="#99161823"
                android:ellipsize="end"
                android:layout_gravity="top|left"
                android:id="@+id/ttlive_input_content_decoration_nickname"
                android:paddingLeft="8dp"
                android:paddingRight="81dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="1"/>
        </LinearLayout>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="end"
            android:id="@+id/ttlive_input_content_decoration_badge"
            android:visibility="gone"
            android:layout_width="81dp"
            android:layout_height="26.5dp"
            android:layout_marginTop="0.8dp"
            android:layout_marginRight="0.8dp"/>
    </FrameLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15dp"
            android:textColor="#b0b0b0"
            android:gravity="start|top"
            android:layout_gravity="start"
            android:id="@+id/edit_text_hint"
            android:background="@null"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="8dp"
            android:minHeight="69dp"
            android:maxLines="3"
            android:singleLine="false"
            android:textAlignment="viewStart"/>
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/edit_text_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="8dp"
            android:minHeight="52dp"/>
    </FrameLayout>
</com.bytedance.android.livesdk.widget.roundcorner.RoundCornerLinearlayout>
