<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/progress_area"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="11dp"
            android:typeface="normal"
            android:textColor="@color/ttlive_std_text_white_1"
            android:gravity="center"
            android:id="@+id/pad_progress_current_time"
            android:layout_width="36dp"
            android:layout_height="20dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_marginEnd="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/vs_progress_seekbar"
            app:layout_constraintEnd_toStartOf="@+id/vs_progress_seekbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/vs_progress_seekbar"/>
        <com.bytedance.android.livesdk.chatroom.replay.player.seekbar.ReplaySeekBar
            android:id="@+id/vs_progress_seekbar"
            android:layout_width="0dp"
            android:layout_height="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/progress_end_area"
            app:layout_constraintStart_toEndOf="@+id/pad_progress_current_time"
            app:layout_goneMarginEnd="10dp"
            app:ttlive_background_progress_color="#4dffffff"
            app:ttlive_measure_depend_on_dragging_radius="false"
            app:ttlive_progress_height="3dp"
            app:ttlive_progress_slide_height="10dp"
            app:ttlive_round_point_style="true"
            app:ttlive_secondary_progress_color="@color/transparent"
            app:ttlive_thumb_outer_stroke_color="#1affffff"
            app:ttlive_thumb_radius="6dp"
            app:ttlive_thumb_radius_on_dragging="15dp"
            app:ttlive_track_color="@color/white"
            app:ttlive_track_color_end="@color/white"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/progress_end_area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/vs_progress_seekbar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/vs_progress_seekbar"
            app:layout_constraintTop_toTopOf="@+id/vs_progress_seekbar">
            <TextView
                android:textSize="11dp"
                android:typeface="normal"
                android:textColor="@color/ttlive_std_text_white_1"
                android:gravity="center"
                android:id="@+id/vs_progress_current_time"
                android:layout_width="36dp"
                android:layout_height="20dp"
                android:singleLine="true"
                android:includeFontPadding="false"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/divider"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textColor="@color/ttlive_std_text_white_1"
                android:id="@+id/divider"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_vs_thumb_process_time_middle_line"
                app:layout_constraintLeft_toRightOf="@+id/vs_progress_current_time"
                app:layout_constraintRight_toLeftOf="@+id/vs_progress_total_time"/>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/ttlive_std_text_white_1"
                android:gravity="center"
                android:id="@+id/vs_progress_total_time"
                android:layout_width="36dp"
                android:layout_height="20dp"
                android:singleLine="true"
                android:includeFontPadding="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/divider"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
