<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/larus_bg_bottom_sheet"
    android:paddingTop="?attr/larus_dp_40"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/force_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:paddingStart="?attr/larus_dp_28"
        android:paddingEnd="?attr/larus_dp_28">
        <FrameLayout
            android:id="@+id/force_bind_platform_logo_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:id="@+id/force_bind_platform_logo"
                android:layout_width="?attr/larus_dp_56"
                android:layout_height="?attr/larus_dp_56"/>
        </FrameLayout>
        <TextView
            android:textSize="?attr/larus_dp_22"
            android:textStyle="bold"
            android:textColor="@color/larus_neutral_100"
            android:gravity="center_horizontal"
            android:id="@+id/tv_force_bind_text"
            android:paddingTop="?attr/larus_dp_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/larus_login_douyin_popUp_title"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="?attr/larus_dp_15"
            android:textColor="@color/larus_neutral_70"
            android:gravity="center_horizontal"
            android:id="@+id/tv_force_bind_tips"
            android:paddingTop="?attr/larus_dp_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/larus_login_douyin_popUp_desc"
            android:fontFamily="sans-serif-medium"/>
        <Button
            android:textSize="?attr/larus_dp_16"
            android:textStyle="bold"
            android:textColor="@color/larus_base_1"
            android:id="@+id/button_bind"
            android:background="@drawable/larus_bg_account_button_white"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginTop="?attr/larus_dp_20"
            android:text="@string/larus_login_douyin_popUp_btn"
            android:fontFamily="sans-serif-medium"
            android:elevation="0dp"
            android:stateListAnimator="@null"/>
        <TextView
            android:textSize="?attr/larus_dp_15"
            android:textStyle="bold"
            android:textColor="@color/larus_primary_50"
            android:gravity="center_horizontal"
            android:id="@+id/tv_no_login_use_directly"
            android:paddingBottom="?attr/larus_dp_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_20"
            android:text="@string/larus_login_bottom_link_noLogin"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</LinearLayout>
