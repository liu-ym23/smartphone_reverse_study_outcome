<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="bottom"
        android:id="@+id/business_screen_bar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/screen_bar_tip_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="10dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:background="@drawable/ttlive_business_icon_bg"
            android:layout_width="28dp"
            android:layout_height="14dp"
            android:layout_marginBottom="8dp"
            android:text="@string/ttlive_business_icon"
            android:layout_marginStart="8dp"/>
        <LinearLayout
            android:layout_gravity="bottom|right"
            android:orientation="horizontal"
            android:id="@+id/screen_bar_action_tip_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="8dp">
            <TextView
                android:textSize="10dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_business_screen_bar_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0.5dp"
                android:shadowColor="@color/ttlive_black_60"
                android:shadowRadius="3"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:background="@drawable/live_icon_screenbar_tip_tag"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="1dp"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
