<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_body"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.lark.ui.CommonTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <include layout="@layout/todo_member_page_title_bar"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/assignee_list"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"/>
    <com.larksuite.component.universe_design.tab.UDTabLayout
        android:id="@+id/assignee_tabLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ud_tab_titleSize="14sp"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/assignee_viewPager"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_task_mode"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@color/line_divider_default"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_05"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="?android:attr/selectableItemBackground"
            android:paddingLeft="@dimen/dp_16"
            android:paddingTop="@dimen/dp_8"
            android:paddingRight="@dimen/dp_16"
            android:paddingBottom="@dimen/dp_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/text_title"
                android:gravity="center_vertical"
                android:id="@+id/text_task_mode"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_48"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="16sp"
                android:layout_height="16sp"
                android:tint="@color/icon_n3"
                app:srcCompat="@drawable/ud_icon_right_outlined"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
