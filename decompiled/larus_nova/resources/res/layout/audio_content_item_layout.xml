<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="9dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.larksuite.component.ui.layout.LKUIRoundableLayout
            android:id="@+id/audio_view_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constrainedWidth="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/audio_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/text_title"
                    android:id="@+id/edited_text_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:lineSpacingExtra="@dimen/text_default_line_spacing"/>
                <com.ss.android.lark.widget.light.LKUILightTextView
                    android:id="@+id/edited_rich_text"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"/>
                <ViewStub
                    android:id="@+id/edited_text_translate_content"
                    android:layout="@layout/audio_content_edited_text_translation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <com.suite.lark.platform.component.widget_biz_chatkeyboard.widget.PlayControlBar
                    android:id="@+id/play_cb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/text_title"
                    android:id="@+id/recognized_text_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="@dimen/text_default_line_spacing"/>
                <ViewStub
                    android:id="@+id/recognized_text_translate_content"
                    android:layout="@layout/audio_content_recognized_text_translation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/text_caption"
                    android:id="@+id/recognized_text_flag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/Lark_Chat_AudioConvertToTextSuccess"
                    android:drawablePadding="4dp"
                    android:drawableStart="@drawable/ic_svg_chat_audio_message_text_flag_gray_n500"/>
            </LinearLayout>
        </com.larksuite.component.ui.layout.LKUIRoundableLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/unread_tip_iv"
        android:background="@drawable/common_radius6dp_color_c15"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="@+id/root_view"
        app:layout_constraintTop_toTopOf="@+id/root_view"/>
    <View
        android:id="@+id/audio_mask"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
