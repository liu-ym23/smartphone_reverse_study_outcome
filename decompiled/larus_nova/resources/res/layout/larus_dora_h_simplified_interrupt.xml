<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="?attr/larus_dp_44">
    <FrameLayout
        android:id="@+id/dora_onboarding_top_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/dora_onboarding_interrupt_title"
        app:layout_constraintTop_toTopOf="parent">
        <com.larus.common_ui.video.VideoPlayView
            android:layout_gravity="center"
            android:id="@+id/dora_onboarding_interrupt_mv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="?attr/larus_dp_390"/>
    </FrameLayout>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_24"
        android:textColor="?attr/larus_neutral_100"
        android:id="@+id/dora_onboarding_interrupt_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_dora_onboarding_interrupt_title_cn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"/>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_16"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center_vertical"
        android:id="@+id/dora_onboarding_query_text"
        android:background="@drawable/larus_dora_h_simplified_capsule_bg"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingTop="?attr/larus_dp_12"
        android:paddingRight="?attr/larus_dp_16"
        android:paddingBottom="?attr/larus_dp_12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_20"
        android:maxWidth="302dp"
        android:minHeight="?attr/larus_dp_48"
        android:maxLines="2"
        android:layout_marginStart="?attr/larus_dp_80"
        android:layout_marginEnd="?attr/larus_dp_24"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dora_onboarding_interrupt_title"/>
    <FrameLayout
        android:id="@+id/dora_onboarding_typewriter_container"
        android:background="@drawable/larus_dora_h_simplified_capsule_bg"
        android:paddingLeft="?attr/larus_dp_14"
        android:paddingTop="?attr/larus_dp_12"
        android:paddingRight="?attr/larus_dp_14"
        android:paddingBottom="?attr/larus_dp_12"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_24"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginRight="?attr/larus_dp_24"
        android:minHeight="?attr/larus_dp_92"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dora_onboarding_query_text">
        <FrameLayout
            android:id="@+id/dora_onboarding_typewriter_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="top"
                android:orientation="horizontal"
                android:id="@+id/dora_onboarding_reply_body_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.common_ui.widget.CircleSimpleDraweeView
                    android:id="@+id/dora_onboarding_typewriter_avatar"
                    android:layout_width="?attr/larus_dp_20"
                    android:layout_height="?attr/larus_dp_20"
                    android:layout_marginTop="?attr/larus_dp_2"
                    app:placeholderImage="@drawable/larus_common_ui_avatar_placeholder"
                    app:roundedCornerRadius="?attr/larus_dp_10"/>
                <FrameLayout
                    android:id="@+id/dora_onboarding_reply_content_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="?attr/larus_dp_8">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/dora_onboarding_reply_loading_indicator"
                        android:visibility="gone"
                        android:layout_width="32dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="?attr/larus_dp_4"
                        android:src="@drawable/larus_dora_h_reply_loading_indicator_animated"
                        android:contentDescription="@null"/>
                    <com.larus.dora.impl.view.DoraTextView
                        android:textSize="?attr/larus_sp_16"
                        android:textColor="@color/larus_neutral_100"
                        android:ellipsize="end"
                        android:id="@+id/dora_onboarding_typewriter_text"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="4"
                        android:minLines="4"
                        android:lineSpacingExtra="?attr/larus_dp_1_5"/>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
