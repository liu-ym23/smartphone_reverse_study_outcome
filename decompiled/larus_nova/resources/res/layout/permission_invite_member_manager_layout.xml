<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">
    <ImageView
        android:id="@+id/titleBackIcon"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ud_icon_left_outlined"
        android:tint="@color/icon_n1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/titleTv"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/titleTv"/>
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/text_title"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/titleTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:text="@string/Doc_Share_InviteCollaborator"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_centerInParent="true"
        android:layout_marginEnd="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/titleBackIcon"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larksuite.component.universe_design.notice.UDNotice
        android:id="@+id/bannerTipsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/titleBackIcon"
        app:ud_notice_icon="@drawable/ud_icon_warning_hollow_filled"
        app:ud_notice_text="@string/Doc_Permission_AddUserSendNotice"/>
    <com.larksuite.component.universe_design.notice.UDNotice
        android:id="@+id/bannerTipsLayout2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        app:layout_constraintTop_toBottomOf="@+id/bannerTipsLayout"
        app:layout_goneMarginTop="8dp"
        app:ud_notice_icon="@drawable/ud_icon_warning_hollow_filled"
        app:ud_notice_text="@string/Doc_Permission_ExternalOwnerShareTips"/>
    <com.larksuite.component.universe_design.notice.UDNotice
        android:id="@+id/bannerTipsLayout3"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        app:layout_constraintTop_toBottomOf="@+id/bannerTipsLayout2"
        app:layout_goneMarginTop="8dp"
        app:ud_notice_icon="@drawable/ud_icon_warning_hollow_filled"
        app:ud_notice_text="@string/CreationMobile_Wiki_SharePanel_Invite_desc"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/usersRv"
        android:paddingTop="8dp"
        android:paddingBottom="@dimen/space_kit_len_8"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/notificationLayout"
        app:layout_constraintTop_toBottomOf="@+id/bannerTipsLayout3"
        app:layout_constraintVertical_weight="1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/notificationLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        app:layout_constraintBottom_toBottomOf="parent">
        <View
            android:id="@+id/divider"
            android:background="@color/line_divider_default"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_kit_len_divider"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/containerPermCheckBoxContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/divider2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/divider">
            <com.larksuite.component.universe_design.checkbox.UDCheckBox
                android:id="@+id/containerPermCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <View
                android:id="@+id/containerPermCheckboxWrapper"
                android:visibility="invisible"
                android:layout_width="@dimen/space_kit_len_34"
                android:layout_height="@dimen/space_kit_len_34"/>
        </FrameLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_title"
            android:id="@+id/containerPermTipsTitle"
            android:paddingTop="14dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/CreationMobile_Wiki_SharePanel_AllowAccess_box"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/containerPermTipsDesc"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/containerPermCheckBoxContainer"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_placeholder"
            android:id="@+id/containerPermTipsDesc"
            android:paddingTop="1dp"
            android:paddingBottom="14dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/CreationMobile_Wiki_SharePanel_AllowAccess_OnDesc"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/divider2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/containerPermCheckBoxContainer"
            app:layout_constraintTop_toBottomOf="@+id/containerPermTipsTitle"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/containerPermGroup"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:constraint_referenced_ids="divider, containerPermCheckBoxContainer, containerPermTipsTitle, containerPermTipsDesc"/>
        <View
            android:id="@+id/divider2"
            android:background="@color/line_divider_default"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_kit_len_divider"
            app:layout_constraintTop_toBottomOf="@+id/containerPermTipsDesc"/>
        <com.bytedance.ee.bear.widgets.universedesign.SpaceEditText
            android:gravity="top"
            android:id="@+id/notesInput"
            android:visibility="gone"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:hint="@string/Doc_Permission_AddNotesDesc"
            android:maxLines="5"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/notificationBottomLayout"
            app:layout_constraintTop_toBottomOf="@+id/divider2"
            style="@style/UDEditText"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/notificationBottomLayout"
            android:background="@color/bg_body"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/notesInput">
            <FrameLayout
                android:id="@+id/notificationCheckboxContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.larksuite.component.universe_design.checkbox.UDCheckBox
                    android:id="@+id/notificationCheckbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <View
                    android:id="@+id/notificationCheckboxWrapper"
                    android:visibility="invisible"
                    android:layout_width="@dimen/space_kit_len_34"
                    android:layout_height="@dimen/space_kit_len_34"/>
            </FrameLayout>
            <TextView
                android:enabled="true"
                android:textSize="14sp"
                android:textColor="@drawable/space_kit_txt_color_enable_selector"
                android:gravity="center_vertical"
                android:id="@+id/notificationTv"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Doc_Share_NoticeLark"/>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/static_white"
                android:gravity="center"
                android:id="@+id/inviteBtn"
                android:background="@drawable/facade_round_around_m"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:minWidth="66dp"
                android:text="@string/Doc_Share_CollaboratorInvite"
                android:includeFontPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="16dp"
                android:backgroundTint="@color/space_kit_btn_l1_bg_color_selector"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
