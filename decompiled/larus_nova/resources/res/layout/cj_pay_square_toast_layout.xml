<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/cj_pay_square_toast_view"
        android:background="@drawable/cj_pay_bg_square_toast"
        android:visibility="visible"
        android:layout_width="124dp"
        android:layout_height="120dp">
        <ImageView
            android:id="@+id/cj_pay_square_toast_icon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginTop="24dp"
            android:scaleType="centerCrop"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/cj_pay_color_white_90"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/cj_pay_square_toast_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="一二三四五六七八九十"
            android:maxLines="1"
            android:layout_below="@+id/cj_pay_square_toast_icon"
            android:layout_marginStart="11dp"
            android:layout_marginEnd="11dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/cj_pay_color_white_90"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/cj_pay_square_toast_subtitle"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:layout_below="@+id/cj_pay_square_toast_title"
            android:layout_centerHorizontal="true"
            android:alpha="0.5"
            android:layout_marginStart="11dp"
            android:layout_marginEnd="11dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</FrameLayout>
