<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.ee.bear.bitable.card.view.cell.text.BitableAtEditText
            android:textSize="14sp"
            android:textColor="@color/text_title"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/num_content"
            android:background="@drawable/bitable_card_field_item_bg_selector"
            android:paddingLeft="10dp"
            android:paddingTop="12dp"
            android:paddingRight="50dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:lineSpacingMultiplier="1.2"
            android:imeOptions="actionDone"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/phone_telephone_image_view"
                android:background="@drawable/facade_round_around_s"
                android:padding="4dp"
                android:visibility="gone"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="@dimen/dp_12"
                android:backgroundTint="@color/facade_selector_item_transparent"
                app:srcCompat="@drawable/ud_icon_call_massage_outlined"
                app:tint="@color/icon_n2"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/phone_system_contract_image_view"
                android:background="@drawable/facade_round_around_s"
                android:padding="4dp"
                android:visibility="gone"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="@dimen/dp_12"
                android:backgroundTint="@color/facade_selector_item_transparent"
                app:srcCompat="@drawable/ud_icon_organization_book_outlined"
                app:tint="@color/icon_n2"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
