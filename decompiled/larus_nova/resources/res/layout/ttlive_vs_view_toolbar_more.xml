<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/more_root"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:layout_marginLeft="8dp"
    android:layout_marginStart="8dp">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/more_toolbar_icon_animation"
        android:visibility="gone"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:scaleType="center"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/more_toolbar_icon"
        android:background="@drawable/ttlive_vs_landscape_more_no_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/view_red_dot"
        android:background="@drawable/ttlive_ic_filter_red_point"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="2dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="2dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
