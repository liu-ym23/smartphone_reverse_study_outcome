<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/item_container"
        android:background="@drawable/ttlive_bg_audience_operate_panel_bg"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:id="@+id/triangle"
        android:background="@drawable/ttlive_audience_panel_triangle"
        android:layout_width="@dimen/ttlive_audience_panel_triangle_width"
        android:layout_height="@dimen/ttlive_audience_panel_triangle_height"/>
</LinearLayout>
