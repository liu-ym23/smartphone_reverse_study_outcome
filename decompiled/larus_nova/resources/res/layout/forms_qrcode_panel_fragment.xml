<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/static_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="left"
        android:id="@+id/quitQRCode"
        android:padding="14dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="52dp"
        android:tint="#2b2f36"
        app:srcCompat="@drawable/ud_icon_left_outlined"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/mainContent"
        android:background="@color/static_white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.larksuite.component.universe_design.shadow.UDShadowLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:ud_shadow_radius="16dp"
            style="@style/UDShadow.L.Down">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:background="@drawable/forms_qrcode_main_content_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="24dp"
                android:maxWidth="342dp"
                android:minWidth="320dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/formsCover"
                    android:background="@color/static_white"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"/>
                <TextView
                    android:textSize="20sp"
                    android:textColor="#1f2329"
                    android:ellipsize="end"
                    android:id="@+id/formsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:maxLines="2"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/formsShareLinkQRCode"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_marginTop="24dp"
                    android:scaleType="centerCrop"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#8f959e"
                    android:id="@+id/qrcodeHintTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="30dp"
                    android:text="@string/Bitable_NewSurvey_Settings_ScanViaMobile_Desc"/>
            </LinearLayout>
        </com.larksuite.component.universe_design.shadow.UDShadowLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/baseIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#8f959e"
                android:id="@+id/brandHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="@string/Bitable_NewSurvey_PoweredByBase_Text"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/saveQRCode"
        android:background="@drawable/forms_qrcode_save_bg"
        android:paddingTop="@dimen/dp_12"
        android:paddingBottom="@dimen/dp_12"
        android:layout_width="342dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tint="@color/static_white"
            app:srcCompat="@drawable/ud_icon_download_outlined"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/static_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Bitable_NewSurvey_Mobile_SaveToAlbums_Button"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
</LinearLayout>
