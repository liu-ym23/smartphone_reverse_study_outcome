<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/larus_bg_unselected_action_bar_instruction_widget_item_for_drop_down"
    android:layout_width="wrap_content"
    android:layout_height="?attr/larus_dp_36"
    android:paddingEnd="?attr/larus_dp_14">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="?attr/larus_neutral_100"
        android:id="@+id/tv_drop_down_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_14"
        android:layout_marginEnd="?attr/larus_dp_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="?attr/larus_neutral_100"
        android:ellipsize="marquee"
        android:gravity="center"
        android:id="@+id/tv_selected_option"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/dp_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_drop_down_label"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="?attr/larus_dp_14"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/icon_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_4"
        app:layout_constraintBottom_toBottomOf="@+id/tv_selected_option"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_selected_option"
        app:layout_constraintTop_toTopOf="@+id/tv_selected_option"
        app:srcCompat="?attr/larus_icon_chevron_down_fill"/>
</androidx.constraintlayout.widget.ConstraintLayout>
