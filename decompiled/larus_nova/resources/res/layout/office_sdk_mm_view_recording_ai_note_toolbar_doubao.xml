<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/flow_ud_neutral_70"
        android:gravity="center"
        android:id="@+id/tvDuration"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_marginTop="10dp"
        android:fontFamily="monospace"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/MmAudioWaveBarViewCon"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="4dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDuration">
        <com.ss.android.lark.officesdk.minutes.ui.foundation.widget.wavebar.MmAudioWaveBarView
            android:layout_gravity="center_vertical"
            android:id="@+id/recordWaveBarView"
            android:layout_width="match_parent"
            android:layout_height="32dp"/>
        <View
            android:layout_gravity="start|center_vertical"
            android:id="@+id/gradientLeft"
            android:layout_width="50dp"
            android:layout_height="56dp"/>
        <View
            android:layout_gravity="end|center_vertical"
            android:id="@+id/gradientRight"
            android:layout_width="50dp"
            android:layout_height="56dp"/>
    </FrameLayout>
    <TextView
        android:id="@+id/showVolumeTv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/MmAudioWaveBarViewCon"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/toolbarActionContainer"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/MmAudioWaveBarViewCon"
        app:layout_constraintVertical_bias="0">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/recordKeyPointContainer"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                app:srcCompat="@drawable/office_sdk_mm_ic_record_key_point_doubao"
                app:tint="@color/icon_n3"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_placeholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/View_PersonalNotes_RecordHighlights_Placeholder"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <ImageView
            android:enabled="false"
            android:id="@+id/ivResumePause"
            android:padding="12dp"
            android:layout_width="78dp"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            app:tint="@color/flow_ud_neutral_100"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/flow_ud_neutral_100"
            android:gravity="center"
            android:id="@+id/ivStop"
            android:layout_width="78dp"
            android:layout_height="44dp"
            android:text="@string/View_G_AnnoEnd_Button"
            android:layout_marginStart="16dp"/>
    </LinearLayout>
</merge>
