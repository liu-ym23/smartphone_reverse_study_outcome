<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minWidth="280dp"
    android:minHeight="200dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:layout_width="280dp"
        android:layout_height="200dp"
        android:minWidth="280dp"
        android:minHeight="200dp">
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="24dp"
            android:text="@string/ttlive_report_room_dialog_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#bf161823"
            android:gravity="center"
            android:id="@+id/confirm_hint"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginTop="8dp"
            android:text="@string/ttlive_report_room_dialog_comfirm_hint"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <EditText
            android:id="@+id/reason_editor"
            android:background="#0d161823"
            android:paddingLeft="12dp"
            android:layout_width="240dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:hint="@string/ttlive_report_room_dialog_reason_editor_hint"
            android:maxLength="30"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/confirm_hint"
            app:layout_goneMarginTop="17dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/preview_row"
            android:layout_width="240dp"
            android:layout_height="45dp"
            app:layout_constraintBottom_toTopOf="@+id/divider"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">
            <ImageView
                android:id="@+id/checkbox"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ttlive_ic_report_dialog_check"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#bf161823"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginLeft="2dp"
                android:text="@string/ttlive_report_room_dialog_checkbox_hint"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/checkbox"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/report_dialog_preview"
                android:layout_width="37dp"
                android:layout_height="37dp"
                android:src="#ffffff"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/divider"
            android:background="#1f161823"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintBottom_toTopOf="@+id/button_container"/>
        <LinearLayout
            android:id="@+id/button_container"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            app:layout_constraintBottom_toBottomOf="parent">
            <TextView
                android:textSize="15dp"
                android:textColor="#bf161823"
                android:gravity="center"
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/ttlive_confirm_not_close"
                android:layout_weight="1"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#161823"
                android:gravity="center"
                android:id="@+id/btn_confirm"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/ttlive_confirm_close"
                android:layout_weight="1"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:layout_gravity="center"
        android:id="@+id/mask_view"
        android:background="#40161823"
        android:visibility="gone"
        android:layout_width="280dp"
        android:layout_height="200dp"/>
    <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
        android:layout_gravity="center"
        android:id="@+id/loading_view"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"/>
</FrameLayout>
