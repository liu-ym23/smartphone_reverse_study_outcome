<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/ll_gradient_background"
    android:background="@drawable/ttlive_bg_media_multi_anchor_link_guest_info"
    android:paddingLeft="2dp"
    android:paddingTop="2dp"
    android:paddingRight="2dp"
    android:paddingBottom="2dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="2dp"
    android:paddingEnd="2dp">
    <FrameLayout
        android:id="@+id/icon_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="4dp"
        android:layout_marginEnd="4dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/head"
            android:layout_width="18dp"
            android:layout_height="18dp"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/pad_mute_iv"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"/>
    </FrameLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="3dp"
        android:maxEms="5"
        android:singleLine="true"
        android:layout_marginEnd="3dp"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_follow"
        android:visibility="gone"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ttlive_ic_multi_anchor_link_follow_btn"/>
</LinearLayout>
