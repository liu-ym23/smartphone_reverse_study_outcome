<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/left_component_item_container"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/left_component_item_close"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/aos_left_component_item_close"
        app:layout_constraintLeft_toRightOf="@+id/left_component_item_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/left_component_item_title"/>
    <com.bytedance.awemeopen.apps.framework.base.view.RoundImageView
        android:id="@+id/left_component_item_pic"
        android:layout_width="33dp"
        android:layout_height="44dp"
        app:layout_constraintBottom_toTopOf="@+id/left_component_item_check_book_big"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:radius="4dp"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textStyle="bold"
        android:textColor="#e6ffffff"
        android:gravity="center"
        android:id="@+id/left_component_item_check_book_small"
        android:background="@drawable/aos_left_component_item_look_book_dark"
        android:visibility="gone"
        android:layout_width="76dp"
        android:layout_height="28dp"
        android:text="查看好书"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/left_component_item_check_book_big"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:radius="4dp"
        style="@style/font_size_26"/>
    <com.bytedance.awemeopen.infra.base.image.AoImageView
        android:id="@+id/left_component_item_check_book_arrow"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/aos_left_component_item_arrow"
        app:layout_constraintBottom_toTopOf="@+id/left_component_item_check_book_big"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:gravity="left"
        android:id="@+id/left_component_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:text="书标题标题标题书标题标题标题书标题标题标题书标题标题标题"
        android:maxLines="1"
        app:layout_constraintLeft_toRightOf="@+id/left_component_item_pic"
        app:layout_constraintRight_toLeftOf="@+id/left_component_item_check_book_small"
        app:layout_constraintTop_toTopOf="@+id/left_component_item_pic"
        style="@style/font_size_26"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textColor="#bfffffff"
        android:ellipsize="end"
        android:gravity="left"
        android:id="@+id/left_component_item_des"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="8dp"
        android:text="描述秒速描述秒速描述秒速描述秒速描述秒速"
        app:layout_constraintBottom_toBottomOf="@+id/left_component_item_pic"
        app:layout_constraintLeft_toRightOf="@+id/left_component_item_pic"
        app:layout_constraintRight_toLeftOf="@+id/left_component_item_check_book_small"
        app:layout_constraintTop_toBottomOf="@+id/left_component_item_title"
        style="@style/font_size_24"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/left_component_item_check_book_big"
        android:background="@drawable/aos_left_component_item_look_book_red"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:text="查看好书"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/left_component_item_pic"
        style="@style/font_size_30"/>
</androidx.constraintlayout.widget.ConstraintLayout>
