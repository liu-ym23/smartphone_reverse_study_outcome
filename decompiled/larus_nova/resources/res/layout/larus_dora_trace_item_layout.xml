<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="58dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_10"
        android:textColor="@color/larus_black"
        android:gravity="center"
        android:id="@+id/trace_item_time"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <View
        android:background="@color/larus_neutral_50"
        android:layout_width="1px"
        android:layout_height="match_parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_10"
        android:textColor="@color/larus_black"
        android:gravity="center"
        android:id="@+id/trace_item_ear"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <View
        android:background="@color/larus_neutral_50"
        android:layout_width="1px"
        android:layout_height="match_parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_10"
        android:textColor="@color/larus_black"
        android:gravity="center"
        android:id="@+id/trace_item_doubao"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <View
        android:background="@color/larus_neutral_50"
        android:layout_width="1px"
        android:layout_height="match_parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_10"
        android:textColor="@color/larus_black"
        android:gravity="center"
        android:id="@+id/trace_item_speach"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
</LinearLayout>
