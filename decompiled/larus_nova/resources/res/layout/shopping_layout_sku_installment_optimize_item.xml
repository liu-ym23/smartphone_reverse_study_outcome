<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_sku_installment_item"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="70dp"
    android:layout_marginRight="8dp"
    android:layout_marginEnd="8dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/cl_sku_installment_item"
        android:background="@drawable/shopping_bg_sku_installment_unselected_opt"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:minWidth="@dimen/shopping_sku_installment_item_width">
        <TextView
            android:textColor="@color/shopping_color_161823"
            android:gravity="center_horizontal"
            android:id="@+id/tv_sku_installment_info_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/tv_sku_installment_service_info"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/font_size_28"/>
        <TextView
            android:textColor="@color/ec_color_99161823"
            android:gravity="center_horizontal"
            android:id="@+id/tv_sku_installment_service_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_sku_installment_info_title"
            style="@style/font_size_24"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/ec_color_white"
        android:gravity="center"
        android:layout_gravity="top|right"
        android:id="@+id/tv_sku_installment_benefit"
        android:background="@drawable/shopping_bg_sku_installment_benefit_opt"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginEnd="-4dp"/>
</FrameLayout>
