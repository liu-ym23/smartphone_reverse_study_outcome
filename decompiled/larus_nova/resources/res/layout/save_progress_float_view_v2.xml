<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/progress_container"
    android:background="@drawable/save_progress_window_bg"
    android:padding="1dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/progress_bg_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="2dp"/>
    <View
        android:id="@+id/progress_bg_mask"
        android:background="#57000000"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="2dp"/>
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.uicomponent.loading.CircularProgressView
            android:layout_gravity="center"
            android:id="@+id/iv_loading"
            android:background="@drawable/save_window_bg_upload_progress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cpv_animAutostart="true"
            app:cpv_color="#80ffffff"
            app:cpv_indeterminate="false"
            app:cpv_maxProgress="100"
            app:cpv_startAngle="-90"
            app:cpv_thickness="3dp"/>
        <TextView
            android:textSize="11dp"
            android:textColor="#e5ffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
