<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_body"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/password_encrypt_container"
            android:paddingLeft="19dp"
            android:paddingRight="19dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.28">
            <com.bytedance.ee.bear.widgets.universedesign.SpaceEmptyState
                android:layout_gravity="center_horizontal"
                android:id="@+id/password_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="26dp"
                app:ud_empty_imageRes="@drawable/office_permission_lock"
                app:ud_empty_imageSize="40dp"
                app:ud_empty_title="@string/Doc_Permission_PleaseEnterPasswordAccess"
                style="@style/SpaceEmptyStatusStyle"/>
            <com.bytedance.ee.bear.widgets.universedesign.SpaceEditText
                android:textSize="16sp"
                android:gravity="center"
                android:id="@+id/password_locked_edit_password"
                android:background="@drawable/office_permission_input_bg"
                android:paddingLeft="16dp"
                android:paddingTop="12dp"
                android:paddingRight="16dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:hint="@string/Doc_Permission_PleaseEnterPassowrd"
                android:lines="1"
                android:inputType="textPassword"
                android:imeOptions="actionDone"
                app:ud_backgroundColor="@android:color/transparent"
                app:ud_strokeWidth="0dp"
                style="@style/UDEditText"/>
            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/static_white"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/btn_confirm_password"
                android:background="@drawable/office_permission_primary_button_disabled"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:text="@string/Doc_Facade_Confirm"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
