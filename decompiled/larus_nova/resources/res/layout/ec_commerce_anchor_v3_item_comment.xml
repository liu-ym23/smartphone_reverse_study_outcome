<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ui.base.widget.round.RoundLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ec_commerce_anchor_v3_item_comment_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bg_color="@color/white">
    <include
        android:id="@+id/comment_truth_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        layout="@layout/ec_comment_truth_tip_view"/>
    <com.bytedance.android.shopping.anchorv3.comment.widget.CommentHeaderView
        android:id="@+id/comment_header_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/comment_content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">
        <TextView
            android:textSize="14dp"
            android:textColor="#bf161823"
            android:ellipsize="end"
            android:id="@+id/comment_content"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"/>
        <com.bytedance.android.shopping.anchorv3.comment.widget.CommentMediaView
            android:id="@+id/comment_media_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="16dp"/>
        <com.bytedance.android.shopping.anchorv3.comment.widget.CommentReplyView
            android:id="@+id/comment_reply_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/append_container"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <FrameLayout
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:textSize="12sp"
                android:textColor="#80161823"
                android:ellipsize="end"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/comment_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.bytedance.android.shopping.anchorv3.comment.widget.CommentInteractiveView
                android:id="@+id/comment_bottom_interactive_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/comment_meaningless_fl"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:layout_gravity="top"
                android:background="@color/commerce_color_1F161823"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="4dp"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/comment_meaningless_ll"
                android:layout_width="match_parent"
                android:layout_height="47dp"
                android:layout_marginTop="4.5dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/commerce_color_99161823"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/comment_meaningless_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ec_arrow_right_meaningless_comment_new"
                    android:scaleType="fitXY"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</com.bytedance.android.ui.base.widget.round.RoundLinearLayout>
