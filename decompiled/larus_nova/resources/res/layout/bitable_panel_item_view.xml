<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/item_wrapper"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/space_kit_font_14"
        android:textColor="@color/text_caption"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/groupTitle"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/space_kit_len_20"
        android:layout_marginLeft="@dimen/space_kit_len_16"
        android:layout_marginRight="@dimen/space_kit_len_16"
        android:layout_marginBottom="@dimen/space_kit_len_4"
        android:singleLine="true"
        android:includeFontPadding="false"/>
    <com.bytedance.ee.bear.facade.common.widget.RoundFrameLayout
        android:id="@+id/item_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_kit_len_16"
        android:layout_marginEnd="@dimen/space_kit_len_16"/>
    <TextView
        android:textSize="@dimen/space_kit_font_14"
        android:textColor="@color/text_placeholder"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/bottomDesc"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/space_kit_len_20"
        android:layout_marginLeft="@dimen/space_kit_len_16"
        android:layout_marginTop="@dimen/space_kit_len_2"
        android:layout_marginRight="@dimen/space_kit_len_16"
        android:layout_marginBottom="@dimen/space_kit_len_2"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:paddingStart="@dimen/space_kit_len_16"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/v_divider"
        android:background="@drawable/common_panel_divider_drawable"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_kit_len_divider"
        android:layout_marginLeft="@dimen/space_kit_len_16"
        android:layout_marginRight="@dimen/space_kit_len_16"/>
</LinearLayout>
