<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_live_white_round_16"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/live_dialog_image_block"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/live_dialog_image"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="50dp"
        android:layout_marginRight="50dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"/>
    <View
        android:id="@+id/live_dialog_top_block"
        android:layout_width="match_parent"
        android:layout_height="16dp"/>
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_live_dialog_title"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/live_dialog_title"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:lines="1"/>
    <View
        android:id="@+id/live_dialog_title_message_block"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_live_dialog_message"
        android:gravity="center_horizontal"
        android:id="@+id/live_dialog_message"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="20dp"/>
    <View
        android:id="@+id/live_dialog_bottom_block"
        android:layout_width="match_parent"
        android:layout_height="16dp"/>
    <FrameLayout
        android:id="@+id/live_dialog_frame"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/live_dialog_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/live_dialog_divider_1"
            style="@style/ttlive_live_dialog_divider_trial_broadcast_vertical"/>
        <Button
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:id="@+id/live_dialog_btn_1"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="48dp"/>
        <View
            android:id="@+id/live_dialog_divider_2"
            style="@style/ttlive_live_dialog_divider_trial_broadcast_vertical"/>
        <Button
            android:textSize="15dp"
            android:textColor="#bf161823"
            android:id="@+id/live_dialog_btn_2"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="48dp"/>
        <View
            android:id="@+id/live_dialog_divider_3"
            style="@style/ttlive_live_dialog_divider_trial_broadcast_vertical"/>
        <Button
            android:textSize="15dp"
            android:textColor="#bf161823"
            android:id="@+id/live_dialog_btn_3"
            android:background="@drawable/ttlive_bg_live_white_down_round_16"
            android:layout_width="match_parent"
            android:layout_height="48dp"/>
    </LinearLayout>
</LinearLayout>
