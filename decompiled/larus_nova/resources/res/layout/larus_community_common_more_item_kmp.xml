<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ProgressBar
        android:layout_gravity="center_horizontal"
        android:id="@+id/loading_view"
        android:layout_width="?attr/larus_dp_32"
        android:layout_height="?attr/larus_dp_32"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:indeterminateTint="@color/larus_neutral_50"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/error_lay"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_64">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="?attr/larus_dp_13"
            android:layout_height="?attr/larus_dp_16"
            android:src="@drawable/larus_ic_refresh_gray"/>
        <TextView
            android:textColor="@color/larus_neutral_50"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_chat_list_load_failed"
            android:layout_marginStart="?attr/larus_dp_8"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/end_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:src="@drawable/larus_item_template_end"/>
</merge>
