<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_body"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.lark.ui.CommonTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.ss.android.lark.picker.Picker
        android:id="@+id/todo_chatter_picker"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_batch_assign"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@color/line_divider_default"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_05"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/bottom_batch_assign_button"
            android:background="@drawable/item_bg_selector_c11"
            android:padding="@dimen/dp_16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/bottom_batch_assign_icon"
                android:layout_width="20sp"
                android:layout_height="20sp"
                app:srcCompat="@drawable/ud_icon_team_add_outlined"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/text_link_normal"
                android:id="@+id/bottom_batch_assign_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Todo_MultiselectMembersToAssignTasks_Button"
                android:layout_marginStart="@dimen/dp_12"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_next_step_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@color/line_divider_default"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_05"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_51">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/text_link_normal"
                android:gravity="center_vertical"
                android:id="@+id/next_step_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_16"/>
            <com.larksuite.component.universe_design.button.UDButton
                android:enabled="false"
                android:textSize="@dimen/sp_14"
                android:textColor="@color/static_white"
                android:gravity="center"
                android:id="@+id/layout_step_btn"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Todo_TaskList_ShareNext_Button"
                android:paddingStart="@dimen/dp_16"
                android:paddingEnd="@dimen/dp_16"
                android:layout_marginEnd="@dimen/dp_16"
                app:ud_backgroundColor="@color/ud_button_blue_bg"
                app:ud_radius="m"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
