<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.ui.ClipImageView
        android:id="@+id/iv_contribute_avatar_1"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.ui.ClipImageView
        android:id="@+id/iv_contribute_avatar_2"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:translationX="-4dp"
        app:layout_constraintLeft_toRightOf="@+id/iv_contribute_avatar_1"
        app:layout_constraintTop_toTopOf="@+id/iv_contribute_avatar_1"/>
    <com.bytedance.android.live.ui.ClipImageView
        android:id="@+id/iv_contribute_avatar_3"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:translationX="-8dp"
        app:layout_constraintLeft_toRightOf="@+id/iv_contribute_avatar_2"
        app:layout_constraintTop_toTopOf="@+id/iv_contribute_avatar_2"/>
</merge>
