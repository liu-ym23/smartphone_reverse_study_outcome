<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.shopping.feed.resourcecard.view.PanelViewWrapper
        android:id="@+id/panel_view_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/panel_view_2"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.shopping.feed.resourcecard.view.PanelViewWrapper
        android:id="@+id/panel_view_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintLeft_toRightOf="@+id/panel_view_1"
        app:layout_constraintRight_toLeftOf="@+id/panel_view_3"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.shopping.feed.resourcecard.view.PanelViewWrapper
        android:id="@+id/panel_view_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintLeft_toRightOf="@+id/panel_view_2"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
