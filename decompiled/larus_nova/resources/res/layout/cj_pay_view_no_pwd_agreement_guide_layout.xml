<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/no_pwd_guide_root_layout"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:id="@+id/no_pwd_agreement_guide_layout_checkbox"
        android:visibility="visible"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.android.ttcjpaysdk.base.theme.widget.CJPayCircleCheckBox
            android:id="@+id/no_pwd_guide_checkbox"
            android:layout_width="16dp"
            android:layout_height="16dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
            android:gravity="top|left"
            android:id="@+id/no_pwd_guide_text_agreement_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="-1dp"
            android:lineSpacingExtra="@dimen/cj_pay_padding_2"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/no_pwd_agreement_guide_layout_switch"
        android:visibility="visible"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.android.ttcjpaysdk.base.theme.widget.CJPaySwitch
            android:id="@+id/no_pwd_guide_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumb="@drawable/cj_pay_switch_thumb_selector"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:track="@drawable/cj_pay_switch_track_selector"
            android:switchMinWidth="24dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
            android:gravity="top|left"
            android:id="@+id/no_pwd_guide_text_agreement_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="0dp"
            android:layout_marginTop="0dp"
            android:layout_marginRight="12dp"
            android:includeFontPadding="false"
            android:layout_toLeftOf="@+id/no_pwd_guide_switch"/>
    </LinearLayout>
    <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
        android:textSize="15sp"
        android:textColor="@color/cj_pay_color_white"
        android:gravity="center"
        android:id="@+id/tv_next_open_and_pay"
        android:background="@drawable/cj_pay_bg_red_btn_radius_4"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_custom_button_height_44"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="24dp"
        android:includeFontPadding="false"/>
</LinearLayout>
