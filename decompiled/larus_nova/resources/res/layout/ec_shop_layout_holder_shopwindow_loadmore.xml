<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:paddingTop="2dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/shopping_bg_line_border_stroke"
        android:paddingLeft="16dp"
        android:paddingTop="4dp"
        android:paddingRight="16dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ec_shop_60161823"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ec_shop_live_hot_load_more_des"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ec_shop_60161823"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ec_shop_live_hot_load_more_left_bracket"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ec_shop_60161823"
            android:layout_gravity="center_vertical"
            android:id="@+id/ec_shop_tv_hotsale_remain_product_cnt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ec_shop_60161823"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ec_shop_live_hot_load_more_right_bracket"/>
    </LinearLayout>
</LinearLayout>
