<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_container"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="72dp">
    <FrameLayout
        android:id="@+id/circle_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="52dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="14dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/history_cover"
            android:layout_width="44dp"
            android:layout_height="44dp"/>
        <com.bytedance.android.live.core.view.LiveCircleView
            android:layout_gravity="center"
            android:id="@+id/history_live_circle"
            android:padding="4dp"
            android:layout_width="52dp"
            android:layout_height="52dp"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/history_icon_tag"
        android:visibility="gone"
        android:layout_width="34dp"
        android:layout_height="14dp"
        android:layout_marginTop="46dp"
        android:src="@drawable/ttlive_history_tag_image"
        app:layout_constraintLeft_toLeftOf="@+id/circle_container"
        app:layout_constraintRight_toRightOf="@+id/circle_container"
        app:layout_constraintTop_toTopOf="@+id/circle_container"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/history_anchor_info"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginRight="15dp"
        android:layout_weight="1"
        android:layout_marginEnd="15dp"
        app:layout_constraintLeft_toRightOf="@+id/circle_container"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/circle_container">
        <TextView
            android:textSize="15sp"
            android:textColor="#e6ffffff"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/history_nickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:lineSpacingExtra="0dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#80ffffff"
            android:ellipsize="end"
            android:id="@+id/history_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:singleLine="true"
            android:lineSpacingExtra="0dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
