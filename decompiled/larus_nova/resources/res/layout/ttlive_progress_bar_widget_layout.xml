<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.chatroom.progressbar.ForceInterceptConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/progress_area"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="11dp"
            android:typeface="normal"
            android:textColor="@color/ttlive_std_text_white_1"
            android:gravity="center"
            android:id="@+id/progress_current_time"
            android:layout_width="50dp"
            android:layout_height="20dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:alpha="0.8"
            app:layout_constraintBottom_toBottomOf="@+id/vs_progress_seekbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/vs_progress_seekbar"/>
        <com.bytedance.android.livesdk.chatroom.progressbar.ui.PlayerSeekBar
            android:id="@+id/vs_progress_seekbar"
            android:layout_width="0dp"
            android:layout_height="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/progress_end_area"
            app:layout_constraintStart_toEndOf="@+id/progress_current_time"
            app:layout_goneMarginEnd="10dp"
            app:ttlive_background_progress_color="@color/ttlive_progress_track_bg_color"
            app:ttlive_measure_depend_on_dragging_radius="false"
            app:ttlive_progress_height="2dp"
            app:ttlive_round_point_style="true"
            app:ttlive_secondary_progress_color="@color/transparent"
            app:ttlive_thumb_outer_stroke_color="@color/ttlive_vs_progress_outer_stroke_color"
            app:ttlive_thumb_radius="4dp"
            app:ttlive_thumb_radius_on_dragging="15dp"
            app:ttlive_track_color="@color/ttlive_vs_progress_track_color"
            app:ttlive_track_color_end="@color/ttlive_vs_progress_track_end_color"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/progress_end_area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/vs_progress_seekbar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/vs_progress_seekbar">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/vs_seek_to_now"
                android:visibility="gone"
                android:layout_width="42dp"
                android:layout_height="20dp"
                android:layout_marginLeft="14dp"
                android:layout_marginRight="14dp"
                android:src="@drawable/ttlive_vs_first_show_seek_to_now"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.bytedance.android.livesdk.chatroom.progressbar.ForceInterceptConstraintLayout>
