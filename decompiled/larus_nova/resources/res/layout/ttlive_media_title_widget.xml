<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/media_replay_label"
        android:paddingRight="6dp"
        android:visibility="gone"
        android:layout_width="34dp"
        android:layout_height="0dp"
        android:src="@drawable/ttlive_media_replay_label"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <com.bytedance.android.uicomponent.FadingEdgeHorizontalScrollView
        android:id="@+id/sv_media_title"
        android:scrollbars="none"
        android:fadingEdgeLength="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:requiresFadingEdge="horizontal"
        app:layout_constraintLeft_toRightOf="@+id/media_replay_label"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="left"
            android:id="@+id/media_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </com.bytedance.android.uicomponent.FadingEdgeHorizontalScrollView>
    <TextView
        android:textSize="19dp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:id="@+id/media_landscape_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="300dp"
        android:maxWidth="430dp"
        android:maxLines="1"
        app:layout_constraintLeft_toRightOf="@+id/media_replay_label"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.common.MarqueeTextView
        android:id="@+id/marquee_media_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@+id/media_replay_label"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/media_title_icon"
        android:background="@drawable/ttlive_media_title_icon"
        android:layout_width="9dp"
        android:layout_height="5dp"
        android:layout_marginLeft="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/sv_media_title"
        app:layout_constraintLeft_toRightOf="@+id/sv_media_title"
        app:layout_constraintTop_toTopOf="@+id/sv_media_title"/>
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:id="@+id/test_title"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
