<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_container"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/title_bar">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:background="?attr/larus_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">
        <com.larus.bmhome.view.item.ItemTextToggle
            android:id="@+id/tts_background_play_toggle"
            android:background="@drawable/larus_bg_voice_edit_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_8"
            android:text="@string/larus_botVoice_toggleHeader_bgPlayback"
            android:layout_marginStart="?attr/larus_dp_16"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_scrollFlags="scroll"/>
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/coll"
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="exitUntilCollapsed|scroll">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.voice_setting.voice.mix.VoiceEditArea
                    android:id="@+id/voice_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/larus_voice_tool_bar_marginBottom"
                    android:layout_marginStart="?attr/larus_dp_16"
                    android:layout_marginEnd="?attr/larus_dp_16"/>
            </LinearLayout>
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/mix_tool_bar"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/larus_voice_tool_bar_marginBottom"
                android:layout_marginEnd="?attr/larus_dp_16"
                app:layout_collapseMode="pin">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="?attr/larus_dp_52"/>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/new_tablayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/larus_dp_12"
            android:layout_marginRight="?attr/larus_dp_12"
            app:tabGravity="fill"
            app:tabIndicator="?attr/larus_tab_bottom"
            app:tabIndicatorColor="?attr/larus_neutral_100"
            app:tabIndicatorFullWidth="false"
            app:tabMaxWidth="?attr/larus_dp_200"
            app:tabMinWidth="?attr/larus_dp_10"
            app:tabMode="fixed"
            app:tabPaddingBottom="?attr/larus_dp_8"
            app:tabPaddingEnd="?attr/larus_dp_12"
            app:tabPaddingStart="?attr/larus_dp_12"
            app:tabPaddingTop="?attr/larus_dp_8"
            app:tabRippleColor="@android:color/transparent"
            app:tabSelectedTextColor="?attr/larus_neutral_100"
            app:tabTextAppearance="@style/larus_multi_tab_layout"
            app:tabTextColor="?attr/larus_neutral_50"/>
        <View
            android:background="?attr/larus_neutral_transparent_2"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_0_5"/>
    </com.google.android.material.appbar.AppBarLayout>
    <FrameLayout
        android:id="@+id/voice_bar_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/larus_voice_tool_bar_marginBottom"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16">
        <com.larus.voice_setting.voice.mix.VoiceMixBar
            android:id="@+id/mix_voice_bar"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/larus_voice_tool_bar_height"/>
        <com.larus.voice_setting.voice.mix.SingleVoiceBar
            android:id="@+id/single_voice_bar"
            android:background="?attr/larus_bg_voice_edit_area"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/larus_voice_tool_bar_height"/>
    </FrameLayout>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/new_view_pager2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
