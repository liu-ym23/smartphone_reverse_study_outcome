<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <View
        android:id="@+id/container_bg"
        android:background="@drawable/ttlive_minors_notice_gradient_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/notice_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="7dp"
        android:src="@drawable/ttlive_minors_notice_icon"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="11dp"
        android:textColor="#e6ffffff"
        android:id="@+id/notice_text"
        android:layout_width="wrap_content"
        android:layout_height="15dp"
        android:layout_marginTop="7dp"
        android:text="@string/ttlive_gift_forbiden_minors_consume"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/notice_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/close_area"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/close_icon"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:layout_marginTop="11dp"
        android:src="@drawable/ttlive_minors_close_icon"
        android:layout_marginEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
