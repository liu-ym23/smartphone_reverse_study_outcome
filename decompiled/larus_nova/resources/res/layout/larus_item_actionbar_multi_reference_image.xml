<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/larus_bg_action_bar_instruction_widget_item"
    android:layout_width="wrap_content"
    android:layout_height="?attr/larus_dp_36"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_goneMarginTop="?attr/larus_dp_0">
    <LinearLayout
        android:id="@+id/reference_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/reference_image_hot_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="?attr/larus_dp_8">
            <androidx.cardview.widget.CardView
                android:id="@+id/reference_image_container"
                android:background="?attr/larus_base_2_overlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="?attr/larus_dp_4"
                app:cardElevation="?attr/larus_dp_0">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/reference_image_view"
                    android:layout_width="?attr/larus_dp_24"
                    android:layout_height="?attr/larus_dp_24"
                    app:placeholderImage="?attr/larus_icon_add_photo_fill"/>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="?attr/larus_neutral_100"
                android:id="@+id/reference_image_after_click_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="?attr/larus_dp_4"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/reference_close_view"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="?attr/larus_dp_9"
            android:paddingEnd="?attr/larus_dp_12">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:layout_width="?attr/larus_dp_12"
                android:layout_height="?attr/larus_dp_12"
                app:srcCompat="?attr/larus_icon_close"/>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/reference_idle_container"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_36"
        android:layout_marginStart="?attr/larus_dp_14"
        android:layout_marginEnd="?attr/larus_dp_14">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:layout_width="?attr/larus_dp_14"
            android:layout_height="?attr/larus_dp_14"
            app:srcCompat="?attr/larus_icon_add_photo_fill"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_100"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_reference_image"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_4"/>
    </LinearLayout>
</LinearLayout>
