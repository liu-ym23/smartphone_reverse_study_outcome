<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="?attr/larus_neutral_100"
        android:id="@+id/tv_loading_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginEnd="?attr/larus_dp_4"/>
    <View
        android:id="@+id/v_dot1"
        android:background="@drawable/larus_bg_loading_dot"
        android:layout_width="?attr/larus_dp_8"
        android:layout_height="?attr/larus_dp_8"/>
    <View
        android:id="@+id/v_dot2"
        android:background="@drawable/larus_bg_loading_dot"
        android:layout_width="?attr/larus_dp_8"
        android:layout_height="?attr/larus_dp_8"
        android:layout_marginLeft="?attr/larus_dp_6"
        android:layout_marginRight="?attr/larus_dp_6"/>
    <View
        android:id="@+id/v_dot3"
        android:background="@drawable/larus_bg_loading_dot"
        android:layout_width="?attr/larus_dp_8"
        android:layout_height="?attr/larus_dp_8"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="?attr/larus_neutral_100"
        android:id="@+id/progress_text_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</merge>
