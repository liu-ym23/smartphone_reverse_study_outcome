<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:id="@+id/root"
    android:background="@drawable/ttlive_core_bg_progressdialog"
    android:paddingTop="24dp"
    android:paddingBottom="16dp"
    android:layout_width="140dp"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/customProgressView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/iv_loading"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ttlive_core_ic_loading_big"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/ttlive_core_s1"
            android:gravity="center"
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_core_ss_progress_text"
        android:gravity="center"
        android:id="@+id/message"
        android:paddingTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/customProgressView"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
