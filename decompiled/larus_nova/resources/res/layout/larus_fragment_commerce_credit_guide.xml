<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_credit_page_dialog"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="?attr/larus_dp_32"
        android:layout_height="?attr/larus_dp_32"
        android:layout_marginTop="?attr/larus_dp_12"
        android:src="@drawable/larus_ic_close_dialog"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/iv_guide_icon"
        android:layout_width="?attr/larus_dp_56"
        android:layout_height="?attr/larus_dp_56"
        app:actualImageScaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_close"
        app:placeholderImage="@drawable/larus_icon_lightening_white"
        app:placeholderImageScaleType="fitCenter"/>
    <TextView
        android:textSize="?attr/larus_dp_22"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:paddingLeft="?attr/larus_dp_28"
        android:paddingRight="?attr/larus_dp_28"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_20"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_guide_icon"/>
    <TextView
        android:textSize="?attr/larus_dp_15"
        android:textColor="@color/larus_neutral_70"
        android:gravity="center"
        android:id="@+id/tv_desc"
        android:paddingLeft="?attr/larus_dp_28"
        android:paddingRight="?attr/larus_dp_28"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:lineSpacingExtra="?attr/larus_dp_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/btn_big_ok"
        android:background="@drawable/larus_bg_btn_guide_action"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginLeft="?attr/larus_dp_28"
        android:layout_marginTop="?attr/larus_dp_20"
        android:layout_marginRight="?attr/larus_dp_28"
        android:layout_marginBottom="?attr/larus_dp_36"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_desc"/>
</androidx.constraintlayout.widget.ConstraintLayout>
