<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ec.window.base.view.ECWindowMultiDispatchFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_store_root_container"
    android:background="@color/ec_store_root_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ec_shop_live_container_lowest_wrapper"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.ec.window.base.view.ECWindowOnlyAcceptClickFrameLayout
            android:id="@+id/ec_shop_live_container_lowest"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="375dp"/>
        <FrameLayout
            android:background="@drawable/shopping_shop_bg_bottom_mask_dark"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/ec_shop_background_container_dialog"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ec_shop_head_background_height"/>
    <FrameLayout
        android:id="@+id/ec_shop_background_second_dialog"
        android:background="@android:color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ec_shop_head_background_height"
        android:alpha="0"/>
    <include layout="@layout/ec_window_layout_backgound_v2"/>
    <com.bytedance.android.ec.window.base.widget.ECWindowOverScrollExpandCoordinatorLayout
        android:id="@+id/ec_shop_coordinator_layout"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.window.shop.home.view.WindowClickableByAlphaFrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/ec_window_cropped_header_container"
            android:background="@color/commerce_color_FFFFFF"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.window.shop.home.view.WindowClickableByAlphaFrameLayout
            android:id="@+id/ec_window_full_screen_header_container"
            android:visibility="invisible"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/ec_shop_app_bar_layout"
            android:tag="no_fling"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp"
            app:layout_behavior="com.bytedance.android.ec.window.base.widget.ECWindowOverScrollExpandBehavior">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/ec_shop_background_container_collapsingToolbarLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_scrollFlags="snap|exitUntilCollapsed|scroll">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ec_shop_background_container_wrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:id="@+id/ec_shop_background_container"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        app:layout_constraintBottom_toBottomOf="@+id/ec_shop_tool_bar_first"
                        app:layout_constraintTop_toTopOf="@+id/ec_shop_tool_bar_first">
                        <include
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            layout="@layout/ec_window_layout_background"/>
                    </FrameLayout>
                    <FrameLayout
                        android:id="@+id/ec_shop_background_second"
                        android:background="@android:color/white"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:alpha="0"
                        app:layout_constraintBottom_toBottomOf="@+id/ec_shop_tool_bar_first"
                        app:layout_constraintTop_toTopOf="@+id/ec_shop_tool_bar_first"/>
                    <RelativeLayout
                        android:gravity="bottom"
                        android:id="@+id/ec_shop_tool_bar_first"
                        android:tag="unpinned"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_collapseMode="none">
                        <com.bytedance.android.ec.window.base.widget.ECWindowOverScrollExpandContainer
                            android:id="@+id/ec_shop_live_container_wrapper"
                            android:tag="ecOverScrollExpandTarget"
                            android:layout_width="match_parent"
                            android:layout_height="140dp">
                            <com.bytedance.android.ec.window.base.view.ECWindowOnlyAcceptClickFrameLayout
                                android:id="@+id/ec_store_live_container"
                                android:focusable="true"
                                android:visibility="invisible"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/ec_window_split_close_accessible"/>
                        </com.bytedance.android.ec.window.base.widget.ECWindowOverScrollExpandContainer>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/ec_shop_info_area_container_wrapper"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/ec_shop_live_container_wrapper">
                            <FrameLayout
                                android:id="@+id/ec_shop_info_area_bg_container"
                                android:clickable="false"
                                android:clipChildren="true"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                app:layout_constraintBottom_toBottomOf="@+id/ec_shop_info_area_container"
                                app:layout_constraintTop_toTopOf="@+id/ec_shop_info_area_container"/>
                            <FrameLayout
                                android:id="@+id/ec_shop_info_area_container"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>
                            <FrameLayout
                                android:id="@+id/ec_window_info_adjust_placeholder"
                                android:visibility="invisible"
                                android:clickable="false"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                app:layout_constraintTop_toBottomOf="@+id/ec_shop_info_area_container"/>
                            <FrameLayout
                                android:id="@+id/ec_window_cropped_pinned_list_container"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:layout_constraintTop_toBottomOf="@+id/ec_window_info_adjust_placeholder"/>
                        </LinearLayout>
                    </RelativeLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ec_shop_content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <com.bytedance.android.ec.common.impl.view.RoundCornerLinearlayout
                android:orientation="vertical"
                android:background="@color/commerce_color_FFFFFF"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="4dp"
                app:ec_leftTopRadius="@dimen/ec_window_panel_radius"
                app:ec_rightTopRadius="@dimen/ec_window_panel_radius">
                <FrameLayout
                    android:layout_gravity="bottom"
                    android:id="@+id/ec_shop_tab_bar_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <include layout="@layout/ec_window_layout_tab_bar"/>
                </FrameLayout>
                <FrameLayout
                    android:background="@color/commerce_color_FFFFFF"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <include
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        layout="@layout/ec_shop_layout_struct_group_plan_a"/>
                    <include layout="@layout/ec_shop_layout_tab_container"/>
                </FrameLayout>
            </com.bytedance.android.ec.common.impl.view.RoundCornerLinearlayout>
        </LinearLayout>
    </com.bytedance.android.ec.window.base.widget.ECWindowOverScrollExpandCoordinatorLayout>
    <com.bytedance.android.window.shop.home.view.WindowClickableByAlphaFrameLayout
        android:id="@+id/ec_shop_top_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/ec_shop_status_view_container"
        android:background="@android:color/white"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.ec.window.base.status.WindowLazyStatusView
            android:layout_gravity="center"
            android:id="@+id/ec_shop_status_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="end|bottom"
        android:id="@+id/ec_shop_float_cart_entry_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="14dp"
        android:layout_marginBottom="98dp"
        android:layout_marginEnd="14dp"/>
    <FrameLayout
        android:layout_gravity="end|bottom"
        android:id="@+id/ec_shop_float_go_top_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="14dp"
        android:layout_marginBottom="44dp"
        android:layout_marginEnd="14dp"/>
</com.bytedance.android.ec.window.base.view.ECWindowMultiDispatchFrameLayout>
