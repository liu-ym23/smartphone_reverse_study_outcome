<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/cj_pay_face_guide_dialog_panel_container"
    android:background="@drawable/cj_pay_bg_face_translucent"
    android:layout_width="124dp"
    android:layout_height="124dp">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/translucent_gif_container"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginTop="20dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/cj_pay_color_white"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/translucent_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:singleLine="true"/>
</LinearLayout>
