<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/search_bg_commodity_network_fail_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.ies.dmt.ui.widget.DmtTextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/TextReverse"
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/search_commodity_network_fail_title"/>
    <com.bytedance.ies.dmt.ui.widget.DmtTextView
        android:textSize="14sp"
        android:textColor="@color/TextReverse2"
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/search_commodity_network_fail_content"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="#00000000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:textSize="15sp"
            android:textColor="@color/TextReverse2"
            android:gravity="center"
            android:id="@+id/tv_retry"
            android:background="@drawable/search_commodity_network_fail_border_right"
            android:paddingTop="13.5dp"
            android:paddingBottom="13.5dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/search_commodity_network_fail_retry"
            android:layout_weight="1"/>
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/TextReverse2"
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:background="@drawable/search_commodity_network_fail_border_left"
            android:paddingTop="13.5dp"
            android:paddingBottom="13.5dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/search_commodity_network_fail_cancel"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
