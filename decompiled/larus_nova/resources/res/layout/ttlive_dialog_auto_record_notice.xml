<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_auto_record_dialog"
    android:paddingLeft="20dp"
    android:paddingTop="32dp"
    android:paddingRight="20dp"
    android:clipToPadding="false"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:id="@+id/ll_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_content">
        <ToggleButton
            android:id="@+id/btn_toggle"
            android:background="@drawable/ttlive_bg_auto_record_dialog_cb"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:textOn=""
            android:textOff=""/>
        <TextView
            android:textSize="14dp"
            android:textColor="#80161823"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:text="@string/ttlive_record_notice_not_again"
            android:includeFontPadding="false"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
    <TextView
        android:textSize="14dp"
        android:textColor="#bf161823"
        android:gravity="center"
        android:id="@+id/tv_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_record_notice_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/v_divider"
        android:background="#1f161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="12dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_toggle"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_divider">
        <TextView
            android:textSize="15dp"
            android:textColor="#bf161823"
            android:gravity="center"
            android:id="@+id/btn_left"
            android:layout_width="0dp"
            android:layout_height="47.5dp"
            android:text="@string/ttlive_record_notice_disallow"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/v_divider2"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#bf161823"
            android:gravity="center"
            android:id="@+id/btn_right"
            android:layout_width="0dp"
            android:layout_height="47.5dp"
            android:text="@string/ttlive_record_notice_allow"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toRightOf="@+id/v_divider2"
            app:layout_constraintRight_toRightOf="parent"/>
        <View
            android:id="@+id/v_divider2"
            android:background="#1f161823"
            android:layout_width="0.5dp"
            android:layout_height="47.5dp"
            app:layout_constraintLeft_toRightOf="@+id/btn_left"
            app:layout_constraintRight_toLeftOf="@+id/btn_right"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
