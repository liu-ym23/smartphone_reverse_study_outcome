<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cj_pay_authorization_root_view"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="start"
        android:id="@+id/iv_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="13dp"
        android:src="@drawable/cj_pay_icon_authorization_close"/>
    <RelativeLayout
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginLeft="@dimen/cj_pay_padding_16"
        android:layout_marginRight="@dimen/cj_pay_padding_16">
        <TextView
            android:textSize="16sp"
            android:textColor="#161823"
            android:id="@+id/tv_auth_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="54dp"
            android:includeFontPadding="false"
            style="@style/CJPayShadowTextStyle"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#99161823"
            android:id="@+id/tv_auth_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:includeFontPadding="false"
            android:layout_below="@+id/tv_auth_title"/>
        <include
            android:id="@+id/tv_user_agreement_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="64dp"
            android:layout_alignParentBottom="true"
            layout="@layout/cj_pay_common_protocol_layout"/>
        <RelativeLayout
            android:id="@+id/layout_next_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="218dp"
            android:layout_alignWithParentIfMissing="true">
            <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
                android:textSize="@dimen/cj_pay_font_size_15"
                android:textColor="@color/cj_pay_color_white"
                android:gravity="center"
                android:id="@+id/btn_next_step"
                android:background="#fe2c55"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/cj_pay_authorization_agree"
                android:includeFontPadding="false"/>
            <ProgressBar
                android:id="@+id/iv_loading"
                android:background="@color/cj_pay_color_trans"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminateOnly="true"
                android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_white"
                android:indeterminateDuration="500"
                android:indeterminateBehavior="repeat"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </RelativeLayout>
</FrameLayout>
