<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_pay_component_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/pay_method_root"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_padding_18">
        <TextView
            android:textSize="@dimen/cj_pay_font_size_13"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
            android:gravity="center"
            android:id="@+id/pay_method"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="@dimen/cj_pay_padding_24"
            android:text="支付方式"
            android:layout_alignParentLeft="true"/>
        <LinearLayout
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/pay_method_ll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toRightOf="@+id/pay_method"
            android:layout_alignParentRight="true">
            <ImageView
                android:id="@+id/pay_method_icon"
                android:layout_width="@dimen/cj_pay_padding_16"
                android:layout_height="@dimen/cj_pay_padding_16"
                android:layout_marginRight="@dimen/cj_pay_padding_4"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="@dimen/cj_pay_font_size_13"
                        android:textColor="@color/cj_pay_color_black_161823"
                        android:gravity="center_vertical"
                        android:id="@+id/pay_method_name1"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="招商银行储蓄卡 (1111)"
                        android:singleLine="true"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:textSize="@dimen/cj_pay_font_size_13"
                        android:textColor="@color/cj_pay_color_black_161823"
                        android:ellipsize="middle"
                        android:gravity="center_vertical"
                        android:id="@+id/pay_method_name2"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="招商银行储蓄卡 (2222)"
                        android:singleLine="true"
                        android:includeFontPadding="false"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/pay_method_right_arrow"
                    android:layout_width="@dimen/cj_pay_padding_12"
                    android:layout_height="@dimen/cj_pay_padding_12"
                    android:layout_marginLeft="@dimen/cj_pay_padding_2"
                    android:src="@drawable/cj_pay_component_view_right_arrow"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/pay_promotion_root"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_padding_18"
        android:layout_marginTop="@dimen/cj_pay_padding_10"
        android:layout_below="@+id/pay_method_root">
        <TextView
            android:textSize="@dimen/cj_pay_font_size_13"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
            android:gravity="center"
            android:id="@+id/pay_promotion"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="24dp"
            android:text="支付优惠"
            android:layout_alignParentLeft="true"/>
        <RelativeLayout
            android:gravity="end"
            android:id="@+id/pay_promotion_ll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toRightOf="@+id/pay_promotion"
            android:layout_alignParentRight="true">
            <TextView
                android:textSize="@dimen/cj_pay_font_size_13"
                android:textColor="@color/cj_pay_color_orange_FF6E26"
                android:gravity="center_vertical"
                android:id="@+id/promotion_dest"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="立减2元立减2元立减2元立减2元立减2元立减2元"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_toLeftOf="@+id/pay_promotion_right_arrow"/>
            <ImageView
                android:id="@+id/pay_promotion_post_image"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="2dp"
                android:layout_toLeftOf="@+id/pay_promotion_right_arrow"
                android:layout_toRightOf="@+id/promotion_dest"
                android:layout_centerVertical="true"/>
            <ImageView
                android:id="@+id/pay_promotion_right_arrow"
                android:layout_width="@dimen/cj_pay_padding_12"
                android:layout_height="@dimen/cj_pay_padding_12"
                android:layout_marginLeft="@dimen/cj_pay_padding_2"
                android:src="@drawable/cj_pay_component_view_oringe_right_arrow"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/recommend_dy_root"
        android:background="@drawable/cj_pay_component_recommend_bg"
        android:layout_width="match_parent"
        android:layout_height="43dp"
        android:layout_marginTop="@dimen/cj_pay_padding_5"
        android:layout_below="@+id/pay_method_root">
        <com.android.ttcjpaysdk.base.ui.widget.CJPayBoldTextView
            android:textSize="@dimen/cj_pay_font_size_12"
            android:textStyle="bold"
            android:textColor="@color/cj_pay_color_red_fe2c55"
            android:ellipsize="middle"
            android:gravity="start|center_vertical"
            android:id="@+id/recommend_dy_dest"
            android:paddingBottom="1.5dp"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/cj_pay_padding_20"
            android:layout_marginLeft="@dimen/cj_pay_padding_8"
            android:layout_marginBottom="@dimen/cj_pay_padding_8"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_toLeftOf="@+id/recommend_btn_container"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/recommend_btn_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true">
            <com.android.ttcjpaysdk.base.ui.widget.CJPayBoldTextView
                android:textSize="@dimen/cj_pay_font_size_12"
                android:textStyle="bold"
                android:textColor="@color/cj_pay_color_red_fe2c55"
                android:id="@+id/use_dy_pay"
                android:paddingBottom="1.5dp"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/cj_pay_padding_20"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="@dimen/cj_pay_padding_24"
                android:layout_marginEnd="@dimen/cj_pay_padding_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <FrameLayout
                android:id="@+id/recommend_btn_exp"
                android:background="@drawable/cj_pay_component_recommend_btn_border"
                android:visibility="gone"
                android:layout_width="60dp"
                android:layout_height="24dp"
                android:layout_marginRight="@dimen/cj_pay_padding_12"
                android:layout_marginBottom="@dimen/cj_pay_padding_6"
                android:layout_marginStart="@dimen/cj_pay_height_24"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <com.android.ttcjpaysdk.base.ui.widget.CJPayBoldTextView
                    android:textSize="@dimen/cj_pay_font_size_12"
                    android:textStyle="bold"
                    android:textColor="@color/cj_pay_color_red_fe2c55"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/recommend_btn_tv_exp"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/cj_pay_padding_20"
                    android:maxLines="1"
                    android:includeFontPadding="false"/>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>
</RelativeLayout>
