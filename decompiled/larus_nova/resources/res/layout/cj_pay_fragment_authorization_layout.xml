<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_pay_authorization_root_view"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/iv_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="@dimen/cj_pay_padding_10"
        android:layout_marginRight="@dimen/cj_pay_padding_12"
        android:src="@drawable/cj_pay_icon_authorization_close"
        android:layout_marginEnd="@dimen/cj_pay_padding_12"/>
    <RelativeLayout
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:layout_marginLeft="@dimen/cj_pay_padding_16"
        android:layout_marginRight="@dimen/cj_pay_padding_16">
        <FrameLayout
            android:id="@+id/title_container_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomRoundCornerImageView
                android:id="@+id/iv_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/cj_pay_icon_authorization"
                app:CJPayCornerRadius="8dp"/>
            <TextView
                android:textSize="@dimen/cj_pay_font_size_15"
                android:textColor="@color/cj_pay_color_black_34"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="52dp"
                android:text="@string/cj_pay_authorization_title"
                android:includeFontPadding="false"
                android:lineSpacingExtra="3dp"
                android:layout_marginStart="52dp"
                style="@style/CJPayShadowTextStyle"/>
            <View
                android:layout_gravity="bottom"
                android:id="@+id/cj_pay_bottom_divider_line"
                android:background="@color/cj_pay_color_gray_232"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cj_pay_height_half_1"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/auth_title_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cj_pay_padding_16"
            android:layout_below="@+id/title_container_layout">
            <TextView
                android:textSize="@dimen/cj_pay_font_size_15"
                android:textColor="@color/cj_pay_color_black_34"
                android:id="@+id/tv_auth_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cj_pay_authorization_apply"
                android:includeFontPadding="false"
                android:lineSpacingExtra="3dp"
                style="@style/CJPayShadowTextStyle"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_auth_info_tip"
                android:background="@color/cj_pay_color_black_161823"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginLeft="5dp"
                android:src="@drawable/cj_pay_icon_pay_timeout"
                android:layout_marginStart="5dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/auth_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:divider="@drawable/cj_pay_divider_trans_12"
            android:layout_below="@+id/auth_title_layout"
            android:showDividers="middle"/>
        <include
            android:id="@+id/tv_user_agreement_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cj_pay_padding_34"
            android:layout_above="@+id/layout_next_step"
            layout="@layout/cj_pay_common_protocol_layout"/>
        <RelativeLayout
            android:id="@+id/layout_next_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:layout_above="@+id/tv_reject"
            android:layout_alignWithParentIfMissing="true">
            <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
                android:textSize="@dimen/cj_pay_font_size_15"
                android:textColor="@color/cj_pay_color_white"
                android:gravity="center"
                android:id="@+id/btn_next_step"
                android:background="#fe2c55"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cj_pay_custom_button_height_44"
                android:text="@string/cj_pay_authorization_agree"
                android:includeFontPadding="false"/>
            <ProgressBar
                android:id="@+id/iv_loading"
                android:background="@color/cj_pay_color_trans"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminateOnly="true"
                android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_white"
                android:indeterminateDuration="500"
                android:indeterminateBehavior="repeat"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/cj_pay_font_size_14"
            android:textColor="@color/cj_pay_color_black_34"
            android:gravity="center_horizontal"
            android:id="@+id/tv_reject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cj_pay_authorization_reject"
            android:includeFontPadding="false"
            android:layout_alignParentBottom="true"
            style="@style/CJPayShadowTextStyle"/>
    </RelativeLayout>
    <ViewStub
        android:id="@+id/view_stub_multi_agreement"
        android:layout="@layout/cj_pay_fragment_auth_multi_agreement"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_470"/>
</FrameLayout>
