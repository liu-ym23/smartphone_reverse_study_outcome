<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/new_profile_shop_info_layout"
    android:background="@drawable/ttlive_bg_shop_component"
    android:layout_width="match_parent"
    android:layout_height="54dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/right_car_icon"
        android:visibility="gone"
        android:layout_width="25dp"
        android:layout_height="36dp"
        app:actualImageScaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_sale_first_line"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginRight="@dimen/ttlive_profile_shop_entrance_left_margin"
        android:layout_marginStart="12dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/layout_sale_entrance"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/black"
            android:id="@+id/tv_sale_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/layout_sale_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/tv_sale_name"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/layout_sale_detail"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginRight="@dimen/ttlive_profile_shop_entrance_left_margin"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="12dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/layout_sale_entrance"
        app:layout_constraintTop_toBottomOf="@+id/layout_sale_first_line">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/sale_detail_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="10dp"
                android:textColor="@color/ttlive_shop_component_info"
                android:id="@+id/tv_sale_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/xzg_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <View
                android:layout_gravity="center_vertical"
                android:id="@+id/shop_divider_view_1"
                android:background="@color/ttlive_shop_component_info_divider"
                android:visibility="gone"
                android:layout_width="1dp"
                android:layout_height="8dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/ttlive_shop_component_info"
                android:id="@+id/tv_sale_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_sale_entrance"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
