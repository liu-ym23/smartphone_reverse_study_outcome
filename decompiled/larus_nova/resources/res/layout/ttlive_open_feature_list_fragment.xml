<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_collapseMode="pin"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/ttlive_open_feature_title_bar_with_panel_desc"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/loading_view_container"
        android:background="@drawable/ttlive_bg_open_feature_loading_view"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar">
        <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
            android:layout_gravity="center"
            android:id="@+id/loading_anim_view"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"/>
    </LinearLayout>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/scroll_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.appbar.AppBarLayout
            android:orientation="vertical"
            android:id="@+id/appbar_layout"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/appbar_layout_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_scrollFlags="scroll">
                <RelativeLayout
                    android:id="@+id/search_input"
                    android:background="@drawable/ttlive_bg_anchor_search_cell"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/live_open_platform_anchor_search_height"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="17dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:id="@+id/search_glass"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginLeft="4dp"
                        android:src="@drawable/ttlive_ic_anchor_search_glass"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="4dp"
                        android:layout_alignParentStart="true"/>
                    <TextView
                        android:textSize="15dp"
                        android:textColor="@color/ttlive_search_text_color"
                        android:textColorHint="@color/ttlive_text_hint_color"
                        android:id="@+id/search_edit"
                        android:background="@null"
                        android:layout_width="match_parent"
                        android:layout_height="21dp"
                        android:layout_marginLeft="4dp"
                        android:layout_marginRight="4dp"
                        android:hint="@string/ttlive_open_platform_search"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:layout_toRightOf="@+id/search_glass"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@+id/search_glass"/>
                </RelativeLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/feature_group_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="15dp"
                    app:layout_scrollFlags="scroll"/>
            </LinearLayout>
            <com.bytedance.android.livesdk.widget.LivePagerSlidingTabStrip
                android:id="@+id/feature_category_tab"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:minHeight="40dp"
                app:layout_scrollFlags="exitUntilCollapsed|scroll"
                app:tabMode="scrollable"
                app:tab_background="@color/transparent"
                app:tab_divider_color="#0000"
                app:tab_indicator_color="@color/ttlive_open_feature_tab_item_indicator"
                app:tab_indicator_height="2dp"
                app:tab_indicator_width="30dp"
                app:tab_padding_left_right="16dp"
                app:tab_scroll_offset="112dp"
                app:tab_text_color="@color/ttlive_open_feature_panel_tab_item"
                app:tab_text_size="15dp"
                app:tab_typeface_style="normal"
                app:tab_underline_color="@color/transparent"/>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/error_area"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/scroll_area"
                app:layout_scrollFlags="scroll">
                <com.bytedance.android.live.core.widget.HSImageView
                    android:layout_gravity="center"
                    android:id="@+id/img_tip"
                    android:visibility="gone"
                    android:layout_width="240dp"
                    android:layout_height="160dp"
                    android:layout_marginTop="40dp"/>
                <TextView
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/network_tip"
                    android:paddingTop="20dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/txt_tip"
                    android:paddingTop="12dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.5"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/retry_btn"
                    android:background="@color/ttlive_open_feature_list_retry"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="40dp"
                    android:text="@string/ttlive_open_platform_feature_list_retry"
                    android:textAlignment="center"/>
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/feature_tab_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
