<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="48dp"
    android:layout_height="48dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="28dp"
        android:layout_height="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/float_view_avatar"
            android:background="@drawable/ttlive_bg_default_anchor_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:placeholderImage="@drawable/ttlive_img_avatar_empty"
            app:roundAsCircle="true"/>
        <View
            android:layout_gravity="center"
            android:background="@drawable/ttlive_bg_linkmic_apply_float_view_avatar_border"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/float_view_avatar_mute"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:placeholderImage="@drawable/ttlive_ic_live_audio_off"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/float_view_avatar_talk_anim"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
