<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/vr_gesture_guide_area"
        android:visibility="gone"
        android:layout_width="260dp"
        android:layout_height="197dp"
        android:layout_alignParentLeft="true"
        android:layout_centerInParent="true">
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center"
            android:id="@+id/vr_gesture_guide_anim"
            android:layout_width="160dp"
            android:layout_height="160dp"/>
        <TextView
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/vr_gesture_guide_text"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:text="@string/ttlive_vr_gesture_guide_text"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/water_mark_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"/>
    <ImageView
        android:id="@+id/ttlive_clear_screen_close"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ttlive_close_in_top_container_shadow"
        android:layout_alignParentRight="true"
        android:contentDescription="@string/ttlive_label_close"
        android:layout_marginEnd="10dp"/>
    <ImageView
        android:id="@+id/ttlive_view_clear_screen"
        android:background="@drawable/ttlive_bg_douyin_official_toolbar"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginLeft="12dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/ttlive_ic_clear_screen"
        android:layout_alignParentLeft="true"
        android:contentDescription="@string/ttlive_restore_screen"
        android:layout_marginStart="12dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/zoom_guide_layout"
        android:background="@drawable/ttlive_clear_screen_guide_backgroud"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="446dp"
        android:layout_alignParentBottom="true"
        android:contentDescription="@string/ttlive_clear_zoom_guide_text">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/guide"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginTop="87dp"/>
        <TextView
            android:textSize="20dp"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:id="@+id/guide_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_clear_zoom_guide_text"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_right_contanier"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginBottom="10dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="12dp">
        <LinearLayout
            android:id="@+id/image_recognition_container"
            android:background="@drawable/ttlive_bg_exit_clear_screen"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginRight="6dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/ic_image_recognition"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginLeft="12dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/ttlive_exit_clear_color"
                android:gravity="center"
                android:id="@+id/tv_image_recognition"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="12dp"/>
        </LinearLayout>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/icon_container_in_clear"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="8dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/exit_clear_screen"
            android:background="@drawable/ttlive_bg_exit_clear_screen"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:contentDescription="@string/ttlive_exit_clear_screen_btn">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/exit_clear_icon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ttlive_icon_exit_clear_screen_focus"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/ttlive_exit_clear_color"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_exit_clear_screen"
                android:paddingLeft="6dp"
                android:paddingRight="14dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_exit_clear_screen"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
