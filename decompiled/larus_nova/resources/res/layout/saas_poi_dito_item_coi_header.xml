<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/poi_coi_feed_divider"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp">
    <com.bytedance.locallife.poi.newdetail.widget.PoiRepeatTextureBgView
        android:id="@+id/texture_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/default_title_container"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/poi_ic_coi_divider_left"
            android:layout_marginEnd="8dp"/>
        <com.bytedance.dux.text.DuxTextView
            android:textColor="@color/POITextPrimary"
            android:id="@+id/divider_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/poi_coi_divider_desc_default"
            style="@style/font_size_30_sp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/poi_ic_coi_divider_right"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <com.bytedance.lighten.loader.SmartImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/image_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp"/>
</FrameLayout>
