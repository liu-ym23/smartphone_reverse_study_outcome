<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/permGroupList"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.ee.bear.facade.common.widget.BearLottieView
        android:layout_gravity="center"
        android:id="@+id/permGroupLoading"
        android:visibility="gone"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/loading_anim"
        style="@style/BearLottieView"/>
    <com.bytedance.ee.bear.widgets.universedesign.SpaceEmptyState
        android:id="@+id/permGroupEmptyState"
        android:visibility="gone"
        app:ud_empty_imageRes="@drawable/ccm_empty_neutral_no_contact"
        style="@style/SpaceEmptyStatusStyle"/>
</FrameLayout>
