<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/cj_pay_bg_common_dialog"
    android:layout_width="@dimen/cj_pay_height_280"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/cj_pay_font_size_17"
        android:textColor="@color/cj_pay_color_black_161823"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/cj_pay_cvv_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_20"
        android:layout_marginTop="@dimen/cj_pay_padding_24"
        android:layout_marginRight="@dimen/cj_pay_padding_20"/>
    <TextView
        android:textSize="@dimen/cj_pay_font_size_14"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/cj_pay_cvv_dialog_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_20"
        android:layout_marginTop="@dimen/cj_pay_padding_8"
        android:layout_marginRight="@dimen/cj_pay_padding_20"/>
    <ImageView
        android:layout_gravity="center"
        android:layout_width="@dimen/cj_pay_height_150"
        android:layout_height="@dimen/cj_pay_height_88"
        android:layout_marginTop="@dimen/cj_pay_padding_12"
        android:src="@drawable/cj_pay_cvv_example_pic"/>
    <View
        android:id="@+id/cj_pay_cvv_dialog_divider"
        android:background="@color/cj_pay_color_cashdesk_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_half_1"
        android:layout_marginTop="@dimen/cj_pay_padding_15"
        android:layout_below="@+id/cj_pay_cvv_dialog_content"/>
    <TextView
        android:textSize="@dimen/cj_pay_font_size_15"
        android:textColor="@color/cj_pay_color_black_161823"
        android:gravity="center"
        android:id="@+id/cj_pay_cvv_dialog_btn_view"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_48"
        android:layout_below="@+id/cj_pay_cvv_dialog_divider"/>
</LinearLayout>
