<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_record_publish_dialog"
    android:paddingBottom="42dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:text="录屏成功，你可能想要"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerImageView
        android:id="@+id/ivThumb"
        android:layout_width="33dp"
        android:layout_height="71dp"
        android:layout_marginTop="14dp"
        app:layout_constraintLeft_toLeftOf="@+id/tvTitle"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        app:ttlive_allRadius="6dp"/>
    <View
        android:id="@+id/viewDivider"
        android:background="#1f161823"
        android:layout_width="0.5dp"
        android:layout_height="60dp"
        android:layout_marginLeft="21dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivThumb"
        app:layout_constraintLeft_toRightOf="@+id/ivThumb"
        app:layout_constraintTop_toTopOf="@+id/ivThumb"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llPublish"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="21dp"
        app:layout_constraintBottom_toBottomOf="@+id/viewDivider"
        app:layout_constraintLeft_toLeftOf="@+id/viewDivider"
        app:layout_constraintTop_toTopOf="@+id/viewDivider">
        <ImageView
            android:background="@drawable/ttlive_icon_record_publish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="11dp"
            android:textColor="#99161823"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="发布到抖音"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
