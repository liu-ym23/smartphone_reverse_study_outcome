<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/cycle_activity_item_cover"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:viewAspectRatio="1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/ec_color_black"
        android:id="@+id/cycle_activity_item_price_prefix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="￥"
        app:layout_constraintBottom_toBottomOf="@+id/cycle_activity_item_price_textview"
        app:layout_constraintEnd_toStartOf="@+id/cycle_activity_item_price_textview"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/ec_color_black"
        android:id="@+id/cycle_activity_item_price_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toStartOf="@+id/cycle_activity_item_price_postfix"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/cycle_activity_item_price_prefix"
        app:layout_constraintTop_toBottomOf="@+id/cycle_activity_item_cover"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/ec_color_white"
        android:id="@+id/cycle_activity_item_price_postfix"
        android:background="@drawable/shopping_homepage_product_subsidy_text_wrapper"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:text="限时"
        app:layout_constraintBottom_toBottomOf="@+id/cycle_activity_item_price_textview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/cycle_activity_item_price_textview"/>
</androidx.constraintlayout.widget.ConstraintLayout>
