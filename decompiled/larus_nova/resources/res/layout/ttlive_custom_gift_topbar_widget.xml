<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:paddingLeft="17dp"
    android:paddingRight="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="17dp"
    android:paddingEnd="12dp">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/custom_gift_icon_layout"
        android:layout_width="46dp"
        android:layout_height="46dp">
        <ImageView
            android:id="@+id/custom_gift_icon_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ttlive_custom_gift_icon_bg_select"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/custom_gift_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"/>
        <ImageView
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/custom_gift_shade"
            android:background="@drawable/ttlive_custom_gift_icon_select_shade"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="20dp"
            android:layout_marginBottom="3dp"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/ttlive_colorffe713"
            android:layout_gravity="end|bottom"
            android:id="@+id/custom_gift_count"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="4dp"
            android:layout_marginEnd="5dp"/>
    </FrameLayout>
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginStart="8dp">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/white"
            android:id="@+id/custom_gift_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/ttlive_colorffffff_cc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="@string/ttlive_custom_gift_suffix"
            android:layout_toRightOf="@+id/custom_gift_name"
            android:layout_marginStart="4dp"
            android:layout_toEndOf="@+id/custom_gift_name"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/ttlive_colorffffff_80"
            android:id="@+id/custom_gift_valid_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_below="@+id/custom_gift_name"/>
    </RelativeLayout>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="13dp"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/custom_gift_buy"
            android:background="@drawable/ttlive_base_gift_top_bar_text_bg"
            android:layout_width="80dp"
            android:layout_height="28dp"/>
    </FrameLayout>
</LinearLayout>
