<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingRight="8dp"
    android:layout_width="132dp"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/payment_card_content_layout"
        android:background="@drawable/cj_pay_bg_payment_card_selector"
        android:layout_width="124dp"
        android:layout_height="48dp"
        android:layout_marginTop="6dp">
        <LinearLayout
            android:layout_gravity="center"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_icon"
                android:visibility="gone"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginRight="4dp"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_90"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:id="@+id/tv_payment_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:maxEms="7"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_right_arrow"
                android:visibility="gone"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/cj_pay_icon_right_arrow_noise_reduction"/>
        </LinearLayout>
    </FrameLayout>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/cj_pay_color_red_fe2c55_opacity_90"
        android:ellipsize="end"
        android:layout_gravity="right"
        android:id="@+id/tv_right_label"
        android:background="@drawable/cj_pay_bg_credit_pay_voucher_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"/>
</FrameLayout>
