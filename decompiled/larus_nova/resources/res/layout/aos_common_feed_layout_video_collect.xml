<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/collect_view_layout"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/collect_container"
        android:importantForAccessibility="no"
        style="@style/common_feed_button_no_gravity_style">
        <com.bytedance.awemeopen.infra.base.anim.lottie.AoAnimationLottieView
            android:layout_gravity="center"
            android:id="@+id/collect_image"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/aos_feed_collect_icon"
            android:scaleType="centerInside"
            android:importantForAccessibility="no"/>
    </FrameLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/aos_white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/collect_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="9dp"
        android:text="收藏"
        android:includeFontPadding="false"
        android:importantForAccessibility="no"/>
</LinearLayout>
