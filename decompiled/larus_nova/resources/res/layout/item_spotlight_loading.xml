<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/search_loading_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/picker_net_loading_fail"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/picker_net_loading_fail_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:scaleType="centerInside"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="@string/Lark_ASLSearch_WeakNetworkNotice_InternetErrorLimitedSearch_NoticeMobile"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/picker_spotlight_loading"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/search_net_loading_iv"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_caption"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="@string/Lark_Legacy_LoadingNow"/>
    </LinearLayout>
</FrameLayout>
