<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="146dp">
    <FrameLayout
        android:background="@drawable/bitable_card_view_setting_top_bg"
        android:layout_width="match_parent"
        android:layout_height="110dp">
        <View
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bitable_card_view_setting_rec_bottom_bg"
            android:visibility="visible"
            android:layout_width="120dp"
            android:layout_height="58dp"
            android:layout_marginTop="30dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bitable_card_view_setting_rec_top_bg"
            android:layout_width="136dp"
            android:layout_height="58dp"
            android:layout_marginTop="22dp">
            <com.bytedance.ee.bear.facade.common.widget.RoundFrameLayout
                android:id="@+id/cover_graph"
                android:background="@drawable/bitable_card_view_setting_cover_graph_bg"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="14dp"
                android:layout_marginRight="8dp"
                app:radius="4dp">
                <View
                    android:background="@drawable/bitable_card_view_setting_cover_graph_circle_bg"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginLeft="18dp"
                    android:layout_marginTop="8dp"/>
                <View
                    android:background="@drawable/bitable_card_view_setting_cover_graph_rectangle_bg"
                    android:layout_width="34dp"
                    android:layout_height="30dp"
                    android:layout_marginLeft="-5dp"
                    android:layout_marginTop="10dp"
                    android:rotation="45"/>
            </com.bytedance.ee.bear.facade.common.widget.RoundFrameLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:id="@+id/line1"
                    android:background="@drawable/bitable_card_view_setting_line_graph_blue_deep"
                    android:layout_width="39dp"
                    android:layout_height="4dp"/>
                <View
                    android:id="@+id/line2"
                    android:background="@drawable/bitable_card_view_setting_line_graph_blue_light"
                    android:layout_width="31dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="7dp"
                    android:layout_below="@+id/line1"/>
                <View
                    android:background="@drawable/bitable_card_view_setting_line_graph_blue_light"
                    android:layout_width="31dp"
                    android:layout_height="4dp"
                    android:layout_marginLeft="7dp"
                    android:layout_marginTop="7dp"
                    android:layout_toRightOf="@+id/line2"
                    android:layout_below="@+id/line1"/>
                <View
                    android:id="@+id/line3"
                    android:background="@drawable/bitable_card_view_setting_line_graph_blue_light"
                    android:layout_width="31dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="5dp"
                    android:layout_below="@+id/line2"/>
                <View
                    android:id="@+id/line3_2"
                    android:background="@drawable/bitable_card_view_setting_line_graph_green"
                    android:layout_width="14.5dp"
                    android:layout_height="4dp"
                    android:layout_marginLeft="7dp"
                    android:layout_marginTop="5dp"
                    android:layout_toRightOf="@+id/line3"
                    android:layout_below="@+id/line2"/>
                <View
                    android:background="@drawable/bitable_card_view_setting_line_graph_wathet"
                    android:layout_width="14.5dp"
                    android:layout_height="4dp"
                    android:layout_marginLeft="2dp"
                    android:layout_marginTop="5dp"
                    android:layout_toRightOf="@+id/line3_2"
                    android:layout_below="@+id/line2"/>
            </RelativeLayout>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:background="@color/bg_float"
        android:layout_width="match_parent"
        android:layout_height="36dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/bitable_card_view_setting_text_color"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Bitable_Mobile_CardMode_Card"/>
    </FrameLayout>
</LinearLayout>
