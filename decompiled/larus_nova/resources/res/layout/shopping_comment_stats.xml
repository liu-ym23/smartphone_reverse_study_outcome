<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/scroll_view_stat"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.shopping.anchorv3.comment.widget.VisibilityEventScrollView
        android:layout_gravity="center"
        android:id="@+id/scroll_view_stat_tag"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="0dp"
        android:paddingBottom="8dp"
        android:scrollbars="none"
        android:fadingEdge="horizontal"
        android:fadingEdgeLength="42dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:requiresFadingEdge="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="0dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/container_stat_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </com.bytedance.android.shopping.anchorv3.comment.widget.VisibilityEventScrollView>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/commerce_comment_list_sort_iv"
        android:paddingLeft="12dp"
        android:paddingTop="6dp"
        android:paddingRight="16dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ec_commerce_comment_sort_default"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"/>
</LinearLayout>
