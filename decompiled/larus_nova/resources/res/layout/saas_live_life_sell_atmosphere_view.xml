<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/atmosphere_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.lighten.loader.SmartImageView
        android:id="@+id/iv_atmosphere_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        app:actualImageScaleType="fitCenter"/>
    <com.bytedance.lighten.loader.SmartImageView
        android:id="@+id/iv_atmosphere_trans"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        app:actualImageScaleType="fitCenter"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/atmosphere_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/left_icon_placeholder"
            android:layout_width="24dp"
            android:layout_height="match_parent"/>
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/iv_atmosphere_pre_text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            app:actualImageScaleType="fitCenter"/>
        <FrameLayout
            android:id="@+id/atmosphere_text_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="1dp">
            <TextView
                android:textSize="15dp"
                android:textStyle="italic|bold"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_atmosphere_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:fontFamily="@font/byte_number_center"/>
        </FrameLayout>
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/iv_atmosphere_after_text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            app:actualImageScaleType="fitCenter"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/atmosphere_x_text_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="2dp">
            <TextView
                android:textSize="8.5dp"
                android:textStyle="italic|bold"
                android:textColor="#ffffff"
                android:id="@+id/tv_x_express"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="x "
                android:fontFamily="@font/byte_number_center"/>
            <TextView
                android:textSize="15dp"
                android:textStyle="italic|bold"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:id="@+id/tv_text_express"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="@font/byte_number_center"/>
        </LinearLayout>
    </LinearLayout>
    <com.bytedance.lighten.loader.SmartImageView
        android:id="@+id/iv_atmosphere_left_icon"
        android:layout_width="24dp"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        app:actualImageScaleType="fitCenter"/>
</FrameLayout>
