<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/product_feed_sv_label_icon"
        android:visibility="gone"
        android:layout_width="@dimen/commerce_anchor_v3_icon_activity_width"
        android:layout_height="@dimen/commerce_anchor_v3_icon_activity_height"
        android:layout_marginLeft="8dp"
        android:scaleType="centerCrop"
        android:layout_marginStart="8dp"/>
    <TextView
        android:textColor="@color/Primary"
        android:gravity="center_vertical"
        android:id="@+id/product_feed_tv_coupon_tag_header"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginStart="10dp"
        style="@style/font_size_26"/>
    <View
        android:id="@+id/product_feed_tv_coupon_tag_divider"
        android:background="@drawable/ec_commerce_bg_anchor_v3_divider_discount"
        android:visibility="gone"
        android:layout_width="1dp"
        android:layout_height="12dp"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"/>
    <TextView
        android:textColor="@color/Primary"
        android:gravity="center_vertical"
        android:id="@+id/product_feed_tv_coupon_tag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/font_size_26"/>
</LinearLayout>
