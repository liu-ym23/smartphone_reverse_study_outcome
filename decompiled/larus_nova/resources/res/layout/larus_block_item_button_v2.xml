<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/button_v2_container"
    android:background="?attr/larus_bg_round_full_radius_8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/button_v2_icon_left"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_18"
        android:layout_height="?attr/larus_dp_18"
        android:layout_marginEnd="?attr/larus_dp_4"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_16"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/button_v2_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/button_v2_icon_right"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_18"
        android:layout_height="?attr/larus_dp_18"
        android:layout_marginStart="?attr/larus_dp_4"/>
</LinearLayout>
