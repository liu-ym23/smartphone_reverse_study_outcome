<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_inflow_full_price_view_relativelayout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.bytedance.android.ec.core.widget.PriceView
        android:id="@+id/main_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        app:extraTextColor="@color/ec_inflow_full_price_color"
        app:extraTextSize="13sp"
        app:prefixSpaceSize="2dp"
        app:prefixTextSize="13sp"
        app:priceBold="true"
        app:priceDecimalTextSize="19sp"
        app:priceTextColor="@color/ec_inflow_full_price_color"
        app:priceTextSize="26sp"
        app:spaceSize="1sp"
        app:thinDecimal="true"
        app:yangTextSize="14sp"/>
    <com.bytedance.android.ec.core.widget.PriceView
        android:id="@+id/sub_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_toRightOf="@+id/main_price"
        android:layout_alignBaseline="@+id/main_price"
        android:layout_marginStart="6dp"
        android:layout_toEndOf="@+id/main_price"
        app:extraTextColor="@color/shopping_color_99161823"
        app:extraTextSize="12sp"
        app:prefixSpaceSize="1dp"
        app:prefixTextColor="@color/shopping_color_99161823"
        app:priceTextColor="@color/shopping_color_99161823"
        app:priceTextSize="12sp"
        app:showDeleteLine="true"
        app:spaceSize="0dp"
        app:yangTextSize="12sp"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/price_description"
        android:background="@drawable/ec_inflow_price_bg_v2"
        android:paddingLeft="6dp"
        android:paddingTop="2dp"
        android:paddingRight="6dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="1dp"
        android:includeFontPadding="false"
        android:layout_toRightOf="@+id/main_price"
        android:layout_toEndOf="@+id/main_price"/>
</RelativeLayout>
