<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/toolbarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/subToolbarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_gravity="bottom"
                android:id="@+id/container_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dp_52"/>
            <FrameLayout
                android:layout_gravity="bottom"
                android:id="@+id/container_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <View
            android:id="@+id/shadow"
            android:background="@drawable/larus_doc_toolbar_bg_shadow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_4"/>
        <RelativeLayout
            android:background="@color/larus_base_2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_60">
            <com.larus.office.base.plugins.toolbar.view.HorizontalOverScrollView
                android:id="@+id/scrollView"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/dp_64">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/topLevelItems"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">
                    <include layout="@layout/larus_toolbar_v2_top_level_item"/>
                    <include layout="@layout/larus_toolbar_v2_top_level_item"/>
                    <include layout="@layout/larus_toolbar_v2_top_level_item"/>
                    <include layout="@layout/larus_toolbar_v2_top_level_item"/>
                </LinearLayout>
            </com.larus.office.base.plugins.toolbar.view.HorizontalOverScrollView>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/keyboardSwitch"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true">
                <View
                    android:id="@+id/mark"
                    android:background="@drawable/larus_doc_toolar_mask_divider"
                    android:visibility="gone"
                    android:layout_width="?attr/larus_dp_16"
                    android:layout_height="match_parent"/>
                <FrameLayout
                    android:id="@+id/keyboardSwitchIconParent"
                    android:background="@color/larus_base_2"
                    android:layout_width="@dimen/dp_48"
                    android:layout_height="match_parent">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center"
                        android:id="@+id/keyboardSwitchIcon"
                        android:background="@drawable/larus_doc_toolbar_keyboard_bg_selector"
                        android:layout_width="@dimen/dp_36"
                        android:layout_height="@dimen/dp_36"
                        android:scaleType="centerInside"
                        android:tint="@color/icon_n1"
                        app:srcCompat="@drawable/larus_doc_icon_keyboard"
                        style="@style/Larus.EditToolbarTopLevelIcon"/>
                </FrameLayout>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.larus.office.base.plugins.toolbar.view.KeyboardPlaceholderView
            android:id="@+id/keyboardPlaceholder"
            android:background="@color/bg_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/sub_panel_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</LinearLayout>
