<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_interact_dialog"
    android:layout_width="match_parent"
    android:layout_height="373dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/img_dialog_plugin"
        android:layout_width="match_parent"
        android:layout_height="188dp"
        app:layout_constraintBottom_toTopOf="@+id/bottome_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottome_container"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="186dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_dialog_plugin">
        <TextView
            android:textSize="14sp"
            android:textColor="#161823"
            android:gravity="center"
            android:id="@+id/notice_text"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="24dp"
            android:text="@string/ttlive_random_pk_announcement_hint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/hint_to_rule_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="@+id/notice_text"
            app:layout_constraintStart_toStartOf="@+id/notice_text"
            app:layout_constraintTop_toBottomOf="@+id/notice_text">
            <TextView
                android:textSize="14sp"
                android:textColor="#fe2c56"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:text="@string/ttlive_random_pk_announcement"/>
            <ImageView
                android:background="@drawable/ttlive_notice_arrowforward"
                android:layout_width="5.75dp"
                android:layout_height="10dp"
                android:layout_marginLeft="4dp"
                android:scaleType="fitXY"/>
        </LinearLayout>
        <TextView
            android:textSize="15sp"
            android:textColor="#161823"
            android:gravity="center"
            android:id="@+id/cancel_btn"
            android:background="@drawable/ttlive_random_check_cancel_btn"
            android:layout_width="167.5dp"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            android:text="@string/ttlive_random_pk_cancel"
            app:layout_constraintEnd_toStartOf="@+id/confirme_btn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hint_to_rule_btn"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/confirme_btn"
            android:background="@drawable/ttlive_random_check_confirme_btn"
            android:layout_width="167.5dp"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            android:text="@string/ttlive_random_pk_confirm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cancel_btn"
            app:layout_constraintTop_toBottomOf="@+id/hint_to_rule_btn"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
