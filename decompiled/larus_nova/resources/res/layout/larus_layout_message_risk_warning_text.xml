<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="?attr/larus_sp_15"
        android:textColor="?attr/larus_neutral_50"
        android:id="@+id/risk_warning_text"
        android:paddingBottom="?attr/larus_dp_8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_16"
        android:letterSpacing="0.02"
        app:layout_constraintBottom_toTopOf="@+id/risk_warning_url"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="?attr/larus_primary_60"
        android:id="@+id/risk_warning_url"
        android:paddingBottom="?attr/larus_dp_12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_16"
        android:letterSpacing="0.02"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/risk_warning_text"/>
</merge>
