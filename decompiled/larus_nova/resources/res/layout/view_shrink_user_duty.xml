<?xml version="1.0" encoding="utf-8"?>
<com.larksuite.framework.ui.PriorityLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <TextView
        android:textColor="@color/text_placeholder"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="13dp"
        android:maxLines="1"
        android:lines="1"
        android:singleLine="true"
        app:priority="9"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_divider"
        android:layout_width="1dp"
        android:layout_height="10dp"
        android:layout_marginTop="0.5dp"
        android:minWidth="1dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:priority="10"
        app:srcCompat="@drawable/divider_vertical"
        app:tint="@color/line_divider_default"/>
    <TextView
        android:textColor="@color/text_placeholder"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_duty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="60dp"
        android:maxLines="1"
        android:lines="1"
        android:singleLine="true"
        app:priority="1"/>
</com.larksuite.framework.ui.PriorityLayout>
