<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ttlive_visitor_count_button"
        android:background="@drawable/ttlive_bg_black_radius20"
        android:paddingLeft="10dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginRight="13dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ttlive_profile_visitor_count_locked_icon"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="2dp"
            android:src="@drawable/icon_profile_visitor_count_locked"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/ttlive_visitor_locked_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/ttlive_profile_visitor_count_locked_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/ttlive_visitor_count_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.live.room.api.view.SimpleIndicatorTextSwitcher
            android:id="@+id/ttlive_visitor_count"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/ttlive_visitor_count_text"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:textColor="@color/white"
            android:id="@+id/ttlive_right_arrow"
            android:visibility="gone"
            android:layout_width="10dp"
            android:layout_height="12dp"
            android:layout_marginLeft="2dp"
            android:src="@drawable/icon_profile_visitor_count_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/ttlive_visitor_count"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/ttlive_visitor_count_yellow_dot"
        android:background="@drawable/ttlive_bg_visitor_yellow_dot"
        android:visibility="gone"
        android:layout_width="7dp"
        android:layout_height="7dp"
        app:layout_constraintRight_toRightOf="@+id/ttlive_visitor_count_button"
        app:layout_constraintTop_toTopOf="@+id/ttlive_visitor_count_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
