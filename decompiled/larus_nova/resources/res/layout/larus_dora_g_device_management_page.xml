<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_container"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/title_back"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            android:contentDescription="@string/larus_accessibility_icon_back"
            android:layout_marginStart="?attr/larus_dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/larus_dora_ic_left_back"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/title_selector_container"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="?attr/larus_dp_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="?attr/larus_dp_4"
            android:layout_marginEnd="?attr/larus_dp_4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/title_battery_container"
            app:layout_constraintStart_toEndOf="@+id/title_back"
            app:layout_constraintTop_toTopOf="parent">
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_20"
                android:textColor="@color/larus_neutral_100"
                android:ellipsize="end"
                android:id="@+id/title_device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="?attr/larus_dp_162"
                android:maxLines="1"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/title_arrow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/larus_dora_g_device_management_dropdown"
                android:layout_marginStart="?attr/larus_dp_4"
                app:tint="@color/larus_neutral_100"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/title_battery_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/title_settings"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/title_battery_icon"
                android:layout_width="?attr/larus_dp_28"
                android:layout_height="?attr/larus_dp_28"
                android:src="@null"
                android:layout_marginEnd="?attr/larus_dp_4"
                app:tint="@color/larus_neutral_100"/>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/larus_neutral_100"
                android:id="@+id/title_battery_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/title_settings"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            android:layout_marginEnd="?attr/larus_dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/larus_ic_settings"/>
        <View
            android:id="@+id/title_settings_red_dot"
            android:background="@drawable/larus_red_dot_bg"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_8"
            android:layout_height="?attr/larus_dp_8"
            android:layout_marginTop="?attr/larus_dp_6"
            android:layout_marginEnd="?attr/larus_dp_6"
            app:layout_constraintEnd_toEndOf="@+id/title_settings"
            app:layout_constraintTop_toTopOf="@+id/title_settings"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.larus.common_ui.refresh.SuperSwipeRefreshLayout
        android:id="@+id/refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0"
        android:layout_weight="1">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"/>
        </FrameLayout>
    </com.larus.common_ui.refresh.SuperSwipeRefreshLayout>
</LinearLayout>
