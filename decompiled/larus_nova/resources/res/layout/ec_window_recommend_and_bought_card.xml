<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.window.shop.widget.WindowRecommendAndBoughtCard xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/user_bought_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/commerce_color_80FFFFFF"
            android:id="@+id/ec_shop_user_bought_empty"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ec_shop_no_follow_record"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/user_bought_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12dp"
                android:textColor="@color/commerce_color_80FFFFFF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ec_shop_chao"/>
            <TextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="@color/commerce_color_80FFFFFF"
                android:id="@+id/ec_shop_bought_count"
                android:padding="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/commerce_color_80FFFFFF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ec_shop_follower_buy"/>
        </LinearLayout>
        <View
            android:id="@+id/ec_shop_line"
            android:background="@color/shopping_color_1AFFFFFF"
            android:layout_width="1dp"
            android:layout_height="12dp"
            android:layout_marginTop="0.5dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/shopping_color_66FFFFFF"
            android:gravity="center_vertical"
            android:id="@+id/ec_shop_recommend_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ec_shop_recommend_count"/>
    </LinearLayout>
</com.bytedance.android.window.shop.widget.WindowRecommendAndBoughtCard>
