<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ec.store.widget.ECRoundedLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/store_product_card"
    android:background="@color/shopping_std_bg_primary_white"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:rounded_radius="12dp">
    <com.bytedance.android.ui.base.widget.round.RoundRelativeLayout
        android:id="@+id/store_product_card_image_above"
        android:layout_width="135dp"
        android:layout_height="135dp"
        app:bg_cornerRadius_BL="12dp"
        app:bg_cornerRadius_BR="0dp"
        app:bg_cornerRadius_TL="12dp"
        app:bg_cornerRadius_TR="0dp">
        <com.bytedance.android.ec.core.widget.AspectRatioFrameLayout
            android:id="@+id/store_product_card_image_wrapper"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/store_product_card_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:placeholderImage="@drawable/ecommerce_slogan_product_single_bg"
                app:roundBottomLeft="true"
                app:roundBottomRight="false"
                app:roundTopLeft="true"
                app:roundTopRight="false"
                app:roundedCornerRadius="12dp"/>
            <com.bytedance.android.shopping.store.home.view.ShopNoTouchViewpager
                android:id="@+id/shop_product_image_viewpager"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <include layout="@layout/shopping_layout_store_card_video"/>
            <View
                android:background="@color/shopping_std_bg_black_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.bytedance.android.ec.core.widget.AspectRatioFrameLayout>
        <com.bytedance.android.ec.core.widget.RoundedLinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/store_product_card_live_status"
            android:background="@color/ec_store_FFB3B3B3"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            app:rounded_radius="10dp">
            <com.bytedance.android.ec.core.widget.RoundedLinearLayout
                android:gravity="center"
                android:id="@+id/store_product_card_live_status_bg"
                android:layout_width="18dp"
                android:layout_height="18dp">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/store_product_card_live_status_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    app:roundAsCircle="true"/>
            </com.bytedance.android.ec.core.widget.RoundedLinearLayout>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/shopping_std_text_white_1"
                android:id="@+id/store_product_card_live_status_text"
                android:paddingLeft="4dp"
                android:paddingRight="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"/>
        </com.bytedance.android.ec.core.widget.RoundedLinearLayout>
    </com.bytedance.android.ui.base.widget.round.RoundRelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="6dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/store_sku_image_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.bytedance.android.ec.store.widget.BreakWordTextView
            android:textSize="14dp"
            android:textColor="@color/shopping_std_text_black_1"
            android:id="@+id/store_product_card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:lineSpacingExtra="3dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/shopping_color_B28059"
            android:ellipsize="none"
            android:id="@+id/store_product_card_recommend_info"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"/>
        <com.bytedance.android.ec.store.view.ECTagListView
            android:id="@+id/store_product_card_recommend_info_new"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>
        <LinearLayout
            android:gravity="bottom"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_constraintStart_toStartOf="parent"
                    layout="@layout/ec_store_product_card_info_price_v2"/>
                <com.bytedance.android.ec.store.view.ECTagListView
                    android:gravity="center_vertical"
                    android:id="@+id/store_product_card_tag_list_new"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_marginEnd="6dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/store_product_card_add_to_cart"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintRight_toLeftOf="@+id/store_product_card_add_to_cart"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/store_product_card_price_wrapper"
                    app:layout_goneMarginEnd="0dp"/>
                <include
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_marginEnd="6dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toLeftOf="@+id/store_product_card_add_to_cart"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/store_product_card_price_wrapper"
                    app:layout_goneMarginEnd="0dp"
                    layout="@layout/ec_store_product_card_info_taglist"/>
                <ImageView
                    android:id="@+id/store_product_card_add_to_cart"
                    android:background="@drawable/ec_store_ic_add_to_cart_pink_new"
                    android:visibility="gone"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="1dp"
                    android:layout_alignParentEnd="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </LinearLayout>
</com.bytedance.android.ec.store.widget.ECRoundedLinearLayout>
