<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ai_bottom_bar_root"
    android:background="@color/doubao_picker_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="8dp">
    <View
        android:id="@+id/ai_bottom_bar_top_divider"
        android:background="@color/larus_neutral_transparent_1"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ai_bottom_bar_selected_avatar_list"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingEnd="4dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ai_bottom_bar_toolbar"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/doubao_picker_subtitle_text"
            android:layout_gravity="center_vertical"
            android:id="@+id/ai_bottom_bar_selection_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="10dp"/>
        <Button
            android:textSize="15sp"
            android:textColor="#ffffff"
            android:id="@+id/ai_bottom_bar_confirm_button"
            android:background="@drawable/bg_mobile_ai_office_bottom_button"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minHeight="44dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"/>
    </LinearLayout>
</LinearLayout>
