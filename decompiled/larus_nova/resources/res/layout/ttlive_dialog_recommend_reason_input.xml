<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_recommend_reason_root"
    android:background="@drawable/ttlive_bg_long_press_v2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_recommend_reason_title_color"
        android:id="@+id/tv_recommend_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/ttlive_recommend_reason_title_success"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/btn_close"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/ttlive_notification_setting_cancel"
        android:contentDescription="@string/ttlive_recommend_reason_close_desc"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <EditText
        android:textSize="15dp"
        android:textColor="@color/ttlive_recommend_reason_title_color"
        android:textColorHint="@color/ttlive_recommend_reason_hint_text_color"
        android:gravity="start|top"
        android:id="@+id/et_recommend_reason"
        android:background="@drawable/ttlive_recommend_reason_input_bg"
        android:paddingTop="12dp"
        android:layout_width="0dp"
        android:layout_height="87dp"
        android:layout_marginTop="14dp"
        android:hint="@string/ttlive_recommend_reason_input_hint"
        android:inputType="textMultiLine"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_recommend_status"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_recommend_reason_send_text_color"
        android:gravity="center"
        android:id="@+id/btn_send"
        android:background="@drawable/ttlive_recommend_reason_send_bg"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp"
        android:text="@string/ttlive_recommend_reason_send_text"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_recommend_reason"/>
</androidx.constraintlayout.widget.ConstraintLayout>
