<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/empty_cover"
        android:layout_width="197dp"
        android:layout_height="140dp"
        android:layout_marginTop="78dp"
        app:actualImageScaleType="fitXY"/>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/ttlive_black"
        android:layout_gravity="center_horizontal"
        android:id="@+id/empty_hint_phase1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/ttlive_pk_rivals_search_empty_hint_phase1"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#80161823"
        android:layout_gravity="center_horizontal"
        android:id="@+id/empty_hint_phase2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ttlive_pk_rivals_search_empty_hint_phase2"/>
</LinearLayout>
