<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="end"
        android:paddingLeft="@dimen/ec_store_popup_menu_elevation"
        android:paddingRight="@dimen/ec_store_popup_menu_elevation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="@dimen/ec_store_popup_menu_elevation">
        <androidx.cardview.widget.CardView
            android:layout_gravity="end"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="@dimen/ec_store_popup_menu_radius"
            android:layout_marginTop="@dimen/ec_store_popup_menu_radius"
            android:layout_marginRight="@dimen/ec_store_popup_menu_radius"
            android:layout_marginBottom="-16dp"
            android:rotation="45"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="4dp"
            app:cardElevation="4dp"/>
    </FrameLayout>
    <androidx.cardview.widget.CardView
        android:layout_width="@dimen/ec_store_popup_menu_width"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ec_store_popup_menu_elevation"
        android:layout_marginRight="@dimen/ec_store_popup_menu_elevation"
        android:layout_marginBottom="@dimen/ec_store_popup_menu_elevation"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="@dimen/ec_store_popup_menu_radius"
        app:cardElevation="@dimen/ec_store_popup_menu_elevation">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ec_shop_popup_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ec_shop_popup_menu_my_order"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <View
                    android:background="@drawable/ec_window_ic_order_black"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/shopping_std_text_modal_1"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/commerce_my_order"
                    android:lines="1"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ec_shop_popup_menu_shop_window"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/ec_shop_popup_menu_shop_window_icon"
                    android:background="@drawable/ec_window_ic_window_black"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginEnd="8dp"
                    app:actualImageScaleType="centerCrop"/>
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/shopping_std_text_modal_1"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/ec_shop_popup_menu_shop_window_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lines="1"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ec_shop_popup_menu_cart"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <View
                    android:background="@drawable/ec_window_ic_cart_black"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/shopping_std_text_modal_1"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/commerce_cart"
                    android:lines="1"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ec_shop_popup_menu_share"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <View
                    android:background="@drawable/ec_window_ic_share_black"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/shopping_std_text_modal_1"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/commerce_share"
                    android:lines="1"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
