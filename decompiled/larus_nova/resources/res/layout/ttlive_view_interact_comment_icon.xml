<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center"
        android:id="@+id/inter_comment_icon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="fitXY"
        app:placeholderImage="@drawable/ttlive_inter_com_close_icon"
        app:placeholderImageScaleType="fitXY"/>
    <View
        android:layout_gravity="end|top"
        android:id="@+id/guide_dot"
        android:background="@drawable/ttlive_interact_audience_setting_guide_dot"
        android:visibility="gone"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginRight="2dp"
        android:layout_marginEnd="2dp"/>
</FrameLayout>
