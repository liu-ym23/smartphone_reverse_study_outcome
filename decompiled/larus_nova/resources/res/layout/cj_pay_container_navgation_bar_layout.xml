<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/cj_pay_navigation_bar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cj_pay_height_44">
    <ImageView
        android:id="@+id/cj_pay_left_iv"
        android:padding="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:src="?attr/cj_pay_action_bar_arrow_icon"
        android:scaleType="centerCrop"
        android:layout_centerVertical="true"
        android:contentDescription="@string/cj_pay_return_text"/>
    <TextView
        android:textSize="16dp"
        android:textColor="?attr/cj_pay_action_bar_text_color"
        android:ellipsize="middle"
        android:id="@+id/cj_pay_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/cj_pay_right_iv"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:scaleType="centerCrop"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</RelativeLayout>
