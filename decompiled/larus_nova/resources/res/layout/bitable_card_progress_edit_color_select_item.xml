<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/space_kit_len_60"
    android:layout_height="@dimen/space_kit_len_60">
    <View
        android:layout_gravity="center"
        android:id="@+id/gradientColorPreview"
        android:background="@color/app_launcher_background"
        android:visibility="gone"
        android:layout_width="@dimen/space_kit_len_60"
        android:layout_height="@dimen/space_kit_len_60"/>
    <com.bytedance.ee.bear.bitable.fieldedit.view.widgets.GradientOffsetView
        android:layout_gravity="center"
        android:id="@+id/defaultColorPreview"
        android:visibility="gone"
        android:layout_width="@dimen/space_kit_len_60"
        android:layout_height="@dimen/space_kit_len_60"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/selectTip"
        android:layout_width="@dimen/space_kit_len_24"
        android:layout_height="@dimen/space_kit_len_24"
        app:srcCompat="@drawable/ud_icon_list_check_bold_outlined"
        app:tint="@color/static_white"/>
</FrameLayout>
