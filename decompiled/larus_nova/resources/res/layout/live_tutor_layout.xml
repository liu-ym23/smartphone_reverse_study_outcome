<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/live_tutor_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">
    <com.larus.livetutor.impl.view.LiveTutorPlanView
        android:id="@+id/live_tutor_plan_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toBottomOf="@+id/live_tutor_top_bar"/>
    <com.larus.livetutor.impl.view.LiveTutorTeachView
        android:id="@+id/live_tutor_teach_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.larus.livetutor.impl.view.LiveTutorTopBarView
        android:id="@+id/live_tutor_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <ViewStub
        android:id="@+id/tts_speed_control_hint_stub"
        android:layout="@layout/live_tutor_layout_tts_speed_control_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/live_tutor_top_bar"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/live_tutor_transition_lottie"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="matrix"/>
    <com.larus.livetutor.impl.view.LiveTutorFragmentContainer
        android:id="@+id/live_tutor_fragment_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/live_tutor_error_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.larus.livetutor.impl.view.TutorLogPanel
        android:id="@+id/debug_log"
        android:background="#000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/debug"
        android:background="#1ac87c"
        android:visibility="gone"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:text="Debug"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
