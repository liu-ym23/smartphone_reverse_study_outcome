<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/cj_pay_item_normal_pay_root_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cj_pay_payment_method_upper_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <ImageView
            android:id="@+id/cj_pay_payment_method_icon"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/cj_pay_payment_method_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cj_pay_payment_method_title"/>
        <ImageView
            android:id="@+id/cj_pay_payment_method_icon_unable_mask"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="16dp"
            android:src="@drawable/cj_pay_bg_payment_icon_unable_style_5"
            app:layout_constraintBottom_toBottomOf="@+id/cj_pay_payment_method_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cj_pay_payment_method_title"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/cj_pay_color_black_161823"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/cj_pay_payment_method_title"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toStartOf="@+id/cj_pay_payment_method_label"
            app:layout_constraintStart_toEndOf="@+id/cj_pay_payment_method_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_goneMarginLeft="44dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
            android:ellipsize="end"
            android:id="@+id/cj_pay_payment_method_sub_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/cj_pay_payment_method_title"
            app:layout_constraintTop_toBottomOf="@+id/cj_pay_payment_method_title"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/cj_pay_color_red"
            android:gravity="center"
            android:id="@+id/cj_pay_payment_method_sub_label_first"
            android:background="@drawable/cj_pay_bg_payment_method_recommend_way"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/cj_pay_payment_method_title"
            app:layout_constraintTop_toBottomOf="@+id/cj_pay_payment_method_title"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/cj_pay_color_red"
            android:gravity="center"
            android:id="@+id/cj_pay_payment_method_sub_label_second"
            android:background="@drawable/cj_pay_bg_payment_method_recommend_way"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="4dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cj_pay_payment_method_sub_label_first"
            app:layout_constraintTop_toBottomOf="@+id/cj_pay_payment_method_title"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
            android:id="@+id/cj_pay_payment_method_label"
            android:paddingLeft="8dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginRight="36dp"
            android:text="@string/cj_pay_without_card_no"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cj_pay_payment_method_title"/>
        <com.android.ttcjpaysdk.base.theme.widget.CJPayCircleCheckBox
            android:id="@+id/cj_pay_payment_method_checkbox"
            android:visibility="visible"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="16dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="@+id/cj_pay_payment_method_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cj_pay_payment_method_title"/>
        <ImageView
            android:id="@+id/cj_pay_payment_method_arrow"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="16dp"
            android:src="@drawable/cj_pay_icon_right_arrow_noise_reduction"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/cj_pay_payment_method_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cj_pay_payment_method_title"/>
        <ProgressBar
            android:id="@+id/cj_pay_payment_method_loading"
            android:background="@color/cj_pay_color_trans"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginRight="13dp"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/cj_pay_method_loading_circle"
            android:indeterminateDuration="500"
            android:indeterminateBehavior="repeat"
            app:layout_constraintBottom_toBottomOf="@+id/cj_pay_payment_method_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cj_pay_payment_method_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/cj_pay_payment_method_more_bank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="42dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
            android:ellipsize="end"
            android:id="@+id/cj_pay_payment_method_more_bank_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"/>
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/cj_pay_right_arrow"/>
    </LinearLayout>
</LinearLayout>
