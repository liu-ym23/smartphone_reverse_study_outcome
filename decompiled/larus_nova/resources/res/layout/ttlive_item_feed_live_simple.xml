<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@null"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/live_cover"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        app:placeholderImage="@drawable/ttlive_feed_cover_loading"
        app:placeholderImageScaleType="fitXY"
        app:roundedCornerRadius="@dimen/ttlive_dimen_feed_img_corner_radius"/>
    <View
        android:id="@+id/content_mask"
        android:background="@drawable/ttlive_bg_live_feed_small"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignLeft="@+id/live_cover"
        android:layout_alignRight="@+id/live_cover"
        android:layout_alignBottom="@+id/live_cover"
        android:layout_alignStart="@+id/live_cover"
        android:layout_alignEnd="@+id/live_cover"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/live_room_label"
        android:visibility="gone"
        android:layout_width="65dp"
        android:layout_height="20dp"
        android:layout_marginLeft="@dimen/ttlive_feed_live_lable_margin_left"
        android:layout_marginTop="@dimen/ttlive_feed_live_lable_margin_top"
        android:scaleType="centerInside"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/ttlive_feed_live_lable_margin_left"
        android:layout_alignParentStart="true"
        app:roundBottomLeft="false"
        app:roundBottomRight="false"
        app:roundTopLeft="true"
        app:roundTopRight="false"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/live_state_layout"
        android:background="@drawable/ttlive_bg_double_column_live_state"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="@dimen/ttlive_feed_live_state_margin_top"
        android:layout_marginRight="@dimen/ttlive_feed_live_state_margin_right"
        android:layout_alignTop="@+id/live_cover"
        android:layout_alignRight="@+id/live_cover"
        android:layout_marginEnd="@dimen/ttlive_feed_live_state_margin_right"
        android:layout_alignEnd="@+id/live_cover">
        <ImageView
            android:id="@+id/live_type"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="3dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:src="@drawable/ttlive_icon_camera_item"
            android:layout_marginStart="3dp"/>
        <View
            android:id="@+id/live_state_ic"
            android:background="@drawable/ttlive_ic_live_state"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="4dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="@dimen/ttlive_feed_live_state_text_size"
            android:textColor="@color/ttlive_hs_s5"
            android:gravity="center"
            android:id="@+id/live_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:text="@string/ttlive_feed_on_live"
            android:layout_marginEnd="6dp"/>
    </LinearLayout>
    <com.bytedance.android.livesdk.feed.openui.view.SimpleLiveView
        android:id="@+id/live_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_container"
        android:paddingBottom="@dimen/ttlive_feed_live_content_padding_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ttlive_feed_live_content_margin_left"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/ttlive_feed_live_content_margin_left">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/room_content_label"
            android:background="@drawable/ttlive_ic_red_envelope_feed"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginBottom="4dp"/>
        <LinearLayout
            android:id="@+id/locate_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_locate"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ttlive_ic_locate"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/locate"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:text="@string/ttlive_feed_mars"
                android:singleLine="true"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/ttlive_feed_live_title_text_size"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ttlive_feed_live_title_height"
            android:maxEms="10"
            android:singleLine="true"/>
        <com.bytedance.android.live.core.widget.CustomFontTextView
            android:textSize="@dimen/ttlive_feed_live_audience_count_text_size"
            android:textColor="@color/ttlive_feed_audience_count_color"
            android:gravity="center"
            android:id="@+id/audience_count"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ttlive_feed_live_audience_count_height"
            android:layout_marginTop="4dp"
            android:text="@string/ttlive_feed_live_feed_count_0"
            android:singleLine="true"/>
    </LinearLayout>
</RelativeLayout>
