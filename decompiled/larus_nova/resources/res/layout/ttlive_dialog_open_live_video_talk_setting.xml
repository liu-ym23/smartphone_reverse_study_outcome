<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/setting_content"
    android:background="@drawable/ttlive_bg_open_live_video_talk"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/video_talk_room_setting_title"
        android:padding="17dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_video_talk_scene_talk_room"/>
    <FrameLayout
        android:id="@+id/fl_open_talk_room"
        android:background="@drawable/ttlive_bg_live_interact_list"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/tv_open_talk_room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:text="@string/ttlive_interact_open_live_talk_room"
            android:layout_marginStart="16dp"/>
        <Switch
            android:layout_gravity="end|center_vertical"
            android:id="@+id/switch_open_talk_room"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginRight="16dp"
            android:checked="false"
            android:textOn=""
            android:textOff=""
            android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
            android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
            android:layout_marginEnd="16dp"/>
    </FrameLayout>
    <TextView
        android:textSize="13dp"
        android:textColor="#99161823"
        android:id="@+id/tv_layout_setting"
        android:paddingLeft="32dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_interact_layout_setting"
        android:paddingStart="32dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_layout_switch"
        android:background="@drawable/ttlive_bg_live_interact_list"
        android:padding="16dp"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="82dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/empty_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_video_camera_layout"
            android:background="@drawable/ttlive_video_talk_switch_scene_selected_bg"
            android:paddingLeft="3dp"
            android:paddingTop="3dp"
            android:paddingRight="3dp"
            android:paddingBottom="3dp"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:src="@drawable/ttlive_video_talk_camera_layout_setting_bg"
            android:scaleType="fitXY"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/iv_equal_talkroom_layout"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_camera_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/iv_video_camera_layout"
            app:layout_constraintStart_toStartOf="@+id/iv_video_camera_layout"
            app:layout_constraintTop_toTopOf="@+id/iv_video_camera_layout">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginLeft="9dp"
                android:src="@drawable/ttlive_video_camera_layout_icon"
                android:layout_marginStart="9dp"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#161823"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/ttlive_interact_video_talk_layout"
                android:importantForAccessibility="no"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/iv_equal_talkroom_layout"
            android:paddingLeft="3dp"
            android:paddingTop="3dp"
            android:paddingRight="3dp"
            android:paddingBottom="3dp"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginLeft="15dp"
            android:src="@drawable/ttlive_video_talk_equal_layout_setting_bg"
            android:scaleType="fitXY"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:layout_marginStart="15dp"
            app:layout_constraintLeft_toRightOf="@+id/iv_video_camera_layout"
            app:layout_constraintRight_toLeftOf="@+id/empty_view"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_equal_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/iv_equal_talkroom_layout"
            app:layout_constraintStart_toStartOf="@+id/iv_equal_talkroom_layout"
            app:layout_constraintTop_toTopOf="@+id/iv_equal_talkroom_layout">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginLeft="9dp"
                android:src="@drawable/ttlive_equal_talkroom_layout_icon"
                android:layout_marginStart="9dp"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#161823"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/ttlive_interact_equal_talk_layout"
                android:importantForAccessibility="no"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/fl_dynamic_window"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/empty_view"
            app:layout_constraintTop_toBottomOf="@+id/iv_video_camera_layout">
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#161823"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/tv_dynamic_window"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_interact_dynamic_window_text_new"/>
            <Switch
                android:layout_gravity="end|center_vertical"
                android:id="@+id/switch_dynamic_window"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:checked="false"
                android:textOn=""
                android:textOff=""
                android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
                android:track="@drawable/ttlive_selector_interact_dialog_switch_track"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
