<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="66dp">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/dv_live_cover"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAsCircle="true"/>
    <View
        android:id="@+id/iv_live_cover_border"
        android:background="@drawable/shopping_icon_feed_live_hint_border"
        android:layout_width="58dp"
        android:layout_height="58dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/shopping_bg_inflow_feed_live_desc"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="45dp"
        app:layout_constraintLeft_toLeftOf="@+id/iv_live_cover_border"
        app:layout_constraintRight_toRightOf="@+id/iv_live_cover_border"
        app:layout_constraintTop_toTopOf="@+id/iv_live_cover_border">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lav_live_hint"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="4dp"
            app:lottie_autoPlay="true"
            app:lottie_fileName="shopping_lottie_feed_live_hint.json"
            app:lottie_repeatCount="-1"
            app:lottie_repeatMode="reverse"/>
        <TextView
            android:textSize="10dp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:id="@+id/tv_live_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:maxLines="1"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
