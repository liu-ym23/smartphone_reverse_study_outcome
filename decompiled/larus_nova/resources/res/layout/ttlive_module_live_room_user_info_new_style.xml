<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="52dp">
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/anchor_info_container"
        android:background="@drawable/ttlive_bg_user_layout_new_style"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="10dp">
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/avatar_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true">
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/digg_avatar_animation_container"
                android:layout_width="60dp"
                android:layout_height="60dp"/>
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/digg_thank_container"
                android:paddingLeft="36dp"
                android:paddingRight="6dp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:paddingStart="36dp"
                android:paddingEnd="6dp"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="center"
                android:id="@+id/head"
                android:background="@drawable/ttlive_bg_circle_head"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="fitXY"/>
            <ImageView
                android:layout_gravity="end|bottom"
                android:id="@+id/user_verify_label"
                android:visibility="gone"
                android:layout_width="@dimen/ttlive_user_verify_label_size"
                android:layout_height="@dimen/ttlive_user_verify_label_size"
                android:layout_marginRight="-4dp"
                android:layout_marginBottom="-4dp"
                android:layout_marginEnd="-4dp"/>
            <TextView
                android:textSize="8dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/user_no_beauty_label"
                android:background="@drawable/ttlive_bg_user_no_beauty_label"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="12dp"
                android:layout_marginBottom="2dp"
                android:text="@string/ttlive_no_beauty_label"/>
        </FrameLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="-2dp"
            android:layout_toRightOf="@+id/avatar_container"
            android:layout_centerVertical="true"
            android:layout_marginStart="-2dp"
            android:layout_toEndOf="@+id/avatar_container">
            <com.bytedance.android.live.core.view.MaxWidthLinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/name_layout"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/ttlive_user_info_inside_spacing"
                android:layout_marginRight="@dimen/ttlive_user_info_inside_spacing"
                android:layout_marginStart="@dimen/ttlive_user_info_inside_spacing"
                android:layout_marginEnd="@dimen/ttlive_user_info_inside_spacing"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_default="wrap">
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/ttlive_white"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:shadowDy="1"
                    android:shadowRadius="1"
                    android:lineSpacingExtra="0.5dp"/>
                <TextView
                    android:textSize="8dp"
                    android:textColor="@color/ttlive_core_hs_w1_transparent_70"
                    android:gravity="center"
                    android:id="@+id/ticket_number"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/ticket_number_new_style"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp">
                    <TextView
                        android:textSize="8dp"
                        android:textColor="#ffffff"
                        android:id="@+id/ticket_number_left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:shadowColor="#26000000"
                        android:shadowDy="1"
                        android:shadowRadius="1"
                        android:lineSpacingExtra="-1sp"/>
                    <TextView
                        android:textSize="8dp"
                        android:textColor="#eae9e9"
                        android:id="@+id/ticket_number_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:shadowColor="#26000000"
                        android:shadowDy="1"
                        android:shadowRadius="1"
                        android:lineSpacingExtra="-1sp"/>
                </LinearLayout>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/ttlive_hs_w2"
                    android:gravity="center"
                    android:id="@+id/fans_number"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="1dp"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
                <FrameLayout
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/fl_room_cert"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"/>
            </com.bytedance.android.live.core.view.MaxWidthLinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/right_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/ttlive_user_info_inside_spacing"
                android:minWidth="40dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/name_layout"
                app:layout_constraintTop_toTopOf="parent"/>
            <FrameLayout
                android:id="@+id/entrance_container"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/name_layout"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>
    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginLeft="2dp"
        android:layout_marginStart="2dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/iv_ceremony_border"
            android:layout_width="38dp"
            android:layout_height="38dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/digg_heart_animation_container"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="-7.35dp"
        android:layout_marginStart="16dp"/>
</RelativeLayout>
