<?xml version="1.0" encoding="utf-8"?>
<com.larksuite.component.ui.layout.LKUIRoundableLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_fixed_btn"
    android:background="@color/bg_body"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="@color/ud_button_white_grey_bg"
    app:rl_border_color="@color/line_border_component"
    app:rl_border_width="@dimen/space_kit_len_1"
    app:rl_radius="@dimen/ud_radius_m">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/bottom_fixed_btn_icon"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="false"
            android:layout_width="@dimen/space_kit_len_20"
            android:layout_height="@dimen/space_kit_len_20"
            android:tint="@color/bitable_selector_item_icon_color"
            app:srcCompat="@drawable/ud_icon_add_outlined"/>
        <TextView
            android:textSize="@dimen/space_kit_font_17"
            android:textColor="@drawable/space_kit_txt_color_enable_selector"
            android:id="@+id/bottom_fixed_btn_text"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Bitable_Relation_AddCondition"
            android:layout_marginStart="@dimen/space_kit_len_4"/>
        <com.larksuite.component.universe_design.badge.UDBadgeView
            android:layout_gravity="center_vertical"
            android:id="@+id/bottom_fixed_btn_badge"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            app:ud_badge_text="@string/Bitable_Common_NewStatus"
            app:ud_badge_textSize="12sp"
            style="@style/UDBadge.Text"/>
    </LinearLayout>
</com.larksuite.component.ui.layout.LKUIRoundableLayout>
