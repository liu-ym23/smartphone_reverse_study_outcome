<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/cj_pay_lynx_dialog_root_layout"
    android:background="#57000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_centerInParent="true">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/cj_pay_keep_dialog_v2_bg"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:layout_gravity="left"
            android:id="@+id/keep_dialog_close_image"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/cj_pay_icon_titlebar_left_close_noise_reduction"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#ff04498d"
            android:layout_gravity="right"
            android:id="@+id/keep_dialog_top_right_btn"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginRight="20dp"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/cj_pay_color_black_161823"
            android:ellipsize="middle"
            android:gravity="center_horizontal"
            android:id="@+id/keep_dialog_v2_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="20dp"
            android:maxLines="2"/>
        <ScrollView
            android:id="@+id/keep_dialog_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="24dp">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/keep_dialog_scroll_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.android.ttcjpaysdk.base.ui.dialog.nativev2.CJPayDoubleVoucherTagsLayout
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/keep_dialog_double_voucher_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"/>
                <com.android.ttcjpaysdk.base.ui.dialog.nativev2.CJPayReasonSelectorLayout
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/keep_dialog_reason_selector"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </ScrollView>
        <com.android.ttcjpaysdk.base.ui.widget.LoadingButton
            android:id="@+id/keep_dialog_v2_confirm_button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="13dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#99161823"
            android:id="@+id/keep_dialog_v2_cancel_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="13dp"/>
    </LinearLayout>
</RelativeLayout>
