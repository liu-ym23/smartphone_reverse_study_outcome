<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/credit_pay_content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/cj_pay_payment_method_icon_layout"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="@dimen/cj_pay_padding_16"
            android:layout_marginTop="14dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="14dp"
            android:layout_centerVertical="true">
            <ImageView
                android:id="@+id/cj_pay_payment_method_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"/>
            <ImageView
                android:id="@+id/cj_pay_payment_method_icon_unable_mask"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/cj_pay_bg_payment_icon_unable_style_5"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/cj_pay_payment_method_content_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/cj_pay_payment_method_icon_layout"
            android:layout_centerVertical="true">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/content_first_line_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:ellipsize="end"
                    android:id="@+id/cj_pay_payment_method_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/cj_pay_color_red"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/cj_pay_payment_method_recommend_icon"
                    android:background="@drawable/cj_pay_bg_payment_method_recommend_way"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/cj_pay_padding_8"
                    android:text="@string/cj_pay_recommend_way"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/content_second_line_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
                    android:ellipsize="end"
                    android:id="@+id/cj_pay_payment_method_sub_title"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cj_pay_padding_4"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/cj_pay_payment_method_sub_title_icon_labels"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </RelativeLayout>
        </LinearLayout>
        <com.android.ttcjpaysdk.base.theme.widget.CJPayCircleCheckBox
            android:id="@+id/cj_pay_payment_method_checkbox"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="@dimen/cj_pay_padding_16"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
            android:id="@+id/cj_pay_payment_method_label"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="32dp"
            android:includeFontPadding="false"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/cj_pay_payment_method_arrow"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/cj_pay_padding_16"
            android:src="@drawable/cj_pay_icon_right_arrow_noise_reduction"
            android:scaleType="centerCrop"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:importantForAccessibility="no"/>
        <ProgressBar
            android:id="@+id/cj_pay_payment_method_loading"
            android:background="@color/cj_pay_color_trans"
            android:visibility="gone"
            android:layout_width="@dimen/cj_pay_padding_24"
            android:layout_height="@dimen/cj_pay_padding_24"
            android:layout_marginRight="13dp"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_gray"
            android:indeterminateDuration="500"
            android:indeterminateBehavior="repeat"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <HorizontalScrollView
        android:id="@+id/credit_pay_voucher_horizontal_scroll_view"
        android:paddingRight="16dp"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_height_52"
        android:layout_marginBottom="@dimen/cj_pay_padding_4">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/credit_pay_voucher_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </HorizontalScrollView>
</LinearLayout>
