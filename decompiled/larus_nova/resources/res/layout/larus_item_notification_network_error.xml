<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/refresh_lay"
    android:background="@color/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_width="?attr/larus_dp_60"
        android:layout_height="?attr/larus_dp_60"
        android:src="@drawable/larus_ic_refresh"/>
    <TextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/refresh_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_24"
        android:text="@string/larus_chat_list_load_failed"/>
    <View
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="2"/>
</LinearLayout>
