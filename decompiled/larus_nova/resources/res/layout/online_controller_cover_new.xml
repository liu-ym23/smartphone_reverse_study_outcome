<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/video_cover"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:transitionName="show_video_share_element"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/play_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/Lark_Legacy_PlayVideoButton"
        app:srcCompat="@drawable/video_play"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/controller_top_layout"
        android:background="@drawable/video_control_top_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ctrl_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="54dp"
            android:layout_marginStart="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/video_ctrl_close"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/controller_bottom_layout"
        android:background="@drawable/action_menu_gradient"
        android:paddingTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="80dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/lkui_N00"
            android:gravity="right"
            android:id="@+id/current_play_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:gravity="center"
            android:id="@+id/video_menu"
            android:background="@drawable/action_menu_bg"
            android:padding="6dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginRight="12dp"
            android:tint="@color/static_white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ud_icon_more_outlined"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:gravity="center"
            android:id="@+id/iv_view_chat_album_from_video"
            android:background="@drawable/action_menu_bg"
            android:padding="6dp"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginRight="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/video_menu"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ud_icon_photo_album_filled"
            app:tint="@color/static_white"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/lkui_N00"
            android:gravity="left"
            android:id="@+id/video_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dp_18"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/iv_view_chat_album_from_video"
            app:layout_constraintTop_toTopOf="parent"/>
        <SeekBar
            android:id="@+id/video_seek"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="11dp"
            android:layout_marginRight="11dp"
            android:maxHeight="4dp"
            android:progressDrawable="@drawable/video_seek_bar"
            android:minHeight="4dp"
            android:thumb="@drawable/video_seekbar_thumb_normal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/current_play_time"
            app:layout_constraintRight_toLeftOf="@+id/video_duration"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
