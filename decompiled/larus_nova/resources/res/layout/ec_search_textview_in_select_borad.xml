<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/filter_icon_left"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="2dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/filter_title_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:ellipsize="end"
            android:id="@+id/filter_main_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"/>
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:ellipsize="end"
            android:id="@+id/filter_sub_title_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/filter_icon_right"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"/>
</LinearLayout>
