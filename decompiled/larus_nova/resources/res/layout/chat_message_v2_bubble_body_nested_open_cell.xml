<?xml version="1.0" encoding="utf-8"?>
<com.ss.android.lark.chat.chatwindow.chat.message.cellv2.layout.slot.StackSlot xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/bubble_layout_body_slot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.larksuite.component.ui.layout.LKUIRoundLinearLayout
        android:orientation="vertical"
        android:id="@+id/bubble_layout_header_content_wrapper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.larksuite.component.ui.layout.LKUIRoundLinearLayout
            android:orientation="vertical"
            android:id="@+id/bubble_layout_header_slot"
            android:padding="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.larksuite.component.ui.layout.LKUIRoundLinearLayout
            android:orientation="vertical"
            android:id="@+id/bubble_layout_content_slot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </com.larksuite.component.ui.layout.LKUIRoundLinearLayout>
</com.ss.android.lark.chat.chatwindow.chat.message.cellv2.layout.slot.StackSlot>
