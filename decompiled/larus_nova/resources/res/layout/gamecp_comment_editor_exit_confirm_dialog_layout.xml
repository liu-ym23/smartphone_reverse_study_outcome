<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_bg_ffffff_corner_16"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/gamecp_game_161823"
        android:id="@+id/comment_exit_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/ttlive_game_promote_comment_editor_exit_dialog_title"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/gamecp_game_BF161823"
        android:id="@+id/comment_exit_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ttlive_game_promote_comment_editor_exit_dialog_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/comment_exit_title"/>
    <View
        android:id="@+id/comment_exit_divider"
        android:background="#1f161823"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/comment_exit_content"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/comment_exit_divider">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/gamecp_game_BF161823"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/comment_exit_cancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/ttlive_game_promote_comment_editor_exit_dialog_cancel"
            android:maxLines="1"
            android:lines="1"
            android:layout_weight="1"/>
        <View
            android:background="#1f161823"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/gamecp_game_161823"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/comment_exit_confirm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/ttlive_game_promote_comment_editor_exit_dialog_confirm"
            android:maxLines="1"
            android:lines="1"
            android:layout_weight="1"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
