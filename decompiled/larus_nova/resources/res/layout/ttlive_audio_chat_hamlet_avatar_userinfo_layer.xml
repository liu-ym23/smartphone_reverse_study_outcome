<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/top_guide_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.1648"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/user_info_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_guide_line">
        <View
            android:id="@+id/user_info_container_bg"
            android:background="@drawable/ttlive_bg_hamlet_avatar_first_user_info"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:minWidth="105dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_info_line"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/ttlive_guest_avatar_container"
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/guide_view_volume_container"
            android:layout_width="42dp"
            android:layout_height="42dp"
            app:layout_constraintBottom_toBottomOf="@+id/ttlive_guest_avatar_container"
            app:layout_constraintRight_toRightOf="@+id/ttlive_guest_avatar_container"
            app:layout_constraintStart_toStartOf="@+id/ttlive_guest_avatar_container"
            app:layout_constraintTop_toTopOf="@+id/ttlive_guest_avatar_container"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ttlive_volume_Anim"
            android:layout_width="42dp"
            android:layout_height="42dp"
            app:layout_constraintBottom_toBottomOf="@+id/guide_view_volume_container"
            app:layout_constraintEnd_toEndOf="@+id/guide_view_volume_container"
            app:layout_constraintStart_toStartOf="@+id/guide_view_volume_container"
            app:layout_constraintTop_toTopOf="@+id/guide_view_volume_container"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/ttlive_avatar_right_top_widget_container"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:translationX="16dp"
            android:translationY="-16dp"
            app:layout_constraintBottom_toBottomOf="@+id/ttlive_guest_avatar"
            app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_avatar">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/ttlive_avatar_right_top_widget"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ttlive_guest_info_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="5dp"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/ttlive_guest_avatar_container"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:id="@+id/ttlive_guest_name_container"
                android:clipChildren="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <View
                    android:layout_gravity="center_vertical"
                    android:id="@+id/ttlive_guest_identification"
                    android:background="@drawable/ttlive_ic_audio_chat_room_admin"
                    android:visibility="gone"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginRight="2dp"
                    android:layout_marginEnd="2dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/ttlive_guest_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lines="1"
                    android:lineSpacingExtra="0dp"
                    android:lineSpacingMultiplier="1"/>
            </LinearLayout>
            <com.bytedance.android.live.liveinteract.videotalk.quickinteract.interactView.LinkMicQuickInteractView
                android:id="@+id/ttlive_guest_fans_ticket_count"
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
        <View
            android:id="@+id/ttlive_guest_info_line"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/ttlive_guest_info_container"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/request_song_mic_icon_anim_view"
            android:layout_width="123dp"
            android:layout_height="42dp"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/request_song_mic_icon_number_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/request_song_mic_icon_anim_view"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="+"/>
            <TextView
                android:textSize="22dp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/request_song_mic_icon_number_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
        </LinearLayout>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ttlive_guest_avatar"
            android:background="@drawable/ttlive_bg_default_anchor_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/ttlive_guest_avatar_container"
            app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_avatar_container"
            app:layout_constraintStart_toStartOf="@+id/ttlive_guest_avatar_container"
            app:layout_constraintTop_toTopOf="@+id/ttlive_guest_avatar_container"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ttlive_guest_avatar_swap_anim"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constrainedHeight="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/ttlive_guest_avatar"
            app:layout_constraintLeft_toLeftOf="@+id/ttlive_guest_avatar"
            app:layout_constraintRight_toRightOf="@+id/ttlive_guest_avatar"
            app:layout_constraintTop_toTopOf="@+id/ttlive_guest_avatar"
            app:roundAsCircle="true"/>
        <View
            android:id="@+id/ttlive_enlarge_stoke"
            android:background="@drawable/ttlive_avatar_enlarge_seat_tag"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constrainedHeight="true"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/ttlive_guest_avatar"
            app:layout_constraintLeft_toLeftOf="@+id/ttlive_guest_avatar"
            app:layout_constraintRight_toRightOf="@+id/ttlive_guest_avatar"
            app:layout_constraintTop_toTopOf="@+id/ttlive_guest_avatar"/>
        <TextView
            android:textSize="4dp"
            android:textColor="#673405"
            android:gravity="center"
            android:id="@+id/ttlive_enlarge_txt"
            android:background="@drawable/ttlive_hamlet_avatar_seta_enlarge_txt_bg"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="8dp"
            android:text="@string/ttlive_live_interact_enlarge_guest_stub"
            app:layout_constraintLeft_toLeftOf="@+id/ttlive_guest_avatar"
            app:layout_constraintRight_toRightOf="@+id/ttlive_guest_avatar"
            app:layout_constraintTop_toTopOf="@+id/ttlive_guest_avatar"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ttlive_pause_container"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/ttlive_guest_avatar"
            app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_avatar"
            app:layout_constraintStart_toStartOf="@+id/ttlive_guest_avatar"
            app:layout_constraintTop_toTopOf="@+id/ttlive_guest_avatar">
            <View
                android:id="@+id/ttlive_leave_mask"
                android:background="#7f000000"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constrainedHeight="true"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/ttlive_leave_icon"
                android:background="@drawable/ttlive_icon_talk_room_anchor_pause_large"
                android:layout_width="20dp"
                android:layout_height="20dp"
                app:layout_constrainedHeight="true"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/ttlive_guest_sliece_view"
            android:background="@drawable/ttlive_icon_audio_hamlet_avatar_link_room_silence"
            android:layout_width="12dp"
            android:layout_height="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/ttlive_guest_avatar"
            app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_avatar"
            app:layout_constraintRight_toRightOf="@+id/ttlive_guest_avatar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
