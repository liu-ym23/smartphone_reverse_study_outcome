<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_vertical"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp_16"
    android:layout_marginTop="@dimen/dp_8"
    android:layout_marginRight="@dimen/dp_16">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_container_view"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dp_70">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_todo_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_todo_content_container"
                android:paddingRight="@dimen/dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:id="@+id/complete_checkbox_container"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2">
                    <ImageView
                        android:id="@+id/complete_checkbox"
                        android:layout_width="20sp"
                        android:layout_height="20sp"
                        android:layout_marginLeft="@dimen/dp_14"
                        android:layout_marginTop="@dimen/dp_12d5"
                        android:layout_marginBottom="@dimen/dp_12d5"/>
                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/complete_checkbox_lottie"
                        android:visibility="gone"
                        android:layout_width="33sp"
                        android:layout_height="33sp"
                        android:layout_marginLeft="@dimen/dp_9d5"
                        android:layout_marginTop="@dimen/dp_8"
                        android:layout_marginBottom="@dimen/dp_7"
                        app:lottie_autoPlay="false"
                        app:lottie_loop="true"/>
                </RelativeLayout>
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginBottom="@dimen/dp_12">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/title_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <com.ss.android.lark.widget.light.LKUILightTextView
                                android:textSize="@dimen/sp_16"
                                android:id="@+id/title_rich_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/dp_22"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                            <View
                                android:id="@+id/item_finish_line"
                                android:background="@color/text_caption"
                                android:layout_width="0dp"
                                android:layout_height="@dimen/dp_1"
                                android:layout_marginTop="@dimen/dp_2"
                                android:layout_centerVertical="true"
                                app:layout_constraintBottom_toBottomOf="@+id/title_rich_text"
                                app:layout_constraintLeft_toLeftOf="@+id/title_rich_text"
                                app:layout_constraintRight_toRightOf="@+id/title_rich_text"
                                app:layout_constraintTop_toTopOf="@+id/title_rich_text"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <com.ss.android.lark.todo.impl.features.common.widget.TaskUDAvatarList
                            android:id="@+id/task_owners"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:task_ud_avatarList_avatarSize="28sp"
                            app:task_ud_avatarList_maxCount="1"
                            app:task_ud_avatarList_overlapSize="4sp"
                            app:task_ud_avatarList_text_size="14sp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/ll_end_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4">
                        <TextView
                            android:textSize="@dimen/sp_14"
                            android:id="@+id/tv_end_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp_4"
                            android:singleLine="true"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
