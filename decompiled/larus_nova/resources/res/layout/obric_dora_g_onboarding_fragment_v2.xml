                <com.larus.dora.impl.view.DoraTextViewWithAnim
                    android:textSize="?attr/larus_sp_16"
                    android:textColor="@color/oui_basic_text_1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/obric_click_stop_query"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/onboarding_single_click_query"
                    android:maxLines="1"/>
            </FrameLayout>
            <LinearLayout
                android:layout_gravity="start"
                android:orientation="horizontal"
                android:id="@+id/obric_click_stop_answer_container"
                android:background="@drawable/obric_onboarding_query_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16">
                <ImageView
