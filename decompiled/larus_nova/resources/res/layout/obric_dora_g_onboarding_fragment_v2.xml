                    android:layout_gravity="top"
                    android:id="@+id/obric_query_topic_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
