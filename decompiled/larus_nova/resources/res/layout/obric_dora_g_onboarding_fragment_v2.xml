                    android:maxLines="4"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="1.5"
                    android:layout_marginEnd="?attr/larus_dp_12"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
