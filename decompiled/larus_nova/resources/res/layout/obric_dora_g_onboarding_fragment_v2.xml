        android:layout_width="?attr/larus_dp_80"
        android:layout_height="?attr/larus_dp_80"
        android:layout_marginBottom="?attr/larus_dp_92"
        android:layout_marginStart="?attr/larus_dp_92"
        app:layout_constraintBottom_toBottomOf="@+id/dora_onboarding_avatar_anchor_view"
