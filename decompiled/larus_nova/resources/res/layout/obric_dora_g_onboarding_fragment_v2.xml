            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerVertical="true"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"/>
        <com.larus.common_ui.view.CustomBarCountAudioVisualizer
            android:id="@+id/dora_onboarding_bubble_audio_anim"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_30"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <com.lynx.lottieadapter.LottieAdapterView
