            <com.larus.dora.impl.view.DoraTextViewWithAnim
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/oui_basic_text_1"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_12"
