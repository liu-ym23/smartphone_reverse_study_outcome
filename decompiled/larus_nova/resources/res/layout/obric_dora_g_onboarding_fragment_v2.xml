                android:id="@+id/obric_click_stop_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_onboarding_glasses_tap_stop_title_cn"
                android:includeFontPadding="false"/>
            <FrameLayout
