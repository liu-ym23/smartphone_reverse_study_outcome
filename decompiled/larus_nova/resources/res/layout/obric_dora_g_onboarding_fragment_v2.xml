        android:id="@+id/obric_video_query_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.larus.dora.obric.onboarding.BottomFadeImageContainer
            android:layout_gravity="top"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_330">
            <com.larus.dora.obric.onboarding.BottomFadeImageView
                android:id="@+id/iv_scene"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/onboarding_vision_scene_desc"
                app:actualImageScaleType="centerCrop"/>
            <com.larus.dora.obric.onboarding.BottomFadeImageView
                android:id="@+id/iv_scene_incoming"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:importantForAccessibility="no"
                app:actualImageScaleType="centerCrop"/>
        </com.larus.dora.obric.onboarding.BottomFadeImageContainer>
        <FrameLayout
            android:id="@+id/video_layer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/onboarding_vision_afx_desc"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:id="@+id/content_panel"
            android:paddingBottom="?attr/larus_dp_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_463">
            <com.larus.dora.impl.view.DoraTextViewWithAnim
                android:textSize="?attr/larus_sp_24"
                android:textStyle="bold"
                android:textColor="@color/oui_basic_text_1"
                android:gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_onboarding_glasses_visual_query_title_cn"
                android:includeFontPadding="false"/>
            <FrameLayout
                android:clipChildren="true"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_209"
                android:layout_marginTop="?attr/larus_dp_24">
