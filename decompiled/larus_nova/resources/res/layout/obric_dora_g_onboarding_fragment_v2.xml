                    android:layout_height="?attr/larus_dp_24"
                    android:layout_marginTop="?attr/larus_dp_12"
                    android:src="@drawable/larus_dora_onboarding_broadcast_avatar_img"
                    android:scaleType="fitXY"
                    android:contentDescription="@string/onboarding_single_click_avatar_desc"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="?attr/larus_dp_12"
                    android:layout_marginEnd="?attr/larus_dp_8"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/obric_click_stop_answer_loading_indicator"
                    android:visibility="gone"
                    android:layout_width="?attr/larus_dp_32"
                    android:layout_height="?attr/larus_dp_16"
                    android:layout_marginTop="?attr/larus_dp_16"
                    android:src="@drawable/larus_dora_h_reply_loading_indicator_animated"
                    android:contentDescription="@null"
                    android:layout_marginEnd="?attr/larus_dp_16"/>
                <com.larus.business.markdown.impl.markwon.MarkdownTextView
                    android:textSize="?attr/larus_sp_16"
                    android:textColor="@color/oui_basic_text_1"
                    android:ellipsize="end"
                    android:id="@+id/obric_click_stop_answer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_12"
                    android:layout_marginBottom="?attr/larus_dp_12"
