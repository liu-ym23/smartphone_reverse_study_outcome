<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <Button
            android:id="@+id/project_loin_button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/luckycat_login"/>
        <Button
            android:id="@+id/project_loin_state_button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/luckycat_ckeck_login_status"/>
        <Button
            android:id="@+id/project_exciting_video_ad_button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/luckycat_open_exciting_ad"/>
        <Button
            android:id="@+id/project_show_big_red_packet"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/luckycat_show_big_redpacket"/>
        <Button
            android:id="@+id/project_show_profit_dialog"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/luckycat_show_profit_dialog"/>
        <Button
            android:id="@+id/project_show_pop_dialog"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/luckcyat_show_popup"/>
        <Button
            android:id="@+id/project_get_walk_step"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/luckycat_get_steps"
            android:textAllCaps="false"/>
        <Button
            android:id="@+id/project_open_invite_friend"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/luckycat_open_invitation_page"/>
        <Button
            android:id="@+id/project_check_invite_code"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/luckycat_check_invitaion_code"/>
        <Button
            android:id="@+id/project_test_remote_url_config"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/luckycat_test_url_config"/>
        <Button
            android:id="@+id/btn_calendar_add"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="添加日历提醒"/>
        <Button
            android:id="@+id/btn_calendar_check"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="查询日历提醒"/>
        <Button
            android:id="@+id/btn_calendar_delete"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="删除日历提醒"/>
        <Button
            android:id="@+id/btn_open_floating_bar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="打开悬浮条"/>
        <Button
            android:id="@+id/btn_close_floating_bar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="关闭悬浮条"/>
        <EditText
            android:id="@+id/et_popup_dialog_fragment"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="输入弹窗schema"/>
        <Button
            android:id="@+id/btn_test_fragment"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/luckycat_test_layout"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:text="@string/luckycat_input_h5_url"/>
            <EditText
                android:id="@+id/js_bridge_test_edit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:textColor="@color/polaris_white"
                android:gravity="center"
                android:id="@+id/js_bridge_test_ok"
                android:background="#f85959"
                android:paddingLeft="8dp"
                android:paddingTop="4dp"
                android:paddingRight="8dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="30dp"
                android:text="@string/luckycat_ok"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="30dp"
                android:text="@string/luckycat_input_ab_key_url"/>
            <EditText
                android:id="@+id/et_ab_key"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:textColor="@color/polaris_white"
                android:gravity="center"
                android:id="@+id/tv_save_ab_key"
                android:background="#f85959"
                android:paddingLeft="8dp"
                android:paddingTop="4dp"
                android:paddingRight="8dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="30dp"
                android:text="@string/luckycat_ok"/>
        </LinearLayout>
        <androidx.appcompat.widget.SwitchCompat
            android:layout_gravity="center_horizontal"
            android:id="@+id/boe_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/luckycat_boe_switch"/>
        <EditText
            android:textSize="14sp"
            android:id="@+id/et_add_params"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请输入要拼接在schema上的参数，比如：b=c"/>
        <Button
            android:id="@+id/btn_disaster_test"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="图片URL容灾"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/polaris_black"
            android:id="@+id/tv_origin_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="https://lf3-sourcecdn-tos.pstatp.com"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/polaris_black"
            android:id="@+id/tv_target_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="图片域名替换后的URL:替换规则:\10容灾域名有10个时，则将did末尾两位数分为10份"/>
        <Button
            android:id="@+id/btn_proxy_schema_test"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="schema映射"/>
        <Button
            android:id="@+id/btn_proxy_schema_open"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="打开schema"/>
        <EditText
            android:textSize="14sp"
            android:textColor="@color/polaris_black"
            android:id="@+id/et_proxy_schema"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/proxy_schema_text"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/polaris_black"
            android:id="@+id/tv_proxy_schema_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="proxy schema 解析后的内容"/>
        <EditText
            android:textSize="14sp"
            android:textColor="@color/polaris_black"
            android:id="@+id/et_lynx_popup_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="请输入lynx popup数据"/>
        <Button
            android:id="@+id/tv_lynx_popup_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="开始测试lynx popup"/>
    </LinearLayout>
</ScrollView>
