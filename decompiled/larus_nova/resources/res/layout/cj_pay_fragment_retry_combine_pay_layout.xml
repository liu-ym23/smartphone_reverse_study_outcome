<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cj_pay_bg_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_470"
        android:layout_alignParentBottom="true">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="44sp">
                    <TextView
                        android:textSize="24sp"
                        android:textColor="#161823"
                        android:gravity="center"
                        android:id="@+id/cj_pay_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="26sp"
                        android:layout_marginBottom="-2dp"
                        android:text="@string/cj_pay_currency_unit"/>
                    <TextView
                        android:textSize="38sp"
                        android:textColor="#161823"
                        android:gravity="center"
                        android:id="@+id/cj_pay_order_value_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="4dp"
                        android:letterSpacing="-0.05"/>
                </LinearLayout>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/cj_pay_color_orange_FF6E26"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/combine_select_page_voucher_msg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="18sp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="16dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#99161823"
                        android:id="@+id/combine_header_line_1_left_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/cj_pay_small_change_pay"
                        android:layout_alignParentLeft="true"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#161823"
                        android:id="@+id/cj_pay_change_pay_value_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentRight="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="18sp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="16dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#99161823"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/cj_pay_bank_card_pay"
                        android:layout_alignParentLeft="true"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#161823"
                        android:id="@+id/cj_pay_bank_card_pay_value_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentRight="true"/>
                </RelativeLayout>
                <View
                    android:id="@+id/combine_pay_divider"
                    android:background="#1f161823"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="20dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#161823"
                    android:gravity="center_vertical"
                    android:id="@+id/bank_card_tips_txt"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cj_pay_select_bank_card"/>
            </LinearLayout>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/cj_pay_back_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/cj_pay_font_size_16"
                android:layout_marginTop="@dimen/cj_pay_font_size_16"
                android:src="@drawable/cj_pay_icon_titlebar_left_arrow"
                android:scaleType="centerCrop"/>
        </RelativeLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.android.ttcjpaysdk.base.ui.widget.ExtendRecyclerView
                android:id="@+id/cj_pay_payment_method_recycler_view"
                android:background="@color/cj_pay_color_trans"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"/>
            <View
                android:id="@+id/cj_pay_empty_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </LinearLayout>
</RelativeLayout>
