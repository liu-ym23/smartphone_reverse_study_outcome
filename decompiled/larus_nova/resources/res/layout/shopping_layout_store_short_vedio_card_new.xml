<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ui.base.widget.round.RoundLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/shop_short_video_card"
    android:padding="12dp"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bg_color="@color/white"
    app:bg_cornerRadius="8dp">
    <TextView
        android:textSize="15dp"
        android:textColor="@color/shopping_std_text_black_2"
        android:id="@+id/ec_short_video_card_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>
    <com.bytedance.android.ui.base.widget.round.RoundRelativeLayout
        android:id="@+id/ec_short_video_card_video_controller"
        android:layout_width="match_parent"
        android:layout_height="468dp"
        app:bg_cornerRadius="8dp"
        app:placeholderImage="@drawable/ecommerce_slogan_product_bg">
        <RelativeLayout
            android:id="@+id/ec_short_video_card_video_wrapper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:id="@+id/ec_short_video_card_video_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/ec_short_video_card_play_btn"
            android:background="@drawable/ecommerce_store_ic_video_play"
            android:layout_width="32dp"
            android:layout_height="27dp"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/ec_short_video_card_mute_btn"
            android:background="@drawable/shopping_ic_store_v3_live_sound_shut"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginRight="14dp"
            android:layout_marginBottom="20dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"/>
    </com.bytedance.android.ui.base.widget.round.RoundRelativeLayout>
    <com.bytedance.android.ui.base.widget.round.RoundRelativeLayout
        android:id="@+id/ec_short_video_card_product_area"
        android:layout_width="match_parent"
        android:layout_height="53dp"
        android:layout_marginTop="12dp"
        app:bg_color="#f5f6f9"
        app:bg_cornerRadius="6dp">
        <TextView
            android:textSize="12sp"
            android:textColor="#73161823"
            android:id="@+id/ec_short_video_card_product_recommend_text"
            android:layout_width="25dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:text="@string/ec_store_recommend_product"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:id="@+id/ec_short_video_card_product_cover"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="49dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            app:cornerRadius="6dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ec_shop_100161823"
            android:ellipsize="end"
            android:id="@+id/ec_short_video_card_product_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="103dp"
            android:layout_marginTop="9dp"
            android:layout_marginRight="8dp"
            android:maxLines="1"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"/>
        <com.bytedance.android.ec.core.widget.price.PriceView
            android:textSize="12sp"
            android:id="@+id/ec_short_video_card_product_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="103dp"
            android:layout_marginBottom="10dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"
            app:pv_priceInFen="109800"
            app:pv_priceTextColor="#ff3b52"
            app:pv_yuanSymbolRatioOfPriceTextSize="0.75"/>
    </com.bytedance.android.ui.base.widget.round.RoundRelativeLayout>
    <com.bytedance.android.shopping.store.moments.widget.ECShortVideoExpandableTextView
        android:textSize="14sp"
        android:textColor="@color/shopping_std_text_black_1"
        android:ellipsize="end"
        android:id="@+id/ec_short_video_card_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:ec_closeMaxLineCount="3"
        app:ec_ellipsisText="展开"
        app:ec_expandMaxLineCount="7"
        app:ec_expandPlaceHolder="收起"
        app:ec_placeHolderColor="@color/ec_gray_link_color"/>
</com.bytedance.android.ui.base.widget.round.RoundLinearLayout>
