<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/flow_ud_bg_base_3"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <FrameLayout
        android:id="@+id/organization_icon_container"
        android:background="@drawable/bg_doubao_organization_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            app:srcCompat="@drawable/ic_doubao_organization"/>
    </FrameLayout>
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/doubao_picker_title_text"
        android:ellipsize="end"
        android:id="@+id/organization_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/organization_chevron"
        app:layout_constraintStart_toEndOf="@+id/organization_icon_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/organization_chevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:tint="@color/icon_n3"
        android:contentDescription="@null"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ud_icon_right_outlined"/>
</androidx.constraintlayout.widget.ConstraintLayout>
