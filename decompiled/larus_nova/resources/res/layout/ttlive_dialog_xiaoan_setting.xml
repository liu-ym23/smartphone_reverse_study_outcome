<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:paddingBottom="30dp"
    android:layout_width="match_parent"
    android:layout_height="584dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="188dp"
        android:layout_marginBottom="24dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/xiaoan_setting_head"
            android:layout_width="match_parent"
            android:layout_height="188dp"/>
        <ImageView
            android:id="@+id/xiaoan_setting_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:src="@drawable/ttlive_close_xiaoan"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/ttlive_douyin_light_TextPrimary"
        android:gravity="center_horizontal"
        android:id="@+id/xiaoan_setting_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_douyin_light_TextTertiary"
        android:gravity="center_horizontal"
        android:id="@+id/xiaoan_setting_top_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <RadioGroup
        android:orientation="vertical"
        android:id="@+id/radio_group"
        android:background="#f8f8f8"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp">
        <RadioButton
            android:textColor="@color/ttlive_douyin_light_TextTertiary"
            android:id="@+id/radio_1"
            android:paddingLeft="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/ttlive_live_pre_enable_comment_follow_2"
            style="@style/ttlive_RedEnvelopeCheckboxStyle"/>
        <RadioButton
            android:textColor="@color/ttlive_douyin_light_TextTertiary"
            android:id="@+id/radio_2"
            android:paddingLeft="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/ttlive_live_pre_enable_comment_follow_3"
            style="@style/ttlive_RedEnvelopeCheckboxStyle"/>
        <RadioButton
            android:textColor="@color/ttlive_douyin_light_TextTertiary"
            android:id="@+id/radio_3"
            android:paddingLeft="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_live_pre_disable_comment"
            style="@style/ttlive_RedEnvelopeCheckboxStyle"/>
    </RadioGroup>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp">
        <Button
            android:textSize="13dp"
            android:textColor="@color/ttlive_black"
            android:id="@+id/btn_cancel"
            android:background="#f8f8f8"
            android:layout_width="167dp"
            android:layout_height="44dp"
            android:layout_marginRight="16dp"
            android:text="@string/ttlive_cancel"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <Button
            android:textSize="13dp"
            android:textColor="#ffffff"
            android:id="@+id/btn_set"
            android:background="@color/ttlive_douyin_primary"
            android:layout_width="167dp"
            android:layout_height="44dp"
            android:layout_marginRight="16dp"
            android:text="@string/ttlive_setting_start"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </LinearLayout>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/xiaoan_setting_bottom_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
</LinearLayout>
