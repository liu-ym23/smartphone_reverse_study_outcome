<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.ui.ClipImageView
        android:layout_gravity="center"
        android:id="@+id/ttlive_guest_bg"
        android:background="@drawable/ttlive_video_talkroom_window_empty_bg"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="#57000000"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ttlive_guest_container"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ttlive_guest_avatar"
            android:background="@drawable/ttlive_build_linking_avatar"
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundAsCircle="true"/>
        <com.bytedance.android.livesdk.common.AnchorPauseTipsView
            android:id="@+id/ttlive_leave_view"
            android:visibility="gone"
            android:layout_width="188dp"
            android:layout_height="166dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ttlive_volume_Anim"
            android:visibility="visible"
            android:layout_width="160dp"
            android:layout_height="160dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ttlive_avatar_right_top_widget"
            android:visibility="gone"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:translationX="63dp"
            android:translationY="-63dp"
            app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_avatar"
            app:layout_constraintTop_toTopOf="@+id/ttlive_guest_avatar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.live.ui.ClipFrameLayout
        android:id="@+id/ttlive_xplay_h5_container"
        android:background="#01000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/first_user_info_bar"
        android:background="@drawable/ttlive_bg_enlarge_user_info_bar"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="128dp"
        android:layout_marginStart="12dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ttlive_guest_identification"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ttlive_icon_video_silence"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#e6ffffff"
            android:ellipsize="end"
            android:id="@+id/ttlive_guest_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="4dp"
            android:maxWidth="68dp"
            android:singleLine="true"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="4dp"/>
        <com.bytedance.android.live.ui.LinkGuestSendGiftView
            android:id="@+id/send_gift_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginLeft="4dp"
            android:layout_marginStart="4dp"/>
        <FrameLayout
            android:id="@+id/ttlive_guest_fans_ticket_count_container"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginStart="2dp">
            <com.bytedance.android.live.liveinteract.videotalk.quickinteract.interactView.LinkMicQuickInteractView
                android:id="@+id/ttlive_guest_fans_ticket_count"
                android:clipChildren="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.bytedance.android.live.liveinteract.videotalk.quickinteract.interactView.ThemedCompetitionQuickInteractView
                android:id="@+id/ttlive_themed_competition_score"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/self_discipline_container"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="2dp"
            android:layout_marginStart="2dp">
            <com.bytedance.android.live.liveinteract.videotalk.selfdiscipline.ui.SelfDisciplineTimerView
                android:layout_gravity="center_vertical"
                android:id="@+id/ttlive_self_discipline_timer_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/ttlive_self_discipline_like_effect"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="7dp"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/extra_container"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginLeft="2dp"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
    <FrameLayout
        android:gravity="center_vertical"
        android:id="@+id/play_mode_user_info_bar"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="128dp"
        android:layout_marginStart="12dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
