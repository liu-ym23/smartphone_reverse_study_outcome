<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="128dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/card_explaining_area"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp">
        <FrameLayout
            android:id="@+id/poi_live_goods_shelves_image_layout"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/poi_live_goods_shelves_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:roundedCornerRadius="8dp"/>
            <com.bytedance.ies.dmt.ui.widget.DmtTextView
                android:textSize="12dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/poi_live_goods_shelves_status"
                android:background="@drawable/bg_poi_live_goods_shelves_image_status"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:fontFamily="PingFangSC"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/poi_live_goods_shelves_serial_number_layout"
                android:layout_width="wrap_content"
                android:layout_height="20dp">
                <com.bytedance.ies.dmt.ui.widget.DmtTextView
                    android:textSize="14dp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:id="@+id/poi_live_goods_shelves_serial_number"
                    android:background="@drawable/bg_live_local_life_order"
                    android:layout_width="28dp"
                    android:layout_height="match_parent"
                    android:maxLines="1"
                    android:fontFamily="PingFangSC"/>
                <com.bytedance.lighten.loader.SmartImageView
                    android:id="@+id/poi_live_goods_shelves_image_tag"
                    android:visibility="gone"
                    android:layout_width="62dp"
                    android:layout_height="match_parent"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:id="@+id/explaining_layout"
                android:background="@drawable/bg_poi_live_goods_shelves_explaining"
                android:layout_width="match_parent"
                android:layout_height="22dp">
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/explaining_lottie"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="26dp"/>
                <com.bytedance.ies.dmt.ui.widget.DmtTextView
                    android:textSize="12dp"
                    android:textColor="#ffffff"
                    android:id="@+id/explaining_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/live_local_life_shelf_explaining_text"
                    android:maxLines="1"
                    android:fontFamily="PingFangSC"
                    android:layout_marginStart="1dp"/>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/goods_shelf_card_content"
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/card_title_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/card_title_execution_plan_image"
                    android:layout_width="wrap_content"
                    android:layout_height="15dp"
                    android:layout_marginEnd="4dp"
                    app:roundedCornerRadius="2dp"/>
                <com.bytedance.ies.dmt.ui.widget.DmtTextView
                    android:textSize="15dp"
                    android:textStyle="bold"
                    android:textColor="#161823"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/card_title_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:fontFamily="PingFangSC"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/card_label_layout"
                android:layout_width="match_parent"
                android:layout_height="51dp"
                android:layout_marginTop="4dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/store_info_new_non_click_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="17dp"
                    android:layout_marginBottom="5dp"
                    android:layout_marginEnd="11dp">
                    <com.bytedance.ies.dmt.ui.widget.DmtTextView
                        android:textSize="12dp"
                        android:textColor="#bf161823"
                        android:id="@+id/user_distance"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:maxLines="1"
                        android:fontFamily="PingFangSC"/>
                    <View
                        android:id="@+id/split_line"
                        android:background="#33161823"
                        android:layout_width="0.5dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4.5dp"/>
                    <com.bytedance.ies.dmt.ui.widget.DmtTextView
                        android:textSize="12dp"
                        android:textColor="#bf161823"
                        android:ellipsize="end"
                        android:id="@+id/poi_name"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:layout_weight="1"
                        android:fontFamily="PingFangSC"/>
                    <com.bytedance.ies.dmt.ui.widget.DmtTextView
                        android:textSize="12dp"
                        android:textColor="#bf161823"
                        android:ellipsize="end"
                        android:id="@+id/poi_store_number"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:fontFamily="PingFangSC"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/service_information_layout"
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:layout_marginBottom="4dp">
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/ticket_info_1_layout"
                        android:background="@drawable/poi_item_live_bg_discount_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="4dp">
                        <com.bytedance.ies.dmt.ui.widget.DmtTextView
                            android:textSize="10dp"
                            android:textColor="#fe2c55"
                            android:gravity="center_vertical"
                            android:id="@+id/coupon_type_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:layout_marginStart="4dp"/>
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:src="@drawable/live_local_life_shelf_ticket_line"
                            android:layout_marginStart="1dp"/>
                        <com.bytedance.ies.dmt.ui.widget.DmtTextView
                            android:textSize="10dp"
                            android:textColor="#fe2c55"
                            android:gravity="center_vertical"
                            android:id="@+id/ticket_info_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:layout_marginStart="1dp"
                            android:layout_marginEnd="4dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/ticket_info_2_layout"
                        android:background="@drawable/poi_item_live_bg_discount_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="4dp">
                        <com.bytedance.ies.dmt.ui.widget.DmtTextView
                            android:textSize="10dp"
                            android:textColor="#fe2c55"
                            android:gravity="center_vertical"
                            android:id="@+id/coupon_type_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"/>
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:src="@drawable/live_local_life_shelf_ticket_line"
                            android:layout_marginStart="1dp"/>
                        <com.bytedance.ies.dmt.ui.widget.DmtTextView
                            android:textSize="10dp"
                            android:textColor="#fe2c55"
                            android:gravity="center_vertical"
                            android:id="@+id/ticket_info_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="1dp"
                            android:layout_marginEnd="4dp"/>
                    </LinearLayout>
                    <com.bytedance.ies.dmt.ui.widget.DmtTextView
                        android:textSize="10dp"
                        android:textColor="#99161823"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/service_info1"
                        android:background="@drawable/poi_item_live_bg_service_tag"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="3dp"/>
                    <com.bytedance.ies.dmt.ui.widget.DmtTextView
                        android:textSize="10dp"
                        android:textColor="#99161823"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/service_info2"
                        android:background="@drawable/poi_item_live_bg_service_tag"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="3dp"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <com.bytedance.ies.dmt.ui.widget.DmtTextView
                        android:textSize="11dp"
                        android:textColor="#99161823"
                        android:layout_gravity="end"
                        android:id="@+id/tickets_sold_label"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:maxLines="1"
                        android:fontFamily="PingFangSC"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/flash_info_layout"
                    android:layout_width="match_parent"
                    android:layout_height="16dp">
                    <com.bytedance.locallife.live.goodsshelves.view.FlashSaleView
                        android:id="@+id/flash_sale_view"
                        android:layout_width="150dp"
                        android:layout_height="16dp"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>
                    <com.bytedance.ies.dmt.ui.widget.DmtTextView
                        android:textSize="11dp"
                        android:textColor="#99161823"
                        android:layout_gravity="end"
                        android:id="@+id/flash_sold_label"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:maxLines="1"
                        android:fontFamily="PingFangSC"/>
                </LinearLayout>
                <com.bytedance.ies.dmt.ui.widget.DmtTextView
                    android:textSize="11dp"
                    android:textColor="#99161823"
                    android:gravity="end|bottom"
                    android:id="@+id/sold_label_non_flash_and_tickets"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="2dp"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:fontFamily="PingFangSC"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="bottom"
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:id="@+id/card_price_and_buy_layout"
                android:layout_width="match_parent"
                android:layout_height="28dp">
                <LinearLayout
                    android:gravity="bottom"
                    android:layout_gravity="bottom"
                    android:orientation="horizontal"
                    android:id="@+id/card_price_layout"
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_weight="1">
                    <com.bytedance.ies.dmt.ui.widget.DmtTextView
                        android:textSize="11dp"
                        android:textStyle="bold"
                        android:textColor="#fe2c55"
                        android:gravity="bottom"
                        android:id="@+id/price_scene_text"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:fontFamily="PingFangSC"
                        android:layout_marginEnd="2dp"/>
                    <TextView
                        android:textSize="13dp"
                        android:textStyle="bold"
                        android:textColor="#fe2c55"
                        android:id="@+id/price_real"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/live_local_life_shelf_card_price_label"
                        android:maxLines="1"
                        android:fontFamily="PingFangSC"/>
                    <com.bytedance.ies.dmt.ui.widget.DmtTextView
                        android:textSize="12dp"
                        android:textColor="#fe2c55"
                        android:layout_gravity="bottom"
                        android:id="@+id/tv_frequency"
                        android:paddingTop="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:maxLines="1"
                        android:fontFamily="PingFangSC"/>
                    <com.bytedance.ies.dmt.ui.widget.DmtTextView
                        android:textSize="12dp"
                        android:textColor="#59161823"
                        android:layout_gravity="bottom"
                        android:id="@+id/origin_price"
                        android:paddingTop="5.5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:maxLines="1"
                        android:fontFamily="PingFangSC"
                        android:layout_marginStart="2dp"/>
                    <com.bytedance.ies.dmt.ui.widget.DmtTextView
                        android:textSize="10dp"
                        android:textColor="#fe2c55"
                        android:orientation="horizontal"
                        android:id="@+id/discount_tag"
                        android:background="@drawable/poi_item_live_bg_discount_tag"
                        android:paddingLeft="5dp"
                        android:paddingTop="2dp"
                        android:paddingRight="5dp"
                        android:paddingBottom="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:layout_marginStart="3dp"/>
                </LinearLayout>
                <com.bytedance.locallife.live.goodsshelves.view.ButtonBuy
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/btn_buy"
                    android:layout_width="80dp"
                    android:layout_height="28dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
