<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/input_container"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.livesdk.interactivity.comment.newinput.view.Audio2TextBtnView
        android:id="@+id/button_asr"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginBottom="106dp"
        app:inner_radius="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:outter_radius="79dp"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#99161823"
        android:id="@+id/text_asr_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ttlive_audio_comment_record_press_speak_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_asr"/>
</androidx.constraintlayout.widget.ConstraintLayout>
