        android:layout_gravity="end"
        android:id="@+id/search_right_bottom_marketing_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <include layout="@layout/saas_search_ec_common_layout_result_feedback"/>
    <include layout="@layout/saas_search_view_commodity_cart"/>
    <include layout="@layout/saas_search_ec_common_layout_result_back_top"/>
</LinearLayout>
