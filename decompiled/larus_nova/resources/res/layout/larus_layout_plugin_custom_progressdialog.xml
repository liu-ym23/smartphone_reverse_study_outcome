<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/root"
    android:background="@drawable/larus_bg_plugin_progressdialog"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingBottom="15dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <RelativeLayout
        android:id="@+id/customProgressView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:layout_centerHorizontal="true">
        <com.larus.mirabridge.impl.ui.PluginCircularProgressView
            android:id="@+id/iv_loading"
            android:layout_width="36sp"
            android:layout_height="36sp"
            android:layout_centerInParent="true"
            app:larus_cpv_animAutostart="true"
            app:larus_cpv_color="@color/larus_plugin_white"
            app:larus_cpv_indeterminate="true"
            app:larus_cpv_maxProgress="100"
            app:larus_cpv_thickness="2dp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/larus_plugin_white"
            android:gravity="center"
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/larus_plugin_white"
        android:gravity="center"
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/customProgressView"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
