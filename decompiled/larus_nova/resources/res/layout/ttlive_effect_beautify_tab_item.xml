<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bt_beauty"
    android:background="@color/transparent"
    android:layout_width="68dp"
    android:layout_height="36dp">
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_effect_beautify_tab_name_selected_color"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_effect_live_beauty_makeups_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/indicator"
        android:background="@drawable/ttlive_effect_ic_beauty_filter_indicator"
        android:layout_width="28dp"
        android:layout_height="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/dot"
        android:background="@drawable/ttlive_effect_ic_filter_red_point"
        android:visibility="invisible"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginLeft="1dp"
        android:layout_marginStart="1dp"
        app:layout_constraintStart_toEndOf="@+id/tv_name"
        app:layout_constraintTop_toTopOf="@+id/tv_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
