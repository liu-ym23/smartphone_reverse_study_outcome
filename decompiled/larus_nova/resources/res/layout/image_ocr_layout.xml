<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/image_ocr_layout"
    android:background="@color/static_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.lark.imageocr.view.OCRBottomView
        android:id="@+id/image_ocr_bottom_view"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"/>
    <com.ss.android.lark.imagewidget.largeimage.LargeImageView
        android:id="@+id/image_ocr_large_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/image_ocr_bottom_view"/>
    <com.ss.android.lark.imageocr.view.OCRScanView
        android:id="@+id/image_ocr_scan_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/image_ocr_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="48dp"
        android:layout_marginStart="25dp"
        app:srcCompat="@drawable/ud_icon_close_outlined"
        app:tint="@color/ocr_tint_color"/>
    <com.ss.android.lark.imageocr.view.OCRTipView
        android:id="@+id/image_ocr_tip_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.ss.android.lark.imageocr.view.OCRPickTextLayout
        android:id="@+id/image_ocr_pick_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
