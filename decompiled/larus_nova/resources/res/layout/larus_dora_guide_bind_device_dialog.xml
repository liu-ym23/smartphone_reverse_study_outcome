<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.common_ui.widget.roundlayout.RoundConstraintLayout
        android:layout_gravity="bottom"
        android:paddingBottom="?attr/larus_dp_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:rv_backgroundColor="@color/larus_base_2"
        app:rv_cornerRadius_TL="?attr/larus_dp_20"
        app:rv_cornerRadius_TR="?attr/larus_dp_20">
        <ImageView
            android:id="@+id/dora_guide_dialog_close_btn"
            android:layout_width="?attr/larus_dp_28"
            android:layout_height="?attr/larus_dp_28"
            android:layout_marginTop="?attr/larus_dp_16"
            android:src="@drawable/larus_dora_onboarding_close_btn"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dora_guide_dialog_close_btn">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/dora_guide_dialog_avatar"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_234"
                android:layout_marginLeft="?attr/larus_dp_28"
                android:layout_marginRight="?attr/larus_dp_28"/>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_dp_22"
                android:textColor="@color/neutral_100"
                android:id="@+id/dora_guide_dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_20"/>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_dp_18"
                android:textColor="@color/neutral_70"
                android:gravity="center_horizontal"
                android:id="@+id/dora_guide_dialog_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="?attr/larus_dp_24"
                android:layout_marginTop="?attr/larus_dp_8"
                android:layout_marginRight="?attr/larus_dp_24"
                android:lineSpacingMultiplier="1.2"/>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_dp_17"
                android:textColor="@color/larus_static_white"
                android:gravity="center"
                android:id="@+id/dora_guide_dialog_confirm_btn"
                android:background="@drawable/larus_item_dora_connect_status"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_56"
                android:layout_marginLeft="?attr/larus_dp_28"
                android:layout_marginTop="?attr/larus_dp_20"
                android:layout_marginRight="?attr/larus_dp_28"/>
        </LinearLayout>
    </com.larus.common_ui.widget.roundlayout.RoundConstraintLayout>
</FrameLayout>
