<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/ttlive_invite_link_guide_effect"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/ttlive_empty_content"
        android:background="@drawable/ttlive_video_talkroom_window_empty_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ttlive_empty_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/ttlive_empty_avatar_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            fresco:layout_constraintBottom_toTopOf="@+id/ttlive_empty_tips"
            fresco:layout_constraintEnd_toEndOf="parent"
            fresco:layout_constraintStart_toStartOf="parent"
            fresco:layout_constraintTop_toTopOf="parent"
            fresco:layout_constraintVertical_chainStyle="packed">
            <TextView
                android:textSize="22dp"
                android:textColor="#87ffffff"
                android:id="@+id/ttlive_empty_position"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
            <ImageView
                android:id="@+id/ttlive_empty_avatar"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ttlive_icon_apply_plus_new"/>
        </FrameLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="#87ffffff"
            android:id="@+id/ttlive_empty_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_video_talkroom_window_want_link"
            android:includeFontPadding="false"
            fresco:layout_constraintBottom_toBottomOf="parent"
            fresco:layout_constraintEnd_toEndOf="parent"
            fresco:layout_constraintStart_toStartOf="parent"
            fresco:layout_constraintTop_toBottomOf="@+id/ttlive_empty_avatar_container"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ViewStub
        android:layout_gravity="center"
        android:id="@+id/ttlive_linkmic_alert_stub"
        android:layout="@layout/ttlive_room_empty_stub_link_alert_view"
        android:inflatedId="@+id/ttlive_linkmic_alert_stub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/avatar"
        android:visibility="invisible"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"/>
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/shader"
        android:background="@drawable/ttlive_bg_friend_online_guide_button_shader"
        android:visibility="invisible"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:layout_gravity="center_horizontal"
        android:id="@+id/tick"
        android:visibility="invisible"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"/>
    <View
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/guide_button_bg"
        android:background="@drawable/ttlive_bg_friend_online_guide_button_chat_room"
        android:visibility="invisible"
        android:layout_width="58dp"
        android:layout_height="16dp"
        android:layout_marginBottom="10dp"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/online_text"
        android:visibility="invisible"
        android:layout_width="58dp"
        android:layout_height="16dp"
        android:layout_marginBottom="10dp"
        android:text="@string/ttlive_friend_online_text"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#161823"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/invite_text"
        android:visibility="invisible"
        android:layout_width="48dp"
        android:layout_height="16dp"
        android:layout_marginBottom="10dp"
        android:text="@string/ttlive_friend_online_invite"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/has_invited_text"
        android:visibility="invisible"
        android:layout_width="56dp"
        android:layout_height="16dp"
        android:layout_marginBottom="10dp"
        android:text="@string/ttlive_friend_online_has_invited"/>
    <com.bytedance.android.live.liveinteract.view.PositionNameTv
        android:textSize="10dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="end"
        android:id="@+id/ttlive_position_name"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginTop="3dp"
        android:maxLength="4"
        android:layout_marginEnd="3dp"/>
</FrameLayout>
