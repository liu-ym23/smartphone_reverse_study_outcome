<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp">
    <ImageView
        android:id="@+id/quick_bindcard_item_icon"
        android:layout_width="@dimen/cj_pay_padding_20"
        android:layout_height="@dimen/cj_pay_padding_20"
        android:layout_marginLeft="16dp"
        android:src="@drawable/cj_pay_quick_bind_item_icon_default"
        android:scaleType="fitXY"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="?attr/cj_pay_page_size_15"
        android:id="@+id/quick_bindcard_item_bankname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_toRightOf="@+id/quick_bindcard_item_icon"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="?attr/cj_pay_page_size_12"
        android:gravity="center_vertical"
        android:id="@+id/quick_bindcard_cardtype_support"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_toLeftOf="@+id/quick_bindcard_item_right_arrow"/>
    <ImageView
        android:id="@+id/quick_bindcard_item_right_arrow"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="16dp"
        android:src="@drawable/cj_pay_bindcard_right_arrow"
        android:scaleType="center"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <ProgressBar
        android:id="@+id/quick_bindcard_item_loading"
        android:background="@color/cj_pay_color_trans"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="16dp"
        android:indeterminateOnly="true"
        android:indeterminateDrawable="@drawable/cj_pay_arrow_loading_drawable"
        android:indeterminateDuration="500"
        android:indeterminateBehavior="repeat"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="50dp"
        android:layout_marginRight="16dp"
        android:layout_alignParentBottom="true"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:layout_toLeftOf="@+id/quick_bindcard_cardtype_support"
        android:layout_toRightOf="@+id/quick_bindcard_item_bankname"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="?attr/cj_pay_page_size_10"
            android:textColor="@color/cj_pay_color_red_11"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/voucher_first"
            android:background="@drawable/cj_pay_quickbind_voucher_tag_background"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="2dp"
            android:minHeight="16dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_toRightOf="@+id/quick_bindcard_item_bankname"/>
        <TextView
            android:textSize="?attr/cj_pay_page_size_10"
            android:textColor="@color/cj_pay_color_red_11"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/voucher_second"
            android:background="@drawable/cj_pay_quickbind_voucher_tag_background"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="2dp"
            android:minHeight="16dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_toRightOf="@+id/voucher_first"/>
    </RelativeLayout>
</RelativeLayout>
