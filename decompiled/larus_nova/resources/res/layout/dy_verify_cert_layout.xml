<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/dy_verify_cert_root_view"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cj_pay_height_470">
    <include
        android:id="@+id/dy_verify_titlebar_root_view"
        layout="@layout/cj_pay_view_titlebar_noise_reduction_layout"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/dy_verify_cert_install_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/dy_verify_titlebar_root_view">
        <ImageView
            android:id="@+id/dy_verify_cert_install_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="88dp"
            android:src="@drawable/dy_verify_icon_cert"
            android:scaleType="centerCrop"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/cj_pay_color_black_161823"
            android:layout_gravity="center_horizontal"
            android:id="@+id/dy_verify_cert_install_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cj_pay_padding_20"
            android:text="@string/dy_verify_cert_for_amount_up_limit"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_below="@+id/dy_verify_cert_install_icon"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
            android:layout_gravity="center_horizontal"
            android:id="@+id/dy_verify_cert_install_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cj_pay_padding_8"
            android:text="@string/dy_vreify_cert_up_limit_by_cert_install"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_below="@+id/dy_verify_cert_install_title"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <FrameLayout
            android:id="@+id/dy_verify_cert_install_btn_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cj_pay_padding_16"
            android:layout_marginTop="@dimen/cj_pay_padding_16"
            android:layout_marginRight="@dimen/cj_pay_padding_16">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/cj_pay_color_white"
                android:gravity="center"
                android:id="@+id/dy_verify_cert_install_btn"
                android:background="@drawable/dy_verify_red_button_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cj_pay_custom_button_height_44"
                android:text="@string/dy_verify_cert_install_btn"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/dy_verify_cert_install_loading_layout"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ProgressBar
                    android:layout_gravity="center_vertical"
                    android:id="@+id/dy_verify_cert_install_loading"
                    android:background="@color/cj_pay_color_trans"
                    android:layout_width="@dimen/cj_pay_padding_20"
                    android:layout_height="@dimen/cj_pay_padding_20"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_white"
                    android:indeterminateDuration="500"
                    android:indeterminateBehavior="repeat"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/cj_pay_color_white"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/dy_verify_cert_install_loading_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/cj_pay_padding_6"
                    android:text="@string/dy_verify_cert_installing_btn"/>
            </LinearLayout>
        </FrameLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_34"
            android:layout_gravity="center_horizontal"
            android:id="@+id/dy_verify_cert_uninstall_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cj_pay_padding_12"
            android:layout_marginBottom="@dimen/cj_pay_padding_16"
            android:text="@string/dy_verify_cert_give_up_btn"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_below="@+id/dy_verify_cert_install_layout"/>
    </LinearLayout>
</RelativeLayout>
