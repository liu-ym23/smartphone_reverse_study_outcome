<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/fieldPropertyExtendRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/fieldPropertyExtendOrigin"
        android:background="@drawable/facade_round_around_xl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_2"
        android:layout_marginBottom="@dimen/space_kit_len_14"
        android:minHeight="@dimen/space_kit_len_52"
        android:paddingStart="@dimen/space_kit_len_16"
        android:paddingEnd="@dimen/space_kit_len_16"
        android:backgroundTint="@color/bg_float">
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/bitable_selector_item_text_color"
            android:id="@+id/fieldPropertyExtendOriginTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_kit_len_12"
            android:layout_marginBottom="@dimen/space_kit_len_12"
            android:maxWidth="280dp"
            android:text="@string/Bitable_PeopleField_DataSorceField_Title"
            android:maxLines="1"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_kit_len_8"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/fieldPropertyExtendOriginIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:tint="@color/icon_n3"
            android:layout_marginEnd="4dp"
            app:srcCompat="@drawable/ud_icon_currency_yuan_outlined"/>
        <TextView
            android:textSize="@dimen/space_kit_font_14"
            android:textColor="@color/text_placeholder"
            android:ellipsize="end"
            android:id="@+id/fieldPropertyExtendOriginName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="210dp"
            android:maxLines="1"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_marginEnd="@dimen/space_kit_len_4"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/fieldPropertyExtendRefresh"
        android:background="@drawable/facade_round_around_xl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_kit_len_14"
        android:minHeight="@dimen/space_kit_len_52"
        android:paddingStart="@dimen/space_kit_len_16"
        android:paddingEnd="@dimen/space_kit_len_16"
        android:backgroundTint="@color/bg_float">
        <com.larksuite.component.universe_design.button.UDButton
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/ud_button_blue_text"
            android:id="@+id/fieldPropertyExtendRefreshTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_kit_len_12"
            android:layout_marginBottom="@dimen/space_kit_len_12"
            android:text="@string/Bitable_PeopleField_RefreshData_Button"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_kit_len_16"/>
    </LinearLayout>
</LinearLayout>
