<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dora_device_info_scroll_view"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:paddingLeft="?attr/larus_dp_12"
        android:paddingRight="?attr/larus_dp_12"
        android:paddingBottom="?attr/larus_dp_10"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dora_device_header_connect_group"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/dora_device_img_left"
                android:layout_width="?attr/larus_dp_120"
                android:layout_height="?attr/larus_dp_216"
                app:actualImageScaleType="center"
                app:layout_constraintEnd_toStartOf="@+id/dora_device_img_box"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/dora_device_img_box"
                android:layout_width="?attr/larus_dp_120"
                android:layout_height="?attr/larus_dp_216"
                app:actualImageScaleType="center"
                app:layout_constraintEnd_toStartOf="@+id/dora_device_img_right"
                app:layout_constraintStart_toEndOf="@+id/dora_device_img_left"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/dora_device_img_right"
                android:layout_width="?attr/larus_dp_120"
                android:layout_height="?attr/larus_dp_216"
                app:actualImageScaleType="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/dora_device_img_box"
                app:layout_constraintTop_toTopOf="parent"/>
            <include
                android:id="@+id/dora_device_battery_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_4"
                app:layout_constraintEnd_toEndOf="@+id/dora_device_img_left"
                app:layout_constraintStart_toStartOf="@+id/dora_device_img_left"
                app:layout_constraintTop_toBottomOf="@+id/dora_device_img_left"
                layout="@layout/larus_dora_device_battery_layout"/>
            <include
                android:id="@+id/dora_device_battery_box"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_4"
                app:layout_constraintEnd_toEndOf="@+id/dora_device_img_box"
                app:layout_constraintStart_toStartOf="@+id/dora_device_img_box"
                app:layout_constraintTop_toBottomOf="@+id/dora_device_img_box"
                layout="@layout/larus_dora_device_battery_layout"/>
            <include
                android:id="@+id/dora_device_battery_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_4"
                app:layout_constraintEnd_toEndOf="@+id/dora_device_img_right"
                app:layout_constraintStart_toStartOf="@+id/dora_device_img_right"
                app:layout_constraintTop_toBottomOf="@+id/dora_device_img_right"
                layout="@layout/larus_dora_device_battery_layout"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dora_device_header_disconnect_group"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/dora_device_img_disconnect_left"
                android:layout_width="?attr/larus_dp_120"
                android:layout_height="?attr/larus_dp_216"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/dora_device_img_disconnect_right"
                android:layout_width="?attr/larus_dp_120"
                android:layout_height="?attr/larus_dp_216"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.7"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="dora_device_header_connect_group,dora_device_header_disconnect_group"/>
        <FrameLayout
            android:id="@+id/dora_device_header_group_disconnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/neutral_50"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/dora_device_disconnect_connect_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_device_disconnected_state_cn"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
