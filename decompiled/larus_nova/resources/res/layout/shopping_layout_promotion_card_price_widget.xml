<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lpall_price_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.bytedance.android.ec.core.widget.price.PriceView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/shopping_color_FF3344"
        android:id="@+id/pv_first_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_orderInHorizontal="0"
        app:layout_orderInVertical="1"
        app:pv_autoResize="true"
        app:pv_prefixMarginRight="2dp"
        app:pv_prefixTextSizeRatio="0.588"
        app:pv_priceBold="true"
        app:pv_priceDecimalTextSizeRatio="0.647"
        app:pv_priceTextColor="@color/shopping_color_FF3344"
        app:pv_suffixTextSizeRatio="0.588"
        app:pv_yuanSymbolMarginRight="1dp"
        app:pv_yuanSymbolRatioOfPriceTextSize="0.647"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/shopping_std_text_black_3"
        android:layout_gravity="bottom"
        android:id="@+id/tv_describe"
        android:paddingBottom="1dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:paddingStart="3dp"
        app:layout_orderInHorizontal="1"
        app:layout_orderInVertical="2"/>
    <com.bytedance.android.ec.core.widget.price.PriceView
        android:textSize="10sp"
        android:layout_gravity="bottom"
        android:id="@+id/pv_origin_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:layout_marginStart="2dp"
        app:layout_orderInHorizontal="2"
        app:layout_orderInVertical="3"
        app:pv_priceTextColor="@color/shopping_std_text_black_4"
        app:pv_showStrikeThrough="true"/>
    <com.bytedance.android.ec.core.widget.price.PriceView
        android:textSize="10sp"
        android:layout_gravity="bottom"
        android:id="@+id/pv_deposit_price_view"
        android:background="@drawable/ec_bg_pre_sale_deposit_price"
        android:paddingLeft="4dp"
        android:paddingTop="1dp"
        android:paddingRight="4dp"
        android:paddingBottom="1dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="3dp"
        android:layout_marginStart="4dp"
        app:layout_orderInHorizontal="3"
        app:layout_orderInVertical="0"
        app:pv_autoResize="true"
        app:pv_prefixMarginRight="2dp"
        app:pv_prefixText="@string/ec_pre_sale_deposit_price"
        app:pv_yuanSymbolMarginRight="1dp"/>
</merge>
