<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/element_container"
    android:background="#ffffff"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="72dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/user_container"
        android:focusable="true"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/operatable_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginRight="108dp">
        <FrameLayout
            android:id="@+id/user_avatar_container"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="noHideDescendants"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/user_info_container"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.android.livesdk.interactivity.chatchannel.widget.ChannelRingView
                android:id="@+id/user_avatar_anim_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:ring_color="#161823"
                app:ring_width="2dp"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/user_avatar_iv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:placeholderImage="@drawable/ttlive_ic_withdraw_default_avatar"/>
            <com.bytedance.android.livesdk.interactivity.chatchannel.widget.ChannelRingView
                android:id="@+id/user_avatar_broad_iv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:ring_color="#1c161823"
                app:ring_width="0.5dp"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/user_info_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="noHideDescendants"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/manager_tag_view"
            app:layout_constraintStart_toEndOf="@+id/user_avatar_container"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="15dp"
                android:textColor="#161823"
                android:ellipsize="end"
                android:id="@+id/user_nickname_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#99161823"
                android:id="@+id/user_state_description_tv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView
            android:textSize="11dp"
            android:textColor="#90161823"
            android:gravity="center"
            android:id="@+id/manager_tag_view"
            android:background="@drawable/ttlive_room_channel_member_manage_list_tag_bg"
            android:layout_width="42dp"
            android:layout_height="20dp"
            android:text="@string/ttlive_room_channel_member_manage_creator"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/user_info_container"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/inoperate_volume_iv"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_room_channel_panel_guest_mic_status_talking_3"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/operatable_container"
        android:background="@drawable/ttlive_room_channel_member_manage_list_operate_bg"
        android:layout_width="106dp"
        android:layout_height="36dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/left_btn_container"
            android:layout_width="52dp"
            android:layout_height="36dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/left_btn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:background="#ffffff"
            android:layout_width="2dp"
            android:layout_height="36dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/right_btn_container"
            android:layout_width="52dp"
            android:layout_height="36dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/right_btn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/single_operatable_container"
        android:background="@drawable/ttlive_room_channel_member_manage_list_operate_bg"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ttlive_room_channel_panel_anchor_mic_status_close"
        android:layout_marginEnd="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/single_operate_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ttlive_room_channel_panel_anchor_mic_status_close"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
