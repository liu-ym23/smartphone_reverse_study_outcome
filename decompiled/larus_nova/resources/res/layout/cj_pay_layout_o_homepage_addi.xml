<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/rl_addi_category"
        android:background="@drawable/cj_pay_bg_r8_top_gradient_blue"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_addi_content"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:baselineAligned="false">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:id="@+id/tv_addi_category_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/cj_pay_color_red_fe2c55"
                android:gravity="center"
                android:id="@+id/tv_addi_tag1"
                android:background="@drawable/cj_pay_voucher_tag"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_marginStart="6dp"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/cj_pay_color_red_fe2c55"
                android:gravity="center"
                android:id="@+id/tv_addi_tag2"
                android:background="@drawable/cj_pay_voucher_tag"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_marginStart="4dp"/>
            <View
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <com.android.ttcjpaysdk.base.ui.widget.CJPayIOSStyleSwitch
                android:id="@+id/switch_addi"
                android:layout_width="34dp"
                android:layout_height="20dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="20dp"
                app:isChecked="true"
                app:layout_constraintRight_toRightOf="parent"
                app:switchPadding="1dp"
                app:switchThumb="@drawable/cj_pay_switch_addi_thumb"
                app:switchTrack="@drawable/cj_pay_switch_addi_voucher_blue_selector"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_addi_category_interact_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="13dp"
                    android:textColor="#99161823"
                    android:id="@+id/tv_addi_category_interact_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginLeft="2dp"
                    android:src="@drawable/cj_pay_icon_arrow_right_gray"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_addi_tag34"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ll_addi_content">
            <TextView
                android:textSize="10sp"
                android:textColor="@color/cj_pay_color_red_fe2c55"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_addi_tag3"
                android:background="@drawable/cj_pay_voucher_tag"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:singleLine="true"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/cj_pay_color_red_fe2c55"
                android:gravity="center"
                android:id="@+id/tv_addi_tag4"
                android:background="@drawable/cj_pay_voucher_tag"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_addi_followName"
        android:background="@drawable/cj_pay_bg_r8_bottom_solid_gray_f9fafb"
        android:layout_width="match_parent"
        android:layout_height="46dp">
        <com.android.ttcjpaysdk.base.ui.widget.CJPayFollowNameView
            android:id="@+id/addi_follow_name_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="16dp"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_addi_pay_without_login"
        android:background="@drawable/cj_pay_bg_r8_bottom_solid_gray_f9fafb"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/iv_account_avatar"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
            android:id="@+id/tv_account_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_account_avatar"
            app:layout_constraintStart_toEndOf="@+id/iv_account_avatar"
            app:layout_constraintTop_toTopOf="@+id/iv_account_avatar"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/cj_pay_color_blue"
            android:id="@+id/tv_account_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_account_avatar"
            app:layout_constraintLeft_toRightOf="@+id/tv_account_desc"
            app:layout_constraintTop_toTopOf="@+id/iv_account_avatar"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
            android:id="@+id/tv_account_sub_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginRight="16dp"
            app:layout_constraintLeft_toLeftOf="@+id/tv_account_desc"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_account_desc"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
