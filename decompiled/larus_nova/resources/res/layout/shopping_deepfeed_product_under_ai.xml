<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/deep_feed_ai_rec_lottie"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        app:lottie_loop="true"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/deep_feed_ai_rec_list"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="32dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/deep_feed_ai_write_layout"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/deep_feed_ai_icon_when_write"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="13dp"
            android:src="@drawable/shopping_bg_deep_feed_ai"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.shopping.deepfeed.ui.view.DeepFeedTypewriterTextView
            android:textColor="#b2ffffff"
            android:gravity="center"
            android:id="@+id/deep_feed_ai_write_view"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/deep_feed_ai_icon_when_write"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
