<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/goods_header_container"
    android:background="#08161823"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/poi_goods_detail_header_origin_height"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_bar">
        <com.bytedance.dux.text.DuxTextView
            android:textStyle="bold"
            android:textColor="@color/TextReverse"
            android:id="@+id/goods_detail_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/font_size_34_sp"/>
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/goods_detail_title_tab_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tabIndicatorColor="#161823"
            app:tabIndicatorFullWidth="false"
            app:tabMinWidth="10dp"
            app:tabPaddingEnd="12dp"
            app:tabPaddingStart="12dp"
            app:tabRippleColor="@android:color/transparent"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="center_vertical"
            android:id="@+id/trade_product_detail_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_s_s_arrowleft_outlined"
            app:tint="#161823"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="center_vertical"
            android:id="@+id/trade_product_search"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/search"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/trade_product_share"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_s_s_magnifier_outlined"
            app:tint="#161823"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="center_vertical"
            android:id="@+id/trade_product_share"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/share"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_s_s_arrowupright_outlined_20"
            app:tint="#161823"/>
        <include
            android:id="@+id/goods_detail_search_bar"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/trade_product_share"
            app:layout_constraintStart_toEndOf="@+id/trade_product_detail_back"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/saas_poi_trade_search_bar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/goods_detail_full_title_tab_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/poi_goods_detail_header_full_tab_height"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:tabIndicatorColor="#161823"
        app:tabIndicatorFullWidth="true"
        app:tabMinWidth="10dp"
        app:tabPaddingEnd="12dp"
        app:tabPaddingStart="12dp"
        app:tabRippleColor="@android:color/transparent"/>
</LinearLayout>
