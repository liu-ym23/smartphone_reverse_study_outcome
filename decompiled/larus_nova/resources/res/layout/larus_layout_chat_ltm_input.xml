<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_ltm_bottom_sheet"
    android:paddingTop="?attr/larus_dp_6"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/cancel"
        android:paddingLeft="?attr/larus_dp_8"
        android:paddingTop="?attr/larus_dp_10"
        android:paddingRight="?attr/larus_dp_8"
        android:paddingBottom="?attr/larus_dp_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_enter_memory_text_box_cancel"
        android:layout_marginStart="?attr/larus_dp_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/add_memory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_add_memory_btn"
        app:layout_constraintBottom_toBottomOf="@+id/cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cancel"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_primary_50"
        android:id="@+id/save"
        android:paddingLeft="?attr/larus_dp_8"
        android:paddingTop="?attr/larus_dp_10"
        android:paddingRight="?attr/larus_dp_8"
        android:paddingBottom="?attr/larus_dp_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_enter_memory_text_box_save"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="?attr/larus_sp_16"
        android:gravity="top"
        android:id="@+id/input"
        android:background="@color/larus_base_3"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_234"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_22"
        android:layout_marginRight="?attr/larus_dp_16"
        android:lineSpacingMultiplier="1.5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cancel"
        style="@style/larus_EditTextStyle"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/examine_root"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingTop="?attr/larus_dp_12"
        android:paddingRight="?attr/larus_dp_16"
        android:paddingBottom="?attr/larus_dp_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/examine_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/larus_icon_ltm_input_waring"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_12"
            android:textColor="@color/larus_danger_50"
            android:id="@+id/examine_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="审核未通过，请修改后重试"
            android:maxLines="1"
            android:layout_marginStart="?attr/larus_dp_4"/>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
