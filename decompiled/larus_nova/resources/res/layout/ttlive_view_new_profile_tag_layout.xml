<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/profile_tag_fans_layout"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="3dp">
        <TextView
            android:textSize="8.6dp"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/profile_tag_fans_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:singleLine="true"/>
    </LinearLayout>
    <TextView
        android:textSize="10dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_new_profile_black"
        android:gravity="center_vertical"
        android:id="@+id/profile_tag_never_join_fans_club"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginTop="1dp"
        android:text="@string/ttlive_new_profile_no_join_fans_club"
        android:maxLines="1"
        android:singleLine="true"/>
    <TextView
        android:textSize="10dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_new_profile_black"
        android:gravity="center_vertical"
        android:id="@+id/profile_tag_only_subscribe"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginTop="1dp"
        android:text="@string/ttlive_new_profile_is_subscribe_vip"
        android:maxLines="1"
        android:singleLine="true"/>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/profile_fans_club_count_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="18dp">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_new_profile_black"
            android:layout_gravity="bottom"
            android:id="@+id/profile_fans_club_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:translationY="0.5dp"/>
        <TextView
            android:textSize="10dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_new_profile_black"
            android:id="@+id/profile_fans_club_count_suffix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:includeFontPadding="false"/>
    </LinearLayout>
</FrameLayout>
