<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/dialog_float_window_layout"
    android:background="@drawable/ttlive_bg_float_window_dialog"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="#181823"
        android:layout_gravity="center_horizontal"
        android:id="@+id/ttlive_dialog_guide_float_window_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/ttlive_guide_float_window_title"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#c0162823"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/ttlive_dialog_guide_float_window_desc"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ttlive_guide_float_window_content"/>
    <View
        android:background="#1e181823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="32dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15dp"
            android:textColor="#181823"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/ttlive_dialog_guide_float_window_action_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/ttlive_guide_float_window_cancel"
            android:layout_weight="1"
            android:contentDescription="@string/ttlive_guide_float_window_cancel_accessibility"/>
        <View
            android:background="#1e181823"
            android:layout_width="0.5dp"
            android:layout_height="48dp"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#181823"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/ttlive_dialog_guide_float_window_action_ok"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/ttlive_guide_float_window_ok"
            android:layout_weight="1"
            android:contentDescription="@string/ttlive_guide_float_window_ok_accessibility"/>
    </LinearLayout>
</LinearLayout>
