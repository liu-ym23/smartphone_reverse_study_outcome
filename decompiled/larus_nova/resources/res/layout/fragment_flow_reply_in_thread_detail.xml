<?xml version="1.0" encoding="utf-8"?>
<com.ss.android.lark.threaddetail.view.StatisticKeyboardDetectorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:ptr="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/thread_detail_root"
    android:background="@color/flow_ud_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.ss.android.lark.chat.chatwindow.biz.component.keyboard.coordinate.MessageListAnimationContainer
            android:orientation="vertical"
            android:id="@+id/msg_lis_anim_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            ptr:layout_constraintBottom_toBottomOf="parent"
            ptr:layout_constraintTop_toTopOf="parent">
            <RelativeLayout
                android:id="@+id/message_list_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/list_bottom_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true">
                    <TextView
                        android:textColor="@color/text_placeholder"
                        android:gravity="center"
                        android:layout_gravity="bottom"
                        android:id="@+id/reply_in_thread_p2p_chatter_is_deactivied_tip"
                        android:background="@color/bg_body"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/p2p_chatter_is_dimission_tip_height"
                        android:text="@string/Lark_Legacy_ChatterResignPermissionMask"/>
                </LinearLayout>
            </RelativeLayout>
            <FrameLayout
                android:id="@+id/flow_bottom_banner_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:id="@+id/keyboard_extend_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.ss.android.lark.chat.chatwindow.biz.component.keyboard.coordinate.MessageListAnimationContainer>
        <FrameLayout
            android:id="@+id/thread_titlebar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            ptr:layout_constraintEnd_toEndOf="parent"
            ptr:layout_constraintStart_toStartOf="parent"
            ptr:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/keyboard_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            ptr:layout_constraintBottom_toBottomOf="parent"/>
        <FrameLayout
            android:id="@+id/flow_chat_message_list_view_observer"
            android:tag="flow_chat_message_list_view_observer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            ptr:layout_constraintBottom_toBottomOf="parent"
            ptr:layout_constraintEnd_toEndOf="parent"
            ptr:layout_constraintStart_toStartOf="parent"
            ptr:layout_constraintTop_toTopOf="parent"
            ptr:layout_constraintVertical_bias="0"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.ss.android.lark.threaddetail.view.StatisticKeyboardDetectorLayout>
