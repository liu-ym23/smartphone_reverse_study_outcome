<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/title_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="52dp">
        <com.bytedance.dux.text.DuxTextView
            android:textColor="@color/TextTertiary"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:textSpec="P2S"/>
        <com.bytedance.dux.image.DuxImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_title_icon"
            android:visibility="gone"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:src="@drawable/dux_ic_required"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title"
            app:layout_constraintStart_toEndOf="@+id/tv_title"
            app:layout_constraintTop_toTopOf="@+id/tv_title"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <RelativeLayout
        android:id="@+id/prefix_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/et_input"
        app:layout_constraintStart_toEndOf="@+id/title_container"
        app:layout_constraintTop_toTopOf="@+id/et_input"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="14sp"
        android:textColor="@color/TextPrimary"
        android:textColorHint="@color/TextQuaternary"
        android:id="@+id/et_input"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:cursorVisible="true"
        android:textCursorDrawable="@drawable/dux_form_cursor"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="25dp"
        app:layout_constraintEnd_toStartOf="@+id/iv_clear"
        app:layout_constraintStart_toEndOf="@+id/prefix_container"
        app:layout_constraintTop_toTopOf="@+id/title_container"
        app:layout_goneMarginLeft="0dp"
        app:layout_goneMarginStart="0dp"/>
    <com.bytedance.dux.image.DuxImageView
        android:id="@+id/iv_clear"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/dux_ic_close_full"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/et_input"
        app:layout_constraintEnd_toStartOf="@+id/tv_action"
        app:layout_constraintTop_toTopOf="@+id/et_input"
        app:layout_goneMarginEnd="0dp"/>
    <com.bytedance.dux.image.DuxImageView
        android:id="@+id/iv_action"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_s_s_scan_outlined"
        app:layout_constraintBottom_toBottomOf="@+id/et_input"
        app:layout_constraintEnd_toStartOf="@+id/tv_action"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/iv_clear"
        app:layout_constraintTop_toTopOf="@+id/et_input"/>
    <com.bytedance.dux.text.DuxTextView
        android:textColor="@color/TextTertiary"
        android:id="@+id/tv_action"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/et_input"
        app:layout_constraintEnd_toStartOf="@+id/suffix_container"
        app:layout_constraintTop_toTopOf="@+id/et_input"
        app:textSpec="H4S"/>
    <RelativeLayout
        android:id="@+id/suffix_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/et_input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/et_input"/>
    <com.bytedance.dux.divider.DuxDivider
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="15dp"
        app:dividerStyle="primary"
        app:layout_constraintStart_toEndOf="@+id/title_container"
        app:layout_constraintTop_toBottomOf="@+id/et_input"/>
    <com.bytedance.dux.text.DuxTextView
        android:textColor="@color/Negative"
        android:id="@+id/tv_error_tips"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintStart_toStartOf="@+id/divider"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        app:textSpec="T1S"/>
    <com.bytedance.dux.text.DuxTextView
        android:textColor="@color/TextQuaternary"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_input_tips"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_counter"
        app:layout_constraintStart_toStartOf="@+id/divider"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        app:textSpec="T1S"/>
    <com.bytedance.dux.text.DuxTextView
        android:textColor="@color/TextQuaternary"
        android:layout_gravity="end"
        android:id="@+id/tv_counter"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        app:textSpec="P3S"/>
</merge>
