<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.android.ttcjpaysdk.base.ui.dialog.nativev2.CJPayKeepDialogLeaveReasonLayout
            android:id="@+id/leave_reason1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <com.android.ttcjpaysdk.base.ui.dialog.nativev2.CJPayKeepDialogLeaveReasonLayout
            android:id="@+id/leave_reason2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/ll_reason_line2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <com.android.ttcjpaysdk.base.ui.dialog.nativev2.CJPayKeepDialogLeaveReasonLayout
            android:id="@+id/leave_reason3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <com.android.ttcjpaysdk.base.ui.dialog.nativev2.CJPayKeepDialogLeaveReasonLayout
            android:id="@+id/leave_reason4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
