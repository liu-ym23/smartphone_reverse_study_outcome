<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gamecp_detail_head_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/gamecp_detail_header_half_track_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/gamecp_detail_header_full_track_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/gamecp_detail_half_head_top_transparent"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:contentDescription="关闭"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.gamecp.common.ui.HSImageView
        android:id="@+id/gamecp_detail_header_icon"
        android:background="@drawable/gamecp_game_detail_img_default_bg_12dp"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="56dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="12dp"/>
    <View
        android:id="@+id/gamecp_detail_header_icon_frame"
        android:background="@drawable/gamecp_game_detail_img_default_bg_12dp_frame"
        android:layout_width="64dp"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="@+id/gamecp_detail_header_icon"
        app:layout_constraintEnd_toEndOf="@+id/gamecp_detail_header_icon"
        app:layout_constraintStart_toStartOf="@+id/gamecp_detail_header_icon"
        app:layout_constraintTop_toTopOf="@+id/gamecp_detail_header_icon"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/gamecp_detail_header_score_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="18dp"
        android:minWidth="52dp"
        app:layout_constraintBottom_toBottomOf="@+id/gamecp_detail_header_icon"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/gamecp_detail_header_icon">
        <TextView
            android:textSize="26sp"
            android:textColor="#161823"
            android:id="@+id/gamecp_detail_header_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/gamecp_detail_header_score_text"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#161823"
            android:id="@+id/gamecp_detail_header_score_text"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/gamecp_detail_header_score"
            app:layout_constraintLeft_toRightOf="@+id/gamecp_detail_header_score"
            app:layout_constraintRight_toRightOf="parent"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#99161823"
            android:id="@+id/gamecp_detail_header_comment_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gamecp_detail_header_score"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/gamecp_detail_header_name_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/gamecp_detail_header_tags"
        app:layout_constraintEnd_toStartOf="@+id/gamecp_detail_header_score_container"
        app:layout_constraintStart_toEndOf="@+id/gamecp_detail_header_icon"
        app:layout_constraintTop_toTopOf="@+id/gamecp_detail_header_icon"
        app:layout_constraintVertical_chainStyle="packed">
        <com.bytedance.android.gamecp.business.view.GameDetailTitleTextView
            android:textSize="20sp"
            android:textColor="#ff161823"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/gamecp_detail_header_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/gamecp_detail_header_status"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/gamecp_detail_header_status"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/gamecp_detail_header_name"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.android.gamecp.common.ui.HSImageView
                android:id="@+id/gamecp_detail_header_status_half"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.bytedance.android.gamecp.common.ui.HSImageView
                android:id="@+id/gamecp_detail_header_status_full"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/gamecp_detail_header_official_account_container"
        android:background="@drawable/gamecp_shape_bg_0d161823_corner_2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="5dp">
        <ImageView
            android:id="@+id/gamecp_detail_header_official_account_icon"
            android:background="@drawable/gamecp_game_promote_official_cert_icon"
            android:layout_width="12sp"
            android:layout_height="12sp"
            android:layout_marginStart="3dp"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#bf161823"
            android:id="@+id/gamecp_detail_header_official_account_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gamecp_official_account"
            android:layout_marginStart="2dp"/>
        <ImageView
            android:id="@+id/gamecp_detail_header_official_account_arrow"
            android:background="@drawable/gamecp_ic_official_account_arrow_gray"
            android:layout_width="5sp"
            android:layout_height="11sp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="3dp"/>
    </LinearLayout>
    <com.bytedance.android.gamecp.common.ui.FlowLayout
        android:orientation="horizontal"
        android:id="@+id/gamecp_detail_header_tags"
        android:layout_width="0dp"
        android:layout_height="14sp"
        android:layout_marginTop="2dp"
        app:layout_constraintBottom_toTopOf="@+id/gamecp_detail_header_desc"
        app:layout_constraintEnd_toEndOf="@+id/gamecp_detail_header_name_container"
        app:layout_constraintStart_toStartOf="@+id/gamecp_detail_header_name_container"
        app:layout_constraintTop_toBottomOf="@+id/gamecp_detail_header_name_container"/>
    <TextView
        android:textSize="11sp"
        android:textColor="#bf161823"
        android:gravity="center"
        android:id="@+id/gamecp_detail_header_desc"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="14sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/gamecp_detail_header_icon"
        app:layout_constraintEnd_toEndOf="@+id/gamecp_detail_header_name_container"
        app:layout_constraintStart_toStartOf="@+id/gamecp_detail_header_name_container"
        app:layout_constraintTop_toBottomOf="@+id/gamecp_detail_header_tags"/>
    <com.bytedance.android.gamecp.business.gamedetail.view.GameDetailDescListView
        android:id="@+id/gamecp_detail_header_desc_list"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/gamecp_detail_header_desc"
        app:layout_constraintLeft_toLeftOf="@+id/gamecp_detail_header_desc"
        app:layout_constraintRight_toRightOf="@+id/gamecp_detail_header_desc"
        app:layout_constraintTop_toTopOf="@+id/gamecp_detail_header_desc"/>
</androidx.constraintlayout.widget.ConstraintLayout>
