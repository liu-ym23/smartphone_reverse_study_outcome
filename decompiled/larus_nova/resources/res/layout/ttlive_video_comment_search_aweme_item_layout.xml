<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="#0d161823"
        android:layout_width="match_parent"
        android:layout_height="12dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <com.bytedance.lighten.loader.SmartCircleImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/video_item_avatar"
            android:layout_width="28dp"
            android:layout_height="28dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp">
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#161823"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/video_item_nickName"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:singleLine="true"/>
            <TextView
                android:textSize="11dp"
                android:textColor="#57161823"
                android:gravity="start|center_vertical"
                android:id="@+id/video_item_date"
                android:layout_width="wrap_content"
                android:layout_height="15dp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="14dp"
        android:textColor="#161823"
        android:ellipsize="end"
        android:id="@+id/video_item_desc"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="4"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <FrameLayout
        android:id="@+id/video_info_container"
        android:layout_width="168dp"
        android:layout_height="331dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/video_item_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="@+id/video_container"
            app:layout_constraintEnd_toEndOf="@+id/video_container"
            app:layout_constraintLeft_toLeftOf="@+id/video_container"
            app:layout_constraintRight_toRightOf="@+id/video_container"
            app:layout_constraintStart_toStartOf="@+id/video_container"
            app:layout_constraintTop_toTopOf="@+id/video_container"/>
        <RelativeLayout
            android:layout_gravity="end|bottom"
            android:id="@+id/play_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/ic_play_btn"
                android:background="@drawable/ttlive_video_pause_icon"
                android:layout_width="22dp"
                android:layout_height="28dp"
                android:layout_margin="20dp"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <FrameLayout
            android:id="@+id/video_container"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </FrameLayout>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/video_item_operate"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/video_item_pin_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="20dp"
            android:layout_alignParentStart="true">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/video_pin_select"
                android:background="@drawable/ttlive_video_comment_select_panel_unselect_bg"
                android:layout_width="16dp"
                android:layout_height="16dp"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#161823"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="@string/ttlive_video_pin_title"
                android:includeFontPadding="false"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/video_item_pin_send"
            android:background="@drawable/ttlive_video_pin_send_button_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="20dp"
            android:layout_alignParentEnd="true">
            <ImageView
                android:layout_gravity="center_vertical"
                android:background="@drawable/ttlive_send_video_icon"
                android:layout_width="14dp"
                android:layout_height="16dp"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#ffffff"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="@string/ttlive_video_pin_send_video"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
