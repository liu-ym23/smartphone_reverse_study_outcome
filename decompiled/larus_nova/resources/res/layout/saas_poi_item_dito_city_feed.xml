<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/poi_item_dito_city_feed_432934468"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">
    <com.bytedance.locallife.dito.baseview.RoundFrameLayout
        android:id="@+id/poi_feed_container"
        android:background="#14000000"
        android:layout_width="match_parent"
        android:layout_height="252dp"
        app:rounded_radius="4dp">
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/poi_feed_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:layout_gravity="bottom"
            android:background="@drawable/poi_bg_city_feed_bottom"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:alpha="0.75"/>
        <com.bytedance.locallife.dito.baseview.RoundLinearLayout
            android:orientation="horizontal"
            android:id="@+id/poi_feed_live_container"
            android:background="#80000000"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            app:rounded_radius="2dp">
            <com.ss.android.ugc.aweme.base.ui.RemoteImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                app:actualImageResource="@drawable/poi_ic_city_feed_live"/>
            <com.bytedance.dux.text.DuxTextView
                android:textSize="12dp"
                android:textColor="#bfffffff"
                android:layout_gravity="center"
                android:id="@+id/poi_feed_live_text"
                android:layout_width="wrap_content"
                android:layout_height="17dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"/>
        </com.bytedance.locallife.dito.baseview.RoundLinearLayout>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/poi_feed_user_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <com.ss.android.ugc.aweme.base.ui.CircleImageView
                    android:layout_gravity="center"
                    android:id="@+id/poi_feed_user_icon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"/>
                <com.bytedance.dux.text.DuxTextView
                    android:textSize="12dp"
                    android:textColor="@color/ConstTextInverse"
                    android:ellipsize="end"
                    android:id="@+id/poi_feed_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="8dp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="end|bottom"
                android:orientation="horizontal"
                android:id="@+id/poi_feed_digg_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:id="@+id/poi_feed_digg_image"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    app:srcCompat="@drawable/ic_s_s_heart_outlined_20"
                    app:tint="@color/ConstTextInverse"/>
                <com.bytedance.dux.text.DuxTextView
                    android:textSize="12dp"
                    android:textColor="@color/ConstTextInverse"
                    android:id="@+id/poi_feed_digg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"/>
            </LinearLayout>
        </LinearLayout>
    </com.bytedance.locallife.dito.baseview.RoundFrameLayout>
    <com.bytedance.dux.text.DuxTextView
        android:textSize="13dp"
        android:textColor="@color/POITextPrimary"
        android:ellipsize="end"
        android:id="@+id/poi_feed_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="6dp"/>
    <com.bytedance.locallife.dito.baseview.RoundLinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/poi_feed_anchor_container"
        android:background="@color/POIBgInput"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="6dp"
        app:rounded_radius="2dp">
        <com.ss.android.ugc.aweme.base.ui.RemoteImageView
            android:id="@+id/poi_feed_poi_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:layout_marginEnd="4dp"
            app:actualImageResource="@drawable/poi_ic_city_feed_poi"/>
        <com.bytedance.dux.text.DuxTextView
            android:textSize="12dp"
            android:textColor="@color/POITextPrimary"
            android:ellipsize="end"
            android:id="@+id/poi_feed_poi_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </com.bytedance.locallife.dito.baseview.RoundLinearLayout>
</LinearLayout>
