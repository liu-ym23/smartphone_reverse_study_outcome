<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.live.performance.views.PerftoolsRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#2f000000"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/debug_normal_info_list"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/debug_performance_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="10sp"
                android:textColor="@color/ttlive_core_dy_yellow"
                android:layout_gravity="center_horizontal"
                android:id="@+id/debug_performance_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.bytedance.android.live.performance.views.charts.LineChartView
                android:id="@+id/debug_performance_data_chart"
                android:layout_width="wrap_content"
                android:layout_height="200dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/debug_performance_text_data"
                android:layout_width="wrap_content"
                android:layout_height="100dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:textColor="@color/ttlive_light_blue"
                    android:id="@+id/debug_performance_chart_backward"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_perftools_perf_data_backward"
                    android:layout_weight="1"/>
                <Button
                    android:textColor="@color/ttlive_light_blue"
                    android:id="@+id/debug_performance_chart_forward"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_perftools_perf_data_forward"
                    android:layout_weight="1"/>
            </LinearLayout>
            <GridView
                android:id="@+id/debug_performance_type_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:numColumns="5"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true">
        <FrameLayout
            android:layout_gravity="end"
            android:id="@+id/close_entrance"
            android:layout_width="50dp"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="end"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginRight="5dp"
                android:src="@drawable/ttlive_close_popup_textpage"
                android:layout_marginEnd="5dp"/>
        </FrameLayout>
    </FrameLayout>
</com.bytedance.android.live.performance.views.PerftoolsRelativeLayout>
