<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="15dp"
        android:textColor="@color/white"
        android:layout_gravity="center"
        android:id="@+id/text_empty_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="parent"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.effect.base.LiveEffectPagerSlidingTabStrip
        android:layout_gravity="center_vertical"
        android:id="@+id/tab_strip"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@+id/sticker_pager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ttlive_effect_tab_background="@drawable/ttlive_effect_secondary_tab_bg"
        app:ttlive_effect_tab_container_horizontal_margin="12dp"
        app:ttlive_effect_tab_enable_margin="true"
        app:ttlive_effect_tab_horizontal_margin="4dp"
        app:ttlive_effect_tab_indicator_height="0dp"
        app:ttlive_effect_tab_padding_left_right="12dp"
        app:ttlive_effect_tab_scroll_offset="112dp"
        app:ttlive_effect_tab_text_color="@color/ttlive_effect_live_sticker_tab_text_color_v2"
        app:ttlive_effect_tab_text_size="13dp"
        app:ttlive_effect_tab_typeface_style="normal"
        app:ttlive_effect_tab_underline_height="0dp"/>
    <com.bytedance.android.live.uikit.rtl.RtlViewPager
        android:id="@+id/sticker_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tab_strip"/>
    <com.bytedance.android.live.uikit.recyclerview.LoadingStatusView
        android:id="@+id/loading_status_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
