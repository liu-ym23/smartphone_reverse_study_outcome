<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/ec_commerce_similar_product_feedback_item_view_130000960"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/ec_commerce_similar_product_feedback_item_icon"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="centerCrop"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/commerce_color_FFFFFF"
        android:layout_gravity="center_vertical"
        android:id="@+id/ec_commerce_similar_product_feedback_item_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginStart="8dp"/>
</LinearLayout>
