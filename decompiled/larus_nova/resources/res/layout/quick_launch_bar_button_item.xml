<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_quick_launch_bar_button"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/quick_launch_bar_button_height"
    android:divider="@drawable/ic_quick_launch_bar_button_divider"
    android:showDividers="middle">
    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="@dimen/quick_launch_bar_item_icon_size"
        android:layout_height="@dimen/quick_launch_bar_item_icon_size"
        android:scaleType="fitCenter"/>
    <FrameLayout
        android:id="@+id/flNameContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/text_title"
            android:ellipsize="none"
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </FrameLayout>
    <com.larksuite.component.universe_design.badge.UDBadgeView
        android:id="@+id/badgeDotView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/UDBadge.Dot.StrongReminder.Medium"/>
    <com.larksuite.component.universe_design.badge.UDBadgeView
        android:id="@+id/badgeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/UDBadge.Text.Red"/>
</LinearLayout>
