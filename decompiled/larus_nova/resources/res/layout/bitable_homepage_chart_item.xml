<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.ee.bear.bitable.homepage.chart.widget.chart.LynxUIContainer
        android:id="@+id/hp_chart_lynx_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/hp_chart_loading_container"
        android:background="@color/bg_float"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.larksuite.component.universe_design.emptystate.UDEmptyState
            android:id="@+id/hp_chart_loading_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:ud_empty_desc="@string/Bitable_HomeDashboard_LoadingChart_Desc"
            app:ud_empty_imageRes="@drawable/bitable_homepage_chart_loading"
            app:ud_empty_imageSize="60dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/hp_chart_error_container"
        android:background="@color/bg_float"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.larksuite.component.universe_design.emptystate.UDEmptyState
            android:layout_gravity="center"
            android:id="@+id/hp_chart_error_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:ud_empty_desc="@string/Bitable_HomeDashboard_ChartLoadFailed_Desc"
            app:ud_empty_imageRes="@drawable/bitable_homepage_chart_error"
            app:ud_empty_imageSize="60dp"
            app:ud_empty_secondaryText="@string/Bitable_HomeDashboard_ReloadChart_Button"/>
    </FrameLayout>
</merge>
