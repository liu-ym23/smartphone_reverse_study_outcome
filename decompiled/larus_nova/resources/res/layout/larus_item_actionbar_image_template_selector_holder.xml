<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="?attr/larus_dp_84"
    android:layout_height="?attr/larus_dp_112">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/image_template_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImage="?attr/larus_base_3_overlay"
        app:placeholderImage="?attr/larus_base_3_overlay"
        app:roundedCornerRadius="?attr/larus_dp_8"/>
    <FrameLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/image_template_create_container"
        android:background="@drawable/larus_bg_same_template_button"
        android:paddingLeft="?attr/larus_dp_8"
        android:paddingRight="?attr/larus_dp_8"
        android:layout_width="?attr/larus_dp_75"
        android:layout_height="?attr/larus_dp_25"
        android:layout_marginBottom="?attr/larus_dp_6">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_12"
            android:textColor="@color/larus_static_white"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/image_template_create_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/retry_icon"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        app:srcCompat="?attr/larus_icon_template_arrow_clockwise"/>
</FrameLayout>
