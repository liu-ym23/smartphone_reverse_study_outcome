<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_room_center_dialog"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_room_notice_dialog_main_textcolor"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/room_center_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/ttlive_is_open_auto_exchange"
        android:includeFontPadding="false"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ttlive_room_notice_dialog_minor_textcolor"
        android:gravity="center"
        android:id="@+id/room_center_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ttlive_insufficient_auto_exchange_diamond"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <View
        android:id="@+id/live_dialog_divider_1"
        android:background="@color/ttlive_room_notice_dialog_line_color"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="32dp"/>
    <Button
        android:layout_gravity="center_horizontal"
        android:id="@+id/room_center_button"
        android:visibility="gone"
        style="@style/ttlive_live_notice_dialog_button_vertical"/>
    <LinearLayout
        android:id="@+id/room_center_button_layout"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textSize="15sp"
            android:textColor="@color/ttlive_room_center_btn_elderly_remind"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/room_center_button_left"
            android:background="@drawable/ttlive_bg_room_review_confirm_dialog_btn_left"
            android:layout_width="match_parent"
            android:layout_height="47dp"
            android:text="@string/ttlive_cancel_auto_exchange"
            android:maxLines="1"
            android:lines="1"
            android:layout_weight="1"
            android:textAllCaps="false"/>
        <View
            android:background="@color/ttlive_room_notice_dialog_line_color"
            android:layout_width="0.5dp"
            android:layout_height="47dp"/>
        <Button
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_room_center_btn_elderly_remind"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/room_center_button_right"
            android:background="@drawable/ttlive_bg_room_review_confirm_dialog_btn_right"
            android:layout_width="match_parent"
            android:layout_height="47dp"
            android:text="@string/ttlive_open_auto_exchange"
            android:maxLines="1"
            android:lines="1"
            android:layout_weight="1"
            android:textAllCaps="false"/>
    </LinearLayout>
</LinearLayout>
