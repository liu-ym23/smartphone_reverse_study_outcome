<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/outside_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/ttlive_bg_dialog_authorize_guide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#d9000000"
            android:gravity="center"
            android:id="@+id/authorize_title"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/ttlive_link_in_room_account_authorize_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/normal_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="#19000000"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#d9000000"
                android:id="@+id/authorize_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/ttlive_link_in_room_account_authorize_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/authorize_title"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/item_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:divider="@drawable/ttlive_divider_authorize_guide_item"
                android:showDividers="middle"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/progress_bar"
                android:padding="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/ttlive_authorize_guide_dialog_button_text"
                android:gravity="center"
                android:id="@+id/apply_button"
                android:background="@drawable/ttlive_bg_authorize_guide_dialog_button"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:text="@string/ttlive_submit_text"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/retry_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="#19000000"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <View
                android:background="@drawable/ttlive_loading_error"
                android:layout_width="210dp"
                android:layout_height="140dp"
                android:layout_marginTop="28dp"/>
            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#161823"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_web_network_error"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#80161823"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ttlive_toast_network_exception"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#161823"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/retry_text"
                android:background="@drawable/ttlive_bg_authorize_guide_retry_btn"
                android:layout_width="231dp"
                android:layout_height="44dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="36dp"
                android:text="@string/ttlive_core_load_status_reload"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
