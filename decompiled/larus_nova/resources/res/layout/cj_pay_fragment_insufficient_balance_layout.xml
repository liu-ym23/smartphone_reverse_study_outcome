<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/ll_root_view"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cj_pay_height_470">
    <include
        android:id="@+id/cj_pay_titlebar_root_view"
        layout="@layout/cj_pay_view_titlebar_layout"/>
    <ImageView
        android:id="@+id/insufficient_image"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="100dp"
        android:src="@drawable/cj_pay_cry_face_icon"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/cj_pay_color_black_161823"
        android:id="@+id/insufficient_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/cj_pay_insufficient_balance"/>
    <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/cj_pay_color_white"
        android:gravity="center"
        android:id="@+id/insufficient_choose_other_method_btn"
        android:background="@color/cj_pay_color_red_fe2c55"
        android:layout_width="160dp"
        android:layout_height="40dp"
        android:layout_marginTop="24dp"
        android:text="@string/cj_pay_change_payment_method"/>
</LinearLayout>
