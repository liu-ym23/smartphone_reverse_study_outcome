<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="10dp"
        android:textColor="@color/white"
        android:id="@+id/commerce_playback_tv_video_curtime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:text=""
        android:layout_marginEnd="8dp"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="/"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/ec_color_white_50"
        android:id="@+id/commerce_playback_tv_video_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:text="00:00"
        android:layout_marginStart="8dp"/>
    <com.bytedance.android.ec.store.view.ECShopVideoPlaySeekBar
        android:id="@+id/commerce_playback_video_seekbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxHeight="3dp"
        android:max="100"
        android:progress="1"
        android:progressDrawable="@drawable/ec_shop_playback_video_seekbar_layer_progress"
        android:minHeight="3dp"
        android:thumb="@drawable/ec_explain_playback_video_seekbar_shape_circle"
        android:thumbOffset="0dp"
        android:layout_weight="1"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:layout_marginStart="12dp"/>
    <com.bytedance.android.ui.base.widget.button.CornersButton
        android:textSize="10dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_speed"
        android:visibility="visible"
        android:layout_width="27dp"
        android:layout_height="27dp"
        android:layout_marginStart="8dp"
        app:bg_color="@color/shopping_color_33000000"/>
</LinearLayout>
