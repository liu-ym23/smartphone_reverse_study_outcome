<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ttlive_beinvited_constraintlayout"
    android:background="@drawable/ttlive_bg_interact_dialog"
    android:paddingBottom="6dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="255dp"
    app:layout_constraintTop_toTopOf="parent">
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="15dp"
        android:text="@string/ttlive_live_pk_notify_dialog_title"
        android:layout_marginStart="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#bf161823"
        android:id="@+id/tv_setting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginRight="16dp"
        android:text="@string/ttlive_live_pk_notify_dialog_setting"
        android:layout_marginEnd="16dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider"
        android:background="#14000000"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="52dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/head_view_container"
        android:background="@drawable/ttlive_bg_live_red_round_v2"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider">
        <View
            android:layout_gravity="center"
            android:background="@drawable/ttlive_bg_live_white_round_v2"
            android:layout_width="64dp"
            android:layout_height="64dp"/>
        <com.bytedance.android.livesdk.widget.VHeadView
            android:layout_gravity="center"
            android:id="@+id/oppo_head_view"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:src="@drawable/ttlive_ic_default_head_small"
            app:placeholderImage="@drawable/ttlive_ic_default_head_small"
            app:retryImageScaleType="fitXY"
            app:roundAsCircle="true"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/user_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="17dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="17dp"
        app:layout_constraintLeft_toRightOf="@+id/head_view_container"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#161823"
                android:ellipsize="end"
                android:id="@+id/tv_oppo_nick_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:maxEms="6"
                android:singleLine="true"/>
            <com.bytedance.android.livesdk.widget.VHeadView
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/view_gender"
                android:background="@drawable/ttlive_bg_circle_head"
                android:visibility="gone"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginLeft="4dp"
                android:layout_marginStart="4dp"
                app:retryImageScaleType="fitXY"
                app:roundAsCircle="true"/>
            <com.bytedance.android.live.revlink.impl.pk.ui.PkTagsContainerView
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/tags_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <ImageView
                android:id="@+id/iv_audience_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ttlive_icon_audience"/>
            <TextView
                android:textSize="11dp"
                android:textColor="#80161823"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_oppo_audience_number"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
            <ImageView
                android:id="@+id/iv_fire_number"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="8dp"
                android:src="@drawable/ttlive_ic_fire_number"
                android:layout_marginStart="8dp"/>
            <TextView
                android:textSize="11dp"
                android:textColor="#80161823"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_oppo_fan_ticket"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView
            android:textSize="11dp"
            android:textColor="#80161823"
            android:gravity="center"
            android:id="@+id/tv_oppo_user_recommend_reason"
            android:background="@drawable/ttlive_bg_pk_notify_match_reason"
            android:paddingLeft="4dp"
            android:paddingTop="4dp"
            android:paddingRight="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginRight="16dp"
            android:singleLine="true"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="19dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/head_view_container">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:background="@drawable/ttlive_bg_pk_feedback_another"
            android:layout_width="167dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="4dp"
            android:text="@string/ttlive_live_pk_notify_dialog_cancel"
            android:height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_invite"
            android:background="@drawable/ttlive_bg_pk_cancel"
            android:layout_width="167dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="16dp"
            android:text="@string/ttlive_live_pk_notify_dialog_invite"
            android:height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
