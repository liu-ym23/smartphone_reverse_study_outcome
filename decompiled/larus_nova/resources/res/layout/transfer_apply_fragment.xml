<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/facade_round_top_xxl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/bg_float_base">
    <com.bytedance.ee.bear.widgets.BaseTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:widget_widgets_tb_back_icon="@drawable/ud_icon_close_small_outlined"
        app:widget_widgets_tb_background="@color/color_transparent"
        app:widget_widgets_tb_divider_height="@dimen/ud_divider_size"
        app:widget_widgets_tb_divider_visible="true"
        app:widget_widgets_tb_title="@string/LarkCCM_CM_Verify_AskOwner_Menu"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:layout_marginBottom="12dp"
            android:text="@string/LarkCCM_NewCM_AfterTransfer_Title"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_title"
            android:id="@+id/transfer_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/LarkCCM_Docs_TransferOwnerRequest_SelectedDocs_Title"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/transfer_apply_selected_name"
            android:background="@drawable/selected_doc_cell"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/transfer_doc_root"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp">
                <com.larksuite.component.universe_design.image.UDAvatar
                    android:layout_gravity="center_vertical"
                    android:id="@+id/selected_doc_avatar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/space_kit_len_12"
                    app:ud_avatar_borderWidth="0dp"
                    app:ud_avatar_size="mini"
                    style="@style/UDAvatar.Circle"/>
                <TextView
                    android:textSize="@dimen/space_kit_font_14"
                    android:textColor="@color/text_title"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/selected_doc_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"/>
            </LinearLayout>
            <View
                android:id="@+id/divider"
                android:background="@color/ud_divider_color"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_kit_len_divider"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/selected_doc_name"
                app:layout_constraintTop_toBottomOf="@+id/transfer_doc_root"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/transfer_folder_root"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp">
                <com.larksuite.component.universe_design.checkbox.UDCheckBox
                    android:id="@+id/folder_check_box"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_default="wrap"
                    app:ud_checkbox_size="small"
                    app:ud_checkbox_type="check_box"/>
                <TextView
                    android:textSize="@dimen/space_kit_font_14"
                    android:textColor="@color/text_title"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/selected_folder_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/LarkCCM_Docs_TransferOwnerRequest_WithSubs_Radio"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"/>
            </LinearLayout>
        </LinearLayout>
        <com.larksuite.component.universe_design.button.UDButton
            android:enabled="true"
            android:textSize="16sp"
            android:textColor="@color/static_white"
            android:id="@+id/doneBtn"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/LarkCCM_Docs_TransferOwnerRequest_Transfer_Button"
            android:layout_weight="1"
            app:ud_backgroundColor="@color/text_disable"
            app:ud_radius="l"
            style="@style/UDButton.Small.Primary"/>
    </LinearLayout>
</LinearLayout>
