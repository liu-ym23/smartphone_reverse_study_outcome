<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="66dp"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="2dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/img_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/invited_shader"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ttlive_bg_invited_shader"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/invited_arrow"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ttlive_ic_invited"/>
        <FrameLayout
            android:layout_gravity="end|bottom"
            android:id="@+id/v_online_state"
            android:background="@drawable/ttlive_bg_talk_invite_list_friend_online_state_white"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginRight="-3dp"
            android:layout_marginBottom="-3dp"
            android:layout_marginEnd="-3dp">
            <View
                android:layout_gravity="center"
                android:background="@drawable/ttlive_bg_talk_invite_list_friend_online_state_green"
                android:layout_width="12dp"
                android:layout_height="12dp"/>
        </FrameLayout>
    </FrameLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="#e5161823"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/user_nick"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="8dp"
        android:maxLines="1"/>
</LinearLayout>
