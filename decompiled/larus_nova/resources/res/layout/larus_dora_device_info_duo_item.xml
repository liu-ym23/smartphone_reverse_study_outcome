<?xml version="1.0" encoding="utf-8"?>
<com.larus.common_ui.widget.roundlayout.RoundFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="?attr/larus_dp_0"
    android:layout_height="?attr/larus_dp_100"
    android:layout_margin="?attr/larus_dp_16"
    android:layout_columnWeight="1"
    app:rv_backgroundColor="@color/base_2"
    app:rv_cornerRadius="?attr/larus_dp_16">
    <com.facebook.drawee.view.SimpleDraweeView
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/duo_item_image"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        android:layout_marginTop="?attr/larus_dp_24"/>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_dp_16"
        android:textColor="@color/neutral_100"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/duo_item_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_24"/>
</com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
