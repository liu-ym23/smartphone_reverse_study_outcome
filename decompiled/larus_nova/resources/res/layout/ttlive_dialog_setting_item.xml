<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:background="@drawable/ttlive_bg_dynamic_emoji_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/guide_line"
        android:background="@color/ttlive_dialog_dividing_line_color"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:paddingStart="17dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guide_line">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/ttlive_link_text_color"
            android:id="@+id/tv_link_distribute_setting_item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="@string/ttlive_live_link_distribute_item_friends"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/guide_line"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/ttlive_core_hs_s5_41"
            android:id="@+id/tv_link_distribute_setting_item_dec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_live_link_distribute_item_friends_dec"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/guide_line"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/item_right_icon"
        android:visibility="gone"
        android:layout_width="37dp"
        android:layout_height="18dp"
        android:paddingEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
