<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/menu_icon"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:scaleType="centerInside"
        app:tint="?attr/larus_neutral_100"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/menu_text_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="?attr/larus_dp_12">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_16"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="end"
            android:id="@+id/menu_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintEnd_toStartOf="@+id/tv_menu_item_tag_layout"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/tv_menu_item_tag_layout"
            android:background="@drawable/larus_bg_menu_item_tag"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="?attr/larus_dp_4"
            app:layout_constraintBottom_toBottomOf="@+id/menu_text"
            app:layout_constraintStart_toEndOf="@+id/menu_text"
            app:layout_constraintTop_toTopOf="@+id/menu_text">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_dp_11"
                android:textColor="?attr/larus_neutral_50"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_menu_item_tag"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="?attr/larus_dp_4"
                android:layout_marginRight="?attr/larus_dp_4"
                android:maxLines="1"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/blue_tag_layout"
            android:background="@drawable/larus_action_bar_menu_blue_update_icon"
            android:paddingLeft="?attr/larus_dp_4"
            android:paddingRight="?attr/larus_dp_4"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_18"
            android:layout_marginStart="?attr/larus_dp_4"
            app:layout_constraintBottom_toBottomOf="@+id/menu_text"
            app:layout_constraintStart_toEndOf="@+id/tv_menu_item_tag_layout"
            app:layout_constraintTop_toTopOf="@+id/menu_text">
            <com.facebook.drawee.view.SimpleDraweeView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/blue_tag_icon"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_10"
                android:layout_height="?attr/larus_dp_10"
                android:scaleType="centerInside"
                android:layout_marginEnd="?attr/larus_dp_2"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_dp_11"
                android:textColor="?attr/larus_primary_50"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/blue_tag_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxLines="1"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_13"
            android:textColor="?attr/larus_neutral_50"
            android:ellipsize="end"
            android:id="@+id/menu_sub_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_20"
            android:layout_marginTop="?attr/larus_dp_2"
            android:maxLines="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/menu_text"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.facebook.drawee.view.SimpleDraweeView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/menu_text_icon"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:scaleType="center"
        android:layout_marginStart="?attr/larus_dp_12"
        app:tint="?attr/larus_neutral_100"/>
</merge>
