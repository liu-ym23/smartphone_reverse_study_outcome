<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/cj_pay_password_verify_root_view"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="470dp">
    <FrameLayout
        android:id="@+id/cj_pay_titlebar_root_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_50"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/cj_pay_back_view"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="@dimen/cj_pay_font_size_16"
            android:src="@drawable/cj_pay_icon_titlebar_left_close_noise_reduction"
            android:scaleType="centerCrop"
            android:contentDescription="@string/cj_pay_pass_close_tallback"/>
        <com.android.ttcjpaysdk.base.ui.CJPayMiddleTitleText
            android:textSize="17sp"
            android:textColor="@color/cj_pay_color_black_161823"
            android:ellipsize="middle"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/cj_pay_middle_title"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="300dp"
            android:singleLine="true"/>
    </FrameLayout>
    <com.android.ttcjpaysdk.base.ui.component.input.PwdEditTextNoiseReduction
        android:id="@+id/cj_pay_pwd_view"
        android:background="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="20dp"
        app:CJPayDotRadius="6dp"
        app:CJPayPwdCount="6"
        app:CJPayPwdEditShapeStyle="CJPayRoundRectangle"
        app:CJPayStrokeColor="@color/cj_pay_color_white_F1F1F2"
        app:CJPayStrokeRadius="4dp"
        app:CJPayStrokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_titlebar_root_view"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/cj_pay_color_red_fe3824"
        android:id="@+id/cj_pay_password_input_error_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintLeft_toLeftOf="@+id/cj_pay_pwd_view"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_pwd_view"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
        android:id="@+id/cj_pay_forget_password_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/cj_pay_forget_password"
        app:layout_constraintRight_toRightOf="@+id/cj_pay_pwd_view"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_pwd_view"/>
    <com.android.ttcjpaysdk.base.ui.component.keyboard.CJNumKeyboardView
        android:id="@+id/cj_pay_keyboard_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:keepScreenOn="true"
        app:CJNumKeyboardStyle="0"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <FrameLayout
        android:id="@+id/bio_enable_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/cj_pay_keyboard_view"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp"
        layout="@layout/cj_pay_view_half_screen_loading_layout"/>
    <include
        android:id="@+id/cj_pay_security_panel_loading_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_titlebar_root_view"
        layout="@layout/cj_pay_view_security_panel_loading_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
