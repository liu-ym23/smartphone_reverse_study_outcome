<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:id="@+id/award_group"
    android:background="@drawable/ttlive_bg_award_daily_gift_task"
    android:layout_width="150dp"
    android:layout_height="107dp"
    android:layout_marginTop="105dp">
    <com.bytedance.android.live.core.widget.LiveTextView
        android:textSize="13dp"
        android:textColor="@color/white"
        android:id="@+id/tv_award_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:singleLine="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_award_title">
        <com.bytedance.android.live.core.widget.LiveTextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/tv_award_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_rapid_live_award_type_coin"
            android:singleLine="true"
            app:layout_constraintEnd_toStartOf="@+id/tv_award_num"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.live.core.widget.LiveTextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/tv_award_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="60dp"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_award_unit"
            app:layout_constraintStart_toEndOf="@+id/tv_award_type"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.live.core.widget.LiveTextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/tv_award_unit"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_rapid_live_award_cash_unit"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_award_num"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.live.core.widget.LiveTextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/tv_award_num_anim"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="60dp"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/tv_award_num"
            app:layout_constraintStart_toStartOf="@+id/tv_award_num"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.live.core.widget.LiveTextView
        android:textSize="10dp"
        android:textColor="@color/white"
        android:id="@+id/tv_award_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:alpha="0.7"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
