<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:background="@drawable/ttlive_bg_message_item_v2"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/ttlive_avatar_view"
        android:background="@drawable/ttlive_ic_withdraw_default_avatar"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="3dp"
        android:layout_marginStart="8dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAsCircle="true"/>
    <com.bytedance.android.livesdk.widget.FlowLayout
        android:id="@+id/tags_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="20dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ttlive_avatar_view"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_std_text_white_1"
        android:ellipsize="end"
        android:gravity="top"
        android:id="@+id/text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="0dp"
        android:textIsSelectable="false"
        android:textAlignment="viewStart"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tags_layout"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/biz_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_view">
        <LinearLayout
            android:gravity="start|top"
            android:orientation="horizontal"
            android:id="@+id/poi_container"
            android:paddingBottom="3dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="6dp">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/poi_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginTop="1.5dp"
                android:scaleType="fitCenter"
                app:actualImageResource="@drawable/ttlive_room_intro_poi_icon"
                app:actualImageScaleType="fitCenter"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ttlive_room_intro_poi_text_color"
                android:id="@+id/poi_address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:layout_weight="1"/>
        </LinearLayout>
        <View
            android:id="@+id/divider"
            android:background="@color/ttlive_room_intro_divider_color"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/appointment_container"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <ImageView
                android:id="@+id/appointment_icon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ttlive_room_intro_announce_icon"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ttlive_room_intro_poi_text_color"
                android:ellipsize="end"
                android:id="@+id/appointment_time_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:text="每周五 20:0dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd直播"
                android:maxLines="1"
                android:includeFontPadding="false"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/subscribe_button"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/appointment_icon"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/subscribe_button"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:src="@drawable/ttlive_room_intro_unsubscribed_icon"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/appointment_time_text"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/local_life_poi_container"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="10dp">
            <ImageView
                android:id="@+id/local_life_poi_icon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginTop="2.5dp"
                android:src="@drawable/ttlive_room_intro_local_life_poi_icon"
                android:scaleType="fitCenter"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/ttlive_room_intro_local_life_poi_text_color"
                android:id="@+id/local_life_poi_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:text="直播地点：北京市|味多美面包坊（紫金店）"
                android:includeFontPadding="false"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/local_life_poi_icon"
                app:layout_constraintTop_toTopOf="@+id/local_life_poi_icon"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/video_icon"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ttlive_room_intro_video_message_icon"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/biz_layout"
        app:layout_constraintVertical_bias="0"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_video_intro_message_text_color"
        android:ellipsize="end"
        android:id="@+id/video_text"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:textIsSelectable="false"
        android:textAlignment="viewStart"
        android:paddingStart="2dp"
        android:paddingEnd="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/video_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/video_icon"
        app:layout_constraintTop_toTopOf="@+id/video_icon"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_std_text_white_1"
        android:gravity="top"
        android:id="@+id/text_anchor"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_anchor_room_intro_desc"
        android:textIsSelectable="false"
        android:alpha="0.5"
        android:textAlignment="viewStart"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/video_icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
