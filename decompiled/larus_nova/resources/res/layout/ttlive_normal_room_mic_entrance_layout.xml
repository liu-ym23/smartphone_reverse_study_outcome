<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/show_list_entrance_normal"
    android:background="@drawable/ttlive_bg_round_item_new"
    android:layout_width="wrap_content"
    android:layout_height="22dp">
    <FrameLayout
        android:id="@+id/show_list_bg_container"
        android:layout_width="62dp"
        android:layout_height="match_parent">
        <View
            android:background="@drawable/ttlive_mic_room_show_list_entrance_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/count_down_text_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/count_down_text_normal"
            android:layout_width="100dp"
            android:layout_height="22dp"
            android:maxLines="1"/>
    </FrameLayout>
</LinearLayout>
