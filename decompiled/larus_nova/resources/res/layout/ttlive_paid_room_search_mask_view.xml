<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/group_watch_end_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/blur_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/blur_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/group_temp_watch_end"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="15dp"
            android:textColor="#ffffffff"
            android:layout_gravity="center_horizontal"
            android:id="@+id/search_mask_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_live_paid_live_temp_watch_end"
            android:lineSpacingExtra="2dp"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#ffffffff"
            android:layout_gravity="center_horizontal"
            android:id="@+id/btn_buy_ticket_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/ttlive_live_paid_live_buy_ticket_tip"
            android:lineSpacingExtra="2dp"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/btn_buy_ticket"
            android:background="@drawable/ttlive_bg_pay_perform_buy_ticket"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="16dp"
            android:text="@string/ttlive_live_paid_live_go_buy_ticket"
            android:lineSpacingExtra="2dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/group_delivery_notice"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.bytedance.lighten.loader.SmartImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/lav_live_playing"
                android:padding="3dp"
                android:layout_width="20dp"
                android:layout_height="20dp"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#ffffffff"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:text="@string/ttlive_live_paid_live_delivery"
                android:lineSpacingExtra="2dp"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
        <TextView
            android:textSize="13dp"
            android:textColor="#ffffffff"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/ttlive_live_paid_live_has_buy_ticket"
            android:lineSpacingExtra="2dp"/>
    </LinearLayout>
    <TextView
        android:textSize="15dp"
        android:textColor="#ffffffff"
        android:id="@+id/debug_paid_status_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:lineSpacingExtra="2dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
