<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_200"
    android:layout_marginLeft="?attr/larus_dp_12"
    android:layout_marginRight="?attr/larus_dp_12"
    android:foreground="@drawable/larus_dora_dynamic_list_item_foreground_mask"
    app:cardBackgroundColor="@color/larus_base_3"
    app:cardCornerRadius="?attr/larus_dp_8"
    app:cardElevation="0dp">
    <com.facebook.drawee.view.SimpleDraweeView
        android:layout_gravity="end"
        android:id="@+id/image_cover"
        android:layout_width="?attr/larus_dp_358"
        android:layout_height="?attr/larus_dp_200"
        app:actualImageScaleType="centerCrop"
        app:placeholderImage="@color/larus_base_3"/>
    <LinearLayout
        android:layout_gravity="top"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_20"
        android:layout_marginTop="?attr/larus_dp_20"
        android:layout_marginBottom="?attr/larus_dp_10">
        <TextView
            android:textSize="?attr/larus_dp_24"
            android:textStyle="bold"
            android:textColor="@color/neutral_100"
            android:ellipsize="end"
            android:id="@+id/tv_device_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="?attr/larus_dp_160"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="@color/neutral_70"
            android:ellipsize="end"
            android:id="@+id/tv_device_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_2"
            android:maxWidth="?attr/larus_dp_160"
            android:maxLines="4"
            android:includeFontPadding="false"
            android:alpha="0.5"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
