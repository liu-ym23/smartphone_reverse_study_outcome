<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/extract_package_progress"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/file_icon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="126dp"
        app:srcCompat="@drawable/ud_icon_file_zip_colorful"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/text_title"
        android:id="@+id/extract_package_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/Lark_IMPreviewCompress_Decompressing_Toast"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_caption"
        android:id="@+id/extract_package_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/extract_progress_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <com.larksuite.component.universe_design.progress.UDProgress
            android:layout_gravity="center_vertical"
            android:id="@+id/extract_progress"
            android:layout_width="210dp"
            android:layout_height="wrap_content"
            android:progress="50"
            app:ud_progress_indicatorColor="@color/primary_fill_default"
            app:ud_progress_indicatorCornerRadius="2dp"
            app:ud_progress_thickness="4dp"
            app:ud_progress_trackColor="@color/udtoken_progress_bg"
            app:ud_progress_type="linear"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_placeholder"
            android:id="@+id/extract_progress_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/extract_package_tip_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="38dp">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="3dp"
            app:srcCompat="@drawable/ud_icon_succeed_colorful"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_caption"
            android:id="@+id/extract_package_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="224dp"
            android:text="@string/Lark_IMPreviewCompress_PreviewOnlyFileTypeLessG_Mobile_Toast"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
