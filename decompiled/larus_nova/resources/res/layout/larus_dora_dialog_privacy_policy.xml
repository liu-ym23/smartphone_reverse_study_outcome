<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.common_ui.widget.roundlayout.RoundConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/container"
        android:paddingBottom="?attr/larus_dp_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:rv_backgroundColor="@color/larus_base_1"
        app:rv_cornerRadius_TL="?attr/larus_dp_16"
        app:rv_cornerRadius_TR="?attr/larus_dp_16">
        <ImageView
            android:id="@+id/dora_privacy_close_btn"
            android:layout_width="?attr/larus_dp_28"
            android:layout_height="?attr/larus_dp_28"
            android:layout_marginTop="?attr/larus_dp_14"
            android:src="@drawable/larus_dora_onboarding_close_btn"
            android:layout_marginEnd="?attr/larus_dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/dora_privacy_title"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_56"
            android:text="@string/larus_dora_broadcast_access_declare_cn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.larus.common_ui.widget.UrlSpanTextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="@color/larus_neutral_70"
            android:id="@+id/dora_privacy_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/larus_dp_24"
            android:layout_marginTop="?attr/larus_dp_9"
            android:layout_marginRight="?attr/larus_dp_24"
            android:minHeight="?attr/larus_dp_60"
            android:lineSpacingMultiplier="1.2"
            app:larus_linkColor="@color/larus_neutral_100"
            app:larus_linkUnderLine="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dora_privacy_title"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/dora_privacy_agree_btn"
            android:background="@drawable/larus_dora_btn_primary_bg"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginLeft="?attr/larus_dp_24"
            android:layout_marginTop="?attr/larus_dp_40"
            android:layout_marginRight="?attr/larus_dp_24"
            android:text="@string/larus_dora_broadcast_access_declare_button_cn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dora_privacy_content"
            app:layout_constraintWidth_max="?attr/larus_dp_420"/>
    </com.larus.common_ui.widget.roundlayout.RoundConstraintLayout>
</FrameLayout>
