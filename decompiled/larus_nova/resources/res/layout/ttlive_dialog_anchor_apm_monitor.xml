<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_view"
    android:background="@drawable/ttlive_anchor_apm_record_dialog_bg"
    android:paddingLeft="16dp"
    android:paddingTop="14dp"
    android:paddingRight="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="460dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/old_title_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp">
        <TextView
            android:textSize="17dp"
            android:textColor="@color/ttlive_color_161823"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="性能状态"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/exit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ttlive_ic_apm_dialog_exit"/>
    </LinearLayout>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/ttlive_dialog_main_text"
        android:gravity="center"
        android:id="@+id/new_title_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="-14dp"
        android:layout_marginBottom="15dp"
        android:text="性能状态"
        android:includeFontPadding="false"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp">
        <ImageView
            android:id="@+id/ic_net"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/ttlive_ic_net_good_detail"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_color_161823"
            android:id="@+id/tv_net"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Wi-Fi/移动网络良好"
            android:layout_toRightOf="@+id/ic_net"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_color_99_161823"
            android:id="@+id/tv_net_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="建议不要频繁切换网络"
            android:layout_toRightOf="@+id/ic_net"
            android:layout_below="@+id/tv_net"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/ic_temp"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/ttlive_ic_temp_regular_detail"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_color_161823"
            android:id="@+id/tv_temp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="设备温度正常"
            android:layout_toRightOf="@+id/ic_temp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_color_99_161823"
            android:id="@+id/tv_temp_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="建议适时检查，保障流畅开播"
            android:layout_toRightOf="@+id/ic_temp"
            android:layout_below="@+id/tv_temp"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_mic"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp">
        <ImageView
            android:id="@+id/ic_mic"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/ttlive_ic_mic_regular_detail"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_color_161823"
            android:id="@+id/tv_mic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="音频状态正常"
            android:layout_toRightOf="@+id/ic_mic"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_color_99_161823"
            android:id="@+id/tv_mic_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="适当的音量可以保障观众观看体验"
            android:layout_toRightOf="@+id/ic_mic"
            android:layout_below="@+id/tv_mic"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ll_bar"
        android:paddingLeft="20dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginTop="18dp">
        <com.bytedance.android.live.effect.base.AdjustPercentBar
            android:id="@+id/bar"
            android:layout_width="238dp"
            android:layout_height="28dp"
            app:ttlive_effect_bar_padding="16dp"
            app:ttlive_effect_sliderRadius="8dp"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_color_80_161823"
            android:id="@+id/index"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_records"
        android:background="@drawable/ttlive_anchor_apm_record_bg"
        android:paddingLeft="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="20dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="12dp">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/ttlive_color_161823"
            android:gravity="center_vertical"
            android:id="@+id/tv_record_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="本场问题记录"
            android:drawableRight="@drawable/ttlive_text_arrow_right"
            android:drawablePadding="4dp"/>
        <ListView
            android:scrollbarSize="0dp"
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:listSelector="@color/transparent"
            android:divider="@null"
            android:dividerHeight="4dp"/>
    </LinearLayout>
</LinearLayout>
