<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_room_prompt_dialog"
    android:layout_width="@dimen/ttlive_room_center_prompt_dialog_width"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/top_image_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.android.livesdk.chatroom.ui.LiveRoundImageView
            android:id="@+id/top_image"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            custom:ttlive_radius_top_left="@dimen/ttlive_room_center_prompt_dialog_radius"
            custom:ttlive_radius_top_right="@dimen/ttlive_room_center_prompt_dialog_radius"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/top_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:scaleType="centerInside"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true"
            custom:placeholderImage="@drawable/ttlive_ic_hs_room_center_dialog_close"
            custom:placeholderImageScaleType="centerCrop"/>
    </RelativeLayout>
    <TextView
        android:textAppearance="@style/ttlive_room_center_prompt_dialog_title_text"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/room_center_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ttlive_room_center_prompt_dialog_title_margin_top"
        android:includeFontPadding="false"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <TextView
        android:textAppearance="@style/ttlive_room_center_prompt_dialog_content_text"
        android:layout_gravity="center_horizontal"
        android:id="@+id/room_center_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ttlive_room_center_prompt_dialog_content_margin_top"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <View
        android:id="@+id/live_dialog_divider_1"
        android:layout_marginTop="@dimen/ttlive_room_center_prompt_dialog_divider_margin_top"
        style="@style/ttlive_live_room_center_prompt_dialog_divider"/>
    <Button
        android:textAppearance="@style/ttlive_room_center_prompt_dialog_button_text"
        android:textColor="@color/ttlive_room_center_prompt_dialog_button_text_color"
        android:id="@+id/room_center_button"
        android:background="@drawable/ttlive_bg_room_center_prompt_btn"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ttlive_room_center_prompt_dialog_button_height"/>
    <include
        android:id="@+id/room_center_button_layout"
        layout="@layout/ttlive_dialog_room_center_prompt_two_btn_layout"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_room_center_bottom_tip"
        android:gravity="center"
        android:id="@+id/room_center_bottom_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:drawableLeft="@drawable/ttlive_ic_illegal_warning"
        android:drawablePadding="8dp"
        android:lineSpacingExtra="2dp"
        android:drawableStart="@drawable/ttlive_ic_illegal_warning"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
</LinearLayout>
