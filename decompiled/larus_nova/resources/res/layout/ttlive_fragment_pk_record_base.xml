    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.revlink.impl.pk.dialog.fragment.InteractPkRecordView
        android:id="@+id/pk_record_page"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.live.revlink.impl.pk.dialog.fragment.InteractPkReserveView
        android:id="@+id/pk_reserve_page"
