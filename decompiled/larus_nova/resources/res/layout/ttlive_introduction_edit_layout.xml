<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ttlive_edit_introduction_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/exit_introduction_edit_btn"
            android:background="@drawable/ttlive_exit_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="16dp"
            android:contentDescription="@string/ttlive_live_play_close"
            android:layout_marginStart="16dp"/>
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_douyin_dark_BGPrimary2"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_create_paid_live"
            android:layout_weight="1"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_core_s24"
            android:layout_gravity="center_vertical"
            android:id="@+id/finish_introduction_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:text="@string/ttlive_finish_hint_text"
            android:layout_marginEnd="12dp"/>
    </LinearLayout>
    <TextView
        android:background="#1f161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <FrameLayout
        android:background="@color/ttlive_core_bg_common"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp">
                <TextView
                    android:textSize="15dp"
                    android:textStyle="bold"
                    android:textColor="@color/ttlive_douyin_dark_BGPrimary2"
                    android:layout_gravity="start|center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:text="@string/ttlive_paid_live_introduction"
                    android:layout_marginStart="16dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/add_pic"
                    android:background="@drawable/ttlive_bg_dark_05"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginEnd="16dp">
                    <ImageView
                        android:background="@drawable/ttlive_add_pic_icon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginLeft="9dp"
                        android:layout_marginRight="3dp"
                        android:layout_marginStart="9dp"
                        android:layout_marginEnd="3dp"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/ttlive_douyin_dark_BGPrimary2"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="6dp"
                        android:text="@string/ttlive_add_pic"
                        android:layout_marginEnd="6dp"/>
                </LinearLayout>
            </FrameLayout>
            <EditText
                android:textSize="13dp"
                android:textColor="#bf161823"
                android:gravity="top"
                android:id="@+id/introduction_edit"
                android:background="@color/white"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxHeight="400dp"
                android:lineSpacingExtra="3dp"
                android:inputType="none"
                android:textCursorDrawable="@drawable/ttlive_introduction_edit_curcor_drawable"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
