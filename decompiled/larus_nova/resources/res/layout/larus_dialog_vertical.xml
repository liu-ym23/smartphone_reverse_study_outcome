<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/larus_bg_round_full"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:gravity="center"
        android:id="@+id/dialog_top_image"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_25"/>
    <TextView
        android:textSize="?attr/larus_dp_18"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_24"
        android:text="@string/larus_search_chat_card_header"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_20"
        android:layout_marginEnd="?attr/larus_dp_20"/>
    <TextView
        android:textSize="?attr/larus_dp_15"
        android:textColor="@color/larus_neutral_70"
        android:gravity="center_horizontal"
        android:id="@+id/dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_20"
        android:layout_marginEnd="?attr/larus_dp_20"/>
    <View
        android:background="@drawable/larus_item_divider"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0_5"
        android:layout_marginTop="?attr/larus_dp_24"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="?attr/larus_dp_16"
            android:textColor="@color/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/confirm"
            android:background="@drawable/larus_bg_rightdown_selector"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="授权并复制反馈ID"
            android:fontFamily="sans-serif-medium"/>
        <View
            android:id="@+id/divider"
            android:background="@drawable/larus_item_divider"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_0_5"/>
        <TextView
            android:textSize="?attr/larus_dp_16"
            android:textColor="@color/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/cancel"
            android:background="@drawable/larus_bg_leftdown_selector"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/larus_bot_profile_pic_crop_cancel"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</LinearLayout>
