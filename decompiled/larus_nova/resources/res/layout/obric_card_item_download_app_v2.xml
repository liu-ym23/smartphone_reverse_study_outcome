<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/dp_16"
    android:paddingTop="@dimen/dp_18"
    android:paddingRight="@dimen/dp_16"
    android:paddingBottom="@dimen/dp_18"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/download_app_v2_icon"
        android:layout_width="@dimen/dp_36"
        android:layout_height="@dimen/dp_36"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/download_app_v2_text"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="@dimen/dp_10"/>
    <TextView
        android:textSize="@dimen/dp_16"
        android:textColor="@color/neutral_100"
        android:ellipsize="end"
        android:id="@+id/download_app_v2_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp_12"
        app:layout_constraintBottom_toTopOf="@+id/download_app_v2_size"
        app:layout_constraintEnd_toStartOf="@+id/download_app_v2_button"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/download_app_v2_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="@dimen/dp_12"
        android:textColor="@color/oui_basic_text_3"
        android:ellipsize="end"
        android:id="@+id/download_app_v2_size"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_2"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/download_app_v2_text"
        app:layout_constraintStart_toEndOf="@+id/download_app_v2_icon"
        app:layout_constraintTop_toBottomOf="@+id/download_app_v2_text"/>
    <com.obric.oui.button.OButton
        android:gravity="center"
        android:id="@+id/download_app_v2_button"
        android:layout_width="@dimen/dp_68"
        android:layout_height="@dimen/dp_32"
        android:text="@string/obric_card_open_app"
        android:layout_marginStart="@dimen/dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/download_app_v2_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/download_app_v2_text"
        app:layout_constraintTop_toTopOf="@+id/download_app_v2_icon"
        style="@style/OStyleV2.OButton.S.Standard.Primary_Light"/>
</androidx.constraintlayout.widget.ConstraintLayout>
