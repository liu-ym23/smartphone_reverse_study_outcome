<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gallery_root_container"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.shopping.widget.ecvideoplayer.ECVideoView
        android:id="@+id/ec_gallery_video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="66dp"/>
    <TextView
        android:textSize="24sp"
        android:textColor="@android:color/white"
        android:id="@+id/gallery_tv_media_progress"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toTopOf="@+id/pb_media_progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_media_duration"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="24sp"
        android:textColor="@color/shopping_color_80FFFFFF"
        android:id="@+id/gallery_tv_media_duration"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tv_media_progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_media_progress"
        app:layout_constraintTop_toTopOf="@+id/tv_media_progress"/>
    <ImageView
        android:id="@+id/gallery_ec_play_iv"
        android:background="@drawable/commerce_ic_play_block_play"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="73dp"
        android:alpha="0.5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <SeekBar
        android:id="@+id/gallery_pb_media_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="42dp"
        android:maxHeight="3dp"
        android:progressDrawable="@drawable/commerce_comment_gallery_media_progress_bar"
        android:thumb="@drawable/commerce_comment_gallery_media_progress_thumb"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@android:style/Widget.ProgressBar.Horizontal"/>
    <com.bytedance.android.ec.core.widget.ECStatusView
        android:id="@+id/gallery_loading_status_view"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
