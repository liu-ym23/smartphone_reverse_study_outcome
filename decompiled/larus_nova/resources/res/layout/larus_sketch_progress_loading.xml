<?xml version="1.0" encoding="utf-8"?>
<com.larus.bmhome.chat.layout.holder.progressloading.RadiusCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Theme.MaterialComponents"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:larus_rcv_bottomLeftRadius="?attr/larus_dp_8"
    app:larus_rcv_bottomRightRadius="?attr/larus_dp_8"
    app:larus_rcv_topLeftRadius="?attr/larus_dp_8"
    app:larus_rcv_topRightRadius="?attr/larus_dp_8">
    <com.larus.bmhome.chat.layout.holder.progressloading.ImageWebpLoadingBgView
        android:id="@+id/loading_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.lynx.lottieadapter.LottieAdapterView
            android:layout_gravity="center_horizontal"
            android:id="@+id/progress_icon"
            android:layout_width="?attr/larus_dp_40"
            android:layout_height="?attr/larus_dp_40"
            android:scaleType="centerInside"/>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/generating_progress"
            android:paddingLeft="?attr/larus_dp_8"
            android:paddingRight="?attr/larus_dp_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_4"/>
        <TextView
            android:textSize="?attr/larus_dp_12"
            android:textColor="@color/static_white_transparent_3"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/description"
            android:paddingLeft="?attr/larus_dp_8"
            android:paddingRight="?attr/larus_dp_8"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_4"
            android:maxLines="1"/>
    </LinearLayout>
</com.larus.bmhome.chat.layout.holder.progressloading.RadiusCardView>
