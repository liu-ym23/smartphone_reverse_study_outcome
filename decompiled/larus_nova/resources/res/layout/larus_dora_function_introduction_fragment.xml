<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/function_introduction_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/larus_dora_function_introduction_fragment_gradient"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/function_introduction_list_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_32"
        android:layout_marginRight="?attr/larus_dp_32"
        android:layout_marginBottom="?attr/larus_dp_22"
        app:layout_constraintBottom_toTopOf="@+id/function_try_button">
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_dp_24"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/function_introduction_title"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_36"
            android:layout_marginBottom="?attr/larus_dp_8"/>
    </LinearLayout>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/function_try_button"
        android:background="@drawable/larus_item_dora_connect_status"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginLeft="?attr/larus_dp_32"
        android:layout_marginRight="?attr/larus_dp_32"
        android:layout_marginBottom="?attr/larus_dp_20"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <ImageView
        android:id="@+id/function_introduction_nav_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        android:src="@drawable/larus_dora_function_introduction_nav_back"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
