<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/header_card_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.shopping.mall.homepage.card.headercard.toolarea.ToolRecyclerView
        android:id="@+id/rcv_tool_list"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="8dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentStart="true"/>
    <com.bytedance.android.shopping.mall.homepage.card.headercard.widget.RVIndicator
        android:id="@+id/fl_tool_list_indicator"
        android:layout_width="25dp"
        android:layout_height="2dp"
        android:layout_marginBottom="5dp"
        android:layout_alignBottom="@+id/rcv_tool_list"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/rcv_head_channel"
        android:background="@color/shopping_home_color_F5F6F9"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rcv_tool_list"
        android:layout_centerHorizontal="true"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcv_channel"
        android:background="@color/shopping_home_color_F5F6F9"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rcv_head_channel"
        android:layout_centerHorizontal="true"/>
    <View
        android:id="@+id/view_channel_skin"
        android:background="@drawable/shopping_homepage_headercard_channel_skin"
        android:layout_width="match_parent"
        android:layout_height="31dp"
        android:layout_alignTop="@+id/rcv_head_channel"
        android:importantForAccessibility="no"
        android:layout_alignStart="@+id/rcv_head_channel"
        android:layout_alignEnd="@+id/rcv_channel"/>
</RelativeLayout>
