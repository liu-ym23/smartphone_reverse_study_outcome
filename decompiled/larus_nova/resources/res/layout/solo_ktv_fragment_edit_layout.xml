<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/solo_ktv_edit_fragment_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="13dp"
        android:textColor="@color/white"
        android:id="@+id/voice_volume_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:text="@string/ttlive_ktv_voice_volume"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.widget.SeekBarWithProgress
        android:id="@+id/voice_volume_seek_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/voice_volume_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/voice_volume_title"
        app:layout_constraintTop_toTopOf="@+id/voice_volume_title"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#ffffff"
        android:id="@+id/music_volume_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="28dp"
        android:text="@string/ttlive_ktv_music_volume"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voice_volume_title"/>
    <com.bytedance.android.livesdk.widget.SeekBarWithProgress
        android:id="@+id/music_volume_seek_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/music_volume_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/music_volume_title"
        app:layout_constraintTop_toTopOf="@+id/music_volume_title"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#ffffff"
        android:id="@+id/voice_align_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="28dp"
        android:text="@string/ttlive_solo_ktv_voice_align"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/music_volume_title"/>
    <View
        android:id="@+id/voice_advance_btn"
        android:background="@drawable/solo_ktv_edit_voice_advance_icon"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:layout_marginLeft="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/voice_align_title"
        app:layout_constraintEnd_toStartOf="@+id/voice_align_seek_bar"
        app:layout_constraintStart_toEndOf="@+id/voice_align_title"
        app:layout_constraintTop_toTopOf="@+id/voice_align_title"/>
    <com.bytedance.android.live.soloktv.view.SoloKtvAlignVoiceView
        android:id="@+id/voice_align_seek_bar"
        android:layout_width="0dp"
        android:layout_height="21dp"
        android:layout_marginLeft="7dp"
        android:layout_marginRight="7dp"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        app:alignColor="#fe2c55"
        app:alignPointerSize="21dp"
        app:bgColor="#29ffffff"
        app:bgSize="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/voice_align_title"
        app:layout_constraintEnd_toStartOf="@+id/voice_delay_btn"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/voice_advance_btn"
        app:layout_constraintTop_toTopOf="@+id/voice_align_title"
        app:middlePointerSize="6dp"
        app:pointerColor="#ffffff"/>
    <View
        android:id="@+id/voice_delay_btn"
        android:background="@drawable/solo_ktv_edit_voice_delay_icon"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:layout_marginRight="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/voice_align_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/voice_align_seek_bar"
        app:layout_constraintTop_toTopOf="@+id/voice_align_title"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#80ffffff"
        android:id="@+id/tv_voice_align_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="人声已延迟26毫秒"
        app:layout_constraintLeft_toLeftOf="@+id/voice_align_seek_bar"
        app:layout_constraintRight_toRightOf="@+id/voice_align_seek_bar"
        app:layout_constraintTop_toBottomOf="@+id/voice_align_seek_bar"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tuning_effect_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="13dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="13dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_voice_align_desc"/>
    <FrameLayout
        android:gravity="center"
        android:id="@+id/loading_tuning_effect_view_container"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:layout_marginLeft="13dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="13dp"
        android:layout_marginStart="13dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_voice_align_desc">
        <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
            android:layout_gravity="center"
            android:id="@+id/loading_tuning_effect_view"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/save_draft_btn"
        android:background="@drawable/solo_ktv_edit_save_draft_bg"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="3.5dp"
        android:layout_marginBottom="18dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="3.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/center_guide_line"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/center_guide_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/loading_tuning_effect_view_container">
        <View
            android:id="@+id/save_draft_iv"
            android:background="@drawable/solo_ktv_edit_save_draft_ic"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/save_draft_tv"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/save_draft_tv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/black"
            android:id="@+id/save_draft_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="@string/ttlive_solo_ktv_save_to_draft"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/save_draft_iv"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintStart_toEndOf="@+id/save_draft_iv"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/center_guide_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/publish_btn"
        android:background="@drawable/solo_ktv_edit_publish_bg"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginLeft="3.5dp"
        android:layout_marginTop="27dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="18dp"
        android:layout_marginStart="3.5dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/center_guide_line"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="@+id/center_guide_line"
        app:layout_constraintTop_toBottomOf="@+id/loading_tuning_effect_view_container">
        <View
            android:id="@+id/publish_iv"
            android:background="@drawable/solo_ktv_edit_publish_ic"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/publish_tv"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/publish_tv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/white"
            android:id="@+id/publish_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="@string/ttlive_solo_ktv_publish"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/publish_iv"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintStart_toEndOf="@+id/publish_iv"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
