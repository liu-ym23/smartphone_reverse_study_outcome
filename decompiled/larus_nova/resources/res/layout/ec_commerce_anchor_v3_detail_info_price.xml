<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ec.core.widget.AutoResizePriceContainer xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_commerce_anchor_v3_detail_info_price_694307771"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/Primary"
        android:id="@+id/price_header"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="2dp"
        android:layout_alignBaseline="@+id/normal_text_min_price"
        android:layout_marginEnd="2dp"/>
    <com.bytedance.android.shopping.widget.PriceView
        android:id="@+id/normal_text_min_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/price_header"
        app:extraTextColor="@color/Primary"
        app:extraTextSize="13sp"
        app:prefixSpaceSize="2dp"
        app:prefixTextSize="13sp"
        app:priceBold="true"
        app:priceDecimalTextSize="16sp"
        app:priceTextColor="@color/Primary"
        app:priceTextSize="24sp"
        app:spaceSize="1sp"
        app:thinDecimal="true"
        app:yangTextSize="16sp"/>
    <TextView
        android:textColor="@color/Primary"
        android:id="@+id/normal_text_price_space"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="—"
        android:includeFontPadding="false"
        android:layout_toRightOf="@+id/normal_text_min_price"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/normal_text_min_price"
        style="@style/font_size_34"/>
    <com.bytedance.android.shopping.widget.PriceView
        android:id="@+id/normal_text_market_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginBottom="2dp"
        android:layout_toRightOf="@+id/normal_text_min_price"
        android:layout_alignBottom="@+id/normal_text_min_price"
        android:layout_marginStart="8dp"
        android:layout_toEndOf="@+id/normal_text_min_price"
        app:extraTextColor="@color/commerce_color_57161823"
        app:extraTextSize="12sp"
        app:prefixSpaceSize="2dp"
        app:priceTextColor="@color/commerce_color_57161823"
        app:priceTextSize="12sp"
        app:showDeleteLine="true"
        app:spaceSize="1dp"
        app:yangTextSize="12sp"/>
    <include
        android:id="@+id/container_discount_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_toRightOf="@+id/normal_text_min_price"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/normal_text_min_price"
        layout="@layout/ec_commerce_anchor_v3_discount_price"/>
</com.bytedance.android.ec.core.widget.AutoResizePriceContainer>
