<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.revlink.impl.pk.ui.PKListItemShadowView
        android:id="@+id/sv_show_wait_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cornerRadius="4dp"
        app:dy="0dp"
        app:shadowColor="#40b4bdc8"
        app:shadowLimit="10dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_show_wait_time"
            android:background="@drawable/ttlive_bg_random_view_emoji_no_followed"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="116dp"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="6dp"
            android:layout_marginBottom="2dp"
            android:elevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="12dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="15sp"
                    android:textColor="#161823"
                    android:id="@+id/tv_random_main_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_multi_team_pk_random_match_default_title"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#80161823"
                    android:id="@+id/tv_sub_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/ttlive_multi_team_pk_random_match_default_sub_title"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_random_main_title"/>
                <View
                    android:id="@+id/divider"
                    android:background="#33161823"
                    android:layout_width="0.5dp"
                    android:layout_height="10dp"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="5dp"
                    app:layout_constraintLeft_toRightOf="@+id/tv_sub_title"
                    app:layout_constraintTop_toBottomOf="@+id/tv_random_main_title"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#80161823"
                    android:id="@+id/tv_wait_sec_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="3dp"
                    android:text="@string/ttlive_live_pk_random_view_wait_sec_left"
                    android:layout_marginStart="5dp"
                    app:layout_constraintLeft_toRightOf="@+id/divider"
                    app:layout_constraintTop_toBottomOf="@+id/tv_random_main_title"/>
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/ttlive_pk_random_view_text_color"
                    android:id="@+id/tv_wait_sec_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3dp"
                    android:layout_marginTop="22dp"
                    android:text="@string/ttlive_live_pk_random_view_default_wait_sec"
                    android:layout_marginStart="3dp"
                    app:layout_constraintLeft_toRightOf="@+id/tv_wait_sec_left"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#80161823"
                    android:id="@+id/tv_wait_sec_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3dp"
                    android:layout_marginTop="3dp"
                    android:text="@string/ttlive_live_pk_random_view_wait_sec_right"
                    android:layout_marginStart="3dp"
                    app:layout_constraintLeft_toRightOf="@+id/tv_wait_sec_title"
                    app:layout_constraintTop_toBottomOf="@+id/tv_random_main_title"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_show_wait_time_random"
                android:background="@drawable/ttlive_bg_live_red_btn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:layout_marginBottom="12dp"
                android:text="@string/ttlive_multi_team_pk_random_match_btn"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.bytedance.android.live.revlink.impl.pk.ui.PKListItemShadowView>
</androidx.constraintlayout.widget.ConstraintLayout>
