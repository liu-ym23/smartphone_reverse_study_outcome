<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vote_decrease"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:tint="@color/colorful_red"
        android:layout_marginStart="17dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ud_icon_no_filled"/>
    <com.suite.lark.emm.design.edittext.SCEditText
        android:textSize="16dp"
        android:textColor="@color/text_title"
        android:textColorHint="@color/text_placeholder"
        android:layout_gravity="center_vertical"
        android:id="@+id/et_vote_option"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:hint="@string/Lark_IM_Poll_CreatePoll_Options_Placeholder"
        android:singleLine="true"
        android:layout_marginStart="13dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/vote_decrease"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/item_line"
        android:background="@color/line_divider_default"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginStart="13dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/vote_decrease"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
