<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_memory_event_item"
    android:paddingTop="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="?attr/larus_dp_12"
    android:paddingStart="?attr/larus_dp_16"
    android:paddingEnd="?attr/larus_dp_16">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/larus_dora_photo_icon"/>
    <TextView
        android:textSize="?attr/larus_sp_16"
        android:textColor="@color/neutral_100"
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_dora_album_album_cn"
        android:layout_marginStart="?attr/larus_dp_6"
        app:layout_constraintBottom_toBottomOf="@+id/icon"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="@+id/icon"/>
    <TextView
        android:textSize="?attr/larus_dp_12"
        android:textColor="@color/neutral_50"
        android:id="@+id/action_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_dora_g_device_more_option_cn"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/icon"
        app:layout_constraintEnd_toStartOf="@+id/action_icon"
        app:layout_constraintTop_toTopOf="@+id/icon"/>
    <ImageView
        android:id="@+id/action_icon"
        android:layout_width="12dp"
        android:layout_height="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/action_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/action_text"
        app:srcCompat="@drawable/larus_dora_action_icon"/>
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/album_sync_banner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon"
        app:layout_goneMarginBottom="16dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/images_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_64"
            android:layout_marginTop="?attr/larus_dp_16">
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="?attr/larus_dp_4">
                <com.larus.bmhome.chat.plugin.image4.view.ImageViewWithLastMotion
                    android:id="@+id/image_1"
                    android:background="@drawable/larus_dora_bg_image_card"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:actualImageScaleType="centerCrop"
                    app:placeholderImage="@drawable/larus_dora_photo_place"
                    app:placeholderImageScaleType="centerCrop"/>
                <TextView
                    android:textSize="?attr/larus_sp_13"
                    android:textStyle="bold"
                    android:textColor="@color/static_white"
                    android:layout_gravity="end|bottom"
                    android:id="@+id/duration_1"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="?attr/larus_dp_6"
                    android:layout_marginEnd="9.5dp"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="?attr/larus_dp_4">
                <com.larus.bmhome.chat.plugin.image4.view.ImageViewWithLastMotion
                    android:id="@+id/image_2"
                    android:background="@drawable/larus_dora_bg_image_card"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:actualImageScaleType="centerCrop"
                    app:placeholderImage="@drawable/larus_dora_photo_place"
                    app:placeholderImageScaleType="centerCrop"/>
                <TextView
                    android:textSize="?attr/larus_sp_13"
                    android:textStyle="bold"
                    android:textColor="@color/static_white"
                    android:layout_gravity="end|bottom"
                    android:id="@+id/duration_2"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="?attr/larus_dp_6"
                    android:layout_marginEnd="9.5dp"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="?attr/larus_dp_4">
                <com.larus.bmhome.chat.plugin.image4.view.ImageViewWithLastMotion
                    android:id="@+id/image_3"
                    android:background="@drawable/larus_dora_bg_image_card"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:actualImageScaleType="centerCrop"
                    app:placeholderImage="@drawable/larus_dora_photo_place"
                    app:placeholderImageScaleType="centerCrop"/>
                <TextView
                    android:textSize="?attr/larus_sp_13"
                    android:textStyle="bold"
                    android:textColor="@color/static_white"
                    android:layout_gravity="end|bottom"
                    android:id="@+id/duration_3"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="?attr/larus_dp_6"
                    android:layout_marginEnd="9.5dp"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="?attr/larus_dp_4">
                <com.larus.bmhome.chat.plugin.image4.view.ImageViewWithLastMotion
                    android:id="@+id/image_4"
                    android:background="@drawable/larus_dora_bg_image_card"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:actualImageScaleType="centerCrop"
                    app:placeholderImage="@drawable/larus_dora_photo_place"
                    app:placeholderImageScaleType="centerCrop"/>
                <TextView
                    android:textSize="?attr/larus_sp_13"
                    android:textStyle="bold"
                    android:textColor="@color/static_white"
                    android:layout_gravity="end|bottom"
                    android:id="@+id/duration_4"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="?attr/larus_dp_6"
                    android:layout_marginEnd="9.5dp"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <com.larus.bmhome.chat.plugin.image4.view.ImageViewWithLastMotion
                    android:id="@+id/image_5"
                    android:background="@drawable/larus_dora_bg_image_card"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:actualImageScaleType="centerCrop"
                    app:placeholderImage="@drawable/larus_dora_photo_place"
                    app:placeholderImageScaleType="centerCrop"/>
                <TextView
                    android:textSize="?attr/larus_sp_13"
                    android:textStyle="bold"
                    android:textColor="@color/static_white"
                    android:layout_gravity="end|bottom"
                    android:id="@+id/duration_5"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="?attr/larus_dp_6"
                    android:layout_marginEnd="9.5dp"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/empty_state_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_20">
            <TextView
                android:textSize="?attr/larus_sp_16"
                android:textColor="@color/larus_neutral_50"
                android:id="@+id/empty_state_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_g_device_media_show_here_cn"/>
        </LinearLayout>
    </FrameLayout>
    <com.larus.avlink.gallery.view.AlbumSyncBanner
        android:id="@+id/album_sync_banner"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_0"
        android:layout_marginBottom="?attr/larus_dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
