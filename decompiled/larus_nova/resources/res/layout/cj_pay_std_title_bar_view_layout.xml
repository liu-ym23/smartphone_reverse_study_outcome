<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/std_title_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/title_bar_container"
        android:background="@color/cj_pay_color_trans"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_44">
        <com.android.ttcjpaysdk.base.framework.container.view.base.CJPayAnyView
            android:id="@+id/title_left_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cj_pay_padding_16"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <com.android.ttcjpaysdk.base.framework.container.view.base.CJPayAnyView
            android:id="@+id/title_center_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cj_pay_padding_16"
            android:layout_marginRight="@dimen/cj_pay_padding_16"
            android:layout_centerInParent="true"/>
        <com.android.ttcjpaysdk.base.framework.container.view.base.CJPayAnyView
            android:id="@+id/title_right_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/cj_pay_padding_16"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/title_bar_line"
        android:background="#1f161823"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_below="@+id/title_bar_container"/>
</RelativeLayout>
