<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="horizontal"
    android:id="@+id/new_profile_button_root"
    android:background="@drawable/ttlive_bg_profile_anchor_followed"
    android:layout_width="match_parent"
    android:layout_height="36dp">
    <ImageView
        android:gravity="center"
        android:id="@+id/new_profile_button_left"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ttlive_profile_set_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/new_profile_button_reddot"
        android:background="@drawable/ttlive_bg_profile_anchor_set_reddot_bg"
        android:visibility="gone"
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="5dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
