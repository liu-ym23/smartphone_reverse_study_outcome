<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_pay_payment_method_activity_view"
    android:background="@color/cj_pay_color_trans"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/cj_pay_payment_method_root_view"
        android:background="@drawable/cj_pay_bg_payment_method_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="557dp">
        <include
            android:id="@+id/cj_pay_payment_method_title_bar"
            layout="@layout/cj_pay_view_titlebar_noise_reduction_layout"/>
        <FrameLayout
            android:id="@+id/cj_pay_payment_method_desc_layout"
            android:background="@color/cj_pay_color_gray_0D161823"
            android:paddingLeft="16dp"
            android:paddingTop="12dp"
            android:paddingRight="16dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/cj_pay_payment_method_title_bar">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cj_pay_color_gray_light"
                android:layout_gravity="center"
                android:id="@+id/cj_pay_payment_method_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <androidx.core.widget.NestedScrollView
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:layout_below="@+id/cj_pay_payment_method_desc_layout"
            android:overScrollMode="never">
            <LinearLayout
                android:orientation="vertical"
                android:descendantFocusability="blocksDescendants"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <FrameLayout
                    android:id="@+id/cj_pay_method_root_view_one"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="14dp"/>
                <FrameLayout
                    android:id="@+id/cj_pay_method_root_view_two"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="14dp"/>
                <FrameLayout
                    android:id="@+id/cj_pay_method_root_view_three"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="14dp"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="20dp"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <include
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/cj_pay_payment_method_title_bar"
            layout="@layout/cj_pay_view_half_screen_loading_layout"/>
        <include
            android:id="@+id/cj_pay_security_panel_loading_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/cj_pay_payment_method_title_bar"
            layout="@layout/cj_pay_view_security_panel_loading_container"/>
    </RelativeLayout>
</FrameLayout>
