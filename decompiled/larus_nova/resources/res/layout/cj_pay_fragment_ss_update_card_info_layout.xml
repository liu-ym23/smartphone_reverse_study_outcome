<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cj_pay_ss_update_card_info_root_view"
    android:background="@color/cj_pay_color_white"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.android.ttcjpaysdk.thirdparty.view.CJPayObservableStateScrollView
        android:id="@+id/cj_pay_ss_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <RelativeLayout
            android:id="@+id/cj_pay_ss_content_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/cj_pay_titlebar_root_view"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_alignParentTop="true"
                layout="@layout/cj_pay_view_standard_titlebar_layout"/>
            <TextView
                android:textSize="@dimen/cj_pay_font_size_24"
                android:textStyle="bold"
                android:textColor="@color/cj_pay_color_black_34"
                android:id="@+id/cj_pay_ss_update_card_info_tip"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:includeFontPadding="false"
                android:layout_below="@+id/cj_pay_titlebar_root_view"/>
            <TextView
                android:textSize="@dimen/cj_pay_font_size_13"
                android:textColor="@color/cj_pay_color_gray_153"
                android:id="@+id/cj_pay_ss_safety_hint"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false"
                android:layout_below="@+id/cj_pay_ss_update_card_info_tip"/>
            <TextView
                android:textSize="@dimen/cj_pay_font_size_13"
                android:textColor="@color/cj_pay_color_gray_202"
                android:id="@+id/cj_pay_ss_card_type_label"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="29dp"
                android:text="@string/cj_pay_ss_card_type"
                android:includeFontPadding="false"
                android:layout_below="@+id/cj_pay_ss_safety_hint"/>
            <TextView
                android:textSize="@dimen/cj_pay_font_size_16"
                android:textColor="@color/cj_pay_color_gray_202"
                android:id="@+id/cj_pay_ss_card_info"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:includeFontPadding="false"
                android:layout_below="@+id/cj_pay_ss_card_type_label"/>
            <View
                android:id="@+id/cj_pay_ss_divider"
                android:background="@color/cj_pay_color_gray_232"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="14dp"
                android:layout_marginRight="24dp"
                android:layout_below="@+id/cj_pay_ss_card_info"/>
            <include
                android:id="@+id/cj_pay_ss_reserved_mobile_container"
                android:layout_width="match_parent"
                android:layout_height="69dp"
                android:layout_marginLeft="24dp"
                android:layout_marginRight="24dp"
                android:layout_below="@+id/cj_pay_ss_divider"
                layout="@layout/cj_pay_item_basic_input_box"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/cj_pay_ss_agreement_container"
                android:paddingLeft="16dp"
                android:paddingRight="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/cj_pay_ss_reserved_mobile_container">
                <com.android.ttcjpaysdk.base.theme.widget.CJPaySquareCheckBox
                    android:id="@+id/cj_pay_ss_agreement_checkbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"/>
                <TextView
                    android:textSize="@dimen/cj_pay_font_size_13"
                    android:textColor="@color/cj_pay_color_gray_153"
                    android:id="@+id/cj_pay_ss_agreement_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:includeFontPadding="true"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
            <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
                android:textSize="@dimen/cj_pay_font_size_15"
                android:textColor="@color/cj_pay_color_white"
                android:gravity="center"
                android:id="@+id/cj_pay_ss_next_btn"
                android:background="@drawable/cj_pay_bg_red_btn_opacity_40"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cj_pay_custom_button_height_44"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="32dp"
                android:layout_marginRight="24dp"
                android:text="@string/cj_pay_ss_pay_continue"
                android:layout_below="@+id/cj_pay_ss_agreement_container"/>
            <ProgressBar
                android:id="@+id/cj_pay_ss_next_btn_loading"
                android:background="@color/cj_pay_color_trans"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="46dp"
                android:indeterminateOnly="true"
                android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_white"
                android:indeterminateDuration="500"
                android:indeterminateBehavior="repeat"
                android:layout_below="@+id/cj_pay_ss_agreement_container"
                android:layout_centerHorizontal="true"/>
            <View
                android:id="@+id/cj_pay_ss_fake_keyboard_placeholder"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="380dp"
                android:layout_below="@+id/cj_pay_ss_agreement_container"/>
        </RelativeLayout>
    </com.android.ttcjpaysdk.thirdparty.view.CJPayObservableStateScrollView>
    <com.android.ttcjpaysdk.base.ui.widget.CJPayKeyboardView
        android:layout_gravity="bottom"
        android:id="@+id/cj_pay_ss_keyboard_view"
        android:visibility="gone"
        android:keepScreenOn="true"
        style="@style/CJ_Pay_Keyboard"/>
</FrameLayout>
