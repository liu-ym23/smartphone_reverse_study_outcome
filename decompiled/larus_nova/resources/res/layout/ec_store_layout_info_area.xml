<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/ec_store_info_area"
    android:visibility="visible"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:visibility="gone"
        android:clipChildren="true"
        android:layout_width="wrap_content"
        android:layout_height="40sp"
        layout="@layout/ec_shop_head_logo"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/ec_store_info_area_desc_wrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="8dp"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ec_store_info_area_name_wrapper"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.bytedance.android.shopping.store.home.view.ECShopMarqueeTextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/shopping_std_text_black_1"
                android:id="@+id/ec_store_info_area_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                app:ec_scroll_adapt_width="1"
                app:ec_scroll_auto_mode="hand"
                app:ec_scroll_delay="2000"
                app:ec_scroll_max_loop="3"
                app:ec_scroll_mode="persistent"
                app:ec_scroll_time_interval="3000"
                app:ec_scroll_velocity="3"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/ec_store_info_area_brand_tag"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="12sp"
                android:layout_marginLeft="4dp"
                android:layout_marginStart="4dp"/>
            <ImageView
                android:id="@+id/ec_store_info_area_arrow"
                android:layout_width="12sp"
                android:layout_height="12sp"
                android:layout_marginLeft="4dp"
                android:src="@drawable/ec_store_ic_round_right_arrow"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <com.bytedance.android.shopping.store.home.view.ECStoreReputationViewNew
            android:id="@+id/ec_store_info_area_reputation_new"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>
        <com.bytedance.android.ec.store.view.ECTagListView
            android:id="@+id/ec_store_info_short_tag_list"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/ec_store_info_area_follow_wrapper"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:id="@+id/ec_store_info_area_follow"
            android:visibility="visible"
            android:layout_width="58sp"
            android:layout_height="24sp">
            <ImageView
                android:id="@+id/ec_store_info_area_follow_icon"
                android:layout_width="12sp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="-1dp"
                android:src="@drawable/ec_store_follow_icon"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/shopping_std_brand"
                android:id="@+id/ec_store_info_area_follow_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0.5dp"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <FrameLayout
            android:gravity="center"
            android:id="@+id/ec_store_info_area_fans_group"
            android:visibility="gone"
            android:layout_width="58sp"
            android:layout_height="24sp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ec_store_info_area_fans_group_icon"
                android:layout_width="26sp"
                android:layout_height="18sp"
                android:src="@drawable/ec_store_info_join_fans_group_image"/>
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/shopping_std_text_white_1"
                android:layout_gravity="center"
                android:id="@+id/ec_store_info_area_fans_group_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
        </FrameLayout>
        <com.bytedance.android.shopping.store.home.view.FollowGiftBubbleView
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/shopping_color_161823"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="end|top"
            android:id="@+id/ec_store_info_area_follow_gift_bubble"
            android:background="@drawable/ec_store_bg_follow_gift_bubble_pink"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-13dp"
            android:lines="1"
            android:includeFontPadding="false"/>
    </FrameLayout>
</LinearLayout>
