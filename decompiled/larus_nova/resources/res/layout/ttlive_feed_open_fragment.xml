<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/ttlive_feed_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.livesdk.feed.ui.FeedTitleBar
        android:id="@+id/feed_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:layout_alignParentTop="true"/>
    <View
        android:id="@+id/feed_divider"
        android:background="@color/ttlive_feed_open_d2_66"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_below="@+id/feed_title_bar"/>
    <FrameLayout
        android:id="@+id/list_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/feed_divider">
        <com.bytedance.android.livesdk.feed.BannerSwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <FrameLayout
                    android:id="@+id/follow_view_container"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.bytedance.android.livesdk.feed.squarefeed.ui.InterceptTouchLayout
                    android:id="@+id/interceptor_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/list"
                        android:background="@color/ttlive_feed_bg"
                        android:scrollbars="none"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:overScrollMode="never"/>
                </com.bytedance.android.livesdk.feed.squarefeed.ui.InterceptTouchLayout>
            </RelativeLayout>
        </com.bytedance.android.livesdk.feed.BannerSwipeRefreshLayout>
        <TextView
            android:textColor="@color/ttlive_white"
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_follow_user_count"
            android:background="@drawable/ttlive_bg_follow_user_count"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="35dp"
            android:drawableRight="@drawable/ttlive_feed_ic_down_arror"
            android:drawablePadding="2dp"/>
    </FrameLayout>
</RelativeLayout>
