<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="90dp"
    android:layout_height="90dp"
    android:layout_marginBottom="1dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center"
        android:id="@+id/guest_bg"
        android:background="@drawable/ttlive_preview_video_talkroom_window_empty_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="15dp">
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/guest_avatar"
                android:background="@drawable/ttlive_img_avatar_empty"
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:placeholderImage="@drawable/ttlive_img_avatar_empty"
                app:roundAsCircle="true"/>
            <View
                android:layout_gravity="center_horizontal"
                android:id="@+id/guest_silence_icon"
                android:background="@drawable/ttlive_ic_small_silence"
                android:visibility="gone"
                android:layout_width="56dp"
                android:layout_height="56dp"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/radio_effect_bg"
                android:background="@drawable/ttlive_radio_effect_bg"
                android:visibility="gone"
                android:layout_width="56dp"
                android:layout_height="56dp"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/radio_effect"
                android:visibility="gone"
                android:layout_width="18dp"
                android:layout_height="10dp"
                android:layout_marginBottom="3dp"/>
        </FrameLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:layout_gravity="center_horizontal"
            android:id="@+id/guest_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:singleLine="true"
            android:maxLength="8"/>
    </LinearLayout>
</FrameLayout>
