<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_interact_dialog"
    android:layout_width="match_parent"
    android:layout_height="350dp">
    <TextView
        android:textSize="17dp"
        android:textColor="#161823"
        android:id="@+id/tv_inter_com_main_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/ttlive_inter_comment_main_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/comment_intro"
        android:padding="16dp"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:src="@drawable/ttlive_intercom_intro"
        app:layout_constraintBottom_toBottomOf="@+id/tv_inter_com_main_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_inter_com_main_title"/>
    <View
        android:id="@+id/divider"
        android:background="#1a161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_inter_com_main_title"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#80000000"
        android:id="@+id/tv_inter_com_sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ttlive_inter_comment_sub_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_inter_comment"
        android:layout_width="343dp"
        android:layout_height="92dp"
        android:layout_marginTop="44dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_inter_com_sub_title"
        app:placeholderImageScaleType="fitXY"/>
    <Button
        android:textSize="14dp"
        android:textColor="@color/white"
        android:id="@+id/bt_invite"
        android:background="@drawable/ttlive_bg_pk_cancel"
        android:layout_width="343dp"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:text="@string/ttlive_inter_comment_invite"
        android:height="44dp"
        android:layout_weight="1"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_inter_comment"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_ban_dialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="18dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bt_invite">
        <RadioButton
            android:id="@+id/ban_dialog_radio"
            android:background="@drawable/ttlive_bg_newuser_pk_radio"
            android:visibility="visible"
            android:clickable="false"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="1dp"
            android:checked="false"
            android:button="@null"/>
        <TextView
            android:textColor="#80000000"
            android:id="@+id/tv_ban_dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="@string/ttlive_inter_comment_ban_dialog"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
