<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#99000000"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:ttlive_allRadius="8dp">
    <FrameLayout
        android:layout_width="144dp"
        android:layout_height="100dp">
        <View
            android:layout_gravity="top|right"
            android:id="@+id/ttlive_game_dialog_loading_close"
            android:background="@drawable/uicomponent_ic_close"
            android:layout_width="20dp"
            android:layout_height="20dp"/>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <TextView
                android:textSize="12dp"
                android:textColor="#ffffff"
                android:layout_gravity="center"
                android:id="@+id/ttlive_game_dialog_loading_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.bytedance.android.livesdk.widget.CircleProgressView
                android:id="@+id/ttlive_game_dialog_loading_progress_ring"
                android:layout_width="40dp"
                android:layout_height="40dp"/>
        </FrameLayout>
        <TextView
            android:textSize="13dp"
            android:textColor="#e6ffffff"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/ttlive_live_start_live_resource_still_loading_message"/>
    </FrameLayout>
</com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout>
