<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larksuite.component.universe_design.shadow.UDShadowLayout
        android:layout_gravity="end|bottom"
        android:id="@+id/submit_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:ud_shadow_radius="30dp"
        style="@style/UDShadow.S3.Down.Pri">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/submit_record"
            android:background="@drawable/bitable_page_submit_record_bg"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginBottom="26dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginEnd="16dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/submit_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:tint="@color/static_white"
                app:srcCompat="@drawable/ud_icon_done_outlined"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/static_white"
                android:gravity="center"
                android:id="@+id/submit_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="32dp"
                android:text="@string/Bitable_QuickAdd_Submit_Button"
                android:maxLines="1"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </com.larksuite.component.universe_design.shadow.UDShadowLayout>
</merge>
