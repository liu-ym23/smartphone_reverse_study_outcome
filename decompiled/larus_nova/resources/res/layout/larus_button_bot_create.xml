<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="?attr/larus_bg_creat_bot_button"
    android:paddingTop="?attr/larus_dp_17"
    android:paddingBottom="?attr/larus_dp_17"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="?attr/larus_dp_24"
    android:paddingEnd="?attr/larus_dp_24">
    <ImageView
        android:id="@+id/image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/larus_ic_bot_create"/>
    <TextView
        android:textSize="?attr/larus_dp_16"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:id="@+id/button_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_6"/>
</LinearLayout>
