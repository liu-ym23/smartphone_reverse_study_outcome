<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/team_fight_container"
    android:visibility="gone"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/iv_top_bg"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.333"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <FrameLayout
        android:id="@+id/voice_team_fight_container_old"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:translationY="-12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_top_bg">
        <com.bytedance.android.live.liveinteract.revenue.fight.view.TeamFightTitleLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/team_fight_title_layout"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginTop="0dp"/>
        <com.bytedance.android.live.liveinteract.revenue.fight.view.TeamFightPKProgressLayout
            android:id="@+id/team_fight_progressbar"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ttlive_team_fight_progress_layout_height"
            android:layout_marginTop="-4dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
