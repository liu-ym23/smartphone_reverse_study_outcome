<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.widgets.universedesign.SpaceShadowLayout
        android:layout_gravity="top"
        android:orientation="vertical"
        android:id="@+id/search_top_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/UDShadow.S2.Down">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/search_titlebar"
            android:background="@color/bg_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="0dp"
            android:layout_marginTop="0dp"
            android:layout_marginRight="0dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:id="@+id/search_box"
                    android:background="@drawable/bitable_search_edit_bg"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp">
                    <com.bytedance.ee.bear.widgets.universedesign.SpaceEditText
                        android:gravity="center_vertical"
                        android:id="@+id/search_et"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:hint="@string/Bitable_Search_PleaseEnterKeyword"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:layout_weight="1"
                        android:imeOptions="flagNoExtractUi|flagNoFullscreen|actionSearch"
                        android:layout_marginStart="12dp"
                        app:ud_editText_iconHeight="@dimen/space_kit_len_16"
                        app:ud_editText_iconWidth="@dimen/space_kit_len_16"
                        app:ud_editText_leftIcon="@drawable/ud_icon_search_outlined"
                        app:ud_editText_leftIconTint="@color/icon_n3"
                        style="@style/UDEditText"/>
                    <com.bytedance.ee.bear.bitable.uikit.simpleitem.SearchConfigIcon
                        android:id="@+id/search_config"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/primary_content_default"
                    android:gravity="center"
                    android:id="@+id/search_done"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:text="@string/Bitable_Common_ButtonCancel"
                    android:layout_marginEnd="16dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/search_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="14dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:id="@+id/search_desc_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/text_caption"
                    android:id="@+id/search_desc_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </com.bytedance.ee.bear.widgets.universedesign.SpaceShadowLayout>
    <com.bytedance.ee.bear.bitable.common.TouchDetectFrameLayout
        android:id="@+id/rest_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
