<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/archive_header_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginRight="@dimen/dp_16">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="16sp"
            android:layout_height="16sp"
            app:srcCompat="@drawable/ud_icon_massage_box_out_outlined"
            app:tint="@color/icon_n2"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/text_title"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_8"
            android:layout_marginTop="@dimen/dp_4"
            android:layout_marginRight="@dimen/dp_8"
            android:layout_marginBottom="@dimen/dp_4"
            android:text="@string/Todo_TaskList_Archived_BotTitle"
            android:maxLines="2"
            android:layout_weight="1"/>
        <com.larksuite.component.universe_design.button.UDButton
            android:textSize="@dimen/sp_14"
            android:textColor="@color/text_title"
            android:gravity="center_vertical"
            android:id="@+id/archive_cancel_button"
            android:paddingLeft="8dp"
            android:paddingTop="8dp"
            android:paddingRight="8dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Todo_TaskList_Restore_Button"
            app:ud_backgroundColor="@color/ud_button_white_grey_bg"
            app:ud_radius="s"
            app:ud_strokeColor="@color/line_border_component"
            app:ud_strokeWidth="1dp"
            style="@style/UDButton.Default"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/todo_loading_container"
        android:background="@color/bg_base"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/todo_lottie_loading_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <com.airbnb.lottie.LottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/todo_lottie_loading_anim"
                android:layout_width="@dimen/dp_125"
                android:layout_height="@dimen/dp_125"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/loading_anim"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/text_caption"
                android:layout_gravity="center"
                android:id="@+id/text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Todo_DataLoadingNowPleaseWait_Text"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/todo_loading_error_ll"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <ImageView
                android:id="@+id/todo_error_iv"
                android:layout_width="@dimen/dp_125"
                android:layout_height="@dimen/dp_125"
                app:srcCompat="@drawable/illustration_placeholder_common_load_failed"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_caption"
                android:gravity="center"
                android:id="@+id/todo_error_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/Lark_Legacy_LoadFailedRetryTip"/>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/empty_container"
        android:background="@color/bg_base"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/img_empty"
                android:layout_width="@dimen/dp_125"
                android:layout_height="@dimen/dp_125"
                app:srcCompat="@drawable/illustration_empty_positive_complete"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/text_title"
                android:id="@+id/tv_empty_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:text="@string/Todo_NoTasks_EmptyStateText"
                android:layout_below="@+id/img_empty"/>
        </LinearLayout>
    </RelativeLayout>
    <com.larksuite.component.ui.layout.LKUIRoundLinearLayout
        android:id="@+id/todo_list_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/dp_12"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginRight="@dimen/dp_16"
        app:rl_radius_left_top="@dimen/dp_10"
        app:rl_radius_right_top="@dimen/dp_10">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.ss.android.lark.widget.recyclerview.CommonRecyclerView
                android:id="@+id/todo_new_center_list"
                android:background="@color/bg_base"
                android:paddingBottom="@dimen/dp_16"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        </RelativeLayout>
    </com.larksuite.component.ui.layout.LKUIRoundLinearLayout>
</LinearLayout>
