<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/turntable_bubble_tip"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ec_color_white"
        android:gravity="start"
        android:id="@+id/tv_content"
        android:background="@drawable/ec_shortcut_guide_bg"
        android:padding="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ec_shortcut_guide_text"
        android:includeFontPadding="false"
        android:lineSpacingExtra="0sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_anchor"/>
    <ImageView
        android:id="@+id/iv_anchor"
        android:layout_width="16dp"
        android:layout_height="6dp"
        android:layout_marginRight="12dp"
        android:src="@drawable/ec_ic_tip_arrow"
        android:rotation="180"
        android:layout_marginEnd="12dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
