<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_store_top_bar_mini_info_container"
    android:visibility="invisible"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/ec_shop_head_logo_wrapper"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="center"
            android:id="@+id/ec_store_head_logo_border"
            android:layout_width="32sp"
            android:layout_height="32sp"
            app:placeholderImage="@color/transparent"
            app:roundedCornerRadius="8sp"
            app:roundingBorderColor="#0d161823"
            app:roundingBorderWidth="0.5dp"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="center"
            android:id="@+id/ec_shop_head_logo"
            android:padding="1dp"
            android:layout_width="32sp"
            android:layout_height="32sp"
            app:backgroundImage="@color/white"
            app:roundedCornerRadius="6sp"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="center"
            android:id="@+id/ec_shop_head_logo_living_border"
            android:layout_width="38sp"
            android:layout_height="38sp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/ec_store_info_area_follow_container"
        android:paddingLeft="6sp"
        android:paddingTop="5sp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14sp"
        android:layout_marginTop="12sp"
        app:layout_constraintLeft_toLeftOf="@+id/ec_shop_head_logo_wrapper"
        app:layout_constraintTop_toTopOf="@+id/ec_shop_head_logo_wrapper">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/ec_store_info_area_follow_lottieAnimationView"
            android:visibility="visible"
            android:layout_width="18sp"
            android:layout_height="18sp"
            android:translationZ="50dp"
            android:elevation="0dp"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ec_store_info_area_name_wrapper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/ec_shop_head_logo_wrapper"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.shopping.store.home.view.ECShopMarqueeTextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#e6161823"
            android:id="@+id/ec_store_info_area_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"
            app:ec_scroll_adapt_width="1"
            app:ec_scroll_auto_mode="hand"
            app:ec_scroll_delay="2000"
            app:ec_scroll_max_loop="3"
            app:ec_scroll_mode="persistent"
            app:ec_scroll_time_interval="3000"
            app:ec_scroll_velocity="3"/>
        <com.bytedance.android.ec.store.view.ECTagListView
            android:id="@+id/ec_store_info_top_tag_list"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
