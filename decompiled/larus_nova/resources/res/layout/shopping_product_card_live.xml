<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.bytedance.android.ec.store.view.ECLiveCircleView
            android:layout_gravity="center"
            android:id="@+id/live_circle"
            android:padding="1dp"
            android:layout_width="19dp"
            android:layout_height="19dp"
            app:live_strokeWidth="1dp"/>
        <com.bytedance.android.ec.core.widget.CircleImageView
            android:layout_gravity="center"
            android:id="@+id/live_avatar"
            android:layout_width="13dp"
            android:layout_height="13dp"/>
        <ImageView
            android:layout_gravity="bottom|right"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/shopping_inflow_live_head_breath"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp">
        <TextView
            android:textSize="13sp"
            android:textColor="#fe496a"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/live_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:maxLines="1"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/live_status"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="13sp"
            android:layout_gravity="center_vertical"
            android:id="@+id/live_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/live_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
