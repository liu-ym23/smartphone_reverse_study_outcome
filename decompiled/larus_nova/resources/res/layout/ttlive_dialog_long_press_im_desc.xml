<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/avatar_container"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginRight="12dp"
        android:layout_marginEnd="16dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:roundAsCircle="true"/>
        <ImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/view_active"
            android:padding="3dp"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginRight="-3dp"
            android:layout_marginBottom="-3dp"
            android:layout_marginEnd="-3dp"/>
    </FrameLayout>
    <TextView
        android:textSize="17dp"
        android:textColor="#ff161823"
        android:ellipsize="end"
        android:id="@+id/desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_weight="1"/>
    <FrameLayout
        android:layout_gravity="end|center_vertical"
        android:id="@+id/im_button_area"
        android:layout_width="92dp"
        android:layout_height="match_parent">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/ttlive_white"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/im_button_text"
            android:background="@drawable/ttlive_bg_long_press_im_btn"
            android:layout_width="64dp"
            android:layout_height="28dp"
            android:layout_marginLeft="12dp"
            android:text="@string/ttlive_share"
            android:layout_marginStart="12dp"/>
    </FrameLayout>
</merge>
