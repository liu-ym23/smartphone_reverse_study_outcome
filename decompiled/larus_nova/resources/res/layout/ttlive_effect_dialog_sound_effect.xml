<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sound_effect_fragment_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/view_outside"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/sound_effect_area"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/audition_area"
        android:background="@drawable/ttlive_effect_bg_audition_area"
        android:visibility="gone"
        android:layout_width="130dp"
        android:layout_height="110dp"
        android:layout_marginBottom="165dp"
        app:layout_constraintBottom_toTopOf="@+id/sound_effect_area"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.bytedance.android.live.effect.soundeffect.AudioWaveView
            android:textColor="#e5ffffff"
            android:gravity="center"
            android:id="@+id/audioWaveView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:text="@string/ttlive_effect_live_sound_effect_audition"
            app:layout_constraintBottom_toTopOf="@+id/tv_audition_tip"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#e5ffffff"
            android:gravity="center"
            android:id="@+id/tv_audition_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="@string/ttlive_effect_live_sound_effect_audition"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sound_effect_area"
        android:background="@drawable/ttlive_effect_bg_sticker_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <View
            android:id="@+id/sound_effect_background_view"
            android:layout_width="0dp"
            android:layout_height="191dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/ttlive_std_text_white_1"
            android:id="@+id/tv_sound_effect_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="18dp"
            android:text="@string/ttlive_effect_live_sound_effect_title"
            android:layout_marginStart="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_sound_item"
            android:layout_width="match_parent"
            android:layout_height="135dp"
            android:layout_marginTop="22dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_sound_effect_tips"/>
        <com.bytedance.android.live.uikit.recyclerview.LoadingStatusView
            android:id="@+id/sound_effect_loading_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
