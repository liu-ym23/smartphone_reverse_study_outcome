<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/cj_pay_password_root_view"
    android:background="@drawable/cj_pay_bg_fragment_container_blackable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/cj_pay_verify_pwd_background_image"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/cj_pay_titlebar_root_view"
        android:background="?attr/cj_pay_bg_primary"
        app:layout_constraintBottom_toTopOf="@+id/cj_pay_pwd_order_info"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/cj_pay_view_titlebar_noise_reduction_layout"/>
    <TextView
        android:textSize="14dp"
        android:textColor="?attr/cj_pay_text_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/cj_pay_pwd_order_info"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_24"
        android:layout_marginRight="@dimen/cj_pay_padding_24"
        android:singleLine="true"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toTopOf="@+id/cj_pay_view_verify_amount_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_titlebar_root_view"/>
    <include
        android:id="@+id/cj_pay_view_verify_amount_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@+id/cj_pay_view_verify_discount_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_pwd_order_info"
        layout="@layout/cj_pay_view_verify_amount_layout"/>
    <include
        android:id="@+id/cj_unify_voucher_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4.5dp"
        android:minHeight="@dimen/cj_pay_padding_20"
        app:layout_constraintBottom_toTopOf="@+id/pay_type_helper_layout_divider_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_view_verify_amount_layout"
        layout="@layout/cj_pay_voucher_layout"/>
    <include
        android:id="@+id/cj_pay_view_verify_discount_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_view_verify_amount_layout"
        layout="@layout/cj_pay_view_verify_discount_layout"/>
    <com.android.ttcjpaysdk.thirdparty.verify.view.marketing.CJMarketingCountdownView
        android:id="@+id/cj_pay_marketing_countdown_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_view_verify_discount_layout"/>
    <View
        android:id="@+id/pay_type_helper_layout_divider_line"
        android:background="?attr/cj_pay_border_divider_grey_color"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_marketing_countdown_view"
        app:layout_goneMarginTop="24dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/pay_type_helper_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pay_type_helper_layout_divider_line"
        app:layout_goneMarginTop="16dp">
        <include
            android:id="@+id/cj_pay_view_pay_type_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            layout="@layout/cj_pay_view_pay_type_layout"/>
        <include
            android:id="@+id/cj_pay_view_verify_combine_info_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            layout="@layout/cj_pay_view_verify_combine_info_layout"/>
        <include
            android:id="@+id/cj_pay_view_pay_type_combine_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            layout="@layout/cj_pay_view_pay_type_combine_layout"/>
    </LinearLayout>
    <com.android.ttcjpaysdk.thirdparty.verify.view.RecommendView
        android:id="@+id/cj_pay_view_pay_type_recommend"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_font_size_16"
        android:layout_marginTop="@dimen/cj_pay_padding_4"
        android:layout_marginRight="@dimen/cj_pay_font_size_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pay_type_helper_layout"/>
    <View
        android:id="@+id/cj_pay_bankcard_point_place_holder"
        android:background="#00000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_view_pay_type_recommend"/>
    <com.android.ttcjpaysdk.base.ui.component.input.CJPwdInputLayout
        android:id="@+id/cj_pay_layout_pwd_input_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@+id/cj_pay_keyboard_divider_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_bankcard_point_place_holder"/>
    <include
        android:id="@+id/cj_pay_tips_above_pwd"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="@dimen/cj_pay_padding_4"
        android:layout_marginRight="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_bankcard_point_place_holder"
        layout="@layout/cj_pay_view_tips_above_pwd"/>
    <com.android.ttcjpaysdk.base.ui.component.input.PwdEditTextNoiseReduction
        android:id="@+id/cj_pay_pwd_view"
        android:background="?attr/cj_pay_bg_primary"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_centerHorizontal="true"
        app:CJPayDotColor="?attr/cj_pay_text_primary"
        app:CJPayDotRadius="6dp"
        app:CJPayPwdCount="6"
        app:CJPayPwdEditShapeStyle="CJPayRoundRectangle"
        app:CJPayStrokeColor="?attr/cj_pay_pwd_input_stroke_color"
        app:CJPayStrokeRadius="4dp"
        app:CJPayStrokeWidth="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_tips_above_pwd"
        app:layout_goneMarginTop="24dp"/>
    <View
        android:id="@+id/cj_pay_line"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_weight="1"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_pwd_view"/>
    <TextView
        android:textSize="12sp"
        android:textColor="?attr/cj_pay_text_tertiary"
        android:id="@+id/cj_pay_forget_password_view"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp"
        android:text="@string/cj_pay_forget_password"
        app:layout_constraintBottom_toTopOf="@+id/cj_pay_keyboard_divider_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_pwd_view"/>
    <View
        android:id="@+id/cj_pay_change_pwd_begin_helper"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_bankcard_point_place_holder"/>
    <include
        android:id="@+id/cj_pay_change_pwd_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/cj_pay_change_pwd_end_helper"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_change_pwd_begin_helper"
        layout="@layout/cj_pay_view_change_pwd_layout"/>
    <View
        android:id="@+id/cj_pay_change_pwd_end_helper"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@+id/cj_pay_keyboard_divider_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <include
        android:id="@+id/cj_pay_pre_bio_guide_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/cj_pay_keyboard_divider_view"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_line"
        layout="@layout/cj_pay_view_pre_bio_guide_layout"/>
    <include
        android:id="@+id/cj_pay_nopwd_guide_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/cj_pay_keyboard_divider_view"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_line"
        layout="@layout/cj_pay_view_pre_no_pwd_guide_layout"/>
    <com.android.ttcjpaysdk.base.ui.component.agreement.CJRowSwitchText
        android:id="@+id/cj_pay_bank_card_points_open"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:CJRowSwitchChecked="false"
        app:CJRowSwitchContent=""
        app:CJRowSwitchContentSize="12sp"
        app:layout_constraintBottom_toTopOf="@+id/cj_pay_keyboard_divider_view"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_line"/>
    <View
        android:id="@+id/cj_pay_keyboard_divider_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toTopOf="@+id/cj_pay_new_keyboard_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.android.ttcjpaysdk.base.ui.widget.NewTalkbackKeyboardView
        android:id="@+id/cj_pay_new_keyboard_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:keepScreenOn="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_goneMarginTop="24dp"/>
    <com.android.ttcjpaysdk.base.ui.component.keyboard.CJNumKeyboardView
        android:id="@+id/cj_pay_view_num_keyboard"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:keepScreenOn="true"
        app:CJNumKeyboardStyle="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_goneMarginTop="24dp"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp"
        layout="@layout/cj_pay_view_half_screen_loading_layout"/>
    <include
        android:id="@+id/cj_pay_security_panel_loading_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_marketing_countdown_view"
        layout="@layout/cj_pay_view_security_panel_loading_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
