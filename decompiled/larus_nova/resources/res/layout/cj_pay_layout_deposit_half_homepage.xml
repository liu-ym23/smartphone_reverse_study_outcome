<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_pay_deposit_homepage_layout"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/cj_background_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"/>
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/cj_pay_deposit_homepage_container"
        android:background="@drawable/cj_pay_bg_fragment_container"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="504dp">
        <com.android.ttcjpaysdk.base.theme.widget.CJPayFlexibleRoundCornerImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/cj_pay_bg_light_brand_low_opacity"
            android:scaleType="centerCrop"
            app:CJPayCorners="CJPay_TOP_RIGHT|CJPay_TOP_LEFT"
            app:CJPayCornersRadius="20dp"/>
        <RelativeLayout
            android:id="@+id/cj_top_navigation_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <ImageView
                android:id="@+id/cj_nav_close_button"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/cj_pay_icon_titlebar_left_round_close"
                android:layout_marginStart="12dp"/>
            <ImageView
                android:id="@+id/cj_nav_logo"
                android:layout_width="85dp"
                android:layout_height="18dp"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/page_scroll_view"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="72dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:fillViewport="true"
            android:layout_above="@+id/ll_sign_bottom_content"
            android:overScrollMode="never">
            <include layout="@layout/cj_pay_deposit_core_info_layout"/>
        </androidx.core.widget.NestedScrollView>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_sign_bottom_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">
            <include layout="@layout/cj_pay_layout_voucher_label_section"/>
            <com.android.ttcjpaysdk.base.ui.widget.LoadingButton
                android:gravity="center"
                android:id="@+id/cj_deposit_confirm_btn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cj_pay_custom_button_height_44"
                app:btnTextColor="@color/cj_pay_color_white"
                app:btnTextSize="15sp"
                app:loadingHeight="20dp"
                app:loadingWidth="20dp"/>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
