<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:id="@+id/filter_common_root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="28dp"
    android:layout_marginTop="13dp"
    android:layout_marginBottom="13dp">
    <com.ss.android.ugc.aweme.search.filter.view.good.ECSearchFilterCornerBg
        android:id="@+id/filter_common_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/filter_common_content_root"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/filter_common_icon_left"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="2dp"
            android:scaleType="fitXY"
            android:layout_marginEnd="2dp"/>
        <com.ss.android.ugc.aweme.search.filter.view.ui.NoPaddingTextView
            android:textSize="14sp"
            android:id="@+id/filter_header_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="16dp"
            android:includeFontPadding="false"/>
        <com.ss.android.ugc.aweme.search.filter.view.ui.NoPaddingTextView
            android:textSize="14sp"
            android:id="@+id/filter_common_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="16dp"
            android:includeFontPadding="false"/>
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/filter_common_icon_right"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="2dp"
            android:scaleType="fitXY"
            android:layout_marginStart="2dp"/>
        <com.ss.android.ugc.aweme.search.filter.view.ui.NoPaddingTextView
            android:textSize="14sp"
            android:id="@+id/filter_common_text_tail"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:minHeight="16dp"
            android:includeFontPadding="false"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
</FrameLayout>
