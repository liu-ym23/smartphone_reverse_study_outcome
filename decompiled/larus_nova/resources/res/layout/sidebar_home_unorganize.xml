<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.scwang.smartrefresh.layout.SmartRefreshLayout
        android:id="@+id/list_refresh_layout"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:srlEnableLoadMore="false"
        app:srlEnableOverScrollBounce="false"
        app:srlEnableOverScrollDrag="false"
        app:srlEnablePreviewInEditMode="true"
        app:srlEnableRefresh="true">
        <com.bytedance.ee.bear.facade.common.widget.recyclerview.DigitDanceHeader
            android:id="@+id/list_refresh_header"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_kit_len_60"/>
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/list_home_coordinator_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/list_sub_menu_layout"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_behavior="com.bytedance.ee.bear.list.homepage.FlingBehavior">
                <com.google.android.material.appbar.CollapsingToolbarLayout
                    android:id="@+id/list_collapsing_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/space_kit_len_60"
                    app:layout_scrollFlags="enterAlwaysCollapsed|enterAlways|scroll">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.bytedance.ee.bear.facade.common.widget.recyclerview.DigitDanceHeader
                            android:id="@+id/list_appbar_refresh_header"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/space_kit_len_60"/>
                        <com.bytedance.ee.bear.facade.common.widget.recyclerview.CircleRefreshHeader
                            android:id="@+id/list_appbar_refresh_lean_header"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/space_kit_len_60"/>
                        <com.bytedance.ee.bear.facade.common.widget.NoNetworkView
                            android:id="@+id/no_net_container"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <FrameLayout
                            android:id="@+id/list_notification_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </com.google.android.material.appbar.CollapsingToolbarLayout>
                <com.bytedance.ee.bear.list.homepage.title.SubMenuView
                    android:id="@+id/home_sub_title_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.appbar.AppBarLayout>
            <fragment
                android:name="com.bytedance.ee.bear.list.sidebar.unorganize.SidebarUnorganizeFragment"
                android:id="@+id/list_home_sub_fragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="com.bytedance.ee.bear.list.homepage.KeepWithinParentBoundsScrollingBehavior"/>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </com.scwang.smartrefresh.layout.SmartRefreshLayout>
</FrameLayout>
