<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ec_commerce_layout_anchor_v4_head_view_924588378"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="top"
        android:id="@+id/ec_commerce_layout_anchor_v4_head_view_2091512013"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/anchor_v4_slides_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/anchor_v4_indicator_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>
        <ImageView
            android:layout_gravity="end|top"
            android:id="@+id/back_click_area"
            android:padding="4dp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/commerce_anchor_v4_back_cross"
            android:contentDescription="@null"/>
        <LinearLayout
            android:gravity="end"
            android:layout_gravity="end|top"
            android:orientation="vertical"
            android:id="@+id/float_button_elements"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"/>
    </FrameLayout>
    <com.bytedance.android.shopping.anchorv4.voavhs.headbottom.AnchorV4HeadBottomView
        android:id="@+id/head_bottom_view"
        android:layout_width="match_parent"
        android:layout_height="12dp"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/new_tab_indicator_container"
        android:background="#f6f6f9"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="32dp"/>
</LinearLayout>
