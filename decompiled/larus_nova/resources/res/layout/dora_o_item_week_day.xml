<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="?attr/larus_dp_4"
    android:paddingBottom="?attr/larus_dp_4"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="?attr/larus_dp_0"
    android:layout_height="wrap_content"
    android:layout_weight="1">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/week_day_cell"
        android:layout_width="?attr/larus_dp_48"
        android:layout_height="?attr/larus_dp_48">
        <TextView
            android:textSize="?attr/larus_sp_16"
            android:textColor="@color/dora_o_text_primary"
            android:gravity="center"
            android:id="@+id/day_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="center"
            android:id="@+id/day_emoji"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"/>
    </FrameLayout>
</FrameLayout>
