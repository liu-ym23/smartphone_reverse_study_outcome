<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:id="@+id/cj_pay_payment_complete_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cj_pay_height_470">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/cj_pay_payment_complete_root_view"
        android:background="@drawable/cj_pay_bg_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_470">
        <include
            android:id="@+id/cj_pay_titlebar_root_view"
            layout="@layout/cj_pay_view_titlebar_noise_reduction_layout"/>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/cj_pay_status_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cj_pay_height_100">
            <FrameLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/cj_pay_status_icon_layout"
                android:layout_width="@dimen/cj_pay_height_60"
                android:layout_height="@dimen/cj_pay_height_60">
                <ImageView
                    android:id="@+id/cj_pay_status_icon"
                    android:layout_width="@dimen/cj_pay_height_60"
                    android:layout_height="@dimen/cj_pay_height_60"
                    android:scaleType="centerCrop"/>
            </FrameLayout>
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/cj_pay_status_text_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/cj_pay_padding_40"
                android:layout_marginTop="@dimen/cj_pay_padding_12"
                android:layout_marginRight="@dimen/cj_pay_padding_40">
                <TextView
                    android:textSize="20sp"
                    android:textColor="@color/cj_pay_color_black_34"
                    android:gravity="center"
                    android:id="@+id/cj_pay_status_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="24sp"
                    android:textColor="@color/cj_pay_color_black_34"
                    android:id="@+id/cj_pay_total_unit"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/cj_pay_padding_6"
                    android:text="@string/cj_pay_currency_unit"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="24sp"
                    android:textColor="@color/cj_pay_color_black_34"
                    android:id="@+id/cj_pay_total_value"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="920"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/cj_pay_color_gray_153"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/cj_pay_detail_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/cj_pay_padding_40"
                android:layout_marginTop="@dimen/cj_pay_padding_4"
                android:layout_marginRight="@dimen/cj_pay_padding_40"
                android:maxLines="3"
                android:includeFontPadding="false"/>
            <FrameLayout
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cj_pay_padding_20">
                <TextView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/cj_pay_status_button_shadow"
                    android:paddingLeft="@dimen/cj_pay_padding_4"
                    android:paddingRight="@dimen/cj_pay_padding_4"
                    android:paddingBottom="@dimen/cj_pay_padding_8"
                    android:visibility="gone"
                    android:layout_width="@dimen/cj_pay_height_168"
                    android:layout_height="@dimen/cj_pay_height_48"/>
                <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
                    android:textSize="16sp"
                    android:textColor="@color/cj_pay_color_white"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/cj_pay_status_button"
                    android:background="@drawable/cj_pay_base_bg_red_btn"
                    android:visibility="gone"
                    android:layout_width="@dimen/cj_pay_height_160"
                    android:layout_height="@dimen/cj_pay_height_40"
                    android:includeFontPadding="false"/>
            </FrameLayout>
        </LinearLayout>
        <include layout="@layout/cj_pay_view_integrated_half_screen_loading_layout"/>
    </LinearLayout>
    <include
        android:visibility="gone"
        layout="@layout/cj_pay_view_independent_loading_layout"/>
</FrameLayout>
