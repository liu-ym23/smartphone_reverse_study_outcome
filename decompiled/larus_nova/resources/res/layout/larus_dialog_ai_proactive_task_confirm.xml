<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_ai_proactive_edit_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17sp"
        android:textColor="@color/neutral_100"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/larus_dora_ai_active_task_confirm_title_cn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/slot_card"
        android:background="@drawable/larus_bg_ai_proactive_edit_input"
        android:padding="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">
        <com.larus.avlink.aiproactive.widget.AiProactiveTaskSlotLayout
            android:id="@+id/slot_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/neutral_50"
        android:id="@+id/tv_remind_method_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/larus_dora_ai_active_task_confirm_remind_type_title_cn"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/slot_card"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_remind_method_group"
        android:background="@drawable/larus_bg_ai_proactive_segment_container"
        android:padding="2dp"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_remind_method_title">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/tv_method_tts"
            android:background="@drawable/larus_bg_ai_proactive_segment_selected"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/larus_dora_ai_active_task_confirm_remind_type_voice_cn"
            android:drawablePadding="4dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/larus_icon_ai_proactive_speaker"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/larus_neutral_70"
            android:gravity="center"
            android:id="@+id/tv_method_sound"
            android:background="@android:color/transparent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/larus_dora_ai_active_task_confirm_remind_type_sound_cn"
            android:drawablePadding="4dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/larus_icon_ai_proactive_oic"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"/>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/neutral_100"
        android:gravity="center"
        android:id="@+id/tv_re_describe"
        android:background="@drawable/larus_bg_ai_proactive_edit_btn_cancel"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:text="@string/larus_dora_ai_active_task_confirm_rewrite_button_cn"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_confirm_add"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_remind_method_group"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/tv_confirm_add"
        android:background="@drawable/larus_bg_ai_proactive_edit_btn_confirm"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginBottom="16dp"
        android:text="确认添加"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_re_describe"/>
</androidx.constraintlayout.widget.ConstraintLayout>
