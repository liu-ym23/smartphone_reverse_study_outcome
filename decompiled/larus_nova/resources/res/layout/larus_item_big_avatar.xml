<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larus.common_ui.widget.CircleSimpleDraweeView
        android:id="@+id/onboarding"
        android:visibility="visible"
        android:layout_width="?attr/larus_dp_160"
        android:layout_height="?attr/larus_dp_160"
        android:src="@drawable/larus_common_ui_avatar_placeholder"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/larus_common_ui_avatar_placeholder"
        app:placeholderImageScaleType="centerCrop"/>
    <TextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/changeIcon"
        android:background="?attr/larus_bg_transparent_button"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_116"
        android:layout_height="?attr/larus_dp_40"
        android:layout_marginTop="?attr/larus_dp_12"
        android:text="@string/larus_change_app_avatar_onboarding_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/onboarding"/>
</androidx.constraintlayout.widget.ConstraintLayout>
