<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="1dp"
    android:layout_width="48dp"
    android:layout_height="48dp">
    <FrameLayout
        android:background="@drawable/ttlive_feed_bg_video_talkroom_empty"
        android:layout_width="48dp"
        android:layout_height="47dp">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/guest_avatar_empty"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/ttlive_feed_ic_video_talk_default"
            android:scaleType="fitCenter"/>
        <TextView
            android:textSize="6dp"
            android:textColor="@color/white"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/tv_empty_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/ttlive_video_talkroom_window_want_link"/>
    </FrameLayout>
</FrameLayout>
