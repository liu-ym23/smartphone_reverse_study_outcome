<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/immersive_voice_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/left_place_holder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/cancel_recording"
        app:layout_constraintEnd_toStartOf="@+id/cancel_recording"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_min="32dp"/>
    <com.ss.android.lark.keyboard.plugin.tool.voice.immersive.widget.VoiceCircleButton
        android:id="@+id/cancel_recording"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginBottom="12dp"
        app:expandedCircleColor="@color/static_white_90"
        app:expandedIconTintColor="@color/static_black"
        app:expandedRadius="44dp"
        app:iconDrawable="@drawable/ud_icon_close_outlined"
        app:iconNonCnDrawable="@drawable/ud_icon_close_outlined"
        app:iconRotateAngel="-8"
        app:iconSize="24dp"
        app:layout_constraintBottom_toTopOf="@+id/voice_oval_background"
        app:layout_constraintEnd_toStartOf="@+id/middle_place_holder"
        app:normalCircleColor="@color/static_black_20"
        app:normalCircleColorDM="@color/static_white_10"
        app:normalIconTintColor="@color/static_white_80"
        app:normalRadius="38dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/middle_place_holder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/recognizing"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="144dp"/>
    <com.ss.android.lark.keyboard.plugin.tool.voice.immersive.widget.VoiceCircleButton
        android:gravity="center_horizontal"
        android:id="@+id/recognizing"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginBottom="12dp"
        app:expandedCircleColor="@color/static_white_90"
        app:expandedIconTintColor="@color/static_black"
        app:expandedRadius="44dp"
        app:iconDrawable="@drawable/ud_icon_text_cn_outlined"
        app:iconNonCnDrawable="@drawable/ud_icon_text_outlined"
        app:iconRotateAngel="8"
        app:iconSize="24dp"
        app:layout_constraintBottom_toTopOf="@+id/voice_oval_background"
        app:layout_constraintStart_toEndOf="@+id/middle_place_holder"
        app:normalCircleColor="@color/static_black_20"
        app:normalCircleColorDM="@color/static_white_10"
        app:normalIconTintColor="@color/static_white_90"
        app:normalRadius="38dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/right_place_holder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/recognizing"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/recognizing"
        app:layout_constraintWidth_min="32dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/switch_language"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/voice_bubble_container"
        app:layout_constraintRight_toRightOf="@+id/voice_bubble_container"
        app:srcCompat="@drawable/icon_more_round_filled"
        app:tint="@color/icon_n3"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="@color/ud_N700"
        android:gravity="center"
        android:id="@+id/retry_recognition_text"
        android:background="@drawable/bg_voice_show_original"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Lark_VoiceInput_PC_Retry_Button"
        android:drawablePadding="5dp"
        android:drawableStart="@drawable/bg_retry_recognition_refresh_icon"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:drawableTint="@color/ud_N700"
        app:layout_constraintBottom_toBottomOf="@+id/switch_language"
        app:layout_constraintStart_toStartOf="@+id/voice_bubble_container"
        app:layout_constraintTop_toTopOf="@+id/switch_language"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="@color/ud_N700"
        android:gravity="center"
        android:id="@+id/show_original_text"
        android:background="@drawable/bg_voice_show_original"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="64dp"
        android:text="@string/Lark_IM_VoiceInput_ShowOriginal_Button"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/switch_language"
        app:layout_constraintEnd_toStartOf="@+id/switch_language"
        app:layout_constraintTop_toTopOf="@+id/switch_language"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/static_white_50"
        android:id="@+id/tips_asr_result_editable"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/Lark_IM_AudioMsg_TapTextToEdit_Text"
        app:layout_constraintEnd_toEndOf="@+id/voice_bubble_container"
        app:layout_constraintLeft_toLeftOf="@+id/bubble_triangle"
        app:layout_constraintRight_toRightOf="@+id/bubble_triangle"
        app:layout_constraintTop_toBottomOf="@+id/bubble_triangle"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/voice_bubble_container"
        android:background="@drawable/bg_audio_bubble_background"
        android:paddingLeft="24dp"
        android:paddingTop="20dp"
        android:paddingRight="24dp"
        android:paddingBottom="20dp"
        android:layout_width="160dp"
        android:layout_height="80dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        app:layout_constraintBottom_toTopOf="@+id/bubble_triangle"
        app:layout_constraintLeft_toLeftOf="@+id/bubble_triangle_anchor"
        app:layout_constraintRight_toRightOf="@+id/bubble_triangle_anchor"
        app:layout_constraintWidth_max="544dp">
        <com.ss.android.lark.keyboard.plugin.tool.voice.immersive.widget.VoiceWaveBar
            android:id="@+id/voice_wave_bar"
            android:layout_width="100dp"
            android:layout_height="36dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/record_preparing"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ud_icon_loading_outlined"
            app:tint="@color/function_info_content_default"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="@color/function_info_content_default"
            android:gravity="center"
            android:id="@+id/voice_record_elapse_hint"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.ss.android.lark.keyboard.plugin.tool.voice.immersive.usecase.VoiceKeyboardFunctionEditText
            android:theme="@style/ImmersiveVoiceKeyboardEditText"
            android:textSize="22sp"
            android:textColor="@color/text_title"
            android:textColorHighlight="@color/primary_fill_default"
            android:gravity="start|center_vertical"
            android:id="@+id/asr_result_edit_text"
            android:background="@null"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:minHeight="30dp"
            android:lineSpacingExtra="3sp"
            android:inputType="textMultiLine"
            android:textCursorDrawable="@drawable/asr_text_cursor_drawable_ig"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_default="wrap"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="17sp"
            android:textColor="@color/static_white"
            android:gravity="center"
            android:id="@+id/tips_weak_net"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="30dp"
            android:text="@string/Lark_Chat_SendAudioAndTextPoorNetworkTip"
            android:drawableLeft="@drawable/ud_icon_warning_hollow_filled"
            android:drawablePadding="8dp"
            app:drawableTint="@color/static_white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/bubble_triangle"
        android:background="@drawable/bg_audio_bubble_triangle"
        android:layout_width="36dp"
        android:layout_height="9dp"
        android:layout_marginBottom="18dp"
        app:layout_constraintBottom_toTopOf="@+id/bubble_triangle_anchor"
        app:layout_constraintLeft_toLeftOf="@+id/bubble_triangle_anchor"
        app:layout_constraintRight_toRightOf="@+id/bubble_triangle_anchor"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center_horizontal"
        android:id="@+id/bubble_triangle_anchor"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="172dp"
        app:layout_constraintBottom_toTopOf="@+id/voice_oval_background"
        app:layout_constraintEnd_toStartOf="@+id/recognizing"
        app:layout_constraintStart_toEndOf="@+id/cancel_recording"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="@color/static_white_60"
        android:id="@+id/send_asr_all_result_tip"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/Lark_IM_AudioMsg_HoldContinueRecord_Button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/send_asr_all_result"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/static_white_60"
        android:gravity="center"
        android:id="@+id/tips_record_preparing"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/Lark_IM_AudioMsg_PreparingRecord_Text"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/voice_oval_background"
        app:layout_constraintEnd_toStartOf="@+id/recognizing"
        app:layout_constraintStart_toEndOf="@+id/cancel_recording"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/static_white_60"
        android:gravity="center"
        android:id="@+id/tips_release_cancel"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/Lark_IM_AudioMsg_ReleaseToCancel_Text"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/cancel_recording"
        app:layout_constraintLeft_toLeftOf="@+id/cancel_recording"
        app:layout_constraintRight_toRightOf="@+id/cancel_recording"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14sp"
        android:textColor="@color/static_white_60"
        android:gravity="center"
        android:id="@+id/tips_recognizing"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/Lark_IM_AudioMsg_ConvertToText_Text"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/recognizing"
        app:layout_constraintEnd_toEndOf="@+id/recognizing"
        app:layout_constraintStart_toStartOf="@+id/recognizing"/>
    <com.ss.android.lark.keyboard.plugin.tool.voice.immersive.widget.CircleIconWithTitle
        android:id="@+id/cancel_asr_result"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginBottom="140dp"
        app:iconDrawableRes="@drawable/ud_icon_undo_outlined"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/cancel_recording"
        app:layout_constraintRight_toRightOf="@+id/cancel_recording"
        app:layout_constraintTop_toTopOf="@+id/cancel_recording"
        app:textResId="@string/Lark_IM_AudioMsg_Cancel_Button"/>
    <com.ss.android.lark.keyboard.plugin.tool.voice.immersive.widget.CircleIconWithTitle
        android:id="@+id/send_asr_audio"
        android:layout_width="88dp"
        android:layout_height="88dp"
        app:iconDrawableRes="@drawable/ud_icon_transcribe_outlined"
        app:layout_constraintBottom_toBottomOf="@+id/cancel_asr_result"
        app:layout_constraintEnd_toStartOf="@+id/send_asr_all_result"
        app:layout_constraintStart_toEndOf="@+id/cancel_asr_result"
        app:layout_constraintTop_toTopOf="@+id/cancel_asr_result"
        app:textResId="@string/Lark_IM_AudioMsg_SendAudioOnly_Button"/>
    <com.ss.android.lark.keyboard.plugin.tool.voice.immersive.widget.CircleIconWithTitle
        android:id="@+id/hold_to_speak_btn"
        android:visibility="invisible"
        android:layout_width="88dp"
        android:layout_height="88dp"
        app:iconDrawableRes="@drawable/ud_icon_mic_outlined"
        app:layout_constraintBottom_toBottomOf="@+id/send_asr_audio"
        app:layout_constraintEnd_toEndOf="@+id/send_asr_audio"
        app:layout_constraintStart_toStartOf="@+id/send_asr_audio"
        app:layout_constraintTop_toTopOf="@+id/send_asr_audio"
        app:textResId="@string/Lark_IM_AudioReedit_HoldRecord_Button"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/hold_to_speak_bar_layout"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/cancel_asr_result"
        app:layout_constraintEnd_toEndOf="@+id/voice_bubble_container"
        app:layout_constraintStart_toStartOf="@+id/voice_bubble_container"
        app:layout_constraintTop_toTopOf="@+id/cancel_asr_result">
        <View
            android:id="@+id/hold_to_speak_bar_bkg"
            android:background="@drawable/kb_audio_send_all_btn_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:backgroundTint="@color/static_white_15"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="@color/static_white"
            android:id="@+id/hold_to_speak_bar_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Lark_IM_AudioReedit_ReleaseStop_Text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/hold_to_speak_bar_bkg"
            app:layout_constraintTop_toTopOf="@+id/hold_to_speak_bar_bkg"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/hold_to_speak_bar_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ud_icon_mic_outlined"
            app:tint="@color/static_white"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.ss.android.lark.keyboard.plugin.tool.voice.immersive.widget.CircleIconWithTitle
        android:id="@+id/send_asr_all_result"
        android:background="@drawable/voice_circle_icon_bkg"
        android:layout_width="88dp"
        android:layout_height="88dp"
        app:backgroundDisableTintColor="@color/static_white_5"
        app:backgroundTintColor="@color/static_white_90"
        app:iconDisableTintColor="@color/static_white_15"
        app:iconDrawableRes="@drawable/ud_icon_done_outlined"
        app:iconTintColor="@color/primary_fill_default"
        app:innerIconSize="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/send_asr_audio"
        app:layout_constraintLeft_toLeftOf="@+id/recognizing"
        app:layout_constraintRight_toRightOf="@+id/recognizing"
        app:layout_constraintTop_toTopOf="@+id/send_asr_audio"/>
    <com.ss.android.lark.keyboard.plugin.tool.voice.immersive.widget.VoiceOvalBackground
        android:id="@+id/voice_oval_background"
        android:layout_width="match_parent"
        android:layout_height="128dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/icon_voice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ud_icon_voice_outlined"
            app:tint="@color/icon_n1"/>
    </com.ss.android.lark.keyboard.plugin.tool.voice.immersive.widget.VoiceOvalBackground>
    <com.ss.android.lark.keyboard.plugin.tool.voice.immersive.widget.SelfConsumingFrameLayout
        android:id="@+id/ime_wrapper_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</merge>
