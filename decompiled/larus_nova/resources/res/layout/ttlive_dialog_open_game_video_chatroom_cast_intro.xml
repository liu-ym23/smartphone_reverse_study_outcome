<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_open_game_panel"
    android:layout_width="match_parent"
    android:layout_height="484dp"
    android:paddingStart="@dimen/ttlive_open_platform_dialog_content_padding"
    android:paddingEnd="@dimen/ttlive_open_platform_dialog_content_padding">
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/ttlive_open_platform_video_chatroom_cast_intro_dialog_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.chatroom.ui.LiveRoundDraweeImageView
        android:id="@+id/cast_image_desc"
        android:layout_width="167dp"
        android:layout_height="260dp"
        android:layout_marginTop="20dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_title"
        app:ttlive_radius="4dp"/>
    <TextView
        android:textColor="@color/ttlive_white_75"
        android:id="@+id/cast_text_introduction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ttlive_open_platform_video_chatroom_cast_intro_dialog_desc"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cast_image_desc"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/user_understand"
        android:background="@drawable/ttlive_bg_game_dialog_red_corner_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="31dp"
        android:text="@string/ttlive_open_platform_video_chatroom_cast_intro_dialog_bn_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cast_text_introduction"/>
</androidx.constraintlayout.widget.ConstraintLayout>
