<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/video_comment_search_panel"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/search_video_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:id="@+id/search_back_btn"
            android:paddingLeft="18dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentLeft="true"
            android:paddingStart="18dp"
            android:paddingEnd="8dp"
            android:layout_alignParentStart="true">
            <ImageView
                android:background="@drawable/ttlive_search_video_back_ic"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/search_action_btn"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_alignParentEnd="true">
            <TextView
                android:textSize="15dp"
                android:textColor="#161823"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_video_comment_search"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:orientation="horizontal"
            android:background="@drawable/ttlive_video_search_background"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/search_action_btn"
            android:layout_toEndOf="@+id/search_back_btn">
            <ImageView
                android:id="@+id/search_input_icon"
                android:background="@drawable/ttlive_video_search_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginLeft="8dp"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_alignParentStart="true"/>
            <RelativeLayout
                android:id="@+id/search_input_clear"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:id="@+id/search_input_clear_icon"
                    android:background="@drawable/ttlive_search_video_clear_icon"
                    android:visibility="gone"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
            <EditText
                android:textSize="15dp"
                android:textColor="#161823"
                android:textColorHint="#57161823"
                android:gravity="start|center_vertical"
                android:id="@+id/search_input"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="21dp"
                android:hint="@string/ttlive_video_comment_search_hint"
                android:maxLines="1"
                android:singleLine="true"
                android:layout_weight="1"
                android:layout_centerVertical="true"
                android:lineSpacingExtra="5dp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:textCursorDrawable="@drawable/ttlive_search_video_cursor_drawable"
                android:textAlignment="viewStart"
                android:layout_marginStart="8dp"
                android:layout_toStartOf="@+id/search_input_clear"
                android:layout_toEndOf="@+id/search_input_icon"/>
        </RelativeLayout>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/video_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_video_bar"/>
    <FrameLayout
        android:id="@+id/video_search_loading_container"
        android:background="#ffffff"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_video_bar">
        <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
            android:layout_gravity="center"
            android:id="@+id/video_search_loading"
            android:layout_width="36dp"
            android:layout_height="36dp"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/video_search_reload_container"
        android:background="#ffffff"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_video_bar">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/video_search_reload_icon"
            android:layout_width="240dp"
            android:layout_height="160dp"/>
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_video_search_error_network"/>
        <Button
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:gravity="center"
            android:id="@+id/video_search_reload_btn"
            android:background="@drawable/ttlive_room_intro_button_gray_bg"
            android:layout_width="240dp"
            android:layout_height="44dp"
            android:layout_marginTop="80dp"
            android:text="@string/ttlive_video_searchl_reloading_btn_title"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/video_search_empty_container"
        android:background="#ffffff"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constrainedHeight="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_video_bar">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/video_search_empty_icon"
            android:layout_width="240dp"
            android:layout_height="160dp"/>
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_video_search_empty_network"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#99161823"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ttlive_video_search_empty_hint_network"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
