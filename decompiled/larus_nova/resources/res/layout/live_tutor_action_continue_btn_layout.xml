<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/dp_151"
    android:layout_height="@dimen/dp_122">
    <View
        android:layout_gravity="end|top"
        android:id="@+id/mask"
        android:background="@drawable/live_tutor_continue_btn_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.larus.common_ui.venus.ShapeButton
        android:textSize="@dimen/dp_15"
        android:textColor="#eb000000"
        android:gravity="center"
        android:layout_gravity="end|top"
        android:id="@+id/continue_button"
        android:paddingLeft="@dimen/dp_17"
        android:paddingTop="@dimen/dp_1"
        android:paddingRight="@dimen/dp_17"
        android:paddingBottom="@dimen/dp_9"
        android:layout_width="@dimen/dp_86"
        android:layout_height="@dimen/dp_50"
        android:layout_marginTop="@dimen/dp_46"
        android:text="继续"
        android:maxLines="1"
        android:drawablePadding="@dimen/dp_4"
        android:drawableStart="@drawable/live_tutor_continue_icon"
        android:layout_marginEnd="@dimen/dp_11"
        app:larus_sb_cornerRadius="@dimen/dp_20"
        app:larus_sb_endColor="#f8fafe"
        app:larus_sb_orientation="TOP_BOTTOM"
        app:larus_sb_shadow_blur_radius="@dimen/dp_5"
        app:larus_sb_shadow_color="#0f005580"
        app:larus_sb_shadow_dy="@dimen/dp_4"
        app:larus_sb_startColor="#fbfcfe"
        app:larus_sb_strokeColor="@color/white"
        app:larus_sb_strokeWidth="@dimen/dp_1"/>
</merge>
