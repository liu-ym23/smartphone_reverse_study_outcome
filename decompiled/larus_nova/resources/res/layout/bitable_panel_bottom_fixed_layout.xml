<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/bottom_fixed_btn_container"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="@dimen/bitable_panel_bottom_fixed_btn_container_height">
    <View
        android:layout_gravity="top"
        android:id="@+id/bottom_divider"
        android:background="@color/line_divider_default"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_kit_len_half"/>
    <include
        android:layout_gravity="center_horizontal"
        android:id="@+id/panel_bottom_btn_1"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        layout="@layout/bitable_panel_bottom_fixed_btn_view"/>
    <include
        android:layout_gravity="center_horizontal"
        android:id="@+id/panel_bottom_btn_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        layout="@layout/bitable_panel_bottom_fixed_btn_view"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/horizontal_btn_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp">
        <include
            android:id="@+id/panel_bottom_btn_v2_1"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            layout="@layout/bitable_panel_bottom_fixed_btn_view"/>
        <include
            android:id="@+id/panel_bottom_btn_v2_2"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            layout="@layout/bitable_panel_bottom_fixed_btn_view"/>
    </LinearLayout>
</LinearLayout>
