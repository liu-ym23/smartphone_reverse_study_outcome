<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_width="36dp"
    android:layout_height="36dp">
    <ImageView
        android:id="@+id/create"
        android:background="@drawable/ttlive_chat_channel_landscape_toolbar_create_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:id="@+id/chat_channel"
        android:layout_width="36dp"
        android:layout_height="36dp">
        <com.bytedance.android.livesdk.widget.TransparentCircleIconView
            android:id="@+id/iv_channel_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerInParent="true"
            app:circleCenterLeftMargin="20dp"
            app:circleCenterTopMargin="20dp"
            app:circleRadius="8dp"
            app:roundAsCircle="true"/>
        <com.bytedance.android.livesdk.widget.TransparentCircleIconView
            android:id="@+id/iv_channel_icon_right"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="6dp"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="6dp"
            android:layout_alignParentEnd="true"
            app:circleCenterLeftMargin="2dp"
            app:circleCenterTopMargin="16dp"
            app:circleRadius="11dp"
            app:roundAsCircle="true"/>
        <com.bytedance.android.livesdk.widget.TransparentCircleIconView
            android:id="@+id/iv_channel_icon_left"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="5dp"
            android:layout_marginBottom="5dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="5dp"
            android:layout_alignParentStart="true"
            app:roundAsCircle="true"/>
        <ImageView
            android:id="@+id/iv_channel_icon_message"
            android:background="@drawable/ttlive_chat_channel_landscape_toolbar_icon_message"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginRight="4dp"
            android:layout_marginBottom="5dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="4dp"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:id="@+id/iv_channel_icon_mention"
            android:background="@drawable/ttlive_chat_channel_landscape_toolbar_icon_mention"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginRight="4dp"
            android:layout_marginBottom="5dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="4dp"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="9dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_channel_unread_count"
            android:background="@drawable/ttlive_bg_chat_channel_landscape_toolbar_icon_unread"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:layout_width="wrap_content"
            android:layout_height="12dp"
            android:layout_marginRight="4dp"
            android:layout_marginBottom="5dp"
            android:includeFontPadding="false"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</RelativeLayout>
