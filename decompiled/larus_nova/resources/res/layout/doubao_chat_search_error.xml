<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/search_result_error"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:tint="@color/ud_N1000"
        app:srcCompat="@drawable/ud_icon_refresh_outlined"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ud_N1000"
        android:gravity="center_horizontal"
        android:id="@+id/search_error_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/LarkIM_ActionBar_LoadFailedRetry_Error"
        android:layout_marginStart="6dp"/>
</LinearLayout>
