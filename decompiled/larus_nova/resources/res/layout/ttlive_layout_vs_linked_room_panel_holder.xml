<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_relevant_live_holder"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="108dp"
    android:layout_height="121dp">
    <com.bytedance.android.livesdk.chatroom.view.VSLinkedAvatarContainer
        android:id="@+id/avatar_area"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/avatar"
            android:layout_width="33dp"
            android:layout_height="33dp"
            app:roundAsCircle="true"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="end|bottom"
            android:id="@+id/living_view"
            android:tag="living_view"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:scaleType="centerCrop"/>
    </com.bytedance.android.livesdk.chatroom.view.VSLinkedAvatarContainer>
    <TextView
        android:textSize="12dp"
        android:textColor="#e5ffffff"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/tv_nick_name"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avatar_area"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#e5ffffff"
        android:gravity="center"
        android:id="@+id/go_to_live_room"
        android:background="@drawable/ttlive_bg_relevant_live_watch_btn"
        android:layout_width="54dp"
        android:layout_height="22dp"
        android:layout_marginTop="12dp"
        android:text="@string/ttlive_open_live"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_nick_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
