<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_store_background_container"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/ec_store_background_wrapper"
        android:background="@color/black"
        android:clipChildren="true"
        android:layout_width="match_parent"
        android:layout_height="375dp">
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:id="@+id/ec_store_background"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layoutMode="height_self_adjust"/>
        <View
            android:id="@+id/ec_store_background_mask"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:id="@+id/ec_store_background_mask_image"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layoutMode="height_self_adjust"/>
    </FrameLayout>
</FrameLayout>
