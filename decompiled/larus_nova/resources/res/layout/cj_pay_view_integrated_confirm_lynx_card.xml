<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_pay_payment_confirm_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/cj_pay_root_view"
        android:background="@drawable/cj_pay_integrated_bg_gray_corner_top"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_470"
        android:layout_alignParentBottom="true">
        <RelativeLayout
            android:id="@+id/cj_pay_total_value_layout"
            android:layout_width="match_parent"
            android:layout_height="115dp">
            <ImageView
                android:id="@+id/cj_pay_close_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/cj_pay_icon_titlebar_left_close_noise_reduction"
                android:contentDescription="@string/cj_pay_old_adapter_close_text"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/cj_pay_color_gray_light"
                    android:id="@+id/cj_pay_douyin_middle_title"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:layout_centerHorizontal="true"/>
                <RelativeLayout
                    android:gravity="center_horizontal"
                    android:id="@+id/cj_pay_money_value_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:textColor="@color/cj_pay_color_black_161823"
                        android:gravity="center"
                        android:id="@+id/cj_pay_total_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.05"/>
                    <TextView
                        android:textSize="28sp"
                        android:textColor="@color/cj_pay_color_black_161823"
                        android:id="@+id/cj_pay_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="4dp"
                        android:layout_marginBottom="1dp"
                        android:text="@string/cj_pay_currency_unit"
                        android:includeFontPadding="false"
                        android:layout_toLeftOf="@+id/cj_pay_total_value"
                        android:layout_alignBottom="@+id/cj_pay_total_value"/>
                </RelativeLayout>
                <com.android.ttcjpaysdk.base.ui.widget.CJPayImageSpanTextView
                    android:textSize="13sp"
                    android:textColor="#ff7a38"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:id="@+id/cj_pay_dy_confirm_discount_text"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_marginRight="12dp"
                    android:layout_marginBottom="2dp"
                    android:maxLines="1"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/cj_pay_dy_confirm_product_desc_layout"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/cj_pay_dy_confirm_discount_text">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/cj_pay_color_gray_light"
                        android:id="@+id/tv_original_price_tip"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cj_pay_original_price"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/cj_pay_color_gray_light"
                        android:id="@+id/tv_original_price"
                        android:paddingRight="8dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/cj_pay_color_gray_light"
                        android:ellipsize="end"
                        android:id="@+id/cj_pay_product_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:includeFontPadding="false"/>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="283dp"
            android:layout_below="@+id/cj_pay_total_value_layout">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_lynx_card"
                android:layout_width="match_parent"
                android:layout_height="283dp"/>
            <View
                android:id="@+id/view_mask_clickable"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:id="@+id/iv_lynx_card_loading"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/cj_pay_bg_lynx_loading"
                android:scaleType="fitXY"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/cj_pay_confirm_layout"
            android:background="@color/cj_pay_color_white"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <RelativeLayout
                android:id="@+id/divide_btn_layout"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp">
                <com.android.ttcjpaysdk.base.ui.widget.CJPaySkewSideLayout
                    android:gravity="center_vertical"
                    android:id="@+id/divide_left_btn_layout"
                    android:layout_width="123dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="-4dp"
                    app:cornerRadius="8dp"
                    app:skewDegree="77"
                    app:skewSide="right">
                    <ImageView
                        android:id="@+id/cj_pay_confirm_left_btn"
                        android:background="#fe2c55"
                        android:layout_width="123dp"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="#ffffff"
                        android:id="@+id/divide_btn_left_label_top"
                        android:paddingLeft="14dp"
                        android:layout_width="match_parent"
                        android:layout_height="123dp"
                        android:layout_marginTop="7dp"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="#ffffff"
                        android:id="@+id/divide_btn_left_label_bottom"
                        android:paddingLeft="14dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"/>
                </com.android.ttcjpaysdk.base.ui.widget.CJPaySkewSideLayout>
                <com.android.ttcjpaysdk.base.ui.widget.CJPaySkewSideLayout
                    android:id="@+id/divide_right_btn_layout"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_toRightOf="@+id/divide_left_btn_layout"
                    app:skewDegree="77"
                    app:skewSide="none">
                    <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
                        android:textSize="15sp"
                        android:textColor="@color/cj_pay_color_white"
                        android:gravity="center"
                        android:id="@+id/cj_pay_confirm"
                        android:background="@drawable/cj_pay_bg_red_btn_radis_4"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/cj_pay_custom_button_height_44"
                        app:CJPayFixSide="left"/>
                    <ProgressBar
                        android:id="@+id/cj_pay_confirm_loading"
                        android:background="@color/cj_pay_color_trans"
                        android:visibility="gone"
                        android:layout_width="@dimen/cj_pay_padding_20"
                        android:layout_height="@dimen/cj_pay_padding_20"
                        android:indeterminateOnly="true"
                        android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_white"
                        android:indeterminateDuration="500"
                        android:indeterminateBehavior="repeat"
                        android:layout_centerInParent="true"/>
                </com.android.ttcjpaysdk.base.ui.widget.CJPaySkewSideLayout>
            </RelativeLayout>
            <TextView
                android:textSize="11sp"
                android:textColor="#ae5e00"
                android:layout_gravity="top|right"
                android:id="@+id/cj_pay_confirm_btn_bubble"
                android:background="@drawable/cj_pay_confirm_button_bubble"
                android:paddingLeft="8dp"
                android:paddingTop="2.5dp"
                android:paddingRight="8dp"
                android:paddingBottom="2dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <RelativeLayout
            android:id="@+id/cj_pay_loading_outer_layout"
            android:background="@drawable/cj_pay_bg_fragment_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.android.ttcjpaysdk.base.ui.CJPayMiddleTitleText
                android:textSize="?attr/cj_pay_page_size_17"
                android:textColor="@color/cj_pay_color_black_161823"
                android:ellipsize="middle"
                android:gravity="center"
                android:id="@+id/cj_pay_loading_title"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/cj_pay_height_50"
                android:maxWidth="300dp"
                android:singleLine="true"
                android:layout_centerHorizontal="true"/>
            <ProgressBar
                android:id="@+id/cj_pay_loading_view"
                android:background="@color/cj_pay_color_trans"
                android:layout_width="@dimen/cj_pay_height_60"
                android:layout_height="@dimen/cj_pay_height_60"
                android:layout_marginTop="100dp"
                android:indeterminateOnly="true"
                android:indeterminateDrawable="@drawable/cj_pay_bg_loading_circle"
                android:indeterminateDuration="500"
                android:indeterminateBehavior="repeat"
                android:layout_below="@+id/cj_pay_loading_title"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
