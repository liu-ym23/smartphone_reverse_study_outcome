<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/fans_icon_layout"
        android:background="@color/transparent"
        android:visibility="gone"
        android:layout_width="41dp"
        android:layout_height="28dp"
        android:layout_marginRight="@dimen/ttlive_user_info_inside_spacing"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/ttlive_user_info_inside_spacing"
        android:layout_alignParentEnd="true">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/fans_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            app:actualImageScaleType="centerInside"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/white"
            android:id="@+id/fans_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</RelativeLayout>
