<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/content"
        android:background="@drawable/ttlive_ktv_dialog_fragment_main_bg_light"
        android:layout_width="match_parent"
        android:layout_height="423dp">
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ttlive_ktv_adjust_music"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/driver"
            android:background="#cfd0d2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="52dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <include
            android:id="@+id/adjust_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="@+id/driver"
            layout="@layout/ttlive_ktv_adjust_layout_light"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/adjust_panel_bottom_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/adjust_area">
            <View
                android:id="@+id/divider_2"
                android:background="@drawable/ttlive_ktv_shadow_divider_light"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#b2b2b2"
                android:id="@+id/cur_play_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="19dp"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider_2"/>
            <Button
                android:textSize="13dp"
                android:textColor="@color/ttlive_white"
                android:gravity="center"
                android:id="@+id/go_ktv_dialog"
                android:background="@drawable/ttlive_bg_ktv_red_bt"
                android:layout_width="100dp"
                android:layout_height="36dp"
                android:layout_marginRight="16dp"
                android:text="@string/ttlive_ktv_room_go_dialog"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/cur_play_time"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/cur_play_time"/>
            <View
                android:id="@+id/cut_song_img"
                android:background="@drawable/ttlive_ktv_music_controller_next_song_light"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginRight="20dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintBottom_toTopOf="@+id/cut_music_tv"
                app:layout_constraintEnd_toStartOf="@+id/go_ktv_dialog"/>
            <TextView
                android:textSize="8dp"
                android:textColor="#363636"
                android:id="@+id/cut_music_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="1dp"
                android:text="@string/ttlive_ktv_sing_next_song"
                app:layout_constraintBottom_toBottomOf="@+id/go_ktv_dialog"
                app:layout_constraintEnd_toEndOf="@+id/cut_song_img"
                app:layout_constraintStart_toStartOf="@+id/cut_song_img"/>
            <View
                android:id="@+id/pause_restart_img"
                android:background="@drawable/ttlive_ktv_music_controller_start_light"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginRight="20dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintBottom_toTopOf="@+id/pause_restart_tv"
                app:layout_constraintEnd_toStartOf="@+id/cut_song_img"/>
            <TextView
                android:textSize="8dp"
                android:textColor="#363636"
                android:id="@+id/pause_restart_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ttlive_ktv_sing_pause"
                app:layout_constraintBottom_toBottomOf="@+id/cut_music_tv"
                app:layout_constraintEnd_toEndOf="@+id/pause_restart_img"
                app:layout_constraintStart_toStartOf="@+id/pause_restart_img"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:id="@+id/ktv_music_controller_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <FrameLayout
            android:id="@+id/ktv_selected_song_list_container"
            android:background="@drawable/ttlive_ktv_dialog_fragment_main_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
