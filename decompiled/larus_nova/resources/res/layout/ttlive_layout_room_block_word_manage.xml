<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/block_word_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="@style/ttlive_LiveProfileSettingItem_Dark"
            android:id="@+id/block_word_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="12dp"
            android:text="@string/ttlive_blockword_setting"
            android:layout_marginStart="16dp"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_commonui_white_50"
            android:id="@+id/tv_block_word_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_toRightOf="@+id/block_word_title"
            android:layout_alignTop="@+id/block_word_title"
            android:layout_alignBottom="@+id/block_word_title"/>
        <ImageView
            android:id="@+id/block_word_red_dot"
            android:background="@drawable/ttlive_ic_red_point_tip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/tv_block_word_count"
            android:layout_alignTop="@+id/tv_block_word_count"/>
    </RelativeLayout>
    <TextView
        android:textSize="13dp"
        android:textColor="#80ffffff"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="4dp"
        android:text="@string/ttlive_blockword_instruction"
        android:lineSpacingExtra="3dp"
        android:translationY="-1.38dp"
        android:layout_marginStart="16dp"/>
    <com.bytedance.android.livesdk.widget.FlowLayout
        android:orientation="horizontal"
        android:id="@+id/block_word_display_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="16dp">
        <FrameLayout
            android:id="@+id/btn_add_block_word"
            android:background="@drawable/ttlive_room_block_word_background"
            android:layout_width="55dp"
            android:layout_height="28dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ttlive_room_block_word_add"/>
        </FrameLayout>
    </com.bytedance.android.livesdk.widget.FlowLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/block_word_input_area"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="42dp">
        <com.bytedance.android.live.core.widget.LiveEditText
            android:textSize="15dp"
            android:textColor="@color/black"
            android:textColorHint="#3d000000"
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/block_word_edit_text"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="8dp"
            android:maxLines="1"
            android:layout_weight="1"
            android:inputType="text"
            android:imeOptions="flagNoExtractUi|actionSend"
            android:textCursorDrawable="@drawable/ttlive_edit_text_cursor_drawable"
            android:textAlignment="viewStart"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#3d000000"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_input_limit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"/>
    </LinearLayout>
</LinearLayout>
