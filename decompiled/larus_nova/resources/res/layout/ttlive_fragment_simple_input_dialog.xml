<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <view
        android:id="@+id/view_shadow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        class="com.bytedance.android.livesdk.chatroom.ui.KeyboardShadowView"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/decoration_text_input_layout"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="46dp">
        <EditText
            android:textColor="#161823"
            android:id="@+id/decoration_text_input"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:singleLine="true"
            android:layout_weight="1"
            android:imeOptions="flagNoExtractUi|actionDone"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>
        <Button
            android:textSize="15dp"
            android:textColor="@color/ttlive_core_hs_s5"
            android:gravity="center"
            android:id="@+id/send_decoration_button"
            android:background="@drawable/ttlive_bg_yellow_btn"
            android:layout_width="60dp"
            android:layout_height="28dp"
            android:layout_marginRight="10dp"
            android:text="@string/ttlive_confirm_decoration_text"
            android:layout_marginEnd="10dp"/>
    </LinearLayout>
</LinearLayout>
