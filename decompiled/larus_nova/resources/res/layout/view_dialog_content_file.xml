<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/icon_layout"
        android:background="@color/bg_float"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <pl.droidsonroids.gif.GifImageView
            android:id="@+id/icon"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="2dp"/>
    </FrameLayout>
    <com.ss.android.lark.widget.EllipsizedEmojiconTextView
        android:textSize="16dp"
        android:textColor="@color/text_title"
        android:ellipsize="end"
        android:id="@+id/confirm_msg_title"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="3dp"
        android:maxLines="2"
        app:layout_constraintLeft_toRightOf="@+id/icon_layout"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.ss.android.lark.widget.EllipsizedEmojiconTextView
        android:textSize="14dp"
        android:textColor="@color/text_title"
        android:ellipsize="end"
        android:id="@+id/confirm_msg_content"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:maxLines="4"
        app:layout_constraintBottom_toTopOf="@+id/confirm_msg_desc"
        app:layout_constraintLeft_toRightOf="@+id/icon_layout"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/confirm_msg_title"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/text_placeholder"
        android:ellipsize="end"
        android:id="@+id/confirm_msg_desc"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginBottom="2dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/icon_layout"
        app:layout_constraintRight_toRightOf="parent"/>
</merge>
