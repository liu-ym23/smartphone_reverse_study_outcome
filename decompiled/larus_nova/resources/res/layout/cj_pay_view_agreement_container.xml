<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/cj_pay_agreement_container"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/cj_pay_checkbox_layout"
        android:paddingLeft="@dimen/cj_pay_padding_14_with_half"
        android:paddingTop="@dimen/cj_pay_padding_21"
        android:paddingRight="@dimen/cj_pay_padding_6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/cj_pay_checkbox_bg"
            android:background="@color/cj_pay_color_blue"
            android:visibility="gone"
            android:layout_width="@dimen/cj_pay_padding_14"
            android:layout_height="12sp"/>
        <ImageView
            android:id="@+id/cj_pay_checkbox"
            android:layout_width="@dimen/cj_pay_padding_12"
            android:layout_height="@dimen/cj_pay_padding_12"
            android:src="@drawable/cj_pay_icon_agreement_check_box_normal"
            android:scaleType="centerCrop"/>
    </FrameLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="?attr/cj_pay_text_primary"
        android:id="@+id/cj_pay_checkbox_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cj_pay_padding_12"
        android:text="@string/cj_pay_agree"
        android:includeFontPadding="false"/>
    <TextView
        android:textSize="12sp"
        android:textColor="?attr/cj_pay_text_link_default"
        android:id="@+id/cj_pay_checkbox_notice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_5"
        android:layout_marginTop="@dimen/cj_pay_padding_12"
        android:text="@string/cj_pay_service_agreement"
        android:includeFontPadding="false"/>
</LinearLayout>
