<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_container"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center"
        android:id="@+id/guest_bg"
        android:background="@drawable/ttlive_equal_talkroom_window_empty_bg"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="#57000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/guest_info_container"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/guest_container"
            android:visibility="invisible"
            android:layout_width="75dp"
            android:layout_height="75dp"
            app:layout_constraintBottom_toBottomOf="@+id/guest_info_container"
            app:layout_constraintLeft_toLeftOf="@+id/guest_info_container"
            app:layout_constraintRight_toRightOf="@+id/guest_info_container"
            app:layout_constraintTop_toTopOf="@+id/guest_info_container">
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/avatar_info"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.bytedance.android.live.core.widget.HSImageView
                    android:layout_gravity="center"
                    android:id="@+id/guest_avatar"
                    android:background="@drawable/ttlive_build_linking_avatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    app:roundAsCircle="true"/>
                <com.bytedance.android.livesdk.common.AnchorPauseTipsView
                    android:layout_gravity="center"
                    android:id="@+id/leave_view"
                    android:visibility="gone"
                    android:layout_width="56dp"
                    android:layout_height="56dp"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/emoji_mask_layer"
                    android:background="#7f000000"
                    android:visibility="gone"
                    android:layout_width="56dp"
                    android:layout_height="56dp"/>
            </FrameLayout>
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="center"
                android:id="@+id/empty_anim_view"
                android:visibility="gone"
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:actualImageScaleType="fitXY"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="center"
                android:id="@+id/radio_effect"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/surface_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/countdown_preview"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:background="#80000000"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="40sp"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:id="@+id/tv_count_down"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_host_label"
            android:background="@drawable/ttlive_bg_video_friend_host_label"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="4dp"
            android:text="@string/ttlive_video_friend_host_label"
            android:layout_marginStart="4dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_bottom_container"
            android:background="@drawable/ttlive_bg_guest_camera_user_info"
            android:paddingLeft="4dp"
            android:paddingTop="3dp"
            android:paddingRight="2dp"
            android:paddingBottom="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@+id/guest_info_container"
            app:layout_constraintRight_toRightOf="@+id/guest_info_container">
            <ImageView
                android:id="@+id/silence_video"
                android:visibility="gone"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginRight="2dp"
                android:src="@drawable/ttlive_icon_video_silence"
                android:layout_marginEnd="2dp"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#e6ffffff"
                android:ellipsize="end"
                android:id="@+id/guest_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:maxLength="15"
                android:layout_weight="1"/>
            <FrameLayout
                android:id="@+id/link_gift_score_container"
                android:clipChildren="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:layout_marginTop="1dp"
                android:layout_marginStart="2dp">
                <com.bytedance.android.live.ui.LinkGuestSendGiftView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/send_gift_view"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/quick_interact_container"
                android:clipChildren="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp">
                <com.bytedance.android.live.liveinteract.videotalk.quickinteract.interactView.LinkMicQuickInteractView
                    android:id="@+id/guest_seat_linkmic_quick_interact"
                    android:clipChildren="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
        </LinearLayout>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/guest_seat_animation"
            android:visibility="gone"
            android:layout_width="70dp"
            android:layout_height="70dp"
            app:layout_constraintBottom_toTopOf="@+id/ll_bottom_container"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/themed_competition_seat_animation"
            android:visibility="gone"
            android:layout_width="70dp"
            android:layout_height="70dp"
            app:layout_constraintBottom_toTopOf="@+id/ll_bottom_container"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.livesdk.chatroom.ui.DynamicEmojiView
            android:id="@+id/dynamic_emoji_view"
            android:visibility="visible"
            android:layout_width="70dp"
            android:layout_height="70dp"
            app:layout_constraintBottom_toTopOf="@+id/ll_bottom_container"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.live.liveinteract.chatroom.chatroom.ui.SeatAnimationView
        android:id="@+id/seat_anim_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/paid_time_count_down_bar"
        android:background="@drawable/ttlive_video_talk_paid_count_down_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <com.bytedance.android.live.liveinteract.view.PositionNameTv
        android:textSize="10dp"
        android:textColor="@color/white"
        android:id="@+id/tv_position_name"
        android:padding="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minWidth="14dp"
        android:maxLength="4"
        android:layout_marginEnd="4dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/guest_battle_seat_big_effect"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
