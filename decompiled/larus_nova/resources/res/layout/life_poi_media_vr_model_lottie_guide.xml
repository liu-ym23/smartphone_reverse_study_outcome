<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/life_poi_media_vr_model_lottie_guide_1470773712"
    android:background="#80000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="start"
        android:id="@+id/life_poi_media_vr_model_lottie_guide_520515140"
        android:background="#26ffffff"
        android:layout_width="55dp"
        android:layout_height="match_parent">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/life_poi_media_vr_model_lottie_guide_335583639"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="155dp"
            android:text="@string/vr_model_swipe_up_for_more"
            android:maxEms="1"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="end"
        android:id="@+id/life_poi_media_vr_model_lottie_guide_402543575"
        android:background="#26ffffff"
        android:layout_width="55dp"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="bottom"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:id="@+id/life_poi_media_vr_model_lottie_guide_295476289"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/life_poi_media_lottie_guide_view"
            android:layout_width="120dp"
            android:layout_height="120dp"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="155dp"
            android:text="@string/vr_model_swipe_up_for_more"
            android:maxEms="1"/>
    </LinearLayout>
</FrameLayout>
