<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/insufficient_root_view"
    android:background="@color/cj_pay_color_layer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:id="@+id/insufficient_panel_root_view"
        android:background="@drawable/cj_pay_bg_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_470">
        <include
            android:id="@+id/cj_pay_titlebar_root_view"
            layout="@layout/cj_pay_view_titlebar_layout"/>
        <RelativeLayout
            android:id="@+id/insufficient_layout"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/cj_pay_titlebar_root_view">
            <ImageView
                android:id="@+id/insufficient_image"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginTop="60dp"
                android:layout_centerHorizontal="true"
                app:srcCompat="@drawable/cj_pay_cry_face_icon"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/insufficient_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_below="@+id/insufficient_image"
                android:layout_centerHorizontal="true">
                <TextView
                    android:textSize="20sp"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:id="@+id/insufficient_title_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cj_pay_insufficient_balance"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
                android:id="@+id/tv_pay_channel"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_below="@+id/insufficient_title"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:gravity="center_horizontal"
                android:id="@+id/insufficient_text_new"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cj_pay_padding_12"
                android:layout_below="@+id/tv_pay_channel"
                android:layout_centerHorizontal="true"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/insufficient_voucher_label_layout"
                android:background="@drawable/cj_pay_bg_super_pay_voucher_label"
                android:paddingLeft="@dimen/cj_pay_padding_15"
                android:paddingRight="@dimen/cj_pay_padding_12"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginBottom="82dp"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cj_pay_padding_10"
                    android:layout_marginRight="@dimen/cj_pay_padding_5"
                    android:src="@drawable/cj_pay_icon_super_pay_voucher"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/cj_pay_color_red_fe2c55"
                    android:id="@+id/insufficient_voucher_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cj_pay_padding_7"
                    android:singleLine="true"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/insufficient_confirm_btn_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cj_pay_height_44"
                android:layout_marginBottom="16dp"
                android:layout_above="@+id/insufficient_other_method_btn">
                <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
                    android:textSize="15sp"
                    android:textColor="@color/cj_pay_color_white"
                    android:gravity="center"
                    android:id="@+id/insufficient_confirm_btn"
                    android:background="@color/cj_pay_color_red_fe2c55"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <ProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/insufficient_confirm_normal_loading"
                    android:background="@color/cj_pay_color_trans"
                    android:visibility="gone"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_white"
                    android:indeterminateDuration="500"
                    android:indeterminateBehavior="repeat"/>
            </FrameLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:gravity="center_horizontal"
                android:id="@+id/insufficient_other_method_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_alignParentBottom="true"/>
            <include
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/cj_pay_view_half_screen_loading_layout"/>
            <com.android.ttcjpaysdk.base.ui.widget.CJPayTextLoadingView
                android:id="@+id/cj_pay_insufficient_loading_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </RelativeLayout>
    </RelativeLayout>
</FrameLayout>
