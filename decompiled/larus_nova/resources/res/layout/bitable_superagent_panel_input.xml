<?xml version="1.0" encoding="utf-8"?>
<com.larksuite.component.universe_design.shadow.UDShadowLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:ud_shadow_radius="16dp"
    style="@style/UDShadow.S2.Down">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bitable_superagent_input_root"
        android:background="@drawable/bitable_superagent_input_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:minHeight="56dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/bitable_superagent_input_at"
            android:padding="6dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:tint="@color/icon_n1"
            android:contentDescription="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ud_icon_at_outlined"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/bitable_superagent_input_send"
            android:background="@drawable/bitable_superagent_send_disabled_bg"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:tint="@color/udtoken_btn_pri_text_disabled"
            android:contentDescription="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ud_icon_send_colorful"/>
        <com.bytedance.ee.bear.bitable.superagent.voice.BitableSuperAgentVoiceStateButton
            android:id="@+id/bitable_superagent_input_voice"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/bitable_superagent_input_send"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginEnd="0dp"/>
        <com.bytedance.ee.bear.bitable.card.view.cell.text.BitableAtEditText
            android:textSize="16sp"
            android:textColor="@color/text_title"
            android:textColorHint="@color/text_placeholder"
            android:gravity="start|center_vertical"
            android:id="@+id/bitable_superagent_input_edit"
            android:background="@android:color/transparent"
            android:padding="0dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:minHeight="32dp"
            android:hint="@string/Bitable_AISidebar_EnterYourQuestion_Placeholder"
            android:maxLines="4"
            android:includeFontPadding="false"
            android:inputType="textMultiLine"
            android:imeOptions="actionSend"
            android:textCursorDrawable="@null"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/bitable_superagent_input_voice"
            app:layout_constraintStart_toEndOf="@+id/bitable_superagent_input_at"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.larksuite.component.universe_design.shadow.UDShadowLayout>
