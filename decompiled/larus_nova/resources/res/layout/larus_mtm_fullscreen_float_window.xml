<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mtm_fullscreen_root"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <com.larus.business.multitask_management.impl.view.FadeEdgeRecyclerView
        android:layout_gravity="start"
        android:id="@+id/mtm_task_list"
        android:clipToPadding="false"
        android:layout_width="?attr/larus_dp_310"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/larus_dp_40"
        android:layout_marginBottom="?attr/larus_dp_40"
        android:paddingEnd="?attr/larus_dp_12"
        android:layout_marginStart="?attr/larus_dp_12"/>
    <FrameLayout
        android:layout_gravity="start"
        android:id="@+id/mtm_drag_handle_container"
        android:clipChildren="true"
        android:layout_width="?attr/larus_dp_298"
        android:layout_height="?attr/larus_dp_64"
        android:layout_marginStart="?attr/larus_dp_12">
        <View
            android:id="@+id/mtm_drag_handle_overlay"
            android:background="@drawable/larus_mtm_fullscreen_float_window_handle_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/mtm_drag_handle_blur_bg"
            android:layout_width="?attr/larus_dp_64"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <View
            android:id="@+id/mtm_drag_handle_blur_bg_mask"
            android:background="#33000000"
            android:layout_width="?attr/larus_dp_64"
            android:layout_height="match_parent"/>
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/mtm_drag_handle_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/larus_float_window_ic_back"
            android:layout_marginStart="?attr/larus_dp_6"/>
    </FrameLayout>
</FrameLayout>
