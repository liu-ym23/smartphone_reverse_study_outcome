<?xml version="1.0" encoding="utf-8"?>
<com.larksuite.component.ui.layout.LKUIRoundableLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/media_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:rl_border_color="@color/line_border_card"
    app:rl_border_width="1dp"
    app:rl_radius="10dp">
    <ImageView
        android:id="@+id/media_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/media_cover_foreground"
        android:background="@color/lkblack_alpha_30"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.ss.android.lark.widget.DonutProgress
            android:layout_gravity="center"
            android:id="@+id/media_upload_progress"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:donut_background_color="@color/lkui_N00"
            app:donut_circle_starting_degree="270"
            app:donut_finished_color="@color/lkui_B500"
            app:donut_finished_stroke_width="2dp"
            app:donut_progress="50"
            app:donut_text_color="@color/lkui_N900"
            app:donut_text_size="15sp"
            app:donut_unfinished_color="@color/lkui_N300"
            app:donut_unfinished_stroke_width="2dp"/>
        <ImageView
            android:id="@+id/media_media_play"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/media_play"/>
        <ImageView
            android:id="@+id/media_continue_upload"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/media_continue_upload"/>
        <com.ss.android.lark.chat.chatwindow.chat.view.IMCircleLoadingView
            android:layout_gravity="center"
            android:id="@+id/loading_view"
            android:visibility="gone"
            android:layout_width="25dp"
            android:layout_height="25dp"/>
    </LinearLayout>
    <View
        android:layout_gravity="end|bottom"
        android:id="@+id/media_duration_shadow_view"
        android:visibility="gone"
        android:layout_width="84dp"
        android:layout_height="40dp"/>
    <com.ss.android.lark.widget.mark.MarkView
        android:layout_gravity="end|bottom"
        android:id="@+id/media_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_marginEnd="6dp"/>
    <com.ss.android.lark.widget.mark.MarkView
        android:layout_gravity="end|bottom"
        android:id="@+id/resource_is_cleaned_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_marginEnd="6dp"/>
</com.larksuite.component.ui.layout.LKUIRoundableLayout>
