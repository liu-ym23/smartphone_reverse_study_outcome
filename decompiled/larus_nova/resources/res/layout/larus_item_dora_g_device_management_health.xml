<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_dora_card_white_rounded"
    android:padding="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_90"
    android:layout_marginLeft="?attr/larus_dp_16"
    android:layout_marginTop="?attr/larus_dp_12"
    android:layout_marginRight="?attr/larus_dp_16">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/icon"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/larus_ic_dora_health_entry"
            app:tint="@color/larus_neutral_100"/>
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_16"
            android:textColor="@color/larus_neutral_100"
            android:ellipsize="end"
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_g_device_health_title_cn"
            android:maxLines="1"
            android:layout_marginStart="?attr/larus_dp_8"
            app:layout_constraintBottom_toBottomOf="@+id/icon"
            app:layout_constraintStart_toEndOf="@+id/icon"
            app:layout_constraintTop_toTopOf="@+id/icon"/>
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_12"
            android:textColor="@color/larus_primary_50"
            android:gravity="center"
            android:id="@+id/beta_text"
            android:background="@drawable/larus_bg_dora_g_health_beta"
            android:layout_width="?attr/larus_dp_37"
            android:layout_height="?attr/larus_dp_20"
            android:text="@string/larus_dora_g_device_health_beta_cn"
            android:maxLines="1"
            android:layout_marginStart="?attr/larus_dp_6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/title_text"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/action_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_12"
                android:textColor="@color/larus_neutral_50"
                android:ellipsize="end"
                android:id="@+id/action_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_g_device_more_option_cn"
                android:maxLines="1"/>
            <ImageView
                android:layout_width="?attr/larus_dp_12"
                android:layout_height="?attr/larus_dp_12"
                android:src="@drawable/larus_dora_g_device_management_more_icon"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_16"
        android:textColor="@color/larus_neutral_50"
        android:ellipsize="end"
        android:id="@+id/desc_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        android:text="@string/larus_dora_ai_active_health_card_desc_cn"
        android:maxLines="1"
        android:lineSpacingExtra="?attr/larus_dp_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
