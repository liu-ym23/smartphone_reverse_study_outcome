<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coupon_container_cl"
    android:background="@drawable/ec_inflow_freshman_coupon_view_parent_bg"
    android:layout_width="match_parent"
    android:layout_height="40dp">
    <View
        android:background="@drawable/ec_inflow_freshman_coupon_view_bg"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/coupon_left_fl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:layout_gravity="center"
            android:id="@+id/coupon_left_img_dv"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="3dp"/>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp">
            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:id="@+id/coupon_price_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="7dp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ec_coupon_yuan"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </FrameLayout>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:ellipsize="end"
        android:id="@+id/coupon_desc_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/coupon_left_fl"
        app:layout_constraintRight_toLeftOf="@+id/coupon_right_ll"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="end"
        android:id="@+id/coupon_right_ll"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.shopping.feed.resourcecard.view.countdownview.CouponCountDownViewV2
            android:layout_gravity="center_vertical"
            android:id="@+id/coupon_right_count_down"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="11dp"
            android:textColor="#e5161823"
            android:layout_gravity="center_vertical"
            android:id="@+id/coupon_right_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ec_coupon_expire_after"
            android:maxLines="1"
            android:includeFontPadding="false"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/coupon_right_iv"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/commerce_close_coupon_right_icon"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="12dp"/>
    </LinearLayout>
    <View
        android:id="@+id/coupon_right_click"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
