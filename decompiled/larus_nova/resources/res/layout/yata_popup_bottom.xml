<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/commerce_sheet_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/inner_sheet_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/commerce_touch_outside"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:soundEffectsEnabled="false"
            android:contentDescription="@string/ec_cart_close_btn"/>
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/commerce_coordinator"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.android.ui.base.widget.round.RoundFrameLayout
                android:layout_gravity="top|center_horizontal"
                android:orientation="vertical"
                android:id="@+id/commerce_design_sheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_behavior="@string/yata_bottom_sheet_behavior"
                style="?attr/bottomSheetStyle"/>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </FrameLayout>
</FrameLayout>
