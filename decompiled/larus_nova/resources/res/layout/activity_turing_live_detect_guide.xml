<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_agreement_container"
        android:background="@drawable/turing_live_pre_dlg_bg"
        android:layout_width="306dp"
        android:layout_height="wrap_content"
        android:minHeight="328dp"
        android:layout_centerInParent="true">
        <ImageView
            android:layout_width="167dp"
            android:layout_height="140dp"
            android:src="@drawable/turing_live_pre_dlg_icon"
            android:layout_alignParentRight="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="48dp"
            android:layout_marginRight="20dp">
            <TextView
                android:textSize="24dp"
                android:textColor="#282f38"
                android:id="@+id/tv_agreement_title_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/turing_live_detect_pre_dlg_tip_1"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="24dp"
                android:textColor="#282f38"
                android:id="@+id/tv_agreement_title_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="@string/turing_live_detect_pre_dlg_tip_2"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#64666b"
                android:id="@+id/tv_agreement_reason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="21dp"
                android:text="@string/turing_live_detect_agreement_reason"
                android:lineSpacingExtra="3dp"/>
            <RelativeLayout
                android:paddingBottom="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp">
                <CheckBox
                    android:id="@+id/cb_live_detect_agreement"
                    android:layout_width="24dp"
                    android:layout_height="20dp"
                    style="@style/turing_cb_style"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#86909c"
                    android:id="@+id/tv_live_detect_agreement"
                    android:paddingTop="1dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3dp"
                    android:text="我已同意并阅读《xx协议》"
                    android:includeFontPadding="false"
                    android:layout_toRightOf="@+id/cb_live_detect_agreement"/>
            </RelativeLayout>
            <TextView
                android:enabled="false"
                android:textSize="16dp"
                android:textColor="@color/turing_color_white"
                android:gravity="center"
                android:id="@+id/tv_live_detect_confirm_btn"
                android:background="@drawable/bdturing_live_detect_btn"
                android:layout_width="266dp"
                android:layout_height="44dp"
                android:layout_marginTop="3dp"
                android:text="开始检测"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/fl_agreement_cb_tip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="117dp"
            android:layout_alignTop="@+id/ll_container">
            <ImageView
                android:layout_width="71dp"
                android:layout_height="38dp"
                android:layout_marginLeft="14dp"
                android:src="@drawable/turing_live_agreement_tips"/>
        </FrameLayout>
        <TextView
            android:textSize="14dp"
            android:textColor="#cc737a87"
            android:id="@+id/tv_live_detect_help"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:text="@string/turing_live_detect_help"
            android:layout_below="@+id/ll_container"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/loading"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/loading_ic"
        android:layout_centerInParent="true"/>
</RelativeLayout>
