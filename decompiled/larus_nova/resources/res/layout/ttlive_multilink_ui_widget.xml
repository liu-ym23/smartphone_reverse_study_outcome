<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.liveinteract.plantform.commonwindow.CommonLinkSeatWindowView
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/link_seat_window_view_video"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.liveinteract.plantform.commonwindow.audio.VoiceCommonLinkSeatWindowView
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/link_seat_window_view_voice"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</FrameLayout>
