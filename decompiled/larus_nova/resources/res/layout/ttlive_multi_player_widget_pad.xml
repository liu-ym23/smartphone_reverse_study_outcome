<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.livesdk.widget.EdgeTransparentView
        android:id="@+id/background_video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.livesdk.widget.EdgeTransparentView
        android:id="@+id/foreground_video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.livesdk.gift.platform.business.dialog.v2.view.GiftSwitchImageView
        android:id="@+id/switch_button"
        android:visibility="gone"
        android:layout_width="@dimen/ttlive_gift_effect_switch_size"
        android:layout_height="@dimen/ttlive_gift_effect_switch_image_size"/>
    <com.bytedance.android.livesdk.gift.platform.business.dialog.v2.view.NewGiftSwitchImageView
        android:id="@+id/switch_button_new"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
