<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/expand_view"
        android:background="?attr/larus_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="?attr/larus_sp_15"
                android:textColor="?attr/larus_neutral_70"
                android:ellipsize="end"
                android:id="@+id/expand_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_10"
                android:layout_marginBottom="?attr/larus_dp_10"
                android:layout_weight="1"
                android:layout_marginStart="?attr/larus_dp_12"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/export_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="?attr/larus_dp_4"
                app:srcCompat="?attr/larus_ic_card_deep_research_report_export"/>
        </LinearLayout>
        <View
            android:id="@+id/line"
            android:background="?attr/larus_base_2_overlay"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_1"
            app:layout_constraintTop_toBottomOf="@+id/header_container"/>
        <FrameLayout
            android:id="@+id/content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/line">
            <com.larus.common_ui.widget.roundlayout.RoundFrameLayout
                android:id="@+id/sheet_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_12"
                android:layout_marginRight="@dimen/dp_12"
                app:layout_constraintCircleRadius="?attr/larus_dp_8">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/iv_sheet_preview_icon"
                        android:layout_width="?attr/larus_dp_48"
                        android:layout_height="?attr/larus_dp_48"
                        android:layout_marginTop="?attr/larus_dp_16"
                        android:layout_marginBottom="?attr/larus_dp_16"/>
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="?attr/larus_dp_17"
                        android:layout_marginBottom="?attr/larus_dp_17"
                        android:layout_marginStart="?attr/larus_dp_12">
                        <TextView
                            android:textSize="@dimen/dp_17"
                            android:textColor="?attr/larus_neutral_100"
                            android:ellipsize="end"
                            android:id="@+id/tv_sheet_generation_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"/>
                        <TextView
                            android:textSize="@dimen/dp_14"
                            android:textColor="?attr/larus_neutral_50"
                            android:ellipsize="end"
                            android:id="@+id/tv_sheet_generation_sub_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_2"
                            android:maxLines="1"/>
                    </LinearLayout>
                </LinearLayout>
            </com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/sheet_loading"
                android:paddingLeft="?attr/larus_dp_16"
                android:paddingTop="?attr/larus_dp_16"
                android:paddingRight="?attr/larus_dp_16"
                android:paddingBottom="?attr/larus_dp_20"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.bmhome.chat.layout.widget.ShimmerLoadingVIew
                    android:id="@+id/shimmer_view_1"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/larus_dp_20"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.larus.bmhome.chat.layout.widget.ShimmerLoadingVIew
                    android:id="@+id/shimmer_view_2"
                    android:layout_width="0dp"
                    android:layout_height="?attr/larus_dp_20"
                    android:layout_marginTop="?attr/larus_dp_12"
                    app:layout_constraintEnd_toStartOf="@+id/guidelineHalf"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/shimmer_view_1"/>
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/guidelineHalf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_begin="0dp"
                    app:layout_constraintGuide_percent="0.5"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout_small_sheet_generation"
            android:background="@drawable/larus_place_holder_ppt_generation"
            android:paddingLeft="?attr/larus_dp_14"
            android:paddingRight="?attr/larus_dp_14"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_50"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/iv_small_sheet_generation_icon"
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"/>
            <TextView
                android:textSize="@dimen/dp_17"
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:id="@+id/tv_small_sheet_generation_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="?attr/larus_dp_8"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/default_view"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_194"
            android:maxWidth="?attr/larus_dp_340"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/iv_default_sheet_icon"
                android:layout_width="?attr/larus_dp_40"
                android:layout_height="?attr/larus_dp_40"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
