<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/footer_avatar_wrapper"
        android:layout_width="?attr/larus_dp_60"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/footer_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/larus_ic_message_share_pic_main_bot_avatar"/>
        <com.larus.common_ui.widget.ShadowLayout
            android:id="@+id/footer_enterprise_avatar_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:ux_shadow_color="@color/larus_neutral_transparent_2_day"
            app:ux_shadow_offset_x="?attr/larus_dp_0"
            app:ux_shadow_offset_y="?attr/larus_dp_1"
            app:ux_shadow_radius="?attr/larus_dp_11"
            app:ux_shadow_size="?attr/larus_dp_8">
            <FrameLayout
                android:background="@drawable/larus_bg_share_footer_avatar_container"
                android:layout_width="?attr/larus_dp_48"
                android:layout_height="?attr/larus_dp_48"
                android:layout_margin="?attr/larus_dp_6">
                <com.larus.common_ui.widget.roundlayout.CustomRoundImageView
                    android:layout_gravity="center"
                    android:id="@+id/footer_enterprise_avatar"
                    android:layout_width="?attr/larus_dp_40"
                    android:layout_height="?attr/larus_dp_40"
                    android:scaleType="centerCrop"
                    app:cus_corner_radius="?attr/larus_dp_20"/>
            </FrameLayout>
        </com.larus.common_ui.widget.ShadowLayout>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="?attr/larus_dp_6"
        android:paddingEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/footer_avatar_wrapper"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="?attr/larus_dp_16"
            android:textColor="?attr/larus_neutral_100"
            android:id="@+id/footer_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_string_name"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="?attr/larus_dp_12"
            android:textColor="?attr/larus_neutral_70"
            android:id="@+id/footer_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_4"
            android:text="@string/larus_shareChatAsImage_bottom_disclaimer"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/footer_qrcode"
        android:layout_width="?attr/larus_dp_48"
        android:layout_height="?attr/larus_dp_48"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
