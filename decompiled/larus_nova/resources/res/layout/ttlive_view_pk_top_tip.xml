<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_top_tip"
    android:background="#08161823"
    android:layout_width="match_parent"
    android:layout_height="38dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/iv_top_tip"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16sp"
            android:layout_marginRight="8dp"
            app:actualImageScaleType="fitXY"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="18dp"
            android:layout_marginRight="16dp"
            android:layout_weight="1"
            android:layout_marginEnd="16dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="13dp"
                    android:textColor="#161823"
                    android:ellipsize="marquee"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_top_tip"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="18dp"
                    android:singleLine="true"
                    android:layout_weight="1"
                    android:marqueeRepeatLimit="marquee_forever"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="#fe2c55"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_go_setting"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginLeft="4dp"
                    android:minWidth="40dp"
                    android:text="@string/ttlive_interact_pk_duration_go_to_settings"
                    android:singleLine="true"/>
            </LinearLayout>
        </LinearLayout>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/iv_tip_close"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginRight="16dp"
            android:layout_marginEnd="16dp"
            app:actualImageResource="@drawable/ttlive_ic_pk_top_tip_close"
            app:placeholderImage="@drawable/ttlive_ic_pk_top_tip_close"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
