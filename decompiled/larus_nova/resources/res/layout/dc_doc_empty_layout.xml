<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"
        layout="@layout/dc_doc_loading_layout"/>
    <com.bytedance.ee.bear.widgets.universedesign.SpaceEmptyState
        android:id="@+id/facade_no_data_empty_state"
        android:visibility="gone"
        android:layout_marginBottom="120dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ud_empty_desc="@string/Doc_Facade_LoadFailed"
        app:ud_empty_imageRes="@drawable/ccm_empty_negative_load_failed"
        style="@style/SpaceEmptyStatusStyle"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#8f959e"
        android:id="@+id/err_code"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="42dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <com.larksuite.component.universe_design.button.UDButton
        android:textSize="@dimen/dp_16"
        android:textColor="@color/static_white"
        android:gravity="center_vertical"
        android:id="@+id/btn_back_source_doc"
        android:paddingLeft="@dimen/dp_16"
        android:paddingRight="@dimen/dp_16"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/space_kit_len_36"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/LarkCCM_Docx_VersionMgmt_View_Back2Ori_Button"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/facade_no_data_empty_state"
        app:ud_backgroundColor="@color/primary_fill_default"
        app:ud_radius="m"/>
</androidx.constraintlayout.widget.ConstraintLayout>
