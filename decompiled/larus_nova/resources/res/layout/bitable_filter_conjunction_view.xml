<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/space_kit_font_16"
        android:textColor="@color/text_title"
        android:id="@+id/conjunction_prefix_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.bytedance.ee.bear.bitable.common.widgets.conditioncard.ConditionCellView
        android:id="@+id/conjunction_value_cell"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_kit_len_8"
        android:layout_marginEnd="@dimen/space_kit_len_8"/>
    <TextView
        android:textSize="@dimen/space_kit_font_16"
        android:textColor="@color/text_title"
        android:ellipsize="end"
        android:id="@+id/conjunction_suffix_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"/>
</merge>
