<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:gravity="center_vertical"
        android:id="@+id/map_pick_location_container"
        android:paddingTop="@dimen/space_kit_len_9"
        android:paddingBottom="@dimen/space_kit_len_9"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_kit_len_10"
        android:paddingEnd="@dimen/space_kit_len_12">
        <FrameLayout
            android:layout_gravity="end"
            android:id="@+id/map_pick_location_icon_container"
            android:layout_width="@dimen/space_kit_len_26"
            android:layout_height="@dimen/space_kit_len_26">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/map_pick_location_icon"
                android:layout_width="@dimen/space_kit_len_18"
                android:layout_height="@dimen/space_kit_len_18"
                android:tint="@color/icon_n2"
                app:srcCompat="@drawable/ud_icon_local_outlined"/>
        </FrameLayout>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/location_des_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/space_kit_font_14"
            android:textColor="@color/text_title"
            android:layout_gravity="center"
            android:id="@+id/location_title"
            android:paddingTop="@dimen/space_kit_len_9"
            android:paddingBottom="@dimen/space_kit_len_9"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="@dimen/space_kit_len_13"
            android:paddingEnd="@dimen/space_kit_len_13"/>
        <FrameLayout
            android:id="@+id/location_edit_icon_container"
            android:layout_width="@dimen/space_kit_len_26"
            android:layout_height="@dimen/space_kit_len_26"
            android:layout_marginEnd="@dimen/space_kit_len_12">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/location_edit_icon"
                android:layout_width="@dimen/space_kit_len_18"
                android:layout_height="@dimen/space_kit_len_18"
                android:tint="@color/icon_n2"
                app:srcCompat="@drawable/ud_icon_edit_outlined"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
