<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="enterAlways|scroll">
            <com.bytedance.ee.bear.widgets.BaseTitleBar
                android:gravity="center_vertical"
                android:id="@+id/wiki_title_bar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/doc_titlebar_height"
                android:contentDescription="title_bar"
                app:widget_widgets_tb_divider_visible="false"/>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/decor"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.ee.bear.wikiv2.searchv2.WikiSearchPickerView
            android:id="@+id/wiki_search_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/wiki_operate_divider"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.ee.bear.wikiv2.wikitreev2.widget.view.WikiTreeCtrlView
            android:id="@+id/wiki_tree_ctrl_view"
            android:background="@color/bg_body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_kit_len_54"
            app:layout_constraintBottom_toTopOf="@+id/wiki_operate_divider"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/wiki_operate_divider"
            android:background="@color/line_divider_default"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_kit_len_divider"
            android:layout_marginBottom="@dimen/space_kit_len_18"
            app:layout_constraintBottom_toTopOf="@+id/wiki_operate_button"/>
        <Button
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/static_white"
            android:gravity="center"
            android:id="@+id/wiki_operate_button"
            android:layout_height="@dimen/space_kit_len_44"
            android:layout_marginTop="@dimen/space_kit_len_18"
            android:layout_marginBottom="@dimen/space_kit_len_18"
            android:text="@string/Doc_Wiki_Confirm"
            android:layout_marginStart="@dimen/space_kit_len_20"
            android:layout_marginEnd="@dimen/space_kit_len_20"
            app:layout_constraintBottom_toBottomOf="parent"
            style="@style/SpaceKitBtn1Level1"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/wiki_operate_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="wiki_operate_divider, wiki_operate_button"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
