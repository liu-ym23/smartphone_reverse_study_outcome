<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#131415"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp">
        <com.bytedance.android.live.uikit.rtl.AutoRTLImageView
            android:id="@+id/back_btn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="16dp"
            android:src="@drawable/ttlive_feed_titlebar_back"
            android:layout_alignParentLeft="true"
            android:contentDescription="@string/ttlive_core_label_back"
            android:layout_marginStart="16dp"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="17dp"
            android:textColor="@color/ttlive_std_text_white_2"
            android:ellipsize="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_feed_appointment_fragment_title"
            android:maxLines="1"
            android:layout_centerInParent="true"
            android:layout_marginStart="88dp"
            android:layout_marginEnd="88dp"/>
    </RelativeLayout>
    <View
        android:background="#14ffffff"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <RelativeLayout
        android:background="@drawable/ttlive_bg_appointment"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:background="@drawable/ttlive_appointment_fragment_decorator_1"
            android:layout_width="112dp"
            android:layout_height="96dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:background="@drawable/ttlive_appointment_decorator_2"
            android:layout_width="56dp"
            android:layout_height="104dp"
            android:layout_marginTop="53dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:background="@drawable/ttlive_appointment_decorator_3"
            android:layout_width="115dp"
            android:layout_height="140dp"
            android:layout_marginTop="437dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"/>
        <com.bytedance.android.livesdk.chatroom.ui.pullrefresh.DoubleBallSwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:paddingLeft="@dimen/ttlive_dimen_feed_left_rignt_blanck"
                android:paddingRight="@dimen/ttlive_dimen_feed_left_rignt_blanck"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:paddingStart="@dimen/ttlive_dimen_feed_left_rignt_blanck"
                android:paddingEnd="@dimen/ttlive_dimen_feed_left_rignt_blanck"/>
        </com.bytedance.android.livesdk.chatroom.ui.pullrefresh.DoubleBallSwipeRefreshLayout>
    </RelativeLayout>
</LinearLayout>
