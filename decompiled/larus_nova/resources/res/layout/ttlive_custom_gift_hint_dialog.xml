<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/ttlive_shape_custom_gift_dialog_bg"
        android:layout_width="280dp"
        android:layout_height="195dp">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_color161823"
            android:id="@+id/custom_gift_hint_dialog_hint"
            android:layout_width="225dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"/>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/ttlive_colorfe2c55"
                android:id="@+id/custom_gift_hint_dialog_buy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/custom_gift_hint_dialog_continue_send_layout"
            android:background="@drawable/ttlive_custom_gift_hint_dialog_send_bg"
            android:layout_width="237dp"
            android:layout_height="38dp"
            android:layout_marginTop="23dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:id="@+id/custom_gift_hint_dialog_continue_send"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_custom_gift_dialog_send"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/white"
                android:id="@+id/custom_gift_hint_dialog_continue_send_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/custom_gift_hint_dialog_continue_send"
                android:layout_toEndOf="@+id/custom_gift_hint_dialog_continue_send"/>
        </RelativeLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/custom_gift_hint_dialog_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:src="@drawable/ttlive_custom_gift_hint_dialog_close"/>
</LinearLayout>
