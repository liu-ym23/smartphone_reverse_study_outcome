<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/ec_store_sub_tab_layout_item_height">
    <TextView
        android:textSize="17dp"
        android:textColor="#bf161823"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/ec_store_sub_tab_layout_item_text"
        android:paddingLeft="10dp"
        android:paddingTop="1dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:lines="1"
        android:includeFontPadding="false"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"/>
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:layout_gravity="center"
        android:id="@+id/ec_store_sub_tab_layout_item_icon"
        android:visibility="gone"
        android:layout_width="66dp"
        android:layout_height="@dimen/ec_store_sub_tab_layout_item_height"
        android:minWidth="34dp"
        app:layoutMode="width_self_adjust"/>
</FrameLayout>
