<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_basic_text_1"
        android:ellipsize="end"
        android:id="@+id/dora_obric_earbuds_settings_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Title_1_Regular"/>
    <com.obric.oui.badge.OBadgeView
        android:id="@+id/dora_obric_earbuds_settings_title_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/dora_obric_earbuds_settings_title"
        app:layout_constraintStart_toEndOf="@+id/dora_obric_earbuds_settings_title"
        app:layout_constraintTop_toTopOf="@+id/dora_obric_earbuds_settings_title"
        style="@style/OBadgeView.S1.Default.Red"/>
</androidx.constraintlayout.widget.ConstraintLayout>
