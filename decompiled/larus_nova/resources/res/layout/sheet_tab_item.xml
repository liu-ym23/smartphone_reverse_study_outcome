<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/sheet_tab_item_layout"
    android:background="@drawable/sheet_tab_item_background_selector"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/space_kit_len_34"
    android:minWidth="@dimen/space_kit_len_72"
    android:contentDescription="sheet_tab_item">
    <LinearLayout
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:id="@+id/iv_tab_color"
        android:layout_width="0dp"
        android:layout_height="@dimen/space_kit_len_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_kit_len_34"
        android:paddingStart="@dimen/space_kit_len_12"
        android:paddingEnd="@dimen/space_kit_len_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/iv_custom_icon"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="@dimen/space_kit_len_14"
            android:layout_height="@dimen/space_kit_len_14"
            android:scaleType="fitCenter"
            android:layout_marginEnd="@dimen/dp_4"
            app:srcCompat="@drawable/icon_global_sheetapp_nor"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/iv_locked_sheet"
            android:focusable="true"
            android:layout_width="@dimen/space_kit_len_14"
            android:layout_height="@dimen/space_kit_len_14"
            android:tint="@color/sheet_tab_item_lock_color_selector"
            android:layout_marginEnd="@dimen/dp_4"
            app:srcCompat="@drawable/ud_icon_lock_outlined"/>
        <TextView
            android:textSize="@dimen/space_kit_font_13"
            android:textColor="@drawable/sheet_tab_item_text_selector"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_sheet_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_manage_sheet"
            android:visibility="gone"
            android:layout_width="@dimen/space_kit_len_12"
            android:layout_height="@dimen/space_kit_len_12"
            android:tint="@color/sheet_tab_manage_icon"
            android:layout_marginStart="@dimen/space_kit_len_4"
            app:srcCompat="@drawable/ud_icon_expand_down_filled"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
