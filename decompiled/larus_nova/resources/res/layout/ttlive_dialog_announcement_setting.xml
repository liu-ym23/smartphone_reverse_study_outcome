<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mLlAnnouncementDialogRoot"
    android:background="@drawable/ttlive_bg_prelive_setting"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/mLlAnnouncementDialogContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_white"
            android:layout_gravity="center_horizontal"
            android:id="@+id/mTvAnnouncementDialogTitle"
            android:padding="18dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="直播公告"/>
        <View
            android:id="@+id/mTvAnnouncementDialogDividerLine1"
            android:background="@color/ttlive_douyin_dark_DialogDivider"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <TextView
            android:textSize="12dp"
            android:gravity="center_vertical"
            android:id="@+id/mTvAnnouncementDialogAuditStatus"
            android:background="@color/ttlive_douyin_BGBrand2"
            android:paddingLeft="15dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:drawableLeft="@drawable/ttlive_ic_announcement_dark_audit_stauts_tip"
            android:drawablePadding="5dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_white_50"
            android:id="@+id/mTvAnnouncementTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="15dp"
            android:lineSpacingExtra="3dp"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="15dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="15dp"
                android:textColor="@color/ttlive_white_90"
                android:id="@+id/mTvAnnouncementDialogTimeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="开播时间"
                android:layout_centerVertical="true"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14dp"
                android:textColor="@color/ttlive_white_50"
                android:id="@+id/mTvAnnouncementDialogTimeDesc"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="请选择"
                android:drawableRight="@drawable/ttlive_ic_announcement_entry_arrow"
                android:drawablePadding="8dp"
                android:layout_alignParentRight="true"
                android:drawableEnd="@drawable/ttlive_ic_announcement_entry_arrow"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <View
            android:id="@+id/mTvAnnouncementDialogDividerLine2"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="15dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="13dp"
            android:id="@+id/mTvAnnouncementDialogContentTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="15dp"
            android:text="公告内容"
            android:alpha="0.5"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mEtAnnouncementDialogEtContentParent"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="15dp">
            <EditText
                android:textSize="13dp"
                android:textColor="#ccffffff"
                android:gravity="top|left"
                android:id="@+id/mEtAnnouncementDialogContent"
                android:background="@drawable/ttlive_bg_announcement_content_edit_text"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="说说想直播的内容..."
                android:inputType="textMultiLine"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/mLlAnnouncementSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <TextView
                    android:textSize="11dp"
                    android:textColor="@color/ttlive_white"
                    android:id="@+id/mTtAnnouncementSwitchContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="换一换"
                    android:drawableLeft="@drawable/ttlive_ic_announcement_dark_content_switch"
                    android:drawablePadding="3dp"/>
                <TextView
                    android:textSize="11dp"
                    android:textColor="#ff0000"
                    android:id="@+id/mTvAnnouncementInputTip"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_white"
            android:gravity="center"
            android:id="@+id/mTvAnnouncementSubmitBtn"
            android:background="@drawable/ttlive_bg_announcement_submit_btn_selector"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="10dp"
            android:text="提交"/>
    </LinearLayout>
    <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
        android:layout_gravity="center"
        android:id="@+id/mDcbLoadingView"
        android:layout_width="36dp"
        android:layout_height="36dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_douyin_dark_TextPrimary"
        android:gravity="center"
        android:id="@+id/mTvNetError"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="请检查网络连接后重试"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</FrameLayout>
