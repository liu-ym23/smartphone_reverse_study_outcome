<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
            android:layout_gravity="center_horizontal"
            android:id="@+id/preload_progress_icon_double_ball"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/ttlive_pk_userlist_refresh_progress_anim"
            android:indeterminateBehavior="repeat"/>
        <ProgressBar
            android:layout_gravity="center_horizontal"
            android:id="@+id/preload_progress_icon_normal"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="10dp"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/ttlive_pk_userlist_refresh_progress_anim"
            android:indeterminateBehavior="repeat"/>
        <com.bytedance.android.live.revlink.impl.pk.ui.PkTopTipView
            android:id="@+id/top_tip_view"
            android:duplicateParentState="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/tv_empty"
            android:paddingBottom="20dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_live_interact_user_list_tip1"/>
            <TextView
                android:textSize="16dp"
                android:id="@+id/user_list_empty_tips_line_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_live_interact_user_list_tip2"/>
        </LinearLayout>
        <com.bytedance.android.live.ui.PkInviteUserListRefreshLayout
            android:id="@+id/userlist_swipe_refresh_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="10dp">
                <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
                    android:layout_gravity="center"
                    android:id="@+id/userlist_refresh_progress_double_ball"
                    android:visibility="gone"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="10dp"
                    android:indeterminate="true"
                    android:indeterminateDrawable="@drawable/ttlive_pk_userlist_refresh_progress_anim"
                    android:indeterminateBehavior="repeat"/>
                <ProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/userlist_refresh_progress_normal"
                    android:visibility="gone"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminate="true"
                    android:indeterminateDrawable="@drawable/ttlive_pk_userlist_refresh_progress_anim"
                    android:indeterminateBehavior="repeat"/>
            </FrameLayout>
            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.google.android.material.appbar.AppBarLayout
                    android:id="@+id/app_bar_layout"
                    android:background="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:elevation="0dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_scrollFlags="scroll">
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_scrollFlags="enterAlways|scroll">
                            <androidx.appcompat.widget.Toolbar
                                android:id="@+id/search_container"
                                android:background="@drawable/ttlive_bg_pk_rivals_search_opt"
                                android:visibility="visible"
                                android:layout_width="match_parent"
                                android:layout_height="36dp"
                                android:layout_marginLeft="16dp"
                                android:layout_marginTop="8dp"
                                android:layout_marginRight="16dp"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="16dp"
                                app:contentInsetEnd="0dp"
                                app:contentInsetStart="0dp">
                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">
                                    <TextView
                                        android:textSize="13dp"
                                        android:textColor="#57161823"
                                        android:id="@+id/tv_search"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/ttlive_interact_anchor_link_search_hint_default"
                                        android:singleLine="true"
                                        android:layout_toRightOf="@+id/iv_search"
                                        android:layout_centerVertical="true"
                                        android:layout_toEndOf="@+id/iv_search"/>
                                    <ImageView
                                        android:id="@+id/iv_search"
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_marginLeft="4dp"
                                        android:src="@drawable/ttlive_ic_pk_search_list"
                                        android:layout_centerVertical="true"
                                        android:layout_marginStart="4dp"/>
                                </RelativeLayout>
                            </androidx.appcompat.widget.Toolbar>
                        </FrameLayout>
                        <FrameLayout
                            android:id="@+id/top_banner"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginLeft="16dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginRight="16dp"
                            app:layout_scrollFlags="scroll"/>
                        <FrameLayout
                            android:id="@+id/link_random"
                            android:visibility="visible"
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:layout_marginLeft="16dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginRight="16dp"/>
                    </LinearLayout>
                </com.google.android.material.appbar.AppBarLayout>
                <com.bytedance.android.live.revlink.impl.pk.ui.PkItemExposeRecyclerViewOpt
                    android:id="@+id/recycler_view"
                    android:background="@color/ttlive_core_hs_w1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
                <FrameLayout
                    android:id="@+id/tab_title_placeholder"
                    android:background="@color/ttlive_core_hs_w1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </androidx.coordinatorlayout.widget.CoordinatorLayout>
        </com.bytedance.android.live.ui.PkInviteUserListRefreshLayout>
    </LinearLayout>
    <TextView
        android:textSize="11dp"
        android:textStyle="normal"
        android:textColor="@color/ttlive_pk_rule_text_color"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/private_hint"
        android:background="@color/ttlive_core_hs_w1"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:translationZ="10dp"
        android:elevation="10dp"/>
</FrameLayout>
