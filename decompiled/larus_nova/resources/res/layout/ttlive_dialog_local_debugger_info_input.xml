<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="80dp">
    <TextView
        android:textSize="13dp"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/tv_appId"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="appId : "
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <EditText
        android:textSize="13dp"
        android:id="@+id/et_appId"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="appId（必填）"
        app:layout_constraintLeft_toRightOf="@+id/tv_appId"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13dp"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/tv_gameId"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="gameId : "
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_appId"/>
    <EditText
        android:textSize="13dp"
        android:id="@+id/et_gameId"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="gameId（选填，app/start 需要）"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/tv_gameId"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_appId"/>
</androidx.constraintlayout.widget.ConstraintLayout>
