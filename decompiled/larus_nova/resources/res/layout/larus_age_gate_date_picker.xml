<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/parent_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.larus.common_ui.widget.datepicker.NumberPicker
        android:id="@+id/year_picker"
        android:paddingTop="12.5dp"
        android:paddingBottom="12.5dp"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:larus_backgroundColor="?attr/larus_base_1"
        app:larus_currentNumber="16"
        app:larus_dateTextColor="?attr/larus_neutral_100"
        app:larus_dateTextShadowColor="?attr/larus_neutral_30"
        app:larus_dateTextSize="21sp"
        app:larus_dividerColor="@android:color/transparent"
        app:larus_endNumber="2100"
        app:larus_rowNumber="7"
        app:larus_startNumber="1900"
        app:larus_verticalSpacing="30dp"/>
    <com.larus.common_ui.widget.datepicker.NumberPicker
        android:id="@+id/month_picker"
        android:paddingTop="12.5dp"
        android:paddingBottom="12.5dp"
        android:layout_width="108dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:larus_backgroundColor="?attr/larus_base_1"
        app:larus_currentNumber="11"
        app:larus_dateTextColor="?attr/larus_neutral_100"
        app:larus_dateTextShadowColor="?attr/larus_neutral_30"
        app:larus_dateTextSize="21sp"
        app:larus_dividerColor="@android:color/transparent"
        app:larus_endNumber="12"
        app:larus_rowNumber="7"
        app:larus_startNumber="1"
        app:larus_verticalSpacing="30dp"/>
    <com.larus.common_ui.widget.datepicker.NumberPicker
        android:id="@+id/day_picker"
        android:paddingTop="12.5dp"
        android:paddingBottom="12.5dp"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:larus_backgroundColor="?attr/larus_base_1"
        app:larus_currentNumber="1900"
        app:larus_dateTextColor="?attr/larus_neutral_100"
        app:larus_dateTextShadowColor="?attr/larus_neutral_30"
        app:larus_dateTextSize="21sp"
        app:larus_dividerColor="@android:color/transparent"
        app:larus_endNumber="31"
        app:larus_rowNumber="7"
        app:larus_startNumber="1"
        app:larus_verticalSpacing="30dp"/>
</LinearLayout>
