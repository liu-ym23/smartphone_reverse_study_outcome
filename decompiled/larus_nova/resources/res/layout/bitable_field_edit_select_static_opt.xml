<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/space_kit_font_14"
        android:textColor="@color/text_placeholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_kit_len_4"
        android:text="@string/Bitable_BTModule_AddOptions"/>
    <com.larksuite.component.ui.layout.LKUIRoundableLayout
        android:id="@+id/optionListContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_kit_len_16"
        app:rl_radius="@dimen/space_radius_xl">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/optionListRV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.larksuite.component.ui.layout.LKUIRoundableLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/addNewOptionBtn"
        android:background="@drawable/facade_round_around_xl"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_kit_len_48"
        android:layout_marginBottom="@dimen/space_kit_len_16"
        android:paddingStart="@dimen/space_kit_len_16"
        android:paddingEnd="@dimen/space_kit_len_16"
        android:backgroundTint="@color/facade_selector_item_float">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/space_kit_len_20"
            android:layout_height="@dimen/space_kit_len_20"
            android:tint="@color/primary_fill_default"
            app:srcCompat="@drawable/ud_icon_add_outlined"/>
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/primary_fill_default"
            android:ellipsize="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Bitable_BTModule_AddOptions"
            android:singleLine="true"
            android:layout_marginStart="@dimen/space_kit_len_12"/>
    </LinearLayout>
</merge>
