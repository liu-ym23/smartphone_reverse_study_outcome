<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:id="@+id/ll_container"
    android:background="@drawable/trade_goods_detail_collect_pop_bg"
    android:padding="12dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.bytedance.dux.text.DuxTextView
        android:textColor="@color/ConstTextInverse"
        android:layout_gravity="center_vertical"
        android:id="@+id/trade_goods_detail_collect_pop_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/trade_detail_has_add_collect"
        style="@style/font_size_26"/>
    <View
        android:layout_gravity="center_vertical"
        android:id="@+id/trade_goods_detail_collect_divider"
        android:background="@color/ConstLineInverse"
        android:layout_width="1dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"/>
    <com.bytedance.dux.text.DuxTextView
        android:textColor="@color/Secondary"
        android:layout_gravity="center_vertical"
        android:id="@+id/trade_goods_detail_collect_pop_link_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/poi_go_dou_detail"
        style="@style/font_size_26"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/trade_goods_detail_collect_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:src="@drawable/trade_collect_pop_gosee_icon"
        android:layout_marginStart="5dp"/>
</LinearLayout>
