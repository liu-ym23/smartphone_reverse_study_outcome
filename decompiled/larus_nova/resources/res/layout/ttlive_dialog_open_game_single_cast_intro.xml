<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_open_game_single_cast_intro"
    android:layout_width="match_parent"
    android:layout_height="484dp"
    android:paddingStart="@dimen/ttlive_open_platform_dialog_content_padding"
    android:paddingEnd="@dimen/ttlive_open_platform_dialog_content_padding">
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_color_161823"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/ttlive_open_platform_single_screencast_dialog_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.chatroom.ui.LiveRoundDraweeImageView
        android:id="@+id/drawee_cast_image_desc1"
        android:layout_width="141dp"
        android:layout_height="251dp"
        android:layout_marginTop="18dp"
        app:layout_constraintEnd_toStartOf="@+id/drawee_cast_image_desc2"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        app:ttlive_radius="12dp"/>
    <com.bytedance.android.livesdk.chatroom.ui.LiveRoundDraweeImageView
        android:id="@+id/drawee_cast_image_desc2"
        android:layout_width="141dp"
        android:layout_height="251dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="18dp"
        android:layout_marginStart="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/drawee_cast_image_desc1"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        app:ttlive_radius="12dp"/>
    <TextView
        android:textColor="@color/ttlive_color_161823_alpha75"
        android:id="@+id/tv_cast_introduction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/ttlive_open_platform_single_screencast_dialog_intro"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/drawee_cast_image_desc1"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_confirm"
        android:background="@drawable/ttlive_bg_game_dialog_red_corner_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:text="@string/ttlive_open_platform_single_screencast_dialog_start1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_cast_introduction"/>
</androidx.constraintlayout.widget.ConstraintLayout>
