<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:scaleType="fitXY"
        app:srcCompat="@drawable/bitable_form_header_bg"/>
    <com.larksuite.component.universe_design.notice.UDNotice
        android:id="@+id/form_header_tip"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ud_notice_icon="@drawable/ud_icon_warning_colorful"
        app:ud_notice_iconColorful="true"
        app:ud_notice_text="@string/Bitable_Billing_RecordReachLimitInCurrentTable_Description"
        app:ud_notice_textBtn="@string/Bitable_Billing_HelpDoc_Common"
        style="@style/UDNotice.Warning"/>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_title"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/form_header_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="@dimen/bitable_form_horizon_margin"
        android:layout_marginEnd="@dimen/bitable_form_horizon_margin"/>
    <com.bytedance.ee.bear.bitable.card.view.description.expandabletext.ExpandableTextLayout
        android:id="@+id/form_header_subtitle_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="@dimen/bitable_form_horizon_margin"
        android:layout_marginEnd="@dimen/bitable_form_horizon_margin"
        app:maxLines="4">
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="16sp"
            android:textColor="@color/text_title"
            android:id="@+id/form_header_subtitle"
            android:background="@null"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:cursorVisible="false"/>
    </com.bytedance.ee.bear.bitable.card.view.description.expandabletext.ExpandableTextLayout>
</LinearLayout>
