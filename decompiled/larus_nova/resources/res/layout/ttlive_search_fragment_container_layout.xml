<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/live_search_empty_feed_container"
        android:paddingTop="4dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="#32ffffff"
            android:layout_width="66dp"
            android:layout_height="0.5dp"
            android:layout_marginTop="8dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#57ffffff"
            android:gravity="center"
            android:id="@+id/live_search_empty_feed"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:background="#32ffffff"
            android:layout_width="66dp"
            android:layout_height="0.5dp"
            android:layout_marginTop="8dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:background="@color/ttlive_search_bg_container"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/live_search_empty_feed_container"
        android:overScrollMode="never"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/empty_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="240dp"
            android:layout_height="160dp"
            android:layout_marginTop="177dp"
            android:src="@drawable/ttlive_empty_search_result"/>
        <TextView
            android:textSize="17dp"
            android:textColor="#e6ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/ttlive_search_result_empty"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#80ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ttlive_search_result_empty_try"/>
    </LinearLayout>
    <RelativeLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/limit_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/limit_layout_normal"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="240dp"
                android:layout_height="160dp"
                android:layout_marginTop="116dp"
                android:src="@drawable/ttlive_empty_search_result"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#80ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ttlive_search_limit"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/limit_layout_login"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <ImageView
                android:layout_width="240dp"
                android:layout_height="160dp"
                android:layout_marginTop="116dp"
                android:src="@drawable/ttlive_search_img_search_need_login"/>
            <TextView
                android:textSize="17dp"
                android:textColor="#e6ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/ttlive_search_need_login"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#80ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ttlive_search_need_login_desc"/>
            <TextView
                android:textSize="13dp"
                android:textStyle="bold"
                android:textColor="#e6ffffff"
                android:gravity="center"
                android:id="@+id/ttlive_search_login"
                android:background="@drawable/ttlive_search_login_bg"
                android:layout_width="112dp"
                android:layout_height="36dp"
                android:layout_marginTop="32dp"
                android:text="@string/ttlive_search_login"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/network_error_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="240dp"
            android:layout_height="160dp"
            android:layout_marginTop="116dp"
            android:src="@drawable/ttlive_search_networ_error"/>
        <TextView
            android:textSize="17dp"
            android:textColor="#e6ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/ttlive_search_network_error"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#80ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ttlive_search_retry_tip"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#e6ffffff"
            android:gravity="center"
            android:id="@+id/search_retry"
            android:background="@drawable/ttlive_search_retry_bg"
            android:layout_width="112dp"
            android:layout_height="36dp"
            android:layout_marginTop="32dp"
            android:text="@string/ttlive_search_retry"/>
    </LinearLayout>
</RelativeLayout>
