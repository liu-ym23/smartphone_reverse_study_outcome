<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_room_notice_dialog"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/top_image_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.android.livesdk.chatroom.ui.LiveRoundImageView
            android:id="@+id/top_image"
            android:layout_width="83dp"
            android:layout_height="81dp"
            android:layout_marginTop="19dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentRight="true"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/top_close"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:scaleType="centerInside"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true"
            custom:placeholderImage="@drawable/ttlive_ic_hs_room_center_dialog_close"
            custom:placeholderImageScaleType="centerCrop"/>
    </RelativeLayout>
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_room_notice_dialog_main_textcolor"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/room_center_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:includeFontPadding="false"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_room_notice_dialog_minor_textcolor"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/room_center_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <View
        android:id="@+id/live_dialog_divider_1"
        android:layout_marginTop="24dp"
        style="@style/ttlive_live_dialog_divider_horizontal"/>
    <Button
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_room_notice_dialog_main_textcolor"
        android:id="@+id/room_center_button"
        android:background="@drawable/ttlive_bg_room_review_dialog_btn"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="47dp"/>
    <include
        android:id="@+id/room_center_button_layout"
        layout="@layout/ttlive_dialog_item_room_jsb_two_btn_layout"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_room_center_bottom_tip"
        android:gravity="center"
        android:id="@+id/room_center_bottom_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:drawableLeft="@drawable/ttlive_ic_illegal_warning"
        android:drawablePadding="8dp"
        android:lineSpacingExtra="2dp"
        android:drawableStart="@drawable/ttlive_ic_illegal_warning"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
</LinearLayout>
