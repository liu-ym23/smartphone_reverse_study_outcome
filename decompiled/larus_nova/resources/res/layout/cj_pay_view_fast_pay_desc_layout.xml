<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cj_pay_height_470">
    <include
        android:id="@+id/cj_pay_titlebar_root_view"
        layout="@layout/cj_pay_view_titlebar_layout"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="49.5dp">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/fast_pay_more_promotion_container"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="16dp">
                <TextView
                    android:textSize="14dp"
                    android:textColor="#161823"
                    android:id="@+id/fast_pay_more_prom_title"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"/>
            </LinearLayout>
            <TextView
                android:textSize="13dp"
                android:textColor="#bf161823"
                android:id="@+id/fast_pay_more_prom_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="6sp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#161823"
                android:id="@+id/fast_pay_more_desc_title"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="19dp"/>
            <com.android.ttcjpaysdk.thirdparty.counter.view.FastPayMoreDescView
                android:orientation="vertical"
                android:id="@+id/fast_pay_desc_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
    </ScrollView>
    <TextView
        android:textSize="13dp"
        android:textColor="#80161823"
        android:gravity="center_vertical"
        android:id="@+id/fast_pay_more_agreement"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="76dp"
        android:layout_alignParentBottom="true"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:layout_alignParentBottom="true">
        <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
            android:textSize="@dimen/cj_pay_font_size_15"
            android:textColor="@color/cj_pay_color_white"
            android:gravity="center"
            android:id="@+id/fast_pay_more_btn"
            android:background="@drawable/cj_pay_base_bg_red_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_custom_button_height_44"/>
        <ProgressBar
            android:id="@+id/fast_pay_more_btn_loading"
            android:background="@color/cj_pay_color_trans"
            android:visibility="gone"
            android:layout_width="@dimen/cj_pay_padding_20"
            android:layout_height="@dimen/cj_pay_padding_20"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/cj_pay_fast_pay_bg_loading"
            android:indeterminateDuration="500"
            android:indeterminateBehavior="repeat"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</RelativeLayout>
