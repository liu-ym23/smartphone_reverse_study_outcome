<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="118dp"
    android:layout_height="118dp"
    android:layout_marginTop="4dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp">
    <com.bytedance.lighten.loader.SmartImageView
        android:id="@+id/live_life_shelf_product_img_iv"
        android:layout_width="118dp"
        android:layout_height="118dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.lighten.loader.SmartImageView
        android:id="@+id/live_life_shelf_product_img_border_iv"
        android:layout_width="118dp"
        android:layout_height="118dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.lighten.loader.SmartImageView
        android:id="@+id/live_life_shelf_product_image_new_tag"
        android:visibility="gone"
        android:layout_width="90dp"
        android:layout_height="28dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.dux.text.DuxTextView
        android:textSize="14dp"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/live_life_shelf_product_serial_number"
        android:background="@drawable/bg_live_local_life_order"
        android:layout_width="28dp"
        android:layout_height="20dp"
        android:maxLines="1"
        android:fontFamily="PingFangSC"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.lighten.loader.SmartImageView
        android:id="@+id/live_life_shelf_product_image_tag"
        android:visibility="gone"
        android:layout_width="62dp"
        android:layout_height="20dp"
        app:layout_constraintStart_toEndOf="@+id/live_life_shelf_product_serial_number"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/live_life_shelf_product_explaining_container"
        android:background="@drawable/bg_poi_live_goods_shelves_explaining"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/live_life_shelf_product_explaining_lottie"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="26dp"/>
        <com.bytedance.dux.text.DuxTextView
            android:textSize="12dp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:id="@+id/live_life_shelf_product_explaining_text"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:text="@string/live_local_life_shelf_explaining_text"
            android:maxLines="1"
            android:fontFamily="PingFangSC"
            android:layout_marginStart="1dp"/>
    </LinearLayout>
    <com.bytedance.dux.text.DuxTextView
        android:textSize="12dp"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/live_life_shelf_product_status_tv"
        android:background="#80000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:maxLines="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
