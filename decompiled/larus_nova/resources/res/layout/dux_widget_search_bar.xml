<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.dux.image.DuxImageView
        android:id="@+id/iv_back"
        android:visibility="visible"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_s_s_arrowleft_outlined"
        app:layout_constraintBottom_toBottomOf="@+id/input_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/input_view"
        app:tint="@color/TextPrimary"/>
    <com.bytedance.dux.forms.DuxLineInputView
        android:id="@+id/input_view"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:formInputHeight="36dp"
        app:formShowClear="true"
        app:formShowDivider="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/action_container"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/iv_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="0dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/action_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/input_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/input_view">
        <com.bytedance.dux.image.DuxImageView
            android:id="@+id/iv_search_action"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="19dp"
            app:tint="@color/TextPrimary"/>
        <com.bytedance.dux.text.DuxTextView
            android:textColor="@color/TextPrimary"
            android:id="@+id/tv_search_action"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dux_search"
            android:layout_marginEnd="16dp"
            app:textSpec="H4"/>
    </LinearLayout>
</merge>
