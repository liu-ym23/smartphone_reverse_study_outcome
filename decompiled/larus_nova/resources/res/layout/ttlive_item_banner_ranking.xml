<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/rank_backgroung"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/rank_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="12dp"
            android:layout_centerVertical="true"
            android:importantForAccessibility="no"
            android:layout_marginStart="12dp"/>
        <com.bytedance.android.live.core.widget.FitTextView
            android:textSize="16dp"
            android:textColor="@color/ttlive_core_s1"
            android:gravity="center_vertical"
            android:id="@+id/rank_title"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:maxLines="1"
            android:layout_toLeftOf="@+id/avatar_0"
            android:layout_toRightOf="@+id/rank_icon"
            android:layout_centerVertical="true"
            android:importantForAccessibility="no"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_toStartOf="@+id/avatar_0"
            android:layout_toEndOf="@+id/rank_icon"/>
        <com.bytedance.android.live.uikit.rtl.AutoRTLImageView
            android:id="@+id/arrow"
            android:background="@drawable/ttlive_gray_arrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="10dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:importantForAccessibility="no"
            android:layout_marginEnd="10dp"
            android:layout_alignParentEnd="true"/>
        <com.bytedance.android.live.uikit.rtl.AutoRTLImageView
            android:id="@+id/avatar_2"
            android:background="@drawable/ttlive_bg_avatar_new_bronze_border"
            android:paddingTop="6dp"
            android:paddingBottom="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginRight="35dp"
            android:scaleType="fitCenter"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:importantForAccessibility="no"
            android:layout_marginEnd="35dp"
            android:layout_alignParentEnd="true"/>
        <com.bytedance.android.live.uikit.rtl.AutoRTLImageView
            android:id="@+id/avatar_1"
            android:background="@drawable/ttlive_bg_avatar_new_silver_border"
            android:paddingTop="6dp"
            android:paddingBottom="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="fitCenter"
            android:layout_toLeftOf="@+id/avatar_2"
            android:layout_centerVertical="true"
            android:importantForAccessibility="no"
            android:layout_toStartOf="@+id/avatar_2"/>
        <com.bytedance.android.live.uikit.rtl.AutoRTLImageView
            android:id="@+id/avatar_0"
            android:background="@drawable/ttlive_bg_avatar_new_golden_border"
            android:paddingTop="6dp"
            android:paddingBottom="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="fitCenter"
            android:layout_toLeftOf="@+id/avatar_1"
            android:layout_centerVertical="true"
            android:importantForAccessibility="no"
            android:layout_toStartOf="@+id/avatar_1"/>
        <com.bytedance.android.live.uikit.rtl.AutoRTLImageView
            android:id="@+id/rank_crown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/avatar_0"
            android:layout_alignRight="@+id/avatar_0"
            android:importantForAccessibility="no"
            android:layout_alignEnd="@+id/avatar_0"/>
    </RelativeLayout>
</FrameLayout>
