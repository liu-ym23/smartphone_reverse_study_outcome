<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:id="@+id/fl_price_sale"
        android:paddingLeft="12dp"
        android:paddingTop="12dp"
        android:paddingRight="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.android.ec.core.widget.AutoResizePriceContainer
            android:id="@+id/inflow_product_price_v2_container"
            android:layout_width="wrap_content"
            android:layout_height="22dp">
            <TextView
                android:textColor="@color/Primary"
                android:gravity="bottom"
                android:id="@+id/inflow_product_price_v2"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"/>
        </com.bytedance.android.ec.core.widget.AutoResizePriceContainer>
        <FrameLayout
            android:id="@+id/fl_price"
            android:layout_width="match_parent"
            android:layout_height="28dp"/>
        <TextView
            android:textColor="@color/TextReverse4"
            android:ellipsize="end"
            android:layout_gravity="bottom|right"
            android:id="@+id/tv_sales"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/font_size_24"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_waist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</merge>
