<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.livesdk.interactivity.publicscreen.ui.PublicScreenTopLayout
        android:orientation="vertical"
        android:id="@+id/text_msg_top_layout"
        android:paddingTop="4dp"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.android.livesdk.interactivity.publicscreen.ui.RiskAdviseView
            android:id="@+id/risk_advise_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/hot_msg_layout"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/highligh_layout"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/messages_pinned_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.bytedance.android.livesdk.interactivity.publicscreen.ui.PublicScreenTopLayout>
    <com.bytedance.android.livesdk.interactivity.publicscreen.ui.LiveMessageLoaderTip
        android:id="@+id/load_tip"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_below="@+id/text_msg_top_layout"/>
    <FrameLayout
        android:id="@+id/no_more_layout"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_below="@+id/load_tip">
        <com.bytedance.android.live.core.widget.HSImageView
            android:background="@drawable/ttlive_live_message_load_more_background"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            app:roundedCornerRadius="5dp"/>
        <com.bytedance.android.livesdk.chatroom.ui.NoMoreSpaceTextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:layout_gravity="start"
            android:id="@+id/no_more_text"
            android:paddingLeft="8dp"
            android:paddingTop="3dp"
            android:paddingRight="8dp"
            android:paddingBottom="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textIsSelectable="false"
            android:textAlignment="viewStart"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
    </FrameLayout>
    <com.bytedance.android.livesdk.interactivity.api.publicscreen.ui.PublicScreenTextMessageFrameLayout
        android:id="@+id/live_message_touch_interceptor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/load_tip">
        <com.bytedance.android.livesdk.chatroom.ui.pullrefresh.LiveMessageRefreshLayout
            android:id="@+id/live_message_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.android.livesdk.interactivity.publicscreen.ui.PSLiveMessageRecyclerView
                android:id="@+id/messages_view"
                android:fadingEdgeLength="24dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/load_tip"
                android:requiresFadingEdge="vertical"/>
        </com.bytedance.android.livesdk.chatroom.ui.pullrefresh.LiveMessageRefreshLayout>
    </com.bytedance.android.livesdk.interactivity.api.publicscreen.ui.PublicScreenTextMessageFrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/messages_hint_layout"
        android:background="@drawable/ttlive_bg_message_hint"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_alignParentBottom="true">
        <com.bytedance.android.live.core.widget.LiveTextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_message_counts_color"
            android:layout_gravity="center_vertical"
            android:id="@+id/messages_hint_view"
            android:paddingRight="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="@string/ttlive_chat_new_message_stub"
            android:paddingEnd="6dp"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
</RelativeLayout>
