<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="16dp">
    <View
        android:id="@+id/top_divider"
        android:background="@color/line_divider_default"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bitable_native_view_divider_size"/>
    <com.bytedance.ee.bear.bitable.infoarch.SafeLinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="11dp"
        android:layout_weight="1">
        <com.bytedance.ee.bear.bitable.infoarch.nativeview.common.uikit.cell.CommonLoadingView
            android:layout_gravity="center_vertical"
            android:id="@+id/group_header_loading_view"
            android:background="@drawable/bitable_native_view_loading_bg"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="12dp"
            app:widthPercent="0.95"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/group_header_left_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/left_group_arrow"
                android:visibility="gone"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginRight="8dp"
                app:srcCompat="@drawable/ud_icon_down_bold_outlined"/>
            <com.bytedance.ee.bear.bitable.infoarch.nativeview.common.uikit.cell.CommonLoadingView
                android:layout_gravity="center_vertical"
                android:id="@+id/left_group_arrow_loading_view"
                android:background="@drawable/bitable_native_view_loading_bg_small_radius"
                android:visibility="gone"
                android:layout_width="12dp"
                android:layout_height="12dp"
                app:widthPercent="0.95"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/group_header_name"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/right_group_arrow"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="9dp"
            app:srcCompat="@drawable/ud_icon_down_bold_outlined"/>
        <com.bytedance.ee.bear.bitable.infoarch.nativeview.common.uikit.cell.CommonLoadingView
            android:layout_gravity="center_vertical"
            android:id="@+id/right_group_arrow_loading_view"
            android:background="@drawable/bitable_native_view_loading_bg_small_radius"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            app:widthPercent="0.95"/>
    </com.bytedance.ee.bear.bitable.infoarch.SafeLinearLayout>
    <View
        android:id="@+id/bottom_divider"
        android:background="@color/line_divider_default"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bitable_native_view_divider_size"/>
</LinearLayout>
