<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/dora_audio_tool_container"
        android:paddingBottom="?attr/larus_dp_24"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_13"
            android:textColor="@color/larus_black"
            android:gravity="center_vertical"
            android:id="@+id/dora_trace_task_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="?attr/larus_dp_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/dora_trace_seperate_line"
            android:layout_width="wrap_content"
            android:layout_height="1px"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dora_trace_task_id"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/dora_trace_list_title"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dora_trace_seperate_line">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_dp_16"
                android:textStyle="bold"
                android:textColor="@color/larus_black"
                android:gravity="center"
                android:id="@+id/trace_item_time"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="时间"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_dp_16"
                android:textStyle="bold"
                android:textColor="@color/larus_black"
                android:gravity="center"
                android:id="@+id/trace_item_ear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="耳机"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_dp_16"
                android:textStyle="bold"
                android:textColor="@color/larus_black"
                android:gravity="center"
                android:id="@+id/trace_item_doubao"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="豆包"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_dp_16"
                android:textStyle="bold"
                android:textColor="@color/larus_black"
                android:gravity="center"
                android:id="@+id/trace_item_speach"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="Speech"
                android:layout_weight="1"/>
        </LinearLayout>
        <View
            android:id="@+id/dora_trace_list_title_line"
            android:background="@color/larus_neutral_50"
            android:layout_width="match_parent"
            android:layout_height="1px"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dora_trace_list_title"/>
        <ScrollView
            android:id="@+id/scroll_dora_trace_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/dora_trace_list"
                android:background="@color/larus_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
