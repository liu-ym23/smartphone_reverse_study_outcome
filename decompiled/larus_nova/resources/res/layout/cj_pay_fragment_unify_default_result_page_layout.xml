<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/cj_pay_payment_complete_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cj_pay_height_470">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/cj_pay_payment_complete_root_view"
        android:background="@drawable/cj_pay_bg_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_470">
        <include
            android:id="@+id/cj_pay_titlebar_root_view"
            layout="@layout/cj_pay_view_titlebar_noise_reduction_layout"/>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/cj_pay_status_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cj_pay_height_100">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/cj_pay_status_icon"
                android:layout_width="@dimen/cj_pay_height_48"
                android:layout_height="@dimen/cj_pay_height_48"
                android:scaleType="centerCrop"/>
            <TextView
                android:textSize="20sp"
                android:textColor="@color/cj_pay_color_black_34"
                android:layout_gravity="center_horizontal"
                android:id="@+id/cj_pay_status_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/cj_pay_padding_40"
                android:layout_marginTop="@dimen/cj_pay_padding_20"
                android:layout_marginRight="@dimen/cj_pay_padding_40"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </LinearLayout>
    <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
        android:layout_gravity="bottom"
        android:id="@+id/bottom_insurance_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:theme_type="0"/>
</FrameLayout>
