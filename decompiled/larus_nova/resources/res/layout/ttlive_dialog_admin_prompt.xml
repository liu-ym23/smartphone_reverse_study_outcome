<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_dialog_8dp_dark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="15sp"
        android:textColor="@color/ttlive_white_70"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="18dp"
        android:text="@string/ttlive_text_prompter"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/iv_prompter_desc"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ttlive_icon_prompt_faq"
        android:layout_alignTop="@+id/title"
        android:layout_alignBottom="@+id/title"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_prompts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:layout_above="@+id/container_edit_text"
        android:layout_below="@+id/divider"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <View
        android:id="@+id/stupid_gradient"
        android:background="@drawable/ttlive_gradient_promopts_list"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="4dp"
        android:layout_above="@+id/container_edit_text"
        android:layout_below="@+id/divider"/>
    <View
        android:id="@+id/divider"
        android:background="@color/ttlive_white_10"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_below="@+id/title"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ttlive_white_50"
        android:gravity="center"
        android:id="@+id/tv_prompts_empty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_text_hint_no_history_prompt"
        android:layout_above="@+id/container_edit_text"
        android:layout_below="@+id/divider"/>
    <FrameLayout
        android:id="@+id/container_edit_text"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <TextView
            android:textColor="#55ffffff"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_fake_prompter_edit"
            android:background="@drawable/ttlive_bg_black20_radius8"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
    </FrameLayout>
</RelativeLayout>
