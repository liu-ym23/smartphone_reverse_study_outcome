<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.ee.bear.facade.common.widget.RoundFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:background="@color/bg_float"
    android:layout_width="match_parent"
    android:layout_height="@dimen/bitable_manager_panel_item_height"
    app:radius="@dimen/space_kit_len_10">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/tag"
            android:background="@color/primary_fill_default"
            android:visibility="invisible"
            android:layout_width="@dimen/space_kit_len_4"
            android:layout_height="match_parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/space_kit_len_20"
            android:layout_height="@dimen/space_kit_len_20"
            android:layout_marginStart="@dimen/space_kit_len_60"
            android:layout_marginEnd="@dimen/space_kit_len_12"/>
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_title"
            android:ellipsize="end"
            android:id="@+id/text_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_weight="1"/>
        <FrameLayout
            android:id="@+id/menu_more"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/space_kit_len_8"
            android:paddingEnd="@dimen/space_kit_len_8">
            <FrameLayout
                android:layout_gravity="center"
                android:background="@drawable/bitable_item_icon_bg_selector"
                android:layout_width="@dimen/space_kit_len_28"
                android:layout_height="@dimen/space_kit_len_28">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:layout_width="@dimen/space_kit_len_20"
                    android:layout_height="@dimen/space_kit_len_20"
                    android:tint="@color/icon_n3"
                    app:srcCompat="@drawable/ud_icon_more_outlined"/>
            </FrameLayout>
        </FrameLayout>
        <View
            android:id="@+id/right_margin"
            android:layout_width="@dimen/space_kit_len_4"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/divider"
        android:background="@color/line_divider_default"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_kit_len_half"
        android:layout_marginStart="@dimen/space_kit_len_64"/>
</com.bytedance.ee.bear.facade.common.widget.RoundFrameLayout>
