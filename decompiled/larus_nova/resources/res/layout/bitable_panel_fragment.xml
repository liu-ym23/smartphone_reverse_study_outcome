<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_view"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.ee.bear.bitable.common.ClearFocusWrapper
        android:id="@+id/content_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/default_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedance.ee.bear.bitable.card.view.description.expandabletext.ExpandableTextLayout
                android:id="@+id/field_desc_container"
                android:paddingTop="@dimen/space_kit_len_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_kit_len_16"
                android:layout_marginEnd="@dimen/space_kit_len_16">
                <TextView
                    android:textSize="@dimen/space_kit_font_14"
                    android:textColor="@color/text_title"
                    android:id="@+id/field_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="@dimen/space_kit_len_3"/>
            </com.bytedance.ee.bear.bitable.card.view.description.expandabletext.ExpandableTextLayout>
            <com.bytedance.ee.bear.bitable.panel.BitablePanelGroupView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.bytedance.ee.bear.bitable.common.ClearFocusWrapper>
</androidx.core.widget.NestedScrollView>
