<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/photo"
        android:layout_width="@dimen/larus_dp_48"
        android:layout_height="@dimen/larus_dp_48"
        android:layout_marginTop="@dimen/larus_dp_12"
        android:layout_marginBottom="@dimen/larus_dp_12"
        android:layout_alignParentTop="true"
        android:layerType="hardware"
        android:layout_marginStart="@dimen/larus_dp_12"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/larus_dp_14"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/larus_dp_12"
        android:layout_marginEnd="@dimen/larus_dp_16"
        android:layout_toEndOf="@+id/photo">
        <TextView
            android:textSize="@dimen/larus_dp_13"
            android:textColor="@color/larus_creation_notification_title_light"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/larus_dp_16"
            android:textStyle="bold"
            android:textColor="@color/larus_creation_notification_content_light"
            android:ellipsize="end"
            android:gravity="start|top"
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/larus_dp_4"
            android:layout_marginBottom="@dimen/larus_dp_4"
            android:singleLine="true"/>
        <LinearLayout
            android:id="@+id/progressBarContainer"
            android:paddingBottom="@dimen/larus_dp_12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/larus_dp_12">
            <ProgressBar
                android:layout_gravity="center_vertical"
                android:id="@+id/progressBar"
                android:layout_width="0dp"
                android:layout_height="@dimen/larus_dp_6"
                android:progressDrawable="@drawable/larus_custom_creation_notification_progress_light"
                android:layout_weight="1"
                style="?android:attr/progressBarStyleHorizontal"/>
            <Chronometer
                android:textSize="@dimen/larus_dp_14"
                android:textColor="@color/larus_creation_notification_title_dark"
                android:layout_gravity="center_vertical"
                android:id="@+id/chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/larus_dp_14"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
