<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cj_pay_titlebar_root_view"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cj_pay_height_50">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/cj_pay_back_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_font_size_16"
        android:src="@drawable/cj_pay_icon_titlebar_left_arrow"
        android:scaleType="centerCrop"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/cj_pay_left_text_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:singleLine="true"/>
    <com.android.ttcjpaysdk.base.ui.CJPayMiddleTitleText
        android:textSize="17dp"
        android:textColor="@color/cj_pay_color_black_161823"
        android:ellipsize="middle"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/cj_pay_middle_title"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="300dp"
        android:singleLine="true"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/cj_pay_middle_view"
        android:visibility="gone"
        android:layout_width="@dimen/cj_pay_height_100"
        android:layout_height="@dimen/cj_pay_height_24"
        android:scaleType="fitXY"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/cj_pay_color_blue_04498D"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/cj_pay_right_text_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:maxWidth="300dp"
        android:singleLine="true"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/cj_pay_color_blue_04498D"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/cj_pay_right_verify_text_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:maxWidth="300dp"
        android:singleLine="true"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/cj_pay_right_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/cj_pay_padding_12"
        android:src="@drawable/cj_pay_icon_titlebar_left_arrow"
        android:scaleType="centerCrop"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/cj_pay_bottom_divider_line"
        android:background="@color/cj_pay_color_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_half_1"/>
</FrameLayout>
