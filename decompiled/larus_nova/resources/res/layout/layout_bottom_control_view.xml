<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_start_sl"
        android:background="@drawable/bg_start_si"
        android:paddingTop="?attr/larus_dp_6"
        android:paddingBottom="?attr/larus_dp_6"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/larus_static_white"
            android:id="@+id/main_text_start_sl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_g_translate_start1_cn"
            app:layout_constraintBottom_toTopOf="@+id/sub_text_start_cl"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/static_white_transparent_3"
            android:id="@+id/sub_text_start_cl"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_lite_translate_btn_start_subtitle_r_cn"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/main_text_start_sl"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_translating"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="ic_flip, text_flip, layout_end_sl"/>
    <ImageView
        android:id="@+id/ic_mute"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:src="@drawable/icon_speaker_si"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/neutral_70"/>
    <ImageView
        android:id="@+id/ic_flip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_18"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:src="@drawable/icon_flip_si"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ic_mute"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/neutral_70"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/neutral_70"
        android:id="@+id/text_flip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:text="@string/larus_dora_g_translate_switchscreen_cn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ic_flip"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_end_sl"
        android:background="@drawable/bg_end_si"
        android:paddingTop="?attr/larus_dp_6"
        android:paddingBottom="?attr/larus_dp_6"
        android:visibility="visible"
        android:layout_width="?attr/larus_dp_132"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/larus_static_white"
            android:id="@+id/main_text_end_sl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_recording_mode_end_cn"
            app:layout_constraintBottom_toTopOf="@+id/sub_text_end_cl"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/static_white_transparent_3"
            android:id="@+id/sub_text_end_cl"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_lite_translate_btn_exit_cn"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/main_text_end_sl"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
