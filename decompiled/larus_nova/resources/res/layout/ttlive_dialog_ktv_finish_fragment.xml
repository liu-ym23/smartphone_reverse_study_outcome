<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_ktv_score_finish"
    android:layout_width="match_parent"
    android:layout_height="375dp">
    <TextView
        android:textSize="24dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_core_hs_w1"
        android:id="@+id/ktv_level_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/ttlive_ktv_level"
        android:shadowColor="#4d000000"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="2"
        android:layout_centerHorizontal="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/ktv_level_iv"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_marginTop="50dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_core_hs_w1"
        android:gravity="center"
        android:id="@+id/ktv_finish_btn"
        android:background="@drawable/ttlive_bg_ktv_next_song"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="203dp"
        android:text="@string/ttlive_ktv_next_song_1"
        android:layout_below="@+id/ktv_level_iv"
        android:layout_centerHorizontal="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ktv_level_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
