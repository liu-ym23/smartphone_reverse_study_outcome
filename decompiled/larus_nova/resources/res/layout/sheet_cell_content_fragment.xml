<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.ee.bear.sheet.common.SheetDragView
        android:id="@+id/cellpanel_dragview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:panel_drag_handler_type="line"
        app:panel_max_height_percent="0.4"
        app:panel_show_divider="false"
        app:panel_show_drag_handler="true"
        app:panel_show_titlebar="false">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ScrollView
                android:scrollbarStyle="insideOverlay"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <FrameLayout
                    android:id="@+id/cellpanel_container"
                    android:paddingLeft="16dp"
                    android:paddingRight="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/formula_content_container"
                        android:paddingTop="16dp"
                        android:paddingBottom="50dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <com.bytedance.ee.bear.sheet.cellcontent.view.SheetCellContentView
                        android:textSize="16sp"
                        android:textColor="@color/sheet_edit_text_color"
                        android:textColorHint="@color/facade_edit_text_hint"
                        android:gravity="top"
                        android:id="@+id/cell_content_text"
                        android:background="@null"
                        android:paddingTop="16dp"
                        android:paddingBottom="50dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:lineSpacingExtra="2dp"
                        android:textIsSelectable="false"
                        android:textCursorDrawable="@drawable/facade_edit_text_cursor"/>
                </FrameLayout>
            </ScrollView>
            <TextView
                android:id="@+id/cell_content_gradient"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_kit_len_26"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.bytedance.ee.bear.sheet.common.SheetDragView>
    <com.bytedance.ee.bear.fabview.FabView
        android:id="@+id/sheet_operation_fab"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_alignParentEnd="true"
        app:fabColor="@color/primary_fill_default"
        app:fabImage="@drawable/ud_icon_toolbar_more_outlined"
        app:fabImageTint="@color/static_white"
        app:fabType="image"
        app:layout_constraintBottom_toTopOf="@+id/cellpanel_dragview"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
