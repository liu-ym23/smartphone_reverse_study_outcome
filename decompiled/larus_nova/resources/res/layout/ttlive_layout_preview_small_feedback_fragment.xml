<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.videoshop.mediaview.SimpleMediaView
        android:id="@+id/media_play"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/bg_anim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/question_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:background="@drawable/ttlive_bg_feedback_title_tag_left"
            android:layout_width="57dp"
            android:layout_height="1.5dp"
            android:layout_marginRight="12dp"
            android:layout_marginEnd="12dp"/>
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="#80ffffff"
            android:id="@+id/feedback_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_live_feedback_preview_title"/>
        <View
            android:background="@drawable/ttlive_bg_feedback_title_tag_right"
            android:layout_width="57dp"
            android:layout_height="1.5dp"
            android:layout_marginLeft="12dp"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/feedback_submit_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/question_tag">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/white"
            android:id="@+id/question_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:maxLines="2"/>
        <com.bytedance.android.livesdk.feedback.view.preview.SmallCardReplaceViewGroup
            android:id="@+id/preview_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/feedback_submit_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@+id/slide_tag"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/replace"
            android:background="@drawable/ttlive_bg_feedback_preview_option_negative"
            android:layout_width="164dp"
            android:layout_height="44dp"
            android:text="@string/ttlive_feedback_small_preview_replace"
            android:layout_marginEnd="7dp"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/submit"
            android:background="@drawable/ttlive_bg_feedback_preview_option_positive"
            android:layout_width="164dp"
            android:layout_height="44dp"
            android:text="@string/ttlive_feedback_small_preview_submit"
            android:layout_marginEnd="7dp"/>
    </LinearLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="#78ffffff"
        android:id="@+id/slide_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="@string/ttlive_live_feedback_slide_tag"
        app:layout_constraintBottom_toTopOf="@+id/guide_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/guide_layout"
        android:layout_width="30dp"
        android:layout_height="28dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
