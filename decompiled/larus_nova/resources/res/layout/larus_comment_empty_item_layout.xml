<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="?attr/larus_dp_168">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="top|center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_empty_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <View
            android:background="@drawable/larus_emoji_empty_comments"
            android:layout_width="?attr/larus_dp_40"
            android:layout_height="?attr/larus_dp_40"/>
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="?attr/neutral_50"
            android:gravity="top|center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_20"
            android:text="@string/larus_botsComment_commentPanel_emptyState_body"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</LinearLayout>
