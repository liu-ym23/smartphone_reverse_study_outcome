<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ec_store_info_group_area_without_live_tips"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="68sp"
        layout="@layout/ec_store_info_frag_ship_decorator_view_opt"/>
    <com.bytedance.android.shopping.store.home.view.ECStrokeView
        android:orientation="vertical"
        android:id="@+id/ec_store_info_without_decorate_area"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.android.shopping.store.home.view.ECStrokeView
            android:orientation="vertical"
            android:id="@+id/ec_store_info_without_top_list_area"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/ec_store_info_area_container"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:id="@+id/ec_store_value_info_container"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="54sp"/>
            <com.bytedance.android.ec.store.view.ECScrollTagListView
                android:id="@+id/ec_store_long_tag_list"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="22sp"
                android:layout_marginTop="12dp"/>
        </com.bytedance.android.shopping.store.home.view.ECStrokeView>
        <FrameLayout
            android:id="@+id/ec_store_top_list_container"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="24sp"
            android:layout_marginStart="-4dp"
            android:layout_marginEnd="-4dp"/>
    </com.bytedance.android.shopping.store.home.view.ECStrokeView>
</FrameLayout>
