<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/login_content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp">
        <ImageView
            android:id="@+id/loading_empty_icon"
            android:layout_width="192dp"
            android:layout_height="132dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/ttlive_empty_content_dark"/>
        <com.bytedance.android.live.core.widget.LiveTextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_feed_drawer_login"/>
        <com.bytedance.android.live.core.widget.LiveTextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#80ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ttlive_feed_drawer_login_tip_history"/>
        <com.bytedance.android.live.core.widget.LiveTextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/drawer_login"
            android:background="@drawable/ttlive_feed_drawer_login_bg"
            android:layout_width="112dp"
            android:layout_height="36dp"
            android:layout_marginTop="16dp"
            android:text="@string/ttlive_feed_drawer_login_ok"/>
    </LinearLayout>
</FrameLayout>
