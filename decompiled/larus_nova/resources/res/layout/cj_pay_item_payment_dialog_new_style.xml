<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/cj_pay_integrated_bg_gray_radius_4"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <FrameLayout
        android:id="@+id/cj_pay_payment_method_icon_layout"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_centerVertical="true">
        <ImageView
            android:id="@+id/cj_pay_payment_method_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
        <ImageView
            android:id="@+id/cj_pay_payment_method_icon_unable_mask"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/cj_pay_integrated_bg_new_style_icon_unable"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/cj_pay_payment_method_content_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/cj_pay_payment_method_icon_layout"
        android:layout_centerVertical="true">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/cj_pay_font_size_16"
                android:textColor="@color/cj_pay_color_black_64"
                android:ellipsize="end"
                android:id="@+id/cj_pay_payment_method_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="@dimen/cj_pay_font_size_10"
                android:textColor="@color/cj_pay_color_red"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_payment_method_recommend_icon"
                android:background="@drawable/cj_pay_bg_payment_method_recommend_way"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/cj_pay_padding_8"
                android:text="@string/cj_pay_recommend_way"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/cj_pay_font_size_12"
                android:textColor="@color/cj_pay_color_gray_153"
                android:ellipsize="end"
                android:id="@+id/cj_pay_payment_method_sub_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cj_pay_padding_4"
                android:layout_marginRight="44dp"
                android:singleLine="true"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="@dimen/cj_pay_font_size_10"
                android:textColor="@color/cj_pay_color_red"
                android:gravity="center"
                android:id="@+id/cj_pay_payment_method_sub_title_icon"
                android:background="@drawable/cj_pay_bg_payment_method_recommend_way"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cj_pay_padding_4"
                android:singleLine="true"
                android:includeFontPadding="false"/>
        </FrameLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_right_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="7dp"
        android:src="@drawable/cj_pay_integrated_icon_dialog_new_style_right_arrow"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
</RelativeLayout>
