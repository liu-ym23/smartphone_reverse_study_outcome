<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/product_feed_title_root_view"
    android:paddingTop="12dp"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <View
        android:id="@+id/product_feed_recommend_title_divider"
        android:background="@color/LineReverse2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1px"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/divider_decorator_1"
        android:background="@drawable/commerce_maybe_u_like_circle_decorator"
        android:visibility="gone"
        android:layout_width="18.5dp"
        android:layout_height="18.5dp"
        android:layout_marginTop="3.5dp"
        android:layout_marginRight="60.5dp"
        android:rotation="240"/>
    <View
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/divider_decorator_2"
        android:background="@drawable/commerce_maybe_u_like_circle_decorator"
        android:visibility="gone"
        android:layout_width="4.4dp"
        android:layout_height="4.4dp"
        android:layout_marginLeft="44dp"
        android:layout_marginTop="9dp"
        android:rotation="300"/>
    <View
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/divider_decorator_3"
        android:background="@drawable/commerce_maybe_u_like_circle_decorator"
        android:visibility="gone"
        android:layout_width="9.4dp"
        android:layout_height="9.4dp"
        android:layout_marginLeft="42dp"
        android:layout_marginBottom="10dp"/>
    <FrameLayout
        android:id="@+id/maybe_like_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <View
                android:layout_gravity="center_vertical"
                android:id="@+id/left_divider_advanced"
                android:background="@color/commerce_color_161823"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="1dp"
                android:layout_marginRight="8dp"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/shopping_color_161823"
                android:id="@+id/product_feed_title_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shopping_tip_guessulike_product_title"
                android:lineSpacingExtra="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="1dp">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/comma_iv_transition"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/commerce_comma_grey"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/comma_iv"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/commerce_comma_grey"/>
            </FrameLayout>
            <View
                android:layout_gravity="center_vertical"
                android:id="@+id/right_divider_advanced"
                android:background="@color/commerce_color_161823"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="1dp"
                android:layout_marginLeft="9dp"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="right"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/switch_bubble_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="64dp">
            <ImageView
                android:layout_width="148dp"
                android:layout_height="55dp"
                android:src="@drawable/commerce_short_video_list_switch_toast"/>
        </FrameLayout>
        <LinearLayout
            android:layout_gravity="center"
            android:id="@+id/list_style_switch_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/list_style_switch_iv"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/commerce_short_video_feed_list_style_switch_icon_tiny"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#99161823"
                android:layout_gravity="center_vertical"
                android:id="@+id/list_style_switch_tv"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="@string/shopping_tip_product_big_image"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
