<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_prelive_setting"
    android:layout_width="match_parent"
    android:layout_height="484dp"
    android:adjustViewBounds="true">
    <RelativeLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/privilege_detail_setting_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:src="@drawable/ttlive_dynamic_back"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"/>
        <TextView
            android:id="@+id/privilege_setting_detail_title_tv"
            android:text="@string/ttlive_live_pre_setting_danmaku_setting_title"
            style="@style/ttlive_dialog_preview_title_style"/>
    </RelativeLayout>
    <View
        android:id="@+id/privilege_setting_top_divider"
        android:background="@color/ttlive_std_line_white_2"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <com.bytedance.android.livesdk.widget.MaxHeightScrollView
        android:id="@+id/pre_setting_scroll"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:maxHeight="398dp">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/follow_info"
                android:visibility="visible"
                android:text="@string/ttlive_privilege_detail_follow"
                style="@style/ttlive_dialog_preview_subtitle_style"/>
            <RadioGroup
                android:id="@+id/group_follow"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp">
                <RadioButton
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_prelive_setting_dark_txt"
                    android:id="@+id/follow_no"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:button="@null"
                    android:text="@string/ttlive_privilege_detail_follow_1"
                    android:drawableRight="@drawable/ttlive_selector_barrage_privilege"
                    android:drawableEnd="@drawable/ttlive_selector_barrage_privilege"/>
                <RadioButton
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_prelive_setting_dark_txt"
                    android:id="@+id/followed_only"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:button="@null"
                    android:text="@string/ttlive_privilege_detail_follow_2_1"
                    android:drawableRight="@drawable/ttlive_selector_barrage_privilege"
                    android:drawableEnd="@drawable/ttlive_selector_barrage_privilege"/>
                <RadioButton
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_prelive_setting_dark_txt"
                    android:id="@+id/follow_only"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:button="@null"
                    android:text="@string/ttlive_privilege_detail_follow_2"
                    android:drawableRight="@drawable/ttlive_selector_barrage_privilege"
                    android:drawableEnd="@drawable/ttlive_selector_barrage_privilege"/>
                <RadioButton
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_prelive_setting_dark_txt"
                    android:id="@+id/follow_three"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:button="@null"
                    android:text="@string/ttlive_privilege_detail_follow_3"
                    android:drawableRight="@drawable/ttlive_selector_barrage_privilege"
                    android:drawableEnd="@drawable/ttlive_selector_barrage_privilege"/>
                <RadioButton
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_prelive_setting_dark_txt"
                    android:id="@+id/follow_seven"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:button="@null"
                    android:text="@string/ttlive_privilege_detail_follow_4"
                    android:drawableRight="@drawable/ttlive_selector_barrage_privilege"
                    android:drawableEnd="@drawable/ttlive_selector_barrage_privilege"/>
                <RadioButton
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_prelive_setting_dark_txt"
                    android:id="@+id/follow_thirty"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:button="@null"
                    android:text="@string/ttlive_privilege_detail_follow_5"
                    android:drawableRight="@drawable/ttlive_selector_barrage_privilege"
                    android:drawableEnd="@drawable/ttlive_selector_barrage_privilege"/>
            </RadioGroup>
            <View
                android:id="@+id/live_active_divider"
                android:visibility="visible"
                style="@style/ttlive_preview_dialog_line"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/live_info"
                    android:visibility="visible"
                    android:text="@string/ttlive_privilege_detail_live"
                    style="@style/ttlive_dialog_preview_subtitle_style"/>
                <ImageView
                    android:id="@+id/iv_active_desc"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginLeft="2dp"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/ttlive_privilege_active_desc"
                    android:layout_marginStart="2dp"
                    style="@style/ttlive_dialog_preview_subtitle_style"/>
            </LinearLayout>
            <RadioGroup
                android:id="@+id/group_live"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp">
                <RadioButton
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_prelive_setting_dark_txt"
                    android:id="@+id/live_no"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:button="@null"
                    android:text="@string/ttlive_privilege_detail_live_1"
                    android:drawableRight="@drawable/ttlive_selector_barrage_privilege"
                    android:drawableEnd="@drawable/ttlive_selector_barrage_privilege"/>
                <RadioButton
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_prelive_setting_dark_txt"
                    android:id="@+id/live_live"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:button="@null"
                    android:text="@string/ttlive_privilege_detail_live_2"
                    android:drawableRight="@drawable/ttlive_selector_barrage_privilege"
                    android:drawableEnd="@drawable/ttlive_selector_barrage_privilege"/>
            </RadioGroup>
            <View
                android:id="@+id/pre_setting_info_title_divider"
                android:visibility="visible"
                style="@style/ttlive_preview_dialog_line"/>
            <TextView
                android:id="@+id/fans_info"
                android:visibility="visible"
                android:text="@string/ttlive_privilege_detail_fans"
                style="@style/ttlive_dialog_preview_subtitle_style"/>
            <RadioGroup
                android:id="@+id/group_fans"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp">
                <RadioButton
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_prelive_setting_dark_txt"
                    android:id="@+id/fans_no"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:button="@null"
                    android:text="@string/ttlive_privilege_detail_fans_no"
                    android:drawableRight="@drawable/ttlive_selector_barrage_privilege"
                    android:drawableEnd="@drawable/ttlive_selector_barrage_privilege"/>
                <RadioButton
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_prelive_setting_dark_txt"
                    android:id="@+id/fans_1"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:button="@null"
                    android:text="@string/ttlive_privilege_detail_fans_1"
                    android:drawableRight="@drawable/ttlive_selector_barrage_privilege"
                    android:drawableEnd="@drawable/ttlive_selector_barrage_privilege"/>
                <RadioButton
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_prelive_setting_dark_txt"
                    android:id="@+id/fans_3"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:button="@null"
                    android:text="@string/ttlive_privilege_detail_fans_2"
                    android:drawableRight="@drawable/ttlive_selector_barrage_privilege"
                    android:drawableEnd="@drawable/ttlive_selector_barrage_privilege"/>
                <RadioButton
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_prelive_setting_dark_txt"
                    android:id="@+id/fans_5"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:button="@null"
                    android:text="@string/ttlive_privilege_detail_fans_3"
                    android:drawableRight="@drawable/ttlive_selector_barrage_privilege"
                    android:drawableEnd="@drawable/ttlive_selector_barrage_privilege"/>
                <RadioButton
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_prelive_setting_dark_txt"
                    android:id="@+id/fans_9"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:button="@null"
                    android:text="@string/ttlive_privilege_detail_fans_4"
                    android:drawableRight="@drawable/ttlive_selector_barrage_privilege"
                    android:drawableEnd="@drawable/ttlive_selector_barrage_privilege"/>
                <RadioButton
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_prelive_setting_dark_txt"
                    android:id="@+id/fans_12"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:button="@null"
                    android:text="@string/ttlive_privilege_detail_fans_5"
                    android:drawableRight="@drawable/ttlive_selector_barrage_privilege"
                    android:drawableEnd="@drawable/ttlive_selector_barrage_privilege"/>
                <RadioButton
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_prelive_setting_dark_txt"
                    android:id="@+id/fans_15"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:button="@null"
                    android:text="@string/ttlive_privilege_detail_fans_6"
                    android:drawableRight="@drawable/ttlive_selector_barrage_privilege"
                    android:drawableEnd="@drawable/ttlive_selector_barrage_privilege"/>
                <RadioButton
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_prelive_setting_dark_txt"
                    android:id="@+id/fans_17"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:button="@null"
                    android:text="@string/ttlive_privilege_detail_fans_7"
                    android:drawableRight="@drawable/ttlive_selector_barrage_privilege"
                    android:drawableEnd="@drawable/ttlive_selector_barrage_privilege"/>
                <RadioButton
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_prelive_setting_dark_txt"
                    android:id="@+id/fans_20"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:button="@null"
                    android:text="@string/ttlive_privilege_detail_fans_8"
                    android:drawableRight="@drawable/ttlive_selector_barrage_privilege"
                    android:drawableEnd="@drawable/ttlive_selector_barrage_privilege"/>
            </RadioGroup>
        </LinearLayout>
    </com.bytedance.android.livesdk.widget.MaxHeightScrollView>
</LinearLayout>
