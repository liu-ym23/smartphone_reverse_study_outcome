<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@color/ttlive_white"
    android:layout_width="match_parent"
    android:layout_height="72dp">
    <FrameLayout
        android:id="@+id/head_living_status_view"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginLeft="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.livesdk.widget.VHeadView
            android:layout_gravity="center"
            android:id="@+id/head_view"
            android:background="@drawable/ttlive_bg_circle_head"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:placeholderImage="@drawable/ttlive_ic_default_head_small"
            app:retryImageScaleType="fitXY"
            app:roundAsCircle="true"/>
        <ImageView
            android:id="@+id/circle_living_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ttlive_ic_pk_rivals_search_living"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="bottom|right"
            android:id="@+id/living_view"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="14dp"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/head_living_status_view"
        app:layout_constraintEnd_toStartOf="@+id/remove_container"
        app:layout_constraintStart_toEndOf="@+id/head_living_status_view"
        app:layout_constraintTop_toTopOf="@+id/head_living_status_view">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="15dp"
                    android:textColor="#161823"
                    android:ellipsize="end"
                    android:id="@+id/tv_nick_name"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:maxLines="1"
                    android:maxEms="6"
                    android:singleLine="true"/>
                <com.bytedance.android.livesdk.widget.VHeadView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/gender_view"
                    android:background="@drawable/ttlive_bg_circle_head"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginLeft="4dp"
                    app:retryImageScaleType="fitXY"
                    app:roundAsCircle="true"/>
                <com.bytedance.android.live.revlink.impl.pk.ui.PkTagsContainerView
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/tags_container"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"/>
            </LinearLayout>
            <TextView
                android:textSize="11dp"
                android:textColor="#161823"
                android:id="@+id/tv_pk_ban_auto_rv_time"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginTop="6dp"
                android:maxLines="1"
                android:singleLine="true"
                android:lineSpacingExtra="5dp"
                android:alpha="0.34"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/remove_container"
        android:layout_width="@dimen/ttlive_pk_record_invite_width"
        android:layout_height="@dimen/ttlive_pk_record_invite_height"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/ttlive_pk_record_invite_text_size"
            android:textColor="#4f4f4f"
            android:gravity="center"
            android:id="@+id/tv_remove"
            android:background="@drawable/ttlive_bg_pk_record_invite_and_feedback_btn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/ttlive_anchor_interact_ban_user_remove"/>
    </FrameLayout>
    <View
        android:id="@+id/divider"
        android:background="#1a000000"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
