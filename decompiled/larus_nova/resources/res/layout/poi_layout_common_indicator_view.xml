<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/poi_layout_common_indicator_view_1599585307"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/poi_layout_common_indicator_view_1759202273"
        android:background="@color/POISDSecondary"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:textSize="14sp"
            android:textColor="@color/POITextPrimaryDark"
            android:id="@+id/tv_index"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:id="@+id/iv_download"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"/>
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:textSize="17sp"
            android:textColor="@color/POITextPrimaryDark"
            android:ellipsize="end"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_centerInParent="true"
            android:layout_marginStart="80dp"
            android:layout_marginEnd="80dp"/>
    </RelativeLayout>
</LinearLayout>
