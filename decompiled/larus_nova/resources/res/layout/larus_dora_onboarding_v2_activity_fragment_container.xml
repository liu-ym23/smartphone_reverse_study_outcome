<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="?attr/larus_dp_30"
        app:layout_constraintBottom_toTopOf="@+id/dora_onboarding_continue_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_neutral_50"
        android:gravity="center_vertical"
        android:id="@+id/dora_onboarding_skip_btn"
        android:paddingLeft="?attr/larus_dp_12"
        android:paddingRight="?attr/larus_dp_12"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_44"
        android:text="@string/larus_dora_btn_skip_cn"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/dora_onboarding_nav_back_btn"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_3"
        android:src="@drawable/larus_dora_ic_left_back"
        android:layout_marginStart="?attr/larus_dp_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.bmhome.view.item.ItemGroup
        android:id="@+id/dora_onboarding_setting_group"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_24"
        android:layout_marginRight="?attr/larus_dp_24"
        android:layout_marginBottom="?attr/larus_dp_24"
        app:layout_constraintBottom_toTopOf="@+id/dora_onboarding_continue_btn"/>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/dora_onboarding_continue_btn"
        android:background="@drawable/larus_dora_btn_primary_bg"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_24"
        android:layout_marginRight="?attr/larus_dp_24"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:minHeight="?attr/larus_dp_56"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toTopOf="@+id/dora_onboarding_later_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="?attr/larus_dp_420"
        app:layout_goneMarginBottom="?attr/larus_dp_48"/>
    <ProgressBar
        android:id="@+id/dora_onboarding_continue_btn_pb"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:indeterminateDrawable="@drawable/larus_dora_progressbar_loading"
        android:indeterminateDuration="750"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/dora_onboarding_continue_btn"
        app:layout_constraintEnd_toEndOf="@+id/dora_onboarding_continue_btn"
        app:layout_constraintTop_toTopOf="@+id/dora_onboarding_continue_btn"/>
    <TextView
        android:textSize="?attr/larus_sp_15"
        android:textColor="@color/larus_neutral_70"
        android:layout_gravity="center_horizontal"
        android:id="@+id/dora_onboarding_later_btn"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_48"
        android:text="@string/larus_dora_btn_setup_later_cn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
