<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_recharge_diamond_color"
        android:gravity="center"
        android:id="@+id/title_text"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="@string/ttlive_title_charge"
        app:layout_constraintBottom_toTopOf="@+id/diamond_and_income"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/recharge_setting"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="17dp"
        android:layout_marginRight="17dp"
        android:src="@drawable/ttlive_ic_recharge_panel_setting"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/diamond_and_income"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="7dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_recharge_dialog_diamond_color"
            android:id="@+id/diamond"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_income_change_balance"
            android:gravity="center"
            android:id="@+id/change_balance"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_income_change_balance"
            android:includeFontPadding="false"
            android:drawableRight="@drawable/ttlive_recharge_dialog_balance_arrow_icon_black"
            android:drawablePadding="3dp"
            android:drawableEnd="@drawable/ttlive_recharge_dialog_balance_arrow_icon_black"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
