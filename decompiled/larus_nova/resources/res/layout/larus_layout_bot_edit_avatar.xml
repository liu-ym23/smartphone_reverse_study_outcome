<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="?attr/larus_dp_120"
    android:layout_height="?attr/larus_dp_120"
    android:layout_marginTop="?attr/larus_dp_12">
    <com.larus.common_ui.widget.roundlayout.CircleFrameLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/iv_header"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:avatar_placeholder="@color/larus_neutral_transparent_1"
            app:failureImage="@drawable/larus_common_ui_avatar_placeholder"/>
    </com.larus.common_ui.widget.roundlayout.CircleFrameLayout>
    <com.larus.bot.impl.common.view.CircularLottieView
        android:id="@+id/avatar_circular_loading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="center"
        app:lottie_autoPlay="true"
        app:lottie_cacheStrategy="strong"
        app:lottie_lazyLoad="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/larus_create_bot_avatar_loading"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/iv_add_header"
        android:layout_width="?attr/larus_dp_32"
        android:layout_height="?attr/larus_dp_32"
        app:srcCompat="@drawable/larus_ic_add_header"/>
</merge>
