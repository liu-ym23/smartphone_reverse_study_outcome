<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bitable_auto_subscribe_confirm_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="@dimen/dp_24"
        android:paddingRight="@dimen/dp_24"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_20">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:layout_width="@dimen/dp_20"
            android:layout_height="@dimen/dp_20"
            android:tint="@color/text_link_normal"
            app:srcCompat="@drawable/ud_icon_info_ccm_filled"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text_title"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/dp_4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/Bitable_SubscribeRecords_DontAutoFollow_Title"
            android:maxLines="1"/>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/text_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_24"
        android:layout_marginTop="13dp"
        android:layout_marginRight="@dimen/dp_24"
        android:text="@string/Bitable_SubscribeRecords_DontAutoFollow_Desc"
        android:lineSpacingExtra="@dimen/dp_2"/>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="@dimen/dp_24"
        android:paddingTop="@dimen/dp_20"
        android:paddingRight="@dimen/dp_24"
        android:paddingBottom="@dimen/dp_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.larksuite.component.universe_design.button.UDButton
            android:textSize="16sp"
            android:textColor="@color/text_title"
            android:gravity="center"
            android:id="@+id/button_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/Bitable_SubscribeRecords_DontAutoFollow_Cancel_Button"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:ud_radius="s"
            app:ud_strokeColor="@color/line_border_component"
            app:ud_strokeWidth="@dimen/dp_1"/>
        <com.larksuite.component.universe_design.button.UDButton
            android:textSize="16sp"
            android:textColor="@color/text_title"
            android:gravity="center"
            android:id="@+id/button_confirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/Bitable_SubscribeRecords_DontAutoFollow_Confirm_Button"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            app:ud_radius="s"
            app:ud_strokeColor="@color/line_border_component"
            app:ud_strokeWidth="@dimen/dp_1"/>
    </LinearLayout>
</LinearLayout>
