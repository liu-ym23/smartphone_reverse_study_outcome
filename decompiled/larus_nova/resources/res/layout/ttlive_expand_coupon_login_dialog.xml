<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:background="@drawable/ttlive_bg_expand_coupon_enter_room_dialog"
    android:paddingBottom="34dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/expand_coupon_container"
        android:background="@drawable/ttlive_bg_expand_coupon_login"
        android:layout_width="240dp"
        android:layout_height="116dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="13dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_color_FFFFFF"
            android:id="@+id/expand_coupon_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="31dp"
            android:layout_marginStart="48dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="28dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_expand_coupon_value_color"
            android:id="@+id/expand_coupon_prefix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/ttlive_expand_coupon_symbol"
            android:includeFontPadding="false"
            android:layout_marginStart="48dp"
            app:layout_constraintEnd_toStartOf="@+id/expand_coupon_num"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/expand_coupon_info"/>
        <TextView
            android:textSize="48sp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_expand_coupon_value_color"
            android:id="@+id/expand_coupon_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            app:layout_constraintBaseline_toBaselineOf="@+id/expand_coupon_prefix"
            app:layout_constraintStart_toEndOf="@+id/expand_coupon_prefix"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_color_161823"
        android:id="@+id/coupon_login_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/ttlive_expand_coupon_login_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/expand_coupon_container"/>
    <Button
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_color_FFFFFF"
        android:gravity="center"
        android:id="@+id/expand_coupon_auth_confirm_btn"
        android:background="@drawable/ttlive_bg_expand_coupon_auth"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:text="@string/ttlive_expand_coupon_do_auth_text"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/coupon_login_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
