<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ffffff"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="75dp">
    <View
        android:id="@+id/v_top_line"
        android:background="#1a000000"
        android:layout_width="match_parent"
        android:layout_height="1px"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13dp"
        android:textStyle="normal"
        android:textColor="#80161823"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ttlive_game_promote_click_to_rate"
        android:layout_marginStart="18dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.gamecp.business.view.GamePromoteCommonRatingBar
        android:id="@+id/rating_bar"
        android:layout_width="100dp"
        android:layout_height="20dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:starBgDrawable="@drawable/gamecp_ic_game_promote_star_bg_v2"
        app:starClickable="true"
        app:starCount="5"
        app:starDrawable="@drawable/gamecp_ic_game_promote_star_v2"
        app:starPadding="12dp"
        app:starScrollable="false"
        app:starType="whole"/>
    <TextView
        android:textSize="13dp"
        android:textStyle="bold"
        android:textColor="@color/gamecp_white"
        android:gravity="center"
        android:id="@+id/tv_input_button"
        android:background="@drawable/shape_bg_comment_fe2c55_corner_4"
        android:layout_width="70dp"
        android:layout_height="28dp"
        android:text="@string/ttlive_game_promote_input_comment"
        android:layout_marginEnd="18dp"
        app:layout_constraintBottom_toBottomOf="@+id/rating_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/rating_bar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
