<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.effect.base.AdjustPercentBar
        android:id="@+id/filter_seek_bar"
        android:background="#0000"
        android:padding="0dp"
        android:layout_width="0dp"
        android:layout_height="@dimen/ttlive_effect_beauty_panel_percent_bar_height"
        android:layout_marginBottom="@dimen/ttlive_effect_beauty_panel_percent_bar_margin_bottom"
        android:maxHeight="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:ttlive_effect_bar_padding="24dp"
        app:ttlive_effect_textColor="#ffffff"
        app:ttlive_effect_textSize="14dp"/>
    <com.bytedance.android.live.effect.base.BeautifyAdjustPercentBar
        android:id="@+id/filter_seek_bar_new"
        android:background="#0000"
        android:padding="0dp"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginBottom="225dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/content_background_view"
        android:background="@color/transparent"
        android:layout_width="0dp"
        android:layout_height="@dimen/ttlive_effect_beauty_panel_content_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcl_filter"
        android:layout_width="0dp"
        android:layout_height="@dimen/ttlive_effect_beauty_common_list_height"
        android:layout_marginBottom="@dimen/ttlive_effect_beauty_common_list_margin_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/toast_view"
        android:background="@color/transparent"
        android:layout_width="0dp"
        android:layout_height="150dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.bytedance.android.live.uikit.recyclerview.LoadingStatusView
        android:id="@+id/loading_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/rcl_filter"
        app:layout_constraintEnd_toEndOf="@+id/rcl_filter"
        app:layout_constraintStart_toStartOf="@+id/rcl_filter"
        app:layout_constraintTop_toTopOf="@+id/rcl_filter"/>
</androidx.constraintlayout.widget.ConstraintLayout>
