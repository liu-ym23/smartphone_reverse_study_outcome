<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="3dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="10dp">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ai_guest_layout"
        android:visibility="gone"
        android:layout_width="66dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="2dp">
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="center"
                android:id="@+id/ai_guest_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:actualImageResource="@drawable/ttlive_ai_guest_avatar"/>
            <ImageView
                android:id="@+id/invited_shader"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/ai_guest_nick_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:src="@drawable/ttlive_ai_guest_nick"/>
    </LinearLayout>
    <com.bytedance.android.livesdk.multilink.base.view.HorizontalRecyclerView
        android:id="@+id/rlv_my_friend"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ai_guest_layout"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
