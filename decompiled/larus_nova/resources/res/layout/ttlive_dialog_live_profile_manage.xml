<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/fans_group_list"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_live_profile_manage_fans_group_list"
        style="@style/ttlive_LiveProfileManageItem"/>
    <View
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:id="@+id/manager_list"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_live_profile_manage_manager_list"
        style="@style/ttlive_LiveProfileManageItem"/>
    <View
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:id="@+id/mute_list"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="57dp"
        android:text="@string/ttlive_live_profile_manage_mute_list"
        style="@style/ttlive_LiveProfileManageItem"/>
    <View
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:id="@+id/kick_out_list"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="57dp"
        android:text="@string/ttlive_setting_block_list"
        style="@style/ttlive_LiveProfileManageItem"/>
    <TextView
        android:id="@+id/manager"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="57dp"
        android:text="@string/ttlive_live_profile_manage_set_manager"
        style="@style/ttlive_LiveProfileManageItem"/>
    <View
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:id="@+id/kick_out"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="57dp"
        android:text="@string/ttlive_chat_block_him"
        style="@style/ttlive_LiveProfileManageItem"/>
    <View
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:id="@+id/mute"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="57dp"
        android:text="@string/ttlive_live_profile_manage_mute"
        style="@style/ttlive_LiveProfileManageItem"/>
    <View
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:id="@+id/cancel"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="57dp"
        android:text="@string/ttlive_cancel"
        style="@style/ttlive_LiveProfileManageItem"/>
</LinearLayout>
