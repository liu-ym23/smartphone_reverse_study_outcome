<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <FrameLayout
            android:id="@+id/menu_left_container"
            android:layout_width="?attr/larus_dp_16"
            android:layout_height="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="@+id/menu_title_row"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/menu_title_row">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/menu_icon"
                android:layout_width="?attr/larus_dp_16"
                android:layout_height="?attr/larus_dp_16"
                android:scaleType="centerInside"
                app:tint="?attr/larus_neutral_100"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/menu_title_row"
            android:layout_width="?attr/larus_dp_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="?attr/larus_dp_6"
            android:layout_marginEnd="?attr/larus_dp_12"
            app:layout_constraintEnd_toStartOf="@+id/menu_right_container"
            app:layout_constraintStart_toEndOf="@+id/menu_left_container"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_dp_14"
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/menu_text"
                android:layout_width="?attr/larus_dp_0"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/menu_title_icon"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_14"
                android:layout_height="?attr/larus_dp_14"
                android:scaleType="centerInside"
                android:layout_marginStart="?attr/larus_dp_2"/>
            <FrameLayout
                android:id="@+id/tv_menu_item_tag_layout"
                android:background="@drawable/larus_bg_menu_item_tag"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="?attr/larus_dp_4">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_dp_11"
                    android:textColor="?attr/larus_neutral_50"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tv_menu_item_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="?attr/larus_dp_4"
                    android:layout_marginRight="?attr/larus_dp_4"
                    android:maxLines="1"
                    android:includeFontPadding="false"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/blue_tag_layout"
                android:background="@drawable/larus_action_bar_menu_blue_update_icon"
                android:paddingLeft="?attr/larus_dp_4"
                android:paddingRight="?attr/larus_dp_4"
                android:layout_width="wrap_content"
                android:layout_height="?attr/larus_dp_18"
                android:layout_marginStart="?attr/larus_dp_4">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/blue_tag_icon"
                    android:visibility="gone"
                    android:layout_width="?attr/larus_dp_10"
                    android:layout_height="?attr/larus_dp_10"
                    android:scaleType="centerInside"
                    android:layout_marginEnd="?attr/larus_dp_2"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_dp_11"
                    android:textColor="?attr/larus_primary_50"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/blue_tag_text"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:maxLines="1"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_13"
            android:textColor="?attr/larus_neutral_50"
            android:ellipsize="end"
            android:id="@+id/menu_sub_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_20"
            android:layout_marginTop="?attr/larus_dp_2"
            android:maxLines="1"
            android:includeFontPadding="false"
            app:layout_constraintStart_toStartOf="@+id/menu_title_row"
            app:layout_constraintTop_toBottomOf="@+id/menu_title_row"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/menu_right_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="?attr/larus_dp_16"
            android:minHeight="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="@+id/menu_title_row"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/menu_title_row">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_dp_14"
                android:textColor="?attr/larus_neutral_50"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/menu_right_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_marginStart="?attr/larus_dp_12"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/menu_text_icon"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_16"
                android:layout_height="?attr/larus_dp_16"
                android:scaleType="center"
                android:layout_marginStart="?attr/larus_dp_4"
                app:tint="?attr/larus_neutral_100"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
