<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:background="@drawable/ttlive_bg_dynamic_emoji_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/iv_back"
        android:layout_width="24dp"
        android:layout_height="22dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="15dp"
        android:layout_marginStart="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:layout_width="8dp"
            android:layout_height="16dp"
            android:src="@drawable/ttlive_video_friend_pair_dialog_back_icon"/>
    </FrameLayout>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/tv_pair_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/ttlive_live_interact_pair"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#80161823"
        android:id="@+id/tv_pair_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/ttlive_live_interact_pair_tips"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_pair_title"/>
    <View
        android:id="@+id/guide_line"
        android:background="#1a161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_pair_tips"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#80000000"
        android:id="@+id/tv_cooling_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginRight="16dp"
        android:text="@string/ttlive_live_video_friend_pair_cooling_countdown"
        android:layout_marginEnd="16dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/empty"
        android:paddingTop="33dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="244dp"
        app:layout_constraintTop_toBottomOf="@+id/guide_line">
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/empty_iv"
            android:background="@drawable/ttlive_ic_video_talk_place_holder_empty"
            android:layout_width="200dp"
            android:layout_height="120dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#8a000000"
            android:layout_gravity="center"
            android:id="@+id/tv_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ttlive_interact_video_friend_no_pair_user_tips"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_pair_user_list"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="244dp"
        app:layout_constraintTop_toBottomOf="@+id/guide_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>
