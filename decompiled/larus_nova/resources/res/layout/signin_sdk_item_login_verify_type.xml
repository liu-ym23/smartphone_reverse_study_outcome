<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/signin_sdk_card_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_type"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/signin_sdk_margin_30"
        android:layout_marginBottom="@dimen/signin_sdk_margin_30"
        android:scaleType="fitCenter"
        android:layout_centerVertical="true"
        app:srcCompat="@drawable/ud_icon_member_filled"/>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_toLeftOf="@+id/iv_arrow"
        android:layout_toRightOf="@+id/iv_type"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dp_16">
        <TextView
            android:textSize="@dimen/sp_17"
            android:textStyle="bold"
            android:textColor="@color/text_title"
            android:id="@+id/tv_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/text_caption"
            android:ellipsize="end"
            android:id="@+id/tv_desc"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/signin_sdk_margin_4"
            android:maxLines="2"
            android:layout_below="@+id/tv_type"/>
    </RelativeLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dp_16"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        app:srcCompat="@drawable/sign_sdk_svg_grey6_right_arrow"
        app:tint="@color/text_caption"/>
</RelativeLayout>
