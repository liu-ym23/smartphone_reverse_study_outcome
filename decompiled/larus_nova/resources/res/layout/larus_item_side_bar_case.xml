<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_40"
    android:paddingStart="?attr/larus_dp_12"
    android:paddingEnd="?attr/larus_dp_12">
    <CheckBox
        android:id="@+id/case_checkbox"
        android:background="@android:color/transparent"
        android:visibility="visible"
        android:layout_width="?attr/larus_dp_28"
        android:layout_height="?attr/larus_dp_28"
        android:checked="false"
        android:button="@drawable/larus_slide_bar_case_view"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/case_title"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/case_title"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/case_checkbox"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
