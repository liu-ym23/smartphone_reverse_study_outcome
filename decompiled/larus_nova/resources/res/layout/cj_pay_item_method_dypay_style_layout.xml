<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/cj_pay_payment_method_icon_layout"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="@dimen/cj_pay_padding_16"
        android:layout_marginTop="14dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="14dp"
        android:layout_centerVertical="true">
        <ImageView
            android:id="@+id/cj_pay_payment_method_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
        <ImageView
            android:id="@+id/cj_pay_payment_method_icon_unable_mask"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/cj_pay_bg_payment_icon_unable_style_5"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/cj_pay_payment_method_content_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:layout_toLeftOf="@+id/cj_pay_right_view"
        android:layout_toRightOf="@+id/cj_pay_payment_method_icon_layout"
        android:layout_centerVertical="true">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:ellipsize="end"
                android:id="@+id/cj_pay_payment_method_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/cj_pay_color_red"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_payment_method_recommend_icon"
                android:background="@drawable/cj_pay_bg_payment_method_recommend_way"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/cj_pay_padding_8"
                android:text="@string/cj_pay_recommend_way"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <RelativeLayout
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
                android:ellipsize="end"
                android:id="@+id/cj_pay_payment_method_sub_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cj_pay_padding_4"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_centerVertical="true"/>
            <ImageView
                android:id="@+id/cj_pay_payment_method_sub_title_info"
                android:paddingLeft="10dp"
                android:paddingTop="0.5dp"
                android:visibility="gone"
                android:layout_width="26dp"
                android:layout_height="17dp"
                android:layout_marginLeft="-6dp"
                android:layout_marginTop="6dp"
                android:src="@drawable/cj_pay_info_icon"
                android:layout_toRightOf="@+id/cj_pay_payment_method_sub_title"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="10sp"
                android:textColor="@color/cj_pay_color_red"
                android:gravity="center"
                android:id="@+id/cj_pay_payment_method_sub_title_icon"
                android:background="@drawable/cj_pay_bg_payment_method_recommend_way"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cj_pay_padding_4"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/cj_pay_color_red"
                android:gravity="center"
                android:id="@+id/cj_pay_payment_method_sub_title_next_icon"
                android:background="@drawable/cj_pay_bg_payment_method_recommend_way"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/cj_pay_padding_8"
                android:layout_marginTop="@dimen/cj_pay_padding_4"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_toRightOf="@+id/cj_pay_payment_method_sub_title_icon"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/cj_pay_right_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true">
        <com.android.ttcjpaysdk.base.theme.widget.CJPayCircleCheckBox
            android:layout_gravity="end|center_vertical"
            android:id="@+id/cj_pay_payment_method_checkbox"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="@dimen/cj_pay_padding_16"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/cj_pay_payment_method_label"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="32dp"
            android:includeFontPadding="false"
            android:layout_centerVertical="true"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/cj_pay_payment_method_arrow"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/cj_pay_padding_16"
            android:src="@drawable/cj_pay_icon_right_arrow_noise_reduction"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"/>
        <ProgressBar
            android:layout_gravity="end|center_vertical"
            android:id="@+id/cj_pay_payment_method_loading"
            android:background="@color/cj_pay_color_trans"
            android:visibility="gone"
            android:layout_width="@dimen/cj_pay_padding_24"
            android:layout_height="@dimen/cj_pay_padding_24"
            android:layout_marginRight="13dp"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_gray"
            android:indeterminateDuration="500"
            android:indeterminateBehavior="repeat"/>
    </FrameLayout>
</RelativeLayout>
