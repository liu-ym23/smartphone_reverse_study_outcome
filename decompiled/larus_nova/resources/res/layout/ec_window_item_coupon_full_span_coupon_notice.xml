<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="13dp"
        android:textColor="#99161823"
        android:id="@+id/coupon_discount_notice_prefix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ec_window_common_red"
        android:id="@+id/coupon_discount_notice_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBaseline_toBaselineOf="@+id/coupon_discount_notice_prefix"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/coupon_discount_notice_prefix"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#99161823"
        android:id="@+id/coupon_discount_notice_suffix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBaseline_toBaselineOf="@+id/coupon_discount_notice_prefix"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/coupon_discount_notice_desc"/>
</androidx.constraintlayout.widget.ConstraintLayout>
