<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="40dp"
    android:paddingBottom="20dp"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larksuite.component.ui.layout.LKUIRoundableLayout
        android:id="@+id/group_avatar_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rl_radius="32dp">
        <ImageView
            android:id="@+id/group_avatar"
            android:layout_width="64dp"
            android:layout_height="64dp"/>
    </com.larksuite.component.ui.layout.LKUIRoundableLayout>
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/flow_ud_neutral_100"
        android:gravity="center_horizontal"
        android:id="@+id/main_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:maxLines="2"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/group_avatar_container"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/flow_ud_neutral_70"
        android:gravity="center_horizontal"
        android:id="@+id/sub_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/main_title"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/flow_ud_neutral_100"
        android:gravity="center"
        android:id="@+id/btn_know"
        android:background="@drawable/bg_chat_setting_abandon_btn_know"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:text="@string/LarkIM_Common_GotIt_Button"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sub_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
