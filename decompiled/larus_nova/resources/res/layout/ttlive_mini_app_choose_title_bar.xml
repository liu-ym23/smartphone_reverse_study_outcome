<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <ImageView
        android:id="@+id/close_btn"
        android:padding="5dp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="12dp"
        android:src="@drawable/ttlive_mini_app_choose_back_btn"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_alignParentStart="true"/>
    <com.google.android.material.tabs.TabLayout
        android:layout_gravity="center"
        android:id="@+id/tab_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:layout_centerInParent="true"
        app:tabBackground="@color/transparent"
        app:tabIndicatorColor="#161823"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="2dp"
        app:tabPaddingEnd="20dp"
        app:tabPaddingStart="20dp"
        app:tabRippleColor="@color/transparent"
        app:tabSelectedTextColor="#161823"
        app:tabTextAppearance="@style/ttlive_mini_app_choose_tab"
        app:tabTextColor="#99161823"/>
    <ImageView
        android:id="@+id/help_btn"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="16dp"
        android:src="@drawable/ttlive_mini_app_choose_help_tip_icon"
        android:layout_toLeftOf="@+id/setting_btn"
        android:layout_centerVertical="true"
        android:layout_alignWithParentIfMissing="true"
        android:layout_marginEnd="16dp"
        android:layout_toStartOf="@+id/setting_btn"/>
    <ImageView
        android:id="@+id/setting_btn"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="16dp"
        android:src="@drawable/ttlive_mini_app_choose_setting_icon"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/search_btn"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="16dp"
        android:src="@drawable/ttlive_mini_choose_search_icon"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
