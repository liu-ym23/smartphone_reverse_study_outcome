<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@color/byted_black"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/layout_resolution"
        android:background="@color/byted_black"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/ocr_take_photo_surface_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.ss.android.bytedcert.view.camera.MyPreview
                android:id="@+id/ocr_take_photo_surface"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <RelativeLayout
            android:id="@+id/mask_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.ss.android.bytedcert.view.ClipHoleView
                android:id="@+id/clip_hole_view"
                android:layout_width="400dp"
                android:layout_height="250dp"
                android:layout_centerInParent="true"/>
            <ImageView
                android:id="@+id/ocr_take_photo_mask"
                android:layout_width="400dp"
                android:layout_height="250dp"
                android:scaleType="fitXY"
                android:text="@string/byted_take_photo"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/ocr_take_photo_bar"
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <ImageView
                android:id="@+id/iv_back"
                android:padding="4dp"
                android:layout_width="21dp"
                android:layout_height="29dp"
                android:layout_marginLeft="12dp"
                android:src="@mipmap/byted_return_white"
                android:scaleType="centerInside"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/ocr_take_photo_led"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="6dp"
                android:src="@mipmap/byted_poweron"
                android:layout_alignParentRight="true"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="25sp"
            android:textColor="@color/byted_white"
            android:gravity="center"
            android:id="@+id/ocr_take_photo_title"
            android:padding="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/byted_ocr_take_front"
            android:layout_centerInParent="true"
            android:rotation="90"/>
        <ImageView
            android:id="@+id/ocr_take_photo_take"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_marginBottom="70dp"
            android:src="@mipmap/byted_take_photo"
            android:text="@string/byted_take_photo"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:contentDescription="take photo"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/byted_white"
            android:gravity="center"
            android:id="@+id/ocr_take_photo_description"
            android:padding="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:layout_above="@+id/ocr_take_photo_take"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/ocr_take_photo_choose_photo"
            android:visibility="gone"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_marginLeft="30dp"
            android:layout_marginBottom="70dp"
            android:src="@mipmap/byted_ocr_choose_photo"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"
            android:contentDescription="choose photo"
            android:layout_marginStart="30dp"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:id="@+id/ocr_take_photo_switch_camera"
            android:visibility="gone"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_marginRight="30dp"
            android:layout_marginBottom="70dp"
            android:src="@mipmap/byted_ocr_switch_camera"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:contentDescription="switch camera"
            android:layout_marginEnd="30dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</FrameLayout>
