<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/anchor_v3_sv_subsized_activity_layout"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/anchor_v3_sv_activity_background"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:actualImageScaleType="fitEnd"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/anchor_v3_sv_subsidized_left_background_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/anchor_v3_sv_subsidized_left_background"
            android:layout_width="99.5dp"
            android:layout_height="62dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/anchor_v3_subsidized_sv_sell_price_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="13dp"
            android:layout_marginStart="12dp"
            app:actualImageScaleType="fitStart"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.ec.core.widget.PriceView
            android:id="@+id/anchor_v3_subsidized_sell_price_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="12dp"
            app:extraTextColor="@color/commerce_color_A3430D"
            app:extraTextSize="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:needPriceBorder="true"
            app:priceBold="true"
            app:priceTextColor="@color/commerce_color_A3430D"
            app:priceTextSize="20dp"
            app:spaceSize="2dp"
            app:yangTextSize="13dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textColor="@color/commerce_color_FFFFFF"
        android:gravity="center"
        android:id="@+id/anchor_v3_tv_subsidized_price_desc"
        android:background="@drawable/commerce_anchor_v3_bg_subsidized_market_price"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="13dp"
        android:layout_marginStart="6dp"
        app:layout_constraintStart_toEndOf="@+id/anchor_v3_sv_subsidized_left_background_container"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/font_size_24"/>
    <TextView
        android:textColor="@color/shopping_color_CCFFFFFF"
        android:gravity="center"
        android:id="@+id/anchor_v3_tv_market_price_desc"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginLeft="6dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/anchor_v3_sv_subsidized_left_background_container"
        style="@style/font_size_22"/>
    <View
        android:id="@+id/anchor_v3_subsidized_vertical_line"
        android:background="@color/shopping_color_80FFFFFF"
        android:visibility="gone"
        android:layout_width="0.5dp"
        android:layout_height="8dp"
        android:layout_marginRight="4dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/anchor_v3_tv_market_price_desc"
        app:layout_constraintStart_toEndOf="@+id/anchor_v3_tv_market_price_desc"
        app:layout_constraintTop_toTopOf="@+id/anchor_v3_tv_market_price_desc"/>
    <TextView
        android:textColor="@color/shopping_color_CCFFFFFF"
        android:id="@+id/anchor_v3_subsidized_has_sold_count"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginLeft="8.5dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/anchor_v3_tv_market_price_desc"
        style="@style/font_size_22"/>
    <com.bytedance.android.shopping.inflow.view.CountDownLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/subsidized_activity_countdown"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/activity_price_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
