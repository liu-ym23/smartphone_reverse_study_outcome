<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="3dp"
    android:layout_width="match_parent"
    android:layout_height="38dp"
    android:layout_marginEnd="4dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/lv_group_title_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/chart_helper_entry"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:ellipsize="end"
            android:id="@+id/tv_group_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#99161823"
            android:id="@+id/tv_group_title_extra"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/chart_helper_entry"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/big_pic_switch_mode_entry"
        app:layout_constraintStart_toEndOf="@+id/lv_group_title_container"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="14sp"
            android:textColor="#99161823"
            android:ellipsize="end"
            android:id="@+id/tv_chart_recommend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="130dp"
            android:singleLine="true"
            android:layout_marginStart="2dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_chart_arrow_chart_helper"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/shopping_sku_arrow_right"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/big_pic_switch_mode_entry"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/divider"
            android:background="#1f161823"
            android:layout_width="1dp"
            android:layout_height="14dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
        <ImageView
            android:id="@+id/iv_switch_mode"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/shopping_sku_spec_small_pic_mode"
            android:layout_marginEnd="2dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#161823"
            android:gravity="center_vertical"
            android:id="@+id/tv_switch_mode"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/shopping_sku_optimize_small_pic_mode"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
