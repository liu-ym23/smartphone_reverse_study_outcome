<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/action_divider"
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="47dp">
        <TextView
            android:textColor="@color/ttlive_replay_user_card_common_red"
            android:id="@+id/follow"
            android:layout_height="match_parent"
            android:text="@string/ttlive_live_profile_follow"
            android:drawableRight="@drawable/ttlive_replay_profile_action_item_divider"
            android:drawableEnd="@drawable/ttlive_replay_profile_action_item_divider"
            style="@style/ttlive_replay_profile_action_item"/>
        <TextView
            android:textColor="@color/ttlive_core_hs_g3"
            android:id="@+id/followed"
            android:layout_height="match_parent"
            android:text="@string/ttlive_live_profile_followed"
            android:drawableRight="@drawable/ttlive_replay_profile_action_item_divider"
            android:drawableEnd="@drawable/ttlive_replay_profile_action_item_divider"
            style="@style/ttlive_replay_profile_action_item"/>
        <TextView
            android:textColor="@color/ttlive_core_hs_s27"
            android:id="@+id/home_page"
            android:layout_height="match_parent"
            android:text="@string/ttlive_home_page"
            style="@style/ttlive_replay_profile_action_item"/>
    </LinearLayout>
</LinearLayout>
