<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="3dp"
        android:paddingStart="10dp"
        android:layout_marginStart="4dp">
        <com.bytedance.android.live.ktv.common.karaokestation.view.secondleveltab.SecondLevelTabView
            android:layout_gravity="center_vertical"
            android:id="@+id/second_level_tab_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.live.ktv.common.karaokestation.view.ScrollControlViewPager
            android:id="@+id/second_level_tab_fragment_viewpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="3dp"/>
    </FrameLayout>
</LinearLayout>
