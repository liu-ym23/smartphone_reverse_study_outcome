<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/bitable_cell_min_height">
    <com.bytedance.ee.bear.bitable.card.view.cell.text.BitableTextFieldEditor
        android:textSize="@dimen/space_kit_font_14"
        android:textColor="@color/text_title"
        android:id="@+id/url_editor"
        android:background="@null"
        android:paddingLeft="@dimen/space_kit_len_10"
        android:paddingTop="@dimen/space_kit_len_12"
        android:paddingRight="@dimen/space_kit_len_10"
        android:paddingBottom="@dimen/space_kit_len_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLength="10000"
        android:lineSpacingMultiplier="1.2"
        android:inputType="textMultiLine"
        android:imeOptions="actionNext"/>
</LinearLayout>
