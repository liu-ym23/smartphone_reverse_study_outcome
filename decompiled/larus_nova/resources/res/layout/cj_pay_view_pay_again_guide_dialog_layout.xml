<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/insufficient_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/insufficient_dialog_layout"
        android:background="@drawable/cj_pay_bg_common_dialog_radius_8"
        android:layout_width="280dp"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/insufficient_close_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            app:srcCompat="@drawable/cj_pay_icon_titlebar_left_close_noise_reduction"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxWidth="240dp"
            android:layout_below="@+id/insufficient_image"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/cj_pay_color_black_161823"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:layout_gravity="center_horizontal"
                android:id="@+id/insufficient_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cj_pay_insufficient_balance"
                android:maxLines="1"/>
            <ImageView
                android:id="@+id/insufficient_title_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:src="@drawable/cj_pay_icon_dialog_pay_again_info"
                android:layout_toRightOf="@+id/insufficient_center_view"/>
        </LinearLayout>
        <include
            android:layout_gravity="center_horizontal"
            android:id="@+id/insufficient_text_layout1"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            layout="@layout/cj_pay_view_pay_again_guide_text_style2"/>
        <include
            android:layout_gravity="center_horizontal"
            android:id="@+id/insufficient_text_layout2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            layout="@layout/cj_pay_view_pay_again_guide_text_style3"/>
        <include
            android:layout_gravity="center_horizontal"
            android:id="@+id/insufficient_text_layout3"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            layout="@layout/cj_pay_view_pay_again_guide_text_style4"/>
        <include
            android:layout_gravity="center_horizontal"
            android:id="@+id/insufficient_text_layout4"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            layout="@layout/cj_pay_view_pay_again_guide_text_style1"/>
        <include
            android:layout_gravity="center_horizontal"
            android:id="@+id/insufficient_confirm_btn_layout"
            android:layout_width="240dp"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            layout="@layout/cj_pay_view_new_insufficient_btn_layout"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/insufficient_other_method_btn"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:layout_marginBottom="13dp"/>
    </LinearLayout>
    <com.android.ttcjpaysdk.base.ui.widget.CJPayTextLoadingView
        android:id="@+id/cj_pay_insufficient_loading_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
