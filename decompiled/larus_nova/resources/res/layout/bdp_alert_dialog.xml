<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/bdp_parentPanel"
    android:background="@drawable/bdp_dialog_bg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="200dp"
    android:layout_marginStart="40dp"
    android:layout_marginEnd="40dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bdp_topPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/bdp_title_template"
            android:paddingTop="22dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <ImageView
                android:id="@+id/bdp_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@null"
                android:scaleType="fitCenter"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:textSize="17sp"
                android:textColor="@color/bdp_ssxinzi1"
                android:ellipsize="end"
                android:id="@+id/bdp_alertTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/bdp_contentPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/bdp_alert_dialog_item_min_hight"
        android:layout_weight="1">
        <View
            android:layout_gravity="top"
            android:id="@+id/bdp_scrollIndicatorUp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <ScrollView
            android:id="@+id/bdp_scrollView"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/bdp_ssxinzi3"
                    android:id="@+id/bdp_message"
                    android:paddingTop="18dp"
                    android:paddingBottom="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"/>
            </LinearLayout>
        </ScrollView>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/bdp_scrollIndicatorDown"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/bdp_customPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/bdp_alert_dialog_item_min_hight"
        android:layout_weight="1">
        <FrameLayout
            android:id="@+id/bdp_custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/bdp_buttonPanel"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp">
        <Button
            android:id="@+id/bdp_button3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/bdp_alert_dialog_button"/>
        <View
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/bdp_button2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/bdp_alert_dialog_button"/>
        <Button
            android:id="@+id/bdp_button1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/bdp_alert_dialog_button"/>
    </LinearLayout>
</LinearLayout>
