<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/timer_view_placeholder"
            android:layout_width="50dp"
            android:layout_height="14dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.live.liveinteract.view.PositionNameTv
            android:textSize="10dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/ttlive_position_name"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="4dp"
            android:minWidth="14dp"
            android:maxLength="4"
            android:layout_marginEnd="4dp"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintLeft_toRightOf="@+id/timer_view_placeholder"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_default="wrap"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.live.liveinteract.view.SeatPosTagLabelTextView
        android:textSize="10dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="end"
        android:id="@+id/ttlive_seat_pos_tag_label"
        android:background="@drawable/ttllive_video_talk_seat_host_label_bg"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="4dp"
        android:includeFontPadding="false"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        android:layout_marginEnd="4dp"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#ffffff"
        android:layout_gravity="end"
        android:id="@+id/anchor_label"
        android:background="@drawable/ttlive_video_talk_c_enlarge_user_label_bg"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="4dp"
        android:text="@string/ttlive_interact_anchor"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        android:layout_marginEnd="4dp"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="end"
        android:id="@+id/ttlive_mic_room_host_tv"
        android:background="@drawable/ttllive_video_talk_seat_host_label_bg"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="4dp"
        android:text="@string/ttlive_interact_host"
        android:includeFontPadding="false"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        android:layout_marginEnd="4dp"/>
    <View
        android:layout_gravity="start|bottom"
        android:id="@+id/ttlive_paid_time_count_down_bar"
        android:background="@drawable/ttlive_video_talk_paid_count_down_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1.5dp"/>
</FrameLayout>
