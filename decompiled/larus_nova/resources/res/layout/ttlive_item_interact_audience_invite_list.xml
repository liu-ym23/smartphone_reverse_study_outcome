<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="65dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_head"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_gender"
        android:layout_width="14dp"
        android:layout_height="14dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_head"
        app:layout_constraintRight_toRightOf="@+id/iv_head"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/name_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintLeft_toRightOf="@+id/iv_head"
        app:layout_constraintRight_toLeftOf="@+id/btn"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:ellipsize="end"
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="170dp"
            android:maxLines="1"/>
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/friend_layout"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="14dp"
            android:layout_marginStart="4dp">
            <TextView
                android:textSize="10dp"
                android:textColor="@color/ttlive_white"
                android:gravity="center"
                android:id="@+id/tv_friend"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/iv_honor"
            android:layout_width="30dp"
            android:layout_height="14dp"
            android:layout_marginStart="4dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/fans"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginLeft="4dp"
            android:layout_marginStart="4dp">
            <TextView
                android:textSize="8dp"
                android:textColor="@color/ttlive_white"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_fans"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:singleLine="true"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/other_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="2dp"
        app:layout_constraintLeft_toRightOf="@+id/iv_head"
        app:layout_constraintTop_toBottomOf="@+id/name_container">
        <TextView
            android:textSize="13dp"
            android:textColor="#80161823"
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""/>
        <View
            android:id="@+id/gap"
            android:background="#16000000"
            android:layout_width="0.5dp"
            android:layout_height="14dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"/>
        <ImageView
            android:id="@+id/iv_location"
            android:visibility="visible"
            android:layout_width="10dp"
            android:layout_height="12dp"
            android:src="@drawable/ttlive_ic_location"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#80161823"
            android:id="@+id/tv_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:text=""/>
    </LinearLayout>
    <TextView
        android:textSize="13dp"
        android:textColor="#80161823"
        android:ellipsize="end"
        android:gravity="start"
        android:orientation="horizontal"
        android:id="@+id/apply_reason"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="90dp"
        android:maxLines="2"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="90dp"
        app:layout_constraintLeft_toRightOf="@+id/iv_head"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/name_container"/>
    <TextView
        android:textSize="13dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_white"
        android:gravity="center"
        android:id="@+id/btn"
        android:background="@drawable/ttlive_bg_live_red_btn"
        android:layout_width="72dp"
        android:layout_height="28dp"
        android:layout_marginRight="16dp"
        android:text="@string/ttlive_live_interact_accept"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
