<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/fast_gift_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="36dp"
        android:layout_height="36dp">
        <com.bytedance.android.livesdk.widget.CircleProgressViewV3
            android:id="@+id/douyin_ring"
            android:visibility="visible"
            android:layout_width="36dp"
            android:layout_height="36dp"/>
        <com.bytedance.android.live.uikit.rtl.AutoRTLImageView
            android:id="@+id/fast_gift"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginStart="5dp"/>
        <FrameLayout
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/gift_price_container"
            android:layout_width="100dp"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="9dp"
                android:textColor="#e6ffffff"
                android:ellipsize="none"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/gift_price"
                android:background="@drawable/ttlive_recommend_fast_gift_bg"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </FrameLayout>
        <com.bytedance.android.live.uikit.rtl.AutoRTLImageView
            android:layout_gravity="center"
            android:id="@+id/task_gift_coin"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="1dp"
            android:src="@drawable/ttlive_reward_coin"
            android:alpha="0"/>
        <TextView
            android:textSize="8dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/hint_view"
            android:background="@drawable/ttlive_live_bg_fast_gift_hint"
            android:visibility="gone"
            android:layout_width="28dp"
            android:layout_height="12dp"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="4dp"
            android:text="@string/ttlive_live_fast_gift_game_hint"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/pop_up_anim"
            android:visibility="gone"
            android:layout_width="100dp"
            android:layout_height="100dp"
            app:fadeDuration="0"/>
    </FrameLayout>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/recommend_turning_anim"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"/>
    <com.bytedance.android.livesdk.gift.fastgift.FastGiftComboView
        android:layout_gravity="center_horizontal"
        android:id="@+id/fast_gift_combo_view"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="100dp"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="9dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/fast_task_gift_reward_view"
        android:background="@drawable/ttlive_fast_task_gift_reward_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="36dp"
        android:layout_height="12dp"
        android:alpha="0"
        android:translationY="-4dp"/>
</FrameLayout>
