<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/store_product_card_source_wrapper"
    android:background="@color/shopping_std_bg_primary_white"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/store_product_card_store_logo"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="4dp"
            android:layout_marginEnd="4dp"
            app:roundAsCircle="true"
            app:roundedCornerRadius="8dp"
            app:roundingBorderColor="@color/ec_shop_1F161823"
            app:roundingBorderWidth="1dp"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/commerce_color_80161823"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/store_product_card_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
</LinearLayout>
