<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="52dp">
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/anchor_info_container"
        android:background="@drawable/ttlive_bg_user_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="10dp">
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/avatar_container"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true">
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/digg_avatar_animation_container"
                android:layout_width="60dp"
                android:layout_height="60dp"/>
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/digg_thank_container"
                android:paddingLeft="36dp"
                android:paddingRight="8dp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:paddingStart="36dp"
                android:paddingEnd="8dp"/>
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/room_certification_container"
                android:paddingLeft="36dp"
                android:paddingRight="8dp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:paddingStart="36dp"
                android:paddingEnd="8dp"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="center"
                android:id="@+id/head"
                android:background="@drawable/ttlive_bg_circle_head"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="fitXY"/>
            <TextView
                android:textSize="8sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/user_no_beauty_label"
                android:background="@drawable/ttlive_bg_user_no_beauty_label"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="12dp"
                android:layout_marginBottom="2dp"
                android:text="@string/live_room_no_beauty_label"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/action_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/live_room_user_info_inside_spacing"
            android:layout_toRightOf="@+id/name_layout"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/live_room_user_info_inside_spacing"
            android:layout_toEndOf="@+id/name_layout">
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/follow_layout"
                android:layout_width="34dp"
                android:layout_height="28dp">
                <com.bytedance.android.live.core.widget.FitTextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/live_room_live_follow_button_text_color"
                    android:gravity="center"
                    android:id="@+id/follow"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/ttlive_follow_label"/>
                <ProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/follow_progress"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/live_room_follow_botton_progress_bar"/>
            </FrameLayout>
            <View
                android:id="@+id/fans_club_stub"
                android:layout_width="41dp"
                android:layout_height="28dp"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/fans_club_widget_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="-4dp"
            android:layout_alignRight="@+id/action_layout"
            android:layout_marginEnd="-4dp"
            android:layout_alignEnd="@+id/action_layout"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/name_layout"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/live_room_user_info_inside_spacing"
            android:layout_marginRight="@dimen/live_room_user_info_inside_spacing"
            android:layout_toRightOf="@+id/avatar_container"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/live_room_user_info_inside_spacing"
            android:layout_marginEnd="@dimen/live_room_user_info_inside_spacing"
            android:layout_toEndOf="@+id/avatar_container">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ttlive_white"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <com.bytedance.android.livesdk.common.MarqueeTextView
                android:id="@+id/marquee_user_name"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="8sp"
                android:textColor="@color/ttlive_core_hs_w1_transparent_70"
                android:gravity="center"
                android:id="@+id/ticket_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="1dp"
                android:singleLine="true"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/ttlive_hs_w2"
                android:gravity="center"
                android:id="@+id/fans_number"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="1dp"
                android:singleLine="true"
                android:includeFontPadding="false"/>
            <FrameLayout
                android:layout_gravity="start|center_vertical"
                android:id="@+id/fl_room_cert"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/temp_anim_name_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignLeft="@+id/name_layout"
            android:layout_alignTop="@+id/name_layout"
            android:layout_alignRight="@+id/name_layout"
            android:layout_alignBottom="@+id/name_layout"
            android:layout_alignStart="@+id/name_layout"
            android:layout_alignEnd="@+id/name_layout">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ttlive_white"
                android:ellipsize="end"
                android:id="@+id/temp_anim_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <TextView
                android:textSize="8sp"
                android:textColor="@color/ttlive_core_hs_w1_transparent_70"
                android:id="@+id/temp_anim_sub_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="1dp"
                android:singleLine="true"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_middle_container"
            android:layout_width="72dp"
            android:layout_height="36dp"
            android:layout_marginLeft="@dimen/live_room_user_info_inside_spacing"
            android:layout_marginRight="@dimen/live_room_user_info_inside_spacing"
            android:layout_toRightOf="@+id/avatar_container"
            android:layout_marginStart="@dimen/live_room_user_info_inside_spacing"
            android:layout_marginEnd="@dimen/live_room_user_info_inside_spacing"
            android:layout_toEndOf="@+id/avatar_container">
            <com.bytedance.android.live.room.navi.userinfo.flipper.UserInfoFlipperLayout
                android:id="@+id/first_tab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flipper_auto_start="true"/>
            <com.bytedance.android.live.room.navi.userinfo.flipper.UserInfoFlipperLayout
                android:id="@+id/second_tab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flipper_auto_start="true"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/add_ticket_layout"
            android:visibility="gone"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/live_room_user_info_inside_spacing"
            android:layout_marginRight="@dimen/live_room_user_info_inside_spacing"
            android:layout_toRightOf="@+id/avatar_container"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/live_room_user_info_inside_spacing"
            android:layout_marginEnd="@dimen/live_room_user_info_inside_spacing"
            android:layout_toEndOf="@+id/avatar_container">
            <TextView
                android:textSize="12sp"
                android:textColor="#f8f8f8"
                android:id="@+id/add_ticket_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:singleLine="true"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/ttlive_core_hs_w1_transparent_70"
                android:id="@+id/add_ticket_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/live_room_live_end_ticket_count_label"
                android:singleLine="true"/>
        </LinearLayout>
    </RelativeLayout>
    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginLeft="2dp"
        android:layout_marginStart="2dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/iv_ceremony_border"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginLeft="7dp"
            android:layout_marginTop="7dp"
            android:layout_marginStart="7dp"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/new_iv_ceremony_border"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginStart="6dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/digg_heart_animation_container"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="-7.35dp"
        android:layout_marginStart="12dp"/>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/user_gift_exhibition_light_container"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="10dp"/>
</RelativeLayout>
