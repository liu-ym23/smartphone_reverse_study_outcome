<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:gravity="start|center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/leftImg"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_12"
        android:layout_height="?attr/larus_dp_20"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"/>
    <FrameLayout
        android:layout_gravity="center"
        android:background="@color/larus_black"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="6dp"
        android:layout_toLeftOf="@+id/rightImg"
        android:layout_toRightOf="@+id/leftImg"
        android:layout_centerInParent="true"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="6dp">
        <androidx.recyclerview.widget.RecyclerView
            android:layout_gravity="center"
            android:id="@+id/centerListView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <com.facebook.drawee.view.SimpleDraweeView
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/rightImg"
        android:visibility="visible"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:scaleType="fitCenter"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"/>
</RelativeLayout>
