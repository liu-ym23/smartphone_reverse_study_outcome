<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shopping_homepage_layout_native_live_card_367061889"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.shopping.api.mall.common.homepage.card.common.ECUpdateHeightConstraintLayout
        android:id="@+id/mall_live_card_root_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/live_cover_image_top_blur"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scaleType="matrix"
            android:importantForAccessibility="no"
            app:layout_constraintTop_toTopOf="@+id/live_cover_image"/>
        <ImageView
            android:id="@+id/live_cover_image_bottom_blur"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scaleType="matrix"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/live_cover_image"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/live_cover_image"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toTopOf="@+id/bottom_info_view"
            app:layout_constraintDimensionRatio="0.8028169014"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.shopping.api.mall.common.homepage.card.common.ECRoundedCornerImageView
            android:id="@+id/live_view_frame"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/live_cover_image"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/live_cover_image"/>
        <com.bytedance.android.shopping.api.mall.common.homepage.card.common.ECRoundedFrameLayout
            android:id="@+id/live_view_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/live_cover_image"
            app:layout_constraintDimensionRatio="0.8028169014"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/live_cover_image">
            <com.bytedance.android.shopping.api.mall.common.homepage.card.common.ECGradientView
                android:id="@+id/player_mask"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.bytedance.android.shopping.api.mall.common.homepage.card.common.ECRoundedFrameLayout>
        <ImageView
            android:id="@+id/mall_homepage_card_live_mute_view"
            android:paddingLeft="10dp"
            android:paddingTop="10dp"
            android:paddingRight="10dp"
            android:paddingBottom="10dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/shopping_homepage_ic_unmute_playback"
            android:importantForAccessibility="no"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/live_layer_play_info_container"
            android:background="@drawable/shopping_homepage_product_float_message_bg"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:importantForAccessibility="no"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/live_layer_play_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"/>
            <TextView
                android:textSize="11dp"
                android:gravity="center"
                android:id="@+id/live_layer_message"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="8dp"
                android:includeFontPadding="false"
                android:importantForAccessibility="no"/>
        </LinearLayout>
        <View
            android:id="@+id/cover_bottom_mask"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/live_cover_image"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/live_layer_merchant_image"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginBottom="10dp"
            android:importantForAccessibility="no"
            android:layout_marginStart="10dp"
            app:fadeDuration="300"
            app:layout_constraintBottom_toBottomOf="@+id/live_view_container"
            app:layout_constraintLeft_toLeftOf="parent"
            app:roundAsCircle="false"
            app:roundedCornerRadius="10dp"/>
        <TextView
            android:textSize="14dp"
            android:ellipsize="end"
            android:id="@+id/live_layer_merchant_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:importantForAccessibility="no"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="7dp"
            app:layout_constraintBottom_toBottomOf="@+id/live_layer_merchant_image"
            app:layout_constraintLeft_toRightOf="@+id/live_layer_merchant_image"
            app:layout_constraintRight_toLeftOf="@+id/live_widget_image"
            app:layout_constraintTop_toTopOf="@+id/live_layer_merchant_image"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/live_widget_image"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:layout_marginBottom="10dp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/live_view_container"
            app:layout_constraintRight_toRightOf="parent"/>
        <com.bytedance.android.shopping.mall.homepage.card.product.ProductTextView
            android:gravity="center"
            android:id="@+id/live_widget_image_privilege_text"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/live_widget_image"
            app:layout_constraintLeft_toLeftOf="@+id/live_widget_image"
            app:layout_constraintRight_toRightOf="@+id/live_widget_image"/>
        <View
            android:id="@+id/arrive_time_bg"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_marginLeft="3dp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/arrive_time_icon"
            app:layout_constraintEnd_toEndOf="@+id/arrive_time"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/arrive_time_icon"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/arrive_time_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="6dp"
            android:layout_marginBottom="8dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/live_view_container"
            app:layout_constraintLeft_toLeftOf="parent"/>
        <com.bytedance.android.shopping.mall.homepage.card.product.ProductTextView
            android:textSize="11dp"
            android:textColor="#ffffffff"
            android:gravity="center"
            android:id="@+id/arrive_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="0.5dp"
            android:includeFontPadding="false"
            android:shadowColor="#57000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/arrive_time_icon"
            app:layout_constraintLeft_toRightOf="@+id/arrive_time_icon"
            app:layout_constraintTop_toTopOf="@+id/arrive_time_icon"/>
        <com.bytedance.android.shopping.mall.homepage.card.product.ProductPriceView
            android:id="@+id/live_product_price_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/arrive_time_icon"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/arrive_time_icon"/>
        <com.bytedance.android.shopping.mall.homepage.card.common.ProductView
            android:id="@+id/product_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/live_view_container"/>
        <com.bytedance.android.shopping.mall.homepage.card.common.BottomInfoView
            android:id="@+id/bottom_info_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="6dp"
            android:layout_marginBottom="8dp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/live_cover_image"/>
        <ImageView
            android:id="@+id/ad_small_black_dot"
            android:background="#57ffffff"
            android:layout_width="0.5dp"
            android:layout_height="0.5dp"
            android:importantForAccessibility="no"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <include
            android:id="@+id/live_watched_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_weight="1"
            layout="@layout/shopping_homepage_card_watched_layout"/>
        <FrameLayout
            android:id="@+id/coin_panel"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="10dp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bottom_info_view"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/live_simple_product_image_view"
            android:visibility="gone"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginBottom="32dp"
            android:layout_marginEnd="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:roundAsCircle="false"
            app:roundedCornerRadius="8dp"
            app:roundingBorderColor="#ffffff"
            app:roundingBorderWidth="1dp"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/mall_live_card_anim_top_left"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.bytedance.android.shopping.api.mall.common.homepage.card.common.ECUpdateHeightConstraintLayout>
    <FrameLayout
        android:id="@+id/wind_vane_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/mall_live_card_root_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
