<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rootView"
    android:background="@color/ud_N100"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.widgets.BaseTitleBar
        android:id="@+id/titleBar"
        android:background="@color/bg_body"
        android:layout_width="match_parent"
        android:layout_height="50dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.ee.bear.facade.common.widget.BearLottieView
            android:layout_gravity="center"
            android:id="@+id/loadingView"
            android:visibility="gone"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/loading_anim"
            style="@style/BearLottieView"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/loadingFailedLayout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:layout_width="125dp"
                android:layout_height="125dp"
                app:srcCompat="@drawable/ccm_empty_negative_load_failed"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_caption"
                android:id="@+id/fail_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/CreationMobile_Common_Placeholder_FailedToLoad"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/horizontal_header_content"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_gravity="center"
                    android:id="@+id/header_permission_text"
                    android:padding="12dp"
                    android:layout_width="82dp"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/space_kit_font_14"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/LarkCCM_Workspace_Security_Settings_Title"/>
                </LinearLayout>
                <View
                    android:background="@color/ud_B500_15"
                    android:layout_width="1px"
                    android:layout_height="match_parent"/>
                <com.bytedance.ee.bear.middleground.permission.secret.detail.SyncHorizontalScrollView
                    android:id="@+id/header_horizontal"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <androidx.recyclerview.widget.RecyclerView
                            android:gravity="center"
                            android:id="@+id/header_recycleView"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </RelativeLayout>
                </com.bytedance.ee.bear.middleground.permission.secret.detail.SyncHorizontalScrollView>
            </LinearLayout>
            <View
                android:id="@+id/header_line"
                android:background="@color/ud_B500_15"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
        </LinearLayout>
        <ScrollView
            android:id="@+id/scroll_content"
            android:visibility="gone"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:background="@color/bg_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.bytedance.ee.bear.middleground.permission.secret.detail.NoscrollRecycleView
                    android:id="@+id/lv_left"
                    android:scrollbars="none"
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"/>
                <View
                    android:background="#cccccc"
                    android:layout_width="1px"
                    android:layout_height="match_parent"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/lin_data_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.bytedance.ee.bear.middleground.permission.secret.detail.SyncHorizontalScrollView
                        android:id="@+id/data_horizontal"
                        android:scrollbars="none"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:overScrollMode="never">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <com.bytedance.ee.bear.middleground.permission.secret.detail.NoscrollRecycleView
                                android:id="@+id/lv_data"
                                android:scrollbars="none"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:overScrollMode="never"/>
                        </RelativeLayout>
                    </com.bytedance.ee.bear.middleground.permission.secret.detail.SyncHorizontalScrollView>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
