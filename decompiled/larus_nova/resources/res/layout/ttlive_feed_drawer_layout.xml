<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ttlive_feed_drawer_top_bar_height">
        <RelativeLayout
            android:id="@+id/back_icon"
            android:visibility="gone"
            android:layout_width="@dimen/ttlive_feed_drawer_top_bar_height"
            android:layout_height="@dimen/ttlive_feed_drawer_top_bar_height"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true">
            <ImageView
                android:id="@+id/imv_back_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ttlive_feed_drawer_back"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <com.bytedance.android.livesdk.feed.LiveDrawerPagerSlidingTabStrip
            android:id="@+id/pager_tab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toLeftOf="@+id/left_container"
            android:layout_toRightOf="@+id/back_icon"
            android:layout_centerInParent="true"
            android:layout_toStartOf="@+id/left_container"
            android:layout_toEndOf="@+id/back_icon"
            app:tab_background="@color/transparent"
            app:tab_indicator_height="2dp"
            app:tab_indicator_width="50dp"
            app:tab_padding_left_right="10dp"
            app:tab_should_expand="false"
            app:tab_text_color="#80ffffff"
            app:tab_text_select_size="20dp"
            app:tab_text_size="15dp"
            app:tab_underline_color="#0000"/>
        <com.bytedance.android.livesdk.feed.LiveDrawerTabScrollShadow
            android:id="@+id/pager_shadow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignLeft="@+id/pager_tab"
            android:layout_alignTop="@+id/pager_tab"
            android:layout_alignRight="@+id/pager_tab"
            android:layout_alignStart="@+id/pager_tab"
            android:layout_alignEnd="@+id/pager_tab"/>
        <LinearLayout
            android:id="@+id/left_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/history_container"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ttlive_feed_drawer_top_bar_height"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="2dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="2dp">
                <ImageView
                    android:id="@+id/history_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ttlive_ic_searshbar_history"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/yellow_point"
                    android:visibility="gone"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:src="@drawable/ttlive_bg_yellow_point"
                    app:layout_constraintEnd_toEndOf="@+id/history_icon"
                    app:layout_constraintTop_toTopOf="@+id/history_icon"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <RelativeLayout
                android:id="@+id/search_icon"
                android:layout_width="@dimen/ttlive_feed_drawer_top_bar_height"
                android:layout_height="@dimen/ttlive_feed_drawer_top_bar_height">
                <ImageView
                    android:id="@+id/imv_search_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ttlive_feed_ic_searshbar_search"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/pager_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/top">
        <View
            android:id="@+id/divider"
            android:background="@color/ttlive_hs_s32"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <com.bytedance.android.live.uikit.viewpager.SSViewPager
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/divider"/>
        <com.bytedance.android.livesdk.chatroom.ui.DouyinLoadingLayout
            android:id="@+id/loading_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_white"
        android:gravity="center"
        android:id="@+id/bt_start_live"
        android:background="@drawable/ttlive_feed_start_btn1"
        android:layout_width="218dp"
        android:layout_height="48dp"
        android:layout_marginBottom="32dp"
        android:text="开直播"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/bt_start_live2"
        android:layout_width="116dp"
        android:layout_height="48dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="46dp"
        android:src="@drawable/ttlive_feed_douyin_start_live_type2"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
