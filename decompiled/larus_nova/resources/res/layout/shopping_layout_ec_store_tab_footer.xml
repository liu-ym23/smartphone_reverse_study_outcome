<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.ec.core.widget.LoadMoreStatusView
        android:id="@+id/sv_product_load_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:id="@+id/rl_product_no_more"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/shopping_std_text_black_4"
            android:gravity="center"
            android:id="@+id/tv_product_no_more"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/shopping_slide_bottom_to_moment_tab"
            android:layout_centerHorizontal="true"/>
    </LinearLayout>
</LinearLayout>
