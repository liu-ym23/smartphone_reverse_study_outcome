<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/update_check_white_bg"
    android:layout_width="272dp"
    android:layout_height="276dp">
    <RelativeLayout
        android:id="@+id/update_sdk_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">
        <ImageView
            android:id="@+id/update_check_cancel_btn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="8dp"
            android:src="@drawable/btn_appupdate_close"
            android:layout_alignParentRight="true"
            android:contentDescription="@string/description_close_button"/>
        <TextView
            android:textSize="19sp"
            android:textColor="#222204"
            android:paddingTop="28dp"
            android:paddingBottom="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/check_dialog_title"
            android:includeFontPadding="false"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <ScrollView
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/scroll_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="73dp"
        android:layout_below="@+id/update_sdk_title">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/update_content_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="102dp"
        android:layout_alignParentBottom="true">
        <View
            android:background="@drawable/update_scroll_bg"
            android:layout_width="wrap_content"
            android:layout_height="58dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="#f9f9f9"
            android:gravity="center"
            android:id="@+id/update_check_ok_btn"
            android:background="@drawable/update_check_ok_bg"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/check_dialog_btn"/>
    </LinearLayout>
</RelativeLayout>
