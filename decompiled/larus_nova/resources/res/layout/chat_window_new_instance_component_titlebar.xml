<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/title_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.ss.android.lark.ui.CommonTitleBar
        android:id="@+id/titlebar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/titlebar_divider"
        android:background="@color/line_border_card"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toBottomOf="@+id/titlebar"/>
    <ImageView
        android:id="@+id/hide_back"
        android:background="@drawable/chat_window_back_bg_selector"
        android:paddingTop="6dp"
        android:paddingBottom="18dp"
        android:visibility="gone"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:scaleType="center"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
