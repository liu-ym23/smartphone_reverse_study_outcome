<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="?attr/larus_dp_21"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_65">
    <TextView
        android:textSize="?attr/larus_dp_16"
        android:textStyle="bold"
        android:textColor="@color/larus_base_1"
        android:gravity="center"
        android:id="@+id/tv_invite_info_index"
        android:background="@drawable/larus_bg_invite_friends_label_layered"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:text="2"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_16"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/tv_invite_info_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_invite_info_index"
        app:layout_constraintTop_toTopOf="@+id/tv_invite_info_index"/>
    <TextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="@color/larus_neutral_50"
        android:ellipsize="end"
        android:id="@+id/tv_invite_info_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_6"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/tv_invite_info_index"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_invite_info_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_invite_info_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
