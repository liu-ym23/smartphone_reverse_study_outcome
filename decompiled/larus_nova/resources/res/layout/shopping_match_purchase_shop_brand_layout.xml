<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/shopping_match_purchase_shop_brand_layout_1097277686"
    android:padding="14dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ic_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="6dp"
        android:src="@drawable/shopping_match_purchase_ic_close"
        android:layout_marginEnd="6dp"/>
    <com.bytedance.android.ec.core.widget.RoundedFrameLayout
        android:layout_width="27dp"
        android:layout_height="27dp"
        android:layout_marginRight="8dp"
        android:layout_marginEnd="8dp"
        app:rounded_radius="4dp">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/shop_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.bytedance.android.ec.core.widget.RoundedFrameLayout>
    <TextView
        android:textColor="@color/TextPrimary"
        android:ellipsize="end"
        android:id="@+id/tv_shop_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_weight="1"
        style="@style/font_size_30"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_jump_other_combination"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/TextPrimary"
            android:id="@+id/tv_combination_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:text="@string/shopping_match_purchase_shop_brand_hint"
            android:layout_marginEnd="5dp"
            style="@style/font_size_26"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/iv_jump_other_page"
            android:layout_width="13dp"
            android:layout_height="13dp"
            app:placeholderImage="@drawable/shopping_match_purchase_jump_icon"/>
    </LinearLayout>
</LinearLayout>
