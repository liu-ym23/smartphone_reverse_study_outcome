<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="164dp"
    android:layout_height="213dp">
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerConstraintLayout
        android:id="@+id/content_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="8dp"
        app:ttlive_allRadius="12dp">
        <View
            android:background="#161823"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/feedback_blur_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.4"/>
        <com.bytedance.android.livesdkapi.roomplayer.LivePlayerView
            android:id="@+id/feed_back_player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:ttlive_player_scene="inner_feed_back"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/preview_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:background="@drawable/ttlive_bg_feedback_large_preview_gradient"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="44dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/sub_title"
            app:layout_constraintEnd_toEndOf="@+id/like_view"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/sub_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:singleLine="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="44dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.bytedance.android.livesdk.feedback.view.preview.FeedbackLikeView
            android:id="@+id/like_view"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginBottom="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
