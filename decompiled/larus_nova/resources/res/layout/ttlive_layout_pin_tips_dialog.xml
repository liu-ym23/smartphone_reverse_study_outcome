<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.widget.roundcorner.RoundCornerLinearlayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:ttlive_leftTopRadius="10dp"
    app:ttlive_rightTopRadius="10dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="187dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/img"
            android:layout_width="match_parent"
            android:layout_height="187dp"/>
        <Button
            android:id="@+id/btn_close"
            android:background="@drawable/pin_tips_dialog_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/ttlive_pin_tips_gray"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/ttlive_pin_tips_dialog_title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ttlive_pin_tips_75_gray"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="24dp"
        android:text="@string/ttlive_pin_tips_dialog_subtitle"/>
    <Button
        android:textSize="15sp"
        android:textColor="@color/white"
        android:id="@+id/operation_pin"
        android:background="@drawable/ttlive_pin_tips_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="44dp"
        android:text="@string/ttlive_pin_tips_dialog_button"/>
</com.bytedance.android.livesdk.widget.roundcorner.RoundCornerLinearlayout>
