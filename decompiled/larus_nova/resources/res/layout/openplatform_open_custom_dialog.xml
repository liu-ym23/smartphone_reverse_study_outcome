<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/custom_dialog_fl"
    android:background="@drawable/openplatform_open_custom_dialog_bg"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/content_tv"
        android:layout_width="match_parent"
        android:layout_height="96dp"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/content_fl"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <View
        android:id="@+id/horizontal_divide"
        android:background="#1f161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/click_ll"
        android:layout_width="match_parent"
        android:layout_height="47.5dp">
        <TextView
            android:textSize="15dp"
            android:textColor="#bf161823"
            android:gravity="center"
            android:id="@+id/cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/aweme_open_dialog_cancel"
            android:layout_weight="1"/>
        <View
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/vertical_divide"
            android:background="#1f161823"
            android:layout_width="0.5dp"
            android:layout_height="47.5dp"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:gravity="center"
            android:id="@+id/confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/aweme_open_dialog_confirm"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
