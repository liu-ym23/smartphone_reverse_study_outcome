<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@drawable/shopping_bg_store_recommend_background_no_product"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="32dp">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="155sp"
            android:layout_height="12sp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/ecommerce_text_slogan_recommend"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/store_v2_iv_image"
            android:layout_width="150sp"
            android:layout_height="100sp"
            android:src="@drawable/ecommerce_store_ic_goods_empty"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/ec_shop_99161823"
            android:gravity="center"
            android:id="@+id/store_tv_new_product_comming"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ec_store_commerce_store_product_coming"/>
        <RelativeLayout
            android:id="@+id/store_to_shop_entrance_wrapper"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/shopping_std_text_black_4"
                android:gravity="center"
                android:id="@+id/no_product"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/store_to_shop_entrance"
                android:background="@drawable/shopping_shop_to_store_bottom_block"
                android:layout_width="110dp"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:layout_below="@+id/no_product"
                android:layout_centerHorizontal="true">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/shopping_std_text_black_2"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/strore_or_shop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ec_store_commerce_go_store_v2"
                    android:layout_marginStart="2dp"/>
                <com.facebook.drawee.view.SimpleDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/store_to_shop_img"
                    android:layout_width="16sp"
                    android:layout_height="16sp"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</FrameLayout>
