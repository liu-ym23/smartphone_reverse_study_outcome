<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_interactivity_share_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="12dp"
        android:textColor="#99161823"
        android:gravity="center"
        android:id="@+id/tv_panel_hint"
        android:background="#f4f3f4"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:text="@string/ttlive_interactivity_share_panel_hint"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/share_item_list"
            android:padding="16dp"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/empty_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/empty_view"
                android:layout_width="192dp"
                android:layout_height="168dp"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#99161823"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="17dp"
                android:text="@string/ttlive_interactivity_share_network_error"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
