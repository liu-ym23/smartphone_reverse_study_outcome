<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/annie_web_risk_rl"
    android:background="#0afe3824"
    android:layout_width="match_parent"
    android:layout_height="50dp">
    <ImageView
        android:id="@+id/annie_web_risk_info_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="17dp"
        android:src="@drawable/annie_web_risk_info"
        android:layout_centerVertical="true"
        android:layout_marginStart="17dp"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#fe3824"
        android:gravity="center_vertical"
        android:id="@+id/annie_web_risk_info_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:layout_toEndOf="@+id/annie_web_risk_info_iv"/>
    <ImageView
        android:id="@+id/annie_web_risk_close_banner_iv"
        android:layout_width="44dp"
        android:layout_height="match_parent"
        android:src="@drawable/annie_web_risk_close_banner"
        android:scaleType="centerInside"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
