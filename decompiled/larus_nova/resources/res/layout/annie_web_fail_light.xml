<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="4"/>
    <ImageView
        android:id="@+id/fail_background"
        android:layout_width="220dp"
        android:layout_height="160dp"
        android:src="@drawable/annie_web_fail_bg_light"/>
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/annie_network_error"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#99161823"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/annie_retry_after_check_notwork"/>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="3"/>
    <Button
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:id="@+id/web_retry"
        android:background="@drawable/annie_bg_retry_btn_light"
        android:layout_width="220dp"
        android:layout_height="40dp"
        android:text="@string/annie_retry"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#99161823"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/fail_close"
        android:layout_width="100dp"
        android:layout_height="44dp"
        android:text="@string/annie_button_close"/>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="3"/>
</LinearLayout>
