<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_explain_card_layout_bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no">
    <FrameLayout
        android:id="@+id/ec_explain_card_background"
        android:background="@drawable/ec_bg_promotion_card_new_style"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.livesdk.livecommerce.view.roundcorner.RoundCornerFrameLayout
            android:id="@+id/fl_ec_main_image"
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="2dp"
            app:ec_leftTopRadius="14dp"
            app:ec_rightTopRadius="14dp">
            <com.bytedance.android.ec.core.widget.ECPromotionImageView
                android:id="@+id/iv_ec_main_image"
                android:layout_width="108dp"
                android:layout_height="108dp"
                android:scaleType="centerCrop"/>
        </com.bytedance.android.livesdk.livecommerce.view.roundcorner.RoundCornerFrameLayout>
        <com.bytedance.android.ec.core.widget.ECNetImageView
            android:id="@+id/iv_ec_activity_cover"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            app:actualImageScaleType="fitXY"/>
        <com.bytedance.android.livesdk.livecommerce.room.widgets.promotion_card.refactor.widget.CombinationView
            android:id="@+id/cv_ec_combination"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="29dp"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="79dp"
            android:layout_marginRight="4dp"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/layout_tryon"
            android:visibility="gone"
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/ec_bg_promotion_card_center_tryon"
                android:paddingLeft="7dp"
                android:paddingRight="7dp"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp">
                <com.bytedance.android.ec.core.widget.ECNetImageView
                    android:id="@+id/iv_tryon_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:actualImageScaleType="fitXY"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/ec_color_white"
                    android:ellipsize="end"
                    android:id="@+id/tv_tryon_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lines="1"/>
                <com.bytedance.android.ec.core.widget.ECNetImageView
                    android:id="@+id/iv_tryon_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:actualImageScaleType="fitXY"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/ec_explain_card_status"
        android:background="@drawable/ec_bg_promotion_card_status_bar"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_margin="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <include
            android:id="@+id/layout_tag_1"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginTop="5dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="20dp"
            layout="@layout/ec_explain_card_uimodule_status_up_icon"/>
        <include
            android:id="@+id/layout_tag_2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginTop="5dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="20dp"
            layout="@layout/ec_explain_card_uimodule_status_up_icon"/>
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/iv_close"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="5dp"
            android:src="@drawable/ec_ic_explain_card_close"
            android:scaleType="centerInside"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="3dp"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/gl_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="111dp"/>
    <include
        android:id="@+id/layout_promotion_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/ec_card_promotion_info_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gl_info"
        layout="@layout/ec_explain_card_info_layout"/>
    <FrameLayout
        android:id="@+id/ec_card_promotion_info_container"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_promotion_info">
        <com.bytedance.android.livesdk.livecommerce.view.roundcorner.RoundCornerRelativeLayout
            android:orientation="horizontal"
            android:id="@+id/card_bottom"
            android:background="@drawable/ec_bg_promotion_card_bottom"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.android.livesdk.livecommerce.view.roundcorner.RoundCornerFrameLayout
                android:id="@+id/fl_card_anim"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true">
                <com.bytedance.android.livesdk.livecommerce.view.ECLottieAnimationView
                    android:id="@+id/iv_card_anim"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    app:lottie_autoPlay="false"/>
            </com.bytedance.android.livesdk.livecommerce.view.roundcorner.RoundCornerFrameLayout>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:paddingEnd="1dp"
                android:layout_toStartOf="@+id/iv_bottom_button"
                android:layout_alignParentStart="true">
                <com.bytedance.android.ec.core.widget.price.PriceView
                    android:textSize="14dp"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/ecpv_price"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    app:pv_autoResize="true"
                    app:pv_prefixMarginRight="1dp"
                    app:pv_prefixTextSizeRatio="0.714"
                    app:pv_priceBold="true"
                    app:pv_priceDecimalTextSizeRatio="1"
                    app:pv_priceTextColor="@color/ec_color_white"
                    app:pv_yuanSymbolMarginRight="1dp"
                    app:pv_yuanSymbolRatioOfPriceTextSize="0.714"/>
            </FrameLayout>
            <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
                android:id="@+id/iv_bottom_button_bg"
                android:layout_width="33dp"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                app:layoutMode="self_adjust_3X"/>
            <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
                android:id="@+id/iv_bottom_button"
                android:layout_width="33dp"
                android:layout_height="match_parent"
                android:contentDescription="@string/ec_tip_buy"
                android:layout_alignParentEnd="true"
                app:layoutMode="self_adjust_3X"/>
        </com.bytedance.android.livesdk.livecommerce.view.roundcorner.RoundCornerRelativeLayout>
        <com.bytedance.android.ec.core.widget.ECNetImageView
            android:id="@+id/iv_appointment_img"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/fl_extend_info_root"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/ec_card_promotion_info_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.livesdk.livecommerce.view.roundcorner.RoundCornerLinearlayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_small_card_top"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            app:ec_leftTopRadius="10dp"
            app:ec_rightTopRadius="10dp">
            <com.bytedance.android.livesdk.livecommerce.view.roundcorner.RoundCornerFrameLayout
                android:id="@+id/fl_small_card_cover"
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:ec_allRadius="6dp">
                <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
                    android:id="@+id/dv_small_card_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <View
                    android:id="@+id/v_small_card_cover_mask"
                    android:background="@color/shopping_color_44000000"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.bytedance.android.livesdk.livecommerce.view.roundcorner.RoundCornerFrameLayout>
            <FrameLayout
                android:id="@+id/fl_small_card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include
                    android:id="@+id/layout_small_card_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    layout="@layout/ec_explain_card_info_layout"/>
                <com.bytedance.android.livesdk.livecommerce.iron.ui.ECCustomizedElementView
                    android:gravity="start|top"
                    android:id="@+id/cev_small_card_top_content"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"/>
            </FrameLayout>
        </com.bytedance.android.livesdk.livecommerce.view.roundcorner.RoundCornerLinearlayout>
        <FrameLayout
            android:id="@+id/fl_extend_info_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
