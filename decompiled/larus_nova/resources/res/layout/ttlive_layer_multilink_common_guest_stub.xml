<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center"
        android:id="@+id/ttlive_guest_bg"
        android:background="@drawable/ttlive_equal_talkroom_window_empty_bg"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="#57000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/guest_info_container"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ttlive_guest_container"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/guest_info_container"
            app:layout_constraintLeft_toLeftOf="@+id/guest_info_container"
            app:layout_constraintRight_toRightOf="@+id/guest_info_container"
            app:layout_constraintTop_toTopOf="@+id/guest_info_container">
            <View
                android:id="@+id/guide_view_left"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/ttlive_guest_avatar"
                app:layout_constraintEnd_toStartOf="@+id/ttlive_guest_avatar"
                app:layout_constraintHorizontal_weight="236"
                app:layout_constraintStart_toStartOf="@+id/ttlive_guest_container"
                app:layout_constraintTop_toTopOf="@+id/ttlive_guest_container"
                app:layout_constraintVertical_weight="236"/>
            <View
                android:id="@+id/guide_view_widget_right"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/ttlive_avatar_right_top_widget"
                app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_container"
                app:layout_constraintHorizontal_weight="0"
                app:layout_constraintStart_toEndOf="@+id/ttlive_avatar_right_top_widget"
                app:layout_constraintTop_toTopOf="@+id/ttlive_guest_container"
                app:layout_constraintVertical_weight="0"/>
            <View
                android:id="@+id/guide_view_right"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_container"
                app:layout_constraintHorizontal_weight="236"
                app:layout_constraintStart_toEndOf="@+id/ttlive_guest_avatar"
                app:layout_constraintTop_toBottomOf="@+id/ttlive_guest_avatar"
                app:layout_constraintVertical_weight="236"/>
            <View
                android:id="@+id/guide_view_widget_left"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ttlive_avatar_right_top_widget"
                app:layout_constraintHorizontal_weight="500"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ttlive_avatar_right_top_widget"
                app:layout_constraintVertical_weight="500"/>
            <View
                android:id="@+id/guide_view_left_for_volume"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/ttlive_volume_Anim"
                app:layout_constraintEnd_toStartOf="@+id/ttlive_volume_Anim"
                app:layout_constraintHorizontal_weight="148"
                app:layout_constraintStart_toStartOf="@+id/ttlive_guest_container"
                app:layout_constraintTop_toTopOf="@+id/ttlive_guest_container"
                app:layout_constraintVertical_weight="148"/>
            <View
                android:id="@+id/guide_view_right_for_volume"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/ttlive_guest_container"
                app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_container"
                app:layout_constraintHorizontal_weight="148"
                app:layout_constraintStart_toEndOf="@+id/ttlive_volume_Anim"
                app:layout_constraintTop_toBottomOf="@+id/ttlive_volume_Anim"
                app:layout_constraintVertical_weight="148"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/ttlive_guest_avatar"
                android:background="@drawable/ttlive_build_linking_avatar"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/guide_view_right"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toStartOf="@+id/guide_view_right"
                app:layout_constraintHorizontal_weight="528"
                app:layout_constraintStart_toEndOf="@+id/guide_view_left"
                app:layout_constraintTop_toBottomOf="@+id/guide_view_left"
                app:layout_constraintVertical_weight="528"
                app:roundAsCircle="true"/>
            <com.bytedance.android.livesdk.common.AnchorPauseTipsView
                android:id="@+id/ttlive_leave_view"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/ttlive_guest_avatar"
                app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_avatar"
                app:layout_constraintStart_toStartOf="@+id/ttlive_guest_avatar"
                app:layout_constraintTop_toTopOf="@+id/ttlive_guest_avatar"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/ttlive_volume_Anim"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/guide_view_right_for_volume"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toStartOf="@+id/guide_view_right_for_volume"
                app:layout_constraintHorizontal_weight="704"
                app:layout_constraintStart_toEndOf="@+id/guide_view_left_for_volume"
                app:layout_constraintTop_toBottomOf="@+id/guide_view_left_for_volume"
                app:layout_constraintVertical_weight="704"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/ttlive_avatar_right_top_widget"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:translationX="3dp"
                android:translationY="-3dp"
                app:layout_constraintBottom_toTopOf="@+id/guide_view_widget_left"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toStartOf="@+id/guide_view_widget_right"
                app:layout_constraintHorizontal_weight="528"
                app:layout_constraintStart_toEndOf="@+id/guide_view_widget_left"
                app:layout_constraintTop_toBottomOf="@+id/guide_view_widget_right"
                app:layout_constraintVertical_weight="528"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.bytedance.android.live.ui.ClipFrameLayout
            android:id="@+id/ttlive_xplay_h5_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ttlive_guest_name_container"
            android:background="@drawable/ttlive_bg_guest_camera_user_info"
            android:paddingLeft="4dp"
            android:paddingTop="3dp"
            android:paddingRight="2dp"
            android:paddingBottom="3dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@+id/guest_info_container"
            app:layout_constraintRight_toRightOf="@+id/guest_info_container">
            <ImageView
                android:id="@+id/ttlive_guest_identification"
                android:visibility="gone"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginRight="2dp"
                android:src="@drawable/ttlive_icon_video_silence"
                android:layout_marginEnd="2dp"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#e6ffffff"
                android:ellipsize="end"
                android:id="@+id/ttlive_guest_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:maxEms="8"
                android:singleLine="true"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/ttlive_guest_fans_ticket_count_container"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.android.live.liveinteract.videotalk.quickinteract.interactView.LinkMicQuickInteractView
                android:layout_gravity="center_vertical"
                android:id="@+id/ttlive_guest_fans_ticket_count"
                android:paddingLeft="3dp"
                android:paddingTop="4dp"
                android:paddingRight="3dp"
                android:paddingBottom="10dp"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.bytedance.android.live.liveinteract.videotalk.quickinteract.interactView.ThemedCompetitionQuickInteractView
                android:layout_gravity="center_vertical"
                android:id="@+id/ttlive_themed_competition_score"
                android:paddingLeft="3dp"
                android:paddingTop="4dp"
                android:paddingRight="3dp"
                android:paddingBottom="10dp"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/self_discipline_container"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:layout_marginTop="4dp"
            android:layout_marginStart="3dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.android.live.liveinteract.videotalk.selfdiscipline.ui.SelfDisciplineTimerView
                android:id="@+id/ttlive_self_discipline_timer_view"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="bottom"
                android:id="@+id/ttlive_self_discipline_like_effect"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="7dp"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
