<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_predictor_banner_entrance_bg"
    android:layout_width="@dimen/ttlive_multi_top_right_banner_width"
    android:layout_height="@dimen/ttlive_room_top_right_banner_height">
    <TextView
        android:textSize="9dp"
        android:textColor="@color/ttlive_white"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/predictor_banner_entrance_title_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:maxHeight="@dimen/ttlive_room_top_right_banner_height"
        android:maxLines="2"
        android:lineSpacingExtra="2dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/predictor_banner_entrance_name_tv"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/predictor_banner_entrance_name_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="9dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_white"
        android:gravity="center"
        android:id="@+id/predictor_banner_entrance_name_tv"
        android:background="@drawable/ttlive_predictor_banner_entracne_name_bg"
        android:layout_width="13dp"
        android:layout_height="@dimen/ttlive_room_top_right_banner_height"
        android:ems="1"
        android:lineSpacingExtra="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="9dp"
        android:textStyle="bold"
        android:textColor="#face15"
        android:gravity="bottom"
        android:id="@+id/predictor_banner_entrance_countdown_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/predictor_banner_entrance_title_tv"
        app:layout_constraintEnd_toEndOf="@+id/predictor_banner_entrance_title_tv"
        app:layout_constraintRight_toRightOf="@+id/predictor_banner_entrance_title_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
