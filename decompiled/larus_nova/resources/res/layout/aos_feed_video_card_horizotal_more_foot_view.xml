<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:layout_gravity="center"
    android:orientation="horizontal"
    android:id="@+id/footer_view"
    android:background="#00ffffff"
    android:visibility="invisible"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <View
        android:id="@+id/anim_view_left"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>
    <com.bytedance.awemeopen.apps.framework.card.view.widget.LoadingMoreView
        android:id="@+id/more"
        android:layout_width="18dp"
        android:layout_height="38dp"/>
    <View
        android:id="@+id/anim_view_middle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/aos_text_quaternary"
        android:id="@+id/tips"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/aos_video_card_left_move_tips"
        android:ems="1"
        android:includeFontPadding="false"
        android:layout_marginStart="3dp"/>
    <View
        android:id="@+id/anim_view_right"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>
</LinearLayout>
