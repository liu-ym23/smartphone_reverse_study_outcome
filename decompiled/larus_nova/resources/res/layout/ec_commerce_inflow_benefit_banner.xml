<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/banner_root_view"
    android:layout_width="wrap_content"
    android:layout_height="100dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/benefit_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="5dp"
        android:elevation="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/benefit_normal_background"
            android:background="@drawable/commerce_red_packet_background"
            android:layout_width="42dp"
            android:layout_height="48dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.ec.core.widget.PriceView
            android:id="@+id/benefit_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:extraTextColor="@color/shopping_color_FE496A"
            app:extraTextSize="11dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:priceDecimalTextSize="13dp"
            app:priceText="8.8"
            app:priceTextColor="@color/shopping_color_FE496A"
            app:priceTextSize="18dp"
            app:spaceSize="2dp"
            app:thinDecimal="true"
            app:yangTextSize="13dp"/>
        <android.widget.Space
            android:id="@+id/space"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/benefit_normal_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/space">
            <TextView
                android:textSize="11dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/benefit_start_bottom_text"
                android:background="@drawable/ec_redpacket_bottom_background_small"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:maxWidth="76dp"
                android:minWidth="62dp"
                android:text="待使用"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/benefit_normal_bottom_view"
                android:background="@drawable/commerce_red_packet_countdown_background"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="11dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/benefit_normal_bottom_text"
                    android:paddingTop="3dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="76dp"
                    android:minWidth="62dp"
                    android:text="待使用"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="10dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/benefit_normal_bottom_count_down"
                    android:layout_width="57dp"
                    android:layout_height="wrap_content"
                    android:text="00:00:00"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/benefit_normal_bottom_text"
                    app:layout_constraintStart_toStartOf="@+id/benefit_normal_bottom_text"
                    app:layout_constraintTop_toBottomOf="@+id/benefit_normal_bottom_text"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:layout_gravity="top"
        android:id="@+id/close_btn"
        android:background="@drawable/commerce_close_button"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:elevation="2dp"
        app:layout_constraintEnd_toEndOf="@+id/benefit_view"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ec_inflow_full_price_color"
        android:gravity="center"
        android:id="@+id/benefit_start_count_down"
        android:background="@drawable/ec_countdown_pink_bg"
        android:visibility="gone"
        android:layout_width="109dp"
        android:layout_height="36dp"
        android:layout_marginLeft="55dp"
        android:layout_marginTop="12dp"
        android:elevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/benefit_collapsed_backgroud"
        android:background="@drawable/commerce_red_packet_collapsed"
        android:visibility="gone"
        android:layout_width="26dp"
        android:layout_height="95dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
