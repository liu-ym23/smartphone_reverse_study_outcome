<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/commerce_sheet_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/container1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/commerce_touch_outside"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:soundEffectsEnabled="false"
            android:contentDescription="关闭"/>
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/popup_coordinator"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.kmp.ec.yata.view.render.screenmanager.popup.view.MaxHeightFrameLayout
                android:id="@+id/behavior_payload_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_behavior="@string/android_non_draggable_bottom_sheet_behavior"
                style="?attr/bottomSheetStyle"/>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </FrameLayout>
</FrameLayout>
