<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.ktvimpl.ktvroom.view.FirstDrawWatcherFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ktv_room_container"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/ktv_full_screen_theme_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="top"
        android:id="@+id/ktv_main_content_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/ktv_guide_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="@dimen/ttlive_ktv_room_scene_height"/>
        <View
            android:id="@+id/ktv_top_bar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/ktv_stage_background"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ktv_stage_background"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:actualImageScaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="@+id/ktv_guide_line"
            app:layout_constraintDimensionRatio="1:1"/>
        <FrameLayout
            android:id="@+id/video_container_for_mv"
            android:visibility="gone"
            android:clipChildren="true"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/ktv_seat_view"
            app:layout_constraintDimensionRatio="W,260:375"/>
        <View
            android:id="@+id/video_mask"
            android:clipChildren="true"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/ktv_seat_view"
            app:layout_constraintDimensionRatio="W,260:375"/>
        <FrameLayout
            android:id="@+id/video_region_container"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/ktv_guide_line"
            app:layout_constraintDimensionRatio="h,4:3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <FrameLayout
            android:id="@+id/interact_render_container_bottom_parent"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.livesdk.ktvimpl.ktvroom.seat.KtvLinkSeatListView
            android:id="@+id/ktv_seat_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            app:layout_constraintBottom_toBottomOf="@+id/ktv_guide_line"/>
        <FrameLayout
            android:id="@+id/ktv_room_widget"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/ktv_seat_view"/>
        <FrameLayout
            android:id="@+id/ktv_mv_preview_song_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="52dp"
            app:layout_constraintBottom_toTopOf="@+id/ktv_seat_view"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/ktv_interact_emoji_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="@+id/ktv_seat_view"/>
    <FrameLayout
        android:layout_gravity="bottom|right"
        android:id="@+id/ktv_room_card_container"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="53dp"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center"
        android:id="@+id/themed_competition_status_effect"
        android:visibility="gone"
        android:layout_width="150dp"
        android:layout_height="110dp"
        app:actualImageScaleType="fitCenter"/>
    <android.opengl.GLSurfaceView
        android:id="@+id/interact_render_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.bytedance.android.livesdk.ktvimpl.ktvroom.view.FirstDrawWatcherFrameLayout>
