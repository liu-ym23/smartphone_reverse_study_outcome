<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/recordView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/galleryCoverLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.larksuite.component.ui.layout.LKUIRoundableLayout
            android:id="@+id/galleryCoverWrapper"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="16:9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:rl_radius_left_top="@dimen/space_kit_len_8"
            app:rl_radius_right_top="@dimen/space_kit_len_8">
            <com.bytedance.ee.bear.bitable.infoarch.nativeview.gallery.record.cover.GalleryCoverView
                android:id="@+id/galleryCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.larksuite.component.ui.layout.LKUIRoundableLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/wrapContent"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedance.ee.bear.bitable.infoarch.nativeview.gallery.record.title.GalleryTitleView
                android:id="@+id/galleryTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="24dp"
                android:layout_weight="1"/>
            <com.bytedance.ee.bear.bitable.infoarch.nativeview.common.uikit.CommentView
                android:id="@+id/galleryComment"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="13dp"/>
        </LinearLayout>
        <com.bytedance.ee.bear.bitable.infoarch.nativeview.gallery.record.cell.GalleryFieldCellListView
            android:id="@+id/galleryCellList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"/>
    </LinearLayout>
</LinearLayout>
