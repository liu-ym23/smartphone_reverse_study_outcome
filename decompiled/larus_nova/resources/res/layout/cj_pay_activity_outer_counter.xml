<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_pay_outer_counter_root_layout"
    android:background="@color/cj_pay_color_gray_393B44"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_dy_loading"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="60dp">
        <ImageView
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:src="@drawable/cj_pay_icon_dy_pay_with_text"/>
        <FrameLayout
            android:id="@+id/dy_brand_loading_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <ImageView
                android:id="@+id/dy_brand_loading_dot_iv1"
                android:background="@drawable/cj_pay_dy_brand_loading_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"/>
            <ImageView
                android:id="@+id/dy_brand_loading_dot_iv2"
                android:background="@drawable/cj_pay_dy_brand_loading_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginLeft="30dp"/>
            <ImageView
                android:id="@+id/dy_brand_loading_dot_iv3"
                android:background="@drawable/cj_pay_dy_brand_loading_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginLeft="60dp"/>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_user_info"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="88dp">
        <com.android.ttcjpaysdk.base.theme.widget.CJPayFlexibleRoundCornerImageView
            android:id="@+id/iv_avatar"
            android:visibility="gone"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="#f8f8f8"
            android:scaleType="centerCrop"
            android:alpha="0.5"
            app:CJPayCorners="CJPay_BOTTOM_RIGHT|CJPay_BOTTOM_LEFT|CJPay_TOP_RIGHT|CJPay_TOP_LEFT"
            app:CJPayCornersRadius="36dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/cj_pay_color_white"
            android:id="@+id/tv_nickname"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.5"/>
    </LinearLayout>
    <com.android.ttcjpaysdk.base.ui.widget.CJPayTextLoadingView
        android:id="@+id/cj_pay_activity_loading_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
