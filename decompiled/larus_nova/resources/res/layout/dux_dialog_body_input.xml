<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/dux_bg_dialog_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:textSize="14sp"
            android:id="@+id/input_text"
            android:background="@null"
            android:paddingLeft="8dp"
            android:paddingTop="10dp"
            android:paddingRight="8dp"
            android:paddingBottom="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/dux_input_hint"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_weight="1"
            android:lineSpacingExtra="6dp"
            android:inputType="text"
            android:textCursorDrawable="@drawable/dux_form_cursor"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/input_clear"
            android:visibility="gone"
            android:layout_width="20sp"
            android:layout_height="20sp"
            android:src="@drawable/ic_s_s_xmarkcircle_filled_20"
            android:layout_marginEnd="8dp"
            app:tint="@color/ConstLineInverse3"/>
    </LinearLayout>
    <com.bytedance.dux.text.DuxTextView
        android:textColor="@color/Primary"
        android:id="@+id/textinput_error"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/dux_input_error"
        app:textSpec="P3"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/checkbox_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <com.bytedance.dux.widget.DuxCheckBox
            android:layout_gravity="center_vertical"
            android:id="@+id/checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:adaptLargeFontMode="true"
            app:dux_checkBoxAlwaysLight="true"/>
        <com.bytedance.dux.text.DuxTextView
            android:textSize="14sp"
            android:textColor="#99161823"
            android:id="@+id/checkbox_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
</LinearLayout>
