<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="13dp"
        android:textColor="@color/white"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="6dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.chatroom.replay.interactionmsg.danmaku.setting.seekbar.RangeSeekBar
        android:id="@+id/seek_bar"
        android:paddingRight="3dp"
        android:layout_width="298dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="17.5dp"
        android:paddingEnd="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rsb_gravity="center"
        app:rsb_indicator_show_mode="alwaysHide"
        app:rsb_mode="single"
        app:rsb_progress_color="#face15"
        app:rsb_progress_default_color="#4dffffff"
        app:rsb_progress_height="3dp"
        app:rsb_progress_radius="2dp"
        app:rsb_step_circle_style="true"
        app:rsb_step_color="#ffffff"
        app:rsb_step_height="3dp"
        app:rsb_step_width="3dp"
        app:rsb_thumb_height="14dp"
        app:rsb_thumb_width="14dp"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:id="@+id/hintContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/seek_bar"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/seek_bar"/>
</merge>
