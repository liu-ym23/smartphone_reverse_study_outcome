<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_iron_promotion_item_rootview"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="yes">
    <com.bytedance.android.ec.core.widget.ECConstrainLayout
        android:id="@+id/iron_promotion_item_rootview"
        android:paddingBottom="8dp"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.livesdk.livecommerce.promotion.cardV2.component.PromotionCardImageComponent
            android:id="@+id/liiam_image_container"
            android:clipChildren="false"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.bytedance.android.livesdk.livecommerce.promotion.cardV2.component.PromotionCardTitleComponent
            android:ellipsize="end"
            android:id="@+id/tv_title"
            android:focusable="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:importantForAccessibility="noHideDescendants"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/liiam_image_container"
            app:layout_constraintTop_toTopOf="@+id/liiam_image_container"/>
        <com.bytedance.android.livesdk.livecommerce.promotion.cardV2.component.PromotionCardInfoComponent
            android:orientation="vertical"
            android:id="@+id/ll_info_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="@+id/tv_title"
            app:layout_constraintStart_toStartOf="@+id/tv_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <com.bytedance.android.livesdk.livecommerce.promotion.cardV2.component.PromotionCardPriceComponent
            android:gravity="bottom"
            android:layout_gravity="bottom"
            android:id="@+id/container_price_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:importantForAccessibility="noHideDescendants"
            android:paddingEnd="6dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/libm_shop_cart_and_buy"
            app:layout_constraintEnd_toStartOf="@+id/libm_shop_cart_and_buy"
            app:layout_constraintStart_toStartOf="@+id/tv_title"/>
        <com.bytedance.android.livesdk.livecommerce.promotion.cardV2.component.PromotionCardButtonComponent
            android:orientation="horizontal"
            android:id="@+id/libm_shop_cart_and_buy"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            app:layout_constraintBottom_toBottomOf="@+id/liiam_image_container"
            app:layout_constraintEnd_toEndOf="@+id/tv_title"/>
        <com.bytedance.android.livesdk.livecommerce.promotion.cardV2.component.PromotionCardBottomComponent
            android:orientation="vertical"
            android:id="@+id/libm_bottom_module"
            android:paddingTop="8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/liiam_image_container"/>
        <ImageView
            android:id="@+id/iv_promotion_card_close"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/ec_common_ic_playback_promotion_card_close"
            android:contentDescription="@string/ec_close_button"
            android:paddingStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.bytedance.android.ec.core.widget.ECConstrainLayout>
    <com.bytedance.android.livesdk.livecommerce.promotion.cardV2.widget.PromotionCardGuideView
        android:id="@+id/ligm_promotion_guide"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/iron_promotion_item_rootview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.livecommerce.promotion.cardV2.module.PromotionCardExternalView
        android:id="@+id/list_bottom_module"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/iron_promotion_item_rootview"/>
    <com.bytedance.android.livesdk.livecommerce.view.ECLottieAnimationView
        android:id="@+id/iron_promotion_item_enhance_effect"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
