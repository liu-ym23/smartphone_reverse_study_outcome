<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_84">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/iv_credit_task_icon"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        app:actualImageScaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/larus_bg_placeholder_credit_task"
        app:placeholderImageScaleType="fitCenter"/>
    <TextView
        android:textSize="?attr/larus_dp_16"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/tv_credit_task_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toTopOf="@+id/tv_credit_task_description"
        app:layout_constraintEnd_toStartOf="@+id/tv_do_task"
        app:layout_constraintStart_toEndOf="@+id/iv_credit_task_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="@color/larus_neutral_50"
        android:ellipsize="end"
        android:id="@+id/tv_credit_task_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_6"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/tv_credit_task_title"
        app:layout_constraintStart_toStartOf="@+id/tv_credit_task_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_credit_task_title"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/tv_do_task"
        android:background="@drawable/larus_bg_btn_task_action_blue"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingTop="?attr/larus_dp_8"
        android:paddingRight="?attr/larus_dp_16"
        android:paddingBottom="?attr/larus_dp_8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="?attr/larus_dp_76"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
