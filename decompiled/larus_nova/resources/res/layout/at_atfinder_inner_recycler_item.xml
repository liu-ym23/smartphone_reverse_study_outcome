<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.larksuite.component.universe_design.image.UDAvatar
            android:layout_gravity="center_vertical"
            android:id="@+id/item_icon"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            app:ud_avatar_borderWidth="0dp"
            app:ud_avatar_size="middle"
            style="@style/UDAvatar.Circle"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/item_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="66dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="top"
                android:id="@+id/item_ll_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:layout_marginTop="13dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="3dp"
                android:layout_alignParentLeft="true">
                <com.bytedance.ee.bear.widgets.tagview.SpaceTagTitleView
                    android:id="@+id/item_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/colorful_wathet"
                    android:gravity="center"
                    android:id="@+id/item_not_in_chatGroup"
                    android:background="@drawable/at_atfinder_not_in_group_bg"
                    android:visibility="gone"
                    android:layout_width="61dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:minHeight="14dp"
                    android:text="@string/Doc_At_NoInGroup"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_placeholder"
                    android:ellipsize="end"
                    android:id="@+id/item_department"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginBottom="10dp"
                    android:minHeight="22dp"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_placeholder"
                    android:ellipsize="end"
                    android:id="@+id/update_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:layout_marginRight="20dp"
                    android:layout_marginBottom="10dp"
                    android:minHeight="22dp"
                    android:maxLines="1"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
