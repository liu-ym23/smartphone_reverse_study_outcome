<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/decor"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.wikiv2.wikitreev2.main.WikiCoverCoordinatorLayout
        android:id="@+id/wiki_coordinator_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/wiki_appbar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_scrollFlags="exitUntilCollapsed|scroll">
                <com.bytedance.ee.bear.wikiv2.wikitreev2.main.SpaceCoverView
                    android:id="@+id/wiki_cover_view"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"/>
                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/wiki_header_toolbar"
                    android:background="@color/bg_body"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:alpha="0"
                    app:contentInsetStart="0dp"
                    app:layout_collapseMode="pin">
                    <com.bytedance.ee.bear.widgets.BaseTitleBar
                        android:id="@+id/wiki_floating_title_bar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:widget_widgets_tb_divider_visible="false"/>
                </androidx.appcompat.widget.Toolbar>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <FrameLayout
                android:id="@+id/wiki_notification_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.bytedance.ee.bear.wikiv2.wikitreev2.widget.view.WikiTreeCtrlView
                android:id="@+id/wiki_tree_ctrl_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </com.bytedance.ee.bear.wikiv2.wikitreev2.main.WikiCoverCoordinatorLayout>
    <com.bytedance.ee.bear.widgets.button.CommonCreateButton
        android:layout_gravity="end|bottom"
        android:id="@+id/common_create_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.bytedance.ee.bear.wikiv2.searchv2.WikiSearchPickerView
        android:id="@+id/wiki_search_view"
        android:background="@color/bg_body"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/wikiEmptyViewStub"
        android:layout="@layout/wiki_tree_empty_view"
        android:inflatedId="@+id/wikiEmptyViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
