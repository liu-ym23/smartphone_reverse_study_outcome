<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:id="@+id/larus_mode_switch_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?attr/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/larus_mode_switch_welcome_title"
            android:paddingLeft="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif"/>
        <FrameLayout
            android:id="@+id/larus_mode_switch_container"
            android:background="@drawable/larus_bg_floating_bottom_button_dark"
            android:clipChildren="true"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="50dp"
            android:backgroundTint="?attr/larus_neutral_transparent_1"
            android:backgroundTintMode="src_in">
            <View
                android:layout_gravity="start|center_vertical"
                android:id="@+id/larus_mode_switch_indicator"
                android:layout_width="126dp"
                android:layout_height="50dp"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/larus_mode_switch_labels"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:minHeight="44dp"
                android:elevation="5dp"/>
        </FrameLayout>
    </LinearLayout>
    <ImageView
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/larus_mode_switch_welcome_icon"
        android:visibility="gone"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:src="@drawable/larus_ic_mode_switch_work_logo"
        android:scaleType="center"
        android:contentDescription="@null"/>
</merge>
