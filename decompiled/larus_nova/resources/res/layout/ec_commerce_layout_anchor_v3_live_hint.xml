<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:id="@+id/ec_commerce_layout_anchor_v3_live_hint_881771077"
    android:background="@drawable/ec_commerce_bg_anchor_v3_live_strand"
    android:layout_width="match_parent"
    android:layout_height="@dimen/commerce_anchor_v3_live_strand_height"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp">
    <com.bytedance.android.shopping.widget.legacy.AvatarImageView
        android:id="@+id/anchor_v3_live_avatar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_margin="8dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textColor="@color/BGReverse"
            android:ellipsize="end"
            android:id="@+id/anchor_v3_nick_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/font_size_26"/>
        <View
            android:background="@color/shopping_white_1e"
            android:layout_width="1px"
            android:layout_height="10dp"
            android:layout_marginLeft="3.5dp"
            android:layout_marginRight="3.5dp"/>
        <TextView
            android:textColor="@color/BGReverse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recommend"
            style="@style/font_size_26"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/iv_playing"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginRight="4.5dp"
            android:layout_marginEnd="4.5dp"/>
        <TextView
            android:textColor="@color/BGReverse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/commerce_live_broadcast_in_progress"
            style="@style/font_size_26"/>
        <View
            android:background="@drawable/commerce_white_right_arrow"
            android:layout_width="6dp"
            android:layout_height="12dp"
            android:layout_marginLeft="6dp"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
</LinearLayout>
