<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/flow_feed_long_click_menu_bg"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:width="240dp">
    <TextView
        android:textSize="@dimen/sp_16"
        android:textStyle="normal"
        android:textColor="@color/flow_feed_long_click_text"
        android:ellipsize="end"
        android:id="@+id/menu_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="4dp"
        android:maxLines="1"
        android:layout_toLeftOf="@+id/menu_icon"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/menu_icon"
        android:duplicateParentState="true"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="16dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <LinearLayout
        android:id="@+id/menu_divider"
        android:background="@color/flow_feed_long_click_menu_divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
