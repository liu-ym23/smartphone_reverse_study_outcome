<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="?attr/larus_dp_88"
    android:minHeight="?attr/larus_dp_48">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:layout_marginTop="?attr/larus_dp_14"
        android:layout_marginBottom="?attr/larus_dp_14"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_16"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:textAlignment="viewStart"
        android:layout_marginStart="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="@+id/icon"/>
    <View
        android:id="@+id/item_divider"
        android:background="?attr/larus_neutral_transparent_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
