<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:id="@+id/new_profile_follow_button_root"
    android:layout_width="match_parent"
    android:layout_height="36dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/new_profile_button_follow_layout"
        android:background="@drawable/ttlive_bg_profile_anchor_follow"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerConstraintLayout
            android:id="@+id/new_profile_follow_button_effect_root"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:ttlive_allRadius="@dimen/ttlive_profile_main_button_radius">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/new_profile_button_follow_9_png"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:actualImageScaleType="fitXY"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerConstraintLayout>
        <ImageView
            android:id="@+id/new_profile_button_follow_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ttlive_ic_profile_plus"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/new_profile_button_follow_text"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/new_profile_button_follow_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_live_new_profile_follow"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/new_profile_button_follow_icon"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/new_profile_button_followed_layout"
        android:background="@drawable/ttlive_bg_profile_anchor_followed"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/new_profile_button_followed_icon"
            android:background="@drawable/ttlive_ic_profile_follow_each_arrow"
            android:layout_width="16dp"
            android:layout_height="16dp"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_new_profile_black"
            android:gravity="start|center_vertical"
            android:id="@+id/new_profile_button_followed_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/new_profile_button_fans_group_layout"
        android:background="@drawable/ttlive_bg_profile_anchor_followed"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/new_profile_button_fans_group_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ttlive_profile_anchor_fansgroup_with_followed"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_new_profile_black"
            android:gravity="start|center_vertical"
            android:id="@+id/new_profile_button_fans_group_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="@string/ttlive_live_new_profile_fansgroup_in_followed"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_new_profile_black"
            android:gravity="center"
            android:id="@+id/new_profile_button_fans_group_text_v2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="@string/ttlive_live_profile_fans_group_v2"
            android:includeFontPadding="false"/>
    </LinearLayout>
</FrameLayout>
