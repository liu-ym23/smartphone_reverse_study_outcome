<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mtm_task_ongoing_item"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_64">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="?attr/larus_dp_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/mtm_task_progress_holder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="?attr/larus_dp_16"
            android:textStyle="bold"
            android:textColor="@color/larus_neutral_100"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/mtm_task_title"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_22"
            android:maxLines="1"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="?attr/larus_dp_12"
            android:textColor="@color/larus_neutral_50"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/mtm_task_desc"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_17"
            android:layout_marginTop="?attr/larus_dp_1"
            android:maxLines="1"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/mtm_task_progress_holder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.larus.common_ui.widget.CircleProgressBar
            android:layout_gravity="end|center_vertical"
            android:id="@+id/mtm_task_progress_bar"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:contentDescription="@null"
            android:layout_marginEnd="?attr/larus_dp_18"
            app:larus_maxProgress="500"
            app:larus_progress="0"
            app:larus_progressbarBackgroundColor="@color/larus_neutral_transparent_2"
            app:larus_progressbarColor="@color/larus_neutral_100"
            app:larus_radius="?attr/larus_dp_12"
            app:larus_strokeWidth="?attr/larus_dp_2_5"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/mtm_task_progress_complete"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:src="@drawable/larus_mtm_ic_progress_complete"
            android:contentDescription="@null"
            android:layout_marginEnd="?attr/larus_dp_16"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
