<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="end"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <LinearLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:id="@+id/live_dialog_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.android.livesdk.widget.FitButton
            android:textSize="15sp"
            android:id="@+id/live_dialog_btn_2"
            android:layout_width="0dp"
            android:layout_weight="1"
            style="@style/ttlive_live_dialog_horizontal_button2"/>
        <com.bytedance.android.livesdk.widget.FitButton
            android:textSize="15sp"
            android:id="@+id/live_dialog_btn_1"
            android:layout_width="0dp"
            android:layout_weight="1"
            style="@style/ttlive_live_dialog_horizontal_button1"/>
    </LinearLayout>
    <View
        android:background="@drawable/ttlive_dialog_divider_horizontal"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/live_dialog_divider_vertical"
        android:background="@drawable/ttlive_dialog_divider_vertical"
        android:layout_width="1dp"
        android:layout_height="48dp"
        android:layout_marginTop="1dp"/>
</FrameLayout>
