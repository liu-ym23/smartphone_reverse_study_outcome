<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:background="@drawable/gamecp_shape_prop_account_dialog_bg"
    android:paddingTop="16dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/gamecp_black_90"
        android:id="@+id/tv_account_list_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_game_promote_prop_account_choose"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_account_list_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_account_list_title">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_account_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/tv_account_add"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/gamecp_game_comment_dialog_bg"
            android:gravity="center"
            android:id="@+id/tv_account_add"
            android:background="@drawable/gamecp_shape_prop_account_create_btn_bg"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:text="@string/ttlive_game_promote_prop_account_create"
            app:layout_constraintTop_toBottomOf="@+id/rv_account_list"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.gamecp.common.ui.LoadingStatusView
        android:id="@+id/loading_account_list"
        android:layout_width="match_parent"
        android:layout_height="108dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_account_list_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
