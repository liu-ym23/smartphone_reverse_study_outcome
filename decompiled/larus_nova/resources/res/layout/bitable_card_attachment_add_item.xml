<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.ee.bear.bitable.card.view.cell.attachment.view.AttachmentCoverItemLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/add_attachment_button_fl"
        android:background="@drawable/facade_round_around_s"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="@color/bitable_page_field_item_right_icon_color">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/add_attachment_button_image"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ud_icon_add_outlined"
            app:tint="@color/icon_n3"/>
    </FrameLayout>
</com.bytedance.ee.bear.bitable.card.view.cell.attachment.view.AttachmentCoverItemLayout>
