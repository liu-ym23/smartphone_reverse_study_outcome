<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.bitable.infoarch.view.BitableLoadingContainer
        android:id="@+id/loadingContainer"
        android:background="@color/bg_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/pluginHostContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/pluginUIContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include
        android:id="@+id/record_page_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/bitable_record_page_layout"/>
    <ViewStub
        android:layout_gravity="bottom"
        android:id="@+id/keyboard_toolbar_view_stub"
        android:layout="@layout/bitable_keyboard_toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</FrameLayout>
