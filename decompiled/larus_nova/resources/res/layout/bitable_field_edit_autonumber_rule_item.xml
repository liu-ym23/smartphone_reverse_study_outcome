<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/space_kit_len_52">
    <TextView
        android:textSize="@dimen/space_kit_font_16"
        android:textColor="@color/text_title"
        android:gravity="center_vertical"
        android:id="@+id/rule_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/space_kit_len_22"
        android:layout_marginTop="@dimen/space_kit_len_15"
        android:layout_marginBottom="@dimen/space_kit_len_15"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/space_kit_len_16"
        android:layout_marginEnd="@dimen/space_kit_len_16"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/number_stepper"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.larksuite.component.ui.layout.LKUIRoundableLayout
            android:id="@+id/number_stepper_reduce_btn"
            android:background="@color/bg_float"
            android:layout_width="@dimen/space_kit_len_32"
            android:layout_height="@dimen/space_kit_len_32"
            android:backgroundTint="@color/facade_selector_item_float"
            app:rl_border_color="@color/line_border_component"
            app:rl_border_width="@dimen/space_kit_len_1"
            app:rl_radius="@dimen/space_radius_m">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/number_stepper_reduce_iv"
                android:layout_width="@dimen/space_kit_len_16"
                android:layout_height="@dimen/space_kit_len_16"
                android:tint="@color/ud_button_grey_text"
                app:srcCompat="@drawable/ud_icon_reduce_outlined"/>
        </com.larksuite.component.ui.layout.LKUIRoundableLayout>
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_title"
            android:id="@+id/number_value_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/space_kit_len_14"
            android:layout_marginEnd="@dimen/space_kit_len_14"/>
        <com.larksuite.component.ui.layout.LKUIRoundableLayout
            android:id="@+id/number_stepper_add_btn"
            android:background="@color/bg_float"
            android:layout_width="@dimen/space_kit_len_32"
            android:layout_height="@dimen/space_kit_len_32"
            android:backgroundTint="@color/facade_selector_item_float"
            app:rl_border_color="@color/line_border_component"
            app:rl_border_width="@dimen/space_kit_len_1"
            app:rl_radius="@dimen/space_radius_m">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/number_stepper_add_iv"
                android:layout_width="@dimen/space_kit_len_16"
                android:layout_height="@dimen/space_kit_len_16"
                android:tint="@color/ud_button_grey_text"
                app:srcCompat="@drawable/ud_icon_add_outlined"/>
        </com.larksuite.component.ui.layout.LKUIRoundableLayout>
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_caption"
            android:id="@+id/number_digit_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/space_kit_len_8"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/rule_desc_iv"
            android:padding="@dimen/space_kit_len_6"
            android:layout_width="@dimen/space_kit_len_28"
            android:layout_height="@dimen/space_kit_len_28"
            android:tint="@color/icon_n3"
            app:srcCompat="@drawable/ud_icon_maybe_outlined"/>
    </LinearLayout>
    <com.larksuite.component.universe_design.edittext.UDTextInputLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/fixed_text_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_15"
        android:layout_marginBottom="@dimen/space_kit_len_15"
        app:ud_inputLayout_bottomTextInputMargin="@dimen/space_kit_len_8">
        <com.bytedance.ee.bear.bitable.fieldedit.view.widgets.FieldEditText
            android:textSize="@dimen/space_kit_font_16"
            android:textColorHint="@color/text_placeholder"
            android:gravity="center_vertical"
            android:id="@+id/fixed_text_et"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_kit_len_22"
            android:hint="@string/Bitable_Common_PleaseEnterMobileVer"
            android:maxLines="1"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:imeOptions="actionDone"
            style="@style/SpaceEditTextStyle"/>
    </com.larksuite.component.universe_design.edittext.UDTextInputLayout>
    <com.bytedance.ee.bear.widgets.universedesign.SpaceEditText
        android:textSize="@dimen/space_kit_font_16"
        android:textColor="@color/text_title"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/created_time_et"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:cursorVisible="false"
        android:maxLines="1"
        android:singleLine="true"
        android:includeFontPadding="false"
        app:ud_editText_iconHeight="@dimen/space_kit_len_16"
        app:ud_editText_iconWidth="@dimen/space_kit_len_16"
        app:ud_editText_rightIcon="@drawable/ud_icon_down_bold_outlined"
        app:ud_editText_rightIconTint="@color/icon_n3"
        style="@style/SpaceEditTextStyle"/>
</LinearLayout>
