<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/larus_multi_account_page"
    android:background="@drawable/larus_bg_base_5_r16_top"
    android:paddingBottom="?attr/larus_dp_12"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/touch_view"
        android:background="@drawable/larus_bg_transparent_2_r2"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_36"
        android:layout_height="?attr/larus_dp_4"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginBottom="?attr/larus_dp_12"/>
    <RelativeLayout
        android:id="@+id/title"
        android:paddingLeft="?attr/larus_dp_24"
        android:paddingRight="?attr/larus_dp_24"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="?attr/larus_neutral_100"
            android:gravity="center_vertical"
            android:id="@+id/tv_cancel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/larus_cancel"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_19"
            android:textStyle="bold"
            android:textColor="?attr/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/larus_switchAccount_switchAcc"
            android:layout_centerInParent="true"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="?attr/larus_neutral_50"
            android:gravity="center_vertical"
            android:id="@+id/tv_manage"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/larus_switchAccount_manageAcc"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/account_list"
        android:background="@drawable/larus_bg_setting_group"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginRight="?attr/larus_dp_16"
        android:overScrollMode="never"/>
</LinearLayout>
