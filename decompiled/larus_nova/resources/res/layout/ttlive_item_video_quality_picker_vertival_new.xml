<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.chatroom.ui.ResolutionItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_root"
    android:layout_width="match_parent"
    android:layout_height="66dp"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp">
    <TextView
        android:textSize="15sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/quality_text"
        android:layout_width="wrap_content"
        android:layout_height="21dp"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/p_text"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/p_text"
        android:layout_width="wrap_content"
        android:layout_height="21dp"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="32dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/quality_text"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/bottom_desc_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:layout_marginTop="38dp"
        android:layout_marginBottom="11dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/text_corner_icon"
        android:visibility="gone"
        android:layout_width="26dp"
        android:layout_height="14dp"
        android:layout_marginLeft="4dp"
        app:layout_constraintBottom_toTopOf="@+id/quality_text"
        app:layout_constraintStart_toEndOf="@+id/p_text"
        app:layout_constraintTop_toTopOf="@+id/quality_text"/>
</com.bytedance.android.livesdk.chatroom.ui.ResolutionItemView>
