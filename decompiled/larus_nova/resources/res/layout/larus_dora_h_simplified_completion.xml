<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dora_onboarding_content"
    android:background="?attr/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="?attr/larus_dp_44">
    <FrameLayout
        android:id="@+id/dora_onboarding_completion_mv_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/dora_onboarding_completion_title"
        app:layout_constraintTop_toTopOf="parent">
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="center"
            android:id="@+id/dora_onboarding_completion_mv"
            android:layout_width="?attr/larus_dp_360"
            android:layout_height="?attr/larus_dp_360"
            app:actualImageScaleType="fitCenter"/>
    </FrameLayout>
    <com.larus.dora.impl.view.DoraTextView
        android:textSize="?attr/larus_sp_24"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/dora_onboarding_completion_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_32"
        android:layout_marginRight="?attr/larus_dp_32"
        android:layout_marginBottom="?attr/larus_dp_29"
        android:text="@string/larus_dora_h_onboard_guide_completed_cn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
