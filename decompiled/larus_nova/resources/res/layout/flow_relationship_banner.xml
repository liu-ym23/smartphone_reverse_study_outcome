<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/flow_bg_relationship_banner"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    android:minHeight="72dp"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:elevation="4dp">
    <ImageView
        android:id="@+id/flow_relationship_banner_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/flow_ud_neutral_100"
        android:ellipsize="end"
        android:id="@+id/flow_relationship_banner_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toTopOf="@+id/flow_relationship_banner_description"
        app:layout_constraintEnd_toStartOf="@+id/flow_relationship_banner_close"
        app:layout_constraintStart_toEndOf="@+id/flow_relationship_banner_icon"
        app:layout_constraintTop_toTopOf="@+id/flow_relationship_banner_icon"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/flow_ud_neutral_70"
        android:id="@+id/flow_relationship_banner_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/flow_relationship_banner_icon"
        app:layout_constraintEnd_toStartOf="@+id/flow_relationship_banner_close"
        app:layout_constraintStart_toEndOf="@+id/flow_relationship_banner_icon"
        app:layout_constraintTop_toBottomOf="@+id/flow_relationship_banner_title"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/flow_relationship_banner_close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/flow_ud_ic_banner_close"/>
</androidx.constraintlayout.widget.ConstraintLayout>
