<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.common.RoundRectLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:leftTopRoundRect="6dp"
    app:rightTopRoundRect="6dp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="195dp"
            android:layout_marginBottom="13dp">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/iv_des"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/title"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:lines="2"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#bf161823"
            android:gravity="center"
            android:id="@+id/des"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="20dp"
            android:text="@string/ttlive_solo_ktv_back_home_tips_dialog_txt"
            android:lines="2"/>
        <com.bytedance.android.live.ktv.common.view.CommomKtvButton
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/comfirm"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:text="我知道了"/>
    </LinearLayout>
</com.bytedance.android.livesdk.common.RoundRectLayout>
