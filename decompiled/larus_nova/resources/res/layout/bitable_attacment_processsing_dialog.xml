<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:paddingTop="@dimen/space_kit_len_24"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/loading_view"
            android:layout_width="@dimen/space_kit_len_20"
            android:layout_height="@dimen/space_kit_len_20"
            android:tint="@color/primary_fill_default"
            android:layout_marginEnd="12dp"
            app:srcCompat="@drawable/ud_icon_replace_outlined"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/text_title"
            android:id="@+id/loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Bitable_Common_Loading_Mobile"/>
    </LinearLayout>
</FrameLayout>
