<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ec.store.widget.ECRoundedLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/store_product_card"
    android:background="@color/ec_color_white"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:rounded_radius="4dp">
    <com.bytedance.android.ec.core.widget.RoundedRelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:rounded_radius="4dp">
        <com.bytedance.android.ec.core.widget.AspectRatioFrameLayout
            android:id="@+id/store_product_card_image_wrapper"
            android:layout_width="match_parent"
            android:layout_height="166dp">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/store_product_card_image"
                android:background="#f3f3f4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <include layout="@layout/shopping_layout_store_card_video"/>
        </com.bytedance.android.ec.core.widget.AspectRatioFrameLayout>
        <com.bytedance.android.ec.core.widget.RoundedLinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/store_product_card_live_status"
            android:background="@color/ec_store_FFB3B3B3"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="10dp"
            app:rounded_radius="10dp">
            <com.bytedance.android.ec.core.widget.RoundedLinearLayout
                android:gravity="center"
                android:id="@+id/store_product_card_live_status_bg"
                android:layout_width="18dp"
                android:layout_height="18dp">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/store_product_card_live_status_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    app:roundAsCircle="true"/>
            </com.bytedance.android.ec.core.widget.RoundedLinearLayout>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/shopping_std_text_white_1"
                android:id="@+id/store_product_card_live_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"/>
        </com.bytedance.android.ec.core.widget.RoundedLinearLayout>
    </com.bytedance.android.ec.core.widget.RoundedRelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="8dp"
        android:paddingTop="8dp"
        android:paddingRight="8dp"
        android:paddingBottom="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <com.bytedance.android.ec.store.widget.BreakWordTextView
            android:textSize="14sp"
            android:textColor="@color/shopping_std_text_black_1"
            android:id="@+id/store_product_card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/store_product_card_extra_info_area"
            android:paddingTop="4dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedance.android.ec.store.product.widget.ECTagFlowLayout
                android:id="@+id/store_product_card_tags_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:tag_maxline="1"
                app:tag_space_horizontal="4dp"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <LinearLayout
                android:gravity="bottom"
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                app:layout_constrainedWidth="true"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/store_product_card_add_to_cart">
                <com.bytedance.android.ec.core.widget.price.PriceView
                    android:textSize="17sp"
                    android:ellipsize="end"
                    android:id="@+id/store_product_card_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lines="1"
                    android:lineSpacingExtra="2dp"
                    app:pv_hideYuanSymbol="false"
                    app:pv_prefixMarginRight="4dp"
                    app:pv_prefixTextBold="true"
                    app:pv_prefixTextColor="@color/shopping_std_brand"
                    app:pv_prefixTextSizeRatio="0.647"
                    app:pv_priceBold="true"
                    app:pv_priceTextColor="@color/shopping_std_brand"
                    app:pv_yuanSymbolBold="true"
                    app:pv_yuanSymbolMarginRight="1dp"
                    app:pv_yuanSymbolRatioOfPriceTextSize="0.764"/>
                <com.bytedance.android.ec.core.widget.price.PriceView
                    android:textSize="10sp"
                    android:layout_gravity="bottom"
                    android:id="@+id/store_product_card_market_price"
                    android:paddingBottom="1dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    app:pv_priceTextColor="@color/commerce_text_reverse_3"
                    app:pv_yuanSymbolMarginRight="2dp"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/shopping_std_text_black_4"
                    android:ellipsize="end"
                    android:layout_gravity="start|bottom"
                    android:id="@+id/store_product_card_sale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginBottom="0.5dp"
                    android:baselineAlignBottom="true"
                    android:maxLines="1"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/store_product_card_add_to_cart"
                android:background="@drawable/ec_store_ic_add_to_cart_pink"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="1dp"
                android:layout_alignParentEnd="true"
                app:layout_constraintRight_toRightOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/shopping_color_99161823"
            android:ellipsize="end"
            android:id="@+id/store_product_card_recommend_info"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lines="1"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/store_product_card_source_wrapper"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="@drawable/shape_shopping_store_v2_item_dash_line"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:layerType="software"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.bytedance.android.ec.core.widget.ECAnimateRingImageView
                    android:id="@+id/store_product_card_store_logo"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="-2dp"
                    android:layout_marginRight="2dp"
                    android:layout_marginStart="-2dp"
                    android:layout_marginEnd="2dp"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/shopping_std_text_black_4"
                    android:ellipsize="end"
                    android:id="@+id/store_product_card_source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.bytedance.android.ec.store.widget.ECRoundedLinearLayout>
