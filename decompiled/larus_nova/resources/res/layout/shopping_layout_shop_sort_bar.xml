<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_sort_bar_wrapper"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="center"
        android:id="@+id/store_sort_recycler_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40sp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/store_sort_right_container"
        android:layout_width="wrap_content"
        android:layout_height="20sp"
        android:layout_marginEnd="16dp">
        <LinearLayout
            android:id="@+id/fl_view_type_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.facebook.drawee.view.SimpleDraweeView
                android:layout_gravity="center"
                android:id="@+id/fl_view_type_icon"
                android:visibility="gone"
                android:layout_width="16sp"
                android:layout_height="16sp"
                android:layout_marginTop="0.5dp"
                android:layout_marginStart="6dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#99161823"
                android:layout_gravity="center_vertical"
                android:id="@+id/fl_view_type_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/store_select_panel_entry_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <View
                android:layout_gravity="center_vertical"
                android:background="#1618231f"
                android:layout_width="0.5sp"
                android:layout_height="14sp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#99161823"
                android:gravity="left"
                android:id="@+id/store_select_panel_entry_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/commerce_shop_filter_enter_text"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/store_select_panel_entry_icon"
                android:background="@drawable/ec_store_ic_filter_unselected"
                android:layout_width="16sp"
                android:layout_height="16sp"
                android:layout_marginTop="0.5sp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
