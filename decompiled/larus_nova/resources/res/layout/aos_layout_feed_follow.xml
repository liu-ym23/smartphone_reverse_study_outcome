<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/feed_follow_root"
    android:background="@color/ao_bgsecondary3"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/fl_follow_page_skylight_layer"
        android:background="@color/ao_bgsecondary3"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="162dp"
        android:layout_marginTop="58dp"/>
    <FrameLayout
        android:id="@+id/fl_feed_container_stub"
        android:background="@color/ao_bgsecondary3"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.awemeopen.apps.framework.feed.widget.LiveSkyLightTouchLayout
            android:id="@+id/fl_follow_page_feed_layer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <include layout="@layout/aos_component_feed"/>
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/ll_skylight_button_container"
                android:background="@drawable/follow_feed_bg_follow_live_skylight_txt_style_b"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="62dp"
                android:paddingStart="10dp"
                android:paddingEnd="6dp">
                <TextView
                    android:textColor="@color/ConstTextInverse3"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_skylight_style_b_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    style="@style/font_size_26_sp"/>
                <TextView
                    android:textColor="@color/ConstTextInverse3"
                    android:gravity="center"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_pull_up_close"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:text="@string/follow_feed_pull_up_close"
                    style="@style/font_size_26_sp"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/img_skylight_arrow"
                    android:padding="2dp"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_s_s_trianglesdown_filled"
                    app:tint="@color/ConstTextInverse3"/>
            </LinearLayout>
        </com.bytedance.awemeopen.apps.framework.feed.widget.LiveSkyLightTouchLayout>
    </FrameLayout>
    <View
        android:background="@drawable/aos_feed_top_linear_gradient"
        android:layout_width="match_parent"
        android:layout_height="108dp"/>
    <include layout="@layout/aos_tab_common_loading"/>
    <include layout="@layout/aos_feed_first_init_loading"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtStatusView
        android:id="@+id/status_view"
        android:background="@color/aos_const_bg_inverse"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/stub_hint_for_follow_page"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp">
        <com.bytedance.awemeopen.apps.framework.base.view.AutoRTLImageView
            android:id="@+id/feed_back_btn"
            android:paddingLeft="16dp"
            android:paddingTop="10dp"
            android:paddingRight="16dp"
            android:paddingBottom="10dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/aos_icon_feed_back"/>
        <ImageView
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/aos_douyin_top_water_mark"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</FrameLayout>
