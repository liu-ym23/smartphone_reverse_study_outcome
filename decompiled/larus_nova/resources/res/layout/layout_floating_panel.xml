<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.suite.lark.platform.component.widget.floatingpanel.impl.view.FloatingPanelScrollView
        android:id="@+id/floating_panel_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.suite.lark.platform.component.widget.floatingpanel.impl.view.FloatingBannerContainer
                android:id="@+id/floating_panel_banner_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.suite.lark.platform.component.widget.floatingpanel.impl.view.FloatingPanelActionView
                android:id="@+id/floating_panel_card_action_top"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.suite.lark.platform.component.widget.floatingpanel.impl.view.FloatingCardContainer
                android:id="@+id/floating_panel_card_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.suite.lark.platform.component.widget.floatingpanel.impl.view.FloatingPanelActionView
                android:id="@+id/floating_panel_card_action_bottom"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.suite.lark.platform.component.widget.floatingpanel.impl.view.FloatingPanelScrollView>
    <TextView
        android:textColor="@color/text_title"
        android:layout_gravity="top|right"
        android:id="@+id/floating_panel_new_tag"
        android:background="#20000000"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEW"
        android:alpha="0.3"/>
</merge>
