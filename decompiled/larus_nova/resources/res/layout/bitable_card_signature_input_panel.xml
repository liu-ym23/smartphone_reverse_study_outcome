<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/panelContainer"
            android:background="@drawable/bitable_signature_panel_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent">
            <RelativeLayout
                android:paddingTop="@dimen/space_kit_len_12"
                android:paddingBottom="@dimen/space_kit_len_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/space_kit_len_16"
                android:paddingEnd="@dimen/space_kit_len_16">
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/text_title"
                    android:id="@+id/cancelButton"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/space_kit_len_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Bitable_Common_ButtonCancel"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_title"
                    android:id="@+id/titleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Bitable_DB_SignatureField_TypeMode_Option"
                    android:layout_centerInParent="true"/>
                <TextView
                    android:enabled="false"
                    android:textSize="17sp"
                    android:textColor="@color/bitable_signature_save_text_color"
                    android:id="@+id/saveButton"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/space_kit_len_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Bitable_Common_ButtonSave"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <View
                android:background="@color/line_divider_default"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_kit_len_divider"/>
            <FrameLayout
                android:background="@color/bg_content_base"
                android:padding="@dimen/space_kit_len_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:background="@drawable/bitable_signature_preview_bg"
                    android:layout_width="match_parent"
                    android:layout_height="208dp">
                    <TextView
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_disable"
                        android:layout_gravity="center"
                        android:id="@+id/placeholderText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Bitable_DB_SignatureField_SignaturePreview_Placeholder"/>
                    <com.bytedance.ee.bear.bitable.celleditor.editor.signature.SignatureTextPreviewView
                        android:id="@+id/previewView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="@dimen/space_kit_len_16"
                        android:paddingEnd="@dimen/space_kit_len_16"/>
                    <ImageView
                        android:enabled="false"
                        android:layout_gravity="end|bottom"
                        android:id="@+id/clearButton"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="2dp"
                        android:layout_width="@dimen/space_kit_len_28"
                        android:layout_height="@dimen/space_kit_len_28"
                        android:layout_margin="@dimen/space_kit_len_12"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/ud_icon_reset_outlined"
                        app:tint="@color/bitable_signature_clear_icon_tint"/>
                </FrameLayout>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/bg_float"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.bytedance.ee.bear.bitable.celleditor.editor.signature.SignatureEditText
                    android:textSize="16sp"
                    android:textColor="@color/text_title"
                    android:textColorHint="@color/text_placeholder"
                    android:id="@+id/editText"
                    android:background="@android:color/transparent"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_kit_len_10"
                    android:layout_marginBottom="@dimen/space_kit_len_10"
                    android:minHeight="30dp"
                    android:hint="@string/Bitable_DB_SignatureField_Fill_Placeholder"
                    android:singleLine="true"
                    android:layout_marginStart="@dimen/space_kit_len_16"
                    android:layout_marginEnd="@dimen/space_kit_len_16"/>
                <com.bytedance.ee.bear.document.widget.KeyboardPlaceholderView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
