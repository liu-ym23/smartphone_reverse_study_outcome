<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="8dp"
    android:visibility="invisible"
    android:layout_width="wrap_content"
    android:layout_height="47dp">
    <View
        android:id="@+id/iv_background"
        android:background="@color/transparent"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginTop="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/dv_avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/dv_avatar"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="3dp"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_background"
        app:placeholderImage="@drawable/ec_icon_default_head_small"/>
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/dv_avatar_border"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/dv_avatar"
        app:layout_constraintEnd_toEndOf="@+id/dv_avatar"
        app:layout_constraintStart_toStartOf="@+id/dv_avatar"
        app:layout_constraintTop_toTopOf="@+id/dv_avatar"/>
    <com.bytedance.android.livesdk.livecommerce.view.GradientAndItalicTextView
        android:textSize="14dp"
        android:ellipsize="end"
        android:id="@+id/tv_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:maxWidth="138dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="6dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/il_introduction"
        app:layout_constraintEnd_toStartOf="@+id/fl_follow"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/dv_avatar"
        app:layout_constraintTop_toTopOf="@+id/dv_avatar"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="spread_inside"/>
    <com.bytedance.android.livesdk.livecommerce.userinfo.title.views.ECIntroductionLayout
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/il_introduction"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/dv_avatar"
        app:layout_constraintEnd_toStartOf="@+id/fl_follow"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/tv_nickname"
        app:layout_constraintTop_toBottomOf="@+id/tv_nickname"
        app:maxWidth="138dp"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/br_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="end"
        app:constraint_referenced_ids="tv_nickname,il_introduction"/>
    <FrameLayout
        android:id="@+id/fl_follow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/dv_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/br_content"
        app:layout_constraintTop_toTopOf="@+id/dv_avatar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
