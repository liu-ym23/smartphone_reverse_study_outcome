<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="156dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="47dp">
            <ImageView
                android:id="@+id/iv_linking"
                android:layout_width="20dp"
                android:layout_height="15dp"
                android:layout_marginLeft="14dp"
                android:src="@drawable/ttlive_ic_multi_anchor_linking"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#161823"
                android:id="@+id/tv_linking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="@string/ttlive_anchor_link_window_linking_with_dot"
                android:layout_toRightOf="@+id/iv_linking"
                android:layout_centerVertical="true"
                android:alpha="0.6"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:layout_alignParentEnd="true">
                <TextView
                    android:textSize="13dp"
                    android:textColor="#161823"
                    android:id="@+id/tv_quit_or_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_anchor_link_window_quit_link"
                    android:alpha="0.6"/>
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout
            android:gravity="bottom|center_horizontal"
            android:layout_gravity="bottom"
            android:id="@+id/ll_multi_anchor_window"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="109dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp">
            <com.bytedance.android.live.revlink.impl.multianchor.ui.MultiAnchorLinkInfoTopSubView
                android:id="@+id/multi_anchor_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <com.bytedance.android.live.revlink.impl.multianchor.ui.MultiAnchorLinkInfoTopSubView
                android:id="@+id/multi_anchor_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <com.bytedance.android.live.revlink.impl.multianchor.ui.MultiAnchorLinkInfoTopSubView
                android:id="@+id/multi_anchor_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <com.bytedance.android.live.revlink.impl.multianchor.ui.MultiAnchorLinkInfoTopSubView
                android:id="@+id/multi_anchor_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</merge>
