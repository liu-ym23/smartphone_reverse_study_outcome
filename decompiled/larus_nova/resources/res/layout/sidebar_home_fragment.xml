<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.scwang.smartrefresh.layout.SmartRefreshLayout
        android:id="@+id/sidebar_smart_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/list_home_coordinator_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/list_sub_menu_layout"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_behavior="com.bytedance.ee.bear.list.homepage.FlingBehavior">
                <com.google.android.material.appbar.CollapsingToolbarLayout
                    android:id="@+id/list_collapsing_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_scrollFlags="enterAlwaysCollapsed|enterAlways|scroll">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/list_header_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <com.bytedance.ee.bear.facade.common.widget.NoNetworkView
                            android:id="@+id/no_net_container"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <com.bytedance.ee.bear.list.sidebar.navigation.SidebarNavigationView
                            android:id="@+id/navigation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </com.google.android.material.appbar.CollapsingToolbarLayout>
                <com.bytedance.ee.bear.list.sidebar.tab.SidebarHomeSubMenuView
                    android:id="@+id/home_sub_title_view"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_kit_len_48"/>
            </com.google.android.material.appbar.AppBarLayout>
            <com.bytedance.ee.bear.list.homepage.tab.HomeViewPager
                android:id="@+id/list_home_viewpager"
                android:background="@color/bg_body"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/space_kit_len_8"
                app:layout_behavior="com.bytedance.ee.bear.list.homepage.KeepWithinParentBoundsScrollingBehavior"/> /&gt; 
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </com.scwang.smartrefresh.layout.SmartRefreshLayout>
    <com.bytedance.ee.bear.widgets.button.CommonCreateButton
        android:id="@+id/common_create_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
