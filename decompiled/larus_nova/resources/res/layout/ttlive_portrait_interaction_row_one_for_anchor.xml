<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/user_info_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginLeft="0dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="0dp"/>
    <ImageView
        android:id="@+id/close_in_top_container"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="-10dp"
        android:layout_marginRight="4dp"
        android:src="@drawable/ttlive_ic_broadcast_interaction_close"
        android:layout_alignTop="@+id/top_right_widget_container"
        android:layout_alignBottom="@+id/top_right_widget_container"
        android:layout_alignParentRight="true"
        android:contentDescription="@string/ttlive_a11y_close"
        android:layout_marginStart="-10dp"
        android:layout_marginEnd="4dp"
        android:layout_alignParentEnd="true"/>
    <FrameLayout
        android:id="@+id/top_right_widget_container"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="12dp"
        android:layout_toLeftOf="@+id/close_in_top_container"
        android:layout_toRightOf="@+id/user_info_container"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_toStartOf="@+id/close_in_top_container"
        android:layout_toEndOf="@+id/user_info_container"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_right_trial_broadcast"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="11dp"
        android:layout_toRightOf="@+id/user_info_container"
        android:layout_alignParentRight="true"
        android:foregroundGravity="right"
        android:layout_marginStart="12dp"
        android:layout_toEndOf="@+id/user_info_container"
        android:layout_alignParentEnd="true"/>
    <FrameLayout
        android:id="@+id/top_right_watch_user_container_v1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="8dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
