<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/link_container"
        android:background="@drawable/ttlive_chat_channel_link_float_view_bg"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/link_status_iv"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ttlive_room_channel_link_float_window_mic_open"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ProgressBar
            android:id="@+id/link_volume_view"
            android:visibility="gone"
            android:layout_width="5dp"
            android:layout_height="10.5dp"
            android:layout_marginTop="10dp"
            android:progress="50"
            app:layout_constraintEnd_toEndOf="@+id/link_status_iv"
            app:layout_constraintStart_toStartOf="@+id/link_status_iv"
            app:layout_constraintTop_toTopOf="@+id/link_status_iv"
            style="@style/ttlive_room_link_progress_bar_style_ver"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/right_arrow_container"
        android:paddingTop="8dp"
        android:paddingRight="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:background="@drawable/ttlive_chat_channel_link_float_view_left_arrow_bg"
            android:layout_width="16dp"
            android:layout_height="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:background="@drawable/ttlive_icon_room_channel_link_float_view_right_arrow"
            android:layout_width="12dp"
            android:layout_height="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
