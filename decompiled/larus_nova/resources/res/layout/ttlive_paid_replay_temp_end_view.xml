<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.livesdk.chatroom.view.BlurImageView
        android:id="@+id/replay_blur_background"
        android:background="@color/ttlive_black_50"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:ttlive_blur_radius="50dp"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/replay_paid_hint_container"
        android:background="@color/ttlive_black_70"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:id="@+id/replay_paid_block_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_replay_buy_ticket_title"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#7fffffff"
            android:gravity="center"
            android:id="@+id/replay_paid_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ttlive_replay_buy_ticket_subtitle"
            app:layout_constraintBottom_toTopOf="@+id/to_buy_btn"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/replay_paid_block_title"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/delivery_btn"
            android:background="@drawable/ttlive_bg_replay_paid_buy_button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:text="@string/ttlive_replay_delivery_button"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/replay_buy_btn"
            android:background="@drawable/ttlive_bg_replay_paid_buy_button"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/replay_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="6dp"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/replay_buy_btn_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_replay_buy_button_hint"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
