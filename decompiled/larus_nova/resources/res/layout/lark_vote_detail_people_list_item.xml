<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/people_item_layout"
    android:background="@color/ud_N00"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:animateLayoutChanges="true">
    <com.larksuite.component.ui.imageview.LKUIRoundedImageView
        android:id="@+id/vote_people_avator"
        android:visibility="visible"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="13dp"
        android:scaleType="centerCrop"
        app:civ_oval="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/ll_name_and_department_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true">
                <com.larksuite.framework.ui.SpareLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/text_title"
                        android:ellipsize="end"
                        android:gravity="top"
                        android:id="@+id/vote_people_name"
                        android:paddingLeft="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="250dp"
                        android:maxLines="1"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/udtoken_tag_text_s_blue"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/vote_master"
                        android:background="@drawable/blue_tag_bg"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_marginLeft="8dp"
                        android:text="@string/Lark_IM_Poll_Creator_Label"
                        android:singleLine="true"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/udtoken_tag_text_s_blue"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/external_votter_tag"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:layout_marginLeft="8dp"
                        android:singleLine="true"/>
                </com.larksuite.framework.ui.SpareLayout>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
