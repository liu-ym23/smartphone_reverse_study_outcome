<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="?attr/larus_bg_search_item"
    android:paddingLeft="?attr/larus_dp_16"
    android:paddingRight="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_68">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/image_search_avatar"
        android:layout_width="?attr/larus_dp_40"
        android:layout_height="?attr/larus_dp_40"
        app:placeholderImage="?attr/larus_neutral_transparent_1"
        app:roundAsCircle="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_12">
        <com.larus.chat.search.common.view.SpareLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="?attr/larus_dp_17"
                android:textStyle="bold"
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/text_search_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/image_tag_icon"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                android:layout_marginStart="?attr/larus_dp_4"
                app:srcCompat="?attr/larus_ic_search_chat_user_tag"/>
        </com.larus.chat.search.common.view.SpareLayout>
        <com.larus.chat.search.common.view.SpareLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_4">
            <TextView
                android:textSize="?attr/larus_dp_14"
                android:textColor="?attr/larus_neutral_50"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/text_search_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textSize="?attr/larus_dp_14"
                android:textColor="?attr/larus_neutral_50"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="·"
                android:layout_marginStart="?attr/larus_dp_8"/>
            <TextView
                android:textSize="?attr/larus_dp_14"
                android:textColor="?attr/larus_neutral_50"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/text_search_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="?attr/larus_dp_2"/>
        </com.larus.chat.search.common.view.SpareLayout>
    </LinearLayout>
</LinearLayout>
