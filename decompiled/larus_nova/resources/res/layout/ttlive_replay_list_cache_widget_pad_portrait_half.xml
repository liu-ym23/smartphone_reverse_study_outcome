<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/vs_cache_empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/vs_cache_content"
        android:background="@drawable/ttlive_replay_dialog_background"
        android:layout_width="375dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/ttlive_vs_video_pad_dialog_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintHeight_max="480dp"
        app:layout_constraintRight_toRightOf="parent">
        <RelativeLayout
            android:id="@+id/vs_cache_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <TextView
                android:textSize="17dp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:text="@string/ttlive_vs_cache_title"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"/>
            <ImageView
                android:id="@+id/vs_cache_close_iv"
                android:paddingLeft="5dp"
                android:paddingTop="5dp"
                android:paddingRight="5dp"
                android:paddingBottom="5dp"
                android:layout_width="21.5dp"
                android:layout_height="21.5dp"
                android:layout_marginRight="16.15dp"
                android:src="@drawable/ttlive_replay_ic_cache_close"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16.15dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/vs_cache_error_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="60dp">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:layout_width="240dp"
                android:layout_height="160dp"
                android:src="@drawable/ttlive_bg_network_error"/>
            <TextView
                android:textColor="#80ffffff"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/ttlive_vs_cache_error_tips"/>
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#e6ffffff"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/vs_cache_retry"
                android:background="@drawable/ttlive_bg_vs_cache_retry"
                android:layout_width="231dp"
                android:layout_height="44dp"
                android:layout_marginTop="20dp"
                android:text="@string/ttlive_vs_cache_retry"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/vs_cache_empty_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="60dp">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="240dp"
                android:layout_height="160dp"
                android:src="@drawable/ttlive_empty_content_dark"/>
            <TextView
                android:textSize="17dp"
                android:textColor="#ffffff"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/ttlive_vs_cache_host_empty"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#80ffffff"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/ttlive_vs_cache_host_empty_tips"/>
        </LinearLayout>
        <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
            android:layout_gravity="center"
            android:id="@+id/vs_cache_load_progress_icon"
            android:visibility="visible"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="80dp"/>
        <com.bytedance.android.livesdk.chatroom.replay.cache.ui.ReplayFadingEdgeRecyclerView
            android:id="@+id/vs_cache_rv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="16dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
