<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/dcd_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/poi_product_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.dux.text.DuxTextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/POITextPrimary"
            android:id="@+id/item_poi_product_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/font_size_26"/>
        <com.bytedance.lighten.loader.SmartImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/arrow"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="16dp"
            app:actualImageResource="@drawable/poi_ic_detail_right_arrow"/>
    </LinearLayout>
    <com.bytedance.locallife.poi.poidetail.container.component.view.dcd.ScrollToOpenLayout
        android:orientation="horizontal"
        android:id="@+id/scroll_to_open"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/card_list"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="62dp"
            android:layout_height="match_parent"
            android:paddingStart="10dp">
            <ImageView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/poi_ic_slide_more"/>
            <com.bytedance.dux.text.DuxTextView
                android:textColor="@color/POITextTertiary"
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feed_guide_title"
                android:ems="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp"/>
        </LinearLayout>
    </com.bytedance.locallife.poi.poidetail.container.component.view.dcd.ScrollToOpenLayout>
</LinearLayout>
