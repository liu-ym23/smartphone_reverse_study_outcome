<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/marquee_logo_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="6dp">
        <com.bytedance.android.shopping.store.home.view.ECShopMarqueeLogoView
            android:id="@+id/marquee_multi_user_logo3"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="28dp"
            app:roundAsCircle="true"
            app:roundingBorderColor="#1f161823"
            app:roundingBorderWidth="0.5dp"/>
        <com.bytedance.android.shopping.store.home.view.ECShopMarqueeLogoView
            android:id="@+id/marquee_multi_user_logo2"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="14dp"
            app:roundAsCircle="true"
            app:roundingBorderColor="#1f161823"
            app:roundingBorderWidth="0.5dp"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/marquee_multi_user_logo1"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:roundAsCircle="true"
            app:roundingBorderColor="#1f161823"
            app:roundingBorderWidth="0.5dp"/>
    </FrameLayout>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/marquee_user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="14dp"
        android:id="@+id/marquee_user_name_suffix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/white"
        android:id="@+id/marquee_comment_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
