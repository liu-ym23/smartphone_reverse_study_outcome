<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/ec_bg_white_radius_2dp"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/ec_color_black_161823"
        android:id="@+id/ec_explain_dialog_tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="10dp"
        android:text="@string/ec_promotion_list_tip_explain_playback_title"
        android:lineSpacingExtra="2dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ec_explain_dialog_tv_content_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/ec_explain_dialog_sv_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:src="@drawable/ec_img_explain_playback_guide"
        android:scaleType="fitXY"/>
    <View
        android:background="@color/ec_color_1f_161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="32dp"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/ec_color_black_161823"
        android:gravity="center"
        android:id="@+id/ec_tv_explain_tip_confirm"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/ec_promotion_list_tip_explain_playback_confirm"/>
</LinearLayout>
