<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/outside"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/ttlive_label_close"
        android:alpha="0"/>
    <FrameLayout
        android:orientation="horizontal"
        android:id="@+id/title_container"
        android:background="@drawable/ttlive_bg_interact_dialog"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <FrameLayout
            android:layout_gravity="start|center_vertical"
            android:id="@+id/layout_left_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginStart="8dp"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/liveuikit_black"
            android:layout_gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/frame_center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_gravity="end|center_vertical"
            android:id="@+id/layout_right_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:layout_marginEnd="8dp"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/iv_info"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="8dp"
            android:layout_marginEnd="8dp"/>
    </FrameLayout>
    <View
        android:id="@+id/view_shadow"
        android:background="#e0e0e0"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <FrameLayout
        android:id="@+id/fragment_container"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
