<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/larus_page_privacy_model_training_setting_135941003"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"/>
    <com.larus.common_ui.view.ChatSettingScrollView
        android:id="@+id/scroll_view"
        android:paddingTop="?attr/larus_dp_8"
        android:paddingBottom="?attr/larus_dp_8"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/container_layout"
            android:paddingLeft="?attr/larus_dp_16"
            android:paddingRight="?attr/larus_dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:id="@+id/title_container"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="?attr/larus_dp_16"
                app:cardCornerRadius="?attr/larus_dp_16"
                app:cardElevation="0dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:background="@color/larus_base_2"
                    android:paddingBottom="?attr/larus_dp_24"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/model_train_title_image"
                        android:layout_width="?attr/larus_dp_56"
                        android:layout_height="?attr/larus_dp_56"
                        android:layout_marginTop="?attr/larus_dp_24"
                        android:src="@drawable/larus_ic_privacy_model_train_small"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="?attr/larus_dp_17"
                        android:textColor="@color/larus_neutral_100"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:id="@+id/train_model_title"
                        android:paddingLeft="?attr/larus_dp_16"
                        android:paddingRight="?attr/larus_dp_16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="?attr/larus_dp_12"
                        android:text="@string/larus_privacy_toggle_model"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/model_train_title_image"/>
                    <com.larus.common_ui.widget.UrlSpanTextView
                        android:textSize="?attr/larus_dp_15"
                        android:textColor="@color/larus_neutral_70"
                        android:gravity="center"
                        android:id="@+id/train_model_sub_title"
                        android:paddingLeft="?attr/larus_dp_16"
                        android:paddingRight="?attr/larus_dp_16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="?attr/larus_dp_4"
                        android:lineSpacingExtra="@dimen/dp_2"
                        android:fontFamily="sans-serif-medium"
                        app:larus_linkColor="@color/larus_neutral_100"
                        app:larus_linkUnderLine="false"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/train_model_title"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/obric_model_training_group"
                android:background="@drawable/larus_bg_setting_group"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="?attr/larus_dp_16"/>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/model_training_data_type_group"
                android:background="@drawable/larus_bg_setting_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/type_data_conversation_item"
                    android:background="@drawable/larus_bg_item_selector_first"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_privacy_model_option_text"/>
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/type_data_upload_multimedia_item"
                    android:background="@drawable/larus_bg_item_selector_middle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_privacy_model_option_upload"/>
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/type_data_voice_input_item"
                    android:background="@drawable/larus_bg_item_selector_middle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_privacy_model_option_audio"/>
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/type_data_video_conversation_item"
                    android:background="@drawable/larus_bg_item_selector_last"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_privacy_model_option_visual"/>
            </com.larus.bmhome.view.item.ItemGroup>
        </LinearLayout>
    </com.larus.common_ui.view.ChatSettingScrollView>
</LinearLayout>
