<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.locallife.live.view.LiveLifeAtmosphereAnimView
        android:id="@+id/view_anim"
        android:layout_width="match_parent"
        android:layout_height="24dp"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <FrameLayout
        android:id="@+id/card_area"
        android:background="@drawable/live_bg_group_purchase_card"
        android:layout_width="match_parent"
        android:layout_height="175dp">
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/iv_cover"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_margin="1dp"
            android:scaleType="fitCenter"
            app:roundBottomEnd="false"
            app:roundBottomLeft="false"
            app:roundBottomRight="false"
            app:roundBottomStart="false"
            app:roundedCornerRadius="4dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_sell_out"
            android:background="@drawable/live_bg_group_purchase_card_sell_out"
            android:visibility="gone"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_margin="1dp"
            android:text="@string/live_local_life_card_sell_out"/>
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/iv_activity"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            app:roundBottomEnd="false"
            app:roundBottomLeft="false"
            app:roundBottomRight="false"
            app:roundBottomStart="false"
            app:roundedCornerRadius="4dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="112dp">
                <FrameLayout
                    android:id="@+id/top_layout"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_margin="1dp">
                    <com.facebook.drawee.view.SimpleDraweeView
                        android:id="@+id/iv_image_tag"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="14dp"
                        android:layout_margin="3dp"
                        app:roundedCornerRadius="2dp"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/ly_top"
                        android:background="@drawable/live_bg_group_purchase_card_tip"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_margin="3dp">
                        <View
                            android:id="@+id/view_point"
                            android:background="@drawable/poi_live_card_point"
                            android:layout_width="4dp"
                            android:layout_height="4dp"
                            android:layout_marginLeft="4dp"
                            android:layout_marginRight="4dp"/>
                        <com.bytedance.lighten.loader.SmartImageView
                            android:id="@+id/iv_tip"
                            android:layout_width="30dp"
                            android:layout_height="14dp"
                            android:scaleType="fitCenter"
                            android:layout_marginEnd="4dp"/>
                        <com.bytedance.ies.dmt.ui.widget.DmtTextView
                            android:textSize="10dp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/tv_top_text"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"/>
                    </LinearLayout>
                </FrameLayout>
                <ImageView
                    android:layout_gravity="end|top"
                    android:id="@+id/iv_group_purchase_card_close"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_margin="3dp"
                    android:src="@drawable/poi_group_purchase_close_view"
                    android:contentDescription="@string/poi_live_close_live"/>
                <RelativeLayout
                    android:layout_gravity="bottom"
                    android:id="@+id/coin_block"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_marginBottom="1dp"
                    android:layout_marginStart="1dp">
                    <com.bytedance.lighten.loader.SmartImageView
                        android:id="@+id/coin_icon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:scaleType="centerCrop"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="5dp"
                        app:placeholderImageScaleType="centerCrop"/>
                    <com.bytedance.ies.dmt.ui.widget.DmtTextView
                        android:textSize="9dp"
                        android:textColor="#ffffff"
                        android:ellipsize="end"
                        android:id="@+id/coin_tips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="6dp"
                        android:layout_toEndOf="@+id/coin_icon"/>
                </RelativeLayout>
            </FrameLayout>
            <com.bytedance.ies.dmt.ui.widget.DmtTextView
                android:textSize="10dp"
                android:textColor="#161823"
                android:ellipsize="end"
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="2"
                android:lineSpacingMultiplier="1.1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"/>
            <com.bytedance.ies.dmt.ui.widget.DmtTextView
                android:textSize="10dp"
                android:textColor="#59161823"
                android:id="@+id/tv_orgin_price"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"/>
            <com.bytedance.ies.dmt.ui.widget.DmtTextView
                android:textSize="10dp"
                android:textColor="#fe2c55"
                android:ellipsize="end"
                android:id="@+id/common_coupon_brand_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0.5dp"
                android:maxLines="1"
                android:layout_marginStart="6dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/near_store_layout"
                android:visibility="gone"
                android:layout_width="106dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="0.5dp"
                android:layout_marginStart="6dp">
                <com.bytedance.ies.dmt.ui.widget.DmtTextView
                    android:textSize="10dp"
                    android:textColor="#fe2c55"
                    android:ellipsize="end"
                    android:id="@+id/distance_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
                <View
                    android:id="@+id/split_line"
                    android:background="#57fe2c55"
                    android:layout_width="0.5dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"/>
                <com.bytedance.ies.dmt.ui.widget.DmtTextView
                    android:textSize="10dp"
                    android:textColor="#fe2c55"
                    android:ellipsize="end"
                    android:id="@+id/poi_total_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true"/>
            </LinearLayout>
            <View
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <FrameLayout
                android:id="@+id/layout_bottom_button_click_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_bottom_button"
                    android:layout_width="match_parent"
                    android:layout_height="24dp">
                    <com.bytedance.lighten.loader.SmartImageView
                        android:id="@+id/iv_btn_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        app:placeholderImage="@drawable/poi_live_local_life_card_bg_button"
                        app:placeholderImageScaleType="fitCenter"/>
                    <com.bytedance.ies.dmt.ui.widget.DmtTextView
                        android:textSize="14dp"
                        android:textColor="@color/white"
                        android:gravity="start|bottom"
                        android:id="@+id/tv_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="1dp"
                        android:lineSpacingExtra="0dp"
                        android:fontFamily="PingFangSC"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="2dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.bytedance.ies.dmt.ui.widget.DmtTextView
                        android:textSize="10dp"
                        android:textColor="@color/white"
                        android:id="@+id/tv_frequency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="PingFangSC"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tv_price"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
