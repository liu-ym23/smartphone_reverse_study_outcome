<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ui.base.widget.round.RoundRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/commerce_playback_product_purchase_card_rootview"
    android:paddingLeft="8dp"
    android:paddingBottom="8dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="8dp">
    <FrameLayout
        android:id="@+id/ec_commerce_sv_playback_product_container"
        android:layout_width="@dimen/ec_explain_playback_small_product_card_imagesize"
        android:layout_height="@dimen/ec_explain_playback_small_product_card_imagesize"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginEnd="8dp">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/ec_commerce_sv_playback_product_img"
            android:layout_width="@dimen/ec_explain_playback_small_product_card_imagesize"
            android:layout_height="@dimen/ec_explain_playback_small_product_card_imagesize"
            android:scaleType="centerCrop"
            app:failureImage="@drawable/ec_explain_playback_video_product_failure_image"
            app:failureImageScaleType="centerCrop"
            app:placeholderImage="@color/explain_playback_color_0D161823"
            app:roundedCornerRadius="2dp"/>
        <com.bytedance.android.ui.base.widget.round.RoundFrameLayout
            android:id="@+id/ec_commerce_tv_product_unable_container"
            android:visibility="gone"
            android:layout_width="@dimen/ec_explain_playback_small_product_card_imagesize"
            android:layout_height="@dimen/ec_explain_playback_small_product_card_imagesize"
            app:bg_color="@color/ec_color_black_50"
            app:bg_cornerRadius="2dp">
            <TextView
                android:textSize="8dp"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:id="@+id/ec_commerce_tv_product_unable_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </com.bytedance.android.ui.base.widget.round.RoundFrameLayout>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ec_right_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/ec_commerce_sv_playback_product_container"
        android:layout_toEndOf="@+id/ec_commerce_sv_playback_product_container">
        <com.bytedance.android.ec.core.widget.price.PriceView
            android:textSize="17dp"
            android:id="@+id/ec_commerce_pv_playback_product_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="7dp"
            app:pv_prefixTextColor="@color/ec_commerce_primary"
            app:pv_prefixTextSizeRatio="0.647"
            app:pv_priceBold="true"
            app:pv_priceDecimalTextSizeRatio="0.705"
            app:pv_priceInFen="8800"
            app:pv_priceTextColor="@color/ec_commerce_primary"
            app:pv_suffixTextColor="@color/ec_commerce_primary"
            app:pv_suffixTextSizeRatio="0.705"
            app:pv_yuanSymbolRatioOfPriceTextSize="0.705"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ec_commerce_product_purchase_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/ec_commerce_primary"
                android:id="@+id/ec_commerce_tv_playback_purchase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ec_explain_playback_go_purchase"
                style="@style/font_size_26"/>
            <ImageView
                android:id="@+id/ec_commerce_iv_purchase_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="3dp"
                android:src="@drawable/commerce_ic_playback_card_arrow_red"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/ec_commerce_iv_playback_close"
        android:paddingLeft="8dp"
        android:paddingTop="8dp"
        android:paddingRight="6dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/commerce_ic_playback_card_close_btn"
        android:layout_toRightOf="@+id/ec_right_container"
        android:paddingStart="8dp"
        android:paddingEnd="6dp"
        android:layout_toEndOf="@+id/ec_right_container"/>
</com.bytedance.android.ui.base.widget.round.RoundRelativeLayout>
