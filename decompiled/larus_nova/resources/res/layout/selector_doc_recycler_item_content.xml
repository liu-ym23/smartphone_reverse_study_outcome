<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/item_content"
    android:background="@drawable/list_item_bg_selector"
    android:paddingLeft="@dimen/sp_16"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/item_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="@dimen/dp_8"
        app:civ_radius="6dp"
        app:srcCompat="@drawable/ud_icon_file_round_doc_colorful"/>
    <com.bytedance.ee.bear.widgets.tagview.SpaceTagTitleView
        android:gravity="center_vertical"
        android:id="@+id/item_name"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginRight="16dp"
        android:layout_weight="1"
        app:titleSize="@dimen/facade_title_text_size"
        app:titleText="@string/Doc_List_TitleLabel"/>
</LinearLayout>
