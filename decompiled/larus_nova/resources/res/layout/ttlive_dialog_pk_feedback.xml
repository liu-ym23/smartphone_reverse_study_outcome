<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/outside"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/ttlive_label_close"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/ttlive_bg_feedback_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <TextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_black"
                android:layout_gravity="center_vertical"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_pk_feedback_dialog_title_any_problem"/>
        </LinearLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="#a3a3a3"
            android:layout_gravity="center_horizontal"
            android:id="@+id/sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ttlive_pk_feedback_tips"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/iv_penalty"
            android:visibility="gone"
            android:layout_width="100dp"
            android:layout_height="70dp"
            android:layout_marginTop="16dp"
            app:actualImageScaleType="fitXY"/>
        <com.bytedance.android.live.revlink.impl.pk.ui.PkFeedbackView
            android:id="@+id/pk_feedback"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"/>
        <TextView
            android:textColor="#a3a3a3"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/net_error"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:text="@string/ttlive_core_load_status_network_error"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/btn_live_revenue_pk_finish"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp">
            <Button
                android:textSize="15dp"
                android:textColor="@color/ttlive_pk_feedback_tag_selected"
                android:id="@+id/btn_pk_end_left"
                android:background="@drawable/ttlive_bg_pk_feedback_another_red"
                android:layout_width="164dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:text="@string/ttlive_pk_feedback_dialog_another_game"
                android:height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"/>
            <Button
                android:textSize="15dp"
                android:textColor="@color/white"
                android:id="@+id/btn_pk_end_right"
                android:background="@drawable/ttlive_bg_pk_cancel"
                android:layout_width="164dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:text="@string/ttlive_pk_feedback_dialog_finish_pk"
                android:height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"/>
        </LinearLayout>
        <Button
            android:textSize="15dp"
            android:textColor="@color/white"
            android:id="@+id/ttlive_submit"
            android:background="@drawable/ttlive_bg_pk_cancel"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/ttlive_pk_feedback_dialog_submit_issues"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
