<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/content_view"
    android:background="@drawable/ttlive_bg_prelive_setting"
    android:layout_width="match_parent"
    android:layout_height="484dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="55dp">
        <TextView
            android:id="@+id/comment_setting_title_tv"
            android:layout_width="wrap_content"
            android:text="@string/ttlive_live_pre_enable_comment_control"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            style="@style/ttlive_dialog_preview_title_style"/>
    </RelativeLayout>
    <View
        android:id="@+id/comment_setting_top_divider"
        android:background="@color/ttlive_std_line_white_2"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <com.bytedance.android.livesdk.widget.MaxHeightScrollView
        android:id="@+id/payment_setting_scroll"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="428dp"
        app:maxHeight="428dp">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="428dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/room_channel_info_title"
                    android:visibility="visible"
                    android:text="@string/ttlive_broadcast_presetting_room_channel_title"
                    style="@style/ttlive_dialog_preview_subtitle_style"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:orientation="horizontal"
                    android:id="@+id/room_channel_setting_layout"
                    android:focusable="true"
                    android:layout_width="match_parent"
                    android:layout_height="77dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView
                        android:textSize="15dp"
                        android:textColor="@color/ttlive_prelive_setting_dark_txt"
                        android:gravity="start|center_vertical"
                        android:id="@+id/room_channel_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ttlive_broadcast_can_open_room_channel"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:importantForAccessibility="no"
                        app:layout_constraintBottom_toTopOf="@+id/room_channel_tips"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed"/>
                    <TextView
                        android:textSize="13dp"
                        android:textColor="@color/ttlive_prelive_setting_dark_tips"
                        android:id="@+id/room_channel_tips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/ttlive_live_room_channel_tips"
                        android:includeFontPadding="false"
                        android:importantForAccessibility="no"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/room_channel_tv"/>
                    <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
                        android:id="@+id/room_channel_switch"
                        android:layout_width="43dp"
                        android:layout_height="25dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:lsb_background="@color/ttlive_prelive_setting_switch_dark_fill"
                        app:lsb_button_color="#ffffff"
                        app:lsb_checked_color="@color/ttlive_preview_setting_switch_check_color"
                        app:lsb_effect_duration="50"
                        app:lsb_shadow_radius="0dp"
                        app:lsb_show_indicator="false"
                        app:lsb_uncheck_color="@color/transparent"
                        app:lsb_uncheckbutton_color="#d9ffffff"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:id="@+id/room_channel_divider"
                    android:visibility="visible"
                    style="@style/ttlive_preview_dialog_line"/>
                <TextView
                    android:id="@+id/pre_setting_info_title"
                    android:visibility="visible"
                    android:text="@string/ttlive_broadcast_toolbar_comment"
                    style="@style/ttlive_dialog_preview_subtitle_style"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:orientation="horizontal"
                    android:id="@+id/comment_setting_comment_layout"
                    android:focusable="true"
                    android:layout_width="match_parent"
                    android:layout_height="77dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView
                        android:textSize="15dp"
                        android:textColor="@color/ttlive_prelive_setting_dark_txt"
                        android:gravity="start|center_vertical"
                        android:id="@+id/comment_setting_comment_title_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ttlive_broadcast_can_comment"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:importantForAccessibility="no"
                        app:layout_constraintBottom_toTopOf="@+id/comment_setting_tips_tv"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed"/>
                    <TextView
                        android:textSize="13dp"
                        android:textColor="@color/ttlive_prelive_setting_dark_tips"
                        android:id="@+id/comment_setting_tips_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/ttlive_live_comment_setting_tips"
                        android:includeFontPadding="false"
                        android:importantForAccessibility="no"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/comment_setting_comment_title_tv"/>
                    <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
                        android:id="@+id/comment_setting_switch"
                        android:layout_width="43dp"
                        android:layout_height="25dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:lsb_background="@color/ttlive_prelive_setting_switch_dark_fill"
                        app:lsb_button_color="#ffffff"
                        app:lsb_checked_color="@color/ttlive_preview_setting_switch_check_color"
                        app:lsb_effect_duration="50"
                        app:lsb_shadow_radius="0dp"
                        app:lsb_show_indicator="false"
                        app:lsb_uncheck_color="@color/transparent"
                        app:lsb_uncheckbutton_color="#d9ffffff"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/comment_setting_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RadioGroup
                        android:id="@+id/group_follow"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp">
                        <RadioButton
                            android:textSize="15dp"
                            android:textColor="@color/ttlive_prelive_setting_dark_txt"
                            android:id="@+id/follow_no"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:button="@null"
                            android:text="@string/ttlive_live_pre_enable_comment_follow_1"
                            android:drawableRight="@drawable/ttlive_selector_barrage_privilege"
                            android:drawableEnd="@drawable/ttlive_selector_barrage_privilege"/>
                        <RadioButton
                            android:textSize="15dp"
                            android:textColor="@color/ttlive_prelive_setting_dark_txt"
                            android:id="@+id/follow_only"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:button="@null"
                            android:text="@string/ttlive_live_pre_enable_comment_follow_2"
                            android:drawableRight="@drawable/ttlive_selector_barrage_privilege"
                            android:drawableEnd="@drawable/ttlive_selector_barrage_privilege"/>
                        <RadioButton
                            android:textSize="15dp"
                            android:textColor="@color/ttlive_prelive_setting_dark_txt"
                            android:id="@+id/follow_three"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:button="@null"
                            android:text="@string/ttlive_live_pre_enable_comment_follow_3"
                            android:drawableRight="@drawable/ttlive_selector_barrage_privilege"
                            android:drawableEnd="@drawable/ttlive_selector_barrage_privilege"/>
                    </RadioGroup>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:orientation="horizontal"
                        android:id="@+id/paid_live_comment_setting_layout"
                        android:focusable="true"
                        android:layout_width="match_parent"
                        android:layout_height="77dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">
                        <TextView
                            android:textSize="15dp"
                            android:textColor="@color/ttlive_prelive_setting_dark_txt"
                            android:gravity="start|center_vertical"
                            android:id="@+id/paid_live_comment_setting_title_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ttlive_paid_live_broadcast_can_comment"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:importantForAccessibility="no"
                            app:layout_constraintBottom_toTopOf="@+id/paid_live_comment_setting_tips_tv"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_chainStyle="packed"/>
                        <TextView
                            android:textSize="13dp"
                            android:textColor="@color/ttlive_prelive_setting_dark_tips"
                            android:id="@+id/paid_live_comment_setting_tips_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/ttlive_paid_live_comment_setting_tips"
                            android:includeFontPadding="false"
                            android:importantForAccessibility="no"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/paid_live_comment_setting_title_tv"/>
                        <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
                            android:id="@+id/paid_live_comment_setting_switch"
                            android:layout_width="43dp"
                            android:layout_height="25dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:lsb_background="@color/ttlive_prelive_setting_switch_dark_fill"
                            app:lsb_button_color="#ffffff"
                            app:lsb_checked_color="@color/ttlive_preview_setting_switch_check_color"
                            app:lsb_effect_duration="50"
                            app:lsb_shadow_radius="0dp"
                            app:lsb_show_indicator="false"
                            app:lsb_uncheck_color="@color/transparent"
                            app:lsb_uncheckbutton_color="#d9ffffff"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:id="@+id/pre_setting_audio_title"
                        android:visibility="visible"
                        android:text="@string/ttlive_broadcast_audio"
                        style="@style/ttlive_dialog_preview_subtitle_style"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:orientation="horizontal"
                        android:id="@+id/comment_setting_audio_layout"
                        android:focusable="true"
                        android:layout_width="match_parent"
                        android:layout_height="77dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">
                        <TextView
                            android:textSize="15dp"
                            android:textColor="@color/ttlive_prelive_setting_dark_txt"
                            android:gravity="start|center_vertical"
                            android:id="@+id/audio_setting_title_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ttlive_audio_comment_can_send"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:importantForAccessibility="no"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_chainStyle="packed"/>
                        <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
                            android:id="@+id/audio_setting_switch"
                            android:layout_width="43dp"
                            android:layout_height="25dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:lsb_background="@color/ttlive_prelive_setting_switch_dark_fill"
                            app:lsb_button_color="#ffffff"
                            app:lsb_checked_color="@color/ttlive_preview_setting_switch_check_color"
                            app:lsb_effect_duration="50"
                            app:lsb_shadow_radius="0dp"
                            app:lsb_show_indicator="false"
                            app:lsb_uncheck_color="@color/transparent"
                            app:lsb_uncheckbutton_color="#d9ffffff"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:orientation="horizontal"
                        android:id="@+id/comment_setting_audio_auto_layout"
                        android:focusable="true"
                        android:layout_width="match_parent"
                        android:layout_height="77dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">
                        <TextView
                            android:textSize="15dp"
                            android:textColor="@color/ttlive_prelive_setting_dark_txt"
                            android:gravity="start|center_vertical"
                            android:id="@+id/audio_auto_setting_title_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ttlive_audio_comment_auto_play"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:importantForAccessibility="no"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_chainStyle="packed"/>
                        <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
                            android:id="@+id/audio_auto_setting_switch"
                            android:layout_width="43dp"
                            android:layout_height="25dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:lsb_background="@color/ttlive_prelive_setting_switch_dark_fill"
                            app:lsb_button_color="#ffffff"
                            app:lsb_checked_color="@color/ttlive_preview_setting_switch_check_color"
                            app:lsb_effect_duration="50"
                            app:lsb_shadow_radius="0dp"
                            app:lsb_show_indicator="false"
                            app:lsb_uncheck_color="@color/transparent"
                            app:lsb_uncheckbutton_color="#d9ffffff"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <View
                        android:id="@+id/pre_setting_info_video_title_divider"
                        android:visibility="visible"
                        style="@style/ttlive_preview_dialog_line"/>
                    <TextView
                        android:id="@+id/pre_setting_video_title"
                        android:visibility="visible"
                        android:text="@string/ttlive_ktv_sing_mode_video"
                        style="@style/ttlive_dialog_preview_subtitle_style"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:orientation="horizontal"
                        android:id="@+id/comment_setting_video_layout"
                        android:focusable="true"
                        android:layout_width="match_parent"
                        android:layout_height="77dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">
                        <TextView
                            android:textSize="15dp"
                            android:textColor="@color/ttlive_prelive_setting_dark_txt"
                            android:gravity="start|center_vertical"
                            android:id="@+id/video_setting_title_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ttlive_video_comment_can_send_broadcast_plugin"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:importantForAccessibility="no"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_chainStyle="packed"/>
                        <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
                            android:id="@+id/video_setting_switch"
                            android:layout_width="43dp"
                            android:layout_height="25dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:lsb_background="@color/ttlive_prelive_setting_switch_dark_fill"
                            app:lsb_button_color="#ffffff"
                            app:lsb_checked_color="@color/ttlive_preview_setting_switch_check_color"
                            app:lsb_effect_duration="50"
                            app:lsb_shadow_radius="0dp"
                            app:lsb_show_indicator="false"
                            app:lsb_uncheck_color="@color/transparent"
                            app:lsb_uncheckbutton_color="#d9ffffff"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <View
                        android:id="@+id/pre_setting_info_title_divider"
                        android:visibility="visible"
                        style="@style/ttlive_preview_dialog_line"/>
                    <TextView
                        android:id="@+id/pre_setting_function_title"
                        android:visibility="visible"
                        android:text="@string/ttlive_live_pre_setting_barrage"
                        style="@style/ttlive_dialog_preview_subtitle_style"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:orientation="horizontal"
                        android:id="@+id/privilege_barrage_setting_layout"
                        android:focusable="true"
                        android:layout_width="match_parent"
                        android:layout_height="77dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">
                        <TextView
                            android:textSize="15dp"
                            android:textColor="@color/ttlive_prelive_setting_dark_txt"
                            android:gravity="start|center_vertical"
                            android:id="@+id/anchor_backtrack_setting_title_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ttlive_live_privilege_setting_barrage_enable"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:importantForAccessibility="no"
                            app:layout_constraintBottom_toTopOf="@+id/anchor_backtrack_setting_tips_tv"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_chainStyle="packed"/>
                        <TextView
                            android:textSize="13dp"
                            android:textColor="@color/ttlive_prelive_setting_dark_tips"
                            android:ellipsize="marquee"
                            android:id="@+id/anchor_backtrack_setting_tips_tv"
                            android:focusableInTouchMode="true"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/ttlive_live_privilege_setting_barrage_enable_desc"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            android:marqueeRepeatLimit="marquee_forever"
                            android:importantForAccessibility="no"
                            android:layout_marginEnd="43dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/anchor_backtrack_setting_title_tv"/>
                        <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
                            android:id="@+id/privilege_barrage_switch"
                            android:layout_width="43dp"
                            android:layout_height="25dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:lsb_background="@color/ttlive_prelive_setting_switch_dark_fill"
                            app:lsb_button_color="#ffffff"
                            app:lsb_checked_color="@color/ttlive_preview_setting_switch_check_color"
                            app:lsb_effect_duration="50"
                            app:lsb_shadow_radius="0dp"
                            app:lsb_show_indicator="false"
                            app:lsb_uncheck_color="@color/transparent"
                            app:lsb_uncheckbutton_color="#d9ffffff"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/goto_privilege_setting_paid_layout"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="15dp"
                            android:textColor="@color/ttlive_prelive_setting_dark_txt"
                            android:gravity="start|center_vertical"
                            android:id="@+id/live_paid_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp"
                            android:text="@string/ttlive_live_privilege_setting_barrage_setting"
                            android:includeFontPadding="false"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="14dp"
                            android:textColor="#80ffffff"
                            android:id="@+id/live_paid_enter_icon"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableRight="@drawable/ttlive_ic_forenotice_entry_arrow"
                            android:drawablePadding="8dp"
                            android:drawableEnd="@drawable/ttlive_ic_forenotice_entry_arrow"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.bytedance.android.livesdk.widget.MaxHeightScrollView>
</LinearLayout>
