<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/hint_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true">
    <View
        android:background="@color/ttlive_color_1F_161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/operateLayout"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <ImageView
            android:background="@drawable/ttlive_mark_highlight_video_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"/>
        <TextView
            android:textColor="@color/ttlive_60_161823"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_mark_highlight_tips"
            android:includeFontPadding="false"/>
        <FrameLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/go_publish"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <TextView
                    android:textColor="@color/ttlive_frequent_chat_key_btn_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="@string/ttlive_mark_highlight_go_publish_tips"
                    android:includeFontPadding="false"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/ttlive_mark_highlight_video_icon_right"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginLeft="4dp"/>
            </LinearLayout>
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/publish_loading"
                android:background="@drawable/ttlive_ic_privilege_loading"
                android:visibility="gone"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginLeft="4dp"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
