<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/root_container"
    android:layout_width="wrap_content"
    android:layout_height="20dp"
    android:baselineAligned="true">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/anchor_v3_sv_rank_icon"
        android:background="@drawable/ec_inflow_rank_head_icon"
        android:layout_width="11dp"
        android:layout_height="11dp"
        android:layout_marginRight="2dp"
        android:scaleType="centerCrop"
        android:layout_marginEnd="2dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#b48352"
        android:gravity="center"
        android:id="@+id/anchor_v3_tv_rank_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="20dp"
        android:lineSpacingExtra="0dp"/>
    <TextView
        android:textColor="#b48352"
        android:gravity="center"
        android:id="@+id/anchor_v3_tv_rank_title_dot"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:text="@string/Anchor_V3_middle_dot"
        android:includeFontPadding="false"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        style="@style/font_size_26"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/anchor_v3_tv_rank_text_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="13sp"
            android:textColor="#b48352"
            android:gravity="center"
            android:id="@+id/anchor_v3_tv_rank_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="20dp"
            android:lineSpacingExtra="0dp"/>
    </LinearLayout>
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/anchor_v3_sv_rank_right_arrow"
        android:background="@drawable/ec_inflow_rank_right_arrow"
        android:layout_width="5dp"
        android:layout_height="9dp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:tint="#b48352"
        android:layout_marginEnd="4dp"/>
</LinearLayout>
