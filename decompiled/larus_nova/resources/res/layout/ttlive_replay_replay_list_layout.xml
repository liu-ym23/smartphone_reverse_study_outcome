<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ttlive_replay_replay_tab_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="4dp"/>
    <com.bytedance.android.livesdk.chatroom.ui.DouyinLoadingLayout
        android:id="@+id/ttlive_replay_list_loading_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ttlive_replay_list_error_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="240dp"
            android:layout_height="160dp"
            android:src="@drawable/ttlive_bg_network_error"
            android:scaleType="fitCenter"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/ttlive_std_text_white_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_vs_loading_error_tips"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/ttlive_std_text_white_1"
            android:gravity="center"
            android:id="@+id/ttsdk_replay_list_error"
            android:background="@drawable/ttlive_bg_player_click_to_retry"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/ttlive_replay_click_to_retry"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ttlive_replay_list_empty_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/replay_list_empty_image"
            android:layout_width="236dp"
            android:layout_height="158dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/ttlive_std_text_white_1"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:text="@string/ttlive_vs_cache_host_empty"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="6"/>
    </LinearLayout>
</FrameLayout>
