<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/video_player_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.livesdk.chatroom.ui.LoadingAnimView
        android:layout_gravity="center"
        android:id="@+id/video_loading_view"
        android:visibility="gone"
        android:layout_width="90dp"
        android:layout_height="90dp"/>
    <com.bytedance.android.livesdk.chatroom.ui.DouyinLoadingLayout
        android:layout_gravity="center"
        android:id="@+id/video_douyin_loading_view"
        android:visibility="gone"
        android:layout_width="90dp"
        android:layout_height="90dp"/>
</FrameLayout>
