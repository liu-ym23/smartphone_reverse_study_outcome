<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/input_editor_assembler"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/input_top_expand_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/float_expand_bg_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.larksuite.component.ui.layout.LKUIRoundableLayout
            android:orientation="horizontal"
            android:id="@+id/input_top_middle_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rl_radius_left_top="28dp"
            app:rl_radius_right_top="28dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/input_top_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/input_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <include
                android:id="@+id/input_shrink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/kb_input_richtext_shrink_assembler"/>
            <include
                android:id="@+id/kb_expand_observe_anim"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/kb_input_richtext_expand_assembler"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/input_bottom_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
