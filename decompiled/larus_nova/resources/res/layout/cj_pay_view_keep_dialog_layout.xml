<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:background="@drawable/cj_pay_bg_common_dialog_radius_12"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/keep_dialog_close_image"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/cj_pay_icon_titlebar_left_close_noise_reduction"/>
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/cj_pay_color_black_161823"
        android:gravity="center"
        android:id="@+id/keep_dialog_title"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_centerHorizontal="true"/>
    <FrameLayout
        android:id="@+id/keep_dialog_content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/keep_dialog_title">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
            android:ellipsize="middle"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/keep_dialog_text"
            android:paddingTop="10dp"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:maxWidth="240dp"
            android:maxLines="2"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/content_list_layout"
            android:paddingTop="10dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
        android:textSize="15sp"
        android:textColor="@color/cj_pay_color_white"
        android:gravity="center"
        android:id="@+id/keep_dialog_btn"
        android:background="@color/cj_pay_color_red_fe2c55"
        android:layout_width="240dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="20dp"
        android:text="@string/cj_pay_keep_window_keep"
        android:layout_below="@+id/keep_dialog_content_layout"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
        android:gravity="center_horizontal"
        android:id="@+id/keep_dialog_another_verify_type"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13dp"
        android:maxLines="1"
        android:layout_below="@+id/keep_dialog_btn"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
