<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/loading_view_container"
    android:visibility="gone"
    android:layout_width="100dp"
    android:layout_height="90dp">
    <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
        android:layout_gravity="center"
        android:id="@+id/double_loading_view"
        android:visibility="visible"
        android:layout_width="36dp"
        android:layout_height="36dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#000000"
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/ttlive_solo_ktv_order_dialog_api_loading_text"/>
</LinearLayout>
