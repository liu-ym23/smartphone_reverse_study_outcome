<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/iv_app_icon"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_16"
        android:src="@drawable/dux_radio_check"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="?attr/larus_dp_6"/>
    <TextView
        android:textSize="@dimen/dp_15"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:id="@+id/tv_app_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="PingFang SC"
        android:layout_marginStart="@dimen/dp_9"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/iv_app_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_app_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_app_icon"/>
    <TextView
        android:textSize="@dimen/dp_16"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="PingFang SC"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_app_icon"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/larus_neutral_50"
        android:id="@+id/tv_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_7"
        android:fontFamily="PingFang SC"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <View
        android:id="@+id/guideView"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_subtitle"
        app:layout_constraintWidth_default="wrap"/>
    <com.larus.common_ui.widget.roundlayout.RoundTextView
        android:textSize="@dimen/dp_17"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/btn_negative"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_44"
        android:layout_marginTop="@dimen/dp_14"
        android:layout_marginBottom="@dimen/dp_16"
        android:fontFamily="PingFang SC"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_positive"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_subtitle"
        app:layout_goneMarginTop="@dimen/dp_16"
        app:rv_backgroundColor="?attr/larus_base_2_overlay"
        app:rv_backgroundPressColor="?attr/larus_base_2_overlay"
        app:rv_cornerRadius="?attr/larus_dp_8"/>
    <ProgressBar
        android:id="@+id/negative_inner_loading"
        android:visibility="invisible"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/larus_ic_common_download_loading_animated"
        android:indeterminateDuration="2000"
        android:fontFamily="PingFang SC"
        android:indeterminateTint="?attr/larus_neutral_100"
        app:layout_constraintBottom_toBottomOf="@+id/btn_negative"
        app:layout_constraintEnd_toEndOf="@+id/btn_negative"
        app:layout_constraintStart_toStartOf="@+id/btn_negative"
        app:layout_constraintTop_toTopOf="@+id/btn_negative"/>
    <com.larus.common_ui.widget.roundlayout.RoundTextView
        android:textSize="@dimen/dp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/btn_positive"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_44"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/btn_negative"
        app:layout_constraintTop_toTopOf="@+id/btn_negative"
        app:rv_backgroundColor="?attr/larus_primary_50"
        app:rv_backgroundPressColor="?attr/larus_primary_50"
        app:rv_cornerRadius="?attr/larus_dp_8"/>
    <ProgressBar
        android:id="@+id/positive_inner_loading"
        android:visibility="invisible"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/larus_ic_common_download_loading_animated"
        android:indeterminateDuration="2000"
        app:layout_constraintBottom_toBottomOf="@+id/btn_positive"
        app:layout_constraintEnd_toEndOf="@+id/btn_positive"
        app:layout_constraintStart_toStartOf="@+id/btn_positive"
        app:layout_constraintTop_toTopOf="@+id/btn_positive"/>
</merge>
