<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.shopping.anchorv3.compat.CompatFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/touch_outside"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:soundEffectsEnabled="false"
            android:importantForAccessibility="no"/>
        <com.bytedance.android.shopping.anchorv3.compat.CompatFrameLayout
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/commerce_design_bottom_sheet"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/ec_behavior"
            style="?attr/bottomSheetStyle"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <FrameLayout
        android:id="@+id/anchor_v3_strand_wrapper"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/anchor_v3_nav_area_search"
        android:background="@color/BGReverse"
        android:layout_width="match_parent"
        android:layout_height="@dimen/commerce_anchor_v3_top_area_height"
        android:alpha="0">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingRight="6dp"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageView
                android:id="@+id/anchor_v3_close_search"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ec_commerce_anchor_v4_back_arrow_shadow"
                android:contentDescription="@string/shopping_return"/>
            <com.bytedance.android.shopping.inflow.widget.AnchorV3SearchEditView
                android:id="@+id/anchor_v3_search_view_search"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginLeft="4dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"/>
            <ImageView
                android:id="@+id/collect_icon_black_search"
                android:padding="6dp"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/commerce_anchor_v3_collect_status_dark"
                android:contentDescription="@string/ec_shopping_anchor_v3_share"/>
            <com.bytedance.android.shopping.inflow.view.AnchorV4AddShopCartView
                android:id="@+id/add_shop_cart_search"
                android:padding="3dp"
                android:focusable="true"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:contentDescription="@string/commerce_jump_to_cart"/>
            <ImageView
                android:id="@+id/share_icon_black_search"
                android:padding="6dp"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/anchor_v4_top_right_share"
                android:contentDescription="@string/commerce_share"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.bytedance.android.shopping.anchorv3.compat.CompatFrameLayout>
