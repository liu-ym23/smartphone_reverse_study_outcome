<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/proIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:scaleType="centerInside"
        android:tint="@color/icon_n1"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ud_icon_bitable_authorization_outlined"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/proMore"
        android:layout_width="@dimen/space_kit_len_20"
        android:layout_height="@dimen/space_kit_len_20"
        android:scaleType="centerInside"
        android:tint="@color/icon_n3"
        android:layout_marginEnd="@dimen/space_kit_len_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ud_icon_right_outlined"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/proTitleLayout"
        android:paddingTop="@dimen/share_panel_row_entry_padding_vertical"
        android:paddingBottom="@dimen/share_panel_row_entry_padding_vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_kit_len_12"
        android:layout_marginEnd="@dimen/space_kit_len_8"
        app:layout_constraintEnd_toStartOf="@+id/proMore"
        app:layout_constraintStart_toEndOf="@+id/proIcon"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_title"
            android:id="@+id/proTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/space_kit_len_22"
            android:text="@string/Bitable_AdvancedPermissions_Mobile_TurnedOnAdvanced_Desc"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="@dimen/space_kit_font_14"
            android:textColor="@color/text_caption"
            android:id="@+id/proSubTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_kit_len_4"
            android:text="@string/Bitable_AdvancedPermissions_Mobile_PermissionsSet_SubDesc"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
