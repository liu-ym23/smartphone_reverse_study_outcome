<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/layout_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/bg_body"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:textColor="@color/text_title"
            android:gravity="center_vertical"
            android:id="@+id/btn_back"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/icon_back_white"
            app:tint="@color/text_title"/>
        <Button
            android:textSize="17sp"
            android:textColor="@color/text_title"
            android:gravity="center"
            android:layout_gravity="right"
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/Lark_Legacy_PickerAllImage"
            style="@style/Widget.AppCompat.ActionButton"/>
        <View
            android:id="@+id/popup_anchor"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="44dp"/>
    </FrameLayout>
    <com.ss.android.lark.widget.photopickernew.storage.PhotoPartialStoragePermissionNotice
        android:id="@+id/partial_permission_notice"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/> /&gt; 
</LinearLayout>
