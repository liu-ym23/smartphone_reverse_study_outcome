<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/message_container"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="17dp"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/ttlive_ps_panel_bg_top_corner"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="20dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerLinearlayout
                android:layout_gravity="center_horizontal"
                android:background="#33161823"
                android:layout_width="32dp"
                android:layout_height="4dp"
                android:layout_marginTop="6dp"
                app:ttlive_allRadius="8dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/top_panel"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/middle_panel"
                android:background="@drawable/ttlive_ps_panel_white_round_corner"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/bottom_panel"
                android:background="@drawable/ttlive_ps_panel_white_round_corner"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
