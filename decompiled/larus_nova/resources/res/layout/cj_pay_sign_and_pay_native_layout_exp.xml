<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_pay_sign_and_pay_native_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@color/cj_pay_color_white"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/top_navigation_bar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="44dp"
            android:layout_marginRight="16dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/sign_left_close_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/cj_pay_sign_and_pay_left_leave"
                android:layout_centerVertical="true"/>
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <ImageView
                    android:id="@+id/iv_navigation_bar_icon"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginRight="4dp"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
                    android:id="@+id/tv_navigation_bar_title"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@+id/iv_navigation_bar_icon"/>
            </RelativeLayout>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/sign_title_zone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_below="@+id/top_navigation_bar">
            <ImageView
                android:id="@+id/sign_title_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/cj_pay_color_black_161823"
                android:id="@+id/sign_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
            android:id="@+id/sign_merchant_name_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_below="@+id/sign_title_zone"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/sign_price_zone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:baselineAligned="true"
            android:layout_below="@+id/sign_merchant_name_text"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="28sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:id="@+id/sign_currency_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¥"/>
            <TextView
                android:textSize="36sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:id="@+id/sign_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="#ffff6e26"
            android:id="@+id/sign_voucher_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/sign_price_zone"
            android:layout_centerHorizontal="true"/>
        <RelativeLayout
            android:id="@+id/sign_switch_button_zone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="40dp"
            android:layout_marginRight="16dp"
            android:layout_below="@+id/sign_price_zone">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#ff161823"
                android:id="@+id/sign_switch_desc_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"/>
            <FrameLayout
                android:id="@+id/sign_switch_button_container"
                android:layout_width="43dp"
                android:layout_height="25dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <View
            android:id="@+id/sign_upper_split_line"
            android:background="#1f161823"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="24.5dp"
            android:layout_below="@+id/sign_switch_button_zone"
            android:layout_centerInParent="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/sign_and_pay_only_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_below="@+id/sign_switch_button_zone">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/sign_amount_line_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="8dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#99161823"
                    android:layout_gravity="top"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cj_pay_sign_and_pay_order_amount"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ff161823"
                    android:gravity="right"
                    android:id="@+id/tv_sign_amount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="24dp"
                    android:maxLines="1"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/sign_voucher_line_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="8dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#99161823"
                    android:layout_gravity="top"
                    android:id="@+id/tv_sign_voucher_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cj_pay_sign_and_pay_payment_offer"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ff6e26"
                    android:gravity="right"
                    android:id="@+id/tv_sign_voucher_right"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="24dp"
                    android:maxLines="1"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/sign_gift_line_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="8dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#99161823"
                    android:layout_gravity="top"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cj_pay_sign_and_pay_payment_gift"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ff6e26"
                    android:ellipsize="end"
                    android:gravity="right"
                    android:id="@+id/tv_sign_gift_right"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="44dp"
                    android:maxLines="1"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/sign_service_line_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#99161823"
                    android:layout_gravity="top"
                    android:id="@+id/sign_service_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cj_pay_sign_and_pay_service_title"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ff161823"
                    android:gravity="left"
                    android:layout_gravity="top"
                    android:id="@+id/sign_service_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="44dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/sign_charge_line_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="14dp"
                android:layout_marginRight="16dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#99161823"
                    android:layout_gravity="top"
                    android:id="@+id/sign_charge_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cj_pay_sign_and_pay_native_deduct_period"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ff161823"
                    android:gravity="left"
                    android:layout_gravity="top"
                    android:id="@+id/sign_charge_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="24dp"/>
            </LinearLayout>
            <View
                android:id="@+id/sign_split_line"
                android:background="#1f161823"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="17dp"
                android:layout_centerInParent="true"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/sign_method_line_layout"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:minHeight="58dp"
                android:layout_below="@+id/sign_split_line">
                <TextView
                    android:textSize="14sp"
                    android:textColor="#99161823"
                    android:id="@+id/sign_charge_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cj_pay_sign_and_pay_method_title_first"/>
                <LinearLayout
                    android:gravity="left"
                    android:orientation="vertical"
                    android:id="@+id/sign_method_right_layout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_weight="3">
                    <LinearLayout
                        android:layout_gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/sign_page_method_line_right_upper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/sign_selected_bank_icon"
                            android:visibility="gone"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_alignParentLeft="true"
                            android:layout_centerVertical="true"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff161823"
                            android:ellipsize="middle"
                            android:id="@+id/sign_selected_bank_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:layout_weight="1"
                            android:layout_toLeftOf="@+id/cj_pay_sign_right_arrow"
                            android:layout_centerVertical="true"/>
                        <ImageView
                            android:id="@+id/cj_pay_sign_right_arrow"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginLeft="2dp"
                            android:src="@drawable/cj_pay_sign_right_arrow"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#80161823"
                        android:id="@+id/sign_deduct_method_desc"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="20dp"
                        android:layout_below="@+id/sign_page_method_line_right_upper"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <Space
            android:id="@+id/space_above_btn_confirm"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:text="hello"
            android:layout_weight="1"/>
        <RelativeLayout
            android:id="@+id/rl_voucher_label_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-13dp">
            <LinearLayout
                android:orientation="horizontal"
                android:background="@drawable/cj_pay_bg_pay_again_voucher_label"
                android:paddingLeft="@dimen/cj_pay_padding_15"
                android:paddingRight="@dimen/cj_pay_padding_12"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginLeft="40dp"
                android:layout_marginRight="16dp"
                android:layout_alignParentEnd="true">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="@dimen/cj_pay_padding_8"
                    android:layout_marginRight="@dimen/cj_pay_padding_5"
                    android:src="@drawable/cj_pay_sign_voucher"
                    android:scaleType="center"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/cj_pay_color_red_fe2c55"
                    android:id="@+id/tv_voucher_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cj_pay_padding_7"
                    android:singleLine="true"/>
            </LinearLayout>
        </RelativeLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="#ff5100"
            android:ellipsize="end"
            android:id="@+id/tv_payment_gift"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="40dp"
            android:layout_marginRight="40dp"
            android:maxLines="1"
            android:layout_below="@+id/sign_and_pay_only_view"
            android:layout_centerHorizontal="true"/>
        <com.android.ttcjpaysdk.base.ui.widget.LoadingButton
            android:gravity="center"
            android:id="@+id/sign_confirm_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_custom_button_height_44"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            app:btnTextColor="@color/cj_pay_color_white"
            app:btnTextSize="15sp"
            app:loadingHeight="20dp"
            app:loadingWidth="20dp"/>
        <Space
            android:id="@+id/space_below_btn_confirm"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
            android:id="@+id/sign_agreement_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:layout_above="@+id/sign_insurance_view"
            android:lineSpacingExtra="2.5dp"/>
        <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
            android:id="@+id/sign_insurance_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/cj_pay_padding_16"
            android:layout_alignParentBottom="true"
            app:theme_type="0"/>
    </LinearLayout>
    <include
        android:id="@+id/sign_method_list_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/cj_pay_activity_payment_method_layout"/>
</FrameLayout>
