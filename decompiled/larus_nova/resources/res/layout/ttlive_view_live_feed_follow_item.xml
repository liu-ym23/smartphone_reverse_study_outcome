<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="wrap_content"
    android:layout_height="120dp">
    <View
        android:id="@+id/left_padding"
        android:layout_width="8dp"
        android:layout_height="120dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/right_padding"
        android:layout_width="8dp"
        android:layout_height="120dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/avatar_background"
        android:background="@drawable/ttlive_bg_feed_live_follow"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginTop="20dp"
        app:layout_constraintLeft_toRightOf="@+id/left_padding"
        app:layout_constraintRight_toLeftOf="@+id/right_padding"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@drawable/ttlive_bg_feed_live_follow_white"
        android:layout_width="54dp"
        android:layout_height="54dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_background"
        app:layout_constraintLeft_toLeftOf="@+id/avatar_background"
        app:layout_constraintRight_toRightOf="@+id/avatar_background"
        app:layout_constraintTop_toTopOf="@+id/avatar_background"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/avatar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_background"
        app:layout_constraintLeft_toLeftOf="@+id/avatar_background"
        app:layout_constraintRight_toRightOf="@+id/avatar_background"
        app:layout_constraintTop_toTopOf="@+id/avatar_background"
        app:placeholderImage="@drawable/ttlive_ic_hotsoon_avatar"
        app:riv_oval="true"
        app:roundAsCircle="true"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#404040"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="@+id/avatar_background"
        app:layout_constraintRight_toRightOf="@+id/avatar_background"
        app:layout_constraintTop_toBottomOf="@+id/avatar_background"/>
</androidx.constraintlayout.widget.ConstraintLayout>
