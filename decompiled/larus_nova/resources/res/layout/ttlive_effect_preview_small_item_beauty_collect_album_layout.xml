<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="74dp">
    <View
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="56dp"
        app:layout_constraintEnd_toStartOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/start_point"
        android:background="@drawable/ttlive_effect_sub_small_beauty_item_indicator"
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="26dp"
        android:layout_marginRight="20dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/sub_beauty_item_back"
        android:background="@drawable/ttlive_effect_sub_small_beauty_item_fold"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginLeft="20dp"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/start_point"
        app:layout_constraintStart_toEndOf="@+id/start_point"
        app:layout_constraintTop_toTopOf="@+id/start_point"/>
    <TextView
        android:textSize="11dp"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:id="@+id/sub_beauty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/sub_beauty_item_back"
        app:layout_constraintStart_toStartOf="@+id/sub_beauty_item_back"/>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="center_vertical"
        android:id="@+id/sub_beauty_list"
        android:layout_width="wrap_content"
        android:layout_height="74dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/sub_beauty_item_back"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:layout_gravity="center"
        android:background="@drawable/ttlive_effect_sub_small_beauty_item_indicator"
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/start_point"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/sub_beauty_list"
        app:layout_constraintTop_toTopOf="@+id/start_point"/>
</androidx.constraintlayout.widget.ConstraintLayout>
