<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/cj_pay_std_ui_dialog_layout"
    android:background="@drawable/cj_pay_bg_stdui_dialog"
    android:layout_width="@dimen/cj_pay_height_280"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/cj_pay_std_ui_dialog_close"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/cj_pay_icon_titlebar_left_close_noise_reduction"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/cj_pay_std_ui_dialog_icon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="32dp"
        android:src="@drawable/cj_pay_std_ui_dialog_icon_holder"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/cj_pay_color_black_161823"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/cj_pay_std_ui_dialog_title"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="标题最多两行标题最多两行标题最多两行标题最多两行标题最多两行标题最多两行"
        android:maxLines="2"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_std_ui_dialog_icon"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/cj_pay_std_ui_dialog_sub_title"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="说明当前状态、提示zz用户解决方案最好不要超过两行说明当前状态、提示zz用户解决方案最好不要超过两行"
        android:maxLines="2"
        android:lineSpacingExtra="3dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_std_ui_dialog_title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:id="@+id/cj_pay_std_ui_dialog_link_title_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_std_ui_dialog_sub_title">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/cj_pay_color_red_11"
                android:id="@+id/cj_pay_std_ui_dialog_link_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="240dp"
                android:text="功能入口样式"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/cj_pay_std_ui_dialog_link_title_arrow"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/cj_pay_std_ui_dialog_linktitle_arrow"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/cj_pay_std_ui_dialog_link_title"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.android.ttcjpaysdk.base.ui.component.dialog.FadingBottomScrollView
        android:id="@+id/cj_pay_std_ui_dialog_content_container"
        android:fadingEdgeLength="24dp"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:requiresFadingEdge="vertical"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_std_ui_dialog_link_title_container">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
            android:id="@+id/cj_pay_std_ui_dialog_content_text"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:text="超过 4 行的文本可以尝试左对齐，正文内容最高可显示 14 行文本，长文本内容可以上下滑动查看更"/>
    </com.android.ttcjpaysdk.base.ui.component.dialog.FadingBottomScrollView>
    <com.android.ttcjpaysdk.base.ui.component.agreement.CJPayAgreementView
        android:id="@+id/cj_pay_std_ui_dialog_agreement"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxWidth="240dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_std_ui_dialog_content_container"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cj_pay_std_ui_dialog_input_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxWidth="240dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_std_ui_dialog_agreement">
        <EditText
            android:textSize="14sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_100"
            android:textColorHint="@color/cj_pay_color_gray_161823_opacity_34"
            android:id="@+id/cj_pay_std_ui_dialog_input"
            android:background="@drawable/cj_pay_bg_stdui_dialog_input"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="240dp"
            android:layout_height="40dp"
            android:hint="输入内容"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/cj_pay_std_ui_dialog_input_delete"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="4dp"
            android:src="@drawable/cj_pay_std_ui_dialog_input_delete"
            app:layout_constraintBottom_toBottomOf="@+id/cj_pay_std_ui_dialog_input"
            app:layout_constraintRight_toRightOf="@+id/cj_pay_std_ui_dialog_input"
            app:layout_constraintTop_toTopOf="@+id/cj_pay_std_ui_dialog_input"/>
        <TextView
            android:textColor="@color/cj_pay_color_red_fe2c55"
            android:id="@+id/cj_pay_std_ui_dialog_input_tips"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="input hint"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cj_pay_std_ui_dialog_input"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cj_pay_std_ui_dialog_custom_area_container"
        android:visibility="gone"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_std_ui_dialog_input_container"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cj_pay_std_ui_dialog_btn_container"
        android:visibility="gone"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_std_ui_dialog_custom_area_container">
        <Button
            android:textSize="15sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_34"
            android:ellipsize="end"
            android:id="@+id/cj_pay_std_ui_dialog_secondary_btn"
            android:background="@drawable/cj_pay_bg_stdui_dialog_secondary_btn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginRight="4dp"
            android:text="secondary btn"
            android:maxLines="1"
            android:stateListAnimator="@null"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/cj_pay_std_ui_dialog_primary_btn"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginRight="0dp"/>
        <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
            android:textSize="15sp"
            android:textColor="@color/cj_pay_color_white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/cj_pay_std_ui_dialog_primary_btn"
            android:background="@drawable/cj_pay_bg_stdui_dialog_primary_btn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="4dp"
            android:text="primary btn"
            android:maxLines="1"
            android:stateListAnimator="@null"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toRightOf="@+id/cj_pay_std_ui_dialog_secondary_btn"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginLeft="0dp"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/cj_pay_std_ui_dialog_primary_btn_loading"
            android:background="@color/cj_pay_color_trans"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_white"
            android:indeterminateDuration="500"
            android:indeterminateBehavior="repeat"
            app:layout_constraintBottom_toBottomOf="@+id/cj_pay_std_ui_dialog_primary_btn"
            app:layout_constraintEnd_toEndOf="@+id/cj_pay_std_ui_dialog_primary_btn"
            app:layout_constraintStart_toStartOf="@+id/cj_pay_std_ui_dialog_primary_btn"
            app:layout_constraintTop_toTopOf="@+id/cj_pay_std_ui_dialog_primary_btn"/>
        <View
            android:id="@+id/cj_pay_std_ui_dialog_btn_left_divider"
            android:layout_width="0.5dp"
            android:layout_height="20dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cj_pay_std_ui_dialog_secondary_btn"/>
        <View
            android:id="@+id/cj_pay_std_ui_dialog_btn_right_divider"
            android:layout_width="0.5dp"
            android:layout_height="20dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cj_pay_std_ui_dialog_primary_btn"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cj_pay_std_ui_dialog_op_container"
        android:layout_width="280dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_std_ui_dialog_btn_container">
        <View
            android:id="@+id/cj_pay_std_ui_dialog_op_top_divider"
            android:background="@color/cj_pay_color_gray_161823_opacity_10"
            android:layout_width="0dp"
            android:layout_height="0.5dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
            android:gravity="center"
            android:id="@+id/cj_pay_std_ui_dialog_secondary_op_text"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="secondary op"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/cj_pay_std_ui_dialog_primary_op_text"
            app:layout_constraintTop_toTopOf="@+id/cj_pay_std_ui_dialog_op_top_divider"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/cj_pay_color_black_161823"
            android:gravity="center"
            android:id="@+id/cj_pay_std_ui_dialog_primary_op_text"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="primary op"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toRightOf="@+id/cj_pay_std_ui_dialog_secondary_op_text"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cj_pay_std_ui_dialog_op_top_divider"/>
        <View
            android:id="@+id/cj_pay_std_ui_dialog_op_divider"
            android:background="@color/cj_pay_color_gray_161823_opacity_10"
            android:layout_width="0.5dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
