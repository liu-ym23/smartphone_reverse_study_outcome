<?xml version="1.0" encoding="utf-8"?>
<com.larus.common_ui.widget.roundlayout.RoundConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:rv_backgroundColor="@color/larus_base_1_overlay"
    app:rv_cornerRadius_TL="?attr/larus_dp_16"
    app:rv_cornerRadius_TR="?attr/larus_dp_16">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/search_bar"
        android:background="@drawable/larus_bg_text_button"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_48"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_4"
        android:layout_marginRight="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_4"
        app:layout_constraintBottom_toTopOf="@+id/app_list_view"
        app:layout_constraintEnd_toStartOf="@+id/search_bar_cancel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <ImageView
            android:id="@+id/search_icon"
            android:layout_width="?attr/larus_dp_18"
            android:layout_height="?attr/larus_dp_18"
            android:src="@drawable/larus_icon_search"
            android:layout_marginStart="?attr/larus_dp_11"
            android:layout_marginEnd="?attr/larus_dp_5"/>
        <EditText
            android:textSize="?attr/larus_sp_17"
            android:gravity="center_vertical"
            android:id="@+id/search_input"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/larus_search"
            android:layout_weight="1"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:layout_marginEnd="?attr/larus_dp_14"
            style="@style/larus_EditTextStyle"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center_vertical"
        android:id="@+id/search_bar_cancel"
        android:paddingTop="?attr/larus_dp_12"
        android:paddingBottom="?attr/larus_dp_12"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_cancel"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/app_list_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/app_list_view"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingRight="?attr/larus_dp_16"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_bar"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/app_empty_view"
        android:background="@color/larus_base_1_overlay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_bar">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_112">
            <ImageView
                android:layout_width="?attr/larus_dp_32"
                android:layout_height="?attr/larus_dp_32"
                android:layout_marginBottom="?attr/larus_dp_20"
                android:src="@drawable/larus_icon_search"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/larus_neutral_100"
                android:id="@+id/app_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="?attr/larus_dp_4"
                android:text=""/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/larus_neutral_50"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_broadcast_no_search_results_desc_cn"/>
        </LinearLayout>
    </LinearLayout>
</com.larus.common_ui.widget.roundlayout.RoundConstraintLayout>
