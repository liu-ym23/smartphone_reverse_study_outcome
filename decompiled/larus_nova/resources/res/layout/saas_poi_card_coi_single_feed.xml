<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/outside_container"
    android:background="@color/POIBgPrimary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.locallife.poi.newdetail.widget.PoiRepeatTextureBgView
        android:id="@+id/texture_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="noHideDescendants"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <com.bytedance.locallife.dito.baseview.RoundFrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            app:rounded_radius="4dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.bytedance.locallife.poi.newdetail.component.feed.coi.PoiCoiImageView
                    android:id="@+id/poi_coi_single_feed_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <FrameLayout
                    android:id="@+id/live_cover_container"
                    android:background="@drawable/life_poi_rounded_gradient_boder"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.bytedance.locallife.poi.newdetail.component.feed.coi.PoiCoiImageView
                        android:id="@+id/poi_coi_single_feed_cover_live"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="3dp"
                        app:roundedCornerRadius="8dp"/>
                    <com.bytedance.locallife.dito.baseview.RoundLinearLayout
                        android:background="#57000000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="7dp"
                        android:layout_marginTop="7dp"
                        app:rounded_radius="2dp">
                        <com.bytedance.lighten.loader.SmartImageView
                            android:id="@+id/poi_coi_single_feed_tag_iv"
                            android:layout_width="14dp"
                            android:layout_height="14dp"/>
                        <com.bytedance.dux.text.DuxTextView
                            android:textSize="10dp"
                            android:textColor="#ffffff"
                            android:gravity="center"
                            android:id="@+id/poi_coi_single_feed_tag_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="直播中"
                            android:fontFamily="PingFang SC"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="4dp"/>
                    </com.bytedance.locallife.dito.baseview.RoundLinearLayout>
                </FrameLayout>
                <View
                    android:background="@color/POIBgPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <com.bytedance.dux.text.DuxTextView
                    android:textSize="8sp"
                    android:textColor="@color/POITextTertiaryDark"
                    android:id="@+id/poi_coi_single_feed_ad"
                    android:background="@drawable/poi_coi_img_cover_mask"
                    android:paddingLeft="2dp"
                    android:paddingTop="1dp"
                    android:paddingRight="2dp"
                    android:paddingBottom="1dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/poi_ad"
                    android:includeFontPadding="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.bytedance.locallife.dito.baseview.RoundFrameLayout>
        <com.bytedance.locallife.poi.newdetail.component.feed.coi.PoiCoiDynamicInfoView
            android:id="@+id/poi_coi_single_feed_info_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:minHeight="90dp"
            android:layout_marginStart="12dp"
            app:poiRankMarginTop="6dp"
            app:poiShowDistance="true"
            app:poiSupportFontScale="true"
            app:poiTagsMarginTop="6dp"/>
    </LinearLayout>
</FrameLayout>
