<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_carmodel_container"
    android:layout_width="match_parent"
    android:layout_height="45dp">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/iv_car_model_status"
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/shopping_std_text_black_1"
        android:id="@+id/tv_car_model_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/shopping_sku_optimize_car_model_add"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_car_model_status"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/shopping_std_text_black_1"
        android:ellipsize="end"
        android:id="@+id/tv_car_model_detail_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_car_model_status"
        app:layout_constraintStart_toEndOf="@+id/iv_car_model_status"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/shopping_std_text_black_1"
        android:id="@+id/tv_car_model_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_car_model_switch_model"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/shopping_std_text_black_3"
        android:id="@+id/tv_car_model_switch_model"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/shopping_tv_car_model_switch_model"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_car_model_right_arrow"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_car_model_right_arrow"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/shopping_sku_carmodel_forward"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_car_model_divider"
        android:background="#1f161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
