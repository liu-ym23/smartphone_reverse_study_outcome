<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ec.core.widget.RoundedLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/buy_and_comment_container"
    android:background="@drawable/shopping_feed_buy_and_comment_background"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/user_avatar_image"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginLeft="1dp"
        android:layout_marginTop="1dp"
        android:layout_marginRight="2dp"
        android:layout_marginBottom="1dp"
        app:cornerRadius="9dp"/>
    <TextView
        android:textSize="11dp"
        android:textStyle="normal"
        android:textColor="#ffffffff"
        android:gravity="center_vertical"
        android:id="@+id/user_name_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:maxLines="1"
        android:includeFontPadding="false"/>
    <TextView
        android:textSize="11dp"
        android:textStyle="normal"
        android:textColor="#ffffffff"
        android:gravity="center_vertical"
        android:id="@+id/buy_or_comment_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="2dp"
        android:layout_marginBottom="2dp"
        android:maxLines="1"
        android:includeFontPadding="false"/>
</com.bytedance.android.ec.core.widget.RoundedLinearLayout>
