<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ec.window.base.widget.ECWindowRoundedLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/store_product_card"
    android:background="@color/shopping_std_bg_primary_white"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:rounded_radius="6dp">
    <com.bytedance.android.ec.core.widget.RoundedRelativeLayout
        android:id="@+id/store_product_card_image_above"
        android:layout_width="136dp"
        android:layout_height="136dp">
        <com.bytedance.android.ec.core.widget.AspectRatioFrameLayout
            android:id="@+id/store_product_card_image_wrapper"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/store_product_card_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:placeholderImage="@color/ec_shop_product_placeholder_color"
                app:roundedCornerRadius="@dimen/ec_window_card_radius"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/window_product_card_image_mask"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:placeholderImage="@color/shopping_std_bg_black_1"
                app:roundedCornerRadius="@dimen/ec_window_card_radius"/>
            <FrameLayout
                android:id="@+id/ec_shop_tag_wrapper"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="bottom|center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/ec_shop_tag_watch_play_back"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginBottom="10dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">
                <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    app:layoutMode="width_self_adjust"
                    app:placeholderImage="@drawable/ec_shop_ic_inner_flow_play_back"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ec_shop_video_watch_explain"
                    android:paddingStart="1dp"/>
            </LinearLayout>
        </com.bytedance.android.ec.core.widget.AspectRatioFrameLayout>
    </com.bytedance.android.ec.core.widget.RoundedRelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="6dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="8dp"
        android:paddingEnd="0dp">
        <com.bytedance.android.ec.window.base.widget.WindowBreakWordTextView
            android:textSize="14dp"
            android:textColor="@color/shopping_std_text_black_1"
            android:ellipsize="end"
            android:id="@+id/store_product_card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ec_window_sub_text_color"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/store_product_card_recommend_info"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:singleLine="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/store_product_card_title"/>
        <FrameLayout
            android:id="@+id/window_product_card_recommend_area"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/store_product_card_title"/>
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:layout_constraintBottom_toTopOf="@+id/window_product_card_price_area"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            layout="@layout/ec_window_product_card_info_taglist"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="bottom"
            android:id="@+id/window_product_card_price_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <com.bytedance.android.ec.core.widget.price.PriceView
                android:textSize="17sp"
                android:ellipsize="end"
                android:id="@+id/store_product_card_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:lineSpacingExtra="2dp"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:pv_hideYuanSymbol="false"
                app:pv_prefixMarginRight="4dp"
                app:pv_prefixTextBold="false"
                app:pv_prefixTextColor="@color/ec_shop_FF1C49"
                app:pv_prefixTextSizeRatio="0.647"
                app:pv_priceBold="true"
                app:pv_priceTextColor="@color/ec_shop_FF1C49"
                app:pv_yuanSymbolBold="false"
                app:pv_yuanSymbolMarginRight="1dp"
                app:pv_yuanSymbolRatioOfPriceTextSize="0.764"/>
            <com.bytedance.android.window.shop.widget.ECWindowOriginPriceView
                android:textSize="12dp"
                android:textColor="@color/ec_shop_34161823"
                android:id="@+id/window_product_card_price_origin_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/store_product_card_price"
                app:layout_constraintStart_toEndOf="@+id/store_product_card_price"/>
            <TextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/window_product_card_to_buy"
                android:background="@drawable/ec_window_bg_hotsale_same_price_product"
                android:layout_width="60dp"
                android:layout_height="28dp"
                android:text="@string/ec_window_go_to_buy"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="11dp"
            android:textStyle="bold"
            android:textColor="@color/ec_window_common_red"
            android:ellipsize="end"
            android:id="@+id/window_product_card_tag_elements"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:maxLines="1"
            app:layout_constraintBottom_toTopOf="@+id/window_product_card_price_area"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.bytedance.android.ec.window.base.widget.ECWindowRoundedLinearLayout>
