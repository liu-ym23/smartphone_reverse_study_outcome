<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/save_picture_btn"
        android:background="@drawable/larus_bg_avatar_action_ai"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/larus_neutral_100"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_music_save"/>
    </FrameLayout>
    <View
        android:background="@color/larus_base_4_overlay"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_8"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/cancel_btn"
        android:background="@drawable/larus_bg_avatar_action_btn"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/larus_neutral_100"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_key_regenerate_double_confirm_cancel"/>
    </LinearLayout>
</LinearLayout>
