<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/ec_comment_rank_dialog_layout_691597589"
    android:background="@drawable/commerce_bg_comment_rank_dialog"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/shopping_color_161823"
        android:layout_gravity="center"
        android:id="@+id/ec_comment_tv_rank_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/commerce_color_BF161823"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/ec_comment_tv_rank_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="20dp"/>
    <View
        android:background="@color/shopping_color_1F161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="24dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/commerce_color_BF161823"
            android:gravity="center"
            android:id="@+id/ec_comment_rank_dialog_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/shopping_cancel_tip"
            android:layout_weight="1"/>
        <View
            android:background="@color/shopping_color_1F161823"
            android:layout_width="0.5dp"
            android:layout_height="48dp"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/shopping_color_161823"
            android:gravity="center"
            android:id="@+id/ec_comment_rank_dialog_confirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/shopping_go_detail_tip"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
