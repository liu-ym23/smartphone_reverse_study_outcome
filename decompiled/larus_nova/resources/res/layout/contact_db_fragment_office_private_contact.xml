<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/flow_ud_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.lark.contact.customized.common.view.ContactOfficeTitleBar
        android:id="@+id/title_bar"
        android:background="@color/color_transparent"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:rightIcon="@drawable/contact_db_add_friends"
        app:title="@string/Lark_Legacy_StructureExternal"/>
    <FrameLayout
        android:id="@+id/private_contact_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
