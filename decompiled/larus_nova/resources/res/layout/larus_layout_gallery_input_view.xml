<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gallery_input"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/input"
        android:background="@drawable/larus_bg_camera_input_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ViewStub
            android:id="@+id/input_delegate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <com.larus.asr.view.ChatSpeaker
        android:layout_gravity="bottom"
        android:id="@+id/speaker"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_12"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/local_media_bottom_container"
        android:paddingTop="?attr/larus_dp_11"
        android:paddingBottom="?attr/larus_dp_12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?attr/larus_dp_12"
        android:paddingEnd="?attr/larus_dp_12">
        <com.larus.bmhome.bigimg.download.CommonDownLoadLayout
            android:id="@+id/local_media_save_button"
            android:background="@drawable/larus_bg_big_image_icon3"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:contentDescription="@string/larus_accessibility_save"
            app:larus_showText="true"/>
    </FrameLayout>
</FrameLayout>
