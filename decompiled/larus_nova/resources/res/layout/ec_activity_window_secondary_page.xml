<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#f4f5f5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@color/ec_store_window_background"
        android:layout_width="match_parent"
        android:layout_height="307dp"/>
    <View
        android:id="@+id/ec_window_secondary_page_head_skeleton"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/ec_window_secondary_page_head_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="26dp"/>
    <FrameLayout
        android:id="@+id/ec_window_secondary_page_head_container"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/status_bar"/>
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/ec_window_tab_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ec_window_secondary_page_head_container">
        <View
            android:id="@+id/ec_window_secondary_page_skeleton"
            android:background="@drawable/ec_window_skeleton_secondary_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/ec_shop_float_cart_entry_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="14dp"
        android:layout_marginBottom="98dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <FrameLayout
        android:id="@+id/ec_shop_float_go_top_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="14dp"
        android:layout_marginBottom="44dp"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
