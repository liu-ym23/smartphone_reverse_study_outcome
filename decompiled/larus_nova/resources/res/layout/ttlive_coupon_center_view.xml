<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/happy_lottie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"/>
    <RelativeLayout
        android:gravity="center_horizontal"
        android:id="@+id/center_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <RelativeLayout
            android:gravity="center_horizontal"
            android:id="@+id/top_view"
            android:layout_width="wrap_content"
            android:layout_height="250dp"
            android:layout_centerInParent="true">
            <ImageView
                android:id="@+id/behind_view"
                android:layout_width="240dp"
                android:layout_height="127dp"
                android:layout_marginBottom="30dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
            <ImageView
                android:id="@+id/double_coupon"
                android:layout_width="240dp"
                android:layout_height="127dp"
                android:layout_marginBottom="106dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
            <FrameLayout
                android:id="@+id/real_coupon_container"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/double_coupon_lottie"
                android:layout_width="267dp"
                android:layout_height="241dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
            <RelativeLayout
                android:id="@+id/bottom_layout"
                android:layout_width="240dp"
                android:layout_height="127dp"
                android:layout_marginBottom="16dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true">
                <ImageView
                    android:id="@+id/front_view"
                    android:layout_width="260dp"
                    android:layout_height="127dp"/>
                <TextView
                    android:textSize="16dp"
                    android:textColor="#ffffff"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/desc_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/ttlive_live_player_send_coupon"
                    android:layout_above="@+id/try_get_coupon"
                    android:layout_centerHorizontal="true"
                    android:alpha="0.5"/>
                <TextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="#ff6249"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/try_get_coupon"
                    android:background="@drawable/ttlive_bottom_coupon_button_gb"
                    android:layout_width="140dp"
                    android:layout_height="30dp"
                    android:layout_marginBottom="30dp"
                    android:text="@string/ttlive_live_try_get_coupon"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
        </RelativeLayout>
        <ImageView
            android:id="@+id/close_view"
            android:background="@drawable/ttlive_coupon_close_view"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="36dp"
            android:layout_below="@+id/top_view"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</RelativeLayout>
