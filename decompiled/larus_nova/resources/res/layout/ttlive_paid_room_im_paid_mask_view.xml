<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ttlive_black_40"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/im_mask_bg_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/im_mask_blur_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/im_mask_blur_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <FrameLayout
        android:background="@drawable/ttlive_bg_paid_room_im_mask"
        android:layout_width="match_parent"
        android:layout_height="168dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:layout_gravity="center_horizontal"
                android:id="@+id/im_mask_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_live_paid_live_temp_watch_end"
                android:lineSpacingExtra="2dp"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#7fffffff"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/im_mask_desc"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ttlive_live_pay_get_share_ticket_desc"
                android:lineSpacingExtra="2dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/im_buy_ticket_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:textSize="13dp"
                android:textColor="#bfffffff"
                android:gravity="center"
                android:id="@+id/im_buy_ticket_desc"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="@string/ttlive_live_paid_live_click_to_buy"
                android:lineSpacingExtra="2dp"/>
            <ImageView
                android:background="@drawable/ttlive_icon_right_arrow_grey"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="5dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
