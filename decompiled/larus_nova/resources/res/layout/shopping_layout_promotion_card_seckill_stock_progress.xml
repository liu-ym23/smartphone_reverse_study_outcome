<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ProgressBar
        android:id="@+id/ec_progressbar_seckill_stock_progress"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/ec_stock_progress_layer_list_2"
        style="?android:attr/progressBarStyleHorizontal"/>
    <ImageView
        android:id="@+id/ec_bg_seckill_stock_progress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:src="@color/transparent"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/shopping_std_text_black_4"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/ec_ic_seckill_stock_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:layout_marginEnd="8dp"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/ec_color_white"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/ec_tv_seckill_progress_des"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginStart="8dp"/>
    <com.bytedance.android.livesdk.livecommerce.promotion.card.view.ECNewCountDownView
        android:textColor="@color/shopping_std_text_white_1"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/new_countdown_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginStart="4dp"
        style="@style/font_size_20"/>
</merge>
