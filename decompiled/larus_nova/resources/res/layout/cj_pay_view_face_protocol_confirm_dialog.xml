<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/cj_pay_face_dialog_protocol_container"
        android:background="@drawable/cj_pay_bg_common_dialog_radius_12"
        android:paddingLeft="@dimen/cj_pay_padding_20"
        android:paddingRight="@dimen/cj_pay_padding_20"
        android:layout_width="@dimen/cj_pay_height_280"
        android:layout_height="wrap_content">
        <com.android.ttcjpaysdk.base.ui.widget.CJPayBoldTextView
            android:textSize="?attr/cj_pay_page_size_17"
            android:textStyle="bold"
            android:textColor="@color/cj_pay_color_black_161823"
            android:id="@+id/cj_pay_face_dialog_protocol_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cj_pay_padding_24"
            style="@style/CJPayShadowTextStyle"/>
        <com.android.ttcjpaysdk.base.ui.widget.CJPayBoldTextView
            android:textSize="?attr/cj_pay_page_size_13"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
            android:gravity="center"
            android:id="@+id/cj_pay_face_dialog_protocol_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2.5dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cj_pay_padding_24">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/cj_pay_color_white"
                android:gravity="center"
                android:id="@+id/cj_pay_face_dialog_agree_and_continue"
                android:background="@drawable/cj_pay_bg_face_guide_red_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cj_pay_custom_button_height_44"
                android:text="@string/cj_pay_face_guide_protocol_confirm_dialog_continue"
                android:includeFontPadding="false"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/cj_pay_face_dialog_agree_and_continue_loading"
                android:background="@color/cj_pay_color_trans"
                android:visibility="gone"
                android:layout_width="@dimen/cj_pay_padding_20"
                android:layout_height="@dimen/cj_pay_padding_20"
                android:indeterminateOnly="true"
                android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_white"
                android:indeterminateDuration="500"
                android:indeterminateBehavior="repeat"/>
        </FrameLayout>
        <TextView
            android:textSize="?attr/cj_pay_page_size_13"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
            android:id="@+id/cj_pay_face_dialog_disagree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cj_pay_padding_13"
            android:layout_marginBottom="@dimen/cj_pay_padding_13"
            android:text="@string/cj_pay_face_guide_protocol_confirm_dialog_disagree"/>
    </LinearLayout>
</FrameLayout>
