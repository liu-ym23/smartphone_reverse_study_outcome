<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/card_template"
        android:background="@color/larus_base_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="?attr/larus_dp_8"
        app:cardElevation="-4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/larus_slides_bg_ppt_template_item_border"
            android:padding="?attr/larus_dp_0_5"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/iv_template_preview"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_99"
                app:actualImageScaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImage="@drawable/larus_slides_place_holder_ppt_template"
                app:placeholderImageScaleType="centerCrop"
                app:roundedCornerRadius="?attr/larus_dp_8"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/cb_template_select"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_26"
                android:layout_height="?attr/larus_dp_26"
                android:src="@drawable/larus_slides_ppt_template_checked"
                app:layout_constraintEnd_toEndOf="@+id/iv_template_preview"
                app:layout_constraintTop_toTopOf="@+id/iv_template_preview"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_12"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/tv_template_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_8"
        android:layout_marginTop="?attr/larus_dp_6"
        android:layout_marginRight="?attr/larus_dp_8"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"/>
</LinearLayout>
