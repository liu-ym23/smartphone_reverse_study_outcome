<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/cj_pay_sms_code_root_view"
    android:background="@drawable/cj_pay_bg_fragment_container_blackable"
    android:layout_width="match_parent"
    android:layout_height="560dp">
    <include
        android:id="@+id/cj_pay_titlebar_root_view"
        layout="@layout/cj_pay_view_titlebar_noise_reduction_layout"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/cj_pay_sms_code_pay_info"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/cj_pay_titlebar_root_view">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/cj_pay_color_black_161823"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/cj_pay_sms_order_info"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cj_pay_padding_24"
            android:layout_marginRight="@dimen/cj_pay_padding_24"
            android:singleLine="true"
            android:includeFontPadding="false"/>
        <include
            android:id="@+id/cj_pay_view_verify_amount_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            layout="@layout/cj_pay_view_verify_amount_layout"/>
        <include
            android:id="@+id/cj_unify_amount_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/cj_pay_amount_view_layout"/>
        <include
            android:id="@+id/cj_pay_view_verify_discount_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            layout="@layout/cj_pay_view_verify_discount_layout"/>
        <com.android.ttcjpaysdk.thirdparty.verify.view.marketing.CJMarketingCountdownView
            android:id="@+id/cj_pay_marketing_countdown_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <include
            android:id="@+id/cj_unify_voucher_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4.5dp"
            android:layout_marginBottom="8dp"
            android:minHeight="@dimen/cj_pay_padding_20"
            layout="@layout/cj_pay_voucher_layout"/>
        <View
            android:id="@+id/pay_type_helper_layout_divider_line"
            android:background="?attr/cj_pay_border_divider_grey_color"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="16dp"
            app:layout_goneMarginTop="8dp"/>
        <include
            android:id="@+id/cj_pay_view_pay_type_combine_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            layout="@layout/cj_pay_view_pay_type_combine_layout"/>
    </LinearLayout>
    <View
        android:id="@+id/cj_pay_bankcard_point_place_holder"
        android:background="#00000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_below="@+id/cj_pay_sms_code_pay_info"/>
    <com.android.ttcjpaysdk.base.ui.component.input.CJSmsCodeInputLayout
        android:id="@+id/cj_pay_layout_sms_code_input_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cj_pay_padding_24"
        android:layout_below="@+id/cj_pay_bankcard_point_place_holder"
        android:layout_alignWithParentIfMissing="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="?attr/cj_pay_text_tertiary"
        android:id="@+id/cj_pay_sms_code_sent_tip"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cj_pay_padding_24"
        android:text="@string/cj_pay_sms_code_sent_tip"
        android:includeFontPadding="false"
        android:layout_below="@+id/cj_pay_bankcard_point_place_holder"
        android:layout_centerHorizontal="true"
        android:layout_alignWithParentIfMissing="true"/>
    <com.android.ttcjpaysdk.base.ui.CJPayAutoAlignmentTextView
        android:textSize="12sp"
        android:textColor="@color/cj_pay_color_red_fe3824"
        android:id="@+id/cj_pay_sms_code_input_error_tip"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cj_pay_padding_24"
        android:includeFontPadding="false"
        android:layout_below="@+id/cj_pay_sms_code_pay_info"
        android:layout_centerHorizontal="true"/>
    <FrameLayout
        android:id="@+id/cj_pay_verification_code_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_16_with_half"
        android:layout_marginRight="@dimen/cj_pay_padding_16_with_half"
        android:layout_below="@+id/cj_pay_sms_code_sent_tip"
        android:layout_centerHorizontal="true">
        <com.android.ttcjpaysdk.base.ui.component.input.CJSmsCodeInputView
            android:id="@+id/cj_pay_new_verification_code_edit_view"
            android:visibility="visible"
            style="@style/CJ_Pay_New_Verification_Code_Style_Opt"/>
    </FrameLayout>
    <include
        android:id="@+id/cj_pay_agreement_old_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/cj_pay_verification_code_layout"
        android:layout_alignStart="@+id/cj_pay_new_verification_code_edit_view"
        layout="@layout/cj_pay_view_agreement_container"/>
    <TextView
        android:textSize="12sp"
        android:textColor="?attr/cj_pay_text_link_default"
        android:gravity="center_horizontal"
        android:id="@+id/cj_pay_acquire_sms_code"
        android:paddingTop="@dimen/cj_pay_padding_12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cj_pay_reacquire_sms_code_enable_tip"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:layout_below="@+id/cj_pay_verification_code_layout"
        android:layout_centerHorizontal="true"/>
    <com.android.ttcjpaysdk.base.ui.component.agreement.CJRowSwitchText
        android:id="@+id/cj_pay_bank_card_points_open"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:layout_below="@+id/cj_pay_layout_sms_code_input_layout"
        android:layout_centerHorizontal="true"
        app:CJRowSwitchChecked="false"
        app:CJRowSwitchContent=""
        app:CJRowSwitchContentSize="12sp"/>
    <include layout="@layout/cj_pay_view_custom_keyboard_layout"/>
    <include layout="@layout/cj_pay_view_half_screen_loading_layout"/>
    <include
        android:id="@+id/cj_pay_security_panel_loading_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/cj_pay_titlebar_root_view"
        layout="@layout/cj_pay_view_security_panel_loading_container"/>
</RelativeLayout>
