<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/layout_root_view"
    android:background="@color/cj_pay_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/cj_pay_view_standard_titlebar_layout"/>
    <TextView
        android:textSize="@dimen/cj_pay_font_size_24"
        android:textStyle="bold"
        android:textColor="@color/cj_pay_color_black_34"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_24"
        android:layout_marginTop="@dimen/cj_pay_padding_24"
        android:text="@string/cj_pay_verification_real_name"
        android:includeFontPadding="false"
        android:layout_below="@+id/cj_pay_titlebar_layout"/>
    <TextView
        android:textSize="@dimen/cj_pay_font_size_13"
        android:textColor="#999999"
        android:id="@+id/tv_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_24"
        android:layout_marginTop="@dimen/cj_pay_padding_8"
        android:layout_marginRight="@dimen/cj_pay_padding_24"
        android:layout_marginBottom="@dimen/cj_pay_padding_16"
        android:text="@string/cj_pay_verification_real_name_tips"
        android:includeFontPadding="false"
        android:layout_below="@+id/tv_title"/>
    <LinearLayout
        android:id="@+id/layout_card_input"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_tips">
        <include
            android:id="@+id/ll_bank_card_container"
            android:layout_width="match_parent"
            android:layout_height="69dp"
            android:layout_marginLeft="@dimen/cj_pay_padding_24"
            android:layout_marginRight="@dimen/cj_pay_padding_24"
            layout="@layout/cj_pay_item_basic_input_box"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/layout_next_step"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/layout_card_input">
        <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
            android:textSize="@dimen/cj_pay_font_size_17"
            android:textColor="@color/cj_pay_color_white"
            android:gravity="center"
            android:id="@+id/tv_next_step"
            android:background="@drawable/cj_pay_bg_red_btn_opacity_40"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_custom_button_height_44"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="24dp"
            android:text="@string/cj_pay_verify"
            android:includeFontPadding="false"/>
        <ProgressBar
            android:id="@+id/iv_loading"
            android:background="@color/cj_pay_color_trans"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="38dp"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_white"
            android:indeterminateDuration="500"
            android:indeterminateBehavior="repeat"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <com.android.ttcjpaysdk.base.ui.widget.CJPayKeyboardView
        android:id="@+id/cj_pay_keyboard_view"
        android:visibility="gone"
        android:layout_alignParentBottom="true"
        android:keepScreenOn="true"
        style="@style/CJ_Pay_Keyboard"/>
</RelativeLayout>
