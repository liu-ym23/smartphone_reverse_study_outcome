<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/facade_round_top_xxl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/bg_float_base">
    <com.bytedance.ee.bear.widgets.BaseTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:widget_widgets_tb_back_icon="@drawable/ud_icon_close_small_outlined"
        app:widget_widgets_tb_background="@color/color_transparent"
        app:widget_widgets_tb_divider_height="@dimen/ud_divider_size"
        app:widget_widgets_tb_divider_visible="true"
        app:widget_widgets_tb_title="@string/CreationMobile_SecureLabel_Edit_ModifyTitle"/>
    <RelativeLayout
        android:id="@+id/rl_loading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.ee.bear.facade.common.widget.BearLottieView
            android:layout_gravity="center"
            android:id="@+id/loadingView"
            android:layout_marginTop="94dp"
            android:layout_marginBottom="113dp"
            android:layout_centerInParent="true"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/loading_anim"
            style="@style/BearLottieView"/>
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/ns_perm_input_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedance.ee.bear.middleground.permission.secret.TipsNotice
                android:id="@+id/bannerWarnTipsLayout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                app:layout_constraintTop_toBottomOf="@+id/bannerTipsLayout2"
                app:layout_goneMarginTop="8dp"
                app:ud_notice_backgroundColor="@color/function_warning_fill_solid_01"
                app:ud_notice_icon="@drawable/ud_icon_warning_hollow_filled"
                app:ud_radius="m"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_title"
                android:id="@+id/download_msg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/CreationMobile_SecureLabel_Edit_ModifySubtitle"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/avatar_layout"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="8dp">
                <include
                    android:id="@+id/avatar_one"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    layout="@layout/perm_vartar_layout"/>
                <include
                    android:id="@+id/avatar_two"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    layout="@layout/perm_vartar_layout"/>
                <include
                    android:id="@+id/avatar_three"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    layout="@layout/perm_vartar_layout"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/input_container"
                android:background="@drawable/facade_round_around_l"
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:backgroundTint="@color/facade_selector_item_float">
                <com.bytedance.ee.bear.widgets.universedesign.SpaceEditText
                    android:textSize="16sp"
                    android:textColor="@color/text_title"
                    android:textColorHint="@color/text_placeholder"
                    android:gravity="top"
                    android:id="@+id/input"
                    android:scrollbars="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:hint="@string/CreationMobile_SecureLabel_Edit_ModifyDesc"
                    android:maxLines="5"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintBottom_toTopOf="@+id/notificationBottomLayout"
                    app:layout_constraintTop_toBottomOf="@+id/divider2"
                    style="@style/UDEditText"/>
            </FrameLayout>
            <com.larksuite.component.universe_design.notice.UDNotice
                android:id="@+id/bannerTipsLayout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                app:layout_constraintTop_toBottomOf="@+id/bannerTipsLayout2"
                app:layout_goneMarginTop="8dp"
                app:ud_notice_backgroundColor="@color/fill_selected"
                app:ud_notice_icon="@drawable/ud_icon_warning_hollow_filled"
                app:ud_radius="m"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp">
                <com.larksuite.component.universe_design.button.UDButton
                    android:textSize="16sp"
                    android:textColor="@color/text_title"
                    android:id="@+id/cancelBtn"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:text="@string/Doc_Facade_Cancel"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    app:ud_backgroundColor="@color/ud_button_white_blue_bg"
                    app:ud_radius="l"
                    app:ud_strokeColor="@color/line_border_component"
                    app:ud_strokeWidth="1dp"
                    style="@style/UDButton.Small.Primary"/>
                <com.larksuite.component.universe_design.button.UDButton
                    android:enabled="false"
                    android:textSize="16sp"
                    android:textColor="@color/static_white"
                    android:id="@+id/doneBtn"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:text="@string/Bitable_Form_Submit"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="16dp"
                    app:ud_backgroundColor="@color/ud_button_blue_bg"
                    app:ud_radius="l"
                    style="@style/UDButton.Small.Primary"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
