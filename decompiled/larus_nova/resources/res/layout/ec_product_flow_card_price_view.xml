<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.bytedance.android.ec.core.widget.PriceView
        android:id="@+id/normal_text_min_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:extraTextColor="@color/shopping_color_FE496A"
        app:extraTextSize="13sp"
        app:prefixSpaceSize="2dp"
        app:prefixTextSize="13sp"
        app:priceBold="true"
        app:priceDecimalTextSize="16sp"
        app:priceTextColor="@color/shopping_color_FE496A"
        app:priceTextSize="24sp"
        app:spaceSize="1sp"
        app:thinDecimal="true"
        app:yangTextSize="16sp"/>
    <com.bytedance.android.ec.core.widget.PriceView
        android:id="@+id/normal_text_market_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginBottom="2dp"
        android:layout_toRightOf="@+id/normal_text_min_price"
        android:layout_alignBottom="@+id/normal_text_min_price"
        android:layout_marginStart="8dp"
        android:layout_toEndOf="@+id/normal_text_min_price"
        app:extraTextColor="@color/commerce_color_57161823"
        app:extraTextSize="12sp"
        app:prefixSpaceSize="2dp"
        app:priceTextColor="@color/commerce_color_57161823"
        app:priceTextSize="12sp"
        app:showDeleteLine="true"
        app:spaceSize="1dp"
        app:yangTextSize="12sp"/>
    <include
        android:id="@+id/container_discount_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_toRightOf="@+id/normal_text_min_price"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/normal_text_min_price"
        layout="@layout/ec_product_flow_red_discount_view"/>
</RelativeLayout>
