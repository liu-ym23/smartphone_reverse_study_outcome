<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/action_divider"
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="47dp">
        <androidx.constraintlayout.widget.ConstraintLayout xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/send_gift_container"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/send_gift_btn_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/send_gift_left_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ttlive_link_guest_send_gift_icon"
                    app:layout_constraintBottom_toBottomOf="@+id/send_gift"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/send_gift"/>
                <TextView
                    android:textSize="15dp"
                    android:textStyle="bold"
                    android:textColor="@color/ttlive_user_card_common_red"
                    android:id="@+id/send_gift"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_send_gift"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/send_gift_left_icon"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ttlive_profile_action_item_divider"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textColor="@color/ttlive_core_hs_s27"
            android:id="@+id/go_to_live_room"
            android:visibility="gone"
            android:layout_height="match_parent"
            android:text="@string/ttlive_live_profile_go_to_live_room"
            android:drawableRight="@drawable/ttlive_profile_action_item_divider"
            android:drawableEnd="@drawable/ttlive_profile_action_item_divider"
            style="@style/ttlive_profile_action_item"/>
        <TextView
            android:textColor="@color/ttlive_user_card_common_red"
            android:id="@+id/follow"
            android:layout_height="match_parent"
            android:text="@string/ttlive_live_profile_follow"
            android:drawableRight="@drawable/ttlive_profile_action_item_divider"
            android:drawableEnd="@drawable/ttlive_profile_action_item_divider"
            style="@style/ttlive_profile_action_item"/>
        <TextView
            android:textColor="@color/ttlive_core_hs_g3"
            android:id="@+id/followed"
            android:layout_height="match_parent"
            android:text="@string/ttlive_live_profile_followed"
            android:drawableRight="@drawable/ttlive_profile_action_item_divider"
            android:drawableEnd="@drawable/ttlive_profile_action_item_divider"
            style="@style/ttlive_profile_action_item"/>
        <TextView
            android:textColor="@color/ttlive_core_hs_s27"
            android:gravity="center"
            android:id="@+id/fans_group"
            android:visibility="gone"
            android:layout_height="match_parent"
            android:text="@string/ttlive_live_profile_fans_group"
            android:drawableRight="@drawable/ttlive_profile_action_item_divider"
            android:drawableEnd="@drawable/ttlive_profile_action_item_divider"
            style="@style/ttlive_profile_action_item"/>
        <TextView
            android:textColor="@color/ttlive_core_hs_s27"
            android:gravity="center"
            android:id="@+id/wgame_invite"
            android:visibility="gone"
            android:layout_height="match_parent"
            android:drawableRight="@drawable/ttlive_profile_action_item_divider"
            android:drawableEnd="@drawable/ttlive_profile_action_item_divider"
            style="@style/ttlive_profile_action_item"/>
        <TextView
            android:textColor="@color/ttlive_core_hs_s27"
            android:gravity="center"
            android:id="@+id/at"
            android:layout_height="match_parent"
            android:text="@string/ttlive_live_profile_at"
            android:drawableRight="@drawable/ttlive_profile_action_item_divider"
            android:drawableEnd="@drawable/ttlive_profile_action_item_divider"
            style="@style/ttlive_profile_action_item"/>
        <TextView
            android:textColor="@color/ttlive_core_hs_s27"
            android:id="@+id/home_page"
            android:layout_height="match_parent"
            android:text="@string/ttlive_home_page"
            style="@style/ttlive_profile_action_item"/>
        <TextView
            android:textColor="@color/ttlive_core_hs_s27"
            android:id="@+id/interact_invte"
            android:visibility="gone"
            android:layout_height="match_parent"
            android:text="@string/ttlive_profile_interact_invite"
            style="@style/ttlive_profile_action_item"/>
        <RelativeLayout
            android:id="@+id/ec_splash_entry_container"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="15dp"
                android:textColor="@color/ttlive_core_hs_s27"
                android:id="@+id/interact_ec_directed_splash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_profile_ec_directed_flash"
                android:layout_centerInParent="true"/>
            <ImageView
                android:id="@+id/interact_ec_directed_splash_red_dot"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ttlive_decoration_red_dot"
                android:layout_toRightOf="@+id/interact_ec_directed_splash"
                android:layout_alignTop="@+id/interact_ec_directed_splash"
                android:layout_toEndOf="@+id/interact_ec_directed_splash"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
