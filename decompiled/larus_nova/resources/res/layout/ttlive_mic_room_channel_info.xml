<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/anchor_info_container"
        android:background="@drawable/ttlive_bg_user_layout"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp">
        <com.bytedance.android.livesdk.widget.VHeadView
            android:id="@+id/head"
            android:background="@drawable/ttlive_bg_circle_head"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="2dp"
            android:scaleType="fitXY"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.android.live.core.view.MaxWidthLinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/name_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="8dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/right_layout"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_default="wrap">
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/ttlive_white"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginRight="12dp"
                    android:maxEms="6"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:shadowDy="1"
                    android:shadowRadius="1"
                    android:drawablePadding="2dp"
                    android:lineSpacingExtra="0.5dp"/>
                <com.bytedance.android.livesdk.common.MinMaxWidthLinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/new_only_user_name_layout"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginRight="12dp">
                    <com.bytedance.android.livesdk.common.MarqueeTextView
                        android:id="@+id/new_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <com.bytedance.android.live.core.widget.HSImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/new_anchor_verify"
                        android:visibility="gone"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginLeft="2dp"/>
                </com.bytedance.android.livesdk.common.MinMaxWidthLinearLayout>
                <TextView
                    android:textSize="10dp"
                    android:textColor="@color/ttlive_core_hs_w1_transparent_70"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/channel_description"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:layout_marginRight="12dp"
                    android:maxEms="11"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
            </com.bytedance.android.live.core.view.MaxWidthLinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/follow_parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp">
            <com.bytedance.android.live.core.widget.FitTextView
                android:textSize="13dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/follow"
                android:background="@drawable/ttlive_bg_mic_room_office_follow"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="28dp"
                android:text="@string/ttlive_follow_label"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
