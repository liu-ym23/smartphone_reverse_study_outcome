<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ttlive_broadcast_toolbar_pk"
    android:layout_width="36dp"
    android:layout_height="36dp"
    android:layout_marginLeft="8dp"
    android:layout_marginStart="8dp">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/iv_pk_bak"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/iv_pk"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/iv_pk_logo"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_pk_match_ring"
        android:background="@drawable/ttlive_bg_random_pk_alpha"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        fresco:actualImageScaleType="fitXY"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_pk_match_point"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="2dp"
        fresco:actualImageScaleType="fitXY"/>
    <TextView
        android:textSize="20dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_count"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:layout_gravity="end"
        android:id="@+id/view_red_dot"
        android:background="@drawable/ttlive_ic_filter_red_point"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="2dp"
        android:layout_marginEnd="2dp"/>
</FrameLayout>
