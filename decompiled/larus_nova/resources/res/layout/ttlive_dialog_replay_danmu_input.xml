<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/content_creator"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="end|bottom"
                android:id="@+id/btn_send"
                android:visibility="gone"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:layout_marginTop="4dp"
                android:layout_marginRight="15dp"
                android:layout_marginBottom="11dp"
                android:src="@drawable/ttlive_ic_vs_danmu_send"
                android:layout_marginEnd="15dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/content_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/editor_container"
                    android:background="@drawable/ttlive_bg_vs_danmaku_input"
                    android:paddingLeft="12dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginRight="12dp"
                    android:layout_marginBottom="6dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="12dp">
                    <com.bytedance.android.live.core.widget.HSImageView
                        android:id="@+id/charactor_head"
                        android:visibility="gone"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="2dp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:roundAsCircle="true"
                        app:roundingBorderColor="#161823"
                        app:roundingBorderWidth="0.5dp"/>
                    <com.bytedance.android.livesdk.chatroom.replay.interactionmsg.danmaku.send.view.StablePrefixGradientEditText
                        android:textSize="14dp"
                        android:textColor="@color/ttlive_vs_danmaku_input_color"
                        android:textColorHint="@color/ttlive_vs_danmaku_input_hint_color"
                        android:gravity="start|center_vertical"
                        android:id="@+id/danmu_editor"
                        android:background="@null"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_marginRight="16dp"
                        android:maxHeight="60dp"
                        android:minHeight="22dp"
                        android:hint="@string/ttlive_vs_danmaku_send_input_hint"
                        android:singleLine="false"
                        android:includeFontPadding="false"
                        android:lineSpacingMultiplier="1.3"
                        android:inputType="textMultiLine"
                        android:imeOptions="flagNoExtractUi|actionSend"
                        android:textCursorDrawable="@drawable/ttlive_bg_vs_danmu_edit_text_cursor_drawable"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toRightOf="@+id/charactor_head"
                        app:layout_constraintRight_toLeftOf="@+id/ttlive_vs_input_hashtag"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_goneMarginLeft="0dp"/>
                    <ImageView
                        android:id="@+id/ttlive_vs_input_hashtag"
                        android:visibility="gone"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginRight="17dp"
                        android:src="@drawable/ttlive_ic_vs_input_hashtag"
                        android:layout_marginEnd="17dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintRight_toLeftOf="@+id/ttlive_vs_input_at"/>
                    <ImageView
                        android:id="@+id/ttlive_vs_input_at"
                        android:visibility="gone"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginRight="17dp"
                        android:src="@drawable/ttlive_vs_ic_comment_input_at"
                        android:layout_marginEnd="17dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintRight_toLeftOf="@+id/btn_danmaku_emoji"/>
                    <ImageView
                        android:id="@+id/btn_danmaku_emoji"
                        android:visibility="gone"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginLeft="6dp"
                        android:layout_marginRight="10dp"
                        android:src="@drawable/ttlive_ic_panel_input_emoji"
                        android:scaleType="fitXY"
                        android:adjustViewBounds="true"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="10dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintRight_toRightOf="parent"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#fe3824"
                        android:id="@+id/ttlive_vs_danmu_overinput_length"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="12dp"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <FrameLayout
                    android:layout_gravity="bottom"
                    android:id="@+id/live_vs_input_select_self_emoji_container"
                    android:visibility="gone"
                    android:layout_width="31dp"
                    android:layout_height="31dp"
                    android:layout_marginRight="12dp"
                    android:layout_marginBottom="7dp"
                    android:layout_marginEnd="12dp">
                    <com.bytedance.android.live.core.widget.HSImageView
                        android:layout_gravity="center"
                        android:id="@+id/live_vs_input_select_self_emoji"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:roundedCornerRadius="2dp"/>
                    <ImageView
                        android:layout_gravity="end|top"
                        android:id="@+id/live_vs_input_select_self_emoji_remover"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ttlive_ic_vs_self_emoji_remover"/>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
        <include layout="@layout/ttlive_dialog_replay_input_select_self_emoji"/>
        <com.bytedance.android.livesdk.chatroom.replay.interactionmsg.danmaku.send.VSInputPanelLayout
            android:id="@+id/panel_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/live_vs_select_self_emoji_fake"
        android:visibility="gone"
        android:layout_width="58dp"
        android:layout_height="58dp"
        app:roundedCornerRadius="4dp"/>
</FrameLayout>
