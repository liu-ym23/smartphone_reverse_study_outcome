<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:layout_width="129dp"
        android:layout_height="85dp"
        android:layout_marginTop="5dp">
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="19dp"
            android:layout_marginTop="55dp"
            android:src="@drawable/ttlive_chat_channel_empty_ball_1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="34dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/ttlive_chat_channel_empty_ball_2"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="87dp"
            android:layout_marginTop="18dp"
            android:src="@drawable/ttlive_chat_channel_empty_ball_3"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerImageView
            android:id="@+id/self_avatar_in_two"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginLeft="36dp"
            android:layout_marginTop="34dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundAsCircle="true"/>
        <com.bytedance.android.livesdk.widget.TransparentCircleIconView
            android:id="@+id/right_avatar_in_two"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginLeft="55dp"
            android:layout_marginTop="15dp"
            app:circleCenterLeftMargin="0dp"
            app:circleCenterTopMargin="38dp"
            app:circleRadius="22dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundAsCircle="true"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
