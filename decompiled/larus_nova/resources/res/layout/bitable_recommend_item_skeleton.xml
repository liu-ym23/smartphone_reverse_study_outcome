<?xml version="1.0" encoding="utf-8"?>
<com.larksuite.component.universe_design.shadow.UDShadowLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:ud_shadow_radius="10dp"
    style="@style/UDShadow.S2.Down">
    <com.bytedance.ee.bear.facade.common.widget.RoundFrameLayout
        android:background="@color/item_bg_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bottom_left_radius="10dp"
        app:bottom_right_radius="10dp"
        app:top_left_radius="10dp"
        app:top_right_radius="10dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_item_water_fall"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/bitable_rectangle_skeleton_no_radius"/>
            <View
                android:id="@+id/tv_title"
                android:background="@drawable/bitable_rectangle_skeleton"
                android:layout_width="153dp"
                android:layout_height="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="12dp"/>
            <View
                android:id="@+id/tv_title2"
                android:background="@drawable/bitable_rectangle_skeleton"
                android:layout_width="43dp"
                android:layout_height="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginStart="12dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <View
                    android:id="@+id/tv_user"
                    android:background="@drawable/bitable_circle_skeleton"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:background="@drawable/bitable_rectangle_skeleton"
                    android:layout_width="58dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_user"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </com.bytedance.ee.bear.facade.common.widget.RoundFrameLayout>
</com.larksuite.component.universe_design.shadow.UDShadowLayout>
