<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/cj_pay_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="@color/cj_pay_color_white"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.android.ttcjpaysdk.base.ui.widget.LabelTextLayout
            android:id="@+id/rl_title_bar"
            android:layout_width="match_parent"
            android:layout_height="44dp"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="44dp"
            android:fillViewport="true">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp">
                    <ImageView
                        android:id="@+id/sign_app_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginRight="6dp"/>
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/cj_pay_color_black_161823"
                        android:id="@+id/tv_sub_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
                    android:id="@+id/tv_product_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"/>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:id="@+id/cj_pay_total_value_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="28sp"
                        android:textColor="@color/cj_pay_color_black_161823"
                        android:id="@+id/cj_pay_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cj_pay_currency_unit"/>
                    <TextView
                        android:textSize="36sp"
                        android:textColor="@color/cj_pay_color_black_161823"
                        android:id="@+id/tv_product_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="2dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/cj_pay_color_orange_FF6E26"
                    android:ellipsize="end"
                    android:id="@+id/tv_product_price_discount"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="58dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
                        android:id="@+id/tv_service_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="服务详情"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/cj_pay_color_black_161823"
                        android:id="@+id/tv_service_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="24dp"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/ll_next_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
                        android:id="@+id/tv_pay_day_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cj_pay_withholding_period"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/cj_pay_color_black_161823"
                        android:id="@+id/tv_pay_day"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="24dp"
                        android:text="2022-07-08"/>
                </LinearLayout>
                <View
                    android:background="@color/cj_pay_color_gray_161823_opacity_12"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_marginTop="24dp"/>
                <RelativeLayout
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/cj_pay_color_black_161823"
                        android:id="@+id/tv_pay_style_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="扣款方式"/>
                    <RelativeLayout
                        android:gravity="center_vertical"
                        android:id="@+id/ll_pay_style"
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:layout_marginLeft="24dp"
                        android:layout_toRightOf="@+id/tv_pay_style_title"
                        android:layout_alignParentRight="true">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
                            android:ellipsize="middle"
                            android:gravity="right"
                            android:id="@+id/tv_pay_style"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginRight="12dp"
                            android:text="@string/cj_pay_withholding_pay_by_order"
                            android:maxLines="1"
                            android:layout_alignParentRight="true"/>
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/iv_arrow"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/cj_pay_icon_right_arrow_noise_reduction"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"/>
                    </RelativeLayout>
                </RelativeLayout>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
                    android:layout_gravity="left"
                    android:id="@+id/cj_pay_agreement_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_marginBottom="16dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="2.5dp"/>
                <com.android.ttcjpaysdk.base.ui.widget.LoadingButton
                    android:gravity="center"
                    android:id="@+id/btn_sign_pay"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cj_pay_custom_button_height_44"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_marginBottom="12dp"
                    app:btnTextColor="@color/cj_pay_color_white"
                    app:btnTextSize="15sp"
                    app:loadingHeight="20dp"
                    app:loadingWidth="20dp"/>
                <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/cj_pay_padding_16"
                    android:layout_alignParentBottom="true"
                    app:theme_type="0"/>
            </LinearLayout>
        </ScrollView>
        <View
            android:id="@+id/view_mask"
            android:background="#57000000"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/fl_fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</FrameLayout>
