<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/flow_ud_bg_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.lark.contact.customized.common.view.ContactOfficeTitleBar
        android:id="@+id/title_bar"
        android:background="@color/color_transparent"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:title="@string/Lark_Legacy_MyQrCode"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/llContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ScrollView
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:fillViewport="true"
                android:layout_weight="1"
                android:overScrollMode="never">
                <com.ss.android.lark.contact.customized.myqrcode.view.OfficeInviteExternalCardView
                    android:layout_gravity="center"
                    android:id="@+id/ieMyQrCodeContainerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"/>
            </ScrollView>
            <FrameLayout
                android:layout_gravity="bottom"
                android:id="@+id/ieShareContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <com.ss.android.lark.contact.customized.common.view.ContactOfficeEmptyStateView
            android:id="@+id/ieErrorView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/ieLoadingLayout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.ss.android.lark.contact.customized.common.view.ContactOfficeLoadingView
                android:layout_gravity="center"
                android:id="@+id/ieLoadingSpinner"
                android:layout_width="32dp"
                android:layout_height="32dp"/>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
