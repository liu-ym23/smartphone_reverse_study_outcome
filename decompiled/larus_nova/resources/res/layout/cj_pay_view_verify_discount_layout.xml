<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/cj_pay_verify_discount_old"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/discount_info_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_centerHorizontal="true">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/cj_pay_color_orange_FF6E26"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/origin_trade_amount"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_toLeftOf="@+id/real_amount_layout"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/cj_pay_color_orange_FF6E26"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/cj_pay_pre_discount_comma"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/cj_pay_color_orange_FF6E26"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/discount_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/cj_pay_color_orange_FF6E26"
                    android:gravity="center_horizontal"
                    android:id="@+id/cj_pay_pre_guide_discount_comma"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_toRightOf="@+id/discount_info"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/cj_pay_color_orange_FF6E26"
                    android:gravity="center_horizontal"
                    android:id="@+id/guide_discount_info_right"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_toRightOf="@+id/cj_pay_pre_guide_discount_comma"
                    android:layout_centerHorizontal="true"/>
            </LinearLayout>
            <RelativeLayout
                android:gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_below="@+id/discount_info_line">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/cj_pay_color_orange_FF6E26"
                    android:gravity="center_horizontal"
                    android:id="@+id/guide_discount_info_below"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_below="@+id/discount_info"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/cj_pay_verify_discount_new"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12sp"
                android:textColor="#ff6e26"
                android:gravity="center_horizontal"
                android:id="@+id/cj_pay_verify_discount_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="320dp"
                android:text="原价¥300，已减6.5元；¥13254354656324311135.5 × 3期(手续费¥1/期)"
                android:maxLines="2"
                android:layout_centerHorizontal="true"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cj_pay_verify_discount_desc_list"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
