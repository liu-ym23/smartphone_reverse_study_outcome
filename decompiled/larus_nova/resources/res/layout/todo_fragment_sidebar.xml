<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">
    <TextView
        android:textSize="@dimen/sp_22"
        android:textStyle="bold"
        android:textColor="@color/text_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="63dp"
        android:text="@string/Todo_Task_Tasks"
        android:layout_marginStart="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_13">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/button_me_owner"
            android:background="@drawable/todo_container_item_bg"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="@dimen/dp_1"
            android:layout_marginRight="14dp"
            android:layout_marginBottom="@dimen/dp_1"
            android:paddingStart="@dimen/dp_10"
            android:paddingEnd="@dimen/dp_10">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20sp"
                android:layout_height="20sp"
                android:src="@drawable/ud_icon_member_outlined"
                android:tint="@drawable/todo_container_item_icon_color"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/todo_container_item_text_color"
                android:id="@+id/text_owned"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:text="@string/Todo_New_OwnedByMe_TabTitle"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_12"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@drawable/todo_container_item_badge_color"
                android:id="@+id/text_owner_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/button_followed"
            android:background="@drawable/todo_container_item_bg"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="@dimen/dp_1"
            android:layout_marginRight="14dp"
            android:layout_marginBottom="@dimen/dp_1"
            android:paddingStart="@dimen/dp_10"
            android:paddingEnd="@dimen/dp_10">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20sp"
                android:layout_height="20sp"
                android:src="@drawable/ud_icon_subscribe_outlined"
                android:tint="@drawable/todo_container_item_icon_color"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/todo_container_item_text_color"
                android:id="@+id/text_followed"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:text="@string/Todo_New_SubscribedByMe_TabTitle"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_12"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@drawable/todo_container_item_badge_color"
                android:id="@+id/text_follow_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/button_all_events"
            android:background="@drawable/todo_container_item_bg"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="@dimen/dp_1"
            android:layout_marginRight="14dp"
            android:layout_marginBottom="@dimen/dp_1"
            android:paddingStart="@dimen/dp_10"
            android:paddingEnd="@dimen/dp_10">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20sp"
                android:layout_height="20sp"
                android:tint="@drawable/todo_container_item_icon_color"
                app:srcCompat="@drawable/ud_icon_time_outlined"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/todo_container_item_text_color"
                android:id="@+id/text_all_events"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:text="@string/Todo_Updates_Title"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_12"/>
        </LinearLayout>
        <View
            android:background="@color/line_divider_default"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_05"
            android:layout_marginLeft="@dimen/dp_14"
            android:layout_marginTop="@dimen/dp_6"
            android:layout_marginRight="@dimen/dp_14"/>
    </LinearLayout>
    <com.ss.android.lark.widget.ptr.LKUIPtrClassicFrameLayout
        android:id="@+id/container_ptr_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_container_list"
            android:paddingTop="@dimen/dp_6"
            android:paddingBottom="@dimen/dp_35"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_8"/>
    </com.ss.android.lark.widget.ptr.LKUIPtrClassicFrameLayout>
</LinearLayout>
