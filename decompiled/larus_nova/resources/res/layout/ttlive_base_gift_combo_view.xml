<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="80dp"
    android:layout_height="80dp">
    <View
        android:id="@+id/combo_bg"
        android:background="@drawable/ttlive_base_gift_combo_bg_new"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/combo_title"
        android:background="@drawable/ttlive_base_gift_combo_title_new2"
        android:visibility="gone"
        android:layout_width="50dp"
        android:layout_height="27dp"
        app:layout_constraintBottom_toBottomOf="@+id/combo_bg"
        app:layout_constraintEnd_toEndOf="@+id/combo_bg"
        app:layout_constraintStart_toStartOf="@+id/combo_bg"
        app:layout_constraintTop_toTopOf="@+id/combo_bg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
