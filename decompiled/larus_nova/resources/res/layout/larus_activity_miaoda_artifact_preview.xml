<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_bar"
        android:background="?attr/larus_base_1"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60">
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            android:src="@drawable/larus_ic_artifact_close"
            android:contentDescription="@string/larus_accessibility_icon_back"
            android:layout_marginStart="?attr/larus_dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/larus_neutral_100"/>
        <TextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:singleLine="true"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_52"
            android:layout_marginEnd="?attr/larus_dp_52"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/btn_share"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            android:src="@drawable/larus_ic_page_top_share"
            android:scaleType="centerInside"
            android:contentDescription="@string/larus_accessibility_icon_share"
            android:layout_marginEnd="?attr/larus_dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/divider"
            android:background="@drawable/larus_bg_divider"
            android:layout_width="match_parent"
            android:layout_height="1px"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/web_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
