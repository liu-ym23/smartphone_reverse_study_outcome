<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity=""
    android:id="@+id/ttlive_live_recommend_container"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ttlive_recommend_title"
        android:layout_width="match_parent"
        android:layout_height="18dp">
        <View
            android:background="@drawable/ttlive_divide_line_live_end"
            android:layout_width="0dp"
            android:layout_height="0.5dp"
            android:layout_marginRight="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/recommend_title_content"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_end_recommend_tips"
            android:id="@+id/recommend_title_content"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/ttlive_live_end_recommend"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:background="@drawable/ttlive_divide_line_live_end"
            android:layout_width="0dp"
            android:layout_height="0.5dp"
            android:layout_marginLeft="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/recommend_title_content"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/recommend_live_container_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="13dp"
        android:layout_marginRight="16dp"
        android:layout_below="@+id/ttlive_recommend_title"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/recommend_live_container_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="16dp"
        android:layout_below="@+id/recommend_live_container_1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/appointment_list_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:layout_below="@+id/ttlive_recommend_title"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"/>
</RelativeLayout>
