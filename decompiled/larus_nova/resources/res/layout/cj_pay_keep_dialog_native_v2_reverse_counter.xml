<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_pay_voucher_dialog_bg_layout"
    android:background="@color/cj_pay_color_trans"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/cj_pay_lynx_dialog_root_layout"
        android:background="@drawable/cj_pay_grey_bg_fragment_container"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="504dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <ImageView
            android:layout_gravity="left"
            android:id="@+id/keep_dialog_close_image"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="15dp"
            android:src="@drawable/cj_pay_icon_titlebar_left_close_noise_reduction"/>
        <ImageView
            android:id="@+id/title_image"
            android:layout_width="184dp"
            android:layout_height="25dp"
            android:layout_marginTop="34dp"
            android:src="@drawable/cj_pay_native_v2_reverse_counter_title"
            android:layout_centerHorizontal="true"/>
        <RelativeLayout
            android:id="@+id/cj_pay_reverse_counter_voucher_layout"
            android:background="@drawable/cj_pay_white_bg_with_radius"
            android:paddingLeft="16dp"
            android:paddingTop="20dp"
            android:paddingRight="16dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="33dp"
            android:minHeight="248dp"
            android:layout_below="@+id/title_image">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/cj_pay_reverse_counter_inner_card_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="15sp"
                    android:textColor="#161823"
                    android:id="@+id/voucher_chooser_title_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cj_pay_reverse_counter_voucher_title_left"/>
                <View
                    android:background="@color/cj_pay_color_gray_161823_opacity_12"
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="#161823"
                    android:id="@+id/voucher_chooser_title_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="4dp"
                    android:text="@string/cj_pay_reverse_counter_voucher_title_right"/>
                <com.android.ttcjpaysdk.base.ui.dialog.nativev2.CJPayReverseCounterCountDownTimerLayout
                    android:id="@+id/count_down_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_below="@+id/cj_pay_reverse_counter_inner_card_title"
                android:layout_centerHorizontal="true">
                <com.android.ttcjpaysdk.base.ui.dialog.nativev2.CJPayReverseCounterVoucherTag
                    android:id="@+id/cj_pay_reverse_counter_voucher_tag_left"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <View
                    android:layout_width="8dp"
                    android:layout_height="10dp"/>
                <com.android.ttcjpaysdk.base.ui.dialog.nativev2.CJPayReverseCounterVoucherTag
                    android:id="@+id/cj_pay_reverse_counter_voucher_tag_right"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
        </RelativeLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/cj_pay_color_red_fe2c55"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="right"
            android:id="@+id/tv_voucher_bubble"
            android:background="@drawable/cj_pay_reverse_counter_bubble"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:layout_marginTop="18dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_below="@+id/cj_pay_reverse_counter_voucher_layout"
            android:layout_alignParentRight="true"/>
        <LinearLayout
            android:id="@+id/cj_pay_reverse_bottom_button_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:layout_below="@+id/cj_pay_reverse_counter_voucher_layout">
            <RelativeLayout
                android:id="@+id/cj_pay_reverse_counter_cancel_button_layout"
                android:background="@drawable/cj_pay_reverse_counter_cancel_button_bg"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="15sp"
                    android:textColor="#ff161823"
                    android:id="@+id/cj_pay_reverse_counter_cancel_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
            <View
                android:layout_width="8dp"
                android:layout_height="5dp"/>
            <com.android.ttcjpaysdk.base.ui.widget.LoadingButton
                android:id="@+id/cj_pay_reverse_counter_confirm_button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"/>
        </LinearLayout>
        <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
            android:id="@+id/bottom_insurance_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_below="@+id/cj_pay_reverse_bottom_button_layout"
            app:theme_type="0"/>
    </RelativeLayout>
</RelativeLayout>
