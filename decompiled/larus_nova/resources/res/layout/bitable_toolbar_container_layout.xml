<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/clipped_container"
    android:paddingLeft="@dimen/space_kit_len_16"
    android:paddingRight="@dimen/space_kit_len_8"
    android:layout_width="match_parent"
    android:layout_height="@dimen/space_kit_len_36">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/left_wrapper"
        android:paddingRight="@dimen/space_kit_len_4"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <TextView
            android:textSize="@dimen/space_kit_font_12"
            android:textColor="@color/text_caption"
            android:gravity="center"
            android:id="@+id/left_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/left_arror"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:srcCompat="@drawable/ud_icon_right_small_ccm_outlined"
            app:tint="@color/icon_n3"/>
    </LinearLayout>
    <View
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/menu_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
