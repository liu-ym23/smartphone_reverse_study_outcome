<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ec_commerce_inflow_search_top_bar_2081395139"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ec_commerce_inflow_search_top_bar_756357476"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/ec_commerce_inflow_search_top_bar_1808934784"
            android:background="@drawable/commerce_bg_inflow_search_top_top"
            android:layout_width="match_parent"
            android:layout_height="15dp"/>
        <View
            android:id="@+id/ec_commerce_inflow_search_top_bar_1143167679"
            android:background="@drawable/commerce_bg_inflow_search_top"
            android:layout_width="match_parent"
            android:layout_height="40dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_search_area"
        android:background="@drawable/commerce_bg_search_bar_data"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="5dp"
        android:layout_marginStart="12dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/commerce_icon_inflow_search"
            android:layout_marginStart="12dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ec_guess_u_search"
            android:includeFontPadding="false"
            android:layout_marginStart="4dp"/>
        <View
            android:background="@drawable/commerce_bg_search_line"
            android:layout_width="1px"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/tv_search_word"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/commerce_inflow_search_arrowright"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="12dp"/>
    </LinearLayout>
</FrameLayout>
