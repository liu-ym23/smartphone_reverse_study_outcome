<?xml version="1.0" encoding="utf-8"?>
<com.larksuite.component.universe_design.shadow.UDShadowLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:ud_shadow_radius="10dp"
    style="@style/UDShadow.S2.Down">
    <com.bytedance.ee.bear.facade.common.widget.RoundFrameLayout
        android:background="@color/item_bg_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bottom_left_radius="10dp"
        app:bottom_right_radius="10dp"
        app:top_left_radius="10dp"
        app:top_right_radius="10dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/image_container"
                android:background="@color/bg_base"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.bytedance.ee.bear.bitable.homepage.recommend.widget.RatioImageView
                    android:id="@+id/iv_item_water_fall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/error_view"
                    android:background="@drawable/ud_icon_loadfail_filled"
                    android:visibility="gone"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:backgroundTint="#8f959e"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textStyle="bold"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:id="@+id/tv_title"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginBottom="12dp">
                <com.larksuite.component.ui.imageview.LKUIRoundedImageView
                    android:id="@+id/iv_user_avatar"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:scaleType="centerCrop"
                    app:civ_border_width="0dp"
                    app:civ_oval="true"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/text_title"
                    android:ellipsize="end"
                    android:id="@+id/tv_user"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:lines="1"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_read_count_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:scaleType="fitXY"
                    android:tint="@color/text_placeholder"
                    android:layout_marginEnd="4dp"
                    app:srcCompat="@drawable/ud_icon_visible_outlined"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/text_placeholder"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_read_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </LinearLayout>
    </com.bytedance.ee.bear.facade.common.widget.RoundFrameLayout>
</com.larksuite.component.universe_design.shadow.UDShadowLayout>
