<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="178dp">
    <ImageView
        android:id="@+id/switch_scene_video_talk_room"
        android:padding="2dp"
        android:layout_width="172dp"
        android:layout_height="124dp"
        android:layout_marginLeft="9dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/ttlive_video_talkroom_switch_scene_bg"
        android:layout_marginStart="9dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_width="100dp"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/ttlive_video_talkroom_switch_scene_icon"
        app:layout_constraintLeft_toLeftOf="@+id/switch_scene_video_talk_room"
        app:layout_constraintRight_toRightOf="@+id/switch_scene_video_talk_room"
        app:layout_constraintTop_toTopOf="@+id/switch_scene_video_talk_room"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_audience_link_tips"
        android:id="@+id/tv_video_talk_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="74dp"
        android:text="@string/ttlive_video_talk_room"
        app:layout_constraintLeft_toLeftOf="@+id/switch_scene_video_talk_room"
        app:layout_constraintRight_toRightOf="@+id/switch_scene_video_talk_room"
        app:layout_constraintTop_toTopOf="@+id/switch_scene_video_talk_room"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_audience_link_small_tips"
        android:id="@+id/tv_video_talk_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="96dp"
        android:text="@string/ttlive_tips_scene_init_talk_room"
        app:layout_constraintLeft_toLeftOf="@+id/switch_scene_video_talk_room"
        app:layout_constraintRight_toRightOf="@+id/switch_scene_video_talk_room"
        app:layout_constraintTop_toTopOf="@+id/switch_scene_video_talk_room"/>
    <ImageView
        android:id="@+id/switch_scene_video_ktv_room"
        android:padding="2dp"
        android:layout_width="172dp"
        android:layout_height="124dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="9dp"
        android:src="@drawable/ttlive_video_talkroom_switch_scene_bg"
        android:layout_marginEnd="9dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/switch_scene_video_ktv_room_icon"
        android:layout_width="100dp"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/ttlive_video_ktvroom_switch_scene_icon"
        app:layout_constraintLeft_toLeftOf="@+id/switch_scene_video_ktv_room"
        app:layout_constraintRight_toRightOf="@+id/switch_scene_video_ktv_room"
        app:layout_constraintTop_toTopOf="@+id/switch_scene_video_ktv_room"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_audience_link_tips"
        android:id="@+id/tv_video_ktv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="74dp"
        android:text="@string/ttlive_live_interact_confirm_ktvroom_title"
        app:layout_constraintLeft_toLeftOf="@+id/switch_scene_video_ktv_room"
        app:layout_constraintRight_toRightOf="@+id/switch_scene_video_ktv_room"
        app:layout_constraintTop_toTopOf="@+id/switch_scene_video_ktv_room"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_audience_link_small_tips"
        android:id="@+id/tv_video_ktv_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="96dp"
        android:text="@string/ttlive_tips_scene_init_ktv"
        app:layout_constraintLeft_toLeftOf="@+id/switch_scene_video_ktv_room"
        app:layout_constraintRight_toRightOf="@+id/switch_scene_video_ktv_room"
        app:layout_constraintTop_toTopOf="@+id/switch_scene_video_ktv_room"/>
</androidx.constraintlayout.widget.ConstraintLayout>
