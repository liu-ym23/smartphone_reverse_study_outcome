<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/video_web_sdk_video_bottomshadow"
    android:layout_width="match_parent"
    android:layout_height="40dp">
    <TextView
        android:textSize="12sp"
        android:textColor="#ffffff"
        android:id="@+id/video_web_sdk_video_time_play"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="12dp"
        android:text="00:00"
        android:shadowColor="#72000000"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="2"/>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <SeekBar
            android:id="@+id/video_web_sdk_video_seekbar"
            android:background="@null"
            android:paddingLeft="0dp"
            android:paddingTop="8dp"
            android:paddingRight="0dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="1dp"
            android:max="100"
            android:progressDrawable="@drawable/video_web_sdk_video_seek_progress"
            android:minHeight="1dp"
            android:thumb="@drawable/video_web_sdk_video_seek_thumb"
            android:thumbOffset="0dp"/>
    </FrameLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="#ffffff"
        android:id="@+id/video_web_sdk_video_time_total_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:text="00:00"
        android:shadowColor="#72000000"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="2"/>
    <ImageView
        android:id="@+id/video_web_sdk_video_full_screen"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/video_web_sdk_video_fullscreen_enter"
        android:scaleType="center"/>
</LinearLayout>
