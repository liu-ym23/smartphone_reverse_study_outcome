<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gamecp_detail_head_container"
    android:background="@drawable/shape_bg_ffffff_corner_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.gamecp.common.ui.HSImageView
        android:id="@+id/gamecp_detail_header_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="18dp"
        app:failureImage="@drawable/gamecp_game_detail_img_default_bg_12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/gamecp_game_detail_img_default_bg_12dp"
        app:roundedCornerRadius="12dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/gamecp_detail_header_score_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="18dp"
        android:minWidth="52dp"
        app:layout_constraintBottom_toBottomOf="@+id/gamecp_detail_header_icon"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/gamecp_detail_header_icon">
        <TextView
            android:textSize="26sp"
            android:textColor="#161823"
            android:id="@+id/gamecp_detail_header_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/gamecp_detail_header_score_text"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#161823"
            android:id="@+id/gamecp_detail_header_score_text"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/gamecp_detail_header_score"
            app:layout_constraintLeft_toRightOf="@+id/gamecp_detail_header_score"
            app:layout_constraintRight_toRightOf="parent"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#99161823"
            android:id="@+id/gamecp_detail_header_comment_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gamecp_detail_header_score"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/gamecp_detail_header_name_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/gamecp_detail_header_tags_container"
        app:layout_constraintEnd_toStartOf="@+id/gamecp_detail_header_score_container"
        app:layout_constraintStart_toEndOf="@+id/gamecp_detail_header_icon"
        app:layout_constraintTop_toTopOf="@+id/gamecp_detail_header_icon"
        app:layout_constraintVertical_chainStyle="packed">
        <com.bytedance.android.gamecp.business.view.GameDetailTitleTextView
            android:textSize="20sp"
            android:textColor="#ff161823"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/gamecp_detail_header_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/gamecp_detail_header_status"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.gamecp.common.ui.HSImageView
            android:id="@+id/gamecp_detail_header_status"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/gamecp_detail_header_name"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/gamecp_detail_header_tags_container"
        android:layout_width="0dp"
        android:layout_height="14sp"
        android:layout_marginTop="2dp"
        app:layout_constraintBottom_toTopOf="@+id/gamecp_detail_header_desc_list_layout"
        app:layout_constraintEnd_toEndOf="@+id/gamecp_detail_header_name_container"
        app:layout_constraintStart_toStartOf="@+id/gamecp_detail_header_name_container"
        app:layout_constraintTop_toBottomOf="@+id/gamecp_detail_header_name_container">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/gamecp_detail_header_official_same_pkg_container"
            android:background="@drawable/gamecp_shape_bg_14168ef9_corner_2"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="5dp">
            <ImageView
                android:id="@+id/gamecp_detail_header_official_same_pkg_icon"
                android:layout_width="9sp"
                android:layout_height="9sp"
                android:layout_marginRight="2dp"
                android:src="@drawable/gamecp_game_detail_official_same_package_shield"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#00a6ff"
                android:id="@+id/gamecp_detail_header_official_same_pkg_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="官网包"/>
        </LinearLayout>
        <com.bytedance.android.gamecp.common.ui.FlowLayout
            android:id="@+id/gamecp_detail_header_tags"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <com.bytedance.android.gamecp.common.ui.FlowLayout
        android:id="@+id/gamecp_detail_header_desc_list_layout"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/gamecp_detail_header_icon"
        app:layout_constraintEnd_toEndOf="@+id/gamecp_detail_header_name_container"
        app:layout_constraintStart_toStartOf="@+id/gamecp_detail_header_name_container"
        app:layout_constraintTop_toBottomOf="@+id/gamecp_detail_header_tags_container"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/gamecp_detail_header_five_element_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="18dp"
        app:layout_constraintBottom_toTopOf="@+id/game_info_video_rank_list_entrance_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/gamecp_detail_header_icon"
        app:layout_constraintTop_toBottomOf="@+id/gamecp_detail_header_icon">
        <TextView
            android:textSize="10sp"
            android:textColor="#57161823"
            android:id="@+id/gamecp_detail_header_pc_game_info"
            android:paddingBottom="2dp"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="1dp"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#57161823"
            android:id="@+id/gamecp_detail_header_five_element"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="1dp"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/game_info_video_rank_list_entrance_layout"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gamecp_detail_header_five_element_layout">
        <View
            android:background="@color/gamecp_game_1A161823"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.gamecp.common.ui.HSImageView
            android:id="@+id/video_rank_list_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/gamecp_detail_video_rank_list_icon"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/video_rank_list_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/gamecp_game_BF161823"
            android:id="@+id/video_rank_list_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/video_rank_list_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/gamecp_game_99161823"
            android:id="@+id/video_rank_list_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/video_rank_list_right_arrow"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/video_rank_list_right_arrow"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:src="@drawable/gamecp_ic_game_promote_right_arrow_black"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/gamecp_detail_header_desc_official_placeholder"
        android:background="#00000000"
        android:layout_width="1dp"
        android:layout_height="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/gamecp_detail_header_desc_privacy_placeholder"
        android:background="#00000000"
        android:layout_width="1dp"
        android:layout_height="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
