<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_edit_container"
    android:background="#66000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/layout_bottom"
        android:background="@color/ec_color_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_weight="1">
            <TextView
                android:textSize="15dp"
                android:textColor="@color/ec_color_black_161823_75"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_auto_gen_title"
                android:background="@drawable/ec_bg_flash_item_title"
                android:paddingLeft="8dp"
                android:paddingTop="3.5dp"
                android:paddingRight="8dp"
                android:paddingBottom="3.5dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginRight="24dp"
                android:layout_marginBottom="5dp"
                android:text="【闪购商品】足银圆形金镶玉超级豪华字超级多的属性"
                android:includeFontPadding="false"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/layout_edit_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:textSize="15dp"
                    android:textColor="@color/ec_color_black_161823"
                    android:textColorHint="@color/ec_color_black_161823_20"
                    android:gravity="center_vertical"
                    android:id="@+id/et_input"
                    android:background="@color/ec_color_transparent"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:minHeight="28dp"
                    android:cursorVisible="true"
                    android:singleLine="true"
                    android:layout_weight="1"
                    android:textCursorDrawable="@drawable/ec_live_edit_cursor_new"/>
                <FrameLayout
                    android:id="@+id/layout_clear"
                    android:visibility="gone"
                    android:layout_width="28dp"
                    android:layout_height="28dp">
                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ec_icon_flash_edit_clear"/>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ec_color_FE2C55"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/btn_complete"
            android:paddingLeft="7dp"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="@string/ec_done"/>
    </LinearLayout>
</FrameLayout>
