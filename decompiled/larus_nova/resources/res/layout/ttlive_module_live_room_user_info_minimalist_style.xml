<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="6dp"
    android:layout_marginTop="8dp"
    android:layout_marginStart="6dp">
    <TextView
        android:textSize="22dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/anchor_name"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:singleLine="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"/>
    <RelativeLayout
        android:id="@+id/ticket_info_layout"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_toRightOf="@+id/anchor_name"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/anchor_name">
        <TextView
            android:textSize="10dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/ticket_count_text"
            android:layout_width="wrap_content"
            android:layout_height="13dp"
            android:layout_marginLeft="4dp"
            android:layout_marginStart="4dp"/>
        <TextView
            android:textSize="10dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/ticket_count"
            android:layout_width="wrap_content"
            android:layout_height="13dp"
            android:layout_marginLeft="4dp"
            android:layout_below="@+id/ticket_count_text"
            android:layout_marginStart="4dp"/>
    </RelativeLayout>
</RelativeLayout>
