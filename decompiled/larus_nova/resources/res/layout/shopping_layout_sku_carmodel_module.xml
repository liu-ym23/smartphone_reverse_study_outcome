<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/shopping_layout_sku_carmodel_module_786124937"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="16dp">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/shopping_std_text_black_1"
        android:id="@+id/tv_car_model_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/shopping_tv_car_model_title"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"/>
    <FrameLayout
        android:gravity="center_vertical"
        android:id="@+id/fl_car_model_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="12dp"
        android:layout_toEndOf="@+id/tv_car_model_title">
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="start|top"
            android:id="@+id/iv_car_model_status"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="1dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/shopping_std_text_black_1"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/tv_car_model_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_marginStart="20dp"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/iv_car_model_right_arrow"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/shopping_ic_sku_forward"
            android:scaleType="centerCrop"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/iv_sku_right_arrow"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/shopping_ic_sku_forward"
        android:scaleType="centerCrop"
        android:layout_below="@+id/fl_car_model_status"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/shopping_std_text_black_3"
        android:id="@+id/tv_car_model_switch_model"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/shopping_tv_car_model_switch_model"
        android:layout_below="@+id/fl_car_model_status"
        android:layout_toStartOf="@+id/iv_sku_right_arrow"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/shopping_std_text_black_3"
        android:ellipsize="end"
        android:id="@+id/tv_car_model_detail_desc"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:singleLine="true"
        android:layout_below="@+id/fl_car_model_status"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="10dp"
        android:layout_toStartOf="@+id/tv_car_model_switch_model"
        android:layout_toEndOf="@+id/tv_car_model_title"/>
</RelativeLayout>
