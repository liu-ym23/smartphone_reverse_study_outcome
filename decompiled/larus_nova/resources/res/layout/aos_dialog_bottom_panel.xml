<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/ll_panel_dialog_container"
    android:background="@drawable/aos_feed_bottom_panel_report_dislike_shape"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:background="@drawable/aos_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/aos_feed_bottom_panel_item_round_shape"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <RelativeLayout
            android:id="@+id/not_interesting_ll"
            android:background="@drawable/aos_feed_bottom_panel_item_round_shape"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingStart="16dp">
            <ImageView
                android:id="@+id/icon_dislike"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/aos_ic_s_s_heartbreak_outlined_20"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#161823"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="不感兴趣"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/icon_dislike"/>
            <View
                android:id="@+id/not_interesting_line"
                android:background="#19161823"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="32dp"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/play_speed_rl"
            android:background="@drawable/aos_feed_bottom_panel_item_round_shape"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingStart="16dp"
            android:paddingEnd="20dp">
            <ImageView
                android:id="@+id/play_speed_iv"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/aos_ic_s_s_play_speed_outlined_20"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#161823"
                android:id="@+id/play_speed_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="播放速度"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/play_speed_iv"/>
            <View
                android:id="@+id/play_speed_line"
                android:background="#19161823"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="32dp"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/enter_clean_mode_rl"
            android:background="@drawable/aos_feed_bottom_panel_item_round_shape"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingStart="16dp"
            android:paddingEnd="20dp">
            <ImageView
                android:id="@+id/enter_clean_mode_iv"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_s_s_zoomout_outlined_20"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#161823"
                android:id="@+id/enter_clean_mode_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="清屏播放"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/enter_clean_mode_iv"/>
            <View
                android:id="@+id/enter_clean_mode_iv_line"
                android:background="#19161823"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="32dp"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/autoPlay_ll"
            android:background="@drawable/aos_feed_bottom_panel_item_round_shape"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingStart="16dp"
            android:paddingEnd="20dp">
            <ImageView
                android:id="@+id/icon_autoPlay"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/aos_ic_s_s_vertrianglesquareonsquare_outlined_20"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#161823"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="自动连播"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/icon_autoPlay"/>
            <com.bytedance.awemeopen.apps.framework.feed.ui.panelswitch.BottomPanelSwitch
                android:id="@+id/autoplay_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                app:thumb_color="#ffffff"
                app:thumb_radius="10.5dp"
                app:track_corner="44dp"
                app:track_height="25dp"
                app:track_turn_off_color="#16182333"
                app:track_turn_on_color="#33e088"
                app:track_width="43dp"/>
            <View
                android:id="@+id/autoplay_line"
                android:background="#19161823"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="32dp"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/collect_ll"
            android:background="@drawable/aos_feed_bottom_panel_item_round_shape"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingStart="16dp">
            <ImageView
                android:id="@+id/icon_collect"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/aos_ic_s_s_pentagram_outlined_30"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#161823"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我的收藏"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/icon_collect"/>
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/aos_ic_s_s_arrowforward_outlined_19"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:layout_alignParentEnd="true"/>
            <View
                android:id="@+id/collect_line"
                android:background="#19161823"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="32dp"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/report_ll_inner"
            android:background="@drawable/aos_feed_bottom_panel_item_round_shape"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <ImageView
                android:id="@+id/icon_report_inner"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/aos_ic_s_s_exclamationtriangle_red_outlined_30"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#fe2c55"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="举报"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/icon_report_inner"/>
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/aos_ic_s_s_arrowforward_outlined_19"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/report_ll"
        android:background="@drawable/aos_feed_bottom_panel_item_round_shape"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <ImageView
            android:id="@+id/icon_report"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/aos_ic_s_s_exclamationtriangle_red_outlined_30"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#fe2c55"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="举报"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/icon_report"/>
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/aos_ic_s_s_arrowforward_outlined_19"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
