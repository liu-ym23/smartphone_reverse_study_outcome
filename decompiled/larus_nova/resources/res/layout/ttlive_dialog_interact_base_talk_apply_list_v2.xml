<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ttlive_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/link_call_empty_panel"
        android:background="@drawable/ttlive_call_link_empty_bg"
        android:layout_width="match_parent"
        android:layout_height="63dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/link_call_btn"
            android:background="@drawable/ttlive_bg_call_link_btn"
            android:clickable="true"
            android:layout_width="106dp"
            android:layout_height="28dp"
            android:layout_marginRight="16dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true">
            <ImageView
                android:layout_gravity="center_vertical"
                android:background="@drawable/ttlive_audience_call_link_hand"
                android:layout_width="20dp"
                android:layout_height="20dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#ffffff"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="@string/ttlive_talk_room_call_link"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:layout_width="match_parent"
            android:layout_height="63dp"
            android:layout_toLeftOf="@+id/link_call_btn"
            android:layout_alignParentLeft="true"
            android:paddingStart="16dp"
            android:layout_toStartOf="@+id/link_call_btn"
            android:layout_alignParentStart="true">
            <TextView
                android:textSize="13sp"
                android:textColor="#2d2f38"
                android:gravity="center_vertical"
                android:id="@+id/link_apply_count"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginTop="12dp"
                android:text="@string/ttlive_talk_room_call_link_empty"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#808080"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="17dp"
                android:layout_marginTop="4dp"
                android:text="@string/ttlive_talk_room_call_link_hint"
                android:lines="1"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/link_apply_panel"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/paid_link_guide_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="64dp">
            <TextView
                android:textSize="13dp"
                android:textColor="#161823"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:text="@string/ttlive_paid_link_guide_content"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/paid_link_guide_btn_open"
                android:background="@drawable/ttlive_bg_paid_link_guide_open_btn"
                android:layout_width="64dp"
                android:layout_height="24dp"
                android:layout_marginRight="44dp"
                android:text="@string/ttlive_paid_link_guide_open"
                android:layout_marginEnd="44dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/paid_link_guide_btn_close"
                android:background="@drawable/ttlive_ic_paid_link_guide_close"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginRight="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="#2d2738"
            android:id="@+id/link_apply_message_count"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="12dp"
            android:text="@string/ttlive_talk_room_call_link_empty"
            android:layout_marginStart="16dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rlv"
            android:background="@color/ttlive_core_hs_w1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/link_apply_more"
            android:background="@drawable/ttlive_link_apply_message_bg"
            android:paddingLeft="8dp"
            android:paddingRight="6dp"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginTop="14dp"
            android:paddingStart="8dp"
            android:paddingEnd="6dp">
            <com.bytedance.android.live.liveinteract.common.ui.CustomOnlineFriendsCircleContainer
                android:layout_gravity="center_vertical"
                android:id="@+id/more_user_avatars"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginRight="4dp"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#80161823"
                android:id="@+id/link_apply_more_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_talk_more_message"/>
            <ImageView
                android:id="@+id/link_apply_more_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="2dp"
                android:src="@drawable/ttlive_ic_pk_userlist_title_expand"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/error"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="180dp"
            android:layout_height="120dp"
            android:layout_marginTop="84dp"
            android:src="@drawable/ttlive_bg_live_loading_error"/>
        <TextView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ttlive_user_rank_no_network_below_tip"/>
        <TextView
            android:textColor="#161823"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/refresh"
            android:background="@drawable/ttlive_bg_interact_text"
            android:layout_width="112dp"
            android:layout_height="36dp"
            android:layout_marginTop="20dp"
            android:text="@string/ttlive_network_refresh"/>
    </LinearLayout>
</FrameLayout>
