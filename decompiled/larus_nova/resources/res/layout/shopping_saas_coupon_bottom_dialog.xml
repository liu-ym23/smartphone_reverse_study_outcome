<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/saas_coupon_whole"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="@drawable/saas_coupon_dialog_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:background="@drawable/saas_coupon_dialog_top_bg"
            android:layout_width="match_parent"
            android:layout_height="157dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/saas_coupon_dialog_color"
                android:layout_gravity="center_horizontal"
                android:id="@+id/saas_coupon_id_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="@string/saas_coupon_dialog_title"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/saas_coupon_dialog_color"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/saas_coupon_id_user_phone_inner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/saas_coupon_dialog_user_phone_inner"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/cl_coupon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/saas_coupon_dialog_bg_middle_src"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_coupon_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="113dp"
                    android:layout_marginStart="113dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/saas_coupon_dialog_color"
                        android:id="@+id/saas_coupon_id_main_right_top"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/saas_coupon_dialog_main_right_top"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/saas_coupon_dialog_text_color"
                        android:id="@+id/saas_coupon_id_main_right_middle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/saas_coupon_dialog_main_right_middle"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/saas_coupon_dialog_text_color"
                        android:id="@+id/saas_coupon_id_main_right_bottom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/saas_coupon_dialog_main_right_bottom"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_coupon_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="12dp"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/ll_coupon_description"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <LinearLayout
                        android:layout_gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <com.bytedance.android.ec.core.widget.price.PriceView
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="@color/saas_coupon_dialog_color"
                            android:id="@+id/saas_coupon_id_main_left_big"
                            android:padding="0dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/saas_coupon_dialog_main_left_big"
                            android:includeFontPadding="false"
                            app:pv_hideYuanSymbol="true"/>
                        <TextView
                            android:textSize="11sp"
                            android:textColor="@color/saas_coupon_dialog_color"
                            android:layout_gravity="bottom"
                            android:id="@+id/saas_coupon_id_main_left_big_tag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp"
                            android:text="@string/saas_coupon_dialog_main_left_big_1"
                            android:includeFontPadding="false"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/saas_coupon_dialog_color"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/saas_coupon_id_main_left_small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/saas_coupon_dialog_main_left_small"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:id="@+id/saas_coupon_service_tip_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/saas_coupon_dialog_service"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/saas_coupon_dialog_text_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/saas_coupon_dialog_service"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <TextView
                android:textSize="15sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/saas_coupon_id_ok_text"
                android:background="@drawable/saas_coupon_dialog_red_bg_botton"
                android:layout_width="343dp"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:text="@string/saas_coupon_dialog_ok_text"
                android:layout_centerInParent="true"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/saas_coupon_dialog_text_color"
                android:layout_gravity="center_horizontal"
                android:id="@+id/saas_coupon_id_douyin_auth_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/saas_coupon_dialog_bind"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="end|top"
            android:id="@+id/saas_coupon_id_cancel"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginEnd="12dp"
            app:srcCompat="@drawable/saas_coupon_dialog_close"/>
    </FrameLayout>
</LinearLayout>
