<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/gamecp_top_head_col_background"
        android:background="@drawable/gamecp_game_detail_top_head_col_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="44dp"
        app:layout_constraintBottom_toBottomOf="@+id/gamecp_top_head_col_container"
        app:layout_constraintEnd_toEndOf="@+id/gamecp_top_head_col_container"
        app:layout_constraintStart_toStartOf="@+id/gamecp_top_head_col_container"
        app:layout_constraintTop_toTopOf="@+id/gamecp_top_head_col_container"/>
    <FrameLayout
        android:id="@+id/gamecp_top_head_col_container"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
