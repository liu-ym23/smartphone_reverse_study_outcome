<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:paddingTop="60dp"
    android:paddingBottom="80dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/image_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/aos_icon_net_error"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/aos_text_primary"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/title_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/aos_net_error_title"
        android:textAlignment="center"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textSize="14sp"
        android:textColor="@color/aos_text_tertiary"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/content_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/aos_net_error_subtitle"
        android:lineSpacingExtra="2dp"
        android:textAlignment="center"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/aos_text_primary"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/retry_btn"
        android:background="@drawable/aos_bg_retry_button"
        android:layout_width="231dp"
        android:layout_height="36dp"
        android:layout_marginTop="119dp"
        android:text="@string/aos_uikit_retry"
        android:textAlignment="center"/>
</LinearLayout>
