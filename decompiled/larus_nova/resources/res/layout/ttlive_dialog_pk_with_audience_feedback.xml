<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/ttlive_mask_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/feedback_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/feedback_container"
        android:background="@drawable/ttlive_bg_feedback_dialog"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_black"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ttlive_talk_room_feedback_title2"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#a3a3a3"
            android:layout_gravity="center_horizontal"
            android:id="@+id/sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ttlive_talk_room_feedback_sub_title2"/>
        <com.bytedance.android.live.livepkaudience.view.PkWithAudienceFeedbackView
            android:id="@+id/feedback_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>
        <TextView
            android:textColor="#a3a3a3"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/net_error"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:text="@string/ttlive_core_load_status_network_error"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/finish"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp">
            <Button
                android:textSize="14dp"
                android:textColor="@color/ttlive_pk_cancel_dialog_button"
                android:id="@+id/ttlive_finish"
                android:background="@drawable/ttlive_bg_pk_end"
                android:layout_width="164dp"
                android:layout_height="match_parent"
                android:layout_marginRight="8dp"
                android:text="@string/ttlive_talk_room_feedback_submit"
                android:height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"/>
            <Button
                android:textSize="14dp"
                android:textColor="@color/white"
                android:id="@+id/ttlive_cancel"
                android:background="@drawable/ttlive_bg_pk_cancel"
                android:layout_width="164dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp"
                android:text="@string/ttlive_talk_room_feedback_cancel"
                android:height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <Button
            android:textSize="15dp"
            android:textColor="@color/white"
            android:id="@+id/ttlive_submit"
            android:background="@drawable/ttlive_bg_talkroom_feedback_btn"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:text="@string/ttlive_talkroom_feedback_dialog_submit_issues"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
