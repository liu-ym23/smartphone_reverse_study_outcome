<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/poi_coi_dynamic_info_fake_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/poi_coi_dynamic_info_spu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_min="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/poi_coi_dynamic_info_rank"
        app:layout_constraintVertical_weight="1"/>
    <com.bytedance.dux.text.DuxTextView
        android:textSize="12sp"
        android:textColor="@color/POITextTertiary2"
        android:id="@+id/poi_coi_dynamic_info_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:includeFontPadding="false"
        android:layout_marginStart="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/poi_coi_dynamic_info_tags"
        app:layout_constraintTop_toBottomOf="@+id/poi_coi_dynamic_info_rating"/>
    <com.bytedance.locallife.poi.newdetail.component.feed.coi.PoiCoiDynamicView
        android:gravity="center_vertical"
        android:id="@+id/poi_coi_dynamic_info_name"
        android:paddingRight="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/poi_coi_dynamic_info_rating"
        app:layout_constraintEnd_toStartOf="@+id/poi_coi_dynamic_info_more_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.locallife.poi.newdetail.component.feed.coi.PoiCoiDynamicView
        android:gravity="center_vertical"
        android:id="@+id/poi_coi_dynamic_info_rank"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintBottom_toTopOf="@+id/poi_coi_dynamic_info_fake_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/poi_coi_dynamic_info_tags"/>
    <com.bytedance.locallife.poi.newdetail.component.feed.coi.PoiCoiDynamicView
        android:gravity="center_vertical"
        android:id="@+id/poi_coi_dynamic_info_rating"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintBottom_toTopOf="@+id/poi_coi_dynamic_info_tags"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/poi_coi_dynamic_info_name"/>
    <com.bytedance.locallife.poi.newdetail.component.feed.coi.PoiCoiDynamicView
        android:gravity="center_vertical"
        android:id="@+id/poi_coi_dynamic_info_tags"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintBottom_toTopOf="@+id/poi_coi_dynamic_info_rank"
        app:layout_constraintEnd_toStartOf="@+id/poi_coi_dynamic_info_distance"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/poi_coi_dynamic_info_rating"/>
    <com.bytedance.locallife.poi.newdetail.component.feed.coi.PoiCoiDynamicView
        android:gravity="center_vertical"
        android:id="@+id/poi_coi_dynamic_info_spu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/poi_coi_dynamic_info_fake_view"/>
</merge>
