<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="38dp">
    <com.ss.android.lark.inline.ai.asr.subprompt.SubPromptTextView
        android:textSize="14sp"
        android:textColor="@color/text_caption"
        android:id="@+id/subprompt_text"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:lineHeight="22dp"/>
    <com.larksuite.component.ui.imageview.LKUIRoundedImageView2
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/subprompt_selected_iv"
        android:background="@drawable/ai_primary_fill_default"
        android:layout_width="20dp"
        android:layout_height="3dp"
        android:layout_marginBottom="3dp"
        android:scaleType="center"
        app:radius="1dp"/>
</FrameLayout>
