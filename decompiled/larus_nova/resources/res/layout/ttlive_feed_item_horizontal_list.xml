<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="68dp"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_cover"
        android:layout_width="54dp"
        android:layout_height="54dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_live_circle"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_live_circle"/>
    <com.bytedance.android.livesdkapi.view.SaasLiveCircleView
        android:id="@+id/iv_live_circle"
        android:padding="5dp"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:live_strokeWidth="1dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/live_tag_layout"
        android:background="@drawable/ttlive_feed_bg_follow_sky_live_tag"
        android:layout_width="40dp"
        android:layout_height="16dp"
        android:layout_marginTop="45dp"
        app:layout_constraintLeft_toLeftOf="@+id/iv_cover"
        app:layout_constraintRight_toRightOf="@+id/iv_cover"
        app:layout_constraintTop_toTopOf="@+id/iv_cover">
        <View
            android:background="@drawable/ttlive_ic_follow_live_tag"
            android:layout_width="8dp"
            android:layout_height="8dp"/>
        <TextView
            android:textSize="8dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_white"
            android:gravity="center_vertical"
            android:id="@+id/tv_live_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_feed_on_live"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/ttlive_feed_open_d2_67"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginTop="4dp"
        android:maxWidth="68dp"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/live_tag_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
