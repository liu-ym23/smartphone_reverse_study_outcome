<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:id="@+id/store_click_placeholder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="@+id/space_info_area"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.livecommerce.iron.ui.top.avatar.ECPromotionListShopAvatarView
        android:id="@+id/iv_store_avatar"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/space_info_area"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintLeft_toRightOf="@+id/iv_store_avatar"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginLeft="4dp"
        app:layout_goneMarginRight="4dp"/>
    <com.bytedance.android.livesdk.livecommerce.iron.listheader.IronListHeaderInfoLayout
        android:id="@+id/info_layout"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/space_info_area"
        app:layout_constraintStart_toStartOf="@+id/space_info_area"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.livecommerce.iron.listheader.IronListHeaderReputationLayout
        android:id="@+id/reputation_layout"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/space_info_area"
        app:layout_constraintStart_toStartOf="@+id/space_info_area"
        app:layout_constraintTop_toBottomOf="@+id/info_layout"/>
    <com.bytedance.android.livesdk.livecommerce.iron.listheader.IronListHeaderTagLayout
        android:id="@+id/tag_layout"
        android:paddingTop="4dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="20dp"
        app:layout_constraintEnd_toEndOf="@+id/space_info_area"
        app:layout_constraintStart_toStartOf="@+id/space_info_area"
        app:layout_constraintTop_toBottomOf="@+id/reputation_layout"/>
    <TextView
        android:textSize="@dimen/ec_dialog_title_text_size"
        android:textStyle="bold"
        android:textColor="@color/ec_color_black_text_level1"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/default_coupon_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/ec_live_promotion_default"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
