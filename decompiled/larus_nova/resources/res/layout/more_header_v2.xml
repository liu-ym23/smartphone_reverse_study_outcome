<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/facade_round_top_xxl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/bg_float_base">
    <com.larksuite.component.ui.imageview.LKUIRoundedImageView
        android:id="@+id/icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:scaleType="centerCrop"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        app:civ_radius="@dimen/space_kit_len_6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/footer"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:layout_constraintBottom_toBottomOf="@+id/icon"
        app:layout_constraintLeft_toLeftOf="@+id/icon"
        app:srcCompat="@drawable/ud_icon_wiki_shortcutarrow_colorful"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/title_container_wrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:id="@+id/title_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/dp_4"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/info_container_wrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="@dimen/space_kit_len_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toBottomOf="@+id/title_container_wrapper">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_caption"
            android:ellipsize="end"
            android:id="@+id/info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <View
            android:id="@+id/divider"
            android:background="@color/ud_divider_color"
            android:visibility="gone"
            android:layout_width="@dimen/space_kit_len_divider"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_kit_len_8"
            android:layout_marginEnd="@dimen/space_kit_len_8"
            app:layout_constraintStart_toEndOf="@+id/info"
            app:layout_constraintTop_toBottomOf="@+id/title_container_wrapper"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/fresh_icon"
            android:visibility="gone"
            android:layout_width="@dimen/space_kit_len_12"
            android:layout_height="@dimen/space_kit_len_12"
            android:layout_marginEnd="@dimen/space_kit_len_4"
            app:layout_constraintStart_toEndOf="@+id/divider"
            app:layout_constraintTop_toBottomOf="@+id/title_container_wrapper"
            app:srcCompat="@drawable/ud_icon_wiki_shortcutarrow_colorful"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_caption"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/state_desc"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/fresh_icon"
            app:layout_constraintTop_toBottomOf="@+id/title_container_wrapper"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/info_last_modified_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="@dimen/space_kit_len_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toBottomOf="@+id/info_container_wrapper">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_caption"
            android:ellipsize="end"
            android:id="@+id/info_last_modified"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <FrameLayout
        android:id="@+id/close"
        android:layout_width="@dimen/space_kit_len_40"
        android:layout_height="@dimen/space_kit_len_40"
        android:layout_marginTop="@dimen/space_kit_len_8"
        android:layout_marginEnd="@dimen/space_kit_len_8"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:layout_width="@dimen/space_kit_len_24"
            android:layout_height="@dimen/space_kit_len_24"
            android:tint="@color/widget_more_close_selector"
            app:srcCompat="@drawable/widget_more_close_circle_shape"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:clickable="false"
            android:layout_width="@dimen/space_kit_len_14"
            android:layout_height="@dimen/space_kit_len_14"
            android:scaleType="fitCenter"
            android:tint="@color/icon_n1"
            app:srcCompat="@drawable/ud_icon_close_bold_outlined"/>
    </FrameLayout>
    <View
        android:id="@+id/headerDivider"
        android:background="@color/line_divider_default"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_kit_len_half"
        android:layout_marginTop="9dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/info_last_modified_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
