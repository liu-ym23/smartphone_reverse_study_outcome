<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/poi_player_root_container"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.lighten.loader.SmartImageView
        android:id="@+id/poi_player_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ConstTextInverse"
        android:id="@+id/poi_player_bottom_text"
        android:padding="12dp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_valid_more_coupon"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <FrameLayout
        android:id="@+id/poi_player_sticky_footer_container"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
    <com.bytedance.locallife.poi.media.ui.VerticalOverScrollLayout
        android:id="@+id/poi_player_over_scroll_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/poi_player_sticky_footer_container">
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/poi_detail_player_view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.bytedance.locallife.poi.media.ui.VerticalOverScrollLayout>
    <com.bytedance.locallife.poi.media.ui.indicator.PoiVerticalPagerIndicator
        android:id="@+id/poi_player_pager_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"/>
    <ViewStub
        android:id="@+id/poi_player_guide_stub"
        android:layout="@layout/life_poi_media_lottie_guide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/poi_vr_model_guide_stub"
        android:layout="@layout/life_poi_media_vr_model_lottie_guide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
