<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lyric_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constrainedWidth="true"
    app:layout_constraintHorizontal_bias="1"
    app:layout_constraintLeft_toLeftOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <ImageView
        android:id="@+id/recognition_ai_iv"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="14dp"
        android:layout_marginLeft="1dp"
        android:layout_marginTop="3.5dp"
        android:src="@drawable/ttlive_ktv_speech_ai_lyric_icon"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.component.lyric.ViewPainter
        android:id="@+id/view_painter"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/recognition_ai_iv"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="9dp"
        android:textStyle="bold"
        android:textColor="#56ffffff"
        android:gravity="center_vertical"
        android:id="@+id/recognition_ai_tips"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginLeft="1dp"
        android:text="@string/ttlive_ktv_ai_lyrics_recognition_tips"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="@+id/view_painter"
        app:layout_constraintRight_toRightOf="@+id/view_painter"
        app:layout_constraintTop_toBottomOf="@+id/view_painter"/>
</androidx.constraintlayout.widget.ConstraintLayout>
