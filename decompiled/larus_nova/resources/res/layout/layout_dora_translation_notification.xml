<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <ImageView
                android:id="@+id/icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/larus_ic_notification_small"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_g_translate_liveactivity_title_cn"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/speaker_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/icon_speaker_si"/>
    </LinearLayout>
    <TextView
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:ellipsize="start"
        android:gravity="start"
        android:id="@+id/translation_content"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Listneing....."
        android:maxLines="3"/>
</LinearLayout>
