<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ec.window.base.widget.WindowRoundedLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/store_product_card"
    android:background="@color/shopping_std_bg_primary_white"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ec_window_product_video_hanging_video"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="3:4"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/ec_window_layout_holder_explain_recommend_video_double"/>
        <FrameLayout
            android:id="@+id/ec_shop_tag_wrapper"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/store_product_card_content_container"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <FrameLayout
            android:id="@+id/window_product_card_recommend_area"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ec_window_sub_text_color"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/store_product_card_recommend_info"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"/>
        <com.bytedance.android.ec.window.base.widget.WindowBreakWordTextView
            android:textSize="14dp"
            android:textColor="@color/shopping_std_text_black_1"
            android:ellipsize="end"
            android:id="@+id/store_product_card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
        <LinearLayout
            android:id="@+id/store_product_card_extra_info_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedance.android.ec.window.base.product.widget.ECWindowTagFlowLayout
                android:id="@+id/store_product_card_tags_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:tag_maxline="1"
                app:tag_space_horizontal="4dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/store_product_card_price_wrapper"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_centerVertical="true">
            <com.bytedance.android.ec.core.widget.price.PriceView
                android:textSize="17dp"
                android:ellipsize="end"
                android:id="@+id/store_product_card_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:lineSpacingExtra="2dp"
                app:pv_hideYuanSymbol="false"
                app:pv_prefixMarginRight="4dp"
                app:pv_prefixTextBold="false"
                app:pv_prefixTextColor="@color/shopping_std_brand"
                app:pv_prefixTextSizeRatio="0.647"
                app:pv_priceBold="true"
                app:pv_priceTextColor="@color/shopping_std_brand"
                app:pv_yuanSymbolBold="false"
                app:pv_yuanSymbolMarginRight="1dp"
                app:pv_yuanSymbolRatioOfPriceTextSize="0.764"/>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/shopping_std_text_black_4"
                android:ellipsize="end"
                android:layout_gravity="start|bottom"
                android:id="@+id/store_product_card_sale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:baselineAlignBottom="true"
                android:maxLines="1"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/ec_window_product_bottom_dynamic_content_container"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</com.bytedance.android.ec.window.base.widget.WindowRoundedLinearLayout>
