<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.ee.bear.widgets.RecursionSetEnableFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:padding="2dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/widgetTitleMenuImg"
                android:layout_width="@dimen/bitable_app_menu_img_size"
                android:layout_height="@dimen/bitable_app_menu_img_size"/>
            <com.larksuite.component.ui.imageview.LKUILottieAnimationView
                android:layout_gravity="center_vertical"
                android:id="@+id/widgetTitleMenuLottie"
                android:visibility="gone"
                android:layout_width="@dimen/bitable_app_menu_img_size"
                android:layout_height="@dimen/bitable_app_menu_img_size"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_repeatMode="restart"/>
            <TextView
                android:textAppearance="@style/UDText.Title3"
                android:textSize="18sp"
                android:textColor="@color/icon_n1"
                android:gravity="center"
                android:id="@+id/widgetTitleMenuImgText"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/bitable_app_menu_img_size"
                android:layout_marginLeft="4dp"
                android:maxLines="1"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <com.larksuite.component.universe_design.badge.UDBadgeView
            android:id="@+id/widgetTitleMenuBadgePoint"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="19dp"
            android:layout_marginTop="-5dp"
            style="@style/UDBadge.Dot.StrongReminder.Medium"/>
        <com.larksuite.component.universe_design.badge.UDBadgeView
            android:id="@+id/widgetTitleMenuBadgeNumFrame"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-8dp"
            android:layout_marginStart="16dp"
            app:ud_badge_text="99"
            app:ud_badge_textMaxLength="2"
            style="@style/UDBadge.Text.Red"/>
    </FrameLayout>
</com.bytedance.ee.bear.widgets.RecursionSetEnableFrameLayout>
