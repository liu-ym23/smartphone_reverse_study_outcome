<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.common_ui.widget.ShadowLayout
        android:id="@+id/shadow_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ux_shadow_color="#1a000000"
        app:ux_shadow_offset_x="?attr/larus_dp_0"
        app:ux_shadow_offset_y="?attr/larus_dp_8"
        app:ux_shadow_size="?attr/larus_dp_24">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="?attr/larus_dp_32">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/share_single_image_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@color/larus_base_1_overlay"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_video_duration"
                android:background="@drawable/larus_bg_single_share_video_duration"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="?attr/larus_dp_24"
                android:layout_marginTop="?attr/larus_dp_10"
                android:layout_marginEnd="?attr/larus_dp_10"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="?attr/larus_sp_12"
                    android:textColor="@color/larus_static_white"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_video_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="?attr/larus_dp_10"
                    android:layout_marginEnd="?attr/larus_dp_3"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="?attr/larus_dp_12"
                    android:layout_height="?attr/larus_dp_12"
                    android:src="@drawable/larus_share_video_duration_icon"
                    android:layout_marginEnd="?attr/larus_dp_5"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.larus.common_ui.widget.ShadowLayout>
    <ProgressBar
        android:id="@+id/progress"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        android:indeterminate="true"
        android:indeterminateTint="@color/larus_neutral_50"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.AppCompat.ProgressBar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
