<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/full_page_container_root"
    android:background="@color/cj_pay_color_trans"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.android.ttcjpaysdk.base.ui.component.pop.CJImageView
        android:id="@+id/background_iv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:foregroundGravity="top"/>
    <FrameLayout
        android:id="@+id/view_contianer"
        android:background="@color/cj_pay_color_trans"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.android.ttcjpaysdk.base.framework.container.view.base.CJPayAnyView
        android:id="@+id/hybrid_card"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.android.ttcjpaysdk.base.framework.container.view.base.CJPayAnyView
        android:id="@+id/std_loading_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.android.ttcjpaysdk.base.framework.container.view.base.CJPayAnyView
        android:id="@+id/full_page_error_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.android.ttcjpaysdk.base.framework.container.view.base.CJPayAnyView
        android:id="@+id/full_page_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.android.ttcjpaysdk.base.ui.component.CJTextView
        android:textSize="10sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_gravity="end|bottom"
        android:id="@+id/container_label"
        android:background="@color/cj_pay_color_blue_245DF1_opacity_50"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="cj-std"/>
</FrameLayout>
