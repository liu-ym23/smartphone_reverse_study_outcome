<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.interactivity.api.DragContainer xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_root"
        android:background="@drawable/ttlive_bg_announcement_highlight_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="103dp">
        <TextView
            android:textSize="11dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_color_161823"
            android:ellipsize="end"
            android:id="@+id/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxWidth="70dp"
            android:maxLines="2"
            android:layout_marginStart="16dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/btn_close"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ttlive_icon_announcement_highlight_cloe_2"
            android:contentDescription="@string/ttlive_advance_announcement_close_content_description"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="24dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_color_161823"
            android:id="@+id/text_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="12dp"
            android:letterSpacing="0.12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_title"/>
        <View
            android:id="@+id/divider"
            android:background="@color/ttlive_color_1F_161823"
            android:layout_width="0dp"
            android:layout_height="0.5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_time"/>
        <LinearLayout
            android:id="@+id/fl_audience_subscribe_info"
            android:paddingLeft="15dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:contentDescription="@string/ttlive_announcement_highlight_subscribe_content_description"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_subscribed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ttlive_icon_announcement_bell"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/ttlive_official_quality_font_selected"
                android:gravity="center"
                android:id="@+id/btn_subscribe"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginLeft="6dp"
                android:text="@string/ttlive_subscribe_broadcaster"
                android:importantForAccessibility="no"/>
        </LinearLayout>
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/ll_anchor_subscribe_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider">
            <TextView
                android:textSize="13dp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_announcement_highlight_color_161823"
                android:id="@+id/text_subscribe_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/ttlive_announcement_highlight_title_color_audience"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_announcement_highlight_subscribe_count_suffix"
                android:layout_alignBaseline="@+id/text_subscribe_count"
                android:layout_marginStart="2dp"
                android:layout_toEndOf="@+id/text_subscribe_count"/>
        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.bytedance.android.livesdk.interactivity.api.DragContainer>
