<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/ec_store_loading_skeleton_list_card"
    android:paddingBottom="0dp"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <View
            android:background="@drawable/ec_store_loading_skeleton_pill"
            android:layout_width="48dp"
            android:layout_height="24dp"/>
        <Space
            android:layout_width="24dp"
            android:layout_height="1dp"/>
        <View
            android:background="@drawable/ec_store_loading_skeleton_pill"
            android:layout_width="48dp"
            android:layout_height="24dp"/>
        <Space
            android:layout_width="24dp"
            android:layout_height="1dp"/>
        <View
            android:background="@drawable/ec_store_loading_skeleton_pill"
            android:layout_width="48dp"
            android:layout_height="24dp"/>
        <Space
            android:layout_width="24dp"
            android:layout_height="1dp"/>
        <View
            android:background="@drawable/ec_store_loading_skeleton_pill"
            android:layout_width="48dp"
            android:layout_height="24dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_marginTop="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <View
            android:background="@drawable/ec_store_loading_skeleton_filter_pill"
            android:layout_width="32dp"
            android:layout_height="20dp"/>
        <Space
            android:layout_width="18dp"
            android:layout_height="1dp"/>
        <View
            android:background="@drawable/ec_store_loading_skeleton_filter_pill"
            android:layout_width="32dp"
            android:layout_height="20dp"/>
        <Space
            android:layout_width="18dp"
            android:layout_height="1dp"/>
        <View
            android:background="@drawable/ec_store_loading_skeleton_filter_pill"
            android:layout_width="32dp"
            android:layout_height="20dp"/>
        <Space
            android:layout_width="18dp"
            android:layout_height="1dp"/>
        <View
            android:background="@drawable/ec_store_loading_skeleton_filter_pill"
            android:layout_width="32dp"
            android:layout_height="20dp"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <View
            android:background="@drawable/ec_store_loading_skeleton_circle"
            android:layout_width="18dp"
            android:layout_height="18dp"/>
        <Space
            android:layout_width="8dp"
            android:layout_height="1dp"/>
        <View
            android:background="@drawable/ec_store_loading_skeleton_circle"
            android:layout_width="18dp"
            android:layout_height="18dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="76dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="265dp">
            <View
                android:background="@drawable/ec_store_loading_skeleton_tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <Space
                android:layout_width="7dp"
                android:layout_height="1dp"/>
            <View
                android:background="@drawable/ec_store_loading_skeleton_tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
        </LinearLayout>
        <Space
            android:layout_width="match_parent"
            android:layout_height="7dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="265dp">
            <View
                android:background="@drawable/ec_store_loading_skeleton_tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <Space
                android:layout_width="7dp"
                android:layout_height="1dp"/>
            <View
                android:background="@drawable/ec_store_loading_skeleton_tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
