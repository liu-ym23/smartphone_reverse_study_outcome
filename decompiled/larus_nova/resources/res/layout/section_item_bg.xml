<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_16">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/list_icon_img"
                android:layout_width="12sp"
                android:layout_height="12sp"
                android:src="@drawable/ud_icon_expand_down_filled"
                android:tint="@color/icon_n2"
                android:layout_marginEnd="@dimen/dp_8d5"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/section_source_icon"
                android:layout_width="16sp"
                android:layout_height="16sp"
                android:tint="@color/icon_n1"
                android:layout_marginEnd="@dimen/dp_8d5"/>
            <com.larksuite.framework.ui.SpareLayout
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/dp_16">
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:textColor="@color/text_title"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/list_icon_title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_weight="1"/>
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/member_one_container"
                    android:background="@drawable/todo_card_owner_item_bg"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.larksuite.component.universe_design.image.UDAvatar
                        android:id="@+id/member_avatar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:src="@drawable/todo_at_all"
                        app:ud_avatar_size="20sp"
                        style="@style/UDAvatar.Circle"/>
                    <TextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/text_title"
                        android:layout_gravity="center"
                        android:id="@+id/member_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="170dp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:layout_marginStart="@dimen/dp_8"/>
                </LinearLayout>
                <com.ss.android.lark.todo.impl.features.common.widget.TaskUDAvatarList
                    android:layout_gravity="center_vertical"
                    android:id="@+id/task_members"
                    android:background="@drawable/todo_section_owners_item_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:task_ud_avatarList_avatarSize="24sp"
                    app:task_ud_avatarList_maxCount="5"
                    app:task_ud_avatarList_overlapSize="@dimen/dp_4"
                    app:task_ud_avatarList_text_size="@dimen/dp_10"/>
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/sp_16"
                        android:textColor="@color/text_placeholder"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/list_icon_count_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp_6"/>
                    <com.larksuite.component.ui.imageview.LKUIBadgeView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/list_icon_count_red_badge"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp_6"
                        app:badgeBackground="@drawable/badge_orange_single_count_bg_no_stroke"
                        app:textColor="@color/static_white"
                        app:textSize="11sp"/>
                </LinearLayout>
            </com.larksuite.framework.ui.SpareLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/more"
            android:padding="10sp"
            android:layout_width="36sp"
            android:layout_height="36sp"
            android:src="@drawable/ud_icon_more_outlined"
            android:tint="@color/icon_n2"/>
    </LinearLayout>
    <View
        android:id="@+id/divider_todo_item"
        android:background="@color/line_divider_default"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
</LinearLayout>
