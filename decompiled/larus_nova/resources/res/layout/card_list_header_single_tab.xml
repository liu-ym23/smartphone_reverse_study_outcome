<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:id="@+id/tab_text_ll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="16sp"
                android:textColor="#bf161823"
                android:id="@+id/tab_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#bf161823"
                android:id="@+id/count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tab_text"
                app:layout_constraintTop_toTopOf="parent"/>
        </LinearLayout>
        <View
            android:id="@+id/tab_hint_dot"
            android:visibility="gone"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginBottom="-7dp"
            android:layout_above="@+id/tab_text_ll"
            android:layout_marginStart="-1dp"
            android:layout_toEndOf="@+id/tab_text_ll"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/tab_hint_text"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginBottom="-7dp"
            android:minWidth="14dp"
            android:layout_above="@+id/tab_text_ll"
            android:layout_marginStart="-7dp"
            android:layout_toEndOf="@+id/tab_text_ll"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/tab_hint_pic"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="-7dp"
            android:scaleType="fitXY"
            android:layout_above="@+id/tab_text_ll"
            android:layout_marginStart="-7dp"
            android:layout_toEndOf="@+id/tab_text_ll"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
