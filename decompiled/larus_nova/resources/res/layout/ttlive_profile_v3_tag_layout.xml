<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/profile_tag_view"
    android:background="@drawable/ttlive_bg_profile_light_gray_bg_color"
    android:paddingLeft="6dp"
    android:paddingRight="6dp"
    android:layout_width="wrap_content"
    android:layout_height="18dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/profile_tag_image_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="18dp"/>
    <ImageView
        android:id="@+id/profile_tag_view_icon"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/ttlive_new_profile_50black"
        android:ellipsize="end"
        android:id="@+id/profile_tag_view_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginStart="2dp"/>
    <ImageView
        android:id="@+id/profile_tag_view_arrow"
        android:visibility="gone"
        android:layout_width="4dp"
        android:layout_height="7dp"
        android:src="@drawable/ttlive_profile_certification_arrow_white"
        android:layout_marginStart="6dp"/>
    <ImageView
        android:id="@+id/profile_verify_tag_view_arrow"
        android:visibility="gone"
        android:layout_width="5dp"
        android:layout_height="8dp"
        android:src="@drawable/ttlive_profile_certification_arrow_white"
        android:alpha="0.7"
        android:layout_marginStart="2dp"/>
</LinearLayout>
