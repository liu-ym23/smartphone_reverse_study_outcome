<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <include
            android:id="@+id/music_content_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/main_content"
            app:layout_constraintStart_toStartOf="@+id/main_content"
            app:layout_constraintTop_toTopOf="@+id/main_content"
            layout="@layout/ttlive_ktv_sung_music_content"/>
        <View
            android:id="@+id/favorite"
            android:background="@drawable/ttlive_ktv_selected_music_star_grey"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/main_content"
            app:layout_constraintEnd_toStartOf="@+id/select_music_btn"
            app:layout_constraintTop_toTopOf="@+id/main_content"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/select_music_btn"
            android:background="@drawable/ttlive_bg_ktv_red_bt"
            android:layout_width="64dp"
            android:layout_height="28dp"
            android:layout_marginRight="16dp"
            android:text="@string/ttlive_ktv_tab_select"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/main_content"
            app:layout_constraintEnd_toEndOf="@+id/main_content"
            app:layout_constraintTop_toTopOf="@+id/main_content"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/gl_left"
        android:layout_width="0.1dp"
        android:layout_height="match_parent"
        app:layout_constraintGuide_begin="0dp"/>
    <TextView
        android:textSize="14dp"
        android:gravity="center"
        android:id="@+id/tv_pos"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="@+id/gl_right"
        app:layout_constraintStart_toStartOf="@+id/gl_left"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/gl_right"
        android:layout_width="0.1dp"
        android:layout_height="match_parent"
        app:layout_constraintGuide_begin="32dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_ktv_empty_view_color"
        android:id="@+id/footer_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/ttlive_ktv_panel_no_more_recent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
