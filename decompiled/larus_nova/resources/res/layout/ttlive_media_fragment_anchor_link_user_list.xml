<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
            android:layout_gravity="center_horizontal"
            android:id="@+id/preload_progress_icon_double_ball"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:indeterminate="true"
            android:indeterminateBehavior="repeat"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/tv_empty"
            android:paddingBottom="20dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_media_live_interact_user_list_tip1"/>
        </LinearLayout>
        <com.bytedance.android.live.ui.PkInviteUserListRefreshLayout
            android:id="@+id/userlist_swipe_refresh_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="10dp">
                <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
                    android:layout_gravity="center"
                    android:id="@+id/userlist_refresh_progress_double_ball"
                    android:visibility="gone"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="10dp"
                    android:indeterminate="true"
                    android:indeterminateBehavior="repeat"/>
            </FrameLayout>
            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.bytedance.android.livesdk.interactivity.medialink.dialog.ui.MediaLinkAnchorItemExposeRecyclerView
                    android:id="@+id/recycler_view"
                    android:background="@color/ttlive_core_hs_w1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
            </androidx.coordinatorlayout.widget.CoordinatorLayout>
        </com.bytedance.android.live.ui.PkInviteUserListRefreshLayout>
    </LinearLayout>
    <TextView
        android:textSize="11dp"
        android:textStyle="normal"
        android:textColor="#4d000000"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/private_hint"
        android:background="@color/ttlive_core_hs_w1"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:translationZ="10dp"
        android:elevation="10dp"/>
</FrameLayout>
