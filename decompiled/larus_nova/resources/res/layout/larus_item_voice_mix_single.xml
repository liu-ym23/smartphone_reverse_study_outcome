<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/voice_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/voice_user_name"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/voice_user_name">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/play_icon"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:src="@drawable/larus_ic_speaker"/>
        <com.lynx.lottieadapter.LottieAdapterView
            android:id="@+id/play_lottie"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            app:lottie_fileName="lottie/text_msg_voice_playing.json"
            app:lottie_loop="true"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_16"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/voice_user_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_weight="1"
        android:textAlignment="viewStart"
        android:layout_marginStart="?attr/larus_dp_12"
        app:layout_constraintLeft_toRightOf="@+id/voice_icon"
        app:layout_constraintRight_toLeftOf="@+id/expand_voice_icon_primary"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/expand_voice_icon_primary"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/larus_accessibility_voice_voiceControlCollapse"
        android:paddingStart="?attr/larus_dp_12"
        android:paddingEnd="?attr/larus_dp_12"
        android:layout_marginStart="?attr/larus_dp_4"
        app:layout_constraintBottom_toBottomOf="@+id/voice_icon"
        app:layout_constraintRight_toLeftOf="@+id/voice_remove"
        app:layout_constraintTop_toTopOf="@+id/voice_icon"
        app:srcCompat="?attr/larus_ic_expand_voice_item"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/voice_remove"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="?attr/larus_dp_12"
        android:paddingEnd="?attr/larus_dp_0"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/voice_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/voice_icon"
        app:srcCompat="@drawable/larus_ic_voice_remove"/>
    <LinearLayout
        android:gravity="start"
        android:id="@+id/voice_empty"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_2"
        android:layout_marginEnd="?attr/larus_dp_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:src="?attr/larus_ic_speaker_slash"
            android:layout_marginStart="?attr/larus_dp_16"/>
        <TextView
            android:textSize="?attr/larus_dp_16"
            android:textStyle="bold"
            android:textColor="?attr/larus_neutral_50"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_modify_bot_voice_empty"
            android:layout_marginStart="?attr/larus_dp_12"/>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:background="?attr/larus_neutral_transparent_2"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_1"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/expand_voice_icon_primary"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_16"
        app:layout_constraintTop_toBottomOf="@+id/voice_user_name"/>
</merge>
