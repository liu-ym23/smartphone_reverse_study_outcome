<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/audioContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.bytedance.android.livesdk.chatroom.ui.NoMoreSpaceTextView
            android:textSize="18dp"
            android:gravity="center_vertical"
            android:id="@+id/name"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:lineSpacingExtra="3sp"
            android:textIsSelectable="false"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/audioPlay"
            android:paddingTop="2dp"
            android:paddingBottom="5dp"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/name"
            app:layout_constraintHeight_max="14dp"
            app:layout_constraintLeft_toRightOf="@+id/name"
            app:layout_constraintTop_toTopOf="@+id/name"
            app:lottie_autoPlay="false"
            app:lottie_loop="true"/>
        <com.bytedance.android.livesdk.chatroom.ui.NoMoreSpaceTextView
            android:textSize="18dp"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/audioDuration"
            android:paddingLeft="5dp"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:textIsSelectable="false"
            android:textAlignment="viewStart"
            android:paddingStart="5dp"
            app:layout_constraintBottom_toBottomOf="@+id/audioPlay"
            app:layout_constraintLeft_toRightOf="@+id/audioPlay"
            app:layout_constraintTop_toTopOf="@+id/audioPlay"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/userLabel"
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            android:layout_marginLeft="8dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/audioDuration"
            app:layout_constraintLeft_toRightOf="@+id/audioDuration"
            app:layout_constraintTop_toTopOf="@+id/audioDuration"/>
        <com.bytedance.android.livesdk.chatroom.ui.NoMoreSpaceTextView
            android:textSize="14dp"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/audioContent"
            android:paddingTop="2dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:textIsSelectable="false"
            android:textAlignment="viewStart"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/audioPlay"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/audioSending"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:src="@drawable/ttlive_comment_audio_sending"
        android:layout_marginStart="4dp"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/audioFail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:src="@drawable/ttlive_comment_audio_send_failed"
        android:layout_marginStart="4dp"/>
</LinearLayout>
