<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="?android:attr/selectableItemBackground"
    android:paddingTop="8dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp_16"
    android:paddingEnd="@dimen/dp_16">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_weight="1">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/image_field_icon"
            android:layout_width="16sp"
            android:layout_height="16sp"
            android:tint="@color/icon_n3"
            android:layout_marginEnd="@dimen/dp_12"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_caption"
            android:ellipsize="end"
            android:id="@+id/text_field_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="92dp"
            android:singleLine="true"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/layout_field_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:layout_marginStart="@dimen/dp_12">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_title"
            android:ellipsize="end"
            android:id="@+id/text_field_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_rich_text_field_value"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <com.ss.android.lark.widget.EllipsizeFrameLayout
                android:layout_gravity="start"
                android:id="@+id/ellipsize_layout_text_field_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:enableEllipsize="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.ss.android.lark.widget.richtext.RichTextView
                    android:id="@+id/rich_text_field_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:richTextColor="@color/text_title"
                    app:richTextSize="@dimen/sp_14"/>
            </com.ss.android.lark.widget.EllipsizeFrameLayout>
            <View
                android:layout_gravity="bottom"
                android:id="@+id/text_field_value_gradient_mask"
                android:background="@drawable/todo_bg_gradient_white"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_100"
                app:layout_constraintBottom_toBottomOf="@+id/ellipsize_layout_text_field_value"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/primary_fill_default"
                android:id="@+id/text_field_value_more"
                android:padding="@dimen/dp_6"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Todo_Task_ShowMore"
                app:layout_constraintBottom_toBottomOf="@+id/text_field_value_gradient_mask"
                app:layout_constraintRight_toRightOf="@+id/ellipsize_layout_text_field_value"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <include
            android:id="@+id/layout_field_avatar"
            android:visibility="gone"
            layout="@layout/todo_avatar_list_item_small"/>
        <com.larksuite.framework.ui.flowlayout.TagFlowLayout
            android:id="@+id/layout_field_tag"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</LinearLayout>
