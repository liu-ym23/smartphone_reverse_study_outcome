<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:background="@drawable/ttlive_bg_message_item_v2"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/ttlive_avatar_view"
        android:background="@drawable/ttlive_ic_withdraw_default_avatar"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAsCircle="true"/>
    <com.bytedance.android.livesdk.chatroom.ui.NoMoreSpaceTextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_std_text_white_1"
        android:ellipsize="end"
        android:id="@+id/anchor_nick_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:maxLines="1"
        android:maxEms="7"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@+id/ttlive_avatar_view"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/authentication_view"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginLeft="4dp"
        android:layout_marginStart="4dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/anchor_nick_name"
        app:layout_constraintStart_toEndOf="@+id/anchor_nick_name"
        app:layout_constraintTop_toTopOf="@+id/anchor_nick_name"
        app:roundAsCircle="true"/>
    <com.bytedance.android.livesdk.chatroom.ui.NoMoreSpaceTextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_std_text_white_1"
        android:gravity="top"
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="0dp"
        android:textIsSelectable="false"
        android:textAlignment="viewStart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/anchor_nick_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
