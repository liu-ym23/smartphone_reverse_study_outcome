<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/noPermissionContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="40dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_no_access"
            android:layout_width="125dp"
            android:layout_height="125dp"
            app:srcCompat="@drawable/illustration_empty_neutral_no_access"/>
        <TextView
            android:textAppearance="@style/UDText.Title3"
            android:textColor="@color/text_title"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/Lark_Conditions_NoPermission"/>
        <TextView
            android:textAppearance="@style/UDText.Body2"
            android:textColor="@color/text_caption"
            android:gravity="center"
            android:id="@+id/tv_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/Lark_Conditions_DeviceUnsure"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"/>
        <TextView
            android:textAppearance="@style/UDText.Body2"
            android:textColor="@color/text_caption"
            android:gravity="center"
            android:id="@+id/tv_sub_hint"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/area_reason"
            android:background="@drawable/scs_bg_grey_card"
            android:padding="@dimen/dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/scs_grey_dot"/>
                <TextView
                    android:textAppearance="@style/UDText.Headline"
                    android:textColor="@color/text_title"
                    android:id="@+id/tv_reason"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Lark_Conditions_DeviceBelonging"
                    android:layout_marginStart="@dimen/dp_12"/>
            </LinearLayout>
            <TextView
                android:textAppearance="@style/UDText.Body2"
                android:textColor="@color/text_caption"
                android:id="@+id/tv_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_2"
                android:text="@string/Lark_Conditions_Personal"
                android:layout_marginStart="18dp"/>
        </LinearLayout>
        <com.larksuite.component.universe_design.button.UDButton
            android:textAppearance="@style/UDText.Title4"
            android:textColor="@color/static_white"
            android:id="@+id/btn_primary"
            android:visibility="gone"
            android:clickable="true"
            android:layout_marginTop="24dp"
            android:text="@string/Lark_Conditions_DeviceApply"
            app:ud_backgroundColor="@color/ud_button_blue_bg"
            app:ud_strokeWidth="1dp"
            style="@style/UDButton.Big.Column"/>
        <com.larksuite.component.universe_design.button.UDButton
            android:textAppearance="@style/UDText.Title4"
            android:textColor="@color/text_title"
            android:id="@+id/btn_retry"
            android:clickable="true"
            android:layout_marginTop="16dp"
            android:text="@string/Lark_Conditions_VisitAgain"
            app:ud_backgroundColor="@color/ud_button_white_grey_bg"
            app:ud_strokeColor="@color/line_border_component"
            app:ud_strokeWidth="1dp"
            style="@style/UDButton.Big.Column"/>
    </LinearLayout>
    <WebView
        android:id="@+id/webView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/loading_view"
        android:visibility="gone"
        layout="@layout/scs_widget_loading_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
