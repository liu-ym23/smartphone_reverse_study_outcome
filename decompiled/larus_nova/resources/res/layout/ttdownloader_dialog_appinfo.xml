<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/ttdownloader_bg_appinfo_dialog"
    android:layout_width="300dp"
    android:layout_height="wrap_content">
    <com.ss.android.downloadlib.guide.install.ClipImageView
        android:id="@+id/iv_app_icon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="32dp"
        android:scaleType="centerCrop"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:id="@+id/tv_app_name"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#999999"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_app_version"
        android:layout_width="216dp"
        android:layout_height="16dp"
        android:layout_marginTop="8dp"
        android:maxLines="1"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#999999"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_app_developer"
        android:layout_width="216dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp">
        <TextView
            android:textSize="12sp"
            android:textColor="#161823"
            android:id="@+id/tv_app_desc"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:text="@string/compliance_dialog_function_button_text"/>
        <View
            android:background="#d8d8d8"
            android:layout_width="1dp"
            android:layout_height="10dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#161823"
            android:id="@+id/tv_app_detail"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:text="@string/compliance_dialog_permission_button_text"/>
        <View
            android:background="#d8d8d8"
            android:layout_width="1dp"
            android:layout_height="10dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#161823"
            android:id="@+id/tv_app_privacy"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:text="@string/compliance_dialog_privacy_button_text"/>/&gt; 
        <View
            android:id="@+id/tv_divider"
            android:background="#d8d8d8"
            android:layout_width="1dp"
            android:layout_height="10dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#161823"
            android:id="@+id/tv_reg_info"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:text="备案"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/ll_download_dialog"
        android:background="@drawable/ttdownloader_bg_appinfo_btn"
        android:layout_width="276dp"
        android:layout_height="36dp"
        android:layout_marginTop="19dp"
        android:text="@string/compliance_dialog_click_start_btn_text"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#999999"
        android:gravity="center"
        android:id="@+id/tv_give_up"
        android:layout_width="276dp"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:text="放弃下载"/>
</LinearLayout>
