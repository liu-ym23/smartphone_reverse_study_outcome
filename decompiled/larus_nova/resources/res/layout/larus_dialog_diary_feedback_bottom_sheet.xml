<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_dora_bg_top_round_base_3_overlay"
    android:paddingBottom="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="?attr/larus_sp_18"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/dora_feedback_sheet_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_18"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/dora_feedback_sheet_close_image"
        android:padding="?attr/larus_dp_6"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="?attr/larus_dp_32"
        android:layout_height="?attr/larus_dp_32"
        android:layout_marginTop="?attr/larus_dp_12"
        android:src="?attr/larus_ic_close"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/dora_feedback_sheet_reason_chip_group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:chipSpacingHorizontal="?attr/larus_dp_8"
        app:chipSpacingVertical="?attr/larus_dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dora_feedback_sheet_title_text"/>
    <EditText
        android:textSize="?attr/larus_sp_16"
        android:textColor="@color/larus_neutral_100"
        android:textColorHint="@color/larus_neutral_50"
        android:gravity="start|top"
        android:id="@+id/dora_feedback_sheet_input_edit"
        android:background="@drawable/larus_dora_bg_round_base_4"
        android:padding="?attr/larus_dp_16"
        android:scrollbars="vertical"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_140"
        android:layout_marginTop="?attr/larus_dp_16"
        android:inputType="textMultiLine"
        android:overScrollMode="ifContentScrolls"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dora_feedback_sheet_reason_chip_group"/>
    <TextView
        android:textSize="?attr/larus_sp_16"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/dora_feedback_sheet_submit_text"
        android:background="@drawable/larus_bg_diary_feedback_submit_disabled"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_48"
        android:layout_marginTop="?attr/larus_dp_20"
        android:text="@string/larus_dislike_feedback_submit"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dora_feedback_sheet_input_edit"/>
</androidx.constraintlayout.widget.ConstraintLayout>
