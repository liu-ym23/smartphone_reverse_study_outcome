<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_view"
        android:background="@drawable/ttlive_bg_cash_exchange_dialog_gift"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-56dp"
        android:layout_below="@+id/gift_icon">
        <TextView
            android:textSize="19dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_cash_exchange_gift_dialog_title"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="71dp"
            android:text="@string/ttlive_cash_exchange_gift_send_title"
            android:includeFontPadding="false"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/ttlive_cash_exchange_gift_dialog_content"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/ttlive_cash_exchange_content"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="8dp">
            <ToggleButton
                android:id="@+id/toggle_btn"
                android:background="@drawable/ttlive_bg_cash_exchange_dialog_cb"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:textOn=""
                android:textOff=""/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ttlive_cash_exchange_gift_dialog_tip"
                android:id="@+id/toggle_btn_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:text="@string/ttlive_cash_exchange_gift_send_not_tip"
                android:includeFontPadding="false"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/button_layout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp">
            <Button
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_cash_exchange_gift_dialog_cencel_btn"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/button_left"
                android:background="@drawable/ttlive_bg_cash_exchange_dialog_btn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/ttlive_cancel"
                android:maxLines="1"
                android:lines="1"
                android:layout_weight="1"
                android:alpha="0.5"
                android:textAllCaps="false"/>
            <View
                android:layout_width="7dp"
                android:layout_height="match_parent"/>
            <Button
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_cash_exchange_gift_dialog_confirm_btn"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/button_right"
                android:background="@drawable/ttlive_bg_cash_exchange_dialog_btn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/ttlive_done"
                android:maxLines="1"
                android:lines="1"
                android:layout_weight="1"
                android:textAllCaps="false"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/icon_bg_view"
        android:layout_width="173dp"
        android:layout_height="162dp"
        android:src="@drawable/ttlive_cash_exchange_gift_dialog_top"
        android:layout_centerHorizontal="true"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/gift_icon"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
