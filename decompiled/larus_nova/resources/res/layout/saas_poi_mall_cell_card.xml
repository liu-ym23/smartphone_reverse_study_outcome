<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.locallife.dito.baseview.RoundRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/poi_mall_cell_card_1392223896"
    android:background="@color/POIBgPrimary"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/poi_mall_cell_split_line"
        android:background="@color/POILineSecondary"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="0.5dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
    <LinearLayout
        android:id="@+id/cell_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.ss.android.ugc.aweme.views.RoundedLinearLayout
            android:orientation="vertical"
            android:id="@+id/poi_cover_container"
            android:layout_width="98dp"
            android:layout_height="wrap_content"
            app:rounded_radius="4dp">
            <com.bytedance.locallife.dito.baseview.RoundFrameLayout
                android:layout_width="86dp"
                android:layout_height="86dp">
                <com.bytedance.lighten.loader.SmartImageView
                    android:id="@+id/img_poi_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:placeholderImage="@color/BGPlaceholderDefault"
                    app:placeholderImageScaleType="centerCrop"
                    app:roundedCornerRadius="4dp"
                    app:viewAspectRatio="1"/>
                <View
                    android:id="@+id/cover_mask"
                    android:background="@drawable/poi_coi_image_mask_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.bytedance.locallife.dito.baseview.RoundFrameLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/seckill_layout"
                android:background="@drawable/poi_mall_seckill_bg"
                android:visibility="gone"
                android:layout_width="94dp"
                android:layout_height="16dp"
                android:layout_marginTop="13dp">
                <TextView
                    android:textSize="10dp"
                    android:textStyle="bold"
                    android:textColor="#fe2c55"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/seckill_words"
                    android:paddingTop="1dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"/>
                <TextView
                    android:textSize="10dp"
                    android:textStyle="bold"
                    android:textColor="#fe2c55"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/seckill_time"
                    android:paddingTop="1dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"/>
            </LinearLayout>
        </com.ss.android.ugc.aweme.views.RoundedLinearLayout>
        <com.bytedance.locallife.dito.baseview.RoundLinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/poi_info_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.bytedance.dux.text.DuxTextView
                    android:textSize="15sp"
                    android:textColor="@color/POITextPrimary"
                    android:ellipsize="end"
                    android:id="@+id/tv_poi_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"/>
                <com.bytedance.dux.text.DuxTextView
                    android:textSize="11sp"
                    android:textColor="#ff711f"
                    android:layout_gravity="right"
                    android:id="@+id/tv_poi_label"
                    android:background="@drawable/poi_bg_mall_poi_label"
                    android:paddingLeft="4dp"
                    android:paddingTop="2dp"
                    android:paddingRight="4dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/category_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <com.bytedance.dux.text.DuxTextView
                        android:textSize="12sp"
                        android:textColor="@color/POITextTertiary2"
                        android:id="@+id/tv_backend_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"/>
                    <com.bytedance.dux.text.DuxTextView
                        android:textSize="12sp"
                        android:textColor="@color/POITextTertiary2"
                        android:ellipsize="end"
                        android:id="@+id/tv_ave_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_marginEnd="8dp"/>
                </LinearLayout>
                <com.bytedance.dux.text.DuxTextView
                    android:textSize="12sp"
                    android:textColor="@color/POITextTertiary"
                    android:gravity="end"
                    android:id="@+id/tv_floor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <com.bytedance.locallife.dito.baseview.RoundLinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/identify_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="18dp">
                <com.bytedance.locallife.dito.baseview.RoundLinearLayout
                    android:gravity="center_vertical"
                    android:id="@+id/rank_container"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="4dp"
                    app:rounded_radius="2dp">
                    <com.facebook.drawee.view.SimpleDraweeView
                        android:id="@+id/rank_view"
                        android:background="@drawable/poi_rank_icon_light"
                        android:layout_width="18sp"
                        android:layout_height="18sp"/>
                    <com.bytedance.dux.text.DuxTextView
                        android:textSize="10sp"
                        android:textColor="#a66237"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_rank_text"
                        android:background="#fcefe1"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:maxLines="1"/>
                </com.bytedance.locallife.dito.baseview.RoundLinearLayout>
                <com.bytedance.dux.text.DuxTextView
                    android:textSize="10sp"
                    android:textColor="@color/POITextTertiary"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_recommend_percent"
                    android:background="@drawable/poi_bg_mall_card_want_go"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:maxLines="1"/>
            </com.bytedance.locallife.dito.baseview.RoundLinearLayout>
            <com.bytedance.locallife.dito.baseview.RoundLinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/comments_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <com.bytedance.locallife.poi.newdetail.widget.CircleImageView
                    android:id="@+id/img_avatar"
                    android:layout_width="16sp"
                    android:layout_height="16sp"
                    android:contentDescription="@string/poi_item_ugc_user_avatar"
                    app:failureImage="@color/POIBgInput"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:placeholderImage="@color/POIBgInput"/>
                <com.bytedance.dux.text.DuxTextView
                    android:textSize="12sp"
                    android:textColor="#e6161823"
                    android:gravity="center_vertical"
                    android:paddingLeft="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/quotation_left"
                    android:maxLines="1"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.bytedance.dux.text.DuxTextView
                        android:textSize="12sp"
                        android:textColor="#e6161823"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_highlight_review"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_weight="1"/>
                    <com.bytedance.dux.text.DuxTextView
                        android:textSize="12sp"
                        android:textColor="#e6161823"
                        android:gravity="center_vertical"
                        android:paddingRight="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/quotation_right"
                        android:maxLines="1"/>
                </LinearLayout>
            </com.bytedance.locallife.dito.baseview.RoundLinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/spu_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <com.bytedance.lighten.loader.SmartImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_spu_icon"
                    android:visibility="gone"
                    android:layout_width="14sp"
                    android:layout_height="14sp"
                    android:layout_marginEnd="4dp"
                    app:placeholderImage="@color/BGPlaceholderDefault"
                    app:placeholderImageScaleType="centerCrop"
                    app:rounded_radius="2dp"
                    app:viewAspectRatio="1"/>
                <com.bytedance.dux.text.DuxTextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#fe2c55"
                    android:ellipsize="end"
                    android:id="@+id/tv_spu_price"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginEnd="2dp"/>
                <com.bytedance.dux.text.DuxTextView
                    android:textSize="10sp"
                    android:textColor="@color/POITextTertiary2"
                    android:ellipsize="end"
                    android:id="@+id/tv_spu_origin_price"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginEnd="4dp"/>
                <com.bytedance.dux.text.DuxTextView
                    android:textSize="10sp"
                    android:textColor="@color/POITextHighlight"
                    android:ellipsize="end"
                    android:id="@+id/tv_spu_discount"
                    android:background="@color/POIBgTabHighlight"
                    android:paddingLeft="3dp"
                    android:paddingTop="0.5dp"
                    android:paddingRight="3dp"
                    android:paddingBottom="0.5dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginEnd="4dp"/>
                <com.bytedance.dux.text.DuxTextView
                    android:textSize="12sp"
                    android:textColor="#e6161823"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_spu_desc"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
            </LinearLayout>
        </com.bytedance.locallife.dito.baseview.RoundLinearLayout>
    </LinearLayout>
</com.bytedance.locallife.dito.baseview.RoundRelativeLayout>
