<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/base_enter_body"
    android:background="@drawable/ttlive_bg_user_entry_level_mid"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/ttlive_user_enter_bg_height">
    <com.bytedance.android.livesdk.chatroom.ui.NoMoreSpaceTextView
        android:layout_gravity="center_vertical"
        android:id="@+id/badge_list_spannable"
        android:layout_width="wrap_content"
        android:layout_height="13dp"
        android:layout_marginLeft="6dp"
        android:layout_marginStart="6dp"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/honor_iv"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="13dp"
        android:layout_marginLeft="6dp"
        android:layout_marginStart="6dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ttlive_user_enter_text_color_normal"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/user_name_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:maxWidth="110dp"
        android:text="@string/ttlive_entry_description_max_length"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="4dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ttlive_user_enter_text_color_normal"
        android:layout_gravity="center_vertical"
        android:id="@+id/description_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_entry_description_level_mid"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        app:layout_constraintStart_toEndOf="@+id/user_name_tv"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/star_iv"
        android:layout_width="@dimen/ttlive_user_enter_star_width"
        android:layout_height="@dimen/ttlive_user_enter_star_height"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:src="@drawable/ttlive_ic_star_white"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"/>
</LinearLayout>
