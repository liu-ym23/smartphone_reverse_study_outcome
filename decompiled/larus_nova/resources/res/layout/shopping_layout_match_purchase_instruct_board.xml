<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/shopping_match_purchase_instruct_board_bg"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:focusable="true"
    android:layout_width="wrap_content"
    android:layout_height="26dp">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:src="@drawable/shopping_anchor_v3_match_purchase_icon"
        android:layout_marginStart="8dp"/>
    <TextView
        android:textColor="@color/TextReverse"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_guide_board"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="6dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        style="@style/font_size_24"/>
</LinearLayout>
