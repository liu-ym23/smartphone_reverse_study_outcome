<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_white_round_corner_rect_vertical"
    android:layout_width="300dp"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/live_dialog_image_block"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/live_dialog_image"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="50dp"
        android:layout_marginRight="50dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"/>
    <View
        android:id="@+id/live_dialog_top_block"
        android:layout_width="match_parent"
        android:layout_height="24dp"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_live_dialog_title"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/live_dialog_title"
        android:background="@color/ttlive_white"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <View
        android:id="@+id/live_dialog_title_message_block"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ttlive_live_dialog_message"
        android:gravity="center_horizontal"
        android:id="@+id/live_dialog_message"
        android:background="@color/ttlive_white"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <View
        android:id="@+id/live_dialog_bottom_block"
        android:layout_width="match_parent"
        android:layout_height="24dp"/>
    <FrameLayout
        android:id="@+id/live_dialog_frame"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/live_dialog_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/live_dialog_divider_1"
            style="@style/ttlive_live_dialog_divider_horizontal"/>
        <Button
            android:textSize="16sp"
            android:id="@+id/live_dialog_btn_1"
            style="@style/ttlive_live_dialog_button_vertical"/>
        <View
            android:id="@+id/live_dialog_divider_2"
            style="@style/ttlive_live_dialog_divider_horizontal"/>
        <Button
            android:textSize="16sp"
            android:id="@+id/live_dialog_btn_2"
            style="@style/ttlive_live_dialog_button_vertical"/>
        <View
            android:id="@+id/live_dialog_divider_3"
            style="@style/ttlive_live_dialog_divider_horizontal"/>
        <Button
            android:textSize="16sp"
            android:id="@+id/live_dialog_btn_3"
            style="@style/ttlive_live_dialog_button_vertical"/>
    </LinearLayout>
    <View
        android:id="@+id/live_dialog_bottom_block"
        android:layout_width="match_parent"
        android:layout_height="14dp"/>
</LinearLayout>
