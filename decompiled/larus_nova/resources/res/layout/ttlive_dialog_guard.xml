<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_guard_dialog"
    android:layout_width="300dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18dp"
        android:textColor="#404040"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/ttlive_live_guard_renew_title"/>
    <TextView
        android:textSize="16dp"
        android:textColor="#808080"
        android:id="@+id/guard_dialog_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="20dp"
        android:text="@string/ttlive_live_guard_renew_tip_2"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp">
        <TextView
            android:textSize="16dp"
            android:textColor="#404040"
            android:gravity="center"
            android:id="@+id/guard_dialog_cancel"
            android:background="@drawable/ttlive_bg_guard_dialog_btn_cancel"
            android:layout_width="133dp"
            android:layout_height="40dp"
            android:layout_marginRight="3dp"
            android:text="@string/ttlive_cancel"
            android:layout_marginEnd="3dp"/>
        <TextView
            android:textSize="16dp"
            android:textColor="#ff2200"
            android:gravity="center"
            android:id="@+id/guard_dialog_recharge"
            android:background="@drawable/ttlive_bg_guard_dialog_btn_sure"
            android:layout_width="133dp"
            android:layout_height="40dp"
            android:text="@string/ttlive_live_guard_charge"/>
    </LinearLayout>
</LinearLayout>
