<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/ttlive_backgroundView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/ttlive_foregroundView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/ttlive_avatarView"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginLeft="28dp"
        android:layout_marginTop="19dp"
        android:layout_marginRight="28dp"
        android:layout_marginBottom="36dp"
        android:layout_marginStart="28dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAsCircle="true"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/ttlive_animationView"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_avatarView"
        app:layout_constraintLeft_toLeftOf="@+id/ttlive_avatarView"
        app:layout_constraintRight_toRightOf="@+id/ttlive_avatarView"
        app:layout_constraintTop_toTopOf="@+id/ttlive_avatarView"/>
</androidx.constraintlayout.widget.ConstraintLayout>
