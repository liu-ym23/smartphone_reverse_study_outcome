<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larksuite.component.ui.imageview.LKUIRoundedImageView2
        android:id="@+id/image_view"
        android:background="@drawable/ai_primary_fill_transparent_01"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:radius="6dp"/>
    <RelativeLayout
        android:layout_gravity="end|top"
        android:id="@+id/v_selected_region"
        android:layout_width="36dp"
        android:layout_height="36dp">
        <androidx.appcompat.widget.AppCompatCheckBox
            android:textSize="12sp"
            android:textColor="@color/static_white"
            android:gravity="center"
            android:id="@+id/v_selected"
            android:background="@drawable/inline_ai_image_checkbox_bg"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:button="@null"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</FrameLayout>
