<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/navigation_bar"
        android:background="@color/flow_ud_bg_base_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Space
            android:layout_width="match_parent"
            android:layout_height="8dp"/>
        <View
            android:background="@drawable/bg_fragment_flow_group_create_line"
            android:layout_width="36dp"
            android:layout_height="4dp"/>
        <Space
            android:layout_width="match_parent"
            android:layout_height="8dp"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/flow_ud_neutral_100"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LarkIM_Feed_CreateGroup_Button"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/picker_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/confirm_bottom_container"
        android:background="@color/flow_ud_bg_base_3"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/static_white"
            android:gravity="center"
            android:id="@+id/confirm"
            android:background="@drawable/bg_flow_group_create_confirm_btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="8dp"
            android:text="@string/LarkIM_Feed_CreateGroup_Button"/>
    </LinearLayout>
</LinearLayout>
