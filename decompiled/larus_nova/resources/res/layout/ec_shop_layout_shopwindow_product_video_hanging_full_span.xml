<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ui.base.widget.round.RoundLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/shopwindow_video_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bg_cornerRadius="8dp"
    app:rounded_radius="8dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ec_window_product_video_hanging_video"
        android:layout_width="146dp"
        android:layout_height="146dp">
        <include
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/ec_shop_layout_shopwindow_product_video_hanging_video"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingTop="6dp"
        android:paddingBottom="2dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="2dp">
        <TextView
            android:textStyle="bold"
            android:textColor="@color/ec_shop_100161823"
            android:id="@+id/ec_window_video_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:paddingStart="6dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ec_window_sub_text_color"
            android:ellipsize="none"
            android:id="@+id/store_product_card_recommend_info"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:paddingStart="6dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ec_window_video_desc"/>
        <FrameLayout
            android:id="@+id/window_product_card_recommend_area"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"/>
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            layout="@layout/ec_shop_layout_shopwindow_product_video_hanging_product"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.bytedance.android.ui.base.widget.round.RoundLinearLayout>
