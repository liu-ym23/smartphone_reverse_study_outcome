<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="#ffffff"
        android:layout_gravity="center"
        android:id="@+id/btn_scan"
        android:background="#44000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_lynx_input_or_scan_qrcode"/>
    <TextView
        android:textColor="#ffffff"
        android:layout_gravity="center"
        android:id="@+id/btn_clear_gecko"
        android:background="#44880000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ttlive_clear_gecko_files"/>
    <TextView
        android:textColor="#ffffff"
        android:layout_gravity="center"
        android:id="@+id/btn_update_gecko"
        android:background="#44008800"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ttlive_trigger_gecko_update"/>
    <TextView
        android:textColor="#ffffff"
        android:layout_gravity="center"
        android:id="@+id/btn_get_versions"
        android:background="#44000088"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ttlive_get_offline_versions"/>
    <TextView
        android:textColor="#ffffff"
        android:layout_gravity="center"
        android:id="@+id/tv_versions"
        android:background="#88000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
</LinearLayout>
