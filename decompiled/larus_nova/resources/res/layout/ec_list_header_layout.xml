<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.bytedance.android.livesdk.livecommerce.iron.listheader.entry.IronListHeaderEntryLayout
        android:id="@+id/list_entry"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.livecommerce.iron.ui.top.info.ECPromotionListShopInfoLayout
        android:id="@+id/area_shop_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/list_entry"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.livecommerce.iron.ui.top.search.ECPromotionListSearchBarView
        android:id="@+id/search_bar"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/list_entry"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/list_entry"
        app:layout_constraintTop_toTopOf="@+id/list_entry"/>
</merge>
