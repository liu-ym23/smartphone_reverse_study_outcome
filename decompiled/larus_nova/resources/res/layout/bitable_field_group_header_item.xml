<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/field_group_left_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:tint="@color/icon_n2"
            app:srcCompat="@drawable/ud_icon_group_bitable_outlined"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textColor="@color/text_caption"
            android:ellipsize="end"
            android:id="@+id/field_group_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="6dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/field_group_desc_icon"
            android:padding="3dp"
            android:visibility="visible"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:tint="@color/icon_n2"
            app:srcCompat="@drawable/ud_icon_info_outlined"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/field_group_chevron_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:tint="@color/icon_n3"
            android:layout_marginStart="6dp"
            app:srcCompat="@drawable/ud_icon_down_small_ccm_outlined"/>
    </LinearLayout>
    <View
        android:id="@+id/field_group_divider"
        android:background="@color/line_border_card"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginStart="38dp"
        android:layout_marginEnd="16dp"/>
</LinearLayout>
