<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/divider_line_top"
        android:background="@color/LineReverse2"
        android:layout_width="match_parent"
        android:layout_height="1px"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.dux.button.DuxButton
        android:textStyle="normal"
        android:textColor="@color/TextReverse2"
        android:gravity="center"
        android:id="@+id/actionNegative"
        android:padding="-1dp"
        android:paddingLeft="10dp"
        android:paddingTop="13.5dp"
        android:paddingRight="10dp"
        android:paddingBottom="13.5dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        app:layout_constraintEnd_toStartOf="@+id/divider_line_middle"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider_line_top"
        style="@style/DuxDialog.Button.Text.Primary.Large"/>
    <View
        android:id="@+id/divider_line_middle"
        android:background="@color/LineReverse2"
        android:visibility="gone"
        android:layout_width="1px"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/actionPositive"
        app:layout_constraintStart_toEndOf="@+id/actionNegative"
        app:layout_constraintTop_toBottomOf="@+id/divider_line_top"/>
    <com.bytedance.dux.button.DuxButton
        android:textColor="@color/dux_dialog_positive_btn_text_color"
        android:gravity="center"
        android:id="@+id/actionPositive"
        android:padding="-1dp"
        android:paddingLeft="10dp"
        android:paddingTop="13.5dp"
        android:paddingRight="10dp"
        android:paddingBottom="13.5dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/divider_line_middle"
        app:layout_constraintTop_toBottomOf="@+id/divider_line_top"
        style="@style/DuxDialog.Button.Text.Primary.Large"/>
</androidx.constraintlayout.widget.ConstraintLayout>
