<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.annie.view.ForceInterceptConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/annie_fragment_root_view"
    android:background="@color/annie_transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.annie.view.WebRiskHintView
        android:id="@+id/annie_web_risk_banner"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/risk_barrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="annie_web_risk_banner"
        app:layout_constraintTop_toBottomOf="@+id/annie_web_risk_banner"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/annie_nav_bar"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/risk_barrier"/>
    <View
        android:id="@+id/title_bar_shadow"
        android:background="@color/annie_hs_g1"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/annie_nav_bar"/>
    <FrameLayout
        android:gravity="center_horizontal"
        android:id="@+id/hybrid_view_fail"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar_shadow"
        app:layout_constraintVertical_bias="0.55"/>
    <FrameLayout
        android:id="@+id/hybrid_view_container"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar_shadow"/>
    <com.bytedance.android.annie.view.FullscreenVideoFrame
        android:id="@+id/custom_view_layout"
        android:background="#000000"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/risk_barrier"/>
    <include
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/risk_barrier"
        layout="@layout/annie_base_title_bar_layout"/>
    <FrameLayout
        android:id="@+id/annie_popup_nav_bar"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/risk_barrier"/>
    <include
        android:layout_gravity="top"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/risk_barrier"
        layout="@layout/annie_pull_down_close_layout"/>
    <FrameLayout
        android:id="@+id/loading_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title_bar_shadow"/>
    <FrameLayout
        android:id="@+id/float_window_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.bytedance.android.annie.view.ForceInterceptConstraintLayout>
