<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ttlive_ad_miniapp_card"
    android:layout_width="112dp"
    android:layout_height="180dp">
    <com.bytedance.android.livesdk.chatroom.ui.LiveRoundImageView
        android:id="@+id/ttlive_ad_miniapp_card_snapshot"
        android:layout_width="match_parent"
        android:layout_height="122dp"
        android:scaleType="matrix"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ttlive_radius_top_left="6dp"
        app:ttlive_radius_top_right="6dp"/>
    <View
        android:id="@+id/ttlive_snapshot_bottom_bg_2"
        android:background="#10000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        app:layout_constraintBottom_toTopOf="@+id/ttlive_snapshot_bottom_bg"/>
    <ImageView
        android:id="@+id/ttlive_snapshot_bottom_bg"
        android:background="@drawable/ttlive_ad_miniapp_gradual_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginBottom="26dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottom_layout"/>
    <ImageView
        android:id="@+id/ttlive_ad_miniapp_card_close"
        android:background="@drawable/ttlive_ad_miniapp_close_button_bg"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/ttlive_ad_miniapp_close_button"
        android:scaleType="center"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_layout"
        android:background="@drawable/ttlive_ad_miniapp_bottom_layout_bg"
        android:layout_width="112dp"
        android:layout_height="58dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:id="@+id/ttlive_ad_miniapp_card_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginTop="4dp"
            android:layout_marginStart="6dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/ttlive_ad_miniapp_card_name"
            android:layout_width="84dp"
            android:layout_height="14dp"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:layout_marginStart="2dp"
            app:layout_constraintStart_toEndOf="@+id/ttlive_ad_miniapp_card_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/ttlive_ad_miniapp_card_desc"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:maxLines="2"
            android:layout_marginStart="6dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
