<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/image_edit_area"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_5"
        app:layout_constraintEnd_toStartOf="@+id/to_video_area"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/edit_inner_image_view"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:layout_marginTop="?attr/larus_dp_7"
            android:src="@drawable/larus_creation_photo_editor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_11"
            android:textColor="@color/larus_static_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_6"
            android:text="@string/larus_creationPreview_btn_edit"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edit_inner_image_view"/>
        <com.larus.common_ui.widget.roundlayout.RoundTextView
            android:textSize="?attr/larus_dp_9"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/iv_edit_inner_image_indicator"
            android:layout_width="?attr/larus_dp_14"
            android:layout_height="?attr/larus_dp_14"
            android:text="@string/larus_imageDetail_btn_label_new"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintEnd_toEndOf="@+id/edit_inner_image_view"
            app:layout_constraintStart_toEndOf="@+id/edit_inner_image_view"
            app:layout_constraintTop_toTopOf="parent"
            app:rv_backgroundColor="?attr/larus_primary_50"
            app:rv_backgroundPressColor="?attr/larus_primary_50"
            app:rv_cornerRadius="?attr/larus_dp_4"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/to_video_area"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_5"
        app:layout_constraintEnd_toStartOf="@+id/download_area"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/image_edit_area"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/to_video_inner_image_view"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:layout_marginTop="?attr/larus_dp_7"
            android:src="@drawable/larus_creation_video"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_11"
            android:textColor="@color/larus_static_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_6"
            android:text="@string/larus_imageDetail_btn_video"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/to_video_inner_image_view"/>
        <com.larus.common_ui.widget.roundlayout.RoundTextView
            android:textSize="?attr/larus_dp_9"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/iv_edit_inner_video_indicator"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_14"
            android:layout_height="?attr/larus_dp_14"
            android:text="@string/larus_imageDetail_btn_label_new"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintEnd_toEndOf="@+id/to_video_inner_image_view"
            app:layout_constraintStart_toEndOf="@+id/to_video_inner_image_view"
            app:layout_constraintTop_toTopOf="parent"
            app:rv_backgroundColor="?attr/larus_primary_50"
            app:rv_backgroundPressColor="?attr/larus_primary_50"
            app:rv_cornerRadius="?attr/larus_dp_4"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/download_area"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        app:layout_constraintEnd_toEndOf="@+id/publish_creation_area"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/to_video_area"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/download_inner_image_view"
            android:visibility="visible"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:src="@drawable/larus_ic_download_white_filled"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/download_inner_loading"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/larus_ic_common_download_loading_animated"
            android:indeterminateDuration="2000"
            app:layout_constraintBottom_toBottomOf="@+id/download_inner_image_view"
            app:layout_constraintEnd_toEndOf="@+id/download_inner_image_view"
            app:layout_constraintStart_toStartOf="@+id/download_inner_image_view"
            app:layout_constraintTop_toTopOf="@+id/download_inner_image_view"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_11"
            android:textColor="@color/larus_static_white"
            android:id="@+id/download_inner_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_6"
            android:text="@string/larus_creationPreview_btn_save"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/publish_creation_area"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/download_area"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/publish_creation_image_view"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:src="@drawable/larus_icon_arrow_up_circle_fill"
            android:tint="@color/larus_static_white"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_11"
            android:textColor="@color/larus_static_white"
            android:id="@+id/publish_creation_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_6"
            android:text="@string/larus_creationPreview_btn_publish"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</merge>
