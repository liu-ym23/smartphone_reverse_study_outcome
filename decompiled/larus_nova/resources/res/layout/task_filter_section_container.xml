<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:minHeight="44sp">
    <com.ss.android.lark.todo.impl.features.detail.widget.KeyboardScrollView
        android:id="@+id/filter_item_container"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/icon_n2"
                android:gravity="center_vertical"
                android:id="@+id/complete_status_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxWidth="170dp"
                android:text="@string/Todo_New_Ongoing_FilterOption"
                android:singleLine="true"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginEnd="@dimen/dp_5"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/icon_n2"
                android:gravity="center_vertical"
                android:id="@+id/group_section_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxWidth="170dp"
                android:text="@string/Todo_New_Section_GroupBy_Section_Button"
                android:singleLine="true"
                android:layout_marginStart="@dimen/dp_25"
                android:layout_marginEnd="@dimen/dp_5"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/icon_n2"
                android:gravity="center_vertical"
                android:id="@+id/sort_filter_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxWidth="170dp"
                android:text="@string/Todo_New_Sort_CustomSort_Button"
                android:singleLine="true"
                android:layout_marginStart="@dimen/dp_25"
                android:layout_marginEnd="@dimen/dp_5"/>
        </LinearLayout>
    </com.ss.android.lark.todo.impl.features.detail.widget.KeyboardScrollView>
    <View
        android:id="@+id/filter_shader"
        android:background="@drawable/todo_keyboard_shader"
        android:visibility="gone"
        android:layout_width="40sp"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
