<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.ee.bear.middleground.comment.widget.CommentRootView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pop_container"
    android:background="@color/bg_mask"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_gravity="bottom"
        android:id="@+id/comment_voice_bottom_mask"
        android:background="@drawable/comment_voice_bottom_mask"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="327dp"/>
    <com.bytedance.ee.bear.widgets.CardIndicator
        android:layout_gravity="center_vertical"
        android:id="@+id/comment_indicator"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="100dp"
        android:layout_marginBottom="100dp"
        android:elevation="8dp"
        app:defaultColor="@color/fill_disable"
        app:dividerWidth="@dimen/space_kit_len_8"
        app:highLightColor="@color/bg_float"
        app:indicator_orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/doc_comment_sender"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.bytedance.ee.bear.widgets.viewpager.VerticalViewPager
        android:id="@+id/doc_comment_viewpager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="0dp"
        android:paddingEnd="6dp"
        android:layout_marginStart="40dp"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/input_comment"
        android:background="@drawable/comment_input_background"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="46dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="52dp"
        android:minHeight="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:elevation="4dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/comment_private_icon"
            android:padding="4dp"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="-4dp"
            android:layout_marginEnd="8dp"
            app:srcCompat="@drawable/ud_icon_lock_filled"
            app:tint="@color/icon_n3"/>
        <com.bytedance.ee.bear.middleground.comment.widget.CommentTextView
            android:textSize="16sp"
            android:textColor="@color/text_title"
            android:textColorHint="@color/text_placeholder"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/doc_comment_input"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:hint="@string/Doc_Comment_ReplyCommentDot"
            android:maxLines="1"
            android:scrollHorizontally="false"
            android:layout_weight="1"
            android:textCursorDrawable="@drawable/facade_edit_text_cursor"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/doc_publish_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            app:srcCompat="@drawable/ud_icon_send_colorful"
            app:tint="@color/space_selector_primary_b500_b300"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/input_comment_fg"
        android:background="@drawable/comment_input_background"
        android:visibility="gone"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="46dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="62dp"
        android:minHeight="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:elevation="4dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/input_comment_fg_text_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/comment_voice_toggle"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="2dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                app:srcCompat="@drawable/ud_icon_mic_outlined"
                app:tint="@color/icon_n2"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/comment_private_icon_fg"
                android:padding="4dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                app:srcCompat="@drawable/ud_icon_lock_filled"
                app:tint="@color/icon_n3"/>
            <com.bytedance.ee.bear.middleground.comment.widget.CommentTextView
                android:textSize="16sp"
                android:textColor="@color/text_title"
                android:textColorHint="@color/text_placeholder"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/doc_comment_input_fg"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:hint="@string/LarkCCM_MobileComment_TypeOrSpeak_Placeholder"
                android:maxLines="1"
                android:scrollHorizontally="false"
                android:layout_weight="1"
                android:textCursorDrawable="@drawable/facade_edit_text_cursor"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/doc_publish_btn_fg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                app:srcCompat="@drawable/ud_icon_send_colorful"
                app:tint="@color/space_selector_primary_b500_b300"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/input_comment_fg_voice_mode"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minHeight="48dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/comment_keyboard_toggle"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="2dp"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="1dp"
                android:layout_marginEnd="8dp"
                app:srcCompat="@drawable/ud_icon_keyboard_packup_outlined"
                app:tint="@color/icon_n1"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/comment_voice_mode_hint"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/Lark_IM_AudioMsg_HoldToRecord_Button"
                android:maxLines="1"
                android:layout_marginEnd="32dp"/>
        </LinearLayout>
    </FrameLayout>
</com.bytedance.ee.bear.middleground.comment.widget.CommentRootView>
