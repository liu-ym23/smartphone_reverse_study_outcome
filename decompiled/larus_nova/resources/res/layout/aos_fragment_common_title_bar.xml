<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/title_bar_layout"
    android:background="@color/aos_white"
    android:layout_width="match_parent"
    android:layout_height="@dimen/aos_uikit_default_title_bar_height">
    <com.bytedance.awemeopen.apps.framework.base.view.AutoRTLImageView
        android:id="@+id/back_btn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="centerInside"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        app:srcCompat="@drawable/aos_icon_back_black"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textColor="@color/aos_text_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/title"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="100dp"
        android:layout_marginRight="100dp"
        android:maxLines="1"
        android:layout_centerInParent="true"
        style="@style/font_size_34_sp"/>
</RelativeLayout>
