<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_54">
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="?attr/larus_dp_12">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_dp_12"
                android:textColor="?attr/larus_neutral_50"
                android:gravity="top"
                android:id="@+id/translator_sub_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_0"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="?attr/larus_dp_12"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <include
                android:id="@+id/language_source_selector"
                android:layout_width="wrap_content"
                android:layout_height="?attr/larus_dp_36"
                android:layout_marginTop="?attr/larus_dp_8"
                android:layout_marginBottom="?attr/larus_dp_12"
                android:layout_marginStart="?attr/larus_dp_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/translator_sub_title"
                app:layout_goneMarginTop="?attr/larus_dp_0"
                layout="@layout/larus_item_actionbar_dropdown_list"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/icon_arrow"
                android:layout_width="?attr/larus_dp_16"
                android:layout_height="?attr/larus_dp_16"
                android:layout_marginStart="?attr/larus_dp_8"
                app:layout_constraintBottom_toBottomOf="@+id/language_source_selector"
                app:layout_constraintStart_toEndOf="@+id/language_source_selector"
                app:layout_constraintTop_toTopOf="@+id/language_source_selector"
                app:srcCompat="?attr/larus_icon_instruction_translate_arrow"/>
            <include
                android:id="@+id/language_target_selector"
                android:layout_width="wrap_content"
                android:layout_height="?attr/larus_dp_36"
                android:layout_marginStart="?attr/larus_dp_8"
                app:layout_constraintBottom_toBottomOf="@+id/language_source_selector"
                app:layout_constraintStart_toEndOf="@+id/icon_arrow"
                app:layout_constraintTop_toTopOf="@+id/language_source_selector"
                layout="@layout/larus_item_actionbar_dropdown_list"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </HorizontalScrollView>
    <View
        android:id="@+id/bottom_divider"
        android:background="?attr/larus_neutral_transparent_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</merge>
