<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="@dimen/space_kit_len_14">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:paddingStart="0dp"
            android:paddingEnd="@dimen/space_kit_len_2">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/text_placeholder"
                android:gravity="center"
                android:id="@+id/upload_item_progress_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.larksuite.component.universe_design.progress.UDProgress
                android:id="@+id/upload_item_progress_bar"
                android:visibility="gone"
                android:clickable="false"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:progress="0"
                android:layout_marginStart="@dimen/space_kit_len_8"
                app:ud_progress_indicatorColor="@color/colorful_blue"
                app:ud_progress_indicatorCornerRadius="1dp"
                app:ud_progress_thickness="2dp"
                app:ud_progress_trackColor="@color/ud_N300"
                app:ud_progress_type="circular"/>
        </LinearLayout>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/uploadlist_lottie"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/upload_finish_image"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/upload_item_retry"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:paddingStart="0dp"
            android:paddingEnd="@dimen/space_kit_len_2">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/drive_retry_upload_text_press_color"
                android:gravity="center"
                android:id="@+id/upload_item_retry_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Drive_Drive_Retry"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/upload_item_retry_tip"
                android:clickable="false"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="@dimen/space_kit_len_8"
                app:srcCompat="@drawable/ud_icon_warning_colorful"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_placeholder"
            android:gravity="center"
            android:id="@+id/upload_item_status_tip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:paddingStart="0dp"
            android:paddingEnd="@dimen/space_kit_len_2"/>
    </RelativeLayout>
</FrameLayout>
