<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:layout_gravity="center_vertical"
        android:id="@+id/layout_pick_item_time"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_16"
        layout="@layout/todo_keyboard_pick_item_time"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/time_button_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <com.larksuite.component.universe_design.button.UDButton
            android:textSize="@dimen/sp_14"
            android:textStyle="normal"
            android:textColor="@color/text_title"
            android:id="@+id/today_btn"
            android:paddingLeft="@dimen/dp_15"
            android:paddingTop="8dp"
            android:paddingRight="@dimen/dp_15"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Todo_Common_Today"
            android:drawablePadding="@dimen/dp_4"
            android:textAllCaps="false"
            app:ud_backgroundColor="@color/bg_body_overlay"
            app:ud_radius="l"
            style="@style/UDButton.Default"/>
        <com.larksuite.component.universe_design.button.UDButton
            android:textSize="@dimen/sp_14"
            android:textStyle="normal"
            android:textColor="@color/text_title"
            android:id="@+id/tomorrow_btn"
            android:paddingLeft="@dimen/dp_15"
            android:paddingTop="8dp"
            android:paddingRight="@dimen/dp_15"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_8"
            android:text="@string/Todo_Common_Tomorrow"
            android:drawablePadding="@dimen/dp_4"
            android:textAllCaps="false"
            app:ud_backgroundColor="@color/bg_body_overlay"
            app:ud_radius="l"
            style="@style/UDButton.Default"/>
        <com.larksuite.component.universe_design.button.UDButton
            android:textSize="@dimen/sp_14"
            android:textStyle="normal"
            android:textColor="@color/text_title"
            android:id="@+id/other_time_btn"
            android:paddingLeft="@dimen/dp_15"
            android:paddingTop="8dp"
            android:paddingRight="@dimen/dp_15"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_8"
            android:layout_marginRight="@dimen/dp_8"
            android:text="@string/Todo_Common_OtherTime"
            android:drawablePadding="@dimen/dp_4"
            android:textAllCaps="false"
            app:ud_backgroundColor="@color/bg_body_overlay"
            app:ud_radius="l"
            style="@style/UDButton.Default"/>
    </LinearLayout>
</LinearLayout>
