<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_bot_edit"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_16"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/prologue_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        android:text="@string/larus_create_bot_settings_card_header"
        android:maxLines="1"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="?attr/larus_dp_16"
        android:gravity="start|top"
        android:id="@+id/prologue_edit"
        android:background="@null"
        android:scrollbars="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:maxHeight="?attr/larus_dp_100"
        android:minHeight="?attr/larus_dp_52"
        android:hint="@string/larus_create_bot_settings_card_subtitle_tip"
        android:inputType="textMultiLine"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/prologue_title"
        style="@style/larus_EditTextStyle"/>
    <com.larus.bot.impl.feature.edit.feature.firstmet.tts.BotCreateTtsPlayerView
        android:id="@+id/tts_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_create_bot_settings_card_opening_remarks_play_btn"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/prologue_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/prologue_title"/>
    <com.larus.bmhome.view.item.ItemTextArrow
        android:id="@+id/suggest_prompt_item"
        android:background="@drawable/larus_ugc_bot_bg_bot_edit_item_selector"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginTop="?attr/larus_dp_12"
        android:text="@string/larus_create_bot_settings_toggle"
        app:larus_sub_text="@string/larus_create_bot_settings_toggle_on"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/prologue_edit"/>
    <View
        android:id="@+id/prologue_suggests_divider"
        android:background="@color/larus_neutral_transparent_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/prologue_edit"/>
    <include
        android:id="@+id/prologue_skeleton"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_0"
        app:layout_constraintBottom_toBottomOf="@+id/prologue_edit"
        app:layout_constraintEnd_toEndOf="@+id/prologue_edit"
        app:layout_constraintStart_toStartOf="@+id/prologue_edit"
        app:layout_constraintTop_toTopOf="@+id/prologue_edit"
        layout="@layout/larus_bot_create_desc_skeleton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
