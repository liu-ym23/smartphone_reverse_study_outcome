<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.common.RoundRectLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:leftBottomRoundRect="6dp"
    app:leftTopRoundRect="6dp"
    app:rightBottomRoundRect="6dp"
    app:rightTopRoundRect="6dp"
    app:roundRect="12dp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="280dp"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/iv_des"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:layout_gravity="right"
                android:id="@+id/iv_close"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_margin="11dp"
                android:src="@drawable/ttlive_solo_ktv_close_icon"/>
        </FrameLayout>
        <TextView
            android:textSize="14dp"
            android:textColor="#bf161823"
            android:gravity="center"
            android:id="@+id/des"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:text="@string/ttlive_solo_ktv_back_home_tips_dialog_txt"
            android:lines="2"/>
        <View
            android:background="@color/liveuikit_gray"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/comfirm"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="我知道了"/>
    </LinearLayout>
</com.bytedance.android.livesdk.common.RoundRectLayout>
