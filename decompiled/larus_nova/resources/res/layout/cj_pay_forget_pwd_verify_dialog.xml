<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="center"
        android:background="@drawable/cj_pay_bg_white"
        android:layout_width="280dp"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/close_btn"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/cj_pay_icon_titlebar_ies_2_left_close"
            android:layout_alignParentRight="true"/>
        <ImageView
            android:id="@+id/verify_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="32dp"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#161823"
            android:gravity="center"
            android:id="@+id/recommend_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="20dp"
            android:layout_below="@+id/verify_icon"
            android:layout_centerHorizontal="true"/>
        <FrameLayout
            android:id="@+id/cj_pay_verify_btn_layout"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="20dp"
            android:layout_below="@+id/recommend_text"
            android:layout_centerHorizontal="true">
            <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
                android:textSize="15sp"
                android:textColor="@color/cj_pay_color_white"
                android:gravity="center"
                android:id="@+id/cj_pay_verify_btn"
                android:background="@drawable/cj_pay_base_bg_red_btn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cj_pay_custom_button_height_44"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/cj_pay_verify_btn_loading"
                android:background="@color/cj_pay_color_trans"
                android:visibility="gone"
                android:layout_width="@dimen/cj_pay_padding_20"
                android:layout_height="@dimen/cj_pay_padding_20"
                android:indeterminateOnly="true"
                android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_white"
                android:indeterminateDuration="500"
                android:indeterminateBehavior="repeat"/>
        </FrameLayout>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:gravity="center"
            android:id="@+id/input_password"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="13dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="18dp"
            android:layout_below="@+id/cj_pay_verify_btn_layout"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</RelativeLayout>
