<?xml version="1.0" encoding="utf-8"?>
<com.larus.bmhome.view.ChatConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.common_ui.view.SlideDismissView
        android:orientation="vertical"
        android:id="@+id/root_container"
        android:background="?attr/larus_creation_bg_bottom_sheet_gray"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="?attr/larus_dp_10"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_12">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="?attr/larus_dp_36"
                android:layout_height="?attr/larus_dp_4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="?attr/larus_rectangle_icon"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/creation_type_select_container"
            android:paddingTop="?attr/larus_dp_16"
            android:paddingBottom="?attr/larus_dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.larus.common_ui.view.SlideDismissView>
</com.larus.bmhome.view.ChatConstraintLayout>
