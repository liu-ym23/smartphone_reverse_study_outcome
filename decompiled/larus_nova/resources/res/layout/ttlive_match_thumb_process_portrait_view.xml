<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/center_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.48">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/progress_time"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="24dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="end|center_vertical"
                android:id="@+id/tv_cur_time"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginRight="6dp"
                android:minWidth="65dp"
                android:shadowColor="#66000000"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="2"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:textSize="17sp"
                android:textColor="#ffffff"
                android:id="@+id/time_middle_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_thumb_process_time_middle_line"
                android:alpha="0.5"/>
            <TextView
                android:textSize="18dp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/tv_total_time"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:layout_marginLeft="4dp"
                android:shadowColor="#66000000"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="2"
                android:alpha="0.5"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_std_text_white_1"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/thumb_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxWidth="290dp"
            android:maxLines="1"
            app:layout_constraintLeft_toLeftOf="@+id/progress_time"
            app:layout_constraintRight_toRightOf="@+id/progress_time"
            app:layout_constraintTop_toBottomOf="@+id/progress_time"/>
        <View
            android:gravity="center"
            android:id="@+id/thumb_title_place"
            android:visibility="invisible"
            android:layout_width="290dp"
            android:layout_height="18dp"
            android:layout_marginTop="8dp"
            android:maxWidth="290dp"
            app:layout_constraintLeft_toLeftOf="@+id/progress_time"
            app:layout_constraintRight_toRightOf="@+id/progress_time"
            app:layout_constraintTop_toBottomOf="@+id/progress_time"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
