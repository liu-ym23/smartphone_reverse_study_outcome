<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/comment_card_holder"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="2dp">
    <FrameLayout
        android:id="@+id/content_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.larksuite.component.universe_design.image.UDAvatar
                android:id="@+id/user_msg_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:ud_avatar_borderWidth="0dp"
                app:ud_avatar_size="small"
                style="@style/UDAvatar.Circle"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:id="@+id/tv_name"
                android:paddingTop="1dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_marginStart="8dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@+id/tv_create_at"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/user_msg_image"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.ee.bear.middleground.comment.widget.CommentTimeText
                android:textSize="12sp"
                android:textColor="@color/text_caption"
                android:ellipsize="end"
                android:layout_gravity="top"
                android:id="@+id/tv_create_at"
                android:paddingTop="1dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_name"
                app:layout_constraintEnd_toStartOf="@+id/tv_opt_comment"
                app:layout_constraintStart_toEndOf="@+id/tv_name"
                app:layout_constraintTop_toTopOf="@+id/tv_name"/>
            <com.bytedance.ee.bear.middleground.comment.widget.CommentTextView
                android:textSize="16sp"
                android:textColor="@color/text_title"
                android:id="@+id/tv_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="4dp"
                android:layout_marginEnd="2dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintLeft_toLeftOf="@+id/tv_name"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_name"/>
            <com.bytedance.ee.bear.middleground.comment.widget.CommentTextView
                android:textSize="14dp"
                android:textColor="@color/text_title"
                android:gravity="left"
                android:id="@+id/tv_content_translate"
                android:background="@drawable/facade_round_around_xs"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="2dp"
                android:backgroundTint="@color/bg_filler"
                app:layout_constrainedWidth="true"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintLeft_toLeftOf="@+id/tv_name"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_content"/>
            <com.bytedance.ee.bear.facade.common.widget.BearLottieView
                android:id="@+id/iv_translate"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_content_translate"
                app:layout_constraintRight_toRightOf="parent"
                app:lottie_autoPlay="false"
                app:lottie_fileName="translate_ing.json"
                app:lottie_loop="true"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_comment_image_list"
                android:padding="0dp"
                android:scrollbars="none"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_kit_len_10"
                android:layout_marginBottom="@dimen/space_kit_len_10"
                app:layout_constraintLeft_toLeftOf="@+id/tv_name"
                app:layout_constraintTop_toBottomOf="@+id/iv_translate"/>
            <com.ss.android.lark.reaction.widget.flowlayout.ReactionFlowLayout
                android:id="@+id/reaction_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:layout_marginStart="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/user_msg_image"
                app:layout_constraintTop_toBottomOf="@+id/rv_comment_image_list"
                app:layout_goneMarginTop="@dimen/dp_4"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/tv_opt_comment"
                android:paddingLeft="3dp"
                android:paddingTop="-6dp"
                android:paddingRight="3dp"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="18dp"
                android:scaleType="centerInside"
                android:paddingEnd="0dp"
                android:layout_alignParentEnd="true"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ud_icon_more_outlined"
                app:tint="@color/icon_n2"/>
            <View
                android:id="@+id/comment_loading_mask"
                android:background="@drawable/comment_loading_background"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="20dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_content"
                app:layout_constraintRight_toRightOf="@+id/tv_content"/>
            <com.bytedance.ee.bear.facade.common.widget.BearLottieView
                android:id="@+id/comment_loading"
                android:paddingLeft="2dp"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="14dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:lottie_fileName="rotate_lottie.json"
                app:lottie_loop="true"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/content_mask"
            android:background="@color/bg_float"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.7"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|top"
            android:id="@+id/delete_comment"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            app:srcCompat="@drawable/ud_icon_delete_trash_outlined"
            app:tint="@color/icon_n3"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/input_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/content_wrapper"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/retry_wrapper"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_container">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/comment_fail_img"
            android:layout_width="@dimen/space_kit_len_16"
            android:layout_height="@dimen/space_kit_len_16"
            android:layout_marginTop="@dimen/space_kit_len_8"
            android:scaleType="centerInside"
            android:layout_marginStart="40dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ud_icon_warning_red_colorful"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_caption"
            android:id="@+id/comment_send_fail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:text="@string/Doc_Comment_CommentSendFailed"
            android:maxLines="2"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/comment_fail_img"
            app:layout_constraintTop_toTopOf="@+id/comment_fail_img"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/colorful_blue"
            android:id="@+id/comment_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Doc_Comment_Retry"
            app:layout_constraintLeft_toLeftOf="@+id/comment_fail_img"
            app:layout_constraintTop_toBottomOf="@+id/comment_send_fail"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.ee.bear.middleground.comment.widget.SmartReplyPreview
        android:id="@+id/comment_smart_reply"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="22dp"
        android:layout_marginStart="48dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/retry_wrapper"/>
</androidx.constraintlayout.widget.ConstraintLayout>
