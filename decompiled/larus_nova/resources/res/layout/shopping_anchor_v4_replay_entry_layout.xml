<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/shopping_anchor_v4_replay_entry_layout_1305743000"
    android:background="@drawable/shopping_replay_entry_background"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/replay_entry_top_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/top_replay_icon"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="11dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="11dp"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/top_replay_icon_lottie"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="11dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="11dp"/>
        <com.bytedance.android.ec.core.widget.RoundedFrameLayout
            android:layout_gravity="center"
            android:id="@+id/video_wrapper"
            android:visibility="gone"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="4dp"
            app:rounded_radius="8dp">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/video_cover_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.bytedance.android.ec.core.widget.RoundedFrameLayout>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/view_disappear_lottie_wrapper"
            android:visibility="gone"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="4dp">
            <com.bytedance.android.ec.core.widget.ECLottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/view_disappear_lottie"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                app:lottie_imageAssetsFolder="images"/>
        </FrameLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/replay_entry_bottom_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/bottom_entry_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="9dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="9dp"
            android:layout_marginBottom="8dp">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/bottom_replay_icon"
                android:layout_width="10dp"
                android:layout_height="10dp"/>
            <TextView
                android:textColor="@color/commerce_color_161823"
                android:id="@+id/bottom_entry_text_new_style"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                style="@style/font_size_20"/>
        </LinearLayout>
        <TextView
            android:textColor="@color/commerce_color_161823"
            android:id="@+id/bottom_entry_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="3dp"
            android:layout_marginBottom="9dp"
            style="@style/font_size_20"/>
    </FrameLayout>
</LinearLayout>
