<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larus.common_ui.widget.roundlayout.CircleFrameLayout
        android:id="@+id/avatar_parent"
        android:layout_width="?attr/larus_dp_60"
        android:layout_height="?attr/larus_dp_60"
        android:layout_marginTop="?attr/larus_dp_2">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/avatar"
            android:layout_width="?attr/larus_dp_60"
            android:layout_height="?attr/larus_dp_60"
            app:placeholderImage="@color/larus_neutral_transparent_1"/>
    </com.larus.common_ui.widget.roundlayout.CircleFrameLayout>
    <com.larus.common_ui.widget.AvatarTagView
        android:id="@+id/avatar_tag_icon_rb"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        android:layout_marginBottom="-3dp"
        android:layout_alignBottom="@+id/avatar_parent"
        android:layout_marginEnd="-3dp"
        android:layout_alignEnd="@+id/avatar_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/text_lay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/larus_dp_60"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_toStartOf="@+id/add_bot_lay"
        android:layout_toEndOf="@+id/avatar_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bot_name_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="?attr/larus_dp_17"
                android:textColor="@color/larus_neutral_100"
                android:ellipsize="end"
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@+id/tag_container"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/tag_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toEndOf="@+id/name"
                app:layout_constraintTop_toTopOf="@+id/name"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="@color/larus_neutral_100"
            android:ellipsize="end"
            android:id="@+id/description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_2"
            android:minHeight="?attr/larus_dp_22"
            android:maxLines="2"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_2">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/bot_heat_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/bot_heat_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_0_5"
                    android:src="@drawable/larus_icon_tag_hot"/>
                <TextView
                    android:textSize="?attr/larus_dp_14"
                    android:textColor="@color/larus_neutral_50"
                    android:id="@+id/bot_heat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="?attr/larus_dp_4"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/divider_dot"
                android:layout_width="?attr/larus_dp_8"
                android:layout_height="?attr/larus_dp_17"
                android:src="@drawable/larus_icon_divider_dot"
                android:layout_marginStart="?attr/larus_dp_4"
                android:layout_marginEnd="?attr/larus_dp_6"/>
            <TextView
                android:textSize="?attr/larus_dp_14"
                android:textColor="@color/larus_neutral_50"
                android:ellipsize="end"
                android:id="@+id/bot_creator_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/add_bot_lay"
        android:layout_width="?attr/larus_dp_62"
        android:layout_height="?attr/larus_dp_62"
        android:layout_marginTop="?attr/larus_dp_2"
        android:layout_alignParentEnd="true">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/add_bot"
            android:layout_width="?attr/larus_dp_30"
            android:layout_height="?attr/larus_dp_30"
            android:src="@drawable/ic_bot_add"/>
    </FrameLayout>
</merge>
