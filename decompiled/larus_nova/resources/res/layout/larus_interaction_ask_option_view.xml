<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/content_container"
        android:background="@drawable/larus_bg_interaction_ask_option"
        android:paddingTop="?attr/larus_dp_16"
        android:paddingBottom="?attr/larus_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/larus_dp_56"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_16">
        <FrameLayout
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24">
            <TextView
                android:textSize="?attr/larus_sp_14"
                android:textStyle="bold"
                android:textColor="?attr/larus_neutral_70"
                android:gravity="center"
                android:id="@+id/mark_index_view"
                android:background="?attr/larus_bg_interaction_ask_option_mark"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:includeFontPadding="false"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/mark_checked_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:srcCompat="?attr/larus_icon_interaction_ask_option_checked"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="?attr/larus_dp_12">
            <TextView
                android:textSize="?attr/larus_sp_17"
                android:textStyle="bold"
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:id="@+id/title_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="?attr/larus_sp_13"
                android:textColor="?attr/larus_neutral_50"
                android:ellipsize="end"
                android:id="@+id/description_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_6"
                android:maxLines="4"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </LinearLayout>
</merge>
