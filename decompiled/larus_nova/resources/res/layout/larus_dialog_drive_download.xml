<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/download_dialog"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardCornerRadius="?attr/larus_dp_20"
    app:cardElevation="?attr/larus_dp_8"
    app:cardUseCompatPadding="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="?attr/larus_dp_128"
        android:layout_height="?attr/larus_dp_136">
        <ImageView
            android:id="@+id/download_cancel"
            android:layout_width="?attr/larus_dp_16"
            android:layout_height="?attr/larus_dp_16"
            android:layout_marginTop="?attr/larus_dp_12"
            android:src="@drawable/larus_ic_drive_download_cancel"
            android:layout_marginEnd="?attr/larus_dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.larus.common_ui.widget.CircleProgressBar
            android:id="@+id/progressBar"
            android:layout_width="?attr/larus_dp_40"
            android:layout_height="?attr/larus_dp_40"
            app:larus_maxProgress="100"
            app:larus_progress="0"
            app:larus_progressbarBackgroundColor="@color/larus_neutral_transparent_2"
            app:larus_progressbarColor="@color/larus_primary_50"
            app:larus_strokeWidth="?attr/larus_dp_4"
            app:layout_constraintBottom_toTopOf="@+id/downloading_tip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="?attr/larus_sp_16"
            android:textColor="@color/larus_neutral_100"
            android:id="@+id/downloading_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_18"
            android:text="@string/larus_drive_toast_downloading_s"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progressBar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
