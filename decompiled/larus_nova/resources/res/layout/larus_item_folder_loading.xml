<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_task_skill_item_middle"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_76">
    <View
        android:id="@+id/v_loading_avatar"
        android:background="@drawable/larus_bg_gray_round"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/v_loading_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/v_loading_title"/>
    <com.larus.bmhome.chat.layout.widget.ShimmerLoadingVIew
        android:id="@+id/v_loading_title"
        android:layout_width="?attr/larus_dp_100"
        android:layout_height="?attr/larus_dp_22"
        android:layout_marginTop="?attr/larus_dp_18"
        android:layout_marginStart="?attr/larus_dp_12"
        app:larus_shimmerColor="@color/larus_folder_loading_shimmer"
        app:layout_constraintStart_toEndOf="@+id/v_loading_avatar"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.bmhome.chat.layout.widget.ShimmerLoadingVIew
        android:id="@+id/v_loading_desc"
        android:layout_width="?attr/larus_dp_240"
        android:layout_height="?attr/larus_dp_14"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginBottom="?attr/larus_dp_14"
        app:larus_shimmerColor="@color/larus_folder_loading_shimmer"
        app:layout_constraintBottom_toTopOf="@+id/v_loading_divider"
        app:layout_constraintStart_toStartOf="@+id/v_loading_title"
        app:layout_constraintTop_toBottomOf="@+id/v_loading_title"/>
    <View
        android:id="@+id/v_loading_divider"
        android:background="@color/larus_neutral_transparent_2"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_0_5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
