<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.lark.flow.passport.ui.widget.layout.BlockedNestedScrollView
        android:id="@+id/signin_sdk_widget_scrollable_content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/signin_sdk_widget_footer_container"
        app:layout_constraintTop_toTopOf="@+id/signin_sdk_widget_title_bar_container"
        app:layout_constraintWidth_max="@dimen/signin_sdk_max_width">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/signin_sdk_widget_content_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <Space
                android:id="@+id/signin_sdk_widget_space_title_bar"
                android:layout_width="0dp"
                android:layout_height="0dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/signin_sdk_widget_header_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:visibility="gone"
                    style="@style/SignInWidget.Title"/>
                <TextView
                    android:visibility="gone"
                    style="@style/SignInWidget.SubTitle"/>
            </LinearLayout>
        </LinearLayout>
    </com.ss.android.lark.flow.passport.ui.widget.layout.BlockedNestedScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/signin_sdk_widget_title_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <com.ss.android.lark.passport.flow.core.widget.CommonTitleBar
            android:id="@+id/signin_sdk_widget_title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:flow_tb_right_text_color="@color/primary_fill_default"
            app:flow_tb_right_text_size="@dimen/signin_sdk_font_size_16"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/signin_sdk_widget_footer_container"
        android:paddingTop="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_16"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/signin_sdk_widget_scrollable_content_container"
        app:layout_constraintWidth_max="@dimen/signin_sdk_max_width">
        <Button
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            style="@style/SignInWidget.FooterButton"/>
    </LinearLayout>
</merge>
