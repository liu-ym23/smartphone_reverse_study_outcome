<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="280dp"
    android:layout_height="168dp">
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/quit_dialog_title"
        android:layout_width="240dp"
        android:layout_height="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"
        android:text="@string/ttlive_quit_room_confirm_title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#bf161823"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/quit_dialog_content"
        android:layout_width="240dp"
        android:layout_height="40dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="24dp"/>
    <View
        android:id="@+id/live_dialog_divider_1"
        style="@style/ttlive_live_dialog_divider_horizontal"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <Button
            android:textSize="15sp"
            android:textColor="#bf161823"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/quit_button"
            android:background="@drawable/ttlive_bg_pk_room_close_dialog_btn_bottom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/ttlive_live_guide_feed_quit"
            android:maxLines="1"
            android:lines="1"
            android:layout_weight="1"/>
        <View
            android:background="#1f161823"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"/>
        <Button
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/continue_button"
            android:background="@drawable/ttlive_bg_pk_room_close_dialog_btn_bottom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/ttlive_quit_room_continue_watch"
            android:maxLines="1"
            android:lines="1"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
