<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/ec_shop_middle_coupon_filter_layout"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="8dp"
    android:layout_marginRight="8dp"
    android:layout_marginBottom="8dp"
    android:weightSum="1">
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/ec_shop_coupon_iv"
        android:layout_width="wrap_content"
        android:layout_height="12dp"
        android:layout_marginEnd="4dp"/>
    <com.bytedance.android.ec.store.view.ECTagListView
        android:id="@+id/ec_shop_coupon_text_tag_list"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.bytedance.android.ec.store.view.ECShopCountdownTimerView
        android:id="@+id/ec_shop_coupon_timer_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <View
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"/>
    <com.bytedance.android.ec.store.view.ECShopCouponStateButton
        android:id="@+id/ec_shop_coupon_state_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"/>
    <View
        android:id="@+id/ec_shop_coupon_divider_line_view"
        android:background="#4d161823"
        android:layout_width="0.5dp"
        android:layout_height="match_parent"
        android:layout_marginTop="11dp"
        android:layout_marginBottom="11dp"
        android:layout_marginStart="8dp"/>
    <com.bytedance.android.ec.store.view.ECShopCouponSelectButton
        android:id="@+id/ec_shop_coupon_select_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"/>
</LinearLayout>
