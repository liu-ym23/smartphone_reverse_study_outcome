<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.locallife.dito.baseview.RoundLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/poi_item_exp_product_314784218"
    android:background="#08161823"
    android:layout_width="wrap_content"
    android:layout_height="162dp"
    app:rounded_radius="2dp">
    <FrameLayout
        android:id="@+id/poi_item_exp_product_328338917"
        android:layout_width="match_parent"
        android:layout_height="98dp">
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/poi_dcd_product_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="centerCrop"/>
        <com.bytedance.dux.text.DuxTextView
            android:textSize="12dp"
            android:textColor="@color/ConstTextInverse"
            android:gravity="center"
            android:id="@+id/poi_dcd_product_label"
            android:background="@drawable/poi_bg_dcd_label"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp"/>
    </FrameLayout>
    <com.bytedance.dux.text.DuxTextView
        android:textSize="12dp"
        android:textColor="@color/POITextPrimary"
        android:id="@+id/poi_dcd_product_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp">
        <com.bytedance.dux.text.DuxTextView
            android:textSize="10dp"
            android:textStyle="bold"
            android:textColor="@color/POIPrimary"
            android:id="@+id/price_before_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:text="@string/poi_price_prefix"/>
        <com.bytedance.dux.text.DuxTextView
            android:textSize="15dp"
            android:textColor="@color/POIPrimary"
            android:id="@+id/poi_dcd_product_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"/>
    </LinearLayout>
</com.bytedance.locallife.dito.baseview.RoundLinearLayout>
