<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/comment_smart_reply_preview_bg_selector"
    android:paddingLeft="6dp"
    android:paddingTop="@dimen/dp_4"
    android:paddingRight="6dp"
    android:paddingBottom="@dimen/dp_4"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.middleground.comment.widget.PreviewTextView
        android:textSize="14sp"
        android:textColor="@color/text_caption"
        android:id="@+id/smart_reply_textview"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:lineSpacingExtra="4dp"/>
    <LinearLayout
        android:layout_gravity="bottom|right"
        android:orientation="horizontal"
        android:id="@+id/view_button_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/see_more_gradient"
            android:background="@drawable/comment_smart_reply_preview_gradient_selector"
            android:layout_width="28dp"
            android:layout_height="match_parent"/>
        <TextView
            android:textColor="@color/text_link_normal"
            android:gravity="bottom|right"
            android:id="@+id/see_more_textview"
            android:background="@drawable/comment_smart_reply_preview_tv_bg_selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="24dp"
            android:text="@string/LarkCCM_Docs_CommentAi_View_Button"
            android:lineSpacingExtra="2sp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/close"
            android:background="@drawable/comment_smart_reply_preview_tv_bg_selector"
            android:paddingLeft="6dp"
            android:paddingTop="6dp"
            android:paddingRight="6dp"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/ud_icon_close_outlined"
            app:tint="@color/icon_n3"/>
    </LinearLayout>
</FrameLayout>
