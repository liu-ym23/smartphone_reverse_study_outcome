<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/ttlive_room_block_word_background"
    android:layout_width="wrap_content"
    android:layout_height="28dp">
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ttlive_white_90"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_block_word"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"/>
    <FrameLayout
        android:id="@+id/btn_block_word_delete"
        android:paddingLeft="4dp"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <View
            android:layout_gravity="center"
            android:background="@drawable/ttlive_blockword_delete_white"
            android:layout_width="10dp"
            android:layout_height="10dp"/>
    </FrameLayout>
</LinearLayout>
