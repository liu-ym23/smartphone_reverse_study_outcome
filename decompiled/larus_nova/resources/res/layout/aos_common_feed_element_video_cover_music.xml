<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:layout_width="49dp"
    android:layout_height="49dp">
    <com.bytedance.awemeopen.apps.framework.base.view.PeriscopeLayout
        android:layout_gravity="end|bottom"
        android:id="@+id/notes_layout"
        android:layout_width="95dp"
        android:layout_height="95dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="-22dp"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/music_cover_container"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"
        android:layout_width="44dp"
        android:layout_height="44dp">
        <ImageView
            android:id="@+id/music_cover"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/aos_legacy_ic_img_defaultmusic"/>
        <com.bytedance.awemeopen.infra.base.image.AoImageView
            android:layout_gravity="center"
            android:id="@+id/origin_music_cover"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:visibility="gone"
            android:layout_width="26dp"
            android:layout_height="26dp"/>
        <com.bytedance.awemeopen.infra.base.image.AoImageView
            android:layout_gravity="center"
            android:id="@+id/origin_music_cover_owner"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:visibility="gone"
            android:layout_width="44dp"
            android:layout_height="44dp"/>
    </FrameLayout>
</FrameLayout>
