<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="2px"
    android:layout_width="wrap_content"
    android:layout_height="16dp">
    <com.bytedance.android.ec.core.widget.ECNetImageView
        android:id="@+id/niv_icon"
        android:layout_width="50dp"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/ec_color_activity_label_text_new"
        android:gravity="center"
        android:id="@+id/activity_des"
        android:background="@color/shopping_color_14FF3344"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"/>
    <com.bytedance.android.livesdk.livecommerce.promotion.card.view.ECNewCountDownView
        android:typeface="monospace"
        android:textColor="@color/ec_color_activity_label_text_new"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_count_down"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="4dp"
        android:maxLines="1"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="4dp"
        style="@style/font_size_20"/>
</merge>
