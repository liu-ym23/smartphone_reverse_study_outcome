<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/photo"
        android:layout_width="@dimen/larus_dp_40"
        android:layout_height="@dimen/larus_dp_40"
        android:layout_marginTop="@dimen/larus_dp_12"
        android:layout_alignParentTop="true"
        android:layerType="hardware"
        android:layout_marginStart="@dimen/larus_dp_12"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/larus_dp_12"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/larus_dp_12"
        android:layout_toEndOf="@+id/photo">
        <TextView
            android:textSize="@dimen/larus_dp_16"
            android:textStyle="bold"
            android:textColor="@color/larus_rtc_notification_title_dark"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textSize="@dimen/larus_dp_15"
            android:textColor="@color/larus_rtc_notification_content_dark"
            android:ellipsize="end"
            android:gravity="start|top"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/larus_dp_2"
            android:layout_marginBottom="@dimen/larus_dp_4"
            android:singleLine="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/larus_dp_14"
                android:textStyle="bold"
                android:textColor="@color/larus_rtc_notification_btn_dark"
                android:gravity="center"
                android:id="@+id/mute_btn"
                android:paddingTop="@dimen/larus_dp_4"
                android:paddingBottom="@dimen/larus_dp_12"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingEnd="@dimen/larus_dp_8"/>
            <TextView
                android:textSize="@dimen/larus_dp_14"
                android:textStyle="bold"
                android:textColor="@color/larus_rtc_notification_btn_dark"
                android:gravity="center"
                android:id="@+id/hangup_btn"
                android:paddingTop="@dimen/larus_dp_4"
                android:paddingBottom="@dimen/larus_dp_12"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/larus_end_btn"
                android:paddingStart="@dimen/larus_dp_8"
                android:paddingEnd="@dimen/larus_dp_8"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/large_icon"
        android:layout_width="@dimen/larus_dp_18"
        android:layout_height="@dimen/larus_dp_18"
        android:layout_marginTop="@dimen/larus_dp_27"
        android:layout_alignParentTop="true"
        android:layerType="hardware"
        android:layout_marginEnd="@dimen/larus_dp_16"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
