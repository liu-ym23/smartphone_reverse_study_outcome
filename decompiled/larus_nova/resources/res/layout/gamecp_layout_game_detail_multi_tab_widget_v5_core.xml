<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:id="@+id/game_detail_dialog_bg"
        android:background="#fff3f3f4"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.gamecp.business.gamedetail.view.NestedParentRecyclerView
        android:id="@+id/rv_game_detail_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"/>
    <FrameLayout
        android:id="@+id/ttlive_game_detail_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/gamecp_status_bar_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/gamecp_convert_layout"
        android:background="@color/white"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/gamecp_floating_window_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="36dp"/>
        <View
            android:id="@+id/gamecp_convert_bar_line"
            android:background="#1f161823"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <FrameLayout
            android:id="@+id/gamecp_convert_bar_container"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7.5dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/gamecp_detail_below_bottomsheet_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/gamecp_detail_title_bar_bg_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:background="#161823"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.bytedance.android.gamecp.common.ui.HSImageView
                android:id="@+id/gamecp_detail_title_bar_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:actualImageScaleType="centerCrop"/>
            <View
                android:background="#1f000000"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </FrameLayout>
</merge>
