<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/photo_content_layout"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="39dp"
            app:layout_constraintBottom_toTopOf="@+id/share_layout"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">
            <ImageView
                android:id="@+id/content"
                android:layout_width="331dp"
                android:layout_height="509dp"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <ImageView
                android:id="@+id/avatar"
                android:background="@drawable/ttlive_group_photo_large_oval_bg"
                android:paddingLeft="1dp"
                android:paddingTop="1dp"
                android:paddingRight="1dp"
                android:paddingBottom="4dp"
                android:layout_width="30dp"
                android:layout_height="33dp"
                app:layout_constraintBottom_toTopOf="@+id/small_avatar"
                app:layout_constraintLeft_toLeftOf="@+id/small_avatar"
                app:layout_constraintRight_toRightOf="@+id/small_avatar"/>
            <ImageView
                android:id="@+id/small_avatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="@+id/content"
                app:layout_constraintTop_toTopOf="@+id/content"/>
            <ImageView
                android:id="@+id/qr_code"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="48dp"
                app:layout_constraintBottom_toBottomOf="@+id/content"
                app:layout_constraintRight_toRightOf="@+id/content"/>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/ttlive_group_photo_share_text_color"
                android:gravity="center"
                android:id="@+id/qr_code_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:includeFontPadding="false"
                app:layout_constraintLeft_toLeftOf="@+id/qr_code"
                app:layout_constraintRight_toRightOf="@+id/qr_code"
                app:layout_constraintTop_toBottomOf="@+id/qr_code"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/share_layout"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="27dp"
            android:alpha="0"
            app:layout_constraintBottom_toTopOf="@+id/cancel_icon"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">
            <View
                android:id="@+id/horizontal_line_left"
                android:background="@color/white"
                android:layout_width="24dp"
                android:layout_height="1dp"
                app:layout_constraintBottom_toBottomOf="@+id/share_text"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/share_text"
                app:layout_constraintTop_toTopOf="@+id/share_text"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/white"
                android:id="@+id/share_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:layout_marginBottom="20dp"
                android:text="@string/ttlive_group_photo_share_title_text"
                app:layout_constraintBottom_toTopOf="@+id/share_item_container"
                app:layout_constraintLeft_toRightOf="@+id/horizontal_line_left"
                app:layout_constraintRight_toLeftOf="@+id/horizontal_line_right"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/horizontal_line_right"
                android:background="@color/white"
                android:layout_width="24dp"
                android:layout_height="1dp"
                app:layout_constraintBottom_toBottomOf="@+id/share_text"
                app:layout_constraintLeft_toRightOf="@+id/share_text"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/share_text"/>
            <include
                android:id="@+id/share_item_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                layout="@layout/ttlive_dialog_group_photo_share_layout"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:id="@+id/cancel_icon"
            android:padding="8dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ttlive_group_photo_cancel"
            android:alpha="0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
