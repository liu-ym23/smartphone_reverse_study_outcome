<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/gamecp_shape_game_detail_template_comment_bg"
    android:layout_width="match_parent"
    android:layout_height="40dp">
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:id="@+id/tv_gamecp_comment_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_game_promote_comment"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#80161823"
        android:id="@+id/tv_comment_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_gamecp_comment_title"
        app:layout_constraintStart_toEndOf="@+id/tv_gamecp_comment_title"
        app:layout_constraintTop_toTopOf="@+id/tv_gamecp_comment_title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_comment_all"
        android:visibility="visible"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/gamecp_ic_game_promote_right_arrow_black"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
