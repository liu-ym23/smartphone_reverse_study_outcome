<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@color/ToastDefault"
    android:padding="10dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.bytedance.dux.image.DuxImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_icon"
        android:visibility="gone"
        android:layout_width="20sp"
        android:layout_height="20sp"
        android:layout_marginEnd="4dp"
        app:tint="@color/ConstTextInverse"/>
    <com.bytedance.dux.text.DuxTextView
        android:textSize="14sp"
        android:textColor="@color/ConstTextInverse"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.bytedance.dux.image.DuxImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_arrow"
        android:layout_width="12sp"
        android:layout_height="12sp"
        android:layout_marginStart="2dp"
        app:srcCompat="@drawable/ic_s_s_arrowforward_outlined_12"
        app:tint="@color/ConstTextInverse"/>
</merge>
