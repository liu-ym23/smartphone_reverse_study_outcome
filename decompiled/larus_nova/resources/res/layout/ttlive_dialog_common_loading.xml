<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/ttlive_white"
    android:paddingTop="24dp"
    android:layout_width="120dp"
    android:layout_height="120dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/live_dialog_loading"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ttlive_img_dialog_loading"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_live_dialog_message"
        android:gravity="center"
        android:id="@+id/live_dialog_message"
        android:layout_width="88dp"
        android:layout_height="20dp"
        android:layout_marginTop="20dp"
        android:text="@string/ttlive_live_dialog_loading"
        android:maxLines="1"
        android:singleLine="true"/>
</LinearLayout>
