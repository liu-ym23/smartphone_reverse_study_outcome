<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_similar_product_content_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/ec_similar_product_left_close_icon_container"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="@+id/ec_similar_product_text"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ec_similar_product_text">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/ec_similar_product_left_close_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ec_commerce_left_close_icon_light"/>
    </FrameLayout>
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/commerce_color_161823"
        android:id="@+id/ec_similar_product_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/commerce_visual_similar_product_text"
        android:layout_centerHorizontal="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:id="@+id/ec_similar_product_description_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:layout_marginRight="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/ec_similar_product_description_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ec_commerce_description_icon"/>
        <TextView
            android:textSize="13dp"
            android:textStyle="normal"
            android:textColor="@color/commerce_color_57161823"
            android:id="@+id/ec_similar_product_description_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:text="@string/commerce_description_text"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/ec_similar_product_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ec_similar_product_text">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ec_similar_product_frame_recyclerView"
            android:layout_width="match_parent"
            android:layout_height="55dp"/>
        <View
            android:id="@+id/ec_similar_product_divider_line"
            android:background="@color/shopping_color_1F161823"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_below="@+id/ec_similar_product_frame_recyclerView"/>
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/ec_similar_product_tab_layout"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_below="@+id/ec_similar_product_divider_line"
            app:tabBackground="@color/commerce_color_00000000"
            app:tabGravity="fill"
            app:tabRippleColor="@color/commerce_color_00000000"/>
        <RelativeLayout
            android:background="#f6f6f9"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/ec_similar_product_tab_layout">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ec_similar_product_card_recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/ec_similar_product_tab_layout"/>
            <com.bytedance.android.ec.core.widget.DoubleColorBallStatusView
                android:id="@+id/ec_similar_product_loading_view"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="55dp"
                android:layout_below="@+id/ec_similar_product_tab_layout"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ec_similar_product_initialize_loading_container"
        android:visibility="gone"
        android:layout_width="196dp"
        android:layout_height="120dp"
        android:layout_marginTop="166dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ec_similar_product_text">
        <com.bytedance.android.ec.core.widget.DoubleColorBallStatusView
            android:id="@+id/ec_similar_product_initialize_loading_view"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="33dp"/>
        <TextView
            android:textSize="13dp"
            android:textStyle="normal"
            android:textColor="@color/commerce_color_80161823"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/commerce_initialize_loading_text"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ec_search_similar_no_result_container"
        android:visibility="gone"
        android:layout_width="310dp"
        android:layout_height="264dp"
        android:layout_marginTop="106dp"
        android:layout_centerHorizontal="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ec_similar_product_text">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ec_commerce_ic_network_error_placeholder"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/commerce_color_80161823"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/commerce_search_similar_no_result"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/commerce_color_161823"
            android:gravity="center"
            android:id="@+id/ec_similar_product_no_result_button"
            android:background="@drawable/ec_commerce_search_similar_error_background"
            android:layout_width="231dp"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:text="@string/commerce_search_similar_no_result_button"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ec_search_similar_net_error_container"
        android:visibility="gone"
        android:layout_width="310dp"
        android:layout_height="264dp"
        android:layout_marginTop="106dp"
        android:layout_centerHorizontal="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ec_similar_product_text">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ec_commerce_ic_network_error_placeholder"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/commerce_color_80161823"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/commerce_search_similar_net_error"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/commerce_color_161823"
            android:gravity="center"
            android:id="@+id/ec_similar_product_net_error_button"
            android:background="@drawable/ec_commerce_search_similar_error_background"
            android:layout_width="231dp"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:text="@string/commerce_search_similar_net_error_button"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
