<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/larus_dora_bg_noti_v3_bottom_sheet"
        android:paddingBottom="48dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="17sp"
            android:textColor="@color/larus_neutral_100"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/larus_dora_broadcast_v3_special_chat_input_panel_title_cn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="17sp"
            android:textColor="@color/larus_neutral_50"
            android:id="@+id/tv_app_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/larus_dora_broadcast_v3_special_chat_app_field_title_cn"
            android:layout_marginStart="34dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="17sp"
            android:textColor="@color/larus_neutral_100"
            android:textColorHint="@color/larus_neutral_30"
            android:gravity="center_vertical"
            android:id="@+id/et_app_name"
            android:background="@drawable/larus_bg_input_normal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:hint="@string/larus_dora_broadcast_v3_special_chat_app_field_placeholder_cn"
            android:maxLines="1"
            android:singleLine="true"
            android:inputType="text"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_app_label"
            style="@style/larus_EditTextStyle"/>
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="17sp"
            android:textColor="@color/larus_neutral_50"
            android:id="@+id/tv_contact_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/larus_dora_broadcast_v3_special_chat_empty_cn"
            android:layout_marginStart="34dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/et_app_name"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="17sp"
            android:textColor="@color/larus_neutral_100"
            android:textColorHint="@color/larus_neutral_30"
            android:gravity="center_vertical"
            android:id="@+id/et_contact_name"
            android:background="@drawable/larus_bg_input_normal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:hint="@string/larus_dora_broadcast_v3_special_chat_name_placeholder_cn"
            android:maxLines="1"
            android:singleLine="true"
            android:inputType="text"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_contact_label"
            style="@style/larus_EditTextStyle"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="17sp"
            android:textColor="@color/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/btn_cancel"
            android:background="@drawable/larus_bg_input_normal"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="40dp"
            android:text="@string/larus_dora_broadcast_cancel_cn"
            android:textAllCaps="false"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="6dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            app:layout_constraintEnd_toStartOf="@+id/btn_confirm"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/et_contact_name"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="17sp"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/btn_confirm"
            android:background="@drawable/larus_dora_bg_noti_v3_confirm_btn"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="40dp"
            android:text="@string/larus_dora_g_confirm_cn"
            android:textAllCaps="false"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/btn_cancel"
            app:layout_constraintTop_toBottomOf="@+id/et_contact_name"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
