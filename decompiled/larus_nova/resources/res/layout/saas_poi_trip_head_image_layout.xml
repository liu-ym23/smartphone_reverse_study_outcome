<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.ugc.aweme.dito.poi.player.ui.HorizontalOverScrollLayout
        android:id="@+id/trip_head_image_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/trip_head_image_view_more"
            android:layout_width="12dp"
            android:layout_height="105dp"
            android:layout_centerVertical="true"/>
        <androidx.viewpager2.widget.ViewPager2
            android:orientation="horizontal"
            android:id="@+id/trip_head_image_swiper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.ss.android.ugc.aweme.dito.poi.player.ui.HorizontalOverScrollLayout>
    <FrameLayout
        android:id="@+id/trip_guide_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constri_video_down_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/video_check_left_container"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            fresco:layout_constraintStart_toStartOf="parent"
            fresco:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true">
                <View
                    android:id="@+id/video_check_white_back_view"
                    android:background="@drawable/poi_trip_head_image_video_left_corner"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"/>
                <com.bytedance.lighten.loader.SmartImageView
                    android:layout_width="56dp"
                    android:layout_height="34dp"
                    fresco:actualImageScaleType="fitXY"
                    fresco:placeholderImage="@drawable/icon_trip_head_video_check_right"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/check_video_text_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="16dp"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="14dp"
                android:layout_alignParentStart="true">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/avatar_linear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <com.bytedance.dux.text.DuxTextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/POIPrimary2"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/text_trip_video_check_in"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginStart="4dp"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_trip_video_check_in"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/icon_trip_head_image_video_arraw"/>
            </LinearLayout>
        </RelativeLayout>
        <com.bytedance.locallife.poi.newdetail.widget.trip.TripPoiHeadTagsWidget
            android:id="@+id/trip_head_image_tags_video"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            fresco:layout_constraintEnd_toEndOf="parent"
            fresco:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.locallife.poi.newdetail.widget.trip.TripPoiHeadTagsWidget
        android:id="@+id/trip_head_image_tags"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginStart="16dp"/>
    <com.bytedance.locallife.poi.newdetail.widget.PoiHeartbeatBadgeView
        android:layout_gravity="end"
        android:id="@+id/trip_head_image_heart"
        android:visibility="invisible"
        android:layout_width="110dp"
        android:layout_height="122dp"/>
</merge>
