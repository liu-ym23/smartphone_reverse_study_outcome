<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cj_pay_payment_method_activity_view"
    android:background="@color/cj_pay_color_trans"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/cj_pay_payment_method_root_view"
        android:background="@drawable/cj_pay_bg_payment_method_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="557dp">
        <include
            android:id="@+id/cj_pay_payment_method_title_bar"
            layout="@layout/cj_pay_view_titlebar_noise_reduction_layout"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/cj_pay_color_gray_light"
            android:layout_gravity="center"
            android:id="@+id/cj_pay_payment_method_desc"
            android:background="@color/cj_pay_color_gray_0D161823"
            android:paddingLeft="16dp"
            android:paddingTop="12dp"
            android:paddingRight="16dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/cj_pay_payment_method_title_bar"/>
        <RelativeLayout
            android:id="@+id/cj_pay_payment_method_content_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/cj_pay_payment_method_desc">
            <com.android.ttcjpaysdk.base.ui.anim.CJBoundScrollView
                android:id="@+id/cj_payment_scroll_view"
                android:scrollbars="none"
                android:clipToPadding="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:overScrollMode="always">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/cj_pay_method_content_holder"
                    android:paddingBottom="8dp"
                    android:descendantFocusability="blocksDescendants"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="14dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="14dp"/>
            </com.android.ttcjpaysdk.base.ui.anim.CJBoundScrollView>
        </RelativeLayout>
        <include
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/cj_pay_payment_method_title_bar"
            layout="@layout/cj_pay_view_half_screen_loading_layout"/>
    </RelativeLayout>
</FrameLayout>
