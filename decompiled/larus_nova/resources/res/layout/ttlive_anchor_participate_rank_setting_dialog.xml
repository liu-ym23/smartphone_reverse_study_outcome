<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/participate_setting_container"
    android:background="@drawable/ttlive_bg_participate_rank_setting"
    android:layout_width="match_parent"
    android:layout_height="484dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/old_title_view"
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <FrameLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/ttlive_dialog_sub_content_text"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/participate_setting_title"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/participate_rank_setting_title"
                android:alpha="0.7"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/back"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:src="@drawable/ttlive_panel_leave_arrow_dark"
                android:layout_marginStart="14dp"/>
        </FrameLayout>
        <View
            android:background="#1affffff"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="#80ffffff"
        android:id="@+id/participate_setting_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="16dp"/>
    <ListView
        android:id="@+id/participate_setting_switch_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:listSelector="@color/transparent"
        android:layout_weight="1"/>
</LinearLayout>
