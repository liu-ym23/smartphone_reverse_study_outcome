<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="66dp">
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerImageView
        android:id="@+id/contact_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="16dp"
        app:roundAsCircle="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:importantForAccessibility="noHideDescendants"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <TextView
            android:textSize="17dp"
            android:textColor="@color/ttlive_white"
            android:ellipsize="end"
            android:id="@+id/contact_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/ttlive_white_34"
            android:ellipsize="end"
            android:id="@+id/recommend_reason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp">
        <com.bytedance.android.uicomponent.compoundbutton.TranslucentCheckBox
            android:layout_gravity="center"
            android:id="@+id/contact_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            style="@style/ttlive_standard_check_box_style"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_white"
            android:gravity="center"
            android:id="@+id/contact_follow"
            android:background="@drawable/ttlive_chat_channel_invite_recommend_follow"
            android:layout_width="62dp"
            android:layout_height="24dp"
            android:text="@string/ttlive_chat_channel_recommend_follow"/>
    </FrameLayout>
</LinearLayout>
