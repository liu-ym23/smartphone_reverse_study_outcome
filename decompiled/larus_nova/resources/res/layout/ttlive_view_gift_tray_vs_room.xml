<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_gift_vs_room"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/ttlive_gift_tray_match_room_height">
    <TextView
        android:textSize="15dp"
        android:textColor="#b3ffffff"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/user_name_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:maxWidth="55dp"
        android:maxLines="1"
        android:maxEms="4"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#ffebd8"
        android:ellipsize="end"
        android:id="@+id/gift_description_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:maxLines="1"
        android:maxEms="6"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/user_name_tv"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.gift.platform.business.normal.view.v2.GiftIconMaskView
        android:id="@+id/gift_icon_animation_view"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="2dp"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/gift_description_tv"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/dynamic_gift_icon"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintStart_toStartOf="@+id/gift_icon_animation_view"
        app:layout_constraintTop_toTopOf="@+id/gift_icon_animation_view"/>
    <View
        android:id="@+id/end_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/gift_icon_animation_view"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/combo_body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/end_view"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="10dp"
            android:textColor="#ffffff"
            android:gravity="bottom"
            android:id="@+id/combo_count_x"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_gift_count"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:gravity="bottom"
            android:id="@+id/combo_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="10dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="12dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
