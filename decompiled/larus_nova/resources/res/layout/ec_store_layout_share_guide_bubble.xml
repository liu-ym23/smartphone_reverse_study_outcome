<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/ec_store_share_guide_bubble_up_triangle"
        android:layout_width="@dimen/ec_store_popup_tips_triangle_width"
        android:layout_height="@dimen/ec_store_popup_tips_triangle_height"
        android:src="@drawable/ec_store_ic_triangle_up_black"
        android:layout_marginEnd="18dp"/>
    <com.bytedance.android.ui.base.widget.round.RoundLinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ec_store_share_guide_bubble_content"
        android:paddingLeft="12dp"
        android:paddingTop="11dp"
        android:paddingRight="12dp"
        android:paddingBottom="11dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:bg_color="@color/ec_dux_black_393B44"
        app:bg_cornerRadius="12dp">
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:layout_gravity="end"
            android:id="@+id/ec_store_layout_share_bubble_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"/>
        <ImageView
            android:id="@+id/ec_store_layout_share_bubble_close_icon"
            android:layout_width="12sp"
            android:layout_height="12sp"
            android:src="@drawable/shopping_ic_store_share_guide_bubble_close_white"
            android:layout_marginStart="8dp"/>
    </com.bytedance.android.ui.base.widget.round.RoundLinearLayout>
</merge>
