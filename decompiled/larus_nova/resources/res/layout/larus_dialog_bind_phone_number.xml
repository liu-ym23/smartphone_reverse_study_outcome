<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_bottom_sheet_radius_24"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/iv_close_dialog"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_8"
        android:src="@drawable/larus_ic_close_dialog_btn"
        android:layout_marginEnd="?attr/larus_dp_8"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="?attr/larus_dp_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="?attr/larus_dp_56"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginTop="?attr/larus_dp_40"
            android:src="@drawable/larus_ic_bind_phone_warning_new"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="?attr/larus_dp_22"
            android:textStyle="bold"
            android:textColor="@color/larus_neutral_100"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_20"
            android:text="@string/larus_change_phone_num_bottomsheet_title_unlink"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="?attr/larus_dp_15"
            android:textColor="@color/larus_neutral_70"
            android:gravity="center"
            android:id="@+id/text_bind_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/larus_dp_28"
            android:layout_marginTop="?attr/larus_dp_8"
            android:layout_marginRight="?attr/larus_dp_28"
            android:text="@string/larus_change_phone_num_bottomsheet_desc_unlink"
            android:lineSpacingMultiplier="1.2"
            android:fontFamily="sans-serif-medium"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_17"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/button_bind_phone"
            android:background="@drawable/larus_auto_publish_confirm"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginLeft="?attr/larus_dp_28"
            android:layout_marginTop="?attr/larus_dp_20"
            android:layout_marginRight="?attr/larus_dp_28"
            android:text="@string/larus_mobile_unbind_button_cn"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</FrameLayout>
