<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="32dp">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp">
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:id="@+id/good_prod_head_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cornerRadius="4dp"/>
        <View
            android:background="@color/good_price_strip_image_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cornerRadius="4dp"/>
    </FrameLayout>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/TextSecondary_Light"
        android:layout_gravity="center_vertical"
        android:id="@+id/good_prod_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"/>
    <com.bytedance.android.ec.core.widget.price.PriceView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/Primary_Light"
        android:layout_gravity="center_vertical"
        android:id="@+id/good_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:layout_width="11dp"
        android:layout_height="11dp"
        android:src="@drawable/commerce_good_price_prod_arrow_right_icon"
        android:layout_marginEnd="6dp"/>
</LinearLayout>
