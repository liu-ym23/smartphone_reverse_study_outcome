<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/gamecp_xt_bg_white_round_corner_rect_dialog"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <com.bytedance.android.gamecp.common.ui.HSImageView
        android:id="@+id/live_dialog_image"
        android:background="@color/gamecp_white"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="50dp"
        android:layout_marginRight="50dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"/>
    <View
        android:id="@+id/live_dialog_image_block"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp"/>
    <RelativeLayout
        android:id="@+id/ttlive_xg_exit_dialog_close_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:src="@drawable/gamecp_dialog_xt_exit_close"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="18dp"
        android:textColor="#222222"
        android:gravity="center_horizontal"
        android:id="@+id/live_dialog_title"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <View
        android:id="@+id/live_dialog_title_message_block"
        android:layout_width="match_parent"
        android:layout_height="12dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#505050"
        android:gravity="center"
        android:id="@+id/live_dialog_message"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:textAllCaps="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <View
        android:id="@+id/live_dialog_bottom_block"
        android:layout_width="match_parent"
        android:layout_height="18dp"/>
    <FrameLayout
        android:id="@+id/live_dialog_frame"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:gravity="end"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <LinearLayout
            android:gravity="end"
            android:orientation="horizontal"
            android:id="@+id/live_dialog_container"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.android.gamecp.common.ui.FitButton
                android:textSize="15dp"
                android:textColor="#222222"
                android:id="@+id/live_dialog_btn_1"
                android:background="@color/transparent"
                android:layout_width="0dp"
                android:layout_weight="1"
                style="@style/gamecp_live_dialog_button_horizontal"/>
            <com.bytedance.android.gamecp.common.ui.FitButton
                android:textSize="15dp"
                android:textColor="#f85656"
                android:id="@+id/live_dialog_btn_2"
                android:background="@color/transparent"
                android:layout_width="0dp"
                android:layout_weight="1"
                style="@style/gamecp_live_dialog_button_horizontal"/>
        </LinearLayout>
        <View
            android:background="@drawable/gamecp_dialog_divider_horizontal"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/live_dialog_divider_vertical"
            android:background="@drawable/gamecp_dialog_divider_vertical"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="1dp"/>
    </FrameLayout>
</LinearLayout>
