<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larksuite.component.universe_design.shadow.UDShadowLayout
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/UDShadow.L.Up">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/content_layout"
            android:background="@drawable/facade_round_top_xxl"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="0dp"
            android:layout_marginBottom="0dp"
            android:backgroundTint="@color/bg_body">
            <com.bytedance.ee.bear.widgets.BaseTitleBar
                android:id="@+id/title_bar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="@color/facade_selector_icon_n1"
                app:widget_widgets_tb_back_icon="@drawable/ud_icon_close_small_outlined"
                app:widget_widgets_tb_background="@color/color_transparent"
                app:widget_widgets_tb_divider_height="@dimen/ud_divider_size"
                app:widget_widgets_tb_divider_visible="true"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:paddingLeft="@dimen/space_kit_len_8"
                android:paddingRight="@dimen/space_kit_len_8"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:nestedScrollingEnabled="false"/>
        </LinearLayout>
    </com.larksuite.component.universe_design.shadow.UDShadowLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_no_data"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.ee.bear.widgets.universedesign.SpaceEmptyState
            app:ud_empty_desc="@string/Doc_Doc_StructureEmtpyTips"
            app:ud_empty_imageRes="@drawable/ccm_empty_neutral_no_content"
            style="@style/SpaceEmptyStatusStyle"/>
    </LinearLayout>
</FrameLayout>
