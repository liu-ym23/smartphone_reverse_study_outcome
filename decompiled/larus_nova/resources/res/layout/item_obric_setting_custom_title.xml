<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_basic_text_1"
        android:ellipsize="end"
        android:id="@+id/custom_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Title_1_Regular"/>
    <com.obric.oui.tag.OTextTag
        android:textSize="@dimen/dp_11"
        android:textColor="@color/obric_guide_blue_6"
        android:gravity="center"
        android:id="@+id/custom_title_new_tag"
        android:background="@drawable/bg_obric_action_bar_phone_operation_mode_feature"
        android:paddingTop="@dimen/dp_2"
        android:paddingBottom="@dimen/dp_2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:paddingStart="@dimen/dp_6"
        android:paddingEnd="@dimen/dp_6"
        android:layout_marginStart="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="@+id/custom_title_text"
        app:layout_constraintStart_toEndOf="@+id/custom_title_text"
        app:layout_constraintTop_toTopOf="@+id/custom_title_text"
        app:oui_radius="@dimen/dp_4"/>
    <ImageView
        android:id="@+id/custom_title_tips_icon"
        android:padding="1dp"
        android:visibility="gone"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:src="@drawable/ic_obric_setting_tips"
        android:layout_marginStart="@dimen/dp_2"
        app:layout_constraintBottom_toBottomOf="@+id/custom_title_text"
        app:layout_constraintStart_toEndOf="@+id/custom_title_new_tag"
        app:layout_constraintTop_toTopOf="@+id/custom_title_text"/>
    <ImageView
        android:id="@+id/custom_title_beta_icon"
        android:visibility="gone"
        android:layout_width="@dimen/dp_28"
        android:layout_height="@dimen/dp_16"
        android:src="@drawable/ic_obric_setting_beta"
        android:layout_marginStart="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="@+id/custom_title_text"
        app:layout_constraintStart_toEndOf="@+id/custom_title_tips_icon"
        app:layout_constraintTop_toTopOf="@+id/custom_title_text"
        app:layout_goneMarginStart="@dimen/dp_4"/>
    <com.obric.oui.badge.OBadgeView
        android:id="@+id/custom_title_red_point"
        android:visibility="gone"
        android:layout_width="@dimen/dp_8"
        android:layout_height="@dimen/dp_8"
        android:layout_marginStart="@dimen/dp_2"
        app:layout_constraintBottom_toBottomOf="@+id/custom_title_text"
        app:layout_constraintStart_toEndOf="@+id/custom_title_beta_icon"
        app:layout_constraintTop_toTopOf="@+id/custom_title_text"
        app:layout_goneMarginStart="@dimen/dp_2"
        style="@style/OBadgeView.S1.Default.Red"/>
</androidx.constraintlayout.widget.ConstraintLayout>
