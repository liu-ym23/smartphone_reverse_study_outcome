<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/larus_bg_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/larus_neutral_50"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/desc"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_24"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginRight="?attr/larus_dp_24"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:text="@string/larus_image_chat_bg_tip"/>
    <View
        android:id="@+id/desc_btn_divider"
        android:background="@color/larus_neutral_transparent_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/auto_gen_btn"
        android:background="@drawable/larus_bg_avatar_action_ai"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/auto_fill_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="?attr/larus_dp_4"
            app:srcCompat="@drawable/larus_ic_bot_create_ai_colorful"/>
        <com.larus.common_ui.widget.GradientTextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/larus_neutral_100"
            android:layout_gravity="center"
            android:id="@+id/auto_fill_title"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_ai_generate_picture"
            android:maxLines="1"
            android:singleLine="true"/>
    </LinearLayout>
    <View
        android:background="@color/larus_neutral_transparent_2"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/upload_pic_btn"
        android:background="@drawable/larus_bg_avatar_action_btn"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/larus_neutral_100"
            android:layout_gravity="center"
            android:id="@+id/upload_avatar_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_upload_photo"/>
    </LinearLayout>
    <View
        android:background="@color/larus_base_4_overlay"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_8"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/cancel_btn"
        android:background="@drawable/larus_bg_avatar_action_btn"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/larus_neutral_100"
            android:layout_gravity="center"
            android:id="@+id/cancel_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_key_regenerate_double_confirm_cancel"/>
    </LinearLayout>
</LinearLayout>
