<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <com.larksuite.component.universe_design.checkbox.UDCheckBox
        android:id="@+id/checkBox"
        android:clickable="false"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/permissionName"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap"
        app:ud_checkbox_size="small"
        app:ud_checkbox_type="radio"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/text_title"
        android:id="@+id/permissionName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="11.5dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toRightOf="@+id/checkBox"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap"/>
    <LinearLayout
        android:id="@+id/permissionRoot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/permissionName">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="@color/text_placeholder"
            android:id="@+id/permissionTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_4"
            android:text="@string/CreationMobile_Wiki_Permission_FullAccess_Options"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toRightOf="@+id/permissionName"
            app:layout_constraintRight_toLeftOf="@+id/permissionIcon"
            app:layout_constraintTop_toTopOf="@+id/permissionName"
            app:layout_constraintWidth_default="wrap"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/permissionIcon"
            android:layout_width="10dp"
            android:layout_height="14dp"
            android:layout_marginTop="4dp"
            android:tint="@color/text_placeholder"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/permissionTag"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ud_icon_right_bold_outlined"/>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:background="@color/ud_divider_color"
        android:layout_width="0dp"
        android:layout_height="@dimen/space_kit_len_divider"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/permissionName"
        app:layout_constraintTop_toBottomOf="@+id/permissionName"/>
</androidx.constraintlayout.widget.ConstraintLayout>
