<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/expand_collapse_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/space_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="?attr/larus_dp_2"
        app:layout_constraintBottom_toBottomOf="@+id/ll_expand"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ll_expand">
        <View
            android:background="?attr/neutral_transparent_2"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_1"
            android:layout_marginStart="?attr/larus_dp_56"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_expand"
        android:padding="?attr/larus_dp_6"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/space_start"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="13sp"
            android:textColor="?attr/neutral_70"
            android:gravity="center"
            android:id="@+id/tv_expand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_arrow_down"
            android:layout_width="?attr/larus_dp_16"
            android:layout_height="?attr/larus_dp_16"
            android:layout_marginTop="?attr/larus_dp_1"
            android:src="?attr/comment_icon_arrow_down"
            android:layout_marginStart="?attr/larus_dp_2"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/ll_collapse"
        android:padding="?attr/larus_dp_6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ll_expand"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="?attr/larus_sp_13"
            android:textColor="?attr/neutral_70"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_collapse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_botsComment_commentPanel_label_collapse"
            android:fontFamily="sans-serif-medium"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_arrow_up"
            android:layout_width="?attr/larus_dp_16"
            android:layout_height="?attr/larus_dp_16"
            android:layout_marginTop="?attr/larus_dp_1"
            android:src="?attr/comment_icon_arrow_up_light"
            android:layout_marginStart="?attr/larus_dp_2"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_loading"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/space_start"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="13sp"
            android:textColor="?attr/neutral_70"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_loading"
            android:paddingTop="?attr/larus_dp_6"
            android:paddingBottom="?attr/larus_dp_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"/>
        <android.widget.ProgressBar
            android:layout_gravity="center_vertical"
            android:id="@+id/pb_loading"
            android:layout_width="?attr/larus_dp_14"
            android:layout_height="?attr/larus_dp_14"
            android:indeterminate="true"
            android:indeterminateDuration="1000"
            android:interpolator="@android:anim/linear_interpolator"
            android:layout_marginStart="?attr/larus_dp_2"
            android:indeterminateTint="@color/larus_neutral_70"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
