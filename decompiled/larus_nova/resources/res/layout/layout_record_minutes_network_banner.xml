<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@color/larus_additional_orange"
    android:paddingTop="18dp"
    android:paddingBottom="18dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/icon_warning_circle"
        android:importantForAccessibility="no"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/larus_additional_brown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_dora_ai_active_record_offline_upload_summary_tip_cn"
        android:layout_marginStart="8dp"/>
</LinearLayout>
