<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="72dp">
    <com.bytedance.android.livesdk.widget.VHeadView
        android:layout_gravity="center"
        android:id="@+id/guest_head_view"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_ic_default_head_small"
        app:retryImageScaleType="fitXY"
        app:roundAsCircle="true"/>
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout
        android:layout_gravity="center"
        android:id="@+id/fl_investor_head_view"
        android:background="@color/white"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="11dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="30dp"
        app:layout_constraintStart_toStartOf="@+id/guest_head_view"
        app:layout_constraintTop_toTopOf="@+id/guest_head_view"
        app:placeholderImage="@drawable/ttlive_ic_default_head_small"
        app:retryImageScaleType="fitXY"
        app:roundAsCircle="true"
        app:ttlive_allRadius="50dp">
        <com.bytedance.android.livesdk.widget.VHeadView
            android:layout_gravity="center"
            android:id="@+id/investor_head_view"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:importantForAccessibility="no"
            app:placeholderImage="@drawable/ttlive_ic_default_head_small"
            app:retryImageScaleType="fitXY"
            app:roundAsCircle="true"/>
    </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#404040"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_nick_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:maxLines="1"
        android:maxEms="7"
        android:singleLine="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintLeft_toRightOf="@+id/fl_investor_head_view"
        app:layout_constraintRight_toLeftOf="@+id/tv_change_pair"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_pair_icon"
        android:layout_width="15dp"
        android:layout_height="12dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="7dp"
        android:src="@drawable/ttlive_video_friend_pair_icon"
        android:layout_marginStart="8dp"
        app:layout_constraintLeft_toRightOf="@+id/fl_investor_head_view"
        app:layout_constraintTop_toBottomOf="@+id/tv_nick_name"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#b3161823"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_investor_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="16dp"
        android:maxEms="7"
        android:singleLine="true"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintLeft_toRightOf="@+id/iv_pair_icon"
        app:layout_constraintRight_toLeftOf="@+id/tv_change_pair"
        app:layout_constraintTop_toBottomOf="@+id/tv_nick_name"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#e6000000"
        android:gravity="center"
        android:id="@+id/tv_change_pair"
        android:background="@drawable/ttlive_bg_video_friend_change_pair"
        android:layout_width="64dp"
        android:layout_height="28dp"
        android:layout_marginRight="8dp"
        android:text="@string/ttlive_video_friend_change_pair"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tv_pair"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_pair"
        android:background="@drawable/ttlive_bg_video_friend_pair"
        android:layout_width="64dp"
        android:layout_height="28dp"
        android:layout_marginRight="16dp"
        android:text="@string/ttlive_video_friend_pair"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
