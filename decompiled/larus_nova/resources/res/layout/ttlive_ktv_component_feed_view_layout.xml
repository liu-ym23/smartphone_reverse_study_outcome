<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.livesdk.ktvimpl.ktvroom.view.midi.KtvComponentMidiView
        android:id="@+id/feed_midi_view"
        android:visibility="gone"
        android:layout_width="235dp"
        android:layout_height="72dp"
        android:layout_marginEnd="@dimen/ttlive_ktv_component_midi_end_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/ktv_lyrics_container"
        android:clipChildren="true"
        android:layout_width="0dp"
        android:layout_height="@dimen/ttlive_ktv_lyrics_view_height"
        app:layout_constraintEnd_toStartOf="@+id/view_guide_line"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/view_guide_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/feed_midi_view">
        <com.bytedance.android.livesdk.ktvimpl.base.view.KtvAudienceLyricsDisplayView
            android:id="@+id/ktv_lyrics_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include layout="@layout/ttlive_ktv_prepare_sing_info_container_layout"/>
    <FrameLayout
        android:id="@+id/multiple_ktv_icon_container"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/feed_midi_view">
        <View
            android:layout_gravity="center"
            android:background="@drawable/ttlive_ktv_icon_bg"
            android:layout_width="34dp"
            android:layout_height="34dp"/>
        <com.bytedance.android.live.ktv.common.midi.KtvComponentProgressView
            android:layout_gravity="center"
            android:id="@+id/multiple_ktv_progress"
            android:layout_width="34dp"
            android:layout_height="34dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/multiple_ktv_tv"
            android:visibility="visible"
            android:layout_width="26dp"
            android:layout_height="14dp"
            android:src="@drawable/ttlive_ktv_component_order_txt"/>
    </FrameLayout>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/multiple_ktv_animation_view"
        android:visibility="gone"
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_guide_line"
        app:layout_constraintEnd_toEndOf="@+id/view_guide_line"
        app:layout_constraintStart_toStartOf="@+id/view_guide_line"
        app:layout_constraintTop_toTopOf="@+id/view_guide_line"/>
    <View
        android:id="@+id/view_guide_line"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/feed_midi_view"/>
</merge>
