<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/shopping_layout_match_purchase_live_923168556"
    android:background="@drawable/shopping_bg_match_purchase_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textColor="#e6161823"
        android:id="@+id/match_purchase_fragment_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:text="@string/shopping_match_purchase_fragment_title"
        android:layout_marginStart="16dp"/>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/match_purchase_fragment_title_v2_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <TextView
            android:textSize="15dp"
            android:textColor="#ff161823"
            android:layout_gravity="center"
            android:id="@+id/match_purchase_fragment_title_v2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/match_purchase_fragment_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/shopping_mp_live_panel_close"
            android:layout_marginEnd="20dp"/>
    </FrameLayout>
    <View
        android:id="@+id/match_purchase_fragment_divider"
        android:background="@color/commerce_color_0F161823"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="8dp"/>
    <FrameLayout
        android:id="@+id/fl_mp_core_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
