<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/time_limit_content_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:background="@drawable/ttlive_ic_notice"
        style="@style/uicomponent_common_alert_dialog_icon_iv"/>
    <TextView
        android:id="@+id/time_limit_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        style="@style/uicomponent_common_alert_dialog_title_tv"/>
    <TextView
        android:id="@+id/time_limit_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/uicomponent_common_alert_dialog_content_tv"/>
</LinearLayout>
