<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_tab_view_parent"
    android:background="@color/gamecp_game_F8F8F8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tl_game_detail_tab_layout"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:tabBackground="@color/transparent"
        app:tabIndicator="@drawable/gamecp_game_detail_tab_indicator"
        app:tabIndicatorColor="@color/gamecp_game_161823"
        app:tabMaxWidth="200dp"
        app:tabMinWidth="68dp"
        app:tabMode="scrollable"
        app:tabPaddingEnd="20dp"
        app:tabPaddingStart="20dp"
        app:tabRippleColor="@color/transparent"
        app:tabSelectedTextColor="@color/gamecp_game_161823"
        app:tabTextAppearance="@style/gamecp_game_detail_tab_layout_style"
        app:tabTextColor="@color/gamecp_game_80161823"/>
    <View
        android:id="@+id/v_game_detail_tab_line"
        android:background="#1f161823"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <FrameLayout
        android:id="@+id/vp_game_detail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
