<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:background="@drawable/larus_bg_drive_share"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/close_iv"
            android:layout_width="?attr/larus_dp_32"
            android:layout_height="?attr/larus_dp_32"
            android:layout_marginTop="?attr/larus_dp_14"
            android:src="@drawable/larus_ic_slides_share_close"
            android:contentDescription="@string/larus_accessibility_icon_close"
            android:layout_marginEnd="?attr/larus_dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/share_title_container"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_52"
            android:layout_marginTop="?attr/larus_dp_20"
            android:layout_marginStart="?attr/larus_dp_20"
            android:layout_marginEnd="?attr/larus_dp_64"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/larus_neutral_100"
                android:ellipsize="end"
                android:id="@+id/share_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/share_subtitle_privacy"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_20"
                android:layout_marginTop="?attr/larus_dp_6"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/share_title">
                <ImageView
                    android:id="@+id/privacy_iv"
                    android:layout_width="?attr/larus_dp_16"
                    android:layout_height="?attr/larus_dp_16"
                    android:src="@drawable/larus_slides_lock"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="?attr/larus_sp_14"
                    android:textColor="@color/larus_neutral_70"
                    android:id="@+id/privacy_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="?attr/larus_dp_4"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/privacy_iv"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/private_next"
                    android:layout_width="?attr/larus_dp_12"
                    android:layout_height="?attr/larus_dp_12"
                    android:src="@drawable/larus_ic_left_bold"
                    android:layout_marginStart="?attr/larus_dp_8"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/privacy_title"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.6"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:id="@+id/divider"
            android:background="@color/larus_neutral_transparent_2"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_0_5"
            android:layout_marginTop="?attr/larus_dp_20"
            app:layout_constraintTop_toBottomOf="@+id/share_title_container"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/share_panel"
            android:background="@color/larus_base_3"
            android:paddingTop="?attr/larus_dp_8"
            android:paddingBottom="?attr/larus_dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
