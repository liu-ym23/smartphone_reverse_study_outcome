<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/cj_pay_password_root_view"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="580dp">
    <include
        android:id="@+id/cj_pay_titlebar_root_view"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/cj_pay_view_titlebar_noise_reduction_layout"/>
    <TextView
        android:textSize="12sp"
        android:textColor="?attr/cj_pay_text_tertiary"
        android:id="@+id/cj_pay_no_pwd_hint"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_titlebar_root_view"/>
    <include
        android:id="@+id/cj_pay_view_verify_amount_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_no_pwd_hint"
        layout="@layout/cj_pay_view_verify_amount_layout"/>
    <include
        android:id="@+id/cj_pay_view_verify_discount_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_view_verify_amount_layout"
        layout="@layout/cj_pay_view_verify_discount_layout"/>
    <include
        android:id="@+id/cj_pay_view_pwd_verify_error_tips_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_view_verify_amount_layout"
        layout="@layout/cj_pay_view_verify_error_tips_layout"/>
    <include
        android:id="@+id/cj_pay_view_verify_combine_info_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_view_verify_discount_layout"
        layout="@layout/cj_pay_view_verify_combine_info_layout"/>
    <com.android.ttcjpaysdk.base.ui.component.input.PwdEditTextNoiseReduction
        android:id="@+id/cj_pay_pwd_view"
        android:background="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="20dp"
        app:CJPayDotRadius="6dp"
        app:CJPayPwdCount="6"
        app:CJPayPwdEditShapeStyle="CJPayRoundRectangle"
        app:CJPayStrokeColor="@color/cj_pay_color_white_F1F1F2"
        app:CJPayStrokeRadius="4dp"
        app:CJPayStrokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_view_verify_combine_info_layout"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?attr/cj_pay_text_secondary"
        android:id="@+id/cj_pay_forget_password_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginRight="16dp"
        android:text="@string/cj_pay_forget_password"
        app:layout="@+id/cj_pay_pwd_view"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/cj_pay_pre_no_pwd_guide_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/cj_pay_keyboard_view"
        layout="@layout/cj_pay_view_pre_no_pwd_guide_layout"/>
    <com.android.ttcjpaysdk.base.ui.widget.TalkbackKeyboardNoiseReductionView
        android:id="@+id/cj_pay_keyboard_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:keepScreenOn="true"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp"
        layout="@layout/cj_pay_view_half_screen_loading_layout"/>
    <include
        android:id="@+id/cj_pay_security_panel_loading_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_view_verify_discount_layout"
        layout="@layout/cj_pay_view_security_panel_loading_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
