<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larus.common_ui.widget.GradientTextView
        android:textSize="?attr/larus_dp_12"
        android:textColor="@color/larus_static_black"
        android:layout_gravity="center"
        android:id="@+id/tips"
        android:paddingTop="20dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_db_feed_recommend_tip_cn"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:background="?attr/larus_bg_gradient_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"/>
</merge>
