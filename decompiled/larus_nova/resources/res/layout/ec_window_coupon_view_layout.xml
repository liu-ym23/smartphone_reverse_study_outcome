<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/coupon_stroke"
    android:background="@drawable/ecommerce_coupon_item_border"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <TextView
        android:textSize="10dp"
        android:textColor="@color/Primary"
        android:gravity="center"
        android:id="@+id/coupon_prefix"
        android:background="@drawable/ecommerce_coupon_item_left"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/coupon_divider"
        android:layout_width="0.5dp"
        android:layout_height="match_parent"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:src="@drawable/ecommerce_coupon_divider"
        android:scaleType="fitXY"
        app:layout_constraintRight_toRightOf="@+id/coupon_prefix"/>
    <com.bytedance.android.ec.window.base.view.ECWindowVerticalDashLine
        android:id="@+id/coupon_divider_new"
        android:visibility="gone"
        android:layout_width="0.5dp"
        android:layout_height="match_parent"
        app:layout_constraintLeft_toRightOf="@+id/coupon_prefix"/>
    <ImageView
        android:id="@+id/coupon_arrow"
        android:visibility="gone"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:src="@drawable/ec_shop_coupon_arrow"
        android:scaleType="fitXY"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="-2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/coupon_divider"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/Primary"
        android:gravity="center"
        android:id="@+id/coupon_tag"
        android:background="@drawable/ecommerce_coupon_item_right"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/coupon_arrow"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
