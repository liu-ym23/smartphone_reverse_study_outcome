<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/larus_bg_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/sheet_line"
        android:background="?attr/larus_bg_bottom_sheet_line"
        android:layout_width="?attr/larus_dp_40"
        android:layout_height="?attr/larus_dp_4"
        android:layout_marginTop="?attr/larus_dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/selector_container"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="?attr/larus_dp_20"
        android:layout_marginStart="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toTopOf="@+id/bottom_area"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sheet_line"
        app:layout_constraintVertical_bias="0">
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="vertical"
            android:id="@+id/feature_selector"
            android:paddingBottom="?attr/larus_dp_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadeScrollbars="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    </androidx.core.widget.NestedScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_area"
        android:background="?attr/larus_base_3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:elevation="?attr/larus_dp_5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.larus.common_ui.widget.roundlayout.RoundTextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/btn_submit"
            android:layout_width="?attr/larus_dp_0"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginTop="?attr/larus_dp_8"
            android:layout_marginBottom="?attr/larus_dp_43"
            android:text="@string/larus_image_gen_done_btn"
            android:layout_marginStart="?attr/larus_dp_16"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:rv_backgroundColor="?attr/larus_primary_50"
            app:rv_cornerRadius="?attr/larus_dp_16"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
