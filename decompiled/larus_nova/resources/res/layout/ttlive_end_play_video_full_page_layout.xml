<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/landscape_player_bg"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.livesdk.chatroom.backtrack.LiveVideoPreviewView
        android:layout_gravity="center"
        android:id="@+id/end_video_player_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="71dp"
        android:layout_marginRight="71dp"/>
    <ImageView
        android:id="@+id/end_play_back"
        android:background="@drawable/ttlive_full_play_video_back_btn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"/>
</FrameLayout>
