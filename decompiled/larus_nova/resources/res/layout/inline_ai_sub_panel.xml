<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/mask_full_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/mask_around_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/space_above_panel"/>
    <androidx.legacy.widget.Space
        android:id="@+id/space_above_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="64dp"
        app:layout_constraintBottom_toTopOf="@+id/panel_view"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.ss.android.lark.inline.ai.ui.NSPConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/panel_view"
        android:background="@drawable/inline_ai_section_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <FrameLayout
            android:id="@+id/drag_view_wrapper"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            app:layout_constraintBottom_toTopOf="@+id/prompts_rv"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:layout_gravity="center_horizontal"
                android:id="@+id/drag_view"
                android:background="@drawable/inline_ai_drag_bar_background"
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"/>
        </FrameLayout>
        <com.ss.android.lark.inline.ai.ui.prompts.PromptsRecyclerView
            android:id="@+id/prompts_rv"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/drag_view_wrapper"/>
        <View
            android:id="@+id/prompts_block_view"
            android:background="@color/transparent"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/prompts_rv"/>
    </com.ss.android.lark.inline.ai.ui.NSPConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
