<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/video_pager_rlv"
        android:background="@color/ttlive_core_hs_w1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/ttlive_video_comment_list_loading_container"
        android:background="#ffffff"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
            android:layout_gravity="center"
            android:id="@+id/ttlive_video_comment_list_loading_animation_view"
            android:layout_width="36dp"
            android:layout_height="36dp"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ttlive_video_comment_list_reloading_btn_container"
        android:background="#ffffff"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:background="@drawable/ttlive_bg_live_loading_error"
            android:layout_width="120dp"
            android:layout_height="80dp"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_video_comment_panel_error_network"/>
        <Button
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:gravity="center"
            android:id="@+id/ttlive_video_comment_list_reloading_btn"
            android:background="@drawable/ttlive_button_gray_bg"
            android:layout_width="200dp"
            android:layout_height="38dp"
            android:layout_marginTop="24dp"
            android:text="@string/ttlive_video_comment_panel_reloading_btn_title"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ttlive_video_comment_list_empty_container"
        android:background="#ffffff"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="30dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ttlive_video_comment_list_empty_image"
            android:layout_width="180dp"
            android:layout_height="120dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#80161823"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/ttlive_video_comment_panel_list_empty"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
