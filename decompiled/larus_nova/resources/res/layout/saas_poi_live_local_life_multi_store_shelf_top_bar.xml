<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/live_shelf_top_bar"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:id="@+id/title"
            android:paddingTop="11dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/live_local_life_shelf_bar_title"
            android:maxLines="1"
            android:fontFamily="PingFangSC"
            android:layout_marginStart="16dp"/>
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:id="@+id/blank"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/consult_layout"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp">
            <ImageView
                android:id="@+id/consult_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/live_local_life_shelf_bar_consult"/>
            <com.bytedance.ies.dmt.ui.widget.DmtTextView
                android:textSize="11dp"
                android:textColor="#bf161823"
                android:ellipsize="end"
                android:id="@+id/consult_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/live_local_life_shelf_bar_consult"
                android:maxLines="1"
                android:fontFamily="PingFangSC"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/order_layout"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="16dp">
            <ImageView
                android:id="@+id/order_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/live_local_life_shelf_bar_order"/>
            <com.bytedance.ies.dmt.ui.widget.DmtTextView
                android:textSize="11dp"
                android:textColor="#bf161823"
                android:ellipsize="end"
                android:id="@+id/order_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/live_local_life_shelf_bar_order"
                android:maxLines="1"
                android:fontFamily="PingFangSC"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/vip_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="16dp">
            <ImageView
                android:id="@+id/vip_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/live_local_life_shelf_bar_vip"/>
            <com.bytedance.ies.dmt.ui.widget.DmtTextView
                android:textSize="11dp"
                android:textColor="#bf161823"
                android:ellipsize="end"
                android:id="@+id/vip_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/live_local_life_shelf_bar_vip"
                android:maxLines="1"
                android:fontFamily="PingFangSC"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
