<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/subscribe_not_member"
        android:background="@drawable/ttlive_subscribe_not_member_bg"
        android:visibility="gone"
        android:layout_width="604dp"
        android:layout_height="70dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="5dp"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/subscribe_emoji_not_member_color"
            android:ellipsize="end"
            android:id="@+id/subscribe_not_member_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="23dp"
            android:layout_marginTop="21dp"
            android:layout_marginRight="4dp"
            android:text="@string/ttlive_subscribe_not_member_tv"
            android:maxLines="1"
            android:layout_toLeftOf="@+id/subscribe_not_member_btn"
            android:layout_alignParentLeft="true"
            android:layout_marginStart="23dp"
            android:layout_marginEnd="4dp"
            android:layout_alignParentStart="true"/>
        <Button
            android:textSize="12dp"
            android:textColor="@color/white"
            android:id="@+id/subscribe_not_member_btn"
            android:background="@drawable/ttlive_bg_subscribe_not_member_btn"
            android:layout_width="64dp"
            android:layout_height="24dp"
            android:layout_marginTop="18dp"
            android:layout_marginRight="23dp"
            android:text="@string/ttlive_subscribe_not_member_btn_tv"
            android:layout_marginEnd="23dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/subscribe_emoji_list"
        android:paddingBottom="52dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="-5dp"
        android:layout_marginRight="16dp"
        android:layout_below="@+id/subscribe_not_member"
        android:layout_alignWithParentIfMissing="true"
        android:overScrollMode="never"/>
</RelativeLayout>
