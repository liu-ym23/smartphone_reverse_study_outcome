<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_link_result_dialog"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="34dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:id="@+id/tv_title_link_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/ttlive_link_result_dialog_user_leave"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#80161823"
        android:id="@+id/tv_feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/ttlive_link_result_dialog_feedback"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#80161823"
        android:id="@+id/tv_tips_link_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="66dp"
        android:text="@string/ttlive_link_result_dialog_normal_tips"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_link_result_container"
        android:background="@drawable/ttlive_bg_link_result_container"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_tips_link_result">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#161823"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_fan_ticket_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_link_result_dialog_value_zero"
                android:maxLines="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#80161823"
                android:gravity="center"
                android:id="@+id/tv_fan_ticket_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_link_result_dialog_label_fan_ticket"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#161823"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_add_follower_count_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_link_result_dialog_value_zero"
                android:maxLines="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#80161823"
                android:gravity="center"
                android:id="@+id/tv_follower_count_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_link_result_dialog_label_add_follower_count"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#161823"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_link_duration_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_link_result_dialog_value_zero"
                android:maxLines="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#80161823"
                android:gravity="center"
                android:id="@+id/tv_link_duration_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_link_result_dialog_label_link_duration_in_minute"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/view_divider"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        app:layout_constraintTop_toBottomOf="@+id/ll_link_result_container"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#80161823"
        android:id="@+id/tv_tips_banner_link_result"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_link_result_dialog_label_banner"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_divider"/>
    <FrameLayout
        android:id="@+id/fl_banner_lynx_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_tips_banner_link_result"/>
</androidx.constraintlayout.widget.ConstraintLayout>
