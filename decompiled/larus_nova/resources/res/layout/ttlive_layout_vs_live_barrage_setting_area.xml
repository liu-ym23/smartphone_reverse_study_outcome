<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="34dp"
    android:layout_width="match_parent"
    android:layout_height="93dp"
    android:paddingStart="34dp">
    <TextView
        android:textSize="11dp"
        android:textColor="#80ffffff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ttlive_barrage_setting_area"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/live_area_radiobutton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <RadioButton
            android:textSize="11dp"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:id="@+id/live_barrage_setting_close"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:button="@null"
            android:text="@string/ttlive_barrage_setting_close"
            android:drawableTop="@drawable/ttlive_selector_barrage_close_toggle_new"
            android:drawablePadding="2dp"/>
        <RadioButton
            android:textSize="11dp"
            android:textColor="@drawable/ttlive_selector_barrage_font"
            android:gravity="center_horizontal"
            android:id="@+id/live_barrage_setting_top"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="54dp"
            android:button="@null"
            android:text="@string/ttlive_barrage_setting_top"
            android:drawableTop="@drawable/ttlive_selector_barrage_top_toggle_new"
            android:drawablePadding="2dp"/>
        <RadioButton
            android:textSize="11dp"
            android:textColor="@drawable/ttlive_selector_barrage_font"
            android:gravity="center_horizontal"
            android:id="@+id/live_barrage_setting_half"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="54dp"
            android:button="@null"
            android:text="@string/ttlive_barrage_setting_half"
            android:drawableTop="@drawable/ttlive_selector_barrage_half_toggle_new"
            android:drawablePadding="2dp"/>
        <RadioButton
            android:textSize="11dp"
            android:textColor="@drawable/ttlive_selector_barrage_font"
            android:gravity="center_horizontal"
            android:id="@+id/live_barrage_setting_full"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="54dp"
            android:button="@null"
            android:text="@string/ttlive_barrage_setting_full"
            android:drawableTop="@drawable/ttlive_selector_barrage_fullscreen_toggle_new"
            android:drawablePadding="2dp"/>
    </RadioGroup>
</androidx.constraintlayout.widget.ConstraintLayout>
