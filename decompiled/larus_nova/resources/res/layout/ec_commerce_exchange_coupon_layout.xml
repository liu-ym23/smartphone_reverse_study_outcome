<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/exchange_coupon_container"
    android:background="#fff4f7"
    android:layout_width="match_parent"
    android:layout_height="32dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">
    <com.facebook.drawee.view.SimpleDraweeView
        android:layout_gravity="center_vertical"
        android:id="@+id/coupon_icon"
        android:layout_width="wrap_content"
        android:layout_height="12dp"/>
    <View
        android:layout_gravity="center_vertical"
        android:id="@+id/division_first"
        android:background="@drawable/ec_commerce_exchange_coupon_division_first"
        android:layout_width="1dp"
        android:layout_height="12dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="12dp"
            android:textColor="#333333"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/coupon_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/coupon_desc_price"
            app:layout_constraintWidth_default="wrap"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#fe2c55"
            android:layout_gravity="center_vertical"
            android:id="@+id/coupon_desc_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="2dp"
            app:layout_constraintLeft_toRightOf="@+id/coupon_desc"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="11dp"
        android:textColor="#fe2c55"
        android:layout_gravity="center_vertical"
        android:id="@+id/coupon_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_marginStart="20dp"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="10dp"
        android:src="@drawable/ec_commerce_exchange_coupon_tip_arrow"
        android:layout_marginStart="4dp"/>
</LinearLayout>
