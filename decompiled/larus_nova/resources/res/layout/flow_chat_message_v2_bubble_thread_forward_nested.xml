<?xml version="1.0" encoding="utf-8"?>
<com.ss.android.lark.chat.chatwindow.chat.message.cellv2.layout.slot.StackSlot xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/bubble_layout_body_slot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/inner_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.ss.android.lark.chat.chatwindow.chat.message.cellv2.layout.slot.StackSlot
            android:gravity="start"
            android:orientation="vertical"
            android:id="@+id/bubble_layout_content_slot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bubble_layout_inner_exposure_slot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bubble_layout_content_slot"/>
        <View
            android:id="@+id/thread_forward_mask"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.ss.android.lark.chat.chatwindow.chat.message.cellv2.layout.slot.StackSlot>
