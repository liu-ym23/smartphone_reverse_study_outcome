<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/camera_anchor_week_container"
    android:background="@drawable/aos_camera_anchor_week_bg"
    android:layout_width="wrap_content"
    android:layout_height="28dp"
    android:layout_marginTop="16dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp">
    <com.bytedance.awemeopen.infra.base.image.AoImageView
        android:id="@+id/iv_camera_week"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#242424"
        android:ellipsize="end"
        android:id="@+id/tv_camera_week_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="相关机位"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_camera_week"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_camera_anchor_divider"
        android:background="#1a242424"
        android:layout_width="1dp"
        android:layout_height="10dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_camera_week_name"
        app:layout_constraintStart_toEndOf="@+id/tv_camera_week_title"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#242424"
        android:ellipsize="end"
        android:id="@+id/tv_camera_week_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="香港尖沙咀"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_camera_anchor_arrow"
        app:layout_constraintStart_toEndOf="@+id/view_camera_anchor_divider"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.awemeopen.infra.base.image.AoImageView
        android:id="@+id/iv_camera_anchor_arrow"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/icon_camera_anchor_week_arrow"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_camera_week_name"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
