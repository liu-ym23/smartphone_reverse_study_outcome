<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@drawable/shape_bg_ffffff_corner_8"
    android:layout_width="288dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/gamecp_download_pause_mobile_data_tips_dialog_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/tv_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/gamecp_download_pause_mobile_data_tips_dialog_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/download_manage_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_content">
        <TextView
            android:textSize="14sp"
            android:textColor="#04498d"
            android:gravity="top"
            android:id="@+id/tv_download_manage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gamecp_download_pause_download_manage"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_arrow"
            android:layout_width="12sp"
            android:layout_height="12sp"
            android:layout_marginTop="0.5sp"
            android:src="@drawable/gamecp_download_pause_manage_arrow"/>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:background="#24161823"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/download_manage_container"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#bf161823"
        android:gravity="center"
        android:id="@+id/tv_btn_left"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="@string/gamecp_download_pause_mobile_data_tips_dialog_left"
        app:layout_constraintEnd_toStartOf="@+id/divider_btn"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
    <View
        android:id="@+id/divider_btn"
        android:background="#24161823"
        android:layout_width="0.5dp"
        android:layout_height="48dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_btn_right"
        app:layout_constraintStart_toEndOf="@+id/tv_btn_left"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/tv_btn_right"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="@string/gamecp_download_pause_mobile_data_tips_dialog_right"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/divider_btn"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
</androidx.constraintlayout.widget.ConstraintLayout>
