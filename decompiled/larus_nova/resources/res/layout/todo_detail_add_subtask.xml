<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="@dimen/dp_6"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/subtasks_load_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_7"
        android:layout_marginBottom="@dimen/dp_7"
        android:minHeight="24dp"
        android:layout_marginStart="@dimen/dp_70">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/subtasks_in_loading_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/subtasks_in_loading_icon"
                android:layout_width="24sp"
                android:layout_height="24sp"
                android:src="@drawable/todo_svg_icon_loading"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:textColor="@color/text_link_hover"
                android:id="@+id/subtasks_in_loading_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Lark_Legacy_LoadingTip"/>
        </LinearLayout>
        <TextView
            android:textColor="@color/text_link_hover"
            android:layout_gravity="center_vertical"
            android:id="@+id/subtask_show_more_tv"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Todo_MultipleSubTasks_ShowMore_Button"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/subtasks_loading_failed_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/text_caption"
                android:id="@+id/subtask_load_fail_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Lark_Legacy_LoadingFailed"
                android:paddingEnd="@dimen/dp_8"/>
            <TextView
                android:textColor="@color/text_link_hover"
                android:id="@+id/subtask_retry_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Todo_Label_LabelLoadingFailedRetry"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/subtask_add_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/add_subtask_container"
            android:visibility="gone"
            android:layout_width="369dp"
            android:layout_height="match_parent"
            android:paddingStart="16sp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="16sp"
                android:layout_height="wrap_content"
                android:tint="@color/icon_n3"
                android:layout_marginStart="28dp"
                app:srcCompat="@drawable/ud_icon_add_outlined"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/text_placeholder"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Todo_AddASubTask_Placeholder"/>
        </LinearLayout>
        <include
            android:id="@+id/edit_subtask_container"
            android:visibility="gone"
            layout="@layout/todo_detail_subtask"/>
    </FrameLayout>
</LinearLayout>
