<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#121212"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15sp"
        android:textColor="@color/white"
        android:id="@+id/tv_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/ttlive_interact_beauty_preview_tips"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/preview_container"
        android:background="#e6161823"
        android:visibility="gone"
        android:layout_width="275dp"
        android:layout_height="275dp"
        android:layout_marginTop="23dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_tips">
        <TextView
            android:textSize="15dp"
            android:textColor="#57ffffff"
            android:gravity="center"
            android:id="@+id/open_camera_hint"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="70dp"
            android:text="@string/ttlive_interact_beauty_preview_open_camera_hint"/>
        <Button
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:layout_gravity="center"
            android:id="@+id/open_camera_btn"
            android:background="#1affffff"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="49dp"
            android:layout_marginTop="20dp"
            android:text="@string/ttlive_interact_beauty_preview_open_camera"
            android:drawableLeft="@drawable/ttlive_interact_permission_open_camera_icon"
            android:drawablePadding="10dp"
            android:drawableStart="@drawable/ttlive_interact_permission_open_camera_icon"
            android:paddingStart="50dp"
            android:paddingEnd="50dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/beautify_content_layout"
        android:layout_width="0dp"
        android:layout_height="259dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/preview_container"/>
    <ImageView
        android:orientation="vertical"
        android:id="@+id/switch_camera_btn"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/ttlive_icon_preview_switch_camera"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/preview_container"
        app:layout_constraintEnd_toEndOf="@+id/preview_container"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#e6ffffff"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:background="@drawable/ttlive_bg_interact_beauty_preview_cancel"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="34dp"
        android:text="@string/ttlive_interact_beauty_preview_cancel"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tv_confirm"
        app:layout_constraintTop_toBottomOf="@+id/beautify_content_layout"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/tv_confirm"
        android:background="@drawable/ttlive_interact_bg_anchor_link_invite_available"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="34dp"
        android:text="@string/ttlive_interact_beauty_start_video_talk"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/tv_cancel"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/beautify_content_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
