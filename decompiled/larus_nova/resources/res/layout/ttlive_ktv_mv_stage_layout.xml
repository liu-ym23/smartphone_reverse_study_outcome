<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ktv_mv_stage_container"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/ktv_mv_mask_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/ktv_mv_challenge_widget"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/lyric_container"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/ktv_mv_control_area_container"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <FrameLayout
        android:id="@+id/ktv_mv_control_area_container"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <com.bytedance.android.livesdk.ktvimpl.ktvroom.view.midi.KtvMvMidiMicLabelAnim
        android:id="@+id/ktv_midi_label_anim"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginBottom="9dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/ktv_mv_control_area_container"
        app:layout_constraintLeft_toLeftOf="@+id/ktv_mv_control_area_container"/>
    <FrameLayout
        android:id="@+id/ktv_mv_midi_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ViewStub
        android:id="@+id/ktv_song_end_feed_back_view"
        android:visibility="gone"
        android:layout="@layout/ttlive_ktv_sing_end_feedback_layout"
        android:layout_width="246dp"
        android:layout_height="134dp"
        android:layout_marginTop="32dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
