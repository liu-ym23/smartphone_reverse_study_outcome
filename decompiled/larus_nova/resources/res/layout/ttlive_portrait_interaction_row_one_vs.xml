<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="52dp">
    <ImageView
        android:id="@+id/close_in_top_container"
        android:layout_width="36sp"
        android:layout_height="36sp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="4dp"
        android:src="@drawable/ttlive_close_in_top_container_shadow"
        android:layout_alignParentRight="true"
        android:contentDescription="@string/ttlive_a11y_close"
        android:layout_marginEnd="4dp"
        android:layout_alignParentEnd="true"/>
    <FrameLayout
        android:id="@+id/top_right_widget_container"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="4dp"
        android:layout_toLeftOf="@+id/close_in_top_container"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        android:layout_toStartOf="@+id/close_in_top_container"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/title_container"
        android:paddingLeft="12dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_toLeftOf="@+id/top_right_widget_container"
        android:layout_alignParentLeft="true"
        android:paddingStart="12dp"
        android:layout_toStartOf="@+id/top_right_widget_container"
        android:layout_alignParentStart="true">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_status"
            android:background="@drawable/ttlive_vs_status_premiere_bg"
            android:visibility="gone"
            android:layout_width="39dp"
            android:layout_height="22dp"
            android:text="@string/live_room_vs_title_live"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/iv_prefix_img"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginBottom="5.5dp"
            android:scaleType="fitXY"
            app:actualImageScaleType="fitXY"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_white"
            android:ellipsize="end"
            android:id="@+id/tv_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:shadowColor="#66000000"
            android:shadowRadius="2"/>
        <com.bytedance.android.live.core.view.EllipsizedScrollTextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_white"
            android:id="@+id/tv_title"
            android:fadingEdgeLength="18dp"
            android:clipChildren="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:shadowColor="#66000000"
            android:shadowRadius="2"
            android:requiresFadingEdge="horizontal"/>
        <com.bytedance.android.livesdk.common.MatchMarqueeTextView
            android:layout_gravity="center_vertical"
            android:id="@+id/marquee_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"/>
        <View
            android:id="@+id/title_icon"
            android:background="@drawable/ttlive_media_title_icon"
            android:visibility="gone"
            android:layout_width="9dp"
            android:layout_height="5dp"
            android:layout_marginLeft="-9dp"
            app:layout_constraintBottom_toBottomOf="@+id/sv_media_title"
            app:layout_constraintLeft_toRightOf="@+id/sv_media_title"
            app:layout_constraintTop_toTopOf="@+id/sv_media_title"/>
    </LinearLayout>
</RelativeLayout>
