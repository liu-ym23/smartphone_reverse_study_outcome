<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="19dp">
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_new_profile_black"
        android:layout_gravity="bottom"
        android:id="@+id/profile_gift_exhibition_light"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        android:includeFontPadding="false"/>
    <TextView
        android:textSize="13dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_new_profile_black"
        android:gravity="end"
        android:layout_gravity="bottom"
        android:id="@+id/profile_gift_exhibition_line"
        android:layout_width="6dp"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_new_profile_gift_exhibition_slash"
        android:maxLines="1"
        android:singleLine="true"
        android:includeFontPadding="false"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_new_profile_black"
        android:layout_gravity="bottom"
        android:id="@+id/profile_gift_exhibition_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        android:includeFontPadding="false"/>
    <ImageView
        android:layout_gravity="bottom"
        android:id="@+id/profile_gift_exhibition_found_all_icon"
        android:visibility="invisible"
        android:layout_width="33dp"
        android:layout_height="14dp"
        android:layout_marginBottom="1dp"
        android:src="@drawable/ttlive_ic_new_profile_gift_found_all"
        android:layout_marginStart="3dp"/>
</LinearLayout>
