<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/audio_live_container"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.lighten.loader.SmartImageView
        android:id="@+id/audio_live_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@drawable/ttlive_bg_audio_live_default_bg"
        app:placeholderImage="@drawable/ttlive_bg_audio_live_default_bg"/>
    <com.bytedance.lighten.loader.SmartImageView
        android:id="@+id/audio_live_anim_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/audio_live_group"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/audio_live_anim"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="108dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/audio_live_avatar"
            android:layout_width="136dp"
            android:layout_height="136dp"
            app:failureImage="@drawable/ttlive_bg_audio_default_avatar"
            app:layout_constraintBottom_toBottomOf="@+id/audio_live_anim"
            app:layout_constraintEnd_toEndOf="@+id/audio_live_anim"
            app:layout_constraintStart_toStartOf="@+id/audio_live_anim"
            app:layout_constraintTop_toTopOf="@+id/audio_live_anim"
            app:placeholderImage="@drawable/ttlive_bg_audio_default_avatar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/linkmic_live_group"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/linkmic_live_anim"
            android:visibility="gone"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginTop="102dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.lighten.loader.SmartCircleImageView
            android:id="@+id/linkmic_live_avatar"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="117dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:id="@+id/linkmic_live_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxEms="10"
            android:singleLine="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linkmic_live_avatar"/>
        <com.bytedance.android.livesdk.chatroom.ui.NoTouchRecyclerView
            android:id="@+id/linkmic_live_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linkmic_live_avatar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
