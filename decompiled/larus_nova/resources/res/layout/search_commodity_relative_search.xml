<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/BGCard"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.lighten.loader.SmartImageView
        android:id="@+id/bg_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <com.bytedance.lighten.loader.SmartImageView
        android:layout_gravity="top|right"
        android:id="@+id/bg_magnifier_cover"
        android:layout_width="44dp"
        android:layout_height="40dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/relative_search_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:textSize="13sp"
            android:textColor="@color/TextTertiary"
            android:id="@+id/title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:text="@string/search_related_searches"
            android:includeFontPadding="false"
            app:fontType="regular"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/new_rs_words_layout"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp">
            <com.bytedance.ies.dmt.ui.widget.DmtTextView
                android:textSize="13dp"
                android:textColor="@color/TextTertiary"
                android:id="@+id/pre_rs_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:fontType="medium"/>
            <com.bytedance.ies.dmt.ui.widget.DmtTextView
                android:textSize="13dp"
                android:textStyle="bold"
                android:textColor="#ff3b52"
                android:id="@+id/rs_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:fontType="medium"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/rights_container"
            android:background="@drawable/search_bg_rs_rights"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="-4dp"
            android:layout_marginBottom="12dp">
            <com.bytedance.lighten.loader.SmartImageView
                android:id="@+id/rights_cover"
                android:layout_width="18dp"
                android:layout_height="16dp"
                app:actualImageScaleType="focusCrop"/>
            <com.bytedance.ies.dmt.ui.widget.DmtTextView
                android:textSize="11dp"
                android:textColor="#ff3b52"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/rights_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:maxLines="1"
                android:lineSpacingExtra="2sp"
                android:layout_marginStart="3dp"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="vertical"
            android:id="@+id/wordsContainer"
            android:paddingBottom="12dp"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</FrameLayout>
