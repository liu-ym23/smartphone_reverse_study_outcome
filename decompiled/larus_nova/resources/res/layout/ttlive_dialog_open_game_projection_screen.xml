<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_open_game_panel"
    android:layout_width="match_parent"
    android:layout_height="484dp"
    android:paddingStart="@dimen/ttlive_open_platform_dialog_content_padding"
    android:paddingEnd="@dimen/ttlive_open_platform_dialog_content_padding">
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/ttlive_open_platform_single_screencast_dialog_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/image_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_title">
        <com.bytedance.android.livesdk.chatroom.ui.LiveRoundDraweeImageView
            android:id="@+id/anchor_perspective_img"
            android:layout_width="167dp"
            android:layout_height="260dp"
            android:scaleType="centerCrop"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            app:ttlive_radius="4dp"/>
        <com.bytedance.android.livesdk.chatroom.ui.LiveRoundDraweeImageView
            android:id="@+id/audience_perspective_img"
            android:layout_width="167dp"
            android:layout_height="260dp"
            android:scaleType="centerCrop"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            app:ttlive_radius="4dp"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/ttlive_white_75"
        android:id="@+id/projection_screen_introduction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ttlive_open_platform_single_screencast_dialog_intro"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image_list"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/cast_screen"
        android:background="@drawable/ttlive_bg_game_dialog_red_corner_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="31dp"
        android:text="@string/ttlive_open_platform_single_screencast_dialog_start1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/projection_screen_introduction"/>
</androidx.constraintlayout.widget.ConstraintLayout>
