<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_16"
        android:textColor="@color/ud_N900"
        android:gravity="center"
        android:id="@+id/tv_no_result"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/Lark_ASLSearch_WeakNetworkNotice_InternetErrorNoResults_TitlePC"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.35"
        app:layout_constraintWidth_max="268dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_14"
        android:textColor="@color/ud_N600"
        android:gravity="center"
        android:id="@+id/tv_check_error"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:text="@string/Lark_ASLSearch_WeakNetworkNotice_NoInternetCheckSettings_NoticeMobile"
        app:layout_constraintBottom_toTopOf="@+id/tv_retry_click"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_no_result"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_max="268dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_16"
        android:textColor="@color/ud_N900"
        android:ellipsize="middle"
        android:gravity="center"
        android:id="@+id/tv_retry_click"
        android:background="@drawable/round_corner_border_bg"
        android:layout_width="96dp"
        android:layout_height="36dp"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/Lark_ASLSearch_WeakNetworkNotice_NoInternetCheckSettings_RetryMobile"
        android:singleLine="true"
        android:paddingStart="@dimen/dp_2"
        android:paddingEnd="@dimen/dp_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_check_error"
        app:layout_constraintVertical_bias="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
