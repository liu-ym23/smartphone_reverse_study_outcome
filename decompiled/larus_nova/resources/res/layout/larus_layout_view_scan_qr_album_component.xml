<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/my_qr_code"
        android:background="@drawable/larus_scan_ic_background"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginBottom="100dp"
        android:layout_marginStart="42dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/larus_ic_my_qr_code"/>
    </FrameLayout>
    <TextView
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/larus_IM_scan_cta_myQRCode"
        app:layout_constraintEnd_toEndOf="@+id/my_qr_code"
        app:layout_constraintStart_toStartOf="@+id/my_qr_code"
        app:layout_constraintTop_toBottomOf="@+id/my_qr_code"/>
    <FrameLayout
        android:id="@+id/scan_album"
        android:background="@drawable/larus_scan_ic_background"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginBottom="100dp"
        android:layout_marginEnd="42dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/larus_ic_scan_album"/>
    </FrameLayout>
    <TextView
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/larus_IM_scan_cta_album"
        app:layout_constraintEnd_toEndOf="@+id/scan_album"
        app:layout_constraintStart_toStartOf="@+id/scan_album"
        app:layout_constraintTop_toBottomOf="@+id/scan_album"/>
</androidx.constraintlayout.widget.ConstraintLayout>
