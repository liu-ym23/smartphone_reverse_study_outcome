<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/content_layout"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/view_fetch_loading"/>
    <include layout="@layout/view_fetch_result_empty"/>
    <com.ss.android.lark.widget.ptr.LKUIPtrClassicFrameLayout xmlns:ptr="http://schemas.android.com/apk/res-auto"
        android:id="@+id/ptr_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        ptr:lkui_ptr_duration_to_close_either="500"
        ptr:lkui_ptr_keep_header_when_refresh="true"
        ptr:lkui_ptr_mode="loadMore"
        ptr:lkui_ptr_pull_to_fresh="false"
        ptr:lkui_ptr_ratio_of_header_height_to_refresh="0.5"
        ptr:lkui_ptr_resistance="1.7">
        <com.ss.android.lark.widget.recyclerview.CommonRecyclerView
            android:id="@+id/file_info_list_rv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="0dp"/>
    </com.ss.android.lark.widget.ptr.LKUIPtrClassicFrameLayout>
</FrameLayout>
