<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/ivClose"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/ttlive_bg_white_radius8"
        android:paddingBottom="44dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <ImageView
            android:id="@+id/close_btn"
            android:visibility="gone"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/ttlive_one_key_auth_dialog_close_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/avatar"
            android:layout_width="60dp"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:src="@drawable/ttlive_img_auth_avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bind_avatar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ttlive_float_icon"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toStartOf="@+id/bind_icon"/>
            <ImageView
                android:id="@+id/bind_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ttlive_auth_bind_avatar_icon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/host_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toEndOf="@+id/bind_icon"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="#161823"
            android:id="@+id/tvAuthTitle"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="108dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#57161823"
            android:id="@+id/tvAuthContent"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvAuthTitle"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/llProtoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            app:layout_constraintTop_toBottomOf="@+id/tvAuthContent">
            <CheckBox
                android:id="@+id/cbProtocol"
                android:background="@android:color/transparent"
                android:layout_width="16dp"
                android:layout_height="16dp"
                style="@style/ttlive_RedEnvelopeCheckboxStyle"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#80161823"
                android:gravity="start"
                android:id="@+id/tvProtocol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/ttlive_auth_protocol_content_description"
                android:layout_marginStart="4dp"
                app:layout_constraintStart_toEndOf="@+id/cbProtocol"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#80161823"
                android:gravity="center_vertical"
                android:id="@+id/auth_tip"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_new_auth_dialog_security_tip"
                android:drawableLeft="@drawable/ttlive_security_icon"
                android:drawablePadding="5.4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:id="@+id/btnConfirm"
            android:layout_width="match_parent"
            android:layout_marginTop="13dp"
            app:layout_constraintTop_toBottomOf="@+id/llProtoContainer"
            app:layout_goneMarginTop="36dp"
            style="@style/uicomponent_button_style_primary_l"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/ttlive_std_brand"
            android:id="@+id/btnDouyinAuth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ttlive_new_auth_login_by_dy"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnConfirm"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
