<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/push_notification_style_root_layout"
    android:background="@color/im_notification_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_centerVertical="true">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/im_notification_container"
        android:paddingLeft="15dp"
        android:paddingTop="5dp"
        android:paddingRight="15dp"
        android:paddingBottom="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/push_notification_header"
            android:paddingBottom="1dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/push_notification_header_icon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginLeft="3dp"
                android:src="@drawable/status_icon"
                android:scaleType="centerCrop"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/im_notification_content_color"
                android:ellipsize="end"
                android:id="@+id/push_notification_header_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:maxLines="1"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/push_notification_left_pic"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_centerVertical="true">
                <ImageView
                    android:id="@+id/push_notification_small_picture"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/status_icon"
                    android:scaleType="fitEnd"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="4"/>
                    <ImageView
                        android:layout_gravity="bottom"
                        android:id="@+id/push_notification_app_icon"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:src="@drawable/status_icon"
                        android:scaleType="fitEnd"
                        android:layout_weight="1"/>
                </LinearLayout>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/push_notification_left_pic"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/im_notification_title_color"
                    android:ellipsize="end"
                    android:id="@+id/push_notification_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
                <TextView
                    android:textColor="@color/im_notification_content_color"
                    android:ellipsize="end"
                    android:id="@+id/push_notification_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1.5dp"
                    android:maxLines="2"
                    android:lineSpacingMultiplier="1"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</FrameLayout>
