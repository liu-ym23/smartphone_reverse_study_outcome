<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_white_round_corner_rect"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/replay_dialog_image_block"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/replay_dialog_image"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="50dp"
        android:layout_marginRight="50dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"/>
    <View
        android:id="@+id/replay_dialog_top_block"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="24dp"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/replay_dialog_title"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        style="@style/ttlive_replay_dialog_title"/>
    <View
        android:id="@+id/replay_dialog_title_message_block"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:gravity="center"
        android:id="@+id/replay_dialog_message"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:includeFontPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        style="@style/ttlive_replay_dialog_message"/>
    <View
        android:id="@+id/replay_dialog_bottom_block"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="16dp"/>
    <FrameLayout
        android:id="@+id/replay_dialog_frame"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"/>
    <include
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        layout="@layout/ttlive_replay_dialog_common_horizontal_button_container"/>
</LinearLayout>
