<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.drawee.view.SimpleDraweeView
        android:layout_gravity="top"
        android:id="@+id/skeleton_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintDimensionRatio="0.58"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:layout_gravity="top"
        android:id="@+id/recharge_image_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintDimensionRatio="0.58"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:layout_gravity="top"
        android:id="@+id/continue_pay_image_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintDimensionRatio="0.58"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:layout_gravity="top"
        android:id="@+id/ultimate_skeleton_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        app:actualImageResource="@drawable/ultimate_buynow_loading_holder"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintDimensionRatio="0.58"/>
    <com.bytedance.android.shopping.buynow.widgets.BuyNowDoubleColorBallAnimationView
        android:id="@+id/loading_view_ball"
        android:visibility="visible"
        android:layout_width="28dp"
        android:layout_height="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_gravity="bottom"
        android:id="@+id/sku_skeleton_loading_moving_anime"
        android:visibility="gone"
        android:layout_width="120dp"
        android:layout_height="match_parent"
        android:src="@drawable/sku_buy_skeleton_anime"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"/>
</merge>
