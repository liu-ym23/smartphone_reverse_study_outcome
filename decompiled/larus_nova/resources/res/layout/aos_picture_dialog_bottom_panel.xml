<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/ll_panel_dialog_container"
    android:background="@drawable/aos_feed_bottom_panel_report_dislike_shape"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:background="@drawable/aos_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"/>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/ext_view_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_bottom_content"
        android:background="@drawable/aos_feed_bottom_panel_item_round_shape"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <RelativeLayout
            android:id="@+id/not_interesting_ll"
            android:background="@drawable/aos_feed_bottom_panel_item_round_shape"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingStart="16dp">
            <ImageView
                android:id="@+id/icon_dislike"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/aos_ic_s_s_heartbreak_outlined_20"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#161823"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="不感兴趣"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/icon_dislike"/>
            <View
                android:id="@+id/not_interesting_line"
                android:background="#19161823"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="32dp"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/collect_ll"
            android:background="@drawable/aos_feed_bottom_panel_item_round_shape"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingStart="16dp">
            <ImageView
                android:id="@+id/icon_collect"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/aos_ic_s_s_pentagram_outlined_30"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#161823"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我的收藏"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/icon_collect"/>
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/aos_ic_s_s_arrowforward_outlined_19"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:layout_alignParentEnd="true"/>
            <View
                android:id="@+id/collect_line"
                android:background="#19161823"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="32dp"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/report_ll_inner"
            android:background="@drawable/aos_feed_bottom_panel_item_round_shape"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <ImageView
                android:id="@+id/icon_report_inner"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/aos_ic_s_s_exclamationtriangle_red_outlined_30"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#fe2c55"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="举报"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/icon_report_inner"/>
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/aos_ic_s_s_arrowforward_outlined_19"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
