<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:background="@drawable/ttlive_pause_view_bg"
            android:layout_width="108dp"
            android:layout_height="65dp"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:background="@drawable/ttlive_pause_view_fg"
            android:layout_width="52dp"
            android:layout_height="46dp"
            android:layout_marginTop="13dp"/>
        <TextView
            android:textSize="11dp"
            android:textColor="#e5ffffff"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="68dp"
            android:text="@string/ttlive_multi_link_pause_tips"/>
        <TextView
            android:textSize="8dp"
            android:textColor="#7fffffff"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="85dp"
            android:layout_marginRight="4dp"
            android:layout_marginBottom="8dp"
            android:text="@string/ttlive_multi_link_pause_sub_tips"/>
    </FrameLayout>
</merge>
