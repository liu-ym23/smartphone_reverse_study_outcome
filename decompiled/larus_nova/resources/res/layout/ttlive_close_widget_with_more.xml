<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerConstraintLayout
        android:id="@+id/root"
        android:background="@color/ttlive_black_20"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ttlive_leftBottomRadius="20dp"
        app:ttlive_leftTopRadius="20dp"
        app:ttlive_rightBottomRadius="20dp"
        app:ttlive_rightTopRadius="20dp">
        <ImageView
            android:id="@+id/ivMoreToolbar"
            android:padding="4dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="4dp"
            android:src="@drawable/ttlive_more_toolbar_with_close"
            android:contentDescription="更多按钮"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/viewDivider"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/viewDivider"
            android:background="#1affffff"
            android:layout_width="0.5px"
            android:layout_height="8dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/ivMoreToolbar"
            app:layout_constraintRight_toLeftOf="@+id/close_in_top_container"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/close_in_top_container"
            android:padding="4dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="4dp"
            android:src="@drawable/ttlive_ic_top_right_close"
            android:contentDescription="@string/ttlive_a11y_close"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/viewDivider"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
