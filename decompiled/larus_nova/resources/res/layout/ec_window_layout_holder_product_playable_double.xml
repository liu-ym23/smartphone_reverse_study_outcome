<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ec.window.base.widget.ECWindowRoundedLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/store_product_card"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:rounded_radius="8dp">
    <com.bytedance.android.ui.base.widget.round.RoundConstraintLayout
        android:id="@+id/ec_window_product_video_hanging_video"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bg_cornerRadius="8dp">
        <ViewStub
            android:id="@+id/ec_window_viewstub_video_playable"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/ec_shop_tag_wrapper"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.bytedance.android.ui.base.widget.round.RoundConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/shopping_std_bg_primary_white"
        android:paddingLeft="6dp"
        android:paddingTop="8dp"
        android:paddingRight="6dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">
        <com.bytedance.android.ec.window.base.widget.WindowBreakWordTextView
            android:textSize="14dp"
            android:textColor="@color/shopping_std_text_black_1"
            android:ellipsize="end"
            android:id="@+id/store_product_card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ec_window_sub_text_color"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/store_product_card_recommend_info"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:includeFontPadding="false"/>
        <FrameLayout
            android:id="@+id/window_product_card_recommend_area"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/store_product_card_title"/>
        <LinearLayout
            android:gravity="bottom"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="12dp"
            android:layout_centerVertical="true">
            <com.bytedance.android.ec.core.widget.price.PriceView
                android:textSize="17dp"
                android:ellipsize="end"
                android:id="@+id/store_product_card_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:lineSpacingExtra="2dp"
                app:pv_hideYuanSymbol="false"
                app:pv_prefixMarginRight="4dp"
                app:pv_prefixTextBold="false"
                app:pv_prefixTextColor="@color/shopping_std_brand"
                app:pv_prefixTextSizeRatio="0.647"
                app:pv_priceBold="true"
                app:pv_priceTextColor="@color/shopping_std_brand"
                app:pv_yuanSymbolBold="false"
                app:pv_yuanSymbolMarginRight="1dp"
                app:pv_yuanSymbolRatioOfPriceTextSize="0.764"/>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/shopping_std_text_black_4"
                android:ellipsize="end"
                android:layout_gravity="start|bottom"
                android:id="@+id/store_product_card_sale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:baselineAlignBottom="true"
                android:maxLines="1"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/store_product_card_extra_info_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <com.bytedance.android.ec.window.base.product.widget.ECWindowTagFlowLayout
                android:id="@+id/store_product_card_tags_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:tag_maxline="1"
                app:tag_space_horizontal="4dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/store_product_card_source_wrapper"
        android:background="@color/shopping_std_bg_primary_white"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingBottom="4dp"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/store_product_card_store_logo"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="4dp"
                android:layout_marginEnd="4dp"
                app:roundAsCircle="true"
                app:roundedCornerRadius="8dp"
                app:roundingBorderColor="@color/ec_shop_1F161823"
                app:roundingBorderWidth="1dp"/>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/commerce_color_80161823"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/store_product_card_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/ec_window_product_bottom_dynamic_content_container"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</com.bytedance.android.ec.window.base.widget.ECWindowRoundedLinearLayout>
