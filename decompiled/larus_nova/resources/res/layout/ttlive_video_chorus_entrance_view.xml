<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_chorus_entrance_container"
    android:layout_width="28dp"
    android:layout_height="28dp">
    <ImageView
        android:id="@+id/video_chorus_entrance_iv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#ffffff"
        android:id="@+id/video_chorus_entrance_red_dot"
        android:background="@drawable/ttlive_real_time_chorus_red_dot_bg"
        android:visibility="gone"
        android:layout_width="6dp"
        android:layout_height="6dp"
        app:layout_constraintRight_toRightOf="@+id/video_chorus_entrance_iv"
        app:layout_constraintTop_toTopOf="@+id/video_chorus_entrance_iv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
