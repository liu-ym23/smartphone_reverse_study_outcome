<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_view_root"
    android:layout_width="match_parent"
    android:layout_height="@dimen/drive_progress_bar_height">
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/seek_bar_touch_area"
        android:layout_width="match_parent"
        android:layout_height="@dimen/drive_progress_bar_v2_content_height">
        <androidx.appcompat.widget.AppCompatSeekBar
            android:layout_gravity="bottom"
            android:id="@+id/seek_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/drive_progress_bar_v2_track_normal_height"
            android:layout_marginBottom="@dimen/drive_progress_bar_v2_track_normal_bottom_margin"
            android:progressDrawable="@drawable/drive_progressbar_v2_normal_video"
            android:thumb="@null"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:splitTrack="false"/>
        <FrameLayout
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/drive_progress_bar_v2_control_row_height"
            android:importantForAccessibility="no">
            <FrameLayout
                android:layout_gravity="start"
                android:id="@+id/start_pause_root"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/start"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:scaleType="fitStart"
                    app:srcCompat="@drawable/drive_progressbar_play_white"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/pause"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:scaleType="fitStart"
                    app:srcCompat="@drawable/drive_progressbar_pause_white"/>
            </FrameLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="start"
                android:orientation="horizontal"
                android:id="@+id/time_container"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="@dimen/drive_progress_bar_v2_time_normal_start_margin">
                <TextView
                    android:textSize="@dimen/drive_progress_bar_v2_time_normal_size"
                    android:textColor="@color/static_white"
                    android:id="@+id/current"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/drive_progress_bar_v2_time_normal_size"
                    android:textColor="@color/static_white"
                    android:id="@+id/length_split"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" / "/>
                <TextView
                    android:textSize="@dimen/drive_progress_bar_v2_time_normal_size"
                    android:textColor="@color/static_white"
                    android:id="@+id/length"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="end"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:paddingEnd="16dp">
                <TextView
                    android:textSize="@dimen/drive_progress_bar_v2_time_normal_size"
                    android:textStyle="bold"
                    android:textColor="@color/static_white"
                    android:gravity="center"
                    android:id="@+id/resolution_switch"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <com.bytedance.ee.bear.drive.view.widget.VolumeView
                    android:id="@+id/drive_video_player_volume_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/block_enter_full"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:tint="@color/static_white"
                    android:layout_marginStart="16dp"
                    app:srcCompat="@drawable/ud_icon_magnify_outlined"/>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
