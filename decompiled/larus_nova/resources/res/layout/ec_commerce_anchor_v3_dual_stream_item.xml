<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ec.core.widget.RoundedFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_commerce_anchor_v3_dual_stream_item_926477253"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:rounded_radius="8dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ec_commerce_anchor_v3_dual_stream_item_244079365"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/dual_stream_item_image"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/dual_stream_video_play_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/commerce_anchor_v3_dual_stream_video_icon"
            app:layout_constraintBottom_toBottomOf="@+id/dual_stream_item_image"
            app:layout_constraintLeft_toLeftOf="@+id/dual_stream_item_image"
            app:layout_constraintRight_toRightOf="@+id/dual_stream_item_image"
            app:layout_constraintTop_toTopOf="@+id/dual_stream_item_image"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/TextReverse"
            android:ellipsize="end"
            android:id="@+id/dual_stream_item_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="12dp"
            android:maxLines="2"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dual_stream_item_image"/>
        <com.bytedance.android.shopping.widget.legacy.AvatarImageView
            android:id="@+id/dual_stream_avatar"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="@null"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dual_stream_item_text"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/TextReverse3"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/dual_stream_user_name"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginLeft="4dp"
            android:maxLength="8"
            android:lineSpacingExtra="2dp"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/dual_stream_avatar"
            app:layout_constraintLeft_toRightOf="@+id/dual_stream_avatar"
            app:layout_constraintTop_toTopOf="@+id/dual_stream_avatar"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dual_stream_hot_area"
            android:layout_width="56dp"
            android:layout_height="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent">
            <TextView
                android:textSize="11sp"
                android:textColor="@color/TextReverse3"
                android:gravity="center_vertical"
                android:id="@+id/dual_stream_appreciate_text"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="11dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <ImageView
                android:id="@+id/dual_stream_appreciate"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginRight="5dp"
                android:layout_marginEnd="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/dual_stream_appreciate_text"
                app:layout_constraintRight_toLeftOf="@+id/dual_stream_appreciate_text"
                app:layout_constraintTop_toTopOf="@+id/dual_stream_appreciate_text"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.bytedance.android.ec.core.widget.RoundedFrameLayout>
