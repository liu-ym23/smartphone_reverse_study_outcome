<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_width="180dp"
        android:layout_height="120dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/ttlive_chat_channel_empty_contact"/>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/ttlive_white_90"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/ttlive_chat_channel_empty_title"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_white_50"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ttlive_chat_channel_empty_content"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/create_channel"
        android:background="@drawable/ttlive_chat_channel_create_channel_button_bg"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="35dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="35dp"
        android:text="@string/ttlive_room_channel_empty_create"/>
</LinearLayout>
