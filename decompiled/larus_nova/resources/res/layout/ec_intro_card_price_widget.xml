<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.bytedance.android.ec.core.widget.price.PriceView
        android:textSize="18dp"
        android:textColor="@color/white"
        android:id="@+id/pv_first_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_orderInHorizontal="0"
        app:layout_orderInVertical="1"
        app:pv_autoResize="true"
        app:pv_prefixMarginRight="2dp"
        app:pv_prefixTextSizeRatio="0.556"
        app:pv_priceDecimalTextSizeRatio="0.647"
        app:pv_priceTextColor="@color/white"
        app:pv_suffixTextSizeRatio="0.556"
        app:pv_yuanSymbolMarginRight="1dp"
        app:pv_yuanSymbolRatioOfPriceTextSize="0.667"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#b2ffffff"
        android:layout_gravity="bottom"
        android:id="@+id/tv_describe"
        android:paddingBottom="1dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:paddingStart="2dp"
        app:layout_orderInHorizontal="1"
        app:layout_orderInVertical="2"/>
    <com.bytedance.android.ec.core.widget.price.PriceView
        android:textSize="10dp"
        android:layout_gravity="bottom"
        android:id="@+id/pv_origin_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:layout_marginStart="2dp"
        app:layout_orderInHorizontal="2"
        app:layout_orderInVertical="3"
        app:pv_priceTextColor="#80ffffff"
        app:pv_showStrikeThrough="true"/>
    <com.bytedance.android.ec.core.widget.price.PriceView
        android:textSize="10dp"
        android:textColor="#b2ffffff"
        android:layout_gravity="bottom"
        android:id="@+id/pv_deposit_price_view"
        android:paddingBottom="1dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:paddingStart="2dp"
        app:layout_orderInHorizontal="3"
        app:layout_orderInVertical="0"
        app:pv_autoResize="true"
        app:pv_prefixMarginRight="2dp"
        app:pv_yuanSymbolMarginRight="1dp"/>
</merge>
