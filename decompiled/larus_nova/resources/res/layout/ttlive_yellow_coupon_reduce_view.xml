<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/image_view"
        android:layout_width="214dp"
        android:layout_height="120dp"/>
    <ImageView
        android:id="@+id/money_icon"
        android:background="@drawable/ttlive_coupon_money_icon"
        android:layout_width="10dp"
        android:layout_height="13dp"
        android:layout_marginLeft="64dp"
        android:layout_marginTop="50dp"
        android:layout_marginStart="64dp"/>
    <com.bytedance.android.livesdk.commerce.coupon.LiveAlignTextView
        android:id="@+id/coupon_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_toRightOf="@+id/money_icon"
        android:layout_alignBottom="@+id/money_icon"
        android:layout_marginStart="4dp"
        android:layout_toEndOf="@+id/money_icon"/>
    <TextView
        android:textSize="11dp"
        android:textStyle="bold"
        android:textColor="#7f6000"
        android:id="@+id/coupon_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="64dp"
        android:layout_marginTop="78dp"
        android:includeFontPadding="false"
        android:layout_marginStart="64dp"/>
</RelativeLayout>
