<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/ttlive_bg_ensure_kick_dialog"
        android:layout_width="270dp"
        android:layout_height="110dp">
        <TextView
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/hintContent"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="@string/ttlive_hint_kick_to_anchor"/>
        <View
            android:id="@+id/divider_horizontal"
            android:background="@color/ttlive_core_hs_s9"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="17dp"
                android:textColor="@color/ttlive_core_cancle_btn"
                android:gravity="center"
                android:id="@+id/tv_cancle"
                android:layout_width="0dp"
                android:layout_height="43.5dp"
                android:text="@string/ttlive_text_cancel"
                android:layout_weight="1"/>
            <View
                android:id="@+id/divider_vertical"
                android:background="@color/ttlive_core_hs_s9"
                android:layout_width="1dp"
                android:layout_height="43.5dp"/>
            <TextView
                android:textSize="17dp"
                android:textColor="@color/ttlive_core_ensure_btn"
                android:gravity="center"
                android:id="@+id/tv_kick_out"
                android:layout_width="0dp"
                android:layout_height="43.5dp"
                android:text="@string/ttlive_text_ensure"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
