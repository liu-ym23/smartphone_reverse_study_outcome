<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.ec.core.widget.RoundedFrameLayout
        android:background="@drawable/ec_window_explain_back_playable_single_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rounded_radius="8dp"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:ellipsize="end"
        android:id="@+id/ec_window_explain_back_main_title"
        android:paddingTop="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:maxLines="1"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#99161823"
        android:ellipsize="end"
        android:id="@+id/ec_window_explain_back_sub_title"
        android:paddingTop="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:maxLines="1"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ec_window_explain_back_main_title"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/ec_window_explain_back_jump"
        android:background="@drawable/ec_window_explain_back_playable_single_text_bg"
        android:layout_width="68dp"
        android:layout_height="24dp"
        android:layout_marginTop="19dp"
        android:layout_marginRight="12dp"
        android:text="去看看"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginRight="13dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ec_window_explain_back_sub_title">
        <com.bytedance.android.ui.base.widget.round.RoundFrameLayout
            android:id="@+id/ec_window_video_view_wrapper"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:bg_cornerRadius="8dp"
            app:layout_constraintDimensionRatio="H,1:1"
            app:layout_constraintEnd_toStartOf="@+id/ec_window_explain_back_img_0"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.android.shopping.api.video.ECVideoPlayerView
                android:id="@+id/ec_window_video_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:delayInitPlayer="true"
                app:enablePlayerPool="true"
                app:keepScreenOnPlaying="true"
                app:playerSceneName="window#inner_flow"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/ec_window_video_cover_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.bytedance.android.ui.base.widget.round.RoundFrameLayout>
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:id="@+id/ec_window_explain_back_img_0"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            app:cornerRadius="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="H,1:1"
            app:layout_constraintEnd_toStartOf="@+id/ec_window_explain_back_img_1"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ec_window_video_view_wrapper"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:id="@+id/ec_window_explain_back_img_1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cornerRadius="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="H,1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ec_window_explain_back_img_0"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
