<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/cj_pay_bg_common_dialog_radius_12"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:minWidth="280dp">
    <ImageView
        android:layout_gravity="start"
        android:id="@+id/close_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:src="?attr/cj_pay_icon_titlebar_left_close_noise_reduction"
        android:contentDescription="@string/cj_pay_close_text"/>
    <TextView
        android:textSize="17dp"
        android:textColor="?attr/cj_pay_text_primary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="20dp"
        android:maxLines="2"
        android:textAlignment="center"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/middle_container"
        android:background="@drawable/cj_pay_bg_middle_container"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="240dp"
        android:layout_height="72dp"
        android:layout_marginTop="16dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/bank_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"/>
        <TextView
            android:textSize="15dp"
            android:textColor="?attr/cj_pay_text_primary"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/bank_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:maxWidth="91dp"
            android:singleLine="true"/>
        <TextView
            android:textSize="15dp"
            android:textColor="?attr/cj_pay_text_primary"
            android:layout_gravity="center_vertical"
            android:id="@+id/bank_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/tip_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="20dp">
        <ImageView
            android:id="@+id/tip_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="?attr/cj_pay_text_tertiary"
            android:ellipsize="end"
            android:id="@+id/tip_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:maxLines="1"/>
    </LinearLayout>
    <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
        android:textSize="?attr/cj_pay_page_size_15"
        android:textStyle="bold"
        android:textColor="@color/cj_pay_color_white"
        android:gravity="center"
        android:id="@+id/confirm_btn"
        android:background="@color/cj_pay_color_red_fe2c55"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="20dp"
        android:text="@string/cj_pay_confirm"
        android:contentDescription="@string/cj_pay_confirm"/>
</LinearLayout>
