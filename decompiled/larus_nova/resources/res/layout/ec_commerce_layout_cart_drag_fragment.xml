<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.shopping.new_cart.widgets.CartRootFrameLayoutContainer xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/touch_outside"
        android:background="#000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:soundEffectsEnabled="false"
        android:alpha="0.6"
        android:importantForAccessibility="no"/>
    <com.bytedance.android.shopping.new_cart.widgets.CartRootFrameLayoutContainer
        android:id="@+id/cart_root_container"
        android:background="#f5f6f9"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="?attr/bottomSheetStyle">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cart_body_title"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.android.shopping.new_cart.widgets.nest.CartSwipeNestRefreshLayoutV2
                android:id="@+id/cart_refresh_layout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/cart_place_holder_footer"
                app:layout_constraintTop_toBottomOf="@+id/cart_body_title">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/vv">
                    <com.bytedance.android.shopping.new_cart.widgets.CartRefreshHeadView
                        android:id="@+id/pull_refresh_header"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:layout_marginTop="-32dp"/>
                    <com.bytedance.android.shopping.new_cart.widgets.nest.CartLinkedScrollViewV2
                        android:id="@+id/linked_scroll_view_v2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </LinearLayout>
            </com.bytedance.android.shopping.new_cart.widgets.nest.CartSwipeNestRefreshLayoutV2>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/save_card_sticky_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="@+id/cart_refresh_layout"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cart_place_holder_footer"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ViewStub
            android:id="@+id/stub_cart_error"
            android:visibility="gone"
            android:layout="@layout/new_cart_error_view_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.shopping.new_cart.widgets.ECCartLoadingView
            android:id="@+id/ec_v_loading"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.shopping.new_cart.widgets.ECCartPlaceHolderView
            android:layout_gravity="left"
            android:id="@+id/ec_v_place_holder_vertical"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:layout_marginTop="100dp"/>
        <com.bytedance.android.shopping.new_cart.widgets.ECCartPlaceHolderView
            android:layout_gravity="left"
            android:id="@+id/ec_v_place_holder_horizen"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="80dp"/>
        <com.bytedance.android.shopping.new_cart.widgets.ECCartPlaceHolderView
            android:layout_gravity="bottom"
            android:id="@+id/ec_v_place_holder_bottom_horizon"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="64dp"/>
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/debug_btn_native"
            android:background="@color/order_list_FE496A"
            android:padding="4dp"
            android:visibility="gone"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:text="Native"
            android:alpha="0.8"/>
    </com.bytedance.android.shopping.new_cart.widgets.CartRootFrameLayoutContainer>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/cart_header_name_not_limit"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/fl_footer_Hybrid_popup_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/save_card_sticky_container_fullscreen"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="10dp"
            app:layout_constraintTop_toBottomOf="@+id/cart_header_name_not_limit"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/pendant_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/cart_footer_name_not_limit"
            app:layout_constraintEnd_toEndOf="parent"/>
        <View
            android:layout_gravity="end|bottom"
            android:id="@+id/back_to_top_btn"
            android:background="@drawable/commerce_anchor_v4_back_to_top_btn"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="60dp"
            android:layout_marginEnd="13dp"
            app:layout_constraintBottom_toTopOf="@+id/cart_footer_name_not_limit"
            app:layout_constraintEnd_toEndOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/cart_footer_name_not_limit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <FrameLayout
            android:id="@+id/fl_footer_popup_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.bytedance.android.shopping.new_cart.widgets.CartRootFrameLayoutContainer>
