<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vh_frame_layout"
    android:background="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.locallife.photo.internal.photodraweeview.transition.TransitionPhotoDraweeView
        android:id="@+id/photo_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        fresco:actualImageScaleType="fitCenter"/>
    <com.bytedance.ies.dmt.ui.widget.DmtLoadingLayout
        android:layout_gravity="center"
        android:id="@+id/status_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
