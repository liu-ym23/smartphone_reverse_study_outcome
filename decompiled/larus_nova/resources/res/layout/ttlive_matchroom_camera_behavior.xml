<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:id="@+id/container"
    android:paddingRight="8dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingEnd="8dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="start|center_vertical"
        android:id="@+id/camera_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/camera_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/camera_text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="4dp"
            android:maxEms="4"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintLeft_toRightOf="@+id/camera_icon"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/paid_tips"
            android:visibility="gone"
            android:layout_width="26dp"
            android:layout_height="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="start|center_vertical"
        android:id="@+id/linked_room_container"
        android:layout_width="wrap_content"
        android:layout_height="38dp">
        <com.bytedance.android.livesdk.chatroom.view.VSLinkedAvatarContainer
            android:layout_gravity="center_vertical"
            android:id="@+id/linked_image_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/linked_image"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:actualImageScaleType="centerCrop"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:layout_gravity="end|bottom"
                android:id="@+id/living_view"
                android:tag="living_view"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginRight="6dp"
                android:layout_marginBottom="9dp"
                android:scaleType="centerCrop"
                android:layout_marginEnd="6dp"/>
        </com.bytedance.android.livesdk.chatroom.view.VSLinkedAvatarContainer>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/linked_room_text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:maxEms="4"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintLeft_toRightOf="@+id/linked_image_container"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
