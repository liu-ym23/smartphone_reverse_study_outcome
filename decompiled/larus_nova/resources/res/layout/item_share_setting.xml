<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="13dp"
    android:paddingBottom="13dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/share_setting_item_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:tint="@color/icon_n1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/share_setting_item_label"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ud_icon_tab_chat_filled"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/text_title"
        android:ellipsize="end"
        android:id="@+id/share_setting_item_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/share_setting_item_description"
        app:layout_constraintEnd_toStartOf="@+id/share_setting_item_custom_slot"
        app:layout_constraintStart_toEndOf="@+id/share_setting_item_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_caption"
        android:ellipsize="end"
        android:id="@+id/share_setting_item_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/share_setting_item_custom_slot"
        app:layout_constraintStart_toStartOf="@+id/share_setting_item_label"
        app:layout_constraintTop_toBottomOf="@+id/share_setting_item_label"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/share_setting_item_text_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="share_setting_item_label,share_setting_item_description"/>
    <FrameLayout
        android:id="@+id/share_setting_item_custom_slot"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/share_setting_item_right_arrow"
        app:layout_constraintStart_toEndOf="@+id/share_setting_item_text_barrier"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/share_setting_item_right_arrow"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:tint="@color/icon_n2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ud_icon_right_bold_outlined"/>
</merge>
