<?xml version="1.0" encoding="utf-8"?>
<com.larus.common_ui.widget.roundlayout.RoundRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:id="@+id/root"
    android:paddingLeft="@dimen/dp_20"
    android:paddingTop="@dimen/dp_24"
    android:paddingRight="@dimen/dp_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:rv_backgroundColor="@color/base_2_overlay"
    app:rv_cornerRadius="@dimen/dp_16">
    <TextView
        android:textSize="@dimen/dp_18"
        android:textColor="@color/neutral_100"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/dp_15"
        android:textColor="@color/neutral_70"
        android:id="@+id/content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_below="@+id/title"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginBottom="@dimen/dp_16"
        android:layout_below="@+id/content"
        android:layout_centerHorizontal="true"/>
</com.larus.common_ui.widget.roundlayout.RoundRelativeLayout>
