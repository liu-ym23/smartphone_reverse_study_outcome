<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/room_center_button_layout"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <Button
        android:textSize="15dp"
        android:textColor="@color/ttlive_live_dialog_negative_button"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/room_center_button_left"
        android:background="@drawable/ttlive_bg_room_center_prompt_dialog_btn_left"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:lines="1"
        android:layout_weight="1"
        android:textAllCaps="false"/>
    <View
        android:background="#1f161823"
        android:layout_width="0.5dp"
        android:layout_height="match_parent"/>
    <Button
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_live_dialog_positive_button"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/room_center_button_right"
        android:background="@drawable/ttlive_bg_room_center_prompt_dialog_btn_right"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:lines="1"
        android:layout_weight="1"
        android:textAllCaps="false"/>
</LinearLayout>
