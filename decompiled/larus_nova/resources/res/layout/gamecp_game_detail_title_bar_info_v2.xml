<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/v_title_bar_info"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_game_detail_title_close"
        android:visibility="invisible"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/gamecp_game_detail_title_close_ic_v2"
        android:scaleType="centerCrop"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_game_icon_name_container"
        android:paddingRight="8dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.gamecp.common.ui.RoundRectLayoutV2
            android:id="@+id/icon_container"
            android:layout_width="28dp"
            android:layout_height="28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.android.gamecp.common.ui.HSImageView
                android:id="@+id/iv_game_detail_title_game_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:roundedCornerRadius="6dp"/>
            <View
                android:background="@drawable/gamecp_game_detail_img_default_bg_6dp_frame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.bytedance.android.gamecp.common.ui.RoundRectLayoutV2>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/gamecp_white"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_game_detail_title_game_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:layout_marginStart="8dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/gamecp_detail_header_status"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/icon_container"/>
        <com.bytedance.android.gamecp.common.ui.HSImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/gamecp_detail_header_status"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginTop="1dp"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_game_detail_title_game_name"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
