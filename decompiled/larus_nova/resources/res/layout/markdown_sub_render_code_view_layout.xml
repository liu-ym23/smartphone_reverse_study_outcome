<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto">
    <com.larus.bmhome.chat.layout.holder.progressloading.ImageWebpLoadingBgView
        android:id="@+id/markdownCodeLoadingBg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.larus.bmhome.chat.markdown.code.CodeRenderGestureLayout
        android:id="@+id/markdownCodePreviewLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/markdownCodeRenderImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            fresco:actualImageScaleType="fitCenter"/>
        <FrameLayout
            android:id="@+id/markdownCodeRenderLynxView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="@dimen/dp_15"
            android:textColor="?attr/larus_neutral_50"
            android:gravity="center_horizontal"
            android:layout_gravity="bottom"
            android:id="@+id/markdownCodePreviewFoldDesc"
            android:background="@drawable/markdown_impl_markdown_code_mask_bg"
            android:paddingTop="@dimen/dp_42"
            android:paddingBottom="@dimen/dp_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.larus.bmhome.chat.markdown.code.CodeRenderGestureLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/markdownCodeRenderFailedLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/markdownCodeRenderFailedIcon"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:src="@drawable/clickable_markdown_fail_retry_icon"/>
        <TextView
            android:textSize="@dimen/dp_15"
            android:textColor="?attr/larus_neutral_30"
            android:gravity="center_vertical"
            android:id="@+id/markdownCodeRenderFailedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            android:text="@string/larus_codePreview_statusLabel_previewFail"
            android:drawablePadding="@dimen/dp_2"
            android:drawableEnd="@drawable/clickable_markdown_fail_right_icon"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/markdownCodeRenderLoadingLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/markdownCodeLoadingImageViewV2"
            android:visibility="gone"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:layout_marginBottom="@dimen/dp_8"
            android:src="@drawable/click_markdown_render_loading_icon"/>
        <TextView
            android:textSize="@dimen/dp_15"
            android:textStyle="bold"
            android:textColor="?attr/larus_neutral_transparent_3"
            android:id="@+id/markdownCodeLoadingTextV2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_artifactCard_status_generating"/>
        <TextView
            android:textSize="@dimen/dp_17"
            android:textColor="?attr/larus_neutral_70"
            android:id="@+id/markdownCodeLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_codePreview_statusLabel_genPreview"/>
        <ProgressBar
            android:id="@+id/markdownCodeProgressBar"
            android:visibility="visible"
            android:layout_width="@dimen/dp_240"
            android:layout_height="@dimen/dp_4"
            android:layout_marginTop="@dimen/dp_14"
            android:max="100"
            android:progress="0"
            android:progressDrawable="?attr/larus_preview_progress_horiztal"
            style="@android:style/Widget.ProgressBar.Horizontal"/>
    </LinearLayout>
</merge>
