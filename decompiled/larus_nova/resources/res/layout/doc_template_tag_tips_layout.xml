<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@color/primary_fill_solid_01"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <ImageView
        android:background="@drawable/ud_icon_template_colorful"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="@dimen/dp_18"
        android:layout_marginEnd="6dp"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/text_title"
        android:gravity="center_vertical"
        android:id="@+id/template_tag_des"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/CreationMobile_Template_ThisIsATemplate"
        android:singleLine="true"
        android:layout_weight="1"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/primary_fill_default"
        android:gravity="center"
        android:id="@+id/use_template"
        android:background="@drawable/doc_template_tag_bg"
        android:paddingTop="@dimen/dp_4"
        android:paddingBottom="@dimen/dp_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/CreationMobile_Template_UseThisTemplate"
        android:paddingStart="@dimen/dp_8"
        android:paddingEnd="@dimen/dp_8"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"/>
</androidx.appcompat.widget.LinearLayoutCompat>
