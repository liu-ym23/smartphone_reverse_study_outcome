<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/root_container"
        android:background="?attr/larus_bg_gaokao_preference_dialog"
        android:visibility="invisible"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/gaokao_preference_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_56">
                <TextView
                    android:textSize="?attr/larus_dp_17"
                    android:textStyle="bold"
                    android:textColor="?attr/larus_neutral_100"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_gaokao_pad_volunteeer_application"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/gaokao_preference_close"
                    android:layout_width="?attr/larus_dp_28"
                    android:layout_height="?attr/larus_dp_28"
                    android:layout_marginEnd="?attr/larus_dp_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="?attr/larus_ic_gaokao_preference_close"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.larus.common_ui.widget.MaxHeightScrollView
                android:id="@+id/gaokao_preference_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                app:larus_max_height="?attr/larus_dp_586">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/gaokao_preference_scroll_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="?attr/larus_dp_14"
                        android:textColor="?attr/larus_neutral_50"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="?attr/larus_dp_8"
                        android:text="@string/larus_volunteer_pad_province"
                        android:layout_marginStart="?attr/larus_dp_32"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/gaokao_preference_province"
                        android:background="?attr/larus_bg_gaokao_16_radius"
                        android:layout_width="match_parent"
                        android:layout_height="?attr/larus_dp_53"
                        android:layout_marginStart="?attr/larus_dp_16"
                        android:layout_marginEnd="?attr/larus_dp_16">
                        <TextView
                            android:textSize="?attr/larus_dp_17"
                            android:textStyle="bold"
                            android:textColor="?attr/larus_neutral_100"
                            android:id="@+id/gaokao_preference_province_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:layout_marginStart="?attr/larus_dp_16"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/gaokao_preference_right_arrow"
                            android:layout_width="?attr/larus_dp_9"
                            android:layout_height="?attr/larus_dp_15"
                            android:layout_marginEnd="?attr/larus_dp_16"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/larus_ic_gaokao_preference_right_arrow"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <TextView
                        android:textSize="?attr/larus_dp_14"
                        android:textColor="?attr/larus_neutral_50"
                        android:id="@+id/gaokao_single_select_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="?attr/larus_dp_16"
                        android:text="@string/larus_volunteer_pad_subject_1"
                        android:layout_marginStart="?attr/larus_dp_32"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/gaokao_single_select_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="?attr/larus_dp_8"
                        android:layout_marginStart="?attr/larus_dp_16"
                        android:layout_marginEnd="?attr/larus_dp_16"/>
                    <TextView
                        android:textSize="?attr/larus_dp_14"
                        android:textColor="?attr/larus_neutral_50"
                        android:id="@+id/gaokao_multi_select_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="?attr/larus_dp_16"
                        android:text="@string/larus_volunteer_pad_subject_2"
                        android:layout_marginStart="?attr/larus_dp_32"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/gaokao_multi_select_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="?attr/larus_dp_8"
                        android:layout_marginStart="?attr/larus_dp_16"
                        android:layout_marginEnd="?attr/larus_dp_16"/>
                    <TextView
                        android:textSize="?attr/larus_dp_14"
                        android:textColor="?attr/larus_neutral_50"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="?attr/larus_dp_16"
                        android:text="@string/larus_volunteer_pad_score_title"
                        android:layout_marginStart="?attr/larus_dp_32"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:background="?attr/larus_bg_gaokao_16_radius"
                        android:layout_width="match_parent"
                        android:layout_height="?attr/larus_dp_106"
                        android:layout_marginTop="?attr/larus_dp_8"
                        android:layout_marginStart="?attr/larus_dp_16"
                        android:layout_marginEnd="?attr/larus_dp_16">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="?attr/larus_dp_53">
                            <TextView
                                android:textSize="?attr/larus_dp_17"
                                android:textStyle="bold"
                                android:textColor="?attr/larus_neutral_100"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/larus_volunteer_pad_score_1"
                                android:layout_marginStart="?attr/larus_dp_16"/>
                            <EditText
                                android:textSize="?attr/larus_dp_16"
                                android:textColor="?attr/larus_neutral_100"
                                android:textColorHint="?attr/larus_neutral_50"
                                android:id="@+id/gaokao_score_input"
                                android:background="@null"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/larus_volunteer_pad_score_hint"
                                android:maxLength="3"
                                android:digits="0123456789"
                                android:inputType="number"
                                android:layout_marginStart="?attr/larus_dp_16"
                                android:layout_marginEnd="?attr/larus_dp_16"/>
                        </LinearLayout>
                        <View
                            android:background="?attr/larus_neutral_transparent_1"
                            android:layout_width="match_parent"
                            android:layout_height="0.5px"
                            android:layout_marginStart="?attr/larus_dp_16"/>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="?attr/larus_dp_53">
                            <TextView
                                android:textSize="?attr/larus_dp_17"
                                android:textStyle="bold"
                                android:textColor="?attr/larus_neutral_100"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/larus_volunteer_pad_score_2"
                                android:layout_marginStart="?attr/larus_dp_16"/>
                            <EditText
                                android:textSize="?attr/larus_dp_16"
                                android:textColor="?attr/larus_neutral_100"
                                android:textColorHint="?attr/larus_neutral_50"
                                android:id="@+id/gaokao_rank_input"
                                android:background="@null"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/larus_volunteer_pad_ranking_hint"
                                android:maxLines="1"
                                android:lines="1"
                                android:singleLine="true"
                                android:maxLength="10"
                                android:digits="0123456789"
                                android:inputType="number"
                                android:layout_marginStart="?attr/larus_dp_16"
                                android:layout_marginEnd="?attr/larus_dp_16"/>
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:textSize="?attr/larus_dp_14"
                        android:textColor="?attr/larus_neutral_50"
                        android:id="@+id/gaokao_post_grad_preference_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="?attr/larus_dp_16"
                        android:text="@string/larus_gaokao_future_plan_title"
                        android:layout_marginStart="?attr/larus_dp_32"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/gaokao_post_grad_preference_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="?attr/larus_dp_8"
                        android:layout_marginStart="?attr/larus_dp_16"
                        android:layout_marginEnd="?attr/larus_dp_16"/>
                    <TextView
                        android:textSize="?attr/larus_dp_17"
                        android:textStyle="bold"
                        android:textColor="@color/larus_static_white"
                        android:gravity="center"
                        android:id="@+id/gaokao_preference_confirm_button"
                        android:background="?attr/larus_bg_gaokao_confirm_button_not_ready"
                        android:layout_width="match_parent"
                        android:layout_height="?attr/larus_dp_52"
                        android:layout_marginTop="?attr/larus_dp_32"
                        android:layout_marginBottom="?attr/larus_dp_12"
                        android:text="@string/larus_create_bot_done"
                        android:layout_marginStart="?attr/larus_dp_16"
                        android:layout_marginEnd="?attr/larus_dp_16"/>
                </LinearLayout>
            </com.larus.common_ui.widget.MaxHeightScrollView>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/gaokao_province_cover"
        android:background="@color/larus_static_black_transparent_1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/gaokao_province_root_container"
        android:background="?attr/larus_bg_gaokao_province_dialog"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/gaokao_province_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_56">
                <TextView
                    android:textSize="?attr/larus_dp_17"
                    android:textStyle="bold"
                    android:textColor="?attr/larus_neutral_100"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_volunteer_pad_province_select"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/gaokao_province_close"
                    android:layout_width="?attr/larus_dp_28"
                    android:layout_height="?attr/larus_dp_28"
                    android:layout_marginEnd="?attr/larus_dp_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="?attr/larus_ic_gaokao_preference_close"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/gaokao_province_recycler"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_400"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
