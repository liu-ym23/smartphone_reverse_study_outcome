<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/larus_static_black_transparent_2"
        android:paddingLeft="?attr/larus_dp_12"
        android:paddingTop="?attr/larus_dp_12"
        android:paddingRight="?attr/larus_dp_12"
        android:paddingBottom="?attr/larus_dp_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.larus.common_ui.widget.roundlayout.RoundFrameLayout
            android:id="@+id/modify_current_button"
            android:layout_width="?attr/larus_dp_0"
            android:layout_height="?attr/larus_dp_56"
            android:layout_weight="1"
            app:rv_backgroundColor="#2c2c2c"
            app:rv_cornerRadius="?attr/larus_dp_12">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_dp_16"
                android:textColor="@color/larus_static_white"
                android:layout_gravity="center"
                android:id="@+id/modify_current_button_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"/>
        </com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
        <View
            android:id="@+id/mid_space"
            android:layout_width="8dp"
            android:layout_height="?attr/larus_dp_44"/>
        <com.larus.common_ui.widget.roundlayout.RoundFrameLayout
            android:id="@+id/take_new_button"
            android:layout_width="?attr/larus_dp_0"
            android:layout_height="?attr/larus_dp_56"
            android:layout_weight="1"
            app:rv_backgroundColor="@color/larus_static_white"
            app:rv_cornerRadius="?attr/larus_dp_12">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_dp_16"
                android:textColor="@color/larus_static_black"
                android:layout_gravity="center"
                android:id="@+id/take_new_button_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"/>
        </com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
    </LinearLayout>
</FrameLayout>
