<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_pay_sign_layout"
    android:background="@color/cj_pay_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/cj_pay_iv_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <RelativeLayout
            android:id="@+id/top_navigation_bar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="44dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/sign_left_close_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/cj_pay_sign_and_pay_left_leave"
                android:layout_centerVertical="true"/>
            <ImageView
                android:id="@+id/navigation_bar_icon"
                android:layout_width="85dp"
                android:layout_height="18dp"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/page_scroll_view"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="16dp"
            android:fillViewport="true"
            android:layout_weight="1"
            android:overScrollMode="never">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/sign_icon_and_title_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp">
                    <ImageView
                        android:id="@+id/sign_merchant_icon"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:layout_marginTop="40dp"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">
                        <TextView
                            android:textSize="18sp"
                            android:textColor="@color/cj_pay_color_black_161823"
                            android:ellipsize="end"
                            android:id="@+id/sign_product_name_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:layout_weight="1"/>
                        <ImageView
                            android:id="@+id/sign_service_info_icon"
                            android:visibility="gone"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginLeft="4dp"
                            android:src="@drawable/cj_pay_sign_service_info"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="bottom"
                        android:layout_gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:id="@+id/sign_risk_fund_layout"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="16dp"
                        android:baselineAligned="false">
                        <TextView
                            android:textSize="17sp"
                            android:textColor="@color/cj_pay_color_black_161823"
                            android:gravity="center_vertical"
                            android:id="@+id/risk_fund_amount_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:text="@string/cj_pay_currency_unit"/>
                        <TextView
                            android:textSize="40sp"
                            android:textColor="@color/cj_pay_color_black_161823"
                            android:gravity="center_vertical"
                            android:id="@+id/risk_fund_amount"
                            android:paddingTop="2dp"
                            android:layout_width="wrap_content"
                            android:layout_height="52dp"
                            android:layout_marginLeft="4dp"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/cj_pay_color_black_161823"
                            android:gravity="center_vertical"
                            android:id="@+id/risk_fund_description_text"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginLeft="4dp"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
                    android:ellipsize="end"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/sign_product_sub_name_text"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:singleLine="true"/>
                <ImageView
                    android:id="@+id/sign_page_desc_img"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="111dp"
                    android:layout_marginTop="40dp"/>
                <View
                    android:id="@+id/sign_split_line"
                    android:background="#14161823"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="24dp"
                    android:layout_centerInParent="true"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ff161823"
                    android:id="@+id/sign_service_detail_union_tv"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/sign_and_pay_only_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/sign_service_merchant_line_layout"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#99161823"
                            android:layout_gravity="top"
                            android:id="@+id/sign_service_merchant_left"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="24dp"
                            android:text="@string/cj_pay_sign_and_pay_service_merchant"/>
                        <com.android.ttcjpaysdk.base.theme.widget.CJPayFlexibleRoundCornerImageView
                            android:layout_gravity="center_vertical"
                            android:id="@+id/sign_service_merchant_icon"
                            android:visibility="gone"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginRight="4dp"
                            android:scaleType="centerCrop"
                            android:adjustViewBounds="true"
                            app:CJPayCorners="CJPay_BOTTOM_RIGHT|CJPay_BOTTOM_LEFT|CJPay_TOP_RIGHT|CJPay_TOP_LEFT"
                            app:CJPayCornersRadius="8dp"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff161823"
                            android:ellipsize="end"
                            android:id="@+id/sign_service_merchant_right"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/multi_sign_info_line_layout"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#99161823"
                            android:layout_gravity="top"
                            android:id="@+id/multi_sign_info_left"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="24dp"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff161823"
                            android:id="@+id/multi_sign_info_right"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <ImageView
                            android:layout_gravity="center_vertical"
                            android:id="@+id/multi_sign_info_show"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/cj_eye_close_icon"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>
                    <RelativeLayout
                        android:orientation="horizontal"
                        android:id="@+id/sign_service_detail_line_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#99161823"
                            android:layout_gravity="top"
                            android:id="@+id/sign_service_detail_left"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cj_pay_sign_and_pay_service_title"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff161823"
                            android:gravity="left"
                            android:layout_gravity="top"
                            android:id="@+id/sign_service_detail_right"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="24dp"
                            android:layout_toRightOf="@+id/sign_service_detail_left"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/cj_pay_color_blue_04498D"
                            android:id="@+id/sign_service_detail_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cj_pay_detail"
                            android:layout_below="@+id/sign_service_detail_right"
                            android:layout_alignLeft="@+id/sign_service_detail_right"/>
                    </RelativeLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/deduct_method_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp">
                        <View
                            android:id="@+id/deduct_split_line"
                            android:background="#14161823"
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:layout_marginBottom="23.5dp"/>
                        <RelativeLayout
                            android:id="@+id/switch_account_layout"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp">
                            <TextView
                                android:textColor="#99161823"
                                android:id="@+id/switch_account_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cj_pay_sign_cur_account"/>
                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="14dp"
                                android:layout_toRightOf="@+id/switch_account_title">
                                <LinearLayout
                                    android:orientation="horizontal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="10dp">
                                    <com.facebook.drawee.view.SimpleDraweeView
                                        android:layout_gravity="center_vertical"
                                        android:id="@+id/cur_user_icon"
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"/>
                                    <TextView
                                        android:textSize="14sp"
                                        android:textColor="#ff161823"
                                        android:ellipsize="middle"
                                        android:layout_gravity="center_vertical"
                                        android:id="@+id/cur_user_name"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="4dp"
                                        android:text="@string/cur_user_name"
                                        android:singleLine="true"
                                        android:layout_weight="1"
                                        android:layout_toLeftOf="@+id/cur_account_hint_info"
                                        android:layout_toRightOf="@+id/cur_user_icon"/>
                                    <TextView
                                        android:textSize="12sp"
                                        android:textColor="#99161823"
                                        android:layout_gravity="center_vertical"
                                        android:id="@+id/cur_account_hint_info"
                                        android:background="@drawable/cj_pay_sign_only_account_hint_info"
                                        android:paddingLeft="4dp"
                                        android:paddingRight="4dp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="4dp"
                                        android:text="@string/cur_user_title"/>
                                </LinearLayout>
                                <RelativeLayout
                                    android:id="@+id/change_account_layout"
                                    android:background="@drawable/cj_pay_sign_only_change_account_view"
                                    android:visibility="visible"
                                    android:layout_width="match_parent"
                                    android:layout_height="67dp"
                                    android:layout_marginTop="12dp">
                                    <TextView
                                        android:textSize="14sp"
                                        android:textColor="#161823"
                                        android:ellipsize="end"
                                        android:id="@+id/login_account_label"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="10dp"
                                        android:layout_marginRight="10dp"
                                        android:text="用手机号打车登录享优惠"
                                        android:maxLines="1"
                                        android:layout_toLeftOf="@+id/switch_account_btn"
                                        android:layout_alignParentLeft="true"
                                        android:layout_centerVertical="true"/>
                                    <LinearLayout
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal"
                                        android:id="@+id/switch_account_info_layout"
                                        android:visibility="gone"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_toLeftOf="@+id/switch_account_btn">
                                        <com.facebook.drawee.view.SimpleDraweeView
                                            android:id="@+id/switch_account_icon"
                                            android:layout_width="38dp"
                                            android:layout_height="38dp"
                                            android:layout_marginLeft="10dp"
                                            android:layout_centerVertical="true"/>
                                        <TextView
                                            android:textSize="14sp"
                                            android:textColor="#ff161823"
                                            android:ellipsize="middle"
                                            android:id="@+id/switch_account_name"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginLeft="8dp"
                                            android:layout_marginRight="8dp"
                                            android:text="@string/cur_user_name"
                                            android:singleLine="true"
                                            android:layout_toRightOf="@+id/switch_account_icon"
                                            android:layout_centerVertical="true"/>
                                    </LinearLayout>
                                    <RelativeLayout
                                        android:id="@+id/switch_account_promotion_layout"
                                        android:layout_width="110dp"
                                        android:layout_height="14dp"
                                        android:layout_alignParentTop="true"
                                        android:layout_alignParentRight="true"
                                        android:layout_centerHorizontal="true">
                                        <TextView
                                            android:textSize="9sp"
                                            android:textColor="#ffffffff"
                                            android:ellipsize="end"
                                            android:id="@+id/switch_account_promotion_label"
                                            android:background="@drawable/cj_pay_icon_promotion_background"
                                            android:paddingLeft="8dp"
                                            android:paddingRight="8dp"
                                            android:layout_width="wrap_content"
                                            android:layout_height="match_parent"
                                            android:text="开通后返6元"
                                            android:singleLine="true"
                                            android:layout_alignParentRight="true"/>
                                    </RelativeLayout>
                                    <Button
                                        android:textSize="12sp"
                                        android:textColor="#cc161823"
                                        android:id="@+id/switch_account_btn"
                                        android:background="@drawable/cj_pay_sign_only_change_account_button"
                                        android:layout_width="78dp"
                                        android:layout_height="27dp"
                                        android:layout_marginRight="10dp"
                                        android:text="@string/cj_pay_sign_switch_account"
                                        android:layout_alignParentRight="true"
                                        android:layout_centerVertical="true"/>
                                </RelativeLayout>
                            </LinearLayout>
                        </RelativeLayout>
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="14sp"
                                android:textColor="#99161823"
                                android:layout_gravity="top"
                                android:id="@+id/sign_charge_left"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cj_pay_sign_and_pay_method_title"
                                android:layout_alignParentStart="true"/>
                            <RelativeLayout
                                android:id="@+id/deduct_method_display_layout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="24dp"
                                android:layout_toEndOf="@+id/sign_charge_left">
                                <TextView
                                    android:textSize="14sp"
                                    android:textColor="#ff161823"
                                    android:ellipsize="middle"
                                    android:id="@+id/deduct_method_prefix"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/cj_pay_text_priority_use"
                                    android:singleLine="true"
                                    android:layout_centerVertical="true"/>
                                <ImageView
                                    android:id="@+id/deduct_method_icon"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginLeft="4dp"
                                    android:layout_marginRight="4dp"
                                    android:layout_toRightOf="@+id/deduct_method_prefix"
                                    android:layout_centerVertical="true"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:textColor="#ff161823"
                                    android:ellipsize="middle"
                                    android:id="@+id/deduct_method_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:singleLine="true"
                                    android:layout_toLeftOf="@+id/deduct_method_right_arrow"
                                    android:layout_toRightOf="@+id/deduct_method_icon"
                                    android:layout_centerVertical="true"
                                    android:layout_alignWithParentIfMissing="true"/>
                                <ImageView
                                    android:id="@+id/deduct_method_right_arrow"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginLeft="2dp"
                                    android:src="@drawable/cj_pay_sign_right_arrow"
                                    android:layout_alignParentRight="true"
                                    android:layout_centerVertical="true"/>
                            </RelativeLayout>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="#80161823"
                                android:id="@+id/sign_deduct_order_desc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:layout_below="@+id/deduct_method_display_layout"
                                android:layout_alignStart="@+id/deduct_method_display_layout"/>
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/layout_lynx_card_inner"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/rl_voucher_label_layout"
            android:background="@drawable/cj_pay_voucher_bubble"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginBottom="8dp"
            android:layout_centerInParent="true">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="@dimen/cj_pay_padding_5"
                android:src="@drawable/cj_pay_sign_voucher"
                android:scaleType="center"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/cj_pay_color_red_fe2c55"
                android:ellipsize="end"
                android:id="@+id/tv_voucher_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/iv_voucher_label_arrow"
                android:visibility="gone"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/cj_pay_voucher_bubble_arrow"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/layout_lynx_card_btn_up"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>
        <com.android.ttcjpaysdk.bdpay.counter.outer.sign.view.CJSignAgreementView
            android:id="@+id/sign_agreement_view_above"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>
        <com.android.ttcjpaysdk.base.ui.widget.LoadingButton
            android:gravity="center"
            android:id="@+id/sign_confirm_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_custom_button_height_44"
            app:btnTextColor="@color/cj_pay_color_white"
            app:btnTextSize="15sp"
            app:loadingHeight="20dp"
            app:loadingWidth="20dp"/>
        <com.android.ttcjpaysdk.bdpay.counter.outer.sign.view.CJSignAgreementView
            android:id="@+id/sign_agreement_view_below"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
            android:id="@+id/bottom_insurance_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="-8dp"
            app:theme_type="0"/>
        <View
            android:layout_width="wrap_content"
            android:layout_height="20dp"/>
    </LinearLayout>
</FrameLayout>
