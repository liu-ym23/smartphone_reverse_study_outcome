<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/md_simple_image_group_more"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/simple_image_group_img_1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:viewAspectRatio="1"/>
    <Space
        android:layout_width="4dp"
        android:layout_height="match_parent"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/simple_image_group_img_2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:viewAspectRatio="1"/>
    <Space
        android:layout_width="4dp"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:viewAspectRatio="1">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/simple_image_group_img_3"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:viewAspectRatio="1"/>
        <View
            android:id="@+id/moreInfoMask"
            android:background="@drawable/larus_simple_image_group_mask"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.4"/>
        <TextView
            android:textSize="17dp"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/moreInfoText"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="sans-serif-medium"/>
    </FrameLayout>
</LinearLayout>
