<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/time_picker_group"
    android:paddingTop="20dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.livesdk.widget.LiveNumberPicker
        android:id="@+id/date_num_picker"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        app:layout_constraintEnd_toStartOf="@+id/hour_num_picker"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ttlive_dateTextColor="#e6ffffff"
        app:ttlive_dateTextSize="18dp"
        app:ttlive_dividerColor="#1fffffff"
        app:ttlive_dividerStroke="1dp"
        app:ttlive_endNumber="23"
        app:ttlive_rowNumber="3"
        app:ttlive_startNumber="0"
        app:ttlive_verticalSpacing="25dp"/>
    <com.bytedance.android.livesdk.widget.LiveNumberPicker
        android:id="@+id/hour_num_picker"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="23dp"
        android:layout_marginStart="20dp"
        app:layout_constraintEnd_toStartOf="@+id/min_num_picker"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/date_num_picker"
        app:layout_constraintTop_toTopOf="parent"
        app:ttlive_dateTextColor="#e6ffffff"
        app:ttlive_dateTextSize="18dp"
        app:ttlive_dividerColor="#1fffffff"
        app:ttlive_dividerStroke="1dp"
        app:ttlive_endNumber="23"
        app:ttlive_rowNumber="3"
        app:ttlive_startNumber="0"
        app:ttlive_verticalSpacing="25dp"/>
    <com.bytedance.android.livesdk.widget.LiveNumberPicker
        android:id="@+id/min_num_picker"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_period"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/hour_num_picker"
        app:layout_constraintTop_toTopOf="@+id/hour_num_picker"
        app:layout_goneMarginBottom="36dp"
        app:ttlive_dateTextColor="#e6ffffff"
        app:ttlive_dateTextSize="18dp"
        app:ttlive_dividerColor="#1fffffff"
        app:ttlive_dividerStroke="1dp"
        app:ttlive_endNumber="5"
        app:ttlive_rowNumber="3"
        app:ttlive_startNumber="0"
        app:ttlive_verticalSpacing="25dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_period"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/min_num_picker">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_white_90"
            android:id="@+id/title_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:text="@string/ttlive_announcement_period_desc"
            android:alpha="0.5"/>
        <HorizontalScrollView
            android:id="@+id/scroll_view"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp">
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/date_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
        </HorizontalScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
