<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="?attr/larus_dp_24"
    android:paddingStart="?attr/larus_dp_6"
    android:paddingEnd="?attr/larus_dp_6">
    <TextView
        android:textSize="?attr/larus_sp_12"
        android:textColor="@color/dora_o_text_secondary"
        android:id="@+id/subtitle_original"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="?attr/larus_sp_16"
        android:textColor="@color/dora_o_text_primary"
        android:id="@+id/subtitle_translation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_2"/>
</LinearLayout>
