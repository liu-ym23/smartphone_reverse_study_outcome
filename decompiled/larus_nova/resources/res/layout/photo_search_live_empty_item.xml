<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="11dp"
        android:textColor="#66161823"
        android:id="@+id/photo_search_line_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@drawable/photo_search_short_line_left"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginEnd="7dp"
        app:layout_constraintBottom_toBottomOf="@+id/photo_search_line_text"
        app:layout_constraintEnd_toStartOf="@+id/photo_search_line_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/photo_search_line_text"/>
    <View
        android:background="@drawable/photo_search_short_line_right"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginStart="7dp"
        app:layout_constraintBottom_toBottomOf="@+id/photo_search_line_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/photo_search_line_text"
        app:layout_constraintTop_toTopOf="@+id/photo_search_line_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
