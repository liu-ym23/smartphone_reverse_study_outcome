<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/dora_o_bg_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/auth_content_container"
            android:paddingBottom="?attr/larus_dp_34"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="?attr/larus_dp_24"
                android:paddingBottom="?attr/larus_dp_24"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="?attr/larus_dp_32"
                android:paddingEnd="?attr/larus_dp_32">
                <ImageView
                    android:id="@+id/auth_app_icon"
                    android:background="@drawable/dora_o_bg_app_icon_placeholder"
                    android:layout_width="?attr/larus_dp_72"
                    android:layout_height="?attr/larus_dp_72"
                    android:src="@drawable/dora_o_ic_journal_star"
                    android:importantForAccessibility="no"/>
                <TextView
                    android:textSize="?attr/larus_sp_24"
                    android:textStyle="bold"
                    android:textColor="@color/dora_o_text_primary"
                    android:gravity="center"
                    android:id="@+id/auth_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_16"
                    android:text="@string/larus_dora_g_device_diary_record_cn"/>
                <TextView
                    android:textSize="?attr/larus_sp_14"
                    android:textColor="@color/dora_o_text_secondary"
                    android:gravity="center"
                    android:id="@+id/auth_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_4"
                    android:text="@string/larus_dora_o_diary_auth_desc"
                    android:lineSpacingExtra="?attr/larus_dp_4"/>
            </LinearLayout>
            <FrameLayout
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_277">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:layout_gravity="start|center_vertical"
                    android:orientation="vertical"
                    android:layout_width="?attr/larus_dp_6"
                    android:layout_height="?attr/larus_dp_252"
                    android:layout_marginStart="?attr/larus_dp_29">
                    <View
                        android:background="@drawable/dora_o_bg_timeline_dot"
                        android:layout_width="?attr/larus_dp_6"
                        android:layout_height="?attr/larus_dp_6"/>
                    <View
                        android:background="@drawable/dora_o_bg_timeline_line"
                        android:layout_width="?attr/larus_dp_2"
                        android:layout_height="?attr/larus_dp_110"
                        android:layout_marginTop="?attr/larus_dp_6"/>
                    <View
                        android:background="@drawable/dora_o_bg_timeline_dot"
                        android:layout_width="?attr/larus_dp_6"
                        android:layout_height="?attr/larus_dp_6"
                        android:layout_marginTop="?attr/larus_dp_6"/>
                    <View
                        android:background="@drawable/dora_o_bg_timeline_line"
                        android:layout_width="?attr/larus_dp_2"
                        android:layout_height="?attr/larus_dp_110"
                        android:layout_marginTop="?attr/larus_dp_6"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_gravity="start|top"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="?attr/larus_dp_282"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_19"
                    android:layout_marginStart="?attr/larus_dp_44">
                    <FrameLayout
                        android:background="@drawable/dora_o_bg_auth_sample_card"
                        android:layout_width="?attr/larus_dp_282"
                        android:layout_height="?attr/larus_dp_115"
                        android:rotation="3">
                        <TextView
                            android:textSize="?attr/larus_sp_10"
                            android:textColor="@color/dora_o_text_secondary"
                            android:layout_gravity="start|top"
                            android:padding="?attr/larus_dp_16"
                            android:layout_width="?attr/larus_dp_250"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="?attr/larus_dp_1"
                            android:text="@string/larus_dora_o_diary_auth_sample_1"
                            android:lineSpacingExtra="?attr/larus_dp_2"/>
                        <FrameLayout
                            android:layout_gravity="start|bottom"
                            android:background="@drawable/dora_o_bg_sample_photo_ring"
                            android:layout_width="?attr/larus_dp_46"
                            android:layout_height="?attr/larus_dp_46"
                            android:layout_marginBottom="?attr/larus_dp_12"
                            android:rotation="3"
                            android:layout_marginStart="?attr/larus_dp_15">
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@+id/auth_sample_photo_1"
                                android:background="@drawable/dora_o_bg_sample_photo"
                                android:layout_width="?attr/larus_dp_44"
                                android:layout_height="?attr/larus_dp_44"
                                android:src="@drawable/dora_o_img_diary_sample_1"
                                android:scaleType="centerCrop"
                                android:importantForAccessibility="no"/>
                        </FrameLayout>
                        <FrameLayout
                            android:layout_gravity="start|bottom"
                            android:background="@drawable/dora_o_bg_sample_photo_ring"
                            android:layout_width="?attr/larus_dp_46"
                            android:layout_height="?attr/larus_dp_46"
                            android:layout_marginBottom="?attr/larus_dp_12"
                            android:rotation="-3"
                            android:layout_marginStart="?attr/larus_dp_59">
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@+id/auth_sample_photo_2"
                                android:background="@drawable/dora_o_bg_sample_photo"
                                android:layout_width="?attr/larus_dp_44"
                                android:layout_height="?attr/larus_dp_44"
                                android:src="@drawable/dora_o_img_diary_sample_2"
                                android:scaleType="centerCrop"
                                android:importantForAccessibility="no"/>
                        </FrameLayout>
                    </FrameLayout>
                    <FrameLayout
                        android:background="@drawable/dora_o_bg_auth_sample_card"
                        android:layout_width="?attr/larus_dp_282"
                        android:layout_height="?attr/larus_dp_115"
                        android:layout_marginTop="?attr/larus_dp_17">
                        <TextView
                            android:textSize="?attr/larus_sp_10"
                            android:textColor="@color/dora_o_text_secondary"
                            android:layout_gravity="start|top"
                            android:padding="?attr/larus_dp_16"
                            android:layout_width="?attr/larus_dp_250"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="?attr/larus_dp_1"
                            android:text="@string/larus_dora_o_diary_auth_sample_2"
                            android:lineSpacingExtra="?attr/larus_dp_2"/>
                        <FrameLayout
                            android:layout_gravity="start|bottom"
                            android:background="@drawable/dora_o_bg_sample_photo_ring"
                            android:layout_width="?attr/larus_dp_46"
                            android:layout_height="?attr/larus_dp_46"
                            android:layout_marginBottom="?attr/larus_dp_12"
                            android:rotation="3"
                            android:layout_marginStart="?attr/larus_dp_15">
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@+id/auth_sample_photo_3"
                                android:background="@drawable/dora_o_bg_sample_photo"
                                android:layout_width="?attr/larus_dp_44"
                                android:layout_height="?attr/larus_dp_44"
                                android:src="@drawable/dora_o_img_diary_sample_3"
                                android:scaleType="centerCrop"
                                android:importantForAccessibility="no"/>
                        </FrameLayout>
                        <FrameLayout
                            android:layout_gravity="start|bottom"
                            android:background="@drawable/dora_o_bg_sample_photo_ring"
                            android:layout_width="?attr/larus_dp_46"
                            android:layout_height="?attr/larus_dp_46"
                            android:layout_marginBottom="?attr/larus_dp_12"
                            android:rotation="-3"
                            android:layout_marginStart="?attr/larus_dp_59">
                            <ImageView
                                android:layout_gravity="center"
                                android:id="@+id/auth_sample_photo_4"
                                android:background="@drawable/dora_o_bg_sample_photo"
                                android:layout_width="?attr/larus_dp_44"
                                android:layout_height="?attr/larus_dp_44"
                                android:src="@drawable/dora_o_img_diary_sample_4"
                                android:scaleType="centerCrop"
                                android:importantForAccessibility="no"/>
                        </FrameLayout>
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>
            <com.obric.oui.button.OButton
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/auth_agree_button"
                android:paddingLeft="?attr/larus_dp_60"
                android:paddingRight="?attr/larus_dp_60"
                android:layout_width="wrap_content"
                android:layout_height="?attr/larus_dp_48"
                android:layout_marginTop="?attr/larus_dp_47"
                android:text="@string/larus_dora_onboarding_glasses_memory_open_button_cn"
                style="@style/OStyleV2.OButton.L.Standard.Primary"/>
        </LinearLayout>
    </ScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/auth_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</androidx.constraintlayout.widget.ConstraintLayout>
