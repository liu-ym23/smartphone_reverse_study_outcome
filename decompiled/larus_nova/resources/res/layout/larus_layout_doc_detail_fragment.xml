<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/docs_titlebar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/doc_titlebar"
            android:background="@color/larus_base_1"
            android:paddingLeft="@dimen/dp_8"
            android:paddingRight="@dimen/dp_8"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_60">
            <FrameLayout
                android:id="@+id/doc_titlebar_left_icon_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/doc_titlebar_back"
                    android:layout_width="?attr/larus_dp_44"
                    android:layout_height="?attr/larus_dp_44"
                    android:src="@drawable/larus_ic_left_back"
                    android:scaleType="centerInside"/>
                <ImageView
                    android:id="@+id/doc_titlebar_complete"
                    android:visibility="gone"
                    android:layout_width="?attr/larus_dp_44"
                    android:layout_height="?attr/larus_dp_44"
                    android:src="@drawable/larus_ic_flow_edit_complete"
                    android:scaleType="centerInside"/>
            </FrameLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/doc_title_view"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/doc_titlebar_sounds_ani"
                app:layout_constraintStart_toEndOf="@+id/doc_titlebar_left_icon_container"
                app:layout_constraintTop_toTopOf="parent">
                <com.larus.bmhome.chat.layout.widget.ShimmerTextView
                    android:textSize="?attr/larus_sp_15"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:id="@+id/doc_titlebar_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="?attr/larus_sp_11"
                    android:textColor="@color/neutral_50"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:id="@+id/doc_titlebar_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_1"
                    android:maxLines="1"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/doc_titlebar_more"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_44"
                android:src="@drawable/larus_ic_bot_setting"
                android:scaleType="centerInside"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/larus_neutral_30"/>
            <ImageView
                android:id="@+id/doc_titlebar_export_doc"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_44"
                android:src="@drawable/larus_doc_ic_export_doc"
                android:scaleType="centerInside"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/doc_titlebar_more"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/doc_titlebar_copy"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_44"
                android:src="@drawable/larus_docbiz_ic_doc_copy_all"
                android:scaleType="centerInside"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/doc_titlebar_export_doc"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/doc_titlebar_edit"
                android:visibility="gone"
                android:layout_width="@dimen/dp_44"
                android:layout_height="@dimen/dp_44"
                android:src="@drawable/larus_doc_ic_edit"
                android:scaleType="centerInside"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/doc_titlebar_export_doc"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/doc_titlebar_redo"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_44"
                android:src="@drawable/larus_ic_flow_redo_default"
                android:scaleType="centerInside"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/doc_titlebar_copy"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/doc_titlebar_undo"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_44"
                android:src="@drawable/larus_ic_flow_undo_default"
                android:scaleType="centerInside"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/doc_titlebar_redo"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.lynx.lottieadapter.LottieAdapterView
                android:id="@+id/doc_titlebar_sounds_ani"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_44"
                android:scaleType="centerInside"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/doc_titlebar_undo"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.larus.bmhome.view.NovaTitleBarEx
            android:id="@+id/docs_titlebar_history"
            android:background="@color/larus_base_1"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_60"/>
    </FrameLayout>
    <com.larus.doc.impl.view.InterceptTouchFrameLayout
        android:id="@+id/doc_fragment_container"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/docs_titlebar_container"/>
    <View
        android:id="@+id/chat_input_bg_mask"
        android:background="@color/larus_neutral_transparent_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.office.base.view.TextLoadingView
        android:id="@+id/loading_text"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/doc_chat_input_container"
        app:layout_constraintStart_toStartOf="parent"
        app:tlv_loadingIconRes="@drawable/larus_common_ui_office_loading_dot"
        app:tlv_text="@string/larus_thinking_state"
        app:tlv_textColor="@color/larus_neutral_100"
        app:tlv_text_weight="400"/>
    <ViewStub
        android:id="@+id/doc_operation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/doc_chat_input_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.larus.doc.impl.view.InterceptTouchFrameLayout
        android:id="@+id/doc_chat_input_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.larus.office.base.view.DocLoadAndErrorLayout
        android:id="@+id/doc_loading_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/doc_fragment_container"/>
    <FrameLayout
        android:id="@+id/docs_full_screen_video_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/doc_no_permission_fragment_container"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/docs_titlebar_container"/>
    <View
        android:id="@+id/full_screen_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
