<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_80">
    <ImageView
        android:id="@+id/larus_drive_upload_item_icon"
        android:layout_width="?attr/larus_dp_48"
        android:layout_height="?attr/larus_dp_48"
        android:src="@drawable/larus_ud_icon_file_docx_colorful"
        android:contentDescription="@null"
        android:layout_marginStart="?attr/larus_dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/larus_drive_upload_item_file_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_39"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/larus_drive_upload_item_status_remove"
        app:layout_constraintStart_toEndOf="@+id/larus_drive_upload_item_icon"/>
    <TextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="@color/larus_neutral_50"
        android:id="@+id/larus_drive_upload_item_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_43"
        android:includeFontPadding="false"
        app:layout_constraintStart_toStartOf="@+id/larus_drive_upload_item_file_name"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/larus_drive_upload_item_status_remove"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:src="@drawable/larus_ic_drive_upload_item_remove"
        android:contentDescription="@null"
        android:layout_marginEnd="?attr/larus_dp_18"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/larus_drive_upload_item_status_retry"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:src="@drawable/larus_ic_drive_upload_item_retry"
        android:contentDescription="@null"
        android:layout_marginEnd="?attr/larus_dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/larus_drive_upload_item_status_remove"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
