<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/dora_o_bg_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.dora.o.impl.diary.week.OWeekCalendarBar
        android:id="@+id/week_bar"
        android:paddingTop="?attr/larus_dp_112"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/permission_tips"
        android:background="@drawable/dora_o_bg_permission_tips"
        android:paddingTop="?attr/larus_dp_16"
        android:paddingBottom="?attr/larus_dp_12"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_12"
        android:layout_marginStart="?attr/larus_dp_20"
        android:layout_marginEnd="?attr/larus_dp_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/week_bar">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="?attr/larus_dp_21"
                android:layout_height="?attr/larus_dp_21"
                android:src="@drawable/dora_o_ic_info_circle"
                android:importantForAccessibility="no"/>
            <TextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/dora_o_text_secondary"
                android:layout_width="?attr/larus_dp_0"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_o_diary_permission_tips"
                android:layout_weight="1"
                android:layout_marginStart="?attr/larus_dp_8"/>
        </LinearLayout>
        <com.obric.oui.button.OButtonLink
            android:layout_gravity="end"
            android:id="@+id/permission_tips_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_8"
            app:oui_widgetText="@string/larus_dora_ai_active_task_env_memory_off_banner_button_cn"
            style="@style/OStyleV2.OButtonLink.S.Default"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/detail_container"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0"
        android:layout_marginTop="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/permission_tips">
        <TextView
            android:textSize="?attr/larus_sp_15"
            android:textColor="@color/dora_o_text_secondary"
            android:layout_gravity="center"
            android:id="@+id/detail_empty_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_personal_diary_calendar_view_history_toast_cn"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/detail_loading"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_32"
            android:layout_height="?attr/larus_dp_32"/>
    </FrameLayout>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/content_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</androidx.constraintlayout.widget.ConstraintLayout>
