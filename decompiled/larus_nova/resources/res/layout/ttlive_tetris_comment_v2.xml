<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.widget.opt.MeasureOptFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.livesdk.widget.PublicScreenEdgeTransparentView
            android:gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/message_view_container"
            android:clipChildren="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ttlive_portrait_text_message_region_height"
            android:layout_marginRight="@dimen/ttlive_text_message_view_dynamic_padding_right"
            android:layout_marginBottom="@dimen/ttlive_text_message_widget_bottom_margin"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="@dimen/ttlive_text_message_view_dynamic_padding_right">
            <com.bytedance.android.livesdk.interactivity.api.publicscreen.viewpager.PublicScreenAreaPagerLayout
                android:id="@+id/public_screen_area_pager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:importantForAccessibility="no"/>
            <com.bytedance.android.livesdk.interactivity.api.publicscreen.viewpager.PublicScreenAreaPagerIndicatorV2
                android:id="@+id/pager_tab_v2"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ttlive_public_screen_indicator_height"
                android:layout_marginTop="@dimen/ttlive_public_screen_indicator_margin_top"
                android:layout_marginStart="@dimen/ttlive_message_container_margin_right"/>
        </com.bytedance.android.livesdk.widget.PublicScreenEdgeTransparentView>
        <FrameLayout
            android:id="@+id/hot_msg_view_container"
            android:paddingTop="4dp"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/message_view_container"
            android:layout_marginStart="12dp"/>
        <FrameLayout
            android:id="@+id/welfare_project_card_container"
            android:visibility="gone"
            android:layout_width="260dp"
            android:layout_height="115dp"
            android:layout_marginBottom="@dimen/ttlive_text_message_widget_bottom_margin"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/ttlive_message_container_margin_right"/>
    </RelativeLayout>
</com.bytedance.android.livesdk.widget.opt.MeasureOptFrameLayout>
