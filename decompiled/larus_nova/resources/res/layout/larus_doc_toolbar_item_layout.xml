<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="36dp">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/toolbar_item_lottie"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_16"
        android:layout_height="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"/>
    <ImageView
        android:id="@+id/toolbar_item_icon"
        android:layout_width="?attr/larus_dp_16"
        android:layout_height="?attr/larus_dp_16"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/toolbar_item_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"/>
</LinearLayout>
