<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/room_center_button_layout"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="40dp">
    <Button
        android:textSize="16dp"
        android:textColor="@color/gamecp_room_center_btn_text_black"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/room_center_button_left"
        android:background="@color/gamecp_white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:lines="1"
        android:layout_weight="1"
        android:textAllCaps="false"/>
    <View
        android:id="@+id/middle_btn_line"
        android:background="#1e161823"
        android:layout_width="0.5dp"
        android:layout_height="match_parent"/>
    <Button
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/gamecp_room_center_btn_text_black"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/room_center_button_middle"
        android:background="@color/gamecp_white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:lines="1"
        android:layout_weight="1"
        android:textAllCaps="false"/>
    <View
        android:background="#1e161823"
        android:layout_width="0.5dp"
        android:layout_height="match_parent"/>
    <Button
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/gamecp_room_center_btn_text_black"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/room_center_button_right"
        android:background="@color/gamecp_white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:lines="1"
        android:layout_weight="1"
        android:textAllCaps="false"/>
</LinearLayout>
