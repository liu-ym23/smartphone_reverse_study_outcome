<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/cl_container"
    android:background="@drawable/ttlive_bg_share_guide"
    android:paddingLeft="@dimen/ttlive_guide_share_padding_horizontal"
    android:paddingTop="@dimen/ttlive_guide_share_padding_top"
    android:paddingRight="@dimen/ttlive_guide_share_padding_horizontal"
    android:layout_width="match_parent"
    android:layout_height="114dp">
    <ImageView
        android:id="@+id/iv_fans"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ttlive_ic_fans"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/ttlive_guide_share_title"
        android:textStyle="bold"
        android:textColor="#161823"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintLeft_toRightOf="@+id/iv_fans"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/ttlive_guide_share_content"
        android:textColor="#7f161823"
        android:id="@+id/tv_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintLeft_toLeftOf="@+id/tv_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <TextView
        android:textSize="@dimen/ttlive_guide_share_content"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/btn"
        android:background="@drawable/ttlive_bg_share_guide_btn"
        android:layout_width="63dp"
        android:layout_height="28dp"
        android:layout_marginTop="8dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
