<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:background="@null"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/card_live_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:placeholderImage="@drawable/ttlive_feed_cover_loading"
        app:placeholderImageScaleType="fitXY"
        app:roundedCornerRadius="@dimen/ttlive_dimen_feed_img_corner_radius"/>
    <TextView
        android:textSize="11dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_feed_open_d2_75"
        android:gravity="center"
        android:id="@+id/tv_douyin_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginRight="6dp"
        android:text="@string/ttlive_feed_title_tag"
        android:shadowColor="@color/ttlive_feed_open_d2_74"
        android:shadowRadius="4"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="6dp"
        android:layout_alignParentEnd="true"/>
    <View
        android:id="@+id/card_content_mask"
        android:background="@drawable/ttlive_bg_live_feed_small"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignLeft="@+id/live_cover"
        android:layout_alignRight="@+id/card_live_cover"
        android:layout_alignBottom="@+id/card_live_cover"
        android:layout_alignStart="@+id/live_cover"
        android:layout_alignEnd="@+id/live_cover"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/card_room_label"
        android:visibility="gone"
        android:layout_width="65dp"
        android:layout_height="20dp"
        android:layout_marginLeft="@dimen/ttlive_feed_live_lable_margin_left"
        android:layout_marginTop="@dimen/ttlive_feed_live_lable_margin_top"
        android:scaleType="centerInside"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/ttlive_feed_live_lable_margin_left"
        android:layout_alignParentStart="true"
        app:roundBottomLeft="false"
        app:roundBottomRight="false"
        app:roundTopLeft="true"
        app:roundTopRight="false"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/ttlive_feed_live_content_margin_left"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/ttlive_feed_live_content_margin_left">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/card_room_content_label"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginBottom="4dp"/>
        <LinearLayout
            android:id="@+id/locate_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/card_iv_locate"
                android:layout_width="10dp"
                android:layout_height="11dp"
                android:src="@drawable/ttlive_ic_locate"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/card_locate"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginLeft="4dp"
                android:text="@string/ttlive_feed_mars"
                android:singleLine="true"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/ttlive_feed_live_title_text_size"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/card_title"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ttlive_feed_live_title_height"
            android:maxEms="10"
            android:singleLine="true"/>
        <com.bytedance.android.live.core.widget.CustomFontTextView
            android:textSize="@dimen/ttlive_feed_live_audience_count_text_size"
            android:textColor="@color/ttlive_feed_audience_count_color"
            android:gravity="center_vertical"
            android:id="@+id/card_audience_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text="@string/ttlive_feed_live_feed_count_0"
            android:singleLine="true"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/surface_container"
        android:visibility="gone"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
