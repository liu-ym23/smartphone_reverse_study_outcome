<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/intent_card_container"
    android:background="@drawable/intent_card_bg_light"
    android:paddingTop="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/logo"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginRight="6dp"
        android:layout_marginBottom="12dp"
        android:src="@drawable/weather_logo"
        android:layout_marginStart="16dp"/>
    <TextView
        android:textColor="@color/assistant_card_neutral_70"
        android:gravity="center_vertical"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/weather_app_name"
        android:layout_alignTop="@+id/logo"
        android:layout_alignBottom="@+id/logo"
        android:layout_toEndOf="@+id/logo"
        style="@style/Label_M_Thin"/>
    <FrameLayout
        android:id="@+id/divider"
        android:background="@color/assistant_card_neutral_transparent_1"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_below="@+id/logo"/>
    <TextView
        android:textColor="@color/assistant_card_neutral_50"
        android:gravity="center_vertical"
        android:id="@+id/sub_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:includeFontPadding="false"
        android:layout_below="@+id/divider"
        android:layout_marginStart="16dp"
        style="@style/Label_M"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/sun_info_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:baselineAligned="false"
        android:layout_below="@+id/sub_info">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/sunrise_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">
            <ImageView
                android:id="@+id/sunrise_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp">
                <TextView
                    android:textColor="@color/assistant_card_neutral_100"
                    android:id="@+id/sunrise_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    style="@style/Title_Title_M"/>
                <TextView
                    android:textColor="@color/assistant_card_neutral_50"
                    android:id="@+id/sunrise_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    style="@style/Label_M"/>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/sun_divider"
            android:background="@color/assistant_card_neutral_transparent_2"
            android:layout_width="1dp"
            android:layout_height="24dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/sunset_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">
            <ImageView
                android:id="@+id/sunset_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp">
                <TextView
                    android:textColor="@color/assistant_card_neutral_100"
                    android:id="@+id/sunset_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    style="@style/Title_Title_M"/>
                <TextView
                    android:textColor="@color/assistant_card_neutral_50"
                    android:id="@+id/sunset_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    style="@style/Label_M"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
