<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.ee.bear.facade.common.widget.recyclerview.SwipeMenuLayout
        android:id="@+id/swipe_menu_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@color/bg_float"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/custom_content_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/operation_area"
                android:layout_width="@dimen/space_kit_len_52"
                android:layout_height="match_parent"
                android:tint="@color/bitable_option_edit_icon_color"
                android:paddingStart="@dimen/space_kit_len_16"
                android:paddingEnd="@dimen/space_kit_len_16"
                app:srcCompat="@drawable/ud_icon_menu_outlined"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/delete_menu"
            android:background="@color/colorful_red"
            android:layout_width="@dimen/space_kit_len_56"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:layout_width="@dimen/space_kit_len_20"
                android:layout_height="@dimen/space_kit_len_20"
                android:tint="@color/static_white"
                app:srcCompat="@drawable/ud_icon_delete_trash_outlined"/>
        </FrameLayout>
    </com.bytedance.ee.bear.facade.common.widget.recyclerview.SwipeMenuLayout>
    <FrameLayout
        android:id="@+id/divider"
        android:background="@color/bg_float"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_kit_len_divider">
        <View
            android:background="@color/line_divider_default"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_kit_len_16"/>
    </FrameLayout>
    <View
        android:id="@+id/bottom_shadow"
        android:background="@drawable/bitable_option_item_shadow"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_kit_len_6"/>
</merge>
