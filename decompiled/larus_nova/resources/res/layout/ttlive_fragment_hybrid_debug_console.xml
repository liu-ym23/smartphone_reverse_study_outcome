<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/back"
        android:background="@drawable/ttlive_ic_btn_back"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/debug_title"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/ttlive_jsb_callback_info"
        app:layout_constraintStart_toStartOf="@+id/back"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/split_line"
        android:background="@color/ttlive_std_line_black_1"
        android:layout_width="match_parent"
        android:layout_height="0.6dp"
        app:layout_constraintTop_toBottomOf="@+id/debug_title"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/hybrid_debug_console_info_rv"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/split_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>
