<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_interact_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15dp"
        android:textColor="#161823"
        android:layout_gravity="center_horizontal"
        android:id="@+id/invite_description_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/ttlive_talk_room_c_position_anchor_invite_title"/>
    <View
        android:background="#1a161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="17.5dp"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/invite_icon_video_img"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="134dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/invite_icon_audio_img"
        android:visibility="gone"
        android:layout_width="178dp"
        android:layout_height="158dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <TextView
            android:textSize="15dp"
            android:textColor="#161823"
            android:gravity="center"
            android:id="@+id/refuse"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#fe2c55"
            android:gravity="center"
            android:id="@+id/accept"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/ttlive_live_interact_accept"
            android:layout_weight="1"/>
        <View
            android:background="#1a161823"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"/>
    </LinearLayout>
</LinearLayout>
