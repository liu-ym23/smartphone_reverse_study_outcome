<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.widget.NoInterceptNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:background="@drawable/ttlive_bg_broadcast_more_action"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ttlive_white_50"
            android:id="@+id/tvInteractionAbilities"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginStart="16dp"/>
        <GridLayout
            android:orientation="horizontal"
            android:id="@+id/glInteractionAbilities"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:columnCount="4"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ttlive_white_50"
            android:id="@+id/tvLiveTools"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="17dp"
            android:layout_marginStart="16dp"/>
        <GridLayout
            android:id="@+id/glLiveTools"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:columnCount="4"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ttlive_white_50"
            android:id="@+id/tvFundamentalAbilities"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="17dp"
            android:layout_marginStart="16dp"/>
        <GridLayout
            android:id="@+id/glFundamentalAbilities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:columnCount="4"/>
    </LinearLayout>
</com.bytedance.android.livesdk.widget.NoInterceptNestedScrollView>
