<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/comment_blur_iv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:placeholderImageScaleType="centerCrop"/>
    <View
        android:background="@color/shopping_deepfeed_comment_bg_color"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/deep_feed_comment_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16dp"
            android:textStyle="italic|bold"
            android:textColor="#282828"
            android:ellipsize="end"
            android:id="@+id/tv_comment_title"
            android:background="@drawable/shopping_deep_feed_comment_tab_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingStart="10dp"/>
        <com.bytedance.android.shopping.deepfeed.ui.view.CommentItemView
            android:id="@+id/comment_content_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/layout_image_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/iv_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:actualImageScaleType="centerCrop"
                app:placeholderImage="@drawable/product_deep_feed_placeholder_skeleton"
                app:placeholderImageScaleType="centerCrop"
                app:roundedCornerRadius="12dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_right_container"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/iv_right_up"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    app:actualImageScaleType="centerCrop"
                    app:placeholderImage="@drawable/product_deep_feed_placeholder_skeleton"
                    app:placeholderImageScaleType="centerCrop"
                    app:roundedCornerRadius="12dp"/>
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/iv_right_down"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    app:actualImageScaleType="centerCrop"
                    app:placeholderImage="@drawable/product_deep_feed_placeholder_skeleton"
                    app:placeholderImageScaleType="centerCrop"
                    app:roundedCornerRadius="12dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/impression_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <TextView
                android:textSize="14dp"
                android:textColor="#b2ffffff"
                android:id="@+id/comment_impression_prefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="多人评价："/>
            <com.bytedance.android.shopping.deepfeed.ui.view.DeepFeedMaskTextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#ffffffff"
                android:id="@+id/tv_impression_words"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:ec_mask_enabled="true"/>
            <com.bytedance.android.shopping.deepfeed.ui.view.AdapterScreenImageView
                android:layout_gravity="center"
                android:id="@+id/deep_feed_comment_tab_impression_arrow"
                android:visibility="gone"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/shopping_deep_feed_comment_more_arrow"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
