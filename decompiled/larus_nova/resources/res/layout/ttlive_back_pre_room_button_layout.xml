<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_back_pre_room_button"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/back_pre_iv"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="4dp"
        android:src="@drawable/ttlive_ic_btn_back_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/back_pre_desc_tv"
        app:layout_constraintLeft_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_white"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/back_pre_desc_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_common_page_back"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/back_pre_iv"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/user_avatar"
        android:background="@drawable/ttlive_bg_broadcaster_circle_head"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="2dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/back_pre_desc_tv"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_ic_default_head_small"
        app:roundAsCircle="true"/>
    <com.bytedance.android.livesdk.widget.CircleProgressView
        android:layout_gravity="center_vertical"
        android:id="@+id/circle_progress_view"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:layout_centerVertical="true"
        app:layout_constraintBottom_toBottomOf="@+id/user_avatar"
        app:layout_constraintLeft_toLeftOf="@+id/user_avatar"
        app:layout_constraintRight_toRightOf="@+id/user_avatar"
        app:layout_constraintTop_toTopOf="@+id/user_avatar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
