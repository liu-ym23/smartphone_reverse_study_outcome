<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:ptr="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.lark.ui.CommonTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.larksuite.component.universe_design.emptystate.UDEmptyState
        android:id="@+id/empty_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="100dp"
        ptr:ud_empty_desc="@string/app_name"
        ptr:ud_empty_imageRes="@drawable/illustration_empty_positive_im_default"
        style="@style/UDEmptyState"/>
    <com.ss.android.lark.widget.ptr.LKUIPtrClassicFrameLayout
        android:id="@+id/pull_to_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        ptr:lkui_ptr_duration_to_close_either="200"
        ptr:lkui_ptr_keep_header_when_refresh="true"
        ptr:lkui_ptr_mode="loadMore"
        ptr:lkui_ptr_pull_to_fresh="false"
        ptr:lkui_ptr_ratio_of_header_height_to_refresh="0.5"
        ptr:lkui_ptr_resistance="1.7">
        <com.ss.android.lark.widget.recyclerview.CommonRecyclerView
            android:id="@+id/member_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.ss.android.lark.widget.ptr.LKUIPtrClassicFrameLayout>
</LinearLayout>
