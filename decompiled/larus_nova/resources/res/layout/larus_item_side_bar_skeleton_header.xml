<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_40"
    android:paddingStart="?attr/larus_dp_14"
    android:paddingEnd="?attr/larus_dp_4">
    <TextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="?attr/larus_neutral_50"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/skeleton_group_title"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintEnd_toStartOf="@+id/skeleton_group_more"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/skeleton_group_more"
        android:padding="?attr/larus_dp_9"
        android:layout_width="?attr/larus_dp_36"
        android:layout_height="?attr/larus_dp_36"
        android:src="?attr/larus_ic_more_gray"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/larus_neutral_30"/>
</androidx.constraintlayout.widget.ConstraintLayout>
