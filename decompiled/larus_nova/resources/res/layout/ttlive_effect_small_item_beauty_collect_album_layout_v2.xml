<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@color/black"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/ttlive_effect_beauty_common_list_item_height">
    <View
        android:background="@drawable/ttlive_effect_sub_small_beauty_item_indicator"
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="61dp"
        android:layout_marginRight="20dp"/>
    <FrameLayout
        android:paddingTop="@dimen/ttlive_effect_beauty_common_list_item_padding"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ttlive_effect_beauty_common_list_item_height">
        <ImageView
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/sub_beauty_item_back"
            android:background="@drawable/ttlive_effect_sub_small_beauty_item_fold"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="27dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#ffffffff"
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/sub_beauty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="66dp"
            android:lines="1"/>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="center_vertical"
        android:id="@+id/sub_beauty_list"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ttlive_effect_beauty_common_list_item_height"/>
    <View
        android:background="@drawable/ttlive_effect_sub_small_beauty_item_indicator"
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="61dp"
        android:layout_marginRight="20dp"/>
</LinearLayout>
