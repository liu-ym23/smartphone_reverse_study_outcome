<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="11sp"
        android:textColor="#ffffff"
        android:gravity="center_vertical"
        android:id="@+id/left_text_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginRight="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/left_tag_view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginRight="4dp"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#ffffff"
        android:gravity="center_vertical"
        android:id="@+id/left_tag_view"
        android:background="@drawable/ttlive_game_bg_t01_tag"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginTop="7dp"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintRight_toLeftOf="@+id/mid_divider_view"/>
    <View
        android:id="@+id/mid_divider_view"
        android:background="@color/white"
        android:layout_width="0.6dp"
        android:layout_height="10dp"
        android:layout_marginTop="1dp"
        android:layout_marginRight="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/right_text_view"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="11sp"
        android:textColor="#ffffff"
        android:gravity="center_vertical"
        android:id="@+id/right_text_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginRight="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/right_tag_view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginRight="12dp"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#ffffff"
        android:gravity="center_vertical"
        android:id="@+id/right_tag_view"
        android:background="@drawable/ttlive_game_bg_t01_tag"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginTop="7dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
