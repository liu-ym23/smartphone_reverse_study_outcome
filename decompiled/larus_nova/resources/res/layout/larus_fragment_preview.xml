<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/media_preview_viewpager"
        android:background="@color/larus_static_black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/media_preview_background"
        android:background="#cd252525"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/media_preview_indicator_checkbox"
        android:background="@drawable/larus_tools_media_import_bg_image_select"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:button="@null"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/media_preview_background"
        app:layout_constraintStart_toStartOf="@+id/media_preview_background"
        app:layout_constraintTop_toTopOf="@+id/media_preview_background"
        style="@style/tools_font_size_24"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:id="@+id/media_preview_indicator_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_album_select_btn"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/media_preview_background"
        app:layout_constraintStart_toEndOf="@+id/media_preview_indicator_checkbox"
        app:layout_constraintTop_toTopOf="@+id/media_preview_background"
        style="@style/tools_font_size_30"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/media_preview_confirm"
        android:background="?attr/larus_tools_media_import_preview_selector_next_step_bg"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:text="@string/larus_album_next_btn"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/media_preview_background"
        app:layout_constraintEnd_toEndOf="@+id/media_preview_background"
        app:layout_constraintTop_toTopOf="@+id/media_preview_background"
        style="@style/tools_font_size_30"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/media_preview_bottom_selector_list"
        android:background="#cd252525"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="6dp"
        app:layout_constraintBottom_toTopOf="@+id/media_preview_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/media_preview_top_mask"
        android:background="@drawable/larus_tools_media_import_preview_top_mask"
        android:layout_width="0dp"
        android:layout_height="120dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/media_preview_top_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="48dp"
        android:src="?attr/larus_ic_left_back"
        android:tint="@color/larus_static_white"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/larus_BtnPreviewBack"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/media_preview_top_original_image_container"
        android:paddingTop="?attr/larus_dp_2"
        android:paddingBottom="?attr/larus_dp_2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/media_preview_top_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/media_preview_top_back">
        <ImageView
            android:id="@+id/media_preview_top_original_image_checkbox"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:src="@drawable/larus_ic_checkbox_original_image_white"
            android:layout_marginEnd="?attr/larus_dp_6"/>
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/larus_static_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_IM_image_radioButton_original"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
