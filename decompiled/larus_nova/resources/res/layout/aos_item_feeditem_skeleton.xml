<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.awemeopen.apps.framework.feed.pages.recommend.GestureFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <View
            android:id="@+id/skeleton_title"
            android:background="#242424"
            android:layout_width="60dp"
            android:layout_height="16dp"
            android:layout_marginBottom="16dp"
            android:layout_above="@+id/skeleton_desc_line1"/>
        <View
            android:id="@+id/skeleton_desc_line1"
            android:background="#242424"
            android:layout_width="283dp"
            android:layout_height="18dp"
            android:layout_marginBottom="8dp"
            android:layout_above="@+id/skeleton_desc_line2"/>
        <View
            android:id="@+id/skeleton_desc_line2"
            android:background="#242424"
            android:layout_width="201dp"
            android:layout_height="18dp"
            android:layout_marginBottom="26dp"
            android:layout_above="@+id/skeleton_comment_entry"/>
        <View
            android:id="@+id/skeleton_comment_entry"
            android:background="@drawable/aos_feed_item_comment_skeleton_bg"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginBottom="20dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</com.bytedance.awemeopen.apps.framework.feed.pages.recommend.GestureFrameLayout>
