<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/bubble_banner_wrapper"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larus.common_ui.venus.ShapeLinearLayout
        android:orientation="vertical"
        android:id="@+id/bubble_banner_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:larus_sc_cornerRadius="?attr/larus_dp_16"
        app:larus_sc_fillColor="?attr/larus_bg_base_5"
        app:larus_sc_shadow_blur_radius="?attr/larus_dp_12"
        app:larus_sc_shadow_color="@color/larus_neutral_transparent_1"
        app:larus_sc_shadow_layout_mode="content_box">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/bubble_banner_content_row"
            android:paddingTop="?attr/larus_dp_16"
            android:paddingBottom="?attr/larus_dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/larus_dp_68"
            android:paddingStart="?attr/larus_dp_16"
            android:paddingEnd="?attr/larus_dp_12">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/bubble_banner_icon"
                android:layout_width="?attr/larus_dp_36"
                android:layout_height="?attr/larus_dp_36"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/bubble_banner_text_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="?attr/larus_dp_36"
                android:layout_weight="1"
                android:layout_marginStart="?attr/larus_dp_12"
                android:layout_marginEnd="?attr/larus_dp_8">
                <TextView
                    android:textSize="?attr/larus_sp_16"
                    android:textColor="?attr/larus_neutral_100"
                    android:ellipsize="end"
                    android:id="@+id/bubble_banner_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:textSize="?attr/larus_sp_12"
                    android:textColor="?attr/larus_neutral_70"
                    android:ellipsize="end"
                    android:id="@+id/bubble_banner_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_2"
                    android:maxLines="2"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/bubble_banner_right_actions"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <com.larus.common_ui.venus.ShapeLinearLayout
                    android:gravity="center"
                    android:id="@+id/bubble_banner_cta_container"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="?attr/larus_dp_32"
                    android:minWidth="?attr/larus_dp_52"
                    android:paddingStart="?attr/larus_dp_12"
                    android:paddingEnd="?attr/larus_dp_12"
                    app:larus_sc_cornerRadius="?attr/larus_dp_16"
                    app:larus_sc_fillColor="?attr/larus_primary_transparent_1">
                    <TextView
                        android:textSize="?attr/larus_sp_14"
                        android:textColor="?attr/larus_primary_50"
                        android:id="@+id/bubble_banner_cta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium"/>
                </com.larus.common_ui.venus.ShapeLinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.larus.common_ui.venus.ShapeLinearLayout>
</LinearLayout>
