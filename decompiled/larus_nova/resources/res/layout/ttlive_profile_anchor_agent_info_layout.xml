<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_anchor_agent_info_layout"
    android:background="@color/transparent"
    android:layout_width="140dp"
    android:layout_height="140dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/profile_anchor_agent_info_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/profile_anchor_agent_info_content"
        android:background="@drawable/ttlive_bg_profile_anchor_agent_info_text"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
