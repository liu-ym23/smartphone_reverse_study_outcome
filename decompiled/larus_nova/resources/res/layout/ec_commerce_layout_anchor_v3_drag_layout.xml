<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.shopping.legacy.DragRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_commerce_layout_anchor_v3_drag_layout_2039552167"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="70dp"
    app:dock_margin_left="10dp"
    app:dock_margin_right="10dp"
    app:dock_mode="left_right">
    <com.bytedance.android.ec.core.widget.RoundedRelativeLayout
        android:id="@+id/anchor_v3_out_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginRight="16dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"
        app:rounded_radius="4dp">
        <FrameLayout
            android:id="@+id/anchor_v3_video_wrapper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/anchor_v3_little_video_float_video_close"
            android:padding="6dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/anchor_v3_little_video_icon_close"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:contentDescription="@string/shopping_tip_close"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:id="@+id/anchor_v3_little_video_audio_status_icon"
            android:padding="6dp"
            android:layout_width="33dp"
            android:layout_height="33dp"
            android:src="@drawable/anchor_v3_little_video_icon_audio_on"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:id="@+id/anchor_v3_little_video_play_status_icon"
            android:padding="6dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginBottom="1.5dp"
            android:src="@drawable/anchor_v3_hao_wu_video_pause"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"/>
        <com.bytedance.android.ec.core.widget.LayoutImmuneTextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:id="@+id/anchor_v3_little_video_time_span"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="-4dp"
            android:layout_marginBottom="9dp"
            android:layout_toRightOf="@+id/anchor_v3_little_video_play_status_icon"
            android:layout_alignParentBottom="true"/>
    </com.bytedance.android.ec.core.widget.RoundedRelativeLayout>
</com.bytedance.android.shopping.legacy.DragRelativeLayout>
