<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/open_card_menu_item"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <com.larksuite.component.ui.imageview.LKUIRoundedImageView2
            android:id="@+id/ud_dialog_icon"
            android:visibility="gone"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_4"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/text_title"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/ud_dialog_content_item_tv"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:singleLine="true"/>
    </LinearLayout>
    <com.larksuite.component.universe_design.checkbox.UDCheckBox
        android:layout_gravity="end|center_vertical"
        android:id="@+id/ud_dialog_content_item_cb"
        android:padding="0dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:ud_checkbox_size="small"
        app:ud_checkbox_type="check_mark"/>
</FrameLayout>
