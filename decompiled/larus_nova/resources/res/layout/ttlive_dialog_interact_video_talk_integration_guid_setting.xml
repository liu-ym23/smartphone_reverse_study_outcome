<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/outside"
        android:background="#57000000"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/setting_content"
        android:background="@drawable/ttlive_bg_interact_dialog"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/video_talk_room_setting_title"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="@string/ttlive_interact_switch_layout"/>
        <View
            android:background="#1a161823"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/iv_guide_res"
            android:layout_width="112dp"
            android:layout_height="212dp"
            android:layout_marginTop="12dp"
            app:roundedCornerRadius="4dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_layout_switch"
            android:layout_width="match_parent"
            android:layout_height="77dp">
            <ImageView
                android:id="@+id/iv_video_camera_layout"
                android:background="@drawable/ttlive_video_talk_switch_scene_selected_bg"
                android:paddingLeft="3dp"
                android:paddingTop="3dp"
                android:paddingRight="3dp"
                android:paddingBottom="3dp"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginLeft="13dp"
                android:src="@drawable/ttlive_video_talk_camera_layout_setting_bg"
                android:scaleType="fitXY"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:layout_marginStart="13dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/iv_equal_talkroom_layout"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_camera_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/iv_video_camera_layout"
                app:layout_constraintStart_toStartOf="@+id/iv_video_camera_layout"
                app:layout_constraintTop_toTopOf="@+id/iv_video_camera_layout">
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="9dp"
                    android:src="@drawable/ttlive_video_camera_layout_icon"
                    android:layout_marginStart="9dp"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="@string/ttlive_interact_video_talk_layout"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/iv_equal_talkroom_layout"
                android:background="@drawable/ttlive_video_talk_switch_scene_selected_bg"
                android:paddingLeft="3dp"
                android:paddingTop="3dp"
                android:paddingRight="3dp"
                android:paddingBottom="3dp"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="13dp"
                android:src="@drawable/ttlive_video_talk_equal_layout_setting_bg"
                android:scaleType="fitXY"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="13dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/iv_video_camera_layout"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_equal_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/iv_equal_talkroom_layout"
                app:layout_constraintStart_toStartOf="@+id/iv_equal_talkroom_layout"
                app:layout_constraintTop_toTopOf="@+id/iv_equal_talkroom_layout">
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginLeft="9dp"
                    android:src="@drawable/ttlive_equal_talkroom_layout_icon"
                    android:layout_marginStart="9dp"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="@string/ttlive_interact_equal_talk_layout"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:id="@+id/fl_dynamic_window"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <TextView
                android:textSize="15dp"
                android:textColor="@color/black"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/tv_dynamic_window"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="@string/ttlive_interact_dynamic_window_text"
                android:layout_marginStart="20dp"/>
            <Switch
                android:layout_gravity="end|center_vertical"
                android:id="@+id/switch_dynamic_window"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginRight="16dp"
                android:checked="true"
                android:textOn=""
                android:textOff=""
                android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
                android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
                android:layout_marginEnd="16dp"/>
        </FrameLayout>
        <Button
            android:textSize="14dp"
            android:textColor="@color/white"
            android:id="@+id/btn_ok"
            android:background="@drawable/ttlive_interact_bg_pk_cancel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="20dp"
            android:text="@string/ttlive_ok"
            android:height="44dp"/>
    </LinearLayout>
</LinearLayout>
