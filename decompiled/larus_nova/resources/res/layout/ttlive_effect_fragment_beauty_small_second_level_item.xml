<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.effect.beauty.smallitem.LiveBeautySecLevelSlidingTab
        android:id="@+id/broadcast_beauty_second_level_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ttlive_effect_tab_background="@color/transparent"
        app:ttlive_effect_tab_indicator_color="#ffffff"
        app:ttlive_effect_tab_indicator_height="2dp"
        app:ttlive_effect_tab_indicator_width="30dp"
        app:ttlive_effect_tab_padding_left_right="12dp"
        app:ttlive_effect_tab_scroll_offset="112dp"
        app:ttlive_effect_tab_text_color="@color/ttlive_effect_live_sticker_tab_text_color_v2"
        app:ttlive_effect_tab_text_size="13dp"
        app:ttlive_effect_tab_typeface_style="normal"
        app:ttlive_effect_tab_underline_color="#0fffffff"
        app:ttlive_effect_tab_underline_height="0.5dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/small_item_beauty_recycle_view"
        android:layout_width="0dp"
        android:layout_height="102dp"
        android:layout_marginTop="12.5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/broadcast_beauty_second_level_strip"/>
    <com.bytedance.android.live.uikit.recyclerview.LoadingStatusView
        android:id="@+id/small_item_beauty_loading_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/small_item_beauty_recycle_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
