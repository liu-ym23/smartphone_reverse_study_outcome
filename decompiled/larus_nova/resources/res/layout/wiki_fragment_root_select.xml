<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_body"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.widgets.BaseTitleBar
        android:id="@+id/wiki_root_select_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_kit_len_50"
        app:widget_widgets_tb_divider_visible="false"
        app:widget_widgets_tb_title="@string/CreationMobile_Wiki_MoveTo"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/wiki_root_select_search"
        android:background="@drawable/facade_edit_bg_shape"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_kit_len_40"
        android:layout_marginLeft="@dimen/dp_8"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_marginRight="@dimen/space_kit_len_16"
        android:layout_marginBottom="@dimen/dp_4">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:layout_width="@dimen/space_kit_len_16"
            android:layout_height="@dimen/space_kit_len_16"
            android:tint="@color/icon_n3"
            android:layout_marginStart="@dimen/space_kit_len_12"
            app:srcCompat="@drawable/ud_icon_search_outlined"/>
        <TextView
            android:textSize="@dimen/space_kit_font_14"
            android:textColor="@color/text_placeholder"
            android:layout_gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Doc_Facade_Search"
            android:layout_marginStart="@dimen/space_kit_len_12"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/wiki_root_select_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
