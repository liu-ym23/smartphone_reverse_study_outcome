<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
        android:id="@+id/switch_button"
        android:layout_width="43dp"
        android:layout_height="25dp"
        app:lsb_background="#33161823"
        app:lsb_button_color="#ffffff"
        app:lsb_checked_color="@color/ttlive_setting_switch_button_color"
        app:lsb_effect_duration="50"
        app:lsb_shadow_radius="0dp"
        app:lsb_show_indicator="false"/>
    <ImageView
        android:id="@+id/loading_img"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:scaleType="fitCenter"
        android:layout_centerInParent="true"/>
</RelativeLayout>
