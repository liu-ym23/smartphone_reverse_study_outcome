<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/close_icon"
        android:padding="?attr/larus_dp_13"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/larus_binder_close_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/binder_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_40"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:paddingStart="?attr/larus_dp_28"
        android:paddingEnd="?attr/larus_dp_28"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/binder_logo_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_20">
            <View
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:id="@+id/binder_logo"
                android:layout_width="?attr/larus_dp_56"
                android:layout_height="?attr/larus_dp_56"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/has_bound_container"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <View
                    android:id="@+id/exchange_icon"
                    android:background="@drawable/larus_exchange_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="@dimen/dp_20"
                    android:layout_marginRight="@dimen/dp_20"/>
                <View
                    android:id="@+id/has_bound_logo"
                    android:layout_width="?attr/larus_dp_56"
                    android:layout_height="?attr/larus_dp_56"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="?attr/larus_dp_22"
            android:textStyle="bold"
            android:textColor="@color/larus_neutral_100"
            android:gravity="center_horizontal"
            android:id="@+id/tv_binder_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="?attr/larus_dp_15"
            android:textColor="@color/larus_neutral_70"
            android:gravity="center_horizontal"
            android:id="@+id/tv_binder_desc"
            android:paddingTop="?attr/larus_dp_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/binder_coupon_container"
            android:background="@drawable/larus_bg_binder_coupon"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_80"
            android:layout_marginTop="?attr/larus_dp_20"
            android:paddingStart="?attr/larus_dp_8"
            android:paddingEnd="?attr/larus_dp_12">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="?attr/larus_dp_74"
                android:layout_height="?attr/larus_dp_74"
                android:paddingStart="?attr/larus_dp_4"
                android:paddingEnd="?attr/larus_dp_4"
                android:layout_marginEnd="?attr/larus_dp_4">
                <TextView
                    android:textStyle="bold"
                    android:textColor="#ff375f"
                    android:ellipsize="end"
                    android:id="@+id/tv_coupon_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true"/>
                <TextView
                    android:textSize="?attr/larus_sp_11"
                    android:textColor="#ff375f"
                    android:id="@+id/tv_coupon_threshold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <View
                android:background="@drawable/larus_coupon_line"
                android:layout_width="?attr/larus_dp_1"
                android:layout_height="?attr/larus_dp_26"/>
            <LinearLayout
                android:gravity="start|center_vertical"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingStart="?attr/larus_dp_7"
                android:paddingEnd="?attr/larus_dp_0">
                <TextView
                    android:textSize="?attr/larus_sp_15"
                    android:textStyle="bold"
                    android:textColor="@color/larus_neutral_100"
                    android:id="@+id/tv_coupon_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:textSize="?attr/larus_sp_11"
                    android:textColor="@color/larus_neutral_transparent_4"
                    android:id="@+id/tv_coupon_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_4"/>
            </LinearLayout>
        </LinearLayout>
        <Button
            android:textSize="?attr/larus_dp_16"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:id="@+id/confirm_button"
            android:background="@drawable/larus_bg_account_button_primary_50"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginTop="?attr/larus_dp_20"
            android:layout_marginBottom="?attr/larus_dp_20"
            android:fontFamily="sans-serif-medium"
            android:elevation="0dp"
            android:stateListAnimator="@null"/>
        <TextView
            android:textSize="?attr/larus_dp_15"
            android:textStyle="bold"
            android:textColor="@color/neutral_70"
            android:gravity="center_horizontal"
            android:id="@+id/cancel_button"
            android:paddingBottom="?attr/larus_dp_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_20"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="?attr/larus_dp_15"
            android:textColor="@color/larus_neutral_70"
            android:gravity="center_horizontal"
            android:id="@+id/tv_binder_bottom_desc"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_12"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
