<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/coupon_discount_prefix_wrapper"
        android:background="@drawable/ec_window_item_coupon_prefix_bg"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="1dp"
        android:paddingEnd="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="8dp"
            android:textColor="@color/ec_window_common_red"
            android:gravity="center_horizontal"
            android:id="@+id/coupon_discount_prefix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="1"/>
    </FrameLayout>
    <TextView
        android:textSize="24dp"
        android:textStyle="bold"
        android:textColor="@color/ec_window_common_red"
        android:id="@+id/coupon_discount_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/coupon_discount_prefix_wrapper"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ec_window_common_red"
        android:id="@+id/coupon_discount_suffix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10.5dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/coupon_discount_desc"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/coupon_discount_desc"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/ec_window_common_red"
        android:id="@+id/coupon_discount_extra_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/coupon_discount_suffix"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
