<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/anchor_info_container"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guide_line_stub_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.77"/>
    <View
        android:id="@+id/stub"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/guide_line_stub_bottom"
        app:layout_constraintDimensionRatio="w,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/guide_view_volume_top"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/guide_view_volume_container"
        app:layout_constraintEnd_toStartOf="@+id/guide_view_volume_container"
        app:layout_constraintHorizontal_weight="5"
        app:layout_constraintStart_toStartOf="@+id/stub"
        app:layout_constraintTop_toTopOf="@+id/stub"
        app:layout_constraintVertical_weight="5"/>
    <View
        android:id="@+id/guide_view_volume_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/guide_view_volume_bottom"
        app:layout_constraintDimensionRatio="h,1:1"
        app:layout_constraintEnd_toStartOf="@+id/guide_view_volume_bottom"
        app:layout_constraintHorizontal_weight="80"
        app:layout_constraintStart_toEndOf="@+id/guide_view_volume_top"
        app:layout_constraintTop_toBottomOf="@+id/guide_view_volume_top"
        app:layout_constraintVertical_weight="80"/>
    <View
        android:id="@+id/guide_view_volume_bottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/stub"
        app:layout_constraintEnd_toEndOf="@+id/stub"
        app:layout_constraintHorizontal_weight="5"
        app:layout_constraintStart_toEndOf="@+id/guide_view_volume_container"
        app:layout_constraintTop_toBottomOf="@+id/guide_view_volume_container"
        app:layout_constraintVertical_weight="5"/>
    <View
        android:id="@+id/guide_view_avatar_top"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintEnd_toStartOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintHorizontal_weight="15"
        app:layout_constraintStart_toStartOf="@+id/stub"
        app:layout_constraintTop_toTopOf="@+id/stub"
        app:layout_constraintVertical_weight="15"/>
    <View
        android:id="@+id/ttlive_guest_avatar_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/guide_view_avatar_bottom"
        app:layout_constraintDimensionRatio="h,1:1"
        app:layout_constraintEnd_toStartOf="@+id/guide_view_avatar_bottom"
        app:layout_constraintHorizontal_weight="60"
        app:layout_constraintStart_toEndOf="@+id/guide_view_avatar_top"
        app:layout_constraintTop_toBottomOf="@+id/guide_view_avatar_top"
        app:layout_constraintVertical_weight="60"/>
    <View
        android:id="@+id/guide_view_avatar_bottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/stub"
        app:layout_constraintEnd_toEndOf="@+id/stub"
        app:layout_constraintHorizontal_weight="15"
        app:layout_constraintStart_toEndOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintVertical_weight="15"/>
    <FrameLayout
        android:id="@+id/audio_status_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintStart_toStartOf="@+id/ttlive_guest_avatar_container">
        <com.bytedance.android.live.liveinteract.view.PositionNameTv
            android:textSize="10dp"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:id="@+id/ttlive_position_name"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:visibility="gone"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLength="4"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"/>
        <com.bytedance.android.live.liveinteract.view.SeatPosTagLabelTextView
            android:textSize="10dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/ttlive_seat_pos_tag_label"
            android:background="@drawable/ttllive_audio_talk_seat_host_label_bg"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:includeFontPadding="false"
            android:importantForAccessibility="no"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"/>
        <com.bytedance.android.live.liveinteract.view.PaidLinkCountDownView
            android:textSize="10dp"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:id="@+id/ttlive_position_count_down"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:visibility="visible"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#ffffff"
            android:gravity="center_horizontal"
            android:id="@+id/anchor_label"
            android:background="@drawable/ttlive_video_talk_c_enlarge_user_label_bg"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_interact_anchor"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
