<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/midi_score_bg"
        android:layout_width="60dp"
        android:layout_height="0dp"
        android:src="@drawable/ttlive_ktv_midi_score_bg_low"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/midi_score"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/midi_score"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="italic"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/midi_score"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:layout_width="51dp"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_ktv_score"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/midi_bg"
        android:background="@drawable/ttlive_bg_ktv_room_midi_view_v2"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/midi_score_bg"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/ktv_midi_bg"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.bytedance.android.live.ktv.common.midi.v2.KtvMidiViewV2
        android:id="@+id/midi_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <com.bytedance.android.live.ktv.common.midi.KtvMidiHitDisplayView
        android:id="@+id/hit_type_display"
        android:layout_width="150dp"
        android:layout_height="56dp"
        android:layout_marginRight="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ffffff"
        android:id="@+id/ktv_no_midi_hint"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_ktv_no_support_midi"
        app:layout_constraintBottom_toBottomOf="@+id/ktv_midi_bg"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ktv_midi_bg"/>
    <com.bytedance.android.live.ktv.common.midi.v2.KtvHitAnimationViewV2
        android:id="@+id/hit_animation"
        android:layout_width="94dp"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
