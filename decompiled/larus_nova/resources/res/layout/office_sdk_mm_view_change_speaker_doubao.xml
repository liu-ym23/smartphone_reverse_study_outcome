<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.lark.officesdk.minutes.ui.foundation.widget.titlebar.MmTitleBarView
        android:id="@+id/titleBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.ss.android.lark.officesdk.minutes.ui.foundation.widget.MmSearchInputView
        android:id="@+id/searchInputView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:debounceTime="600"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"
        app:searchCancelText="@string/MMWeb_M_CancelButton"
        app:searchHint="@string/View_UpdateSpeaker_InputName_Placeholder"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/flow_ud_neutral_50"
        android:gravity="center"
        android:id="@+id/changeSpeakerTip"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/View_UpdateSpeaker_RecordNameUpdate_Desc"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        app:layout_constraintBottom_toTopOf="@+id/changeSpeakerTip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/searchInputView">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/loadingView"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="22dp"
            android:layout_marginRight="16dp"
            app:srcCompat="@drawable/office_sdk_mm_ic_loading"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/flow_ud_neutral_70"
            android:gravity="center"
            android:id="@+id/emptyView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="22dp"
            android:layout_marginRight="16dp"
            android:text="@string/View_UpdateSpeaker_SpeakerNotMatched_Desc"/>
        <TextView
            android:textSize="14sp"
            android:gravity="center"
            android:id="@+id/errorView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="22dp"
            android:layout_marginRight="16dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/candidateList"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
