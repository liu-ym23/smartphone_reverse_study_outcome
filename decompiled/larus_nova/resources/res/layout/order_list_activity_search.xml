<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/order_list_F5F6F9"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/order_search_head_container"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/order_search_ll_header"
                android:visibility="gone"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/order_search_view_head_make_up"
                android:background="@color/order_list_F5F6F9"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/order_search_ll_header"
                app:layout_constraintTop_toBottomOf="@+id/order_search_view_head_bar"/>
            <com.bytedance.android.shopping.orderlist.common.widgets.state.OrderCommonHeadBarView
                android:id="@+id/order_search_view_head_bar"
                android:background="@color/order_list_F5F6F9"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:id="@+id/order_search_fl_body_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/order_search_ll_footer"
            app:layout_constraintTop_toBottomOf="@+id/order_search_head_container">
            <com.bytedance.android.shopping.orderlist.search.widget.linkedlist.OrderSearchResultLinkedScrollView
                android:id="@+id/order_search_linked_scroll_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.bytedance.android.shopping.orderlist.common.widgets.state.OrderCommonShopSkeletonLoadingView
                android:id="@+id/order_search_view_shop_skeleton_loading"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/order_search_ll_footer"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/order_search_fl_body_container"/>
        <com.bytedance.android.shopping.orderlist.common.widgets.state.OrderCommonMaskView
            android:id="@+id/order_search_view_mask"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/order_search_ll_footer"
            app:layout_constraintTop_toTopOf="@+id/order_search_fl_body_container"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.shopping.orderlist.common.widgets.state.OrderCommonBallLoadingView
        android:id="@+id/order_search_view_ball_loading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:layout_gravity="end|bottom"
        android:id="@+id/order_search_btn_back_to_top"
        android:background="@drawable/commerce_anchor_v4_back_to_top_btn"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="127dp"
        android:layout_marginEnd="13dp"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/debug_btn_native"
        android:background="@color/order_list_FE496A"
        android:padding="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Native"
        android:alpha="0.8"/>
</FrameLayout>
