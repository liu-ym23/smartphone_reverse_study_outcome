<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/drive_preview_page_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/banner_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <FrameLayout
                android:id="@+id/drive_tips_root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larksuite.component.universe_design.notice.UDNotice
                    android:id="@+id/drive_notice_layout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
            <com.bytedance.ee.bear.facade.common.widget.DLPRiskBannerView
                android:id="@+id/dlp_risk_banner_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.bytedance.ee.bear.facade.common.widget.ForbiddenBannerView
                android:id="@+id/forbidden_banner_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.bytedance.ee.bear.facade.common.widget.ForbiddenBannerNewView
                android:id="@+id/forbidden_banner_new_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.bytedance.ee.bear.facade.common.widget.SecretSetBannerView
                android:id="@+id/drive_secret_tips"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.bytedance.ee.bear.drive.biz.preview.banner.DriveCustomBannerContainer
                android:id="@+id/drive_custom_banner_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/drive_preview_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/banner_container"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/pluginUIContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
