<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/loading_container"
    android:background="@color/dtf_guide_transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.dtf.face.ui.widget.iOSLoadingView
        android:layout_gravity="center"
        android:id="@+id/iOSLoadingView"
        android:layout_width="30dp"
        android:layout_height="30dp"/>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/loading_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="bottom|right"
            android:id="@+id/title_back"
            android:padding="14dp"
            android:visibility="invisible"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="@mipmap/dtf_back_arrow"
            android:scaleType="centerInside"/>
        <TextView
            android:textSize="16dp"
            android:gravity="center"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/bar_title"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:text="协议内容"
            android:layout_weight="1"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/title_close"
            android:padding="14dp"
            android:visibility="invisible"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="@mipmap/dtf_face_black_close"
            android:scaleType="centerInside"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <ProgressBar
        android:id="@+id/web_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:max="100"
        style="?android:attr/progressBarStyleHorizontal"/>
    <FrameLayout
        android:id="@+id/fl_webview_container"
        android:background="#00000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.dtf.face.ui.overlay.CommAlertOverlay
        android:id="@+id/message_box_overlay"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
