<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bgm_cover_container"
    android:layout_width="52dp"
    android:layout_height="52dp"
    app:layout_constraintBottom_toBottomOf="@+id/ktv_float_ball_placeholder"
    app:layout_constraintEnd_toEndOf="@+id/ktv_float_ball_placeholder"
    app:layout_constraintStart_toStartOf="@+id/ktv_float_ball_placeholder"
    app:layout_constraintTop_toTopOf="@+id/ktv_float_ball_placeholder">
    <View
        android:layout_gravity="center"
        android:id="@+id/bgm_icon_bg"
        android:background="@drawable/ttlive_ktv_bgm_icon_bg"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:contentDescription="@string/ttlive_ksong_accessibility_label_song_live"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center"
        android:id="@+id/bgm_icon_cover"
        android:background="@drawable/ttlive_ktv_empty_bgm_icon_bg"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:contentDescription="@string/ttlive_ksong_accessibility_label_song_live"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/bgm_score_tv"
        android:background="@drawable/ttlive_ktv_component_score_bg_ic"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:text="@string/ttlive_ktv_component_score_zero"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#161823"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="right"
        android:id="@+id/bgm_order_song_num"
        android:background="@drawable/ttlive_ksong_multiple_ktv_music_list_size_bg"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="8dp"
        android:minWidth="16dp"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginEnd="8dp"/>
</FrameLayout>
