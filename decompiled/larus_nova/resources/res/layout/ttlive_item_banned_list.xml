<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <com.bytedance.android.livesdk.widget.VHeadView
        android:id="@+id/header_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="16dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_ic_default_head_small"
        app:roundAsCircle="true"
        app:v_able="false"/>
    <FrameLayout
        android:id="@+id/cancel_layout"
        android:layout_width="60dp"
        android:layout_height="28dp"
        android:layout_marginRight="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_manage_undo_text_color"
            android:gravity="center"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/cancel_btn"
            android:background="@drawable/ttlive_bg_cancel_ban"
            android:layout_width="60dp"
            android:layout_height="28dp"
            android:text="@string/ttlive_undo_admin"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/cancel_progress"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@android:style/Widget.ProgressBar.Small"/>
    </FrameLayout>
    <RelativeLayout
        android:layout_width="219dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:layout_toLeftOf="@+id/cancel_layout"
        android:layout_toRightOf="@+id/header_image"
        android:layout_centerVertical="true"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@+id/cancel_layout"
        android:layout_toEndOf="@+id/header_image"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/header_image"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_manage_anim_user_name"
            android:ellipsize="end"
            android:id="@+id/user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="4dp"
            android:singleLine="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="4dp"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/user_class_medal"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="16dp"
            android:scaleType="fitXY"
            android:layout_toRightOf="@+id/user_name"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/user_name"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
