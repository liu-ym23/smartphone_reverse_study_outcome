<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_vote_sti_entry"
    android:layout_width="112dp"
    android:layout_height="96dp">
    <TextView
        android:textSize="14dp"
        android:textColor="@color/white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="6dp"
        android:text="@string/ttlive_vote_entry_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/white"
        android:id="@+id/tv_count_down"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginRight="6dp"
        android:includeFontPadding="false"
        android:layout_marginEnd="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/left_bar"
        android:background="@drawable/ttlive_bg_vote_sti_entry_colorbar_left"
        android:layout_width="100dp"
        android:layout_height="20dp"
        android:layout_marginTop="38dp"
        app:layout_constraintStart_toStartOf="@+id/ttlive_guideline"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/right_bar"
        android:background="@drawable/ttlive_bg_vote_sti_entry_colorbar_right"
        android:layout_width="100dp"
        android:layout_height="20dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/ttlive_guideline"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_left_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/left_bar"
        app:layout_constraintRight_toRightOf="@+id/left_bar"
        app:layout_constraintStart_toStartOf="@+id/ttlive_guideline2"
        app:layout_constraintTop_toTopOf="@+id/left_bar"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_right_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/right_bar"
        app:layout_constraintStart_toStartOf="@+id/ttlive_guideline2"
        app:layout_constraintTop_toTopOf="@+id/right_bar"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_left_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/left_bar"
        app:layout_constraintRight_toRightOf="@+id/left_bar"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_right_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/right_bar"
        app:layout_constraintRight_toRightOf="@+id/right_bar"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/ttlive_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="6dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/ttlive_guideline2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="13dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
