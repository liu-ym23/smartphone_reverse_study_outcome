<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="112dp"
    android:layout_height="wrap_content">
    <com.bytedance.android.ec.core.widget.ECHotAtmosphereView
        android:id="@+id/layout_hot_atmosphere"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginBottom="8dp"/>
    <FrameLayout
        android:background="@drawable/ec_bg_promotion_card_new_style"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="175dp">
        <com.bytedance.android.ec.core.widget.ECNetImageView
            android:id="@+id/iv_ec_main_image"
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="2dp"
            android:scaleType="centerCrop"/>
        <FrameLayout
            android:background="@drawable/ec_bg_promotion_card_status_bar"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_margin="2dp">
            <ImageView
                android:layout_gravity="right"
                android:id="@+id/iv_close"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="2dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="3dp"
                android:src="@drawable/ec_ic_explain_card_close"
                android:scaleType="centerInside"/>
            <com.bytedance.android.ec.core.widget.ECAuctionStatusLayout
                android:id="@+id/layout_status"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginTop="5dp"
                android:layout_marginStart="5dp"/>
        </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="111dp">
            <include
                android:id="@+id/layout_auction_info_hide"
                layout="@layout/ec_explain_card_uimodule_auction_info"/>
            <include
                android:id="@+id/layout_auction_info_show"
                layout="@layout/ec_explain_card_uimodule_auction_info"/>
        </FrameLayout>
        <FrameLayout
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="147dp">
            <com.bytedance.android.livesdk.livecommerce.view.roundcorner.RoundCornerLinearlayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/layout_bottom"
                android:background="@color/shopping_color_FFFF005C"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:ec_allRadius="20dp">
                <com.bytedance.android.ec.core.widget.ECNetImageView
                    android:id="@+id/iv_bottom_user_head"
                    android:visibility="gone"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginRight="4dp"/>
                <TextView
                    android:textSize="10dp"
                    android:textStyle="bold"
                    android:textColor="@color/ec_color_pink_fe2c55"
                    android:id="@+id/tv_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </com.bytedance.android.livesdk.livecommerce.view.roundcorner.RoundCornerLinearlayout>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
