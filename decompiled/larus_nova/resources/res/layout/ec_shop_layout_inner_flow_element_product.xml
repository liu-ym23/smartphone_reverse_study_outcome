<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shopping_bg_inner_flow_element_product"
    android:padding="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/store_product_card_image_wrapper"
        android:padding="6dp"
        android:layout_width="68dp"
        android:layout_height="68dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/store_product_card_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:placeholderImage="@drawable/ecommerce_slogan_product_single_bg"
            app:placeholderImageScaleType="fitXY"/>
        <View
            android:background="@color/shopping_std_bg_black_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.cardview.widget.CardView>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:id="@+id/store_product_card_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/store_product_card_image_wrapper"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#99161823"
        android:ellipsize="end"
        android:id="@+id/ec_shop_tv_product_source"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:maxLines="1"
        android:layout_below="@+id/store_product_card_title"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/store_product_card_image_wrapper"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/store_product_card_title"/>
    <com.bytedance.android.ec.core.widget.price.PriceView
        android:textSize="17dp"
        android:ellipsize="end"
        android:id="@+id/store_product_card_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:lines="1"
        android:layout_alignParentBottom="true"
        android:lineSpacingExtra="2dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/store_product_card_image_wrapper"
        app:layout_constraintTop_toBottomOf="@+id/ec_shop_tv_product_source"
        app:layout_constraintVertical_bias="1"/>
    <TextView
        android:textSize="11dp"
        android:textColor="#b0b0b4"
        android:ellipsize="end"
        android:id="@+id/store_product_card_sale"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:maxLines="1"
        android:layout_alignParentBottom="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBaseline_toBaselineOf="@+id/store_product_card_price"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/store_product_card_price"
        app:layout_constraintTop_toBottomOf="@+id/ec_shop_tv_product_source"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintWidth_max="100dp"/>
    <com.bytedance.android.ec.window.base.widget.ECWindowRoundedLinearLayout
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ec_ll_submit_order_group"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_alignParentBottom="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintLeft_toRightOf="@+id/store_product_card_sale"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintWidth_min="68dp"
        app:rounded_radius="4dp">
        <ImageView
            android:id="@+id/store_product_card_add_to_cart"
            android:background="@color/shopping_color_0DFE496A"
            android:padding="1dp"
            android:layout_width="38dp"
            android:layout_height="24dp"
            android:src="@drawable/ec_shop_inner_flow_ic_add_to_cart"/>
        <TextView
            android:textSize="13dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/ec_element_tv_buy_product"
            android:background="@color/shopping_color_FE496A"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="68dp"
            android:maxLines="1"/>
    </com.bytedance.android.ec.window.base.widget.ECWindowRoundedLinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
