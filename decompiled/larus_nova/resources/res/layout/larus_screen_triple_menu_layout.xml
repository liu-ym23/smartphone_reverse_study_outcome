<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/left_menu_layout"
            android:padding="?attr/larus_dp_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/divider_1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/left_text_icon"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                android:layout_marginBottom="?attr/larus_dp_4"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/left_text_url_icon"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                android:layout_marginBottom="?attr/larus_dp_4"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_dp_16"
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:id="@+id/left_menu_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <View
            android:id="@+id/divider_1"
            android:background="?attr/larus_neutral_transparent_2"
            android:layout_width="1px"
            android:layout_height="match_parent"
            android:layout_marginTop="?attr/larus_dp_19"
            android:layout_marginBottom="?attr/larus_dp_19"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/mid_menu_layout"
            app:layout_constraintStart_toEndOf="@+id/left_menu_layout"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/mid_menu_layout"
            android:padding="?attr/larus_dp_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/divider_2"
            app:layout_constraintStart_toEndOf="@+id/divider_1"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/mid_text_icon"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                android:layout_marginBottom="?attr/larus_dp_4"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/mid_text_url_icon"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                android:layout_marginBottom="?attr/larus_dp_4"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_dp_16"
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:id="@+id/mid_menu_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <View
            android:id="@+id/divider_2"
            android:background="?attr/larus_neutral_transparent_2"
            android:layout_width="1px"
            android:layout_height="match_parent"
            android:layout_marginTop="?attr/larus_dp_19"
            android:layout_marginBottom="?attr/larus_dp_19"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/right_menu_layout"
            app:layout_constraintStart_toEndOf="@+id/mid_menu_layout"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/right_menu_layout"
            android:padding="?attr/larus_dp_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/divider_2"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/right_text_icon"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                android:layout_marginBottom="?attr/larus_dp_4"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/right_text_url_icon"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                android:layout_marginBottom="?attr/larus_dp_4"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_dp_16"
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:id="@+id/right_menu_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
