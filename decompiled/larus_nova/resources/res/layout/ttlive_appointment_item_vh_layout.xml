<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/program_cover"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:layout_centerVertical="true"
        app:placeholderImageScaleType="centerCrop"
        app:roundedCornerRadius="@dimen/ttlive_live_end_recommend_radius"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="16dp"
        android:layout_toLeftOf="@+id/program_button"
        android:layout_toRightOf="@+id/program_cover"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        android:layout_toStartOf="@+id/program_button"
        android:layout_toEndOf="@+id/program_cover">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_std_text_white_2"
            android:ellipsize="end"
            android:id="@+id/program_title"
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            android:maxLines="1"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_white_50"
            android:ellipsize="end"
            android:id="@+id/program_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="17dp"
            android:layout_marginTop="4dp"
            android:maxLines="1"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="17dp"
            android:layout_marginTop="4dp">
            <com.airbnb.lottie.LottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/live_lottie"
                android:visibility="gone"
                android:layout_width="10.5dp"
                android:layout_height="10dp"
                android:layout_marginRight="4dp"
                android:scaleType="centerCrop"
                android:layout_marginEnd="4dp"
                app:lottie_fileName="ttlive_icon.json"
                app:lottie_loop="true"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ttlive_white_50"
                android:ellipsize="end"
                android:id="@+id/program_time"
                android:layout_width="wrap_content"
                android:layout_height="17dp"
                android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_std_text_white_2"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/program_button"
        android:background="@drawable/ttlive_reserve_button_bg"
        android:layout_width="64dp"
        android:layout_height="24dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
