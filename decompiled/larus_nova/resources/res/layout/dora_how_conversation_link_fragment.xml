<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ScrollView
        android:id="@+id/scroll_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bottom_action_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="?attr/larus_dp_16"
            android:paddingTop="?attr/larus_dp_16"
            android:paddingRight="?attr/larus_dp_16"
            android:paddingBottom="?attr/larus_dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/neutral_100"
                android:id="@+id/tv_share_guide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <ImageView
                android:layout_gravity="start"
                android:layout_width="?attr/larus_dp_266"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_12"
                android:src="@drawable/dora_how_conversation_link_1"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"/>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/neutral_100"
                android:id="@+id/tv_copy_guide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16"/>
            <ImageView
                android:layout_gravity="start"
                android:layout_width="?attr/larus_dp_266"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_12"
                android:src="@drawable/dora_how_conversation_link_2"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bottom_action_container"
        android:background="@color/base_1"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingTop="?attr/larus_dp_8"
        android:paddingRight="?attr/larus_dp_16"
        android:paddingBottom="?attr/larus_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_go_to_conversation"
            android:background="@drawable/larus_dora_btn_primary_bg_r12"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_48"
            android:text="@string/larus_dora_g_go_select_chat_cn"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
