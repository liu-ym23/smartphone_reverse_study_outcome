<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.shopping.anchorv4.widgets.AnchorV4SlideContainer xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/anchor_v4_half_slides_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.shopping.anchorv4.widgets.TopRoundFrameLayout
        android:id="@+id/anchor_v4_content_view"
        android:background="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.shopping.anchorv4.widgets.ECCoordinatorRecyclerView
            android:id="@+id/anchor_v4_recycler_view_exp"
            android:background="#fff6f6f9"
            android:paddingBottom="@dimen/commerce_anchor_v3_left_recyclerview_bottom_margin"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.shopping.anchorv3.widget.FixedRecyclerView
            android:id="@+id/anchor_v4_recycler_view"
            android:background="#fff6f6f9"
            android:paddingBottom="@dimen/commerce_anchor_v3_left_recyclerview_bottom_margin"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/anchor_v4_drag_container_box"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:layout_gravity="bottom|right"
            android:id="@+id/back_to_top_btn"
            android:background="@drawable/commerce_anchor_v4_back_to_top_btn"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="127dp"
            android:layout_marginEnd="13dp"/>
        <com.bytedance.android.shopping.anchorv4.voavhs.base.components.LongContentLabelComponentView
            android:layout_gravity="bottom|right"
            android:id="@+id/shop_float_entry"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="332dp"/>
        <FrameLayout
            android:layout_gravity="bottom|right"
            android:id="@+id/questionnaire_entrance"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="112dp"/>
        <FrameLayout
            android:id="@+id/play_back_entry_wrapper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="70dp">
            <com.bytedance.android.shopping.anchorv4.floatwidget.replay.AnchorV4PlaybackArea
                android:layout_gravity="end"
                android:id="@+id/play_back_entry"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <FrameLayout
            android:orientation="vertical"
            android:id="@+id/anchor_v4_frame_area"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/anchor_v4_frame_ll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.bytedance.android.shopping.anchorv4.voavhs.head.base.LengthenedCompatDraweeView
                    android:id="@+id/anchor_v4_frame_image"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:fadeDuration="0"/>
                <com.bytedance.android.shopping.anchorv4.widgets.WireFrameViewV2
                    android:id="@+id/anchor_v4_frame_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>
            <ViewStub
                android:id="@+id/anchor_v4_error_view_stub"
                android:visibility="gone"
                android:layout="@layout/ec_common_layout_error"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ViewStub
                android:id="@+id/anchor_v4_error_view_stub_v2"
                android:visibility="gone"
                android:layout="@layout/ec_pdp_network_error_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/anchor_v4_comment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/anchor_v4_gallery_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.bytedance.android.shopping.anchorv4.widgets.TopRoundFrameLayout>
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/anchor_v4_drag_handle"
        android:background="@drawable/anchor_v4_half_drag_handle"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"/>
</com.bytedance.android.shopping.anchorv4.widgets.AnchorV4SlideContainer>
