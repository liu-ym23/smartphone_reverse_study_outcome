<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/shopping_layout_sku_button_module_1488139199"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/sku_delay_view"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="8dp">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/iv_sku_delay_icon"
            android:visibility="gone"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/tv_sku_delivery_time"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/shopping_std_text_black_1"
            android:id="@+id/tv_sku_delivery_time"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/iv_sku_delay_icon"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:typeface="monospace"
        android:textColor="@color/ec_color_FF6F26"
        android:gravity="center"
        android:id="@+id/tv_sku_sold_free"
        android:background="@drawable/shopping_bg_sold_free_promotion"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        style="@style/font_size_22"/>
    <com.bytedance.android.ec.core.widget.RoundedLinearLayout
        android:gravity="center"
        android:id="@+id/ll_sku_button_container"
        android:background="@color/ec_color_white"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:rounded_radius="8dp">
        <TextView
            android:textSize="17sp"
            android:textColor="@drawable/shopping_tc_selector_add_to_cart_tv"
            android:gravity="center"
            android:id="@+id/ll_sku_add_container"
            android:background="@color/shopping_color_0DFE496A"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/shopping_add_to_cart"
            android:layout_weight="1"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_sku_buy_container"
            android:background="@drawable/shopping_bg_selector_go_to_goods_btn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="17sp"
                android:textColor="@color/shopping_std_text_white_1"
                android:id="@+id/tv_sku_buy_confirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shopping_confirm"/>
            <TextView
                android:typeface="monospace"
                android:textColor="@color/shopping_std_text_white_4"
                android:id="@+id/tv_sku_buy_count_down"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/font_size_24"/>
        </LinearLayout>
    </com.bytedance.android.ec.core.widget.RoundedLinearLayout>
</LinearLayout>
