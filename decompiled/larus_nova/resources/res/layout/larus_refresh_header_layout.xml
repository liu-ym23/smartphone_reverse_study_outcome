<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progress_view"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:layout_marginTop="?attr/larus_dp_14"
        android:layout_marginBottom="?attr/larus_dp_14"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/larus_ic_refresh_header_loading_animated"
        android:indeterminateDuration="750"
        android:indeterminateBehavior="repeat"/>
</merge>
