<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/close_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/cellular_container"
        android:background="@drawable/ttlive_bg_ktv_feedback_dialog"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="122dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_black"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_ktv_multi_chorus_enable_cellular_title"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#a3a3a3"
                android:id="@+id/sub_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/ttlive_ktv_multi_chorus_enable_cellular_sub_tittle"/>
        </LinearLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:id="@+id/ttlive_cellular_enable"
            android:background="@drawable/ttlive_bg_ktv_feedback_btn"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_ktv_multi_chorus_enable_cellular_enable"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</FrameLayout>
