<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_root"
    android:background="@drawable/commerce_product_feed_top_immersive_background"
    android:layout_width="match_parent"
    android:layout_height="100dp">
    <View
        android:id="@+id/product_feed_head_cover"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/product_feed_ic_immersive_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">
        <View
            android:layout_gravity="center"
            android:background="@drawable/commerce_product_feed_bg_close_btn"
            android:layout_width="35dp"
            android:layout_height="35dp"/>
        <ImageView
            android:layout_gravity="center"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/commerce_ic_close_white"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/coupon_urge_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:layout_marginLeft="8dp"
        android:layout_marginBottom="9.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/product_feed_ic_immersive_close"/>
    <LinearLayout
        android:layout_gravity="end|bottom"
        android:orientation="horizontal"
        android:id="@+id/right_entrance_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:divider="@drawable/commerce_inflow_feed_icon_linear_layout_divider"
        android:showDividers="middle"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <FrameLayout
            android:layout_gravity="end|bottom"
            android:id="@+id/product_feed_ic_immersive_coupon"
            android:visibility="gone"
            android:layout_width="35dp"
            android:layout_height="35dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent">
            <View
                android:layout_gravity="center"
                android:background="@drawable/commerce_product_feed_bg_close_btn"
                android:layout_width="35dp"
                android:layout_height="35dp"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ec_mall_immersive_coupon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ec_inflow_feed_coupon_entrance"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="end|bottom"
            android:id="@+id/product_feed_ic_immersive_search"
            android:layout_width="35dp"
            android:layout_height="35dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent">
            <View
                android:layout_gravity="center"
                android:background="@drawable/commerce_product_feed_bg_close_btn"
                android:layout_width="35dp"
                android:layout_height="35dp"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ec_mall_immersive_search"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ec_inflow_feed_search"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="end|bottom"
            android:id="@+id/product_feed_ic_immersive_mall"
            android:layout_width="35dp"
            android:layout_height="35dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent">
            <View
                android:layout_gravity="center"
                android:background="@drawable/commerce_product_feed_bg_close_btn"
                android:layout_width="35dp"
                android:layout_height="35dp"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/ec_mall_immersive_iv"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ec_inflow_feed_mall_imersive"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="end"
            android:id="@+id/product_feed_ic_immersive_cart_container"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent">
            <View
                android:layout_gravity="start|bottom"
                android:background="@drawable/commerce_product_feed_bg_close_btn"
                android:layout_width="35dp"
                android:layout_height="35dp"/>
            <com.bytedance.android.ec.core.widget.ECLottieAnimationView
                android:layout_gravity="start|bottom"
                android:id="@+id/product_feed_ic_immersive_cart"
                android:layout_width="35dp"
                android:layout_height="35dp"
                app:lottie_autoPlay="false"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/commerce_color_FFFFFF"
                android:gravity="center"
                android:layout_gravity="end|top"
                android:id="@+id/product_feed_ic_immersive_add_cart_dot_count"
                android:background="@drawable/shopping_bg_add_cart_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="14dp"
                android:minHeight="14dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"/>
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
