<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/recordcard_title_ll_opt"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="32dp">
        <FrameLayout
            android:id="@+id/recordcard_close"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:tint="@color/icon_n1"
                app:srcCompat="@drawable/ud_icon_left_outlined"/>
        </FrameLayout>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/text_title"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/recordcard_table_title_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:maxLines="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/recordcard_to_navigation"
            app:layout_constraintStart_toEndOf="@+id/recordcard_close"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/recordcard_to_navigation"
            android:padding="6dp"
            android:visibility="gone"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:tint="@color/icon_n1"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/recordcard_menu_share"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ud_icon_more_launcher_outlined"/>
        <FrameLayout
            android:id="@+id/recordcard_menu_share"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/record_card_menu_subscribe"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/recordcard_menu_share_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:tint="@color/icon_n1"
                app:srcCompat="@drawable/ud_icon_forward_outlined"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/record_card_menu_subscribe"
            android:visibility="visible"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/recordcard_menu_more"
            app:layout_constraintTop_toTopOf="parent">
            <com.larksuite.component.ui.imageview.LKUILottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/record_card_menu_subscribe_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                app:srcCompat="@drawable/ud_icon_subscribe_add_outlined"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/recordcard_menu_more"
            android:visibility="visible"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:tint="@color/icon_n1"
                app:srcCompat="@drawable/ud_icon_more_outlined"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
