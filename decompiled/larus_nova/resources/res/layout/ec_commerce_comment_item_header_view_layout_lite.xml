<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_commerce_comment_item_header_view_layout_lite_1940293648"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.shopping.widget.legacy.AvatarImageView
        android:id="@+id/comment_sv_user_avatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@color/shopping_color_08161823"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/shopping_color_99161823"
        android:id="@+id/comment_tv_comment_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:includeFontPadding="false"
        android:layout_below="@+id/user_name_container"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/comment_sv_user_avatar"
        app:layout_constraintTop_toBottomOf="@+id/user_tag_container"/>
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/comment_item_sv_rank_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:scaleType="centerCrop"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/user_tag_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/comment_sv_user_avatar"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="13dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:layout_gravity="center_vertical"
            android:id="@+id/comment_tv_user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="8dp"/>
        <ViewStub
            android:layout_gravity="center_vertical"
            android:id="@+id/comment_rank_info_view_stub"
            android:layout="@layout/ec_commerce_comment_item_comment_user_rank_info_view_stub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"/>
        <ViewStub
            android:layout_gravity="center_vertical"
            android:id="@+id/comment_repeat_customer_tag_view_stub"
            android:layout="@layout/ec_commerce_comment_item_comment_repeat_customer_tag_view_stub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"/>
        <ViewStub
            android:layout_gravity="center_vertical"
            android:id="@+id/comment_shopping_fans_group_view_stub"
            android:layout="@layout/ec_commerce_comment_item_comment_shopping_fans_group_view_stub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/comment_sku_info_container"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/comment_sv_user_avatar">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/shopping_color_99161823"
            android:ellipsize="end"
            android:id="@+id/comment_tv_sku_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
