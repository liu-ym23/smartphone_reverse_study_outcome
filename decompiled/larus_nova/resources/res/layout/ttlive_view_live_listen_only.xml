<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/listen_live_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ttlive_icon_listen_live_white"
        android:scaleType="centerInside"/>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/ttlive_white_90"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="音频直播中"/>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/ttlive_white"
        android:gravity="center"
        android:id="@+id/live_listen_recover_live"
        android:background="@drawable/ttlive_bg_live_listen_only_button"
        android:layout_width="140dp"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:text="观看直播画面"/>
</LinearLayout>
