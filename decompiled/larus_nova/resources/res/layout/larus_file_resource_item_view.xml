<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/file_resource_root"
    android:paddingTop="?attr/larus_dp_12"
    android:paddingBottom="?attr/larus_dp_12"
    android:layout_width="?attr/larus_dp_198"
    android:layout_height="?attr/larus_dp_108"
    android:paddingStart="?attr/larus_dp_0"
    android:paddingEnd="?attr/larus_dp_8">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/file_resource_content_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_15"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="end"
            android:id="@+id/file_resource_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_10"
            android:maxLines="2"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginStart="?attr/larus_dp_10"
            android:layout_marginEnd="?attr/larus_dp_28"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/file_resource_type_icon"
            android:layout_width="?attr/larus_dp_14"
            android:layout_height="?attr/larus_dp_14"
            android:layout_marginTop="?attr/larus_dp_2"
            android:layout_marginBottom="?attr/larus_dp_10"
            android:layout_marginStart="?attr/larus_dp_10"
            android:layout_marginEnd="?attr/larus_dp_2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_12"
            android:textColor="?attr/larus_neutral_70"
            android:ellipsize="end"
            android:id="@+id/file_resource_type_txt"
            android:layout_width="?attr/larus_dp_0"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginStart="?attr/larus_dp_4"
            android:layout_marginEnd="?attr/larus_dp_10"
            app:autoSizeMaxTextSize="12sp"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toBottomOf="@+id/file_resource_type_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/file_resource_type_icon"
            app:layout_constraintTop_toTopOf="@+id/file_resource_type_icon"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/image"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:placeholderImage="?attr/larus_neutral_transparent_1"
            app:roundedCornerRadius="?attr/larus_dp_8"/>
        <com.larus.bmhome.chat.layout.widget.ImageCoverEditView
            android:id="@+id/image_cover_edit"
            android:padding="?attr/larus_dp_4"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <ViewStub
            android:id="@+id/file_resource_parse_failed_layout"
            android:layout="@layout/larus_file_resource_parse_failed_layout"
            android:inflatedId="@+id/file_resource_parse_failed_bottom_layout"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_28"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:id="@+id/file_resource_content_border"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/file_resource_uplink_progress_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.larus.common_ui.widget.CircleProgressBarView
            android:layout_gravity="center"
            android:id="@+id/file_resource_uplink_progress"
            android:layout_width="?attr/larus_dp_30"
            android:layout_height="?attr/larus_dp_30"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/file_resource_re_uplink_layout"
        android:background="?attr/larus_mask_overlay_50"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/file_resource_re_uplink"
            android:layout_width="?attr/larus_dp_30"
            android:layout_height="?attr/larus_dp_30"
            android:src="@drawable/larus_resource_item_re_uplink"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/file_resource_re_select_layout"
        android:background="@drawable/larus_bg_re_select_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/file_resource_re_select"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:src="@drawable/larus_arrow_reverse_line"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/file_resource_uplink_spring_review_layout"
        android:background="@drawable/bg_spring_review_background_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.larus.common_ui.widget.CircleProgressBarView
            android:layout_gravity="center"
            android:id="@+id/file_resource_spring_review_progress"
            android:layout_width="?attr/larus_dp_30"
            android:layout_height="?attr/larus_dp_30"/>
    </FrameLayout>
    <ViewStub
        android:id="@+id/file_resource_inspect_failed_layout"
        android:layout="@layout/larus_file_resource_inspect_failed_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end"
        android:id="@+id/file_resource_remove"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_4"
        android:src="@drawable/larus_resource_item_remove"
        android:contentDescription="@string/larus_accessibility_remove_image"
        android:layout_marginEnd="?attr/larus_dp_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/duration_container_view"
        android:paddingTop="19dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:textSize="?attr/larus_sp_13"
            android:textColor="@color/larus_static_white"
            android:layout_gravity="end"
            android:id="@+id/duration_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#40000000"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="4"
            android:lineSpacingMultiplier="1"
            android:fontFamily="sans-serif"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:letterSpacing="0"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/subscript_container_view"
        android:paddingTop="19dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_12"
            android:textColor="@color/larus_static_white"
            android:layout_gravity="end"
            android:id="@+id/subscript_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#40000000"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="4"
            android:fontFamily="sans-serif"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:letterSpacing="0"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
