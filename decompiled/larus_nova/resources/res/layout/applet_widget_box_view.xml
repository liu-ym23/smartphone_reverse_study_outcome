<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/title_bar"
        android:paddingTop="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/app_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:actualImageScaleType="centerCrop"
            app:roundedCornerRadius="4dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="?attr/applet_widget_title_color"
            android:ellipsize="end"
            android:id="@+id/app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:background="?attr/applet_widget_stroke_color"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="12dp"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/widget_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/float_title_bar"
            android:background="@drawable/widget_title_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="8dp">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/float_app_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:actualImageScaleType="centerCrop"
                app:roundedCornerRadius="4dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="?attr/applet_widget_title_color"
                android:ellipsize="end"
                android:id="@+id/float_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
    </FrameLayout>
</merge>
