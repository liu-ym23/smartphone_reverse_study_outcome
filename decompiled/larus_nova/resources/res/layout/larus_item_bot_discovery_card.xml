<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/big_image_extra_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_weight="1">
    <androidx.cardview.widget.CardView xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="?attr/larus_dp_183"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/larus_white_bg_item_middle_color"
        app:cardCornerRadius="?attr/larus_dp_16"
        app:cardElevation="?attr/larus_dp_0"
        app:cardMaxElevation="?attr/larus_dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="?attr/larus_dp_12"
            android:layout_width="?attr/larus_dp_183"
            android:layout_height="wrap_content">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/avatar"
                android:layout_width="?attr/larus_dp_183"
                android:layout_height="?attr/larus_dp_183"
                android:scaleType="centerCrop"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/name_des_container"
                android:layout_width="?attr/larus_dp_163"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:layout_marginStart="?attr/larus_dp_10"
                android:layout_marginEnd="?attr/larus_dp_10"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/avatar">
                <LinearLayout
                    android:gravity="start"
                    android:orientation="horizontal"
                    android:id="@+id/bot_name_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="?attr/larus_dp_16"
                        android:textColor="@color/larus_neutral_100"
                        android:ellipsize="end"
                        android:id="@+id/name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="?attr/larus_dp_163"
                        android:maxLines="2"
                        android:layout_marginEnd="?attr/larus_dp_6"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center"
                        android:id="@+id/iv_immersive_icon"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="?attr/larus_dp_18"
                        app:srcCompat="@drawable/larus_ic_bot_immersive"/>
                </LinearLayout>
                <TextView
                    android:textSize="?attr/larus_dp_13"
                    android:textColor="@color/larus_neutral_100"
                    android:ellipsize="end"
                    android:gravity="start|bottom"
                    android:id="@+id/description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_4"
                    android:maxWidth="?attr/larus_dp_163"
                    android:maxLines="2"
                    android:textAlignment="viewStart"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/name"/>
            </LinearLayout>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/add_bot"
                android:layout_width="?attr/larus_dp_52"
                android:layout_height="?attr/larus_dp_52"
                android:foreground="@drawable/larus_bg_add_remove_button"
                android:src="@drawable/larus_ugc_bot_ic_bot_off"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="?attr/larus_dp_13"
                android:textColor="@color/larus_neutral_50"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/bot_creator_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_4"
                android:maxWidth="?attr/larus_dp_97"
                android:maxLines="1"
                android:layout_marginStart="?attr/larus_dp_10"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/name_des_container"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/bot_heat_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_4"
                android:layout_marginStart="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_10"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/name_des_container">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="?attr/larus_dp_14"
                    android:layout_height="?attr/larus_dp_14"
                    android:src="@drawable/larus_icon_tag_hot_mini"
                    android:layout_marginEnd="?attr/larus_dp_2"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/bot_heat"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="?attr/larus_dp_13"
                    android:textColor="@color/larus_neutral_50"
                    android:id="@+id/bot_heat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
