<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height">
        <ImageView
            android:id="@+id/back_btn"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="7dp"
            android:src="@drawable/ttlive_ic_btn_back"
            android:layout_centerVertical="true"
            android:layout_marginStart="7dp"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/ttlive_core_s1"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/ttlive_realname_verify"/>
    </FrameLayout>
    <View
        android:background="@color/ttlive_core_s9"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <FrameLayout
        android:background="#0f000000"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_common_verify_desc"/>
    </FrameLayout>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:text="@string/ttlive_real_name"
        android:layout_marginStart="16dp"/>
    <EditText
        android:textSize="15dp"
        android:textColor="#e5000000"
        android:textColorHint="@color/ttlive_core_half_black"
        android:id="@+id/cloud_name_edt"
        android:background="@null"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="16dp"
        android:hint="@string/ttlive_cloud_name_tips"
        android:maxLines="1"
        android:inputType="text"
        android:imeOptions="actionNext"
        android:textCursorDrawable="@drawable/ttlive_edit_text_cursor_drawable"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <View
        android:background="#14000000"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:text="@string/ttlive_cloud_id"
        android:layout_marginStart="16dp"/>
    <EditText
        android:textSize="15dp"
        android:textColor="#e5000000"
        android:textColorHint="@color/ttlive_core_half_black"
        android:id="@+id/cloud_id_edt"
        android:background="@null"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="16dp"
        android:hint="@string/ttlive_cloud_id_tips"
        android:maxLines="1"
        android:inputType="text"
        android:imeOptions="actionNext"
        android:textCursorDrawable="@drawable/ttlive_edit_text_cursor_drawable"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <View
        android:background="#14000000"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <Button
        android:enabled="false"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:id="@+id/cloud_submit"
        android:background="@drawable/ttlive_bg_common_verify_btn_selector"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="16dp"
        android:text="@string/ttlive_next_step"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
</LinearLayout>
