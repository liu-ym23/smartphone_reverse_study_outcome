<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dora_diary_notice_banner"
        android:background="@color/larus_additional_orange"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingTop="?attr/larus_dp_18"
        android:paddingRight="?attr/larus_dp_16"
        android:paddingBottom="?attr/larus_dp_18"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/larus_dp_58">
        <TextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="@color/larus_additional_brown"
            android:id="@+id/dora_diary_notice_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_diary_notice_environment_observation_not_open_cn"
            android:drawablePadding="?attr/larus_dp_8"
            android:drawableStart="@drawable/icon_warning_circle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="@color/primary_50"
            android:id="@+id/dora_diary_notice_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_diary_notice_open_btn_cn"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/diary_record_status"
        android:paddingBottom="?attr/larus_dp_2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.lynx.lottieadapter.LottieAdapterView
            android:layout_gravity="center_vertical"
            android:id="@+id/diary_recording_animation"
            android:layout_width="?attr/larus_dp_14"
            android:layout_height="?attr/larus_dp_14"
            android:layout_marginEnd="?attr/larus_dp_2"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"/>
        <TextView
            android:textSize="?attr/larus_sp_12"
            android:textColor="@color/neutral_50"
            android:layout_gravity="center_vertical"
            android:id="@+id/diary_title_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_diary_tag_pausing_cn"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="?attr/larus_sp_12"
            android:textColor="@color/larus_neutral_50"
            android:layout_gravity="center_vertical"
            android:id="@+id/diary_next_update_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="?attr/larus_dp_4"/>
    </LinearLayout>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/dora_env_diary_srl_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/dora_env_diary_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/neutral_50"
                android:layout_gravity="center"
                android:id="@+id/diary_empty_guide"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_diary_empty_guide_cn"
                android:includeFontPadding="false"/>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
