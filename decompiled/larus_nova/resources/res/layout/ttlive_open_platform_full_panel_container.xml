<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom"
    android:id="@+id/fl_panel_container_root"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/game_interact_panel_layout"
        android:background="#161616"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ttlive_leftTopRadius="12dp"
        app:ttlive_rightTopRadius="12dp">
        <FrameLayout
            android:id="@+id/hybrid_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/loading_status_layout"
            android:background="#161616"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:gravity="center_horizontal"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="225dp">
                <ImageView
                    android:layout_width="180dp"
                    android:layout_height="120dp"
                    android:src="@drawable/ttlive_open_feature_list_network_error"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#80ffffff"
                    android:gravity="center"
                    android:id="@+id/statusBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:text="@string/ttlive_open_platform_panel_load_fail"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_live_game_interact_panel_loading_text_color"
                    android:gravity="center"
                    android:id="@+id/retry_btn"
                    android:background="#26ffffff"
                    android:layout_width="170dp"
                    android:layout_height="45dp"
                    android:text="@string/ttlive_open_platform_panel_retry"/>
            </LinearLayout>
            <TextView
                android:textSize="14dp"
                android:textColor="#7fffffff"
                android:layout_gravity="end|top"
                android:id="@+id/tv_stop"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/ttlive_audio_stop_game"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/double_ball_loading_view_background"
            android:background="#161616"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
                android:layout_gravity="center"
                android:id="@+id/double_ball_loading_view"
                android:layout_width="28dp"
                android:layout_height="28dp"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/top_right_btn_view"
            android:background="@drawable/ttlive_game_anchor_more_close_bg"
            android:paddingLeft="13dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="8dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/top_message_container"
            android:background="#161616"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="8dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerConstraintLayout>
</LinearLayout>
