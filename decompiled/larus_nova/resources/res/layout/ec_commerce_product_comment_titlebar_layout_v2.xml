<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/comment_titlebar_root_view_v2"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="88dp">
    <View
        android:id="@+id/stated_comment_back"
        android:background="@drawable/commerce_comment_back_black"
        android:layout_width="@dimen/commerce_anchor_v3_comment_back_icon_size"
        android:layout_height="@dimen/commerce_anchor_v3_comment_back_icon_size"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="49dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/commerce_comment_title_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/stated_comment_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/stated_comment_back">
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="@color/TextReverse"
            android:ellipsize="end"
            android:id="@+id/tv_comment_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/commerce_comment"
            android:maxLines="1"/>
        <ImageView
            android:id="@+id/commerce_comment_sku_filter_iv"
            android:visibility="gone"
            android:layout_width="8dp"
            android:layout_height="5dp"
            android:layout_marginLeft="4dp"
            android:src="@drawable/commerce_comment_sku_select"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="end"
        android:id="@+id/ec_commerce_top_right_controls"
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:layout_marginTop="43dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/ec_commerce_comment_split_line"
        android:background="@color/color_33black"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
