<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/store_product_card_price_wrapper"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/store_product_card_price_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="bottom"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedance.android.ec.core.widget.price.PriceView
                android:textSize="22sp"
                android:ellipsize="end"
                android:id="@+id/store_product_card_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:lineSpacingExtra="2dp"
                app:pv_hideYuanSymbol="false"
                app:pv_prefixMarginRight="4dp"
                app:pv_prefixTextBold="false"
                app:pv_prefixTextColor="@color/ec_shop_FE002A"
                app:pv_prefixTextSizeRatio="0.647"
                app:pv_priceBold="true"
                app:pv_priceTextColor="@color/ec_shop_FE002A"
                app:pv_yuanSymbolBold="false"
                app:pv_yuanSymbolMarginRight="1dp"
                app:pv_yuanSymbolRatioOfPriceTextSize="0.764"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/shopping_std_text_black_4"
                android:ellipsize="end"
                android:layout_gravity="start|bottom"
                android:id="@+id/store_product_card_sale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:baselineAlignBottom="true"
                android:maxLines="1"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
