<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larus.common_ui.widget.roundlayout.RoundRelativeLayout
        android:id="@+id/container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:rv_backgroundColor="@color/base_3"
        app:rv_cornerRadius="@dimen/dp_8">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/title_layout"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_34"
            android:layout_alignParentTop="true"
            android:paddingEnd="?attr/larus_dp_10"
            android:layout_alignParentStart="true">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/icon"
                android:layout_width="?attr/larus_dp_28"
                android:layout_height="?attr/larus_dp_28"
                app:actualImageScaleType="fitCenter"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextSwitcher
                android:layout_gravity="center_vertical"
                android:id="@+id/search_reference_switcher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="?attr/larus_dp_4"/>
            <TextView
                android:textSize="@dimen/dp_14"
                android:textStyle="bold"
                android:textColor="@color/neutral_70"
                android:ellipsize="end"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="?attr/larus_dp_4"/>
            <com.larus.bmhome.chat.layout.widget.MessageLoading
                android:orientation="horizontal"
                android:id="@+id/message_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:color="@color/larus_neutral_100"/>
            <View
                android:layout_gravity="center_vertical"
                android:id="@+id/arrow"
                android:background="@drawable/obric_icon_bold_gray_right_arrow"
                android:layout_width="?attr/larus_dp_14"
                android:layout_height="?attr/larus_dp_15"
                android:layout_marginStart="?attr/larus_dp_2"/>
        </LinearLayout>
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/dropdown_layout"
            android:paddingBottom="@dimen/dp_9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/title_layout">
            <View
                android:id="@+id/divider"
                android:background="@color/larus_neutral_transparent_1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_alignParentTop="true"/>
            <TextView
                android:textSize="@dimen/dp_15"
                android:textColor="@color/neutral_70"
                android:id="@+id/tv_queries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/item_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:layout_below="@+id/tv_queries"/>
        </RelativeLayout>
    </com.larus.common_ui.widget.roundlayout.RoundRelativeLayout>
</RelativeLayout>
