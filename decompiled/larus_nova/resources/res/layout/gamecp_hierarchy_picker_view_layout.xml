<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gamecp_picker_view_titlebar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="15dp"
            android:textStyle="normal"
            android:textColor="#161823"
            android:id="@+id/gamecp_picker_view_tv_cancel"
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="11.5dp"
            android:layout_marginBottom="11.5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:id="@+id/gamecp_picker_view_tv_title"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/gamecp_picker_view_tv_confirm"
            app:layout_constraintStart_toEndOf="@+id/gamecp_picker_view_tv_cancel"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="normal"
            android:textColor="#fe2c55"
            android:id="@+id/gamecp_picker_view_tv_confirm"
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            android:layout_marginTop="11.5dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="11.5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/gamecp_picker_view_divider"
        android:background="#1e161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gamecp_picker_view_titlebar"/>
    <com.bytedance.dux.picker.DuxPicker
        android:id="@+id/gamecp_picker_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gamecp_picker_view_divider"/>
</androidx.constraintlayout.widget.ConstraintLayout>
