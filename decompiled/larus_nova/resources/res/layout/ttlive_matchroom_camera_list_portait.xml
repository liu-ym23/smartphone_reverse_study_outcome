<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#99000000"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="top"
        android:id="@+id/panel_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="138dp"
        android:importantForAccessibility="no">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/panel_blur_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:roundTopEnd="false"
            app:roundTopLeft="false"
            app:roundTopRight="false"
            app:roundTopStart="false"
            app:roundedCornerRadius="12dp"/>
        <View
            android:id="@+id/panel_mask"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.livesdk.vscore_impl.component.multicamera.linkedroom.ui.MultiCameraLinkerRoomTagView
            android:id="@+id/tag_view"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constrainedWidth="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/iv_arrow"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_arrow"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/ttlive_matchroom_camera_panel_arrow"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.livesdk.widget.LivePagerSlidingTabStrip
            android:id="@+id/tab_strip"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginLeft="18dp"
            android:layout_marginStart="18dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/iv_arrow"
            app:layout_constraintTop_toTopOf="parent"
            app:tab_background="@color/transparent"
            app:tab_divider_color="@color/transparent"
            app:tab_indicator_color="@color/white"
            app:tab_indicator_height="2dp"
            app:tab_indicator_radius="10dp"
            app:tab_indicator_width="30dp"
            app:tab_margin_right="16dp"
            app:tab_padding_left_right="0dp"
            app:tab_text_color="#80ffffff"
            app:tab_text_size="13dp"
            app:tab_underline_color="@color/transparent"/>
        <com.bytedance.android.livesdk.vscore_impl.component.multicamera.linkedroom.ui.NoSwipeViewPager
            android:id="@+id/viewpager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_arrow"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
