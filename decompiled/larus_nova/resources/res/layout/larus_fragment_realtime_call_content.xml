<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/realtime_call_root_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.voicecall.impl.ui.VoiceCallBgLayout
        android:id="@+id/realtime_call_bg_layout"
        android:background="@color/larus_static_black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/realtime_call_fg_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/top_line"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintGuide_begin="?attr/larus_dp_44"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/bottom_line"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintGuide_end="?attr/larus_dp_124"/>
        <View
            android:id="@+id/iv_take_photo_ani_bg"
            android:background="@color/larus_static_black"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="1dp"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/iv_take_photo_ani"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:elevation="1dp"
            app:actualImageScaleType="center"
            app:layout_constraintBottom_toBottomOf="@+id/bottom_line"
            app:layout_constraintDimensionRatio="H,4:3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/top_line"
            app:roundedCornerRadius="?attr/larus_dp_8"/>
        <com.larus.common_ui.view.ZoomableTextureView
            android:id="@+id/realtime_call_network_hot_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="?attr/larus_dp_20"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/focus"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/larus_ic_realtime_surface_focus"
            android:scaleType="center"
            android:alpha="0"
            app:layout_constraintStart_toStartOf="@+id/realtime_call_network_hot_area"
            app:layout_constraintTop_toTopOf="@+id/realtime_call_network_hot_area"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.larus.voicecall.impl.ui.VoiceCallContentLayout
                android:id="@+id/voice_call_content_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.larus.voicecall.impl.subtitle.RealtimeCallScreenShareLayout
                android:id="@+id/voice_call_screen_share_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.larus.voicecall.impl.subtitle.SubtitleInterpretLayout
                android:id="@+id/voice_call_interpret_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.larus.voicecall.impl.subtitle.RealtimeCallSubtitleLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/voice_call_subtitle_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/voice_call_interpret_layout"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:id="@+id/floatSubtitleContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/smallViewPortPH"
            android:visibility="visible"
            android:layout_width="?attr/larus_dp_80"
            android:layout_height="?attr/larus_dp_132"
            android:layout_marginEnd="?attr/larus_dp_6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/realtime_call_cover"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
