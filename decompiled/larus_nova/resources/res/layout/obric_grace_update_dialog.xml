<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dp_48"
    app:cardCornerRadius="@dimen/dp_16">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/base_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/sp_18"
            android:textStyle="bold"
            android:textColor="@color/neutral_100"
            android:gravity="center"
            android:id="@+id/tvDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:text="@string/obric_settings_found_new_version"
            android:lines="1"
            android:layout_marginStart="@dimen/dp_20"
            android:layout_marginEnd="@dimen/dp_20"/>
        <TextView
            android:textSize="@dimen/sp_15"
            android:textColor="@color/neutral_70"
            android:gravity="center"
            android:id="@+id/tvDialogContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp_20"
            android:paddingEnd="@dimen/dp_20"/>
        <View
            android:background="@color/neutral_transparent_1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/sp_17"
                android:textColor="@color/neutral_100"
                android:gravity="center"
                android:id="@+id/tvDialogCancel"
                android:background="@drawable/larus_bg_leftdown_selector"
                android:paddingTop="@dimen/dp_13"
                android:paddingBottom="@dimen/dp_13"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/obric_stop_service_cancel"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:paddingStart="@dimen/dp_16"
                android:paddingEnd="@dimen/dp_16"/>
            <View
                android:background="@color/neutral_transparent_1"
                android:layout_width="@dimen/dp_1"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="@dimen/sp_17"
                android:textStyle="bold"
                android:textColor="@color/primary_50"
                android:gravity="center"
                android:id="@+id/btnDialogConfirm"
                android:background="@drawable/bg_rightdown_selector"
                android:paddingTop="@dimen/dp_13"
                android:paddingBottom="@dimen/dp_13"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/larus_update_popup_agree"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:paddingStart="@dimen/dp_16"
                android:paddingEnd="@dimen/dp_16"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
