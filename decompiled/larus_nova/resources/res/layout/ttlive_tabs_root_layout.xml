<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/tab_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/top"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ttlive_tab_height">
            <com.bytedance.android.livesdk.vscore_impl.component.tabs.LivePagerTabsStrip
                android:id="@+id/pager_tab"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:tab_background="@color/transparent"
                app:tab_indicator_color="#ffffff"
                app:tab_indicator_height="2dp"
                app:tab_indicator_radius="10px"
                app:tab_should_expand="false"
                app:tab_text_color="@color/ttlive_tabs_text_color"
                app:tab_text_select_size="15dp"
                app:tab_text_size="15dp"
                app:tab_widget="62dp"/>
        </RelativeLayout>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/pager_container"
        android:background="@color/transparent"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/divider"
            android:background="@color/ttlive_hs_s32"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <com.bytedance.android.livesdk.vscore_impl.component.tabs.MultiTabRoomViewPager
            android:id="@+id/ttlive_view_pager"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/divider"/>
    </FrameLayout>
</LinearLayout>
