<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_dynamic_emoji_dialog"
    android:paddingBottom="15dp"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:orientation="horizontal"
        android:id="@+id/title_container"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_interact_name"/>
        <LinearLayout
            android:gravity="top"
            android:layout_gravity="end|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/toolbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14dp"
                android:textColor="#7f000000"
                android:id="@+id/tv_disconnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_audio_disconnect"/>
        </LinearLayout>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/talk_room_action_list"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_container"/>
    <View
        android:id="@+id/guide_line"
        android:background="#11000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/talk_room_action_list"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#525252"
        android:gravity="center"
        android:id="@+id/empty_list_tips"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:text="@string/ttlive_talk_room_emoji_list_error_tip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guide_line"/>
    <com.bytedance.android.livesdk.chatroom.ui.DouyinLoadingLayout
        android:id="@+id/list_loading_webp_view"
        android:visibility="gone"
        android:layout_width="90dp"
        android:layout_height="90dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guide_line"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/talk_room_emoji_list"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        app:layout_constraintTop_toBottomOf="@+id/guide_line"/>
    <com.bytedance.android.livesdk.chatroom.ui.RtlViewPagerShower
        android:gravity="center"
        android:id="@+id/pager_bottom_shower"
        android:layout_width="0dp"
        android:layout_height="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/talk_room_emoji_list"/>
    <View
        android:id="@+id/space_view"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        app:layout_constraintTop_toBottomOf="@+id/talk_room_emoji_list"/>
</androidx.constraintlayout.widget.ConstraintLayout>
