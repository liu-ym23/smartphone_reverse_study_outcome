<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/cj_unify_double_verify_panel"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="552dp">
    <ImageView
        android:id="@+id/iv_close"
        android:padding="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/cj_pay_icon_titlebar_left_round_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_close">
        <TextView
            android:textSize="@dimen/cj_pay_font_size_15"
            android:textColor="?attr/cj_pay_text_primary"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/cj_unify_pay_order_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/cj_pay_padding_24"
            android:layout_marginEnd="@dimen/cj_pay_padding_24"/>
        <include
            android:id="@+id/cj_unify_amount_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cj_pay_padding_8"
            layout="@layout/cj_pay_amount_view_layout"/>
        <include
            android:id="@+id/cj_unify_voucher_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cj_pay_padding_8"
            layout="@layout/cj_pay_voucher_layout"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_account_info"
            android:background="@drawable/cj_pay_bg_r8_gray"
            android:paddingLeft="@dimen/cj_pay_padding_16"
            android:paddingTop="@dimen/cj_pay_padding_12"
            android:paddingRight="@dimen/cj_pay_padding_16"
            android:paddingBottom="@dimen/cj_pay_padding_12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cj_pay_padding_12"
            android:layout_marginTop="@dimen/cj_pay_padding_20"
            android:layout_marginRight="@dimen/cj_pay_padding_12">
            <TextView
                android:textSize="@dimen/cj_pay_font_size_13"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
                android:ellipsize="end"
                android:id="@+id/tv_account_tip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cj_unify_account_tip"
                android:singleLine="true"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cj_pay_padding_12">
                <ImageView
                    android:id="@+id/iv_avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="centerCrop"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:textSize="@dimen/cj_pay_font_size_15"
                        android:textColor="?attr/cj_pay_text_primary"
                        android:id="@+id/tv_nick_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="@dimen/cj_pay_font_size_13"
                        android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
                        android:id="@+id/tv_mobile_mask"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cj_pay_padding_2"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
        android:textSize="@dimen/cj_pay_font_size_16"
        android:gravity="center"
        android:id="@+id/btn_confirm"
        android:layout_width="0dp"
        android:layout_height="@dimen/cj_pay_height_48"
        android:layout_marginBottom="@dimen/cj_pay_padding_16"
        android:layout_marginStart="@dimen/cj_pay_padding_12"
        android:layout_marginEnd="@dimen/cj_pay_padding_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
