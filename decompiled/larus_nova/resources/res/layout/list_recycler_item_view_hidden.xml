<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="76dp">
    <View
        android:background="@color/ud_N100"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/text_title"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/list_item_hidden"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/Doc_List_HiddenFolders"
        android:paddingStart="24dp"
        android:paddingEnd="0dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/list_item_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tint="@color/ud_N500"
        android:layout_marginEnd="22dp"
        app:srcCompat="@drawable/ud_icon_right_outlined"/>
    <View
        android:layout_gravity="bottom"
        android:background="@color/ud_N300"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="9dp"/>
</FrameLayout>
