<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.larus.common_ui.widget.ShadowLayout
        android:id="@+id/shadow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:ux_shadow_color="#29000000"
        app:ux_shadow_offset_x="?attr/larus_dp_0"
        app:ux_shadow_offset_y="?attr/larus_dp_6"
        app:ux_shadow_radius="?attr/larus_dp_12"
        app:ux_shadow_size="?attr/larus_dp_24">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/content"
            android:background="?attr/larus_base_2_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_18"
            android:layout_marginBottom="?attr/larus_dp_30"
            android:layout_marginStart="?attr/larus_dp_24"
            android:layout_marginEnd="?attr/larus_dp_10">
            <FrameLayout
                android:id="@+id/menu_copy"
                android:background="?attr/larus_bg_paste_popup_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.larus.common_ui.widget.roundlayout.RoundTextView
                    android:textSize="?attr/larus_sp_14"
                    android:textColor="?attr/larus_neutral_100"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="?attr/larus_dp_44"
                    android:text="@string/larus_keyboard_longpress_paste"
                    android:layout_marginStart="?attr/larus_dp_16"
                    android:layout_marginEnd="?attr/larus_dp_16"/>
            </FrameLayout>
            <View
                android:id="@+id/divider"
                android:background="#1a000000"
                android:layout_width="0.5dp"
                android:layout_height="match_parent"/>
            <FrameLayout
                android:id="@+id/menu_copy_and_send"
                android:background="?attr/larus_bg_paste_popup_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="?attr/larus_sp_14"
                    android:textColor="?attr/larus_neutral_100"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="?attr/larus_dp_44"
                    android:text="@string/larus_keyboard_longpress_pasteAndSend"
                    android:layout_marginStart="?attr/larus_dp_16"
                    android:layout_marginEnd="?attr/larus_dp_12"/>
            </FrameLayout>
        </LinearLayout>
    </com.larus.common_ui.widget.ShadowLayout>
</merge>
