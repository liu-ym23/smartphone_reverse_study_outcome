<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.widget.roundcorner.RoundCornerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_region"
    android:background="#000000"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constrainedHeight="true"
    app:layout_constraintDimensionRatio="h,16:9"
    app:ttlive_leftBottomRadius="12dp"
    app:ttlive_leftTopRadius="12dp"
    app:ttlive_rightBottomRadius="12dp"
    app:ttlive_rightTopRadius="12dp">
    <TextureView
        android:id="@+id/sf_preview_texture_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/cover_iv"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"/>
    <View
        android:id="@+id/mask_view"
        android:background="#44000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.live.ktv.common.view.PreviewProgressView
        android:id="@+id/preview_progress"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/preview_start_btn"
        android:background="@drawable/ttlive_solo_ktv_preview_play_ic"
        android:visibility="gone"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_marginTop="15dp"
        app:layout_constraintBottom_toTopOf="@+id/preview_progress"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.bytedance.android.livesdk.widget.roundcorner.RoundCornerConstraintLayout>
