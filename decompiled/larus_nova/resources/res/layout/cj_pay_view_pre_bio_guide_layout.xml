<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/pre_bio_guide_root_layout"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/guide_switch_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12sp"
            android:textColor="?attr/cj_pay_text_tertiary"
            android:gravity="left"
            android:id="@+id/tv_switch_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:layout_toLeftOf="@+id/switch_guide"
            android:layout_centerInParent="true"/>
        <com.android.ttcjpaysdk.base.ui.component.CJSwitchView
            android:id="@+id/switch_guide"
            android:layout_width="24dp"
            android:layout_height="14dp"
            android:layout_alignParentRight="true"
            android:layout_centerInParent="true"
            app:cjSwitchThumbDiameter="12dp"
            app:switchPadding="1dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/guide_checkbox_layout"
        android:visibility="gone"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.android.ttcjpaysdk.base.theme.widget.CJPayStandardCircleCheckbox
            android:id="@+id/checkbox_guide"
            android:layout_width="16dp"
            android:layout_height="16dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="?attr/cj_pay_text_tertiary"
            android:gravity="left"
            android:id="@+id/tv_checkbox_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:includeFontPadding="false"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
        android:textSize="15sp"
        android:textColor="@color/cj_pay_color_white"
        android:gravity="center"
        android:id="@+id/btn_open_and_confirm_pay"
        android:background="@drawable/cj_pay_bg_red_btn_radis_4"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_custom_button_height_44"
        android:includeFontPadding="false"/>
</LinearLayout>
