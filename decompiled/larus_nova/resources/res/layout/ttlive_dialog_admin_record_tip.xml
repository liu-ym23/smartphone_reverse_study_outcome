<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/ttlive_bg_admin_record"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="13dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/mTvAdminRecordGo"
        android:background="@drawable/ttlive_bg_admin_record_btn_red"
        android:layout_width="64dp"
        android:layout_height="28dp"
        android:layout_marginLeft="8dp"
        android:text="@string/ttlive_admin_record_tip_go"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/mTvAdminRecordGo"
        android:layout_toStartOf="@+id/mTvAdminRecordGo">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ttlive_ic_admin_record_shot"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/black"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="@string/ttlive_admin_record_tip_title"
            android:singleLine="true"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="13dp"
        android:textColor="#80161823"
        android:ellipsize="end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="36dp"
        android:layout_marginTop="2dp"
        android:text="@string/ttlive_admin_record_tip_desc"
        android:singleLine="true"
        android:layout_below="@+id/ll_title"
        android:layout_alignRight="@+id/ll_title"
        android:layout_marginStart="36dp"
        android:layout_alignEnd="@+id/ll_title"/>
</RelativeLayout>
