<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="325dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/voice_chat_thinking"
        android:visibility="gone"
        android:layout_width="82dp"
        android:layout_height="59dp"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center"
        android:id="@+id/voice_chat_voice_wave"
        android:visibility="gone"
        android:layout_width="325dp"
        android:layout_height="325dp"/>
    <com.bytedance.android.live.profit.format.voicechat.view.HollowImageView
        android:layout_gravity="center"
        android:id="@+id/voice_chat_avatar_bg"
        android:visibility="invisible"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:src="@drawable/ttlive_format_voice_chat_avatar_bg"
        app:hole_radius="64.5dp"/>
    <com.bytedance.android.live.profit.format.voicechat.view.CircleProgressView
        android:layout_gravity="center"
        android:id="@+id/voice_chat_progress"
        android:layout_width="141dp"
        android:layout_height="141dp"
        app:progressColor="@color/white"
        app:progressWidth="6dp"/>
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerImageView
        android:layout_gravity="center"
        android:id="@+id/voice_chat_avatar"
        android:layout_width="129dp"
        android:layout_height="129dp"
        android:scaleType="centerCrop"
        android:alpha="0.8"
        app:ttlive_allRadius="64.5dp"/>
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerImageView
        android:layout_gravity="center"
        android:id="@+id/voice_chat_ai_tag"
        android:background="@color/white"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginLeft="45.5dp"
        android:layout_marginTop="45.5dp"
        android:scaleType="centerCrop"
        app:ttlive_allRadius="19dp"/>
</FrameLayout>
