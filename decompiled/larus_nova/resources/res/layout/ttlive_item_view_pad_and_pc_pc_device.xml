<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="65dp">
    <ImageView
        android:id="@+id/ivPlayStatus"
        android:background="@drawable/ttlive_selector_pc_device_play"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieLinking"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivPlayStatus"
        app:layout_constraintEnd_toEndOf="@+id/ivPlayStatus"
        app:layout_constraintLeft_toLeftOf="@+id/ivPlayStatus"
        app:layout_constraintRight_toRightOf="@+id/ivPlayStatus"
        app:layout_constraintStart_toStartOf="@+id/ivPlayStatus"
        app:layout_constraintTop_toTopOf="@+id/ivPlayStatus"
        app:lottie_autoPlay="false"
        app:lottie_cacheStrategy="strong"
        app:lottie_fileName="ttlive_cast_screen_pc_loading.json"
        app:lottie_loop="true"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/tvDeviceName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="52dp"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/ivPlayStatus"
        app:layout_constraintLeft_toRightOf="@+id/ivPlayStatus"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivPlayStatus"/>
    <View
        android:id="@+id/vDivider"
        android:background="@color/ttlive_std_line_white_3"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
