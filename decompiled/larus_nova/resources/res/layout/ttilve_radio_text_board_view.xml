<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_radio_text_container_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="18dp"
        android:textColor="#ffffff"
        android:gravity="center_horizontal"
        android:id="@+id/radio_text_container_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="今晚，祝你睡个好觉"
        android:layout_marginStart="34dp"
        android:layout_marginEnd="34dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/radio_text_container_separator"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="18dp"
        android:layout_marginStart="34dp"
        android:layout_marginEnd="34dp"
        app:layout_constraintTop_toBottomOf="@+id/radio_text_container_title"/>
    <com.bytedance.android.live.liveinteract.view.RadioTextRecyclerView
        android:id="@+id/radio_text_container_rv"
        android:fadingEdgeLength="40dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="30dp"
        android:requiresFadingEdge="vertical"
        android:layout_marginStart="34dp"
        android:layout_marginEnd="34dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/radio_text_container_separator"/>
</androidx.constraintlayout.widget.ConstraintLayout>
