<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.ee.bear.facade.common.widget.RoundFrameLayout
        android:background="@color/bitable_homepage_chart_bg_color"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        app:bottom_left_radius="0dp"
        app:bottom_right_radius="0dp"
        app:top_left_radius="20dp"
        app:top_right_radius="20dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_title"
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/Bitable_HomeDashboard_MyChart_Text"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textColor="@color/ud_N900_90"
                android:gravity="center"
                android:id="@+id/edit_tv"
                android:background="@drawable/bitable_home_edit_button_bg_normal_mode"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Bitable_HomeDashboard_Edit_Button"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
        </LinearLayout>
    </com.bytedance.ee.bear.facade.common.widget.RoundFrameLayout>
    <View
        android:id="@+id/divider"
        android:background="@color/line_divider_default"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
</merge>
