<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.awemeopen.apps.framework.profile.view.ProfileTabView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textColor="@color/aos_profile_tab_text_color_selector"
        android:gravity="center"
        android:id="@android:id/text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_centerInParent="true"
        style="@style/font_size_30"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textColor="@color/aos_text_primary"
        android:id="@+id/description"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/aos_visible_to_self"
        android:drawablePadding="1.5dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:drawableStart="@drawable/aos_profile_ic_tab_locked"/>
</com.bytedance.awemeopen.apps.framework.profile.view.ProfileTabView>
