<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.locallife.pdp.headimage.view.HeadImageView
        android:id="@+id/head_image_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/container_point_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.locallife.pdp.headimage.view.TextTabView
        android:layout_gravity="end|bottom"
        android:id="@+id/tab_view"
        android:background="#80161823"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginBottom="20dp"
        android:layout_marginEnd="16dp"/>
    <View
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/half_screen_anchor_view"
        android:background="@drawable/life_pdp_half_screen_anchor_bg"
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"/>
</FrameLayout>
