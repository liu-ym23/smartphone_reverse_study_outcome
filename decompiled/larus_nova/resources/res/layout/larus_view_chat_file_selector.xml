<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="?attr/larus_neutral_transparent_2"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_1"/>
    <FrameLayout
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingRight="?attr/larus_dp_16"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_98">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="start|top"
            android:orientation="horizontal"
            android:id="@+id/chat_selected_tip_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_22">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_16"
                android:textColor="?attr/larus_neutral_100"
                android:id="@+id/chat_selected_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="?attr/larus_ic_chat_file_selector_arrow"/>
        </LinearLayout>
        <com.larus.common_ui.widget.roundlayout.RoundFrameLayout
            android:layout_gravity="end|top"
            android:id="@+id/chat_selected_next_btn"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_44"
            android:layout_marginTop="?attr/larus_dp_12"
            android:minWidth="?attr/larus_dp_92"
            app:rv_backgroundColor="?attr/larus_primary_50"
            app:rv_backgroundPressColor="?attr/larus_primary_60"
            app:rv_cornerRadius="?attr/larus_dp_12">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_15"
                android:textStyle="bold"
                android:textColor="@color/larus_static_white"
                android:gravity="center"
                android:id="@+id/chat_selected_next_text"
                android:paddingLeft="?attr/larus_dp_22"
                android:paddingRight="?attr/larus_dp_22"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
    </FrameLayout>
</LinearLayout>
