<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.scaleimageview.areacomment.CommentRectLayout
        android:id="@+id/comment_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:gravity="top"
        android:id="@+id/comment_area_add"
        android:background="@drawable/bg_shadow_top_down"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="88dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/static_white"
            android:ellipsize="end"
            android:id="@+id/back_view"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LarkCCM_Comment_Image_Back_Button"
            android:singleLine="true"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/static_white"
            android:ellipsize="end"
            android:layout_gravity="end"
            android:id="@+id/add_area_comment"
            android:background="@drawable/drive_bg_area_comment_add_text"
            android:paddingLeft="12dp"
            android:paddingTop="6dp"
            android:paddingRight="12dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LarkCCM_Comment_Image_CommentMore_Button"
            android:singleLine="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</FrameLayout>
