<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_dialog_inroom_user"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_gravity="center_horizontal"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="18dp"
        android:text="@string/ttlive_live_aujust_guest_position_title"/>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="center_horizontal"
        android:id="@+id/rv_adjust_guest_position"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"/>
    <Button
        android:textColor="@color/ttlive_text_white"
        android:layout_gravity="center_horizontal"
        android:id="@+id/confirm_btn_adjust_guest_position"
        android:background="@drawable/ttlive_bg_adjust_guest_position_comfirm_btn_selected"
        android:layout_width="343dp"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="34dp"
        android:text="@string/ttlive_chat_channel_dialog_link_tips_sure"/>
</LinearLayout>
