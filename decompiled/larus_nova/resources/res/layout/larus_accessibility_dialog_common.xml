<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:paddingLeft="?attr/larus_dp_48"
    android:paddingRight="?attr/larus_dp_48"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/larus_bg_round_full"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.facebook.drawee.view.SimpleDraweeView
            android:gravity="center"
            android:id="@+id/dialog_top_image"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_25"/>
        <TextView
            android:textSize="?attr/larus_dp_18"
            android:textColor="@color/larus_neutral_100"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/dialog_title"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_24"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_20"
            android:layout_marginEnd="?attr/larus_dp_20"/>
        <TextView
            android:textSize="?attr/larus_dp_15"
            android:textColor="@color/larus_neutral_70"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/dialog_message"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_8"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_20"
            android:layout_marginEnd="?attr/larus_dp_20"/>
        <View
            android:background="@drawable/larus_item_divider"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_0_5"
            android:layout_marginTop="?attr/larus_dp_24"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_48">
            <TextView
                android:textSize="?attr/larus_dp_16"
                android:textColor="@color/larus_neutral_100"
                android:gravity="center"
                android:id="@+id/cancel"
                android:background="@drawable/larus_bg_leftdown_selector"
                android:layout_width="?attr/larus_dp_0"
                android:layout_height="match_parent"
                android:text="@string/larus_bot_profile_pic_crop_cancel"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"/>
            <View
                android:layout_gravity="center_horizontal"
                android:id="@+id/divider"
                android:background="@drawable/larus_item_divider"
                android:layout_width="?attr/larus_dp_0_5"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="?attr/larus_dp_16"
                android:textColor="@color/larus_neutral_100"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/confirm"
                android:background="@drawable/larus_bg_rightdown_selector"
                android:layout_width="?attr/larus_dp_0"
                android:layout_height="match_parent"
                android:text="@string/larus_bot_profile_pic_crop_save"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
