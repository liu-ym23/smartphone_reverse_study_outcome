<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="268dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/digg_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
            android:textSize="14sp"
            android:textColor="@color/aos_text_tertiary"
            android:gravity="center"
            android:id="@+id/profile_dmttextview2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/aos_follow_hint_txt4"
            android:maxLines="1"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/digg_count"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/aos_text_primary"
            android:gravity="center"
            android:id="@+id/digg_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="40"
            android:maxLines="1"
            app:fontType="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/following_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toEndOf="@+id/digg_layout"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
            android:textSize="14sp"
            android:textColor="@color/aos_text_tertiary"
            android:gravity="center"
            android:id="@+id/following_count_tag_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/aos_following"
            android:maxLines="1"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/following_count"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/aos_text_primary"
            android:id="@+id/following_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="589"
            android:maxLines="1"
            app:fontType="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:id="@+id/follower_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toEndOf="@+id/following_layout"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
            android:textSize="14sp"
            android:textColor="@color/aos_text_tertiary"
            android:gravity="center"
            android:id="@+id/profile_dmttextview4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/aos_follower"
            android:maxLines="1"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/follower_count"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/aos_text_primary"
            android:gravity="center"
            android:id="@+id/follower_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="369"
            android:maxLines="1"
            app:fontType="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
