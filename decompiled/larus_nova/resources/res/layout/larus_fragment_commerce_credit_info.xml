<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/larus_bg_credit_page_dialog"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/view_credit_indicator"
        android:background="@drawable/larus_bg_view_credit_indicator"
        android:layout_width="?attr/larus_dp_36"
        android:layout_height="?attr/larus_dp_4"
        android:layout_marginTop="?attr/larus_dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_top_close_range"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_28"
        android:contentDescription="@string/larus_accessibility_icon_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_container_credit_info"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/view_top_close_range">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout_top_credit_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_20"
            android:paddingStart="?attr/larus_dp_16">
            <TextView
                android:textSize="?attr/larus_dp_60"
                android:textStyle="bold"
                android:textColor="@color/larus_neutral_100"
                android:ellipsize="end"
                android:gravity="bottom"
                android:id="@+id/tv_credit_value"
                android:layout_width="wrap_content"
                android:layout_height="?attr/larus_dp_72"
                android:layout_marginTop="?attr/larus_dp_5"
                android:maxWidth="?attr/larus_dp_230"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/iv_credit_label"
                android:layout_width="?attr/larus_dp_12"
                android:layout_height="?attr/larus_dp_18"
                android:layout_marginTop="?attr/larus_dp_17"
                android:layout_marginStart="?attr/larus_dp_6"
                app:actualImageScaleType="fitCenter"
                app:placeholderImage="@drawable/larus_ic_lightening"
                app:placeholderImageScaleType="fitCenter"/>
            <TextView
                android:textSize="?attr/larus_dp_16"
                android:textStyle="bold"
                android:textColor="@color/larus_neutral_100"
                android:id="@+id/tv_credit_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_17"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="?attr/larus_dp_4"/>
            <TextView
                android:textSize="?attr/larus_dp_10"
                android:textColor="@color/larus_ic_learn_more_blue"
                android:id="@+id/tv_learn_more"
                android:background="@drawable/larus_bg_credit_learn_more"
                android:paddingTop="?attr/larus_dp_2"
                android:paddingBottom="?attr/larus_dp_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_17"
                android:paddingStart="?attr/larus_dp_6"
                android:paddingEnd="?attr/larus_dp_6"
                android:layout_marginStart="?attr/larus_dp_6"/>
        </LinearLayout>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="@color/larus_neutral_50"
            android:id="@+id/tv_credit_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/larus_dp_16"
            android:layout_marginRight="?attr/larus_dp_16"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_credit_tasks"
            android:paddingLeft="?attr/larus_dp_16"
            android:paddingRight="?attr/larus_dp_16"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_252"
            android:layout_marginTop="?attr/larus_dp_16"
            android:layout_marginBottom="?attr/larus_dp_24"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/layout_failed_to_retry"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_376"
        app:layout_constraintTop_toBottomOf="@+id/view_top_close_range">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="?attr/larus_dp_60"
            android:layout_height="?attr/larus_dp_60"
            app:srcCompat="@drawable/larus_ic_slim_refresh_gray"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="@color/larus_neutral_50"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_20"
            android:text="@string/larus_chat_list_load_failed"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
