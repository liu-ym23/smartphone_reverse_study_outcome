<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="bottom"
        android:background="@drawable/cj_pay_bg_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_470">
        <include
            android:id="@+id/cj_pay_cvv_title_bar"
            layout="@layout/cj_pay_view_titlebar_noise_reduction_layout"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/cj_pay_text_tertiary"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="66dp"
            android:text="@string/cj_pay_cvv_input_tips"/>
        <TextView
            android:textSize="24sp"
            android:textColor="?attr/cj_pay_text_primary"
            android:gravity="center"
            android:id="@+id/cj_pay_cvv_edit_view"
            android:background="@drawable/cj_pay_bg_cvv_text_corner"
            android:layout_width="180dp"
            android:layout_height="44dp"
            android:layout_marginTop="102dp"
            android:layout_centerHorizontal="true"
            android:textAlignment="center"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#fe3824"
            android:gravity="center"
            android:id="@+id/cvv_error_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="154dp"/>
        <com.android.ttcjpaysdk.base.ui.widget.LoadingButton
            android:gravity="center"
            android:id="@+id/cj_pay_confirm_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_custom_button_height_44"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="179dp"
            android:layout_marginRight="24dp"
            app:btnText="@string/cj_pay_cvv_verify_confirm"
            app:btnTextColor="?attr/cj_pay_bg_inverse"
            app:btnTextSize="?attr/cj_pay_page_size_15"/>
        <com.android.ttcjpaysdk.base.ui.widget.TalkbackKeyboardNoiseReductionView
            android:id="@+id/cj_pay_keyboard_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:keepScreenOn="true"/>
        <include
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="50dp"
            layout="@layout/cj_pay_view_half_screen_loading_layout"/>
        <include
            android:id="@+id/cj_pay_security_panel_loading_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="50dp"
            layout="@layout/cj_pay_view_security_panel_loading_container"/>
    </RelativeLayout>
</FrameLayout>
