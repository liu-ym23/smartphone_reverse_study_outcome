<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom|center_horizontal"
    android:orientation="horizontal"
    android:paddingBottom="14dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <TextView
        android:textSize="16sp"
        android:textColor="#168ef9"
        android:gravity="center"
        android:id="@+id/tv_sub_action"
        android:background="@drawable/gamecp_game_install_sub_action_btn_bg"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:maxWidth="350dp"
        android:text="返回抖音"
        android:includeFontPadding="false"
        android:layout_weight="1"/>
    <Space
        android:layout_width="6dp"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/tv_main_action"
        android:background="@drawable/gamecp_game_install_main_action_btn_bg"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:maxWidth="350dp"
        android:text="打开游戏"
        android:includeFontPadding="false"
        android:layout_weight="1"/>
</LinearLayout>
