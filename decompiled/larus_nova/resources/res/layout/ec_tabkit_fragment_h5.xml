<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_tabkit_fragment"
    android:background="@color/white"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/ec_tabkit_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:id="@+id/ec_tabkit_background"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:actualImageScaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.shopping.store.tabkit.view.TabKitMainContainerView
            android:id="@+id/ec_tabkit_fragment_main_container_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/ec_tabkit_bottom_bar_tab_layout"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.shopping.store.tabkit.view.MixTabLayout
            android:id="@+id/ec_tabkit_top_bar_tab_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.shopping.store.tabkit.view.MixTabLayout
            android:id="@+id/ec_tabkit_bottom_bar_tab_layout"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ec_tabkit_fragment_main_container_view"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:layout_gravity="top"
        android:id="@+id/ec_tabkit_fragment_nav_bar"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/ec_tabkit_nav_bar"/>
    <FrameLayout
        android:id="@+id/ec_tabkit_fragment_status_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/tabkit_bottom_sheet_indicator"
        android:background="@drawable/seg_7_indicator_light"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="5dp"
        android:layout_marginTop="8dp"/>
</FrameLayout>
