<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/top_container"
    android:background="@drawable/facade_round_top_xxl"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/bg_float_base">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="13dp">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_title"
            android:id="@+id/cancel_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="13dp"
            android:minHeight="22dp"
            android:text="@string/LarkCCM_CM_CustomPassword_Cancel_Button"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="22dp"
            android:text="@string/LarkCCM_CM_CustomPassword_ModifyPassword_Button"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_link_normal"
            android:id="@+id/save_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dp_16"
            android:minHeight="22dp"
            android:text="@string/LarkCCM_CM_CustomPassword_Save_Button"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <View
        android:background="@color/line_divider_default"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:text="@string/LarkCCM_CM_CustomPassword_Password_Title"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_link_hover"
            android:id="@+id/create_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/dp_16"
            android:text="@string/LarkCCM_CM_CustomPassword_RandomGenerated_Button"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <com.bytedance.ee.bear.widgets.universedesign.SpaceEditText
        android:textSize="16sp"
        android:id="@+id/edit_password"
        android:background="@color/udtoken_component_outlined_bg"
        android:paddingLeft="12dp"
        android:paddingTop="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginRight="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_12"
        android:hint="@string/LarkCCM_CM_CustomPassword_EnterNew_Placeholder"
        android:cursorVisible="true"
        android:maxLines="1"
        android:singleLine="true"
        android:inputType="textEmailAddress"
        app:ud_backgroundColor="@color/ud_edittext_white_bg"
        app:ud_editText_clearBtnEnabled="true"
        app:ud_editText_iconHeight="@dimen/space_kit_len_16"
        app:ud_editText_iconWidth="@dimen/space_kit_len_16"
        app:ud_strokeColor="@color/ud_edittext_stroke"
        app:ud_strokeWidth="1dp"
        style="@style/UDEditText"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/level_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginBottom="@dimen/dp_4">
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/text_title"
            android:gravity="center"
            android:id="@+id/level_tx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16sp"
            android:text="@string/LarkCCM_CM_CustomPassword_Save_Button"/>
        <View
            android:gravity="center"
            android:id="@+id/level_first"
            android:background="@color/function_success_600"
            android:layout_width="21dp"
            android:layout_height="4dp"
            android:layout_marginLeft="@dimen/dp_4"/>
        <View
            android:gravity="center"
            android:id="@+id/level_sec"
            android:background="@color/function_success_600"
            android:layout_width="21dp"
            android:layout_height="4dp"
            android:layout_marginLeft="@dimen/dp_2"/>
        <View
            android:gravity="center"
            android:id="@+id/level_third"
            android:background="@color/function_success_600"
            android:layout_width="21dp"
            android:layout_height="4dp"
            android:layout_marginLeft="@dimen/dp_2"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/icon_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"/>
    <View
        android:background="@color/line_divider_default"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_marginRight="@dimen/dp_16"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/icon_n2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_8"
        android:text="@string/LarkCCM_CM_CustomPassword_AvoidPersonalInfoInAPassword_Desc"/>
</LinearLayout>
