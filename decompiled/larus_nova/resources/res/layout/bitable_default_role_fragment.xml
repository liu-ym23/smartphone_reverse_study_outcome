<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_base"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/role_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>
        <RelativeLayout
            android:id="@+id/disable_strategy"
            android:background="@drawable/facade_round_around_xxl"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:backgroundTint="@color/bg_body">
            <TextView
                android:textSize="17sp"
                android:textColor="@color/function_danger_500"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Bitable_AdvancedPermissionsInherit_NotAssignedRoles_NoPermissions_Option"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/disable_strategy_select"
                android:layout_alignParentStart="true"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/disable_strategy_select"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:tint="@color/primary_pri_500"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_alignParentEnd="true"
                app:srcCompat="@drawable/ud_icon_list_check_bold_outlined"/>
        </RelativeLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
