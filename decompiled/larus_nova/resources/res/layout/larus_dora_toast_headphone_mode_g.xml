<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/container_layout"
    android:background="@drawable/larus_dora_toast_wearing_detection_background"
    android:padding="?attr/larus_dp_8"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:elevation="?attr/larus_dp_5">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dora_g_headphone_mode_toast_content_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/larus_neutral_100"
            android:ellipsize="end"
            android:id="@+id/dora_g_headphone_mode_toast_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="?attr/larus_dp_184"
            android:maxLines="1"
            android:singleLine="true"
            app:layout_constraintBottom_toTopOf="@+id/dora_g_headphone_mode_toast_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_12"
            android:textColor="@color/larus_neutral_50"
            android:ellipsize="end"
            android:id="@+id/dora_g_headphone_mode_toast_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_2"
            android:maxWidth="?attr/larus_dp_184"
            android:maxLines="1"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dora_g_headphone_mode_toast_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/dora_g_headphone_mode_toast_icon"
        android:layout_width="?attr/larus_dp_64"
        android:layout_height="?attr/larus_dp_48"
        android:src="@null"
        android:layout_marginStart="?attr/larus_dp_8"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/dora_g_headphone_mode_toast_content_layout"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
