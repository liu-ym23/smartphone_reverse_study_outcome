<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/extendScopeChecker"
        android:background="@drawable/facade_round_around_xl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/space_kit_len_52"
        android:paddingStart="@dimen/space_kit_len_16"
        android:paddingEnd="@dimen/space_kit_len_16"
        android:backgroundTint="@color/bg_float">
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_title"
            android:id="@+id/extendScopeCheckerTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <com.larksuite.component.universe_design.badge.UDBadgeView
            android:id="@+id/guideBadge"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/space_kit_len_16"
            android:layout_marginStart="@dimen/space_kit_len_12"
            app:ud_badge_text="@string/Bitable_Common_NewStatus"
            style="@style/UDBadge.Text"/>
        <FrameLayout
            android:id="@+id/extendScopeCheckBoxContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.larksuite.component.universe_design.udswitch.UDSwitch
                android:id="@+id/extendScopeCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:layout_marginStart="@dimen/space_kit_len_12"/>
        </FrameLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/extendScopeTvLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_14"
        android:layout_marginBottom="@dimen/space_kit_len_2">
        <TextView
            android:textSize="@dimen/space_kit_font_14"
            android:textColor="@color/text_placeholder"
            android:id="@+id/extendScopeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <FrameLayout
        android:background="@drawable/facade_round_around_xl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_kit_len_16"
        android:backgroundTint="@color/bg_float">
        <com.bytedance.ee.bear.bitable.fieldedit.view.edit.extendfield.ExtendFieldListView
            android:id="@+id/itemRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</LinearLayout>
