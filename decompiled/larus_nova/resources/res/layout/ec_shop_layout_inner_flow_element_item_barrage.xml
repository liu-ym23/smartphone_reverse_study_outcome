<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.bytedance.android.window.shop.innerflow.holder.element.barrage.BarrageBackgroundView
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/ec_shop_inner_flow_item_barrage_text"
            app:layout_constraintLeft_toLeftOf="@+id/ec_shop_inner_flow_item_barrage_text"
            app:layout_constraintRight_toRightOf="@+id/ec_shop_inner_flow_item_barrage_text"
            app:layout_constraintTop_toTopOf="@+id/ec_shop_inner_flow_item_barrage_text"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="#ffffffff"
            android:ellipsize="end"
            android:id="@+id/ec_shop_inner_flow_item_barrage_text"
            android:paddingLeft="11dp"
            android:paddingTop="11dp"
            android:paddingRight="10dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="500dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="4dp">
        <TextView
            android:textSize="18dp"
            android:textStyle="italic|bold"
            android:textColor="#ffffffff"
            android:layout_gravity="bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ec_shop_inner_flow_product_barrage_icon"
            android:shadowColor="#4d000000"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="1"/>
        <TextView
            android:textSize="24dp"
            android:textStyle="italic|bold"
            android:textColor="#ffffffff"
            android:layout_gravity="bottom"
            android:id="@+id/ec_shop_inner_flow_item_barrage_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1dp"
            android:shadowColor="#4d000000"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="1"/>
    </LinearLayout>
</LinearLayout>
