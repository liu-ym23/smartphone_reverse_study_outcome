<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/cj_pay_color_gray_248"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/page_scroll_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_above="@+id/layout_bottom"
        android:overScrollMode="never">
        <RelativeLayout
            android:id="@+id/scroll_inner_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"/>
            <ImageView
                android:id="@+id/iv_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_below="@+id/layout_titlebar"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_below="@+id/iv_icon"
                android:layout_centerHorizontal="true"/>
            <RelativeLayout
                android:gravity="center_horizontal"
                android:id="@+id/layout_total_value"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_below="@+id/tv_status">
                <TextView
                    android:textSize="40sp"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:id="@+id/cj_pay_total_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.05"/>
                <TextView
                    android:textSize="28sp"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:id="@+id/cj_pay_total_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="2dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/cj_pay_currency_unit"
                    android:layout_toLeftOf="@+id/cj_pay_total_value"
                    android:layout_alignBottom="@+id/cj_pay_total_value"/>
            </RelativeLayout>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cj_pay_color_orange_FF6E26"
                android:ellipsize="end"
                android:id="@+id/tv_discount_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_below="@+id/layout_total_value"
                android:layout_centerHorizontal="true"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_detail_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="28dp"
                android:layout_marginRight="16dp"
                android:layout_below="@+id/tv_discount_info"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_lynx_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_below="@+id/layout_detail_info"/>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_bottom"
        android:background="@color/cj_pay_color_gray_248"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <Button
            android:textSize="15sp"
            android:textColor="@color/cj_pay_color_black_161823"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/btn_bottom"
            android:background="@drawable/cj_pay_bg_round_corner_btn_radius_4"
            android:visibility="gone"
            android:layout_width="160dp"
            android:layout_height="42dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="28dp"/>
        <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
            android:id="@+id/bottom_insurance_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:layout_alignParentBottom="true"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/layout_titlebar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/cj_pay_color_black_161823"
            android:gravity="center"
            android:id="@+id/tv_right_top"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginRight="16dp"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
</RelativeLayout>
