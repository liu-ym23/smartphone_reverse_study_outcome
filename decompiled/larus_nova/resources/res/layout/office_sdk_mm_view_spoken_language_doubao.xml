<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="@dimen/office_sdk_mm_half_screen_dialog_padding_bottom_doubao"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.ss.android.lark.officesdk.minutes.ui.foundation.widget.titlebar.MmTitleBarView
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tbv_title_text="@string/View_G_Record_SpeakingIn_Option"/>
    <com.larksuite.component.ignition.widget.setting_group.SettingGroupLayout
        android:orientation="vertical"
        android:id="@+id/mmSpokenLanguageLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="8dp"
        android:minHeight="104dp"
        app:itemBackgroundColor="@color/flow_ud_bg_base_4">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLanguageList"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.larksuite.component.ignition.widget.setting_group.SettingGroupLayout>
</LinearLayout>
