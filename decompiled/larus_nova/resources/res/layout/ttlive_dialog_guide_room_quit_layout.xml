<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/dialog_room_quit_layout"
    android:background="@drawable/ttlive_bg_room_quit_dialog"
    android:layout_width="280dp"
    android:layout_height="300dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center"
        android:id="@+id/ttlive_dialog_guide_room_quit_background"
        android:background="#f0f0f0"
        android:layout_width="match_parent"
        android:layout_height="140dp"/>
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="#181823"
        android:layout_gravity="center_horizontal"
        android:id="@+id/ttlive_dialog_guide_room_quit_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/ttlive_guide_room_quit_title"/>
    <TextView
        android:textSize="14dp"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/ttlive_dialog_guide_room_quit_desc"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ttlive_guide_room_quit_content"/>
    <View
        android:background="#1e181823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="24dp"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#181823"
        android:layout_gravity="center_horizontal"
        android:id="@+id/ttlive_dialog_guide_room_quit_action_title"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_guide_room_quit_ok"/>
</LinearLayout>
