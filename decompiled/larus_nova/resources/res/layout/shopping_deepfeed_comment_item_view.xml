<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_comment_text_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp">
        <LinearLayout
            android:gravity="top"
            android:orientation="horizontal"
            android:id="@+id/layout_comment_top_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.facebook.drawee.view.SimpleDraweeView
                android:layout_gravity="center"
                android:id="@+id/iv_comment_avatar"
                android:layout_width="18dp"
                android:layout_height="18dp"
                app:actualImageScaleType="centerCrop"
                app:placeholderImage="@drawable/product_deep_feed_placeholder_skeleton"
                app:placeholderImageScaleType="centerCrop"
                app:roundAsCircle="true"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/layout_comment_inline_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="14dp"
                    android:textColor="#f2ffffff"
                    android:ellipsize="end"
                    android:id="@+id/tv_comment_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/iv_comment_user_icon"
                    android:visibility="gone"
                    android:layout_width="28dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    app:actualImageScaleType="fitCenter"/>
                <View
                    android:id="@+id/view_comment_divider"
                    android:background="@drawable/shopping_deepfeed_comment_divider_bg"
                    android:visibility="visible"
                    android:layout_width="1dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"/>
                <com.bytedance.android.shopping.deepfeed.ui.view.DeepFeedMaskTextView
                    android:textSize="14dp"
                    android:textColor="#f2ffffff"
                    android:id="@+id/tv_comment_content_first_line"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
        <com.bytedance.android.shopping.deepfeed.ui.view.DeepFeedMaskTextView
            android:textSize="14dp"
            android:textColor="#f2ffffff"
            android:id="@+id/tv_comment_content_second_line"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="bottom|center_horizontal"
        android:layout_gravity="end|bottom"
        android:orientation="horizontal"
        android:id="@+id/layout_comment_more"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14dp"
            android:textColor="#f2ffffff"
            android:id="@+id/tv_comment_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="更多"/>
        <com.bytedance.android.shopping.deepfeed.ui.view.AdapterScreenImageView
            android:layout_gravity="center"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/shopping_deep_feed_comment_more_arrow"
            android:layout_marginStart="1dp"/>
    </LinearLayout>
</FrameLayout>
