<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.window.shop.widget.WindowHeadBubbleDoubleCard xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ec_window_bubble_background"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/commerce_color_161823"
        android:id="@+id/ec_window_head_bubble_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/commerce_color_8c161823"
        android:id="@+id/ec_window_head_bubble_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="6dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ec_window_head_bubble_title"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/commerce_color_8c161823"
        android:id="@+id/ec_window_head_bubble_just_watched"
        android:background="@drawable/shape_shopping_window_just_watched_background"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:text="@string/ec_window_just_watched"
        app:layout_constraintBottom_toBottomOf="@+id/ec_window_head_bubble_title"
        app:layout_constraintLeft_toRightOf="@+id/ec_window_head_bubble_title"
        app:layout_constraintTop_toTopOf="@+id/ec_window_head_bubble_title"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/ec_window_head_bubble_entrance"
        android:background="@drawable/ec_window_ic_bubble_right_arrow"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginTop="15dp"
        android:layout_marginRight="12dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ec_window_head_bubble_subtitle">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/ec_window_head_bubble_product_one"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="7dp"
            android:layout_weight="1"
            app:roundedCornerRadius="@dimen/ec_window_card_radius"
            app:viewAspectRatio="1"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/ec_window_head_bubble_product_two"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:layout_weight="1"
            app:roundedCornerRadius="@dimen/ec_window_card_radius"
            app:viewAspectRatio="1"/>
    </LinearLayout>
</com.bytedance.android.window.shop.widget.WindowHeadBubbleDoubleCard>
