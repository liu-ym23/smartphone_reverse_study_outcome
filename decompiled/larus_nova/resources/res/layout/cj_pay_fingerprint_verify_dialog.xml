<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:id="@+id/finger_dialog_layout"
    android:background="@drawable/cj_pay_bg_common_dialog_radius_8"
    android:layout_width="250dp"
    android:layout_height="170dp">
    <ImageView
        android:id="@+id/tt_cj_pay_common_dialog_cancel_btn_view"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="@dimen/cj_pay_padding_12"
        android:layout_marginTop="@dimen/cj_pay_padding_12"
        android:src="?attr/cj_pay_icon_titlebar_left_close_noise_reduction"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?attr/cj_pay_text_secondary"
        android:gravity="center"
        android:id="@+id/tt_cj_pay_common_dialog_confirm_btn_view"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="@dimen/cj_pay_padding_12"
        android:layout_marginRight="@dimen/cj_pay_padding_12"
        android:text="@string/cj_pay_input_password"
        android:layout_alignParentRight="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/tt_cj_pay_common_dialog_title_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/cj_pay_padding_24"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/fingerprint_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="36dp"
            android:src="@drawable/cj_pay_icon_fingerprint_blue"/>
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/cj_pay_text_primary"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cj_pay_fingerprint_verify_tips"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="12sp"
            android:textColor="?attr/cj_pay_text_secondary"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_sub_tips"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:includeFontPadding="false"/>
    </LinearLayout>
</RelativeLayout>
