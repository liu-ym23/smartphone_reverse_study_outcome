<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larksuite.component.universe_design.progress.UDProgress
        android:id="@+id/progress_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="25"
        android:layout_marginStart="@dimen/space_kit_len_8"
        android:layout_marginEnd="@dimen/space_kit_len_8"
        app:ud_progress_indicatorCornerRadius="5dp"
        app:ud_progress_thickness="10dp"
        app:ud_progress_trackColor="@color/ud_N300"/>
    <View
        android:id="@+id/unedit_placeholder"
        android:visibility="gone"
        android:layout_width="@dimen/space_kit_len_41"
        android:layout_height="@dimen/space_kit_len_1"/>
    <TextView
        android:textSize="@dimen/space_kit_font_14"
        android:textColor="@color/text_title"
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:id="@+id/progress_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_weight="14"
        android:layout_marginEnd="@dimen/space_kit_len_8"/>
</LinearLayout>
