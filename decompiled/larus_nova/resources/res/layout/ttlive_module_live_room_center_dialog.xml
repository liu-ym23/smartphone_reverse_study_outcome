<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/ttlive_white"
    android:layout_width="300dp"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/live_dialog_top_block"
        android:layout_width="match_parent"
        android:layout_height="24dp"/>
    <TextView
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_live_dialog_title"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/live_dialog_title"
        android:background="@color/ttlive_white"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <View
        android:id="@+id/live_dialog_title_message_block"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_live_dialog_message"
        android:gravity="center_horizontal"
        android:id="@+id/live_dialog_message"
        android:background="@color/ttlive_white"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <View
        android:id="@+id/live_dialog_bottom_block"
        android:layout_width="match_parent"
        android:layout_height="24dp"/>
    <View
        android:id="@+id/live_dialog_divider_1"
        style="@style/ttlive_live_dialog_divider_horizontal"/>
    <Button
        android:id="@+id/live_dialog_btn_1"
        style="@style/ttlive_live_dialog_button_vertical"/>
</LinearLayout>
