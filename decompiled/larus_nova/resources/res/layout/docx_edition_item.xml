<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/text_title"
        android:ellipsize="end"
        android:id="@+id/tv_edition_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_11"
        android:maxWidth="400dp"
        android:minHeight="@dimen/space_kit_len_22"
        android:singleLine="true"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_4"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_placeholder"
        android:id="@+id/tv_edition_description"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/space_kit_len_22"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_edition_name"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_edition_selected"
        android:visibility="gone"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginEnd="@dimen/dp_18"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ud_icon_list_check_bold_outlined"/>
    <View
        android:id="@+id/space_bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_12"
        app:layout_constraintTop_toBottomOf="@+id/tv_edition_description"/>
    <View
        android:id="@+id/divider"
        android:background="@color/line_divider_default"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/space_bottom"/>
</androidx.constraintlayout.widget.ConstraintLayout>
