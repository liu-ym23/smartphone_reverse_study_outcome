<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ttlive_white"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
        android:layout_gravity="center_horizontal"
        android:id="@+id/preload_progress_icon_double_ball"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/ttlive_pk_userlist_refresh_progress_anim"
        android:indeterminateBehavior="repeat"/>
    <ProgressBar
        android:layout_gravity="center_horizontal"
        android:id="@+id/preload_progress_icon_normal"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="10dp"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/ttlive_pk_userlist_refresh_progress_anim"
        android:indeterminateBehavior="repeat"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/tv_empty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/empty_image_view"
            android:layout_width="240dp"
            android:layout_height="160dp"
            app:placeholderImageScaleType="fitXY"/>
        <TextView
            android:textSize="17dp"
            android:textColor="#161823"
            android:id="@+id/empty_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/ttlive_interact_pk_no_anchor_record"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
</LinearLayout>
