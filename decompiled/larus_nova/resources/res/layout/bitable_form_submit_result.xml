<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/result_icon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:srcCompat="@drawable/ccm_empty_positive_complete"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/text_title"
            android:gravity="top|center_horizontal"
            android:id="@+id/result_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:lineSpacingExtra="1sp"/>
        <com.larksuite.component.universe_design.button.UDButton
            android:textColor="@color/static_white"
            android:layout_gravity="center"
            android:id="@+id/result_btn"
            android:background="@drawable/bitable_form_submit_bg"
            android:visibility="gone"
            android:clickable="true"
            android:layout_marginTop="30dp"
            android:text="@string/Bitable_Form_FillInAgain"
            android:layout_alignParentTop="true"
            app:ud_backgroundColor="@color/ud_button_blue_bg"
            style="@style/UDButton.Middle.Primary"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_caption"
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:id="@+id/result_msg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2sp"/>
    </LinearLayout>
</FrameLayout>
