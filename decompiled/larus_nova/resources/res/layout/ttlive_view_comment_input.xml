<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/comment_input_layout"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="12dp"
    android:layout_marginBottom="8dp"
    android:layout_weight="1">
    <RelativeLayout
        android:layout_gravity="start"
        android:id="@+id/edit_btn_audience_container"
        android:background="@drawable/ttlive_bg_edit_message_rename"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="38dp">
        <RelativeLayout
            android:layout_gravity="start"
            android:id="@+id/edit_btn_audience_container_sub_root"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="38dp">
            <FrameLayout
                android:id="@+id/my_live_container"
                android:visibility="visible"
                android:clipChildren="false"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginLeft="-1dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="-1dp">
                <com.bytedance.android.live.core.widget.HSImageView
                    android:layout_gravity="center"
                    android:id="@+id/my_live_avatar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:actualImageScaleType="fitCenter"
                    app:placeholderImage="@drawable/my_live_default_avatar"
                    app:placeholderImageScaleType="fitCenter"
                    app:roundAsCircle="true"/>
                <com.bytedance.android.live.core.widget.HSImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/my_live_avatar_border"
                    android:visibility="visible"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:actualImageScaleType="fitCenter"/>
            </FrameLayout>
            <LinearLayout
                android:id="@+id/voice_emoji_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true">
                <com.bytedance.android.live.core.widget.HSImageView
                    android:id="@+id/ai_entry"
                    android:visibility="gone"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/ttlive_comment_ai_entry"
                    app:actualImageResource="@drawable/ttlive_comment_ai_entry"/>
                <com.bytedance.android.live.core.widget.HSImageView
                    android:id="@+id/emoji_entry"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/ttlive_comment_emoji_entry"
                    app:actualImageResource="@drawable/ttlive_comment_emoji_entry"/>
                <RelativeLayout
                    android:gravity="center_vertical"
                    android:id="@+id/imemoji_contaienr"
                    android:paddingRight="2dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"/>
            </LinearLayout>
            <com.bytedance.android.live.core.widget.LiveTextView
                android:textSize="14sp"
                android:textColor="#b2ffffff"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/edit_btn_audience"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="10dp"
                android:text="@string/ttlive_say_something"
                android:singleLine="true"
                android:layout_toLeftOf="@+id/voice_emoji_container"
                android:layout_toRightOf="@+id/my_live_container"
                android:layout_toStartOf="@+id/voice_emoji_container"
                android:layout_toEndOf="@+id/my_live_container"/>
        </RelativeLayout>
        <com.bytedance.android.live.core.widget.LiveTextView
            android:textSize="15sp"
            android:textColor="#bfffffff"
            android:gravity="center"
            android:id="@+id/ogc_fixed_comment_hint"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="@string/ttlive_say_something"
            android:singleLine="true"/>
    </RelativeLayout>
</FrameLayout>
