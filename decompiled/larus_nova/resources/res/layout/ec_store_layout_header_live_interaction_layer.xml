<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ec_store_live_interaction_layer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_gravity="end|top"
        android:id="@+id/store_v3_header_live_sound_button"
        android:background="@drawable/shopping_ic_store_v3_live_sound_shut"
        android:layout_width="32sp"
        android:layout_height="32sp"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="16dp"
        android:translationZ="30dp"/>
    <View
        android:layout_gravity="top"
        android:id="@+id/ec_header_live_top_mask"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="174dp"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/ec_header_live_bottom_Info_area_mask"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="293dp"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/ec_header_live_bottom_gradual_mask"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="94dp"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/ec_header_live_bottom_extra_gradient"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/ec_header_live_bottom_block"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="119dp">
        <LinearLayout
            android:gravity="bottom"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/ec_header_live_bottom_block_info_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <LinearLayout
                android:layout_gravity="start|bottom"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <FrameLayout
                    android:layout_gravity="bottom"
                    android:id="@+id/ec_header_live_status"
                    android:layout_width="207dp"
                    android:layout_height="54dp"
                    android:layout_marginBottom="4dp"/>
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:gravity="start|top"
                    android:id="@+id/store_v3_live_title_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="215dp"
                    android:shadowColor="#26000000"
                    android:shadowDy="2"
                    android:shadowRadius="3"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/store_v3_live_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
        <com.bytedance.android.ec.store.view.ECHeaderSlideIndicator
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/ec_header_live_slide_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="97dp"
            android:layout_marginEnd="97dp"/>
    </FrameLayout>
</FrameLayout>
