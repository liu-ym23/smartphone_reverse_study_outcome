<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.widgets.BaseTitleBar
        android:id="@+id/baseTitleBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/doc_titlebar_height"
        app:layout_constraintTop_toTopOf="parent"
        app:widget_widgets_tb_divider_visible="false"/>
    <com.bytedance.ee.bear.doc.syncblock.SyncBlockLoadingLayout
        android:id="@+id/loading"
        android:background="@color/bg_body"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/baseTitleBar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
