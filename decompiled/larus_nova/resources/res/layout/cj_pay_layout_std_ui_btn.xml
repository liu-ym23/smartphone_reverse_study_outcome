<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_pay_layout_std_ui_btn_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cj_pay_std_ui_btn_above_agreement_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.android.ttcjpaysdk.base.theme.widget.CJPayCircleCheckBox
            android:id="@+id/cj_pay_std_ui_btn_above_agreement_checkbox"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
            android:ellipsize="end"
            android:id="@+id/cj_pay_std_ui_btn_above_agreement_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="16dp"
            android:text="agreement text"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/cj_pay_std_ui_btn_above_agreement_checkbox"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/cj_pay_std_ui_btn_above_agreement_expend_arrow_down"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/cj_pay_std_ui_button_expend_arrow_down"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <ImageView
            android:id="@+id/cj_pay_std_ui_btn_above_agreement_expend_arrow_up"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/cj_pay_std_ui_button_expend_arrow_up"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/cj_pay_std_ui_btn_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="@dimen/cj_pay_padding_16"
        android:layout_alignParentBottom="true"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_std_ui_btn_above_agreement_container"
        app:layout_goneMarginTop="0dp">
        <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
            android:textSize="15sp"
            android:textColor="@color/cj_pay_color_white"
            android:gravity="center"
            android:id="@+id/cj_pay_layout_std_ui_btn_button"
            android:background="@drawable/cj_pay_bg_red_btn_radis_8"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_custom_button_height_44"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/cj_pay_layout_std_ui_btn_loading"
            android:background="@color/cj_pay_color_trans"
            android:visibility="gone"
            android:layout_width="@dimen/cj_pay_padding_20"
            android:layout_height="@dimen/cj_pay_padding_20"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_white"
            android:indeterminateDuration="500"
            android:indeterminateBehavior="repeat"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cj_pay_std_ui_btn_below_agreement_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_std_ui_btn_container">
        <com.android.ttcjpaysdk.base.theme.widget.CJPayCircleCheckBox
            android:id="@+id/cj_pay_std_ui_btn_below_agreement_checkbox"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
            android:ellipsize="end"
            android:id="@+id/cj_pay_std_ui_btn_below_agreement_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="16dp"
            android:text="agreement text"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/cj_pay_std_ui_btn_below_agreement_checkbox"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/cj_pay_std_ui_btn_below_agreement_expend_arrow_down"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/cj_pay_std_ui_button_expend_arrow_down"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <ImageView
            android:id="@+id/cj_pay_std_ui_btn_below_agreement_expend_arrow_up"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/cj_pay_std_ui_button_expend_arrow_up"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
