<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.shopping.widget.square.SquareFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/dv_product_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:roundedCornerRadius="4dp"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/shopping_color_90FFFFFF"
        android:gravity="center"
        android:id="@+id/tv_more"
        android:background="@drawable/shopping_bg_feed_store_more_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/shopping_more_product"/>
</com.bytedance.android.shopping.widget.square.SquareFrameLayout>
