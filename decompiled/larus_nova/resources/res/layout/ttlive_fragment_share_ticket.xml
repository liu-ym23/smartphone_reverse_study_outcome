<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sv_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_container"
            android:paddingTop="26dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="17dp"
                android:textColor="#161823"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/iv_back"
                android:paddingLeft="19dp"
                android:paddingRight="5dp"
                android:layout_width="32dp"
                android:layout_height="16dp"
                android:src="@drawable/ttlive_ic_arrow"
                android:paddingStart="19dp"
                android:paddingEnd="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_title"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_title"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_ticket_parent_parent"
                android:layout_width="296dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_tip_bg">
                <com.bytedance.android.live.core.widget.HSImageView
                    android:id="@+id/iv_shadow"
                    android:layout_width="296dp"
                    android:layout_height="380dp"
                    app:actualImageScaleType="fitXY"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:roundBottomEnd="false"
                    app:roundBottomLeft="false"
                    app:roundBottomRight="false"
                    app:roundBottomStart="false"
                    app:roundedCornerRadius="28dp"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_ticket_parent"
                    android:layout_width="296dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.bytedance.android.live.core.widget.HSImageView
                        android:id="@+id/iv_ticket"
                        android:layout_width="match_parent"
                        android:layout_height="350dp"
                        android:layout_marginLeft="8dp"
                        android:layout_marginRight="8dp"
                        android:scaleType="centerCrop"
                        android:translationY="4dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:roundBottomEnd="false"
                        app:roundBottomLeft="false"
                        app:roundBottomRight="false"
                        app:roundBottomStart="false"
                        app:roundedCornerRadius="8dp"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_ticket_top"
                        android:background="@drawable/ttlive_bg_poster_title"
                        android:visibility="gone"
                        android:layout_width="280dp"
                        android:layout_height="90dp"
                        android:layout_marginTop="4dp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.bytedance.android.live.core.widget.HSImageView
                        android:id="@+id/iv_real_ticket"
                        android:layout_width="296dp"
                        android:layout_height="209dp"
                        app:actualImageScaleType="fitXY"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/iv_ticket"
                        app:roundTopEnd="false"
                        app:roundTopLeft="false"
                        app:roundTopRight="false"
                        app:roundTopStart="false"
                        app:roundedCornerRadius="8dp"/>
                    <TextView
                        android:textSize="17dp"
                        android:textColor="#161823"
                        android:ellipsize="end"
                        android:id="@+id/tv_ticket_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="24dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginRight="24dp"
                        android:maxLines="3"
                        android:layout_marginStart="24dp"
                        android:layout_marginEnd="24dp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/iv_real_ticket"/>
                    <TextView
                        android:textSize="15dp"
                        android:textColor="#bf161823"
                        android:id="@+id/tv_ticket_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:layout_constraintLeft_toLeftOf="@+id/tv_ticket_title"
                        app:layout_constraintTop_toBottomOf="@+id/tv_ticket_title"/>
                    <TextView
                        android:textSize="20dp"
                        android:textColor="#ffffff"
                        android:gravity="center"
                        android:id="@+id/tv_take"
                        android:background="@drawable/ttlive_bg_pay_ticket_take"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp"
                        android:layout_marginBottom="30dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_qrcode"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="28dp"
                        android:layout_marginRight="28dp"
                        android:layout_marginBottom="32dp"
                        android:layout_marginStart="28dp"
                        android:layout_marginEnd="28dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent">
                        <TextView
                            android:textSize="12.1dp"
                            android:textColor="#bf161823"
                            android:id="@+id/tv_save"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ttlive_save_to_gallery"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView
                            android:id="@+id/iv_tip_arrow"
                            android:layout_width="23dp"
                            android:layout_height="16dp"
                            android:layout_marginLeft="16dp"
                            android:src="@drawable/ttlive_ic_ticket_tip_arrow"
                            android:layout_marginStart="16dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintLeft_toRightOf="@+id/tv_save"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:textSize="12.1dp"
                            android:textColor="#bf161823"
                            android:id="@+id/tv_scan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="9dp"
                            android:text="@string/ttlive_try_scan"
                            android:layout_marginStart="9dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintLeft_toRightOf="@+id/iv_tip_arrow"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <com.bytedance.android.live.core.widget.HSImageView
                            android:id="@+id/iv_qrcode"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <ImageView
                android:id="@+id/iv_tip_bg"
                android:layout_width="227dp"
                android:layout_height="60dp"
                android:layout_marginTop="19dp"
                android:layout_marginRight="8dp"
                android:src="@drawable/ttlive_bg_tip_ticket"
                android:layout_marginEnd="8dp"
                app:layout_constraintRight_toRightOf="@+id/cl_ticket_parent_parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#000000"
                android:id="@+id/tv_sender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginTop="9dp"
                android:layout_marginStart="15dp"
                app:layout_constraintLeft_toLeftOf="@+id/iv_tip_bg"
                app:layout_constraintTop_toTopOf="@+id/iv_tip_bg"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#cc7e7e7e"
                android:id="@+id/tv_send_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                app:layout_constraintLeft_toLeftOf="@+id/tv_sender"
                app:layout_constraintTop_toBottomOf="@+id/tv_sender"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/iv_avatar"
                android:layout_width="47dp"
                android:layout_height="47dp"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="5dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_tip_bg"
                app:layout_constraintLeft_toLeftOf="@+id/cl_ticket_parent_parent"
                app:layout_constraintTop_toTopOf="@+id/iv_tip_bg"
                app:placeholderImage="@drawable/ttlive_img_avatar_empty"
                app:roundAsCircle="true"
                app:roundingBorderColor="#ffffff"
                app:roundingBorderWidth="2dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/ll_bottom_parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cl_ticket_parent_parent">
                <TextView
                    android:textSize="12dp"
                    android:textColor="#80000000"
                    android:id="@+id/tv_introduction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_live_intro"/>
                <ImageView
                    android:id="@+id/iv_introduction"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginLeft="2dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/ttlive_ic_ticket_bottom_arrow"
                    android:layout_marginStart="2dp"/>
                <View
                    android:id="@+id/v_divider"
                    android:background="#33000000"
                    android:visibility="gone"
                    android:layout_width="1dp"
                    android:layout_height="13dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#80000000"
                    android:id="@+id/tv_withdraw"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_withdraw_share_ticket"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <include
            android:visibility="gone"
            layout="@layout/ttlive_layout_disable_click_loading"/>
    </FrameLayout>
</androidx.core.widget.NestedScrollView>
