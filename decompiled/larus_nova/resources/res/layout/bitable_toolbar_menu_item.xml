<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menu_container"
    android:background="@color/bg_body"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="@color/facade_selector_item_body">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/item_main_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/menu_icon"
                android:layout_width="@dimen/space_kit_len_22"
                android:layout_height="@dimen/space_kit_len_22"
                android:tint="@color/bitable_toolbar_menu_icon_color"/>
            <com.larksuite.component.universe_design.badge.UDBadgeView
                android:layout_gravity="top|right"
                android:id="@+id/guideBadge"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                style="@style/bitable_dot_badge"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_kit_len_2">
            <TextView
                android:textSize="@dimen/space_kit_font_11"
                android:textColor="@color/primary_fill_default"
                android:id="@+id/count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_kit_len_2"/>
            <TextView
                android:textSize="@dimen/space_kit_font_11"
                android:textColor="@color/bitable_toolbar_menu_text_color"
                android:id="@+id/menu_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/tip_icon"
        android:background="@drawable/bitable_adv_perm_toolbox_tip"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="-6dp"
        android:layout_alignTop="@+id/item_main_content"
        android:layout_marginStart="24dp"
        android:layout_alignStart="@+id/item_main_content"/>
</RelativeLayout>
