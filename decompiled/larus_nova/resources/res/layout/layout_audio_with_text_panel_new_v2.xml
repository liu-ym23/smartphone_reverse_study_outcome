<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_audio_and_text_new"
    android:background="@color/bg_body_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/panel_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/audio_bg_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/audio_bg_divider"
        android:background="@color/line_border_card"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_edit"/>
    <View
        android:id="@+id/audio_circle_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/panel_bg"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/text_placeholder"
        android:id="@+id/audio_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:drawablePadding="10dp"
        android:drawableStart="@drawable/kb_ic_svg_audio_send_audio_duration"
        app:layout_constraintStart_toStartOf="@+id/input_edit"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/text_placeholder"
        android:id="@+id/audio_recognize_locale"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toTopOf="@+id/input_edit"
        app:layout_constraintEnd_toEndOf="@+id/input_edit"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.ss.android.lark.keyboard.edittext2.KeyboardFunctionEditText
        android:textSize="14dp"
        android:textColor="@color/text_title"
        android:textColorHint="@color/text_placeholder"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/input_edit"
        android:background="@null"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="8dp"
        android:maxLines="4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/audio_recognize_locale"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/text_title"
        android:gravity="center"
        android:id="@+id/warning_textView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:drawablePadding="5dp"
        android:layout_centerHorizontal="true"
        android:drawableStart="@drawable/ic_warning_filled"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/panel_bg"/>
    <com.ss.android.lark.keyboard.plugin.tool.voice.widget.AudioCircleView
        android:id="@+id/audio_circle_btn"
        android:layout_width="210dp"
        android:layout_height="210dp"
        android:layout_marginBottom="37dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@drawable/bg_asr_text_color_v2"
        android:gravity="center"
        android:id="@+id/audio_2_text_option"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="57dp"
        android:drawablePadding="5dp"
        android:layout_centerHorizontal="true"
        android:drawableEnd="@drawable/ic_text_option_icon_selector"
        app:layout_constraintBottom_toTopOf="@+id/audio_2_text_center_btn_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/audio_2_text_center_btn_layout"
        android:background="@drawable/kb_audio_send_all_btn_bg"
        android:visibility="gone"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_send_audio_only"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ud_icon_voice_outlined"
            app:tint="@color/static_white"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ProgressBar
        android:id="@+id/pb_recognizing"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/audio_2_text_center_btn_layout"
        app:layout_constraintEnd_toEndOf="@+id/audio_2_text_center_btn_layout"
        app:layout_constraintStart_toStartOf="@+id/audio_2_text_center_btn_layout"
        app:layout_constraintTop_toTopOf="@+id/audio_2_text_center_btn_layout"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@drawable/bg_asr_text_color_v2"
        android:ellipsize="none"
        android:gravity="center_horizontal"
        android:id="@+id/tv_cancel"
        android:visibility="gone"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="80dp"
        android:text="@string/Lark_IM_AudioToTextSelectLangugage_Cancel_Button"
        android:maxLines="3"
        android:drawableTop="@drawable/ic_undo_outlined_selector"
        android:drawablePadding="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/audio_circle_bg"
        app:layout_constraintEnd_toStartOf="@+id/tv_send_audio_only"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@drawable/bg_asr_text_color_v2"
        android:ellipsize="none"
        android:gravity="center_horizontal"
        android:id="@+id/tv_send_audio_only"
        android:visibility="gone"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:text="@string/Lark_Chat_SendAudioOnly"
        android:maxLines="3"
        android:drawableTop="@drawable/ic_send_audio_only_selector"
        android:drawablePadding="8dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_send_text_only"
        app:layout_constraintStart_toEndOf="@+id/tv_cancel"
        app:layout_constraintTop_toTopOf="@+id/tv_cancel"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tv_send_text_only"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/tv_send_audio_and_text"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/tv_send_audio_only"
        app:layout_constraintTop_toTopOf="@+id/tv_cancel">
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/UDText.Body0"
            android:textColor="@drawable/bg_asr_text_color_v2"
            android:ellipsize="none"
            android:gravity="center_horizontal"
            android:id="@+id/tv_send_text_only_zh"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Lark_Chat_SendTextOnly_Text"
            android:maxLines="3"
            android:drawablePadding="8dp"
            app:drawableTopCompat="@drawable/ud_icon_text_cn_outlined"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textAppearance="@style/UDText.Body0"
            android:textColor="@drawable/bg_asr_text_color_v2"
            android:ellipsize="none"
            android:gravity="center_horizontal"
            android:id="@+id/tv_send_text_only_en"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Lark_Chat_SendTextOnly_Text"
            android:maxLines="3"
            android:drawablePadding="8dp"
            app:drawableTopCompat="@drawable/ud_icon_text2_outlined"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="16dp"
        android:textColor="@drawable/bg_asr_send_all_btn_color_v2"
        android:ellipsize="none"
        android:gravity="center_horizontal"
        android:id="@+id/tv_send_audio_and_text"
        android:visibility="gone"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:text="@string/Lark_Legacy_Send"
        android:maxLines="3"
        android:drawableTop="@drawable/ic_send_all_selector_v2"
        android:drawablePadding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_send_text_only"
        app:layout_constraintTop_toTopOf="@+id/tv_cancel"/>
</androidx.constraintlayout.widget.ConstraintLayout>
