<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom|center_horizontal"
    android:layout_gravity="bottom|center_horizontal"
    android:id="@+id/panel_root"
    android:background="@color/bg_mask"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.document.editionmanager.panel.EditionPanelDragView
        android:id="@+id/edition_drag_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/edition_panel_drag_view_height"
        android:layout_marginTop="-9dp"
        app:panel_background_color="@color/bg_float"
        app:panel_show_divider="true"
        app:panel_show_drag_handler="true"
        app:panel_show_titlebar="true">
        <FrameLayout
            android:id="@+id/panel_container"
            android:background="@color/bg_body"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/loading_ll"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.bytedance.ee.bear.widgets.universedesign.SpaceLoadingImage
                    android:layout_width="@dimen/space_kit_len_20"
                    android:layout_height="@dimen/space_kit_len_20"
                    app:loading_circle_color="@color/primary_fill_default"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/text_caption"
                    android:ellipsize="end"
                    android:id="@+id/facade_fail_msg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/Doc_Facade_Loading"
                    android:lines="1"/>
            </LinearLayout>
            <com.scwang.smartrefresh.layout.SmartRefreshLayout
                android:id="@+id/edition_list_refresh"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/panel_edition_list"
                    android:background="@color/bg_body"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.scwang.smartrefresh.layout.SmartRefreshLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/loading_fail_ll"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/loading_fail_view"
                    android:layout_width="@dimen/space_kit_len_82"
                    android:layout_height="@dimen/space_kit_len_82"
                    app:srcCompat="@drawable/ccm_empty_negative_load_failed"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_caption"
                    android:ellipsize="end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/Doc_Doc_LoadFailed"
                    android:lines="1"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/loading_empty_ll"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/loading_empty_view"
                    android:layout_width="@dimen/space_kit_len_82"
                    android:layout_height="@dimen/space_kit_len_82"
                    app:srcCompat="@drawable/ccm_empty_neutral_no_content"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_caption"
                    android:ellipsize="end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/LarkCCM_Docx_VersionMgmt_NoVersionsSaved_Mob"
                    android:lines="1"/>
            </LinearLayout>
        </FrameLayout>
    </com.bytedance.ee.bear.document.editionmanager.panel.EditionPanelDragView>
</RelativeLayout>
