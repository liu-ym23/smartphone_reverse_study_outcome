<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/cj_pay_bg_face_retain_or_fail_dialog"
    android:layout_width="@dimen/cj_pay_height_280"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/cj_pay_face_retain_or_fail_dialog_title_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cj_pay_padding_24"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/cj_pay_color_black_161823"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_pay_face_retain_or_fail_dialog_title_view"
            android:paddingLeft="@dimen/cj_pay_padding_20"
            android:paddingRight="@dimen/cj_pay_padding_20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_pay_face_retain_or_fail_dialog_sub_title_view"
            android:paddingLeft="@dimen/cj_pay_padding_20"
            android:paddingRight="@dimen/cj_pay_padding_20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="@dimen/cj_pay_padding_3"/>
    </LinearLayout>
    <View
        android:id="@+id/cj_pay_face_retain_or_fail_dialog_divider"
        android:background="@color/cj_pay_color_gray_232"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_half_1"
        android:layout_marginTop="@dimen/cj_pay_padding_20"
        android:layout_below="@+id/cj_pay_face_retain_or_fail_dialog_title_layout"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/cj_pay_face_retain_or_fail_dialog_divider">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
            android:gravity="center"
            android:id="@+id/cj_pay_face_retain_or_fail_dialog_left_btn_view"
            android:layout_width="139.7dp"
            android:layout_height="48dp"
            android:singleLine="true"
            android:layout_weight="1"/>
        <View
            android:id="@+id/cj_pay_face_retain_or_fail_dialog_vertical_divider"
            android:background="@color/cj_pay_color_gray_232"
            android:layout_width="@dimen/cj_pay_height_half_1"
            android:layout_height="48dp"
            android:layout_toRightOf="@+id/cj_pay_face_retain_or_fail_dialog_left_btn_view"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/cj_pay_color_black_161823"
            android:gravity="center"
            android:id="@+id/cj_pay_face_retain_or_fail_dialog_right_btn_view"
            android:layout_width="139.7dp"
            android:layout_height="48dp"
            android:singleLine="true"
            android:layout_weight="1"
            android:layout_toRightOf="@+id/cj_pay_face_retain_or_fail_dialog_vertical_divider"/>
    </LinearLayout>
</RelativeLayout>
