<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/picture_detail_root"
    android:background="@color/aos_bg_secondary3"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fragment_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/picture_top_container"
            android:paddingTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.awemeopen.infra.base.image.AoImageView
                android:id="@+id/picture_top_return"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/aos_picture_return"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/avatar_top_2dp_guideline"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:layout_marginBottom="2dp"
                app:layout_constraintBottom_toTopOf="@+id/picture_top_avatar"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.bytedance.awemeopen.infra.base.image.AoImageView
                android:id="@+id/picture_top_avatar"
                android:visibility="gone"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/picture_top_return"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.awemeopen.apps.framework.feed.follow.util.DuxTextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="@color/aos_text_primary"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/picture_top_user_name"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/picture_top_avatar"
                app:layout_constraintLeft_toRightOf="@+id/picture_top_avatar"
                app:layout_constraintTop_toTopOf="@+id/picture_top_avatar"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/picture_top_second_line_container"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="16dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintEnd_toStartOf="@+id/picture_top_follow"
                app:layout_constraintStart_toStartOf="@+id/picture_top_user_name"
                app:layout_constraintTop_toBottomOf="@+id/picture_top_user_name">
                <com.bytedance.awemeopen.infra.base.image.AoImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/picture_top_poi_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/aos_pic_poi_under_name_light"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"/>
                <com.bytedance.awemeopen.apps.framework.feed.follow.util.DuxTextView
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:textColor="@color/aos_pic_top_primary"
                    android:id="@+id/picture_top_poi_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="北京市"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:fontFamily="sans-serif-medium"/>
                <View
                    android:layout_gravity="center_vertical"
                    android:id="@+id/picture_top_poi_divider"
                    android:background="@color/aos_pic_top_primary"
                    android:layout_width="1dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"/>
                <com.bytedance.awemeopen.apps.framework.feed.follow.util.DuxTextView
                    android:textSize="12dp"
                    android:textStyle="normal"
                    android:textColor="@color/aos_pic_top_primary"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/picture_top_poi_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
            <com.bytedance.awemeopen.infra.base.image.AoImageView
                android:id="@+id/picture_douyin_icon"
                android:visibility="gone"
                android:layout_width="56dp"
                android:layout_height="20dp"
                android:src="@drawable/aos_picture_douyin_icon"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/picture_top_user_name"
                app:layout_constraintLeft_toRightOf="@+id/picture_top_user_name"
                app:layout_constraintTop_toTopOf="@+id/picture_top_user_name"/>
            <com.bytedance.awemeopen.apps.framework.feed.follow.util.DuxTextView
                android:textSize="12dp"
                android:textStyle="normal"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/picture_top_follow"
                android:background="@drawable/aos_picture_top_follow_selector"
                android:visibility="gone"
                android:layout_width="64dp"
                android:layout_height="28dp"
                android:text="关注"
                android:maxLines="1"
                android:singleLine="true"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/picture_top_container_line"
            android:background="@color/aos_picture_line_color"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            app:layout_constraintTop_toBottomOf="@+id/picture_top_container"/>
        <com.bytedance.awemeopen.apps.photo.view.CustomCoordinatorLayout
            android:id="@+id/custom_coordinator"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/page_btm_bar"
            app:layout_constraintTop_toBottomOf="@+id/picture_top_container_line">
            <com.google.android.material.appbar.SlidesDetailAppBarLayout
                android:orientation="vertical"
                android:id="@+id/app_bar_layout"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:elevation="0dp"
                app:layout_behavior="com.google.android.material.appbar.SlidesDetailAppbarBehavior">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_scrollFlags="exitUntilCollapsed|scroll">
                    <include
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="270dp"
                        layout="@layout/aos_photos_flow_card_photos"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/header_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">
                        <View
                            android:id="@+id/header_bottom_divider"
                            android:background="@color/aos_text_primary_1F"
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:layout_marginLeft="16dp"
                            android:layout_marginRight="16dp"/>
                        <include layout="@layout/aos_photos_camera_week"/>
                        <FrameLayout
                            android:id="@+id/feed_back_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <com.bytedance.awemeopen.apps.framework.feed.follow.util.DuxTextView
                            android:textSize="14dp"
                            android:textColor="@color/aos_picture_text_color"
                            android:id="@+id/header_comment_count"
                            android:paddingTop="18dp"
                            android:paddingBottom="18dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="14dp"
                            android:layout_marginRight="14dp"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.appbar.SlidesDetailAppBarLayout>
            <com.bytedance.awemeopen.apps.framework.comment.CommentListView
                android:id="@+id/comment_list_view"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
        </com.bytedance.awemeopen.apps.photo.view.CustomCoordinatorLayout>
        <include
            android:id="@+id/page_btm_bar"
            layout="@layout/aos_picture_flow_page_btm_float_bar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/aos_photos_flow_page_pinch_stable_view"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="60dp"
        layout="@layout/aos_photo_first_init_loading"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtStatusView
        android:id="@+id/status_view"
        android:background="@color/aos_bg_secondary3"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="60dp"/>
</FrameLayout>
