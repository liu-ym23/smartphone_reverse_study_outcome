<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/polaris_title_bar_style">
    <TextView
        android:id="@+id/back"
        style="@style/polaris_back_view"/>
    <ImageView
        android:id="@+id/close_all_webpage"
        android:paddingLeft="12dp"
        android:paddingTop="5dp"
        android:paddingRight="10dp"
        android:paddingBottom="5dp"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:src="@drawable/polaris_title_bar_close_selector"
        android:layout_toRightOf="@+id/back"
        android:layout_centerVertical="true"/>
    <TextView
        android:id="@+id/right_text"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:drawableLeft="@drawable/polaris_btn_more_title_detail"
        android:layout_alignParentRight="true"
        style="@style/polaris_title_bar_button"/>
    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="85dp"
        android:layout_marginRight="85dp"
        android:singleLine="true"
        android:layout_centerInParent="true"
        style="@style/polaris_title_text_style"/>
    <ProgressBar
        android:id="@+id/right_progress"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="15dp"
        android:indeterminateOnly="true"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        style="?android:attr/progressBarStyleSmall"/>
</RelativeLayout>
