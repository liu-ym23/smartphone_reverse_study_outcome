<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="0dp"
    android:paddingBottom="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/UDText.Body0"
        android:textColor="@color/text_title"
        android:id="@+id/ud_dialog_content_message_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ud_dialog_padding_left_right"
        android:layout_marginEnd="@dimen/ud_dialog_padding_left_right"/>
    <TextView
        android:textSize="@dimen/ud_text_body1"
        android:textColor="@color/text_caption"
        android:id="@+id/ud_dialog_content_tips_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_10"
        android:layout_marginStart="@dimen/ud_dialog_padding_left_right"
        android:layout_marginEnd="@dimen/ud_dialog_padding_left_right"/>
    <LinearLayout
        android:id="@+id/ud_dialog_checkbox_layout"
        android:paddingTop="@dimen/dp_12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <com.larksuite.component.universe_design.checkbox.UDCheckBox
            android:layout_gravity="center_vertical"
            android:id="@+id/ud_dialog_checkbox"
            android:padding="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="1dp"
            android:checked="true"
            android:layout_marginEnd="@dimen/dp_8"/>
        <TextView
            android:textAppearance="@style/UDText.Body2"
            android:textSize="@dimen/sp_14"
            android:textColor="@color/text_title"
            android:layout_gravity="center_vertical"
            android:id="@+id/ud_dialog_checkbox_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
