<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/cj_pay_bg_common_dialog_radius_2"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="248dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/cj_pay_icon_titlebar_left_close"/>
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/cj_pay_color_black_161823"
        android:layout_gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/cj_pay_color_black_161823"
        android:gravity="left"
        android:layout_gravity="center"
        android:id="@+id/tv_content"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:includeFontPadding="false"
        android:layout_below="@+id/tv_title"
        android:lineSpacingExtra="1.4dp"/>
    <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
        android:textSize="15sp"
        android:textColor="@color/cj_pay_color_white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/bt_processing"
        android:background="@color/cj_pay_color_red_fe2c55"
        android:layout_width="240dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="20dp"
        android:layout_below="@+id/tv_content"/>
</LinearLayout>
