<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@null"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="81.5dp"
    android:layout_marginRight="81.5dp"
    android:layout_centerInParent="true"
    android:layoutDirection="ltr"
    android:layout_marginStart="81.5dp"
    android:layout_marginEnd="81.5dp">
    <com.ss.android.ugc.tools.view.style.StyleTextView
        android:textSize="26sp"
        android:textColor="@color/tools_tPrimary_dark"
        android:gravity="center"
        android:id="@+id/first_tv"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="140dp"
        android:layout_centerInParent="true"/>
    <com.ss.android.ugc.tools.view.style.StyleTextView
        android:textSize="26sp"
        android:textColor="@color/tools_tPrimary_dark"
        android:gravity="center"
        android:id="@+id/second_tv"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="25dp"
        android:minWidth="140dp"
        android:layout_alignParentRight="true"
        android:layout_marginStart="25dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
