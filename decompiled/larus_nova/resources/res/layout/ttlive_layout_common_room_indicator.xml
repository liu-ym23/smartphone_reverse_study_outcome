<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.live.room.view.InterceptFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/alpha_change_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/indicator_boundary"
            android:background="@drawable/ttlive_bg_watch_user_info_indicator_boundary"
            android:layout_width="1dp"
            android:layout_height="26dp"
            android:layout_centerVertical="true"/>
        <FrameLayout
            android:id="@+id/half_ui_first_line_area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_centerHorizontal="true">
            <ImageView
                android:id="@+id/indicator_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="centerInside"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/commonui_white"
                android:ellipsize="end"
                android:id="@+id/indicator_tv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/new_order_first_line_area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_alignLeft="@+id/new_order_second_line_area"
            android:layout_alignStart="@+id/new_order_second_line_area">
            <com.bytedance.android.live.room.view.NewIndicatorTextSwitcher
                android:id="@+id/indicator_new_order_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0"/>
            <ImageView
                android:id="@+id/indicator_new_order_user_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/new_order_second_line_area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/new_order_first_line_area"
            android:layout_centerInParent="true">
            <TextView
                android:textSize="9dp"
                android:textColor="@color/commonui_white"
                android:id="@+id/indicator_new_order_copy_writer"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="13dp"
                android:alpha="0"
                android:letterSpacing="0.04"/>
            <ImageView
                android:id="@+id/indicator_new_order_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/data_info_area"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_below="@+id/half_ui_first_line_area"
            android:layout_centerHorizontal="true">
            <com.bytedance.android.live.room.view.IndicatorTextSwitcher
                android:id="@+id/plus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.bytedance.android.live.room.view.IndicatorTextSwitcher
                android:id="@+id/wan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.bytedance.android.live.room.view.IndicatorTextSwitcher
                android:id="@+id/thousand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.bytedance.android.live.room.view.IndicatorTextSwitcher
                android:id="@+id/hundreds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.bytedance.android.live.room.view.IndicatorTextSwitcher
                android:id="@+id/decade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.bytedance.android.live.room.view.IndicatorTextSwitcher
                android:id="@+id/bits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <com.bytedance.android.live.room.view.IndicatorTextSwitcher
            android:gravity="center"
            android:id="@+id/info_label"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_below="@+id/half_ui_first_line_area"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</com.bytedance.android.live.room.view.InterceptFrameLayout>
