<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_40"
    android:importantForAccessibility="no"
    android:paddingEnd="?attr/larus_dp_16">
    <View
        android:id="@+id/panel_loading_icon"
        android:layout_width="?attr/larus_dp_28"
        android:layout_height="?attr/larus_dp_28"
        android:layout_marginTop="?attr/larus_dp_6"
        android:layout_marginBottom="?attr/larus_dp_6"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_6"/>
    <View
        android:id="@+id/panel_loading_text"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_24"
        android:layout_weight="1"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"/>
</LinearLayout>
