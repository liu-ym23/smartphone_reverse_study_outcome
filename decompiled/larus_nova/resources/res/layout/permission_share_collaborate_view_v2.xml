<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shareCollGroup"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/topContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_caption"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/collaboratorTitleTv"
            android:paddingTop="@dimen/dp_12"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <com.bytedance.ee.bear.middleground.permission.lock.LockBannerView
            android:id="@+id/lockBanner"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <com.bytedance.ee.bear.widgets.universedesign.SpaceSettingGroupLayout
        android:id="@+id/collaboratorLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_kit_len_16"
        android:layout_marginRight="@dimen/space_kit_len_16"
        app:dividerBackgroundColor="@color/bg_float"
        app:itemBackgroundColor="@color/facade_selector_item_float"
        app:layout_constraintTop_toBottomOf="@+id/topContainer">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/inputLayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/share_panel_row_entry_height">
            <ImageView
                android:layout_width="@dimen/space_kit_len_20"
                android:layout_height="@dimen/space_kit_len_20"
                android:src="@drawable/ud_icon_member_add_outlined"
                android:scaleType="centerInside"
                android:layout_marginStart="@dimen/space_kit_len_16"
                app:tint="@color/icon_n1"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_title"
                android:id="@+id/inviteMemberTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/LarkCCM_Docs_InviteCollaborators_Menu_Mob"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_kit_len_13"/>
            <ImageView
                android:layout_width="@dimen/space_kit_len_14"
                android:layout_height="@dimen/space_kit_len_14"
                android:src="@drawable/ud_icon_right_outlined"
                android:scaleType="centerInside"
                android:tint="@color/text_placeholder"
                android:layout_marginEnd="@dimen/space_kit_len_16"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/memberListLayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/share_panel_row_entry_height">
            <ImageView
                android:layout_width="@dimen/space_kit_len_20"
                android:layout_height="@dimen/space_kit_len_20"
                android:src="@drawable/ud_icon_group_outlined"
                android:scaleType="centerInside"
                android:layout_marginStart="@dimen/space_kit_len_16"
                app:tint="@color/icon_n1"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:id="@+id/manageMemberTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/Doc_Share_Collaborators"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_kit_len_13"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/collaboratorLayout"/>
            <com.larksuite.component.universe_design.image.UDAvatarList
                android:id="@+id/memberList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_kit_len_16"
                app:ud_avatarList_maxCount="5"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/sendNotificationLayout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/share_panel_row_entry_height">
            <ImageView
                android:layout_width="@dimen/space_kit_len_20"
                android:layout_height="@dimen/space_kit_len_20"
                android:scaleType="centerInside"
                android:layout_marginStart="@dimen/space_kit_len_16"
                app:srcCompat="@drawable/ud_icon_sent_outlined"
                app:tint="@color/icon_n1"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:id="@+id/sendNotificationTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/Doc_Share_Collaborators"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_kit_len_13"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/collaboratorLayout"/>
        </LinearLayout>
    </com.bytedance.ee.bear.widgets.universedesign.SpaceSettingGroupLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
