<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="12dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:paddingStart="12dp">
    <ImageView
        android:id="@+id/popup_arrow"
        android:background="@drawable/ttlive_ic_top_arrow"
        android:layout_width="18dp"
        android:layout_height="9dp"
        android:layout_marginLeft="50dp"
        android:layout_marginStart="50dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/ttlive_bg_popup_open_buff"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginTop="6dp">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/white"
            android:id="@+id/popup_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="6dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/pop_text_arrow"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/pop_text_arrow"
            android:background="@drawable/ttlive_ic_right_arrow"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginRight="14dp"
            android:layout_marginEnd="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
