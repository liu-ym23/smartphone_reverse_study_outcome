<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/rv_setting_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <include layout="@layout/ttlive_layout_room_block_word_manage"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/admin_action_container"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/manager"
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:text="@string/ttlive_live_profile_manage_set_manager"
            style="@style/ttlive_LiveProfileManageItem"/>
        <View
            android:id="@+id/manager_divider"
            android:background="@color/ttlive_core_hs_s9"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <TextView
            android:id="@+id/add_audience"
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:text="@string/ttlive_live_profile_add_audience_list"
            style="@style/ttlive_LiveProfileManageItem"/>
        <View
            android:id="@+id/audience_divider"
            android:background="@color/ttlive_core_hs_s9"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <TextView
            android:id="@+id/kick_out"
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:text="@string/ttlive_chat_block_him"
            style="@style/ttlive_LiveProfileManageItem"/>
        <View
            android:background="@color/ttlive_core_hs_s9"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <TextView
            android:id="@+id/mute"
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:text="@string/ttlive_live_profile_manage_mute"
            style="@style/ttlive_LiveProfileManageItem"/>
        <View
            android:id="@+id/report_divider"
            android:background="@color/ttlive_core_hs_s9"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <TextView
            android:id="@+id/report"
            android:background="@color/ttlive_white"
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:text="@string/ttlive_report_report"
            style="@style/ttlive_LiveProfileManageItem"/>
        <View
            android:background="@color/ttlive_core_hs_s9"
            android:layout_width="match_parent"
            android:layout_height="8dp"/>
        <TextView
            android:id="@+id/cancel"
            android:layout_width="match_parent"
            android:layout_height="57dp"
            android:text="@string/ttlive_cancel"
            style="@style/ttlive_LiveProfileManageItem"/>
    </LinearLayout>
</LinearLayout>
