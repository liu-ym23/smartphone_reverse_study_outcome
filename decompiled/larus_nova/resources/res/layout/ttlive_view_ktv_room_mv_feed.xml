<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ktv_mv_feed_content_container"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <FrameLayout
        android:id="@+id/mv_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <FrameLayout
        android:id="@+id/lyric_container"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="52dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <com.bytedance.android.live.ktv.common.midi.KtvRoomMidiView
        android:id="@+id/ktv_feed_mv_midi_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="77dp"
        app:layout_constraintBottom_toTopOf="@+id/lyric_container"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <com.bytedance.android.live.ktv.common.midi.v2.KtvRoomMidiViewV2
        android:id="@+id/ktv_feed_mv_midi_view_v2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="77dp"
        app:layout_constraintBottom_toTopOf="@+id/lyric_container"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <com.bytedance.android.livesdk.ktvimpl.feed.KtvRoomSingerInfoFeedView
        android:id="@+id/ktv_feed_singer_info_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
