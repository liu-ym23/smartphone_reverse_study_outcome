<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/poi_fragment_screenshot_share_906612246"
    android:paddingTop="5dp"
    android:paddingBottom="50dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.dux.widget.DuxRadiusImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_screenshot"
        android:layout_width="36dp"
        android:layout_height="70dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/poi_screenshot_iv_content_description"
        android:layout_marginStart="26dp"
        app:cornerRadius="4dp"
        app:radiusStrokeColor="#e4e4e4"
        app:radiusStrokeWidth="0.5dp"/>
    <View
        android:layout_gravity="center_vertical"
        android:background="#1f161823"
        android:layout_width="0.5dp"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="center_vertical"
        android:id="@+id/rv_share_channel"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginStart="3dp"/>
</LinearLayout>
