<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/bdpapp_m_parent_view_map"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/bdpapp_m_map_close"
        android:background="@drawable/bdp_m_map_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp">
        <ImageView
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/bdpapp_m_lefterbackicon_titlebar_dark"/>
    </FrameLayout>
    <ImageView
        android:gravity="center_vertical"
        android:id="@+id/bdpapp_m_map_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:src="@drawable/bdpapp_m_map_sentinel"
        android:layout_above="@+id/bdpapp_m_map_bottom"
        android:layout_marginEnd="10dp"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bdpapp_m_map_bottom"
        android:background="@drawable/bdpapp_m_map_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerVertical="true">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="15dp"
            android:layout_weight="1"
            android:layout_alignParentStart="true">
            <TextView
                android:textSize="19dp"
                android:textColor="@color/bdpapp_m_ssxinzi1"
                android:ellipsize="end"
                android:id="@+id/bdpapp_m_map_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/bdpapp_m_ssxianzi3"
                android:ellipsize="end"
                android:id="@+id/bdpapp_m_map_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"/>
            <TextView
                android:textSize="19dp"
                android:textColor="@color/bdpapp_m_ssxinzi1"
                android:id="@+id/bdpapp_m_map_position"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bdpapp_m_location"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/bdpapp_m_map_nav"
            android:background="@drawable/bdpapp_m_map_nav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:layout_weight="0"
            android:layout_marginEnd="15dp"/>
    </LinearLayout>
</RelativeLayout>
