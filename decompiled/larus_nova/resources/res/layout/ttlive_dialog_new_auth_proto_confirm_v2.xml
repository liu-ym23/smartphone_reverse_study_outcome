<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/ivProtoClose"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/ttlive_bg_white_radius_20"
        android:paddingBottom="44dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <ImageView
            android:id="@+id/proto_confirm_close_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/ttlive_one_key_auth_dialog_close_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:id="@+id/tvProtoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#80161823"
            android:id="@+id/tvProtoContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvProtoTitle"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/auth_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvProtoContent">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="1dp"
                android:src="@drawable/ttlive_security_icon"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#80161823"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_new_auth_dialog_security_tip"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <Button
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/uicomponent_live_button_primary_text_color"
            android:id="@+id/btnProtoConfirm"
            android:background="@drawable/uicomponent_bg_button_primary_8"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/auth_tip"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
