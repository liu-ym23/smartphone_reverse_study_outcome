<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.dora.impl.view.DoraNovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.bmhome.view.item.ItemGroup
        android:id="@+id/dora_auto_ota_group"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_12"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginRight="?attr/larus_dp_12"
        android:layout_marginBottom="?attr/larus_dp_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <com.larus.bmhome.view.item.ItemTextToggle
            android:id="@+id/dora_auto_ota_switch"
            android:background="@drawable/larus_bg_item_selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_ota_auto_start_cn"/>
    </com.larus.bmhome.view.item.ItemGroup>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/ota_loading_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ProgressBar
                android:id="@+id/ota_loading_progress_bar"
                android:padding="?attr/larus_dp_20"
                android:layout_width="?attr/larus_dp_60"
                android:layout_height="?attr/larus_dp_60"
                android:indeterminateDrawable="@drawable/larus_dora_loading"
                android:indeterminateDuration="750"/>
            <ImageView
                android:id="@+id/ota_loading_retry_img_view"
                android:layout_width="?attr/larus_dp_60"
                android:layout_height="?attr/larus_dp_60"
                android:src="@drawable/larus_dora_ota_load_retry"/>
        </FrameLayout>
        <TextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="@color/larus_neutral_50"
            android:layout_gravity="center_horizontal"
            android:id="@+id/ota_loading_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/larus_neutral_50"
        android:gravity="center_horizontal"
        android:id="@+id/ota_new_version_text_view"
        android:paddingLeft="?attr/larus_dp_12"
        android:paddingRight="?attr/larus_dp_12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ota_update_content_layout"
        android:background="@drawable/larus_dora_ota_update_content_layout_bg"
        android:padding="?attr/larus_dp_16"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="?attr/larus_dp_12"
        android:layout_marginTop="?attr/larus_dp_18"
        android:layout_marginRight="?attr/larus_dp_12"
        android:layout_marginBottom="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dora_auto_ota_group"
        app:layout_goneMarginTop="?attr/larus_dp_8">
        <ScrollView
            android:orientation="vertical"
            android:id="@+id/ota_update_info_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/ota_bottom_control_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ota_update_info_header_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ota_update_info_header_icon"
                        android:layout_width="?attr/larus_dp_64"
                        android:layout_height="?attr/larus_dp_64"
                        android:src="@drawable/larus_dora_ota_icon"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="?attr/larus_sp_17"
                        android:textStyle="bold"
                        android:textColor="@color/larus_neutral_100"
                        android:id="@+id/ota_update_info_header_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="?attr/larus_dp_16"
                        app:layout_constraintBottom_toTopOf="@+id/ota_update_info_header_size"
                        app:layout_constraintStart_toEndOf="@+id/ota_update_info_header_icon"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="?attr/larus_sp_15"
                        android:textColor="@color/larus_neutral_50"
                        android:id="@+id/ota_update_info_header_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="?attr/larus_dp_2"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/ota_update_info_header_version"
                        app:layout_constraintTop_toBottomOf="@+id/ota_update_info_header_version"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <View
                    android:background="@color/larus_neutral_transparent_3_static"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/larus_dp_0_5"
                    android:layout_marginTop="?attr/larus_dp_18"
                    android:layout_marginBottom="?attr/larus_dp_18"/>
                <com.larus.business.markdown.impl.markwon.MarkdownTextView
                    android:textSize="?attr/larus_sp_17"
                    android:textColor="@color/larus_neutral_100"
                    android:id="@+id/ota_update_info_text_view"
                    android:scrollbars="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </ScrollView>
        <FrameLayout
            android:id="@+id/ota_bottom_control_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_gravity="bottom"
                android:id="@+id/ota_bottom_control_btn_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="?attr/larus_dp_16"
                    android:textColor="@color/larus_static_white"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/ota_bottom_control_start_button"
                    android:background="@drawable/larus_dora_ota_bg_btn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="?attr/larus_dp_56"
                    android:text="@string/larus_dora_ota_btn_start_cn"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_sp_15"
                    android:textColor="@color/larus_neutral_100"
                    android:id="@+id/ota_bottom_control_tip_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="?attr/larus_dp_18"
                    android:text="@string/larus_dora_g_ota_tips_3_cn"
                    android:drawablePadding="?attr/larus_dp_8"
                    android:drawableStart="@drawable/larus_dora_ota_bottom_control_tip_dot"
                    android:paddingStart="?attr/larus_dp_8"
                    android:paddingEnd="?attr/larus_dp_8"
                    app:layout_constraintBottom_toTopOf="@+id/ota_bottom_control_start_button"
                    app:layout_constraintStart_toStartOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_sp_15"
                    android:textColor="@color/larus_neutral_100"
                    android:id="@+id/ota_bottom_control_tip_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="?attr/larus_dp_8"
                    android:text="@string/larus_dora_g_ota_tips_2_cn"
                    android:drawablePadding="?attr/larus_dp_8"
                    android:drawableStart="@drawable/larus_dora_ota_bottom_control_tip_dot"
                    android:paddingStart="?attr/larus_dp_8"
                    android:paddingEnd="?attr/larus_dp_8"
                    app:layout_constraintBottom_toTopOf="@+id/ota_bottom_control_tip_3"
                    app:layout_constraintStart_toStartOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_sp_15"
                    android:textColor="@color/larus_neutral_100"
                    android:id="@+id/ota_bottom_control_tip_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="?attr/larus_dp_8"
                    android:text="@string/larus_dora_g_ota_tips_1_cn"
                    android:drawablePadding="?attr/larus_dp_8"
                    android:drawableStart="@drawable/larus_dora_ota_bottom_control_tip_dot"
                    android:paddingStart="?attr/larus_dp_8"
                    android:paddingEnd="?attr/larus_dp_8"
                    app:layout_constraintBottom_toTopOf="@+id/ota_bottom_control_tip_2"
                    app:layout_constraintStart_toStartOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_gravity="bottom"
                android:id="@+id/ota_bottom_control_checking_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="?attr/larus_dp_16"
                    android:textColor="@color/larus_static_white"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/ota_bottom_control_checking_button"
                    android:background="@drawable/larus_dora_ota_bg_btn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="?attr/larus_dp_56"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                <ProgressBar
                    android:id="@+id/ota_bottom_control_checking_progress_bar"
                    android:layout_width="?attr/larus_dp_20"
                    android:layout_height="?attr/larus_dp_20"
                    android:indeterminateDrawable="@drawable/larus_dora_loading"
                    android:indeterminateDuration="750"
                    app:layout_constraintBottom_toBottomOf="@+id/ota_bottom_control_checking_button"
                    app:layout_constraintEnd_toEndOf="@+id/ota_bottom_control_checking_button"
                    app:layout_constraintStart_toStartOf="@+id/ota_bottom_control_checking_button"
                    app:layout_constraintTop_toTopOf="@+id/ota_bottom_control_checking_button"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_gravity="bottom"
                android:id="@+id/ota_bottom_control_progress_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ProgressBar
                    android:id="@+id/ota_bottom_control_progress_bar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="100"
                    android:indeterminate="false"
                    android:progressDrawable="@drawable/larus_dora_progress_shape"
                    android:minHeight="?attr/larus_dp_56"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    style="@style/larus_common_progress_bar_horizontal"/>
                <TextView
                    android:textSize="?attr/larus_sp_17"
                    android:textColor="@color/larus_primary_50"
                    android:gravity="center"
                    android:id="@+id/ota_bottom_control_progress_text_view"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="@+id/ota_bottom_control_progress_bar"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/ota_bottom_control_progress_bar"/>
                <TextView
                    android:textSize="?attr/larus_sp_15"
                    android:textColor="@color/larus_neutral_30"
                    android:gravity="center"
                    android:id="@+id/ota_bottom_control_progress_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="?attr/larus_dp_18"
                    android:text="@string/larus_dora_g_ota_updating_desc_cn"
                    app:layout_constraintBottom_toTopOf="@+id/ota_bottom_control_progress_bar"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_gravity="bottom"
                android:id="@+id/ota_bottom_control_restart_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ota_bottom_control_restart_btn_layout"
                    android:background="@drawable/larus_dora_ota_bottom_control_restart_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="?attr/larus_dp_56"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent">
                    <ProgressBar
                        android:id="@+id/ota_bottom_control_restart_progress_bar"
                        android:layout_width="?attr/larus_dp_20"
                        android:layout_height="?attr/larus_dp_20"
                        android:indeterminateDrawable="@drawable/larus_dora_loading"
                        android:indeterminateDuration="750"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/ota_bottom_control_restart_text_view"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="?attr/larus_dp_17"
                        android:textColor="@color/larus_neutral_50"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/ota_bottom_control_restart_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_dora_g_ota_rebooting_btn_cn"
                        android:layout_marginStart="?attr/larus_dp_5"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ota_bottom_control_restart_progress_bar"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_dp_15"
                    android:textColor="@color/larus_neutral_30"
                    android:gravity="center"
                    android:id="@+id/ota_bottom_control_restart_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="?attr/larus_dp_18"
                    android:text="@string/larus_dora_g_ota_rebooting_desc_cn"
                    app:layout_constraintBottom_toTopOf="@+id/ota_bottom_control_restart_btn_layout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
        <View
            android:id="@+id/ota_bottom_control_line_view"
            android:background="@color/larus_neutral_transparent_3_static"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_0_5"
            android:layout_marginBottom="?attr/larus_dp_18"
            app:layout_constraintBottom_toTopOf="@+id/ota_bottom_control_layout"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:id="@+id/ota_bottom_control_mask_view"
            android:background="@drawable/larus_dora_ota_bottom_control_mask"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_50"
            app:layout_constraintBottom_toTopOf="@+id/ota_bottom_control_line_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
