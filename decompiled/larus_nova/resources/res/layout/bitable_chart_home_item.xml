<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.ee.bear.facade.common.widget.RoundFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bitable_homepage_chart_bg_color"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:bottom_left_radius="20dp"
    app:bottom_right_radius="20dp"
    app:top_left_radius="20dp"
    app:top_right_radius="20dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="end|top"
                android:id="@+id/delete_icon"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="46dp"
                android:scaleType="centerInside"
                android:layout_marginEnd="8dp"
                app:srcCompat="@drawable/bitable_homepage_chart_icon_delete"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:id="@+id/chart_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/drag_icon"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="46dp"
                android:scaleType="centerInside"
                android:layout_marginStart="8dp"
                app:srcCompat="@drawable/bitable_homepage_chart_icon_drag"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/chart_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
</com.bytedance.ee.bear.facade.common.widget.RoundFrameLayout>
