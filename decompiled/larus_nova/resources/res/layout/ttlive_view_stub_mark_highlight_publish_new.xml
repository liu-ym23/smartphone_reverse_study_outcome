<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hint_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/operateLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="11dp"
        android:layout_alignParentBottom="true">
        <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerLinearlayout
            android:gravity="center"
            android:id="@+id/llRecord"
            android:background="#0d161823"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            app:ttlive_allRadius="8dp">
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#161823"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="开始直播录制"/>
        </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerLinearlayout>
        <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerLinearlayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/go_publish"
            android:background="#fe2c55"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            app:ttlive_allRadius="8dp">
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="发布已生成的高光"
                android:includeFontPadding="false"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/publish_loading"
                android:background="@drawable/ttlive_ic_highlight_record_loading"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="4dp"/>
        </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerLinearlayout>
    </LinearLayout>
</FrameLayout>
