<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_76">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/item_left_icon"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/item_main_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/item_main_name"/>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="?attr/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/item_main_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        android:singleLine="true"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_8"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/item_description"
        app:layout_constraintEnd_toStartOf="@+id/item_status_badge"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/item_left_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/item_status_badge"
        android:background="@drawable/larus_shape_online_badge_bg"
        android:paddingTop="?attr/larus_dp_2"
        android:paddingBottom="?attr/larus_dp_2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="?attr/larus_dp_8"
        android:paddingEnd="?attr/larus_dp_8"
        android:layout_marginStart="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/item_main_name"
        app:layout_constraintEnd_toStartOf="@+id/item_end_barrier"
        app:layout_constraintStart_toEndOf="@+id/item_main_name"
        app:layout_constraintTop_toTopOf="@+id/item_main_name">
        <ImageView
            android:id="@+id/item_status_badge_icon"
            android:layout_width="?attr/larus_dp_6"
            android:layout_height="?attr/larus_dp_6"
            android:src="@drawable/larus_shape_online_dot"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="?attr/larus_dp_11"
            android:textColor="@color/success_50"
            android:ellipsize="end"
            android:id="@+id/item_status_badge_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dispatch_online_cn"
            android:singleLine="true"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_4"/>
    </LinearLayout>
    <TextView
        android:textSize="?attr/larus_dp_12"
        android:textColor="?attr/larus_neutral_50"
        android:ellipsize="end"
        android:id="@+id/item_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_4"
        android:layout_marginBottom="?attr/larus_dp_12"
        android:maxLines="2"
        android:layout_marginStart="?attr/larus_dp_8"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintBottom_toTopOf="@+id/item_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/item_left_icon"
        app:layout_constraintTop_toBottomOf="@+id/item_main_name"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/item_end_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="true"
        app:barrierDirection="start"
        app:constraint_referenced_ids="item_end_label,item_end_icon,item_end_loading"/>
    <TextView
        android:textColor="@color/neutral_50"
        android:ellipsize="end"
        android:id="@+id/item_end_label"
        android:background="@drawable/larus_bg_crowd_test_label"
        android:paddingLeft="?attr/larus_dp_6"
        android:paddingTop="?attr/larus_dp_4"
        android:paddingRight="?attr/larus_dp_6"
        android:paddingBottom="?attr/larus_dp_4"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="?attr/larus_dp_17"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/item_main_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/item_main_name"/>
    <ImageView
        android:id="@+id/item_end_icon"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:src="@drawable/larus_ic_message_selected_night2"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/item_main_name"
        app:layout_constraintEnd_toStartOf="@+id/item_end_label"
        app:layout_constraintTop_toTopOf="@+id/item_main_name"/>
    <com.larus.bmhome.taskskill.ui.PcDeviceAuthorizingLoadingView
        android:id="@+id/item_end_loading"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_16"
        android:layout_height="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/item_main_name"
        app:layout_constraintEnd_toStartOf="@+id/item_end_label"
        app:layout_constraintTop_toTopOf="@+id/item_main_name"/>
    <View
        android:id="@+id/item_divider"
        android:background="@color/larus_neutral_transparent_2"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_0_5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
