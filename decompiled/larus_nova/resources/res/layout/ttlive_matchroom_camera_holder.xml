<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="84dp"
    android:layout_height="wrap_content">
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout
        android:id="@+id/cover_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ttlive_allRadius="6.5dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/cover"
            android:layout_width="84dp"
            android:layout_height="48dp"
            app:placeholderImage="@drawable/ttlive_camera_place_holder"
            app:placeholderImageScaleType="focusCrop"
            app:roundedCornerRadius="6dp"/>
        <FrameLayout
            android:id="@+id/playing_container"
            android:background="@drawable/ttlive_bg_matchroom_camera_playing"
            android:layout_width="84dp"
            android:layout_height="48dp"
            app:layout_constraintBottom_toBottomOf="@+id/cover"
            app:layout_constraintLeft_toLeftOf="@+id/cover"
            app:layout_constraintRight_toRightOf="@+id/cover"
            app:layout_constraintTop_toTopOf="@+id/cover">
            <com.airbnb.lottie.LottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/living_view"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:scaleType="centerCrop"
                app:lottie_autoPlay="false"
                app:lottie_loop="true"/>
        </FrameLayout>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="start|top"
            android:id="@+id/paid_tips"
            android:background="@drawable/ttlive_vs_camera_paid_tips"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:layout_width="wrap_content"
            android:layout_height="15dp"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="start|top"
            android:id="@+id/vr_icon"
            android:background="@drawable/ttlive_multi_vr_icon"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="17dp"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp"/>
    </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/title"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lines="2"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cover_area"
        app:layout_goneMarginBottom="16dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
