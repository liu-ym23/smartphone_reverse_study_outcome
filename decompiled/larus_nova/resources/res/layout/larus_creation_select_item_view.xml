<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/larus_creation_item_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="?attr/larus_dp_16"
    android:layout_marginTop="?attr/larus_dp_12"
    android:layout_marginRight="?attr/larus_dp_16">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/icon_creation_type"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        android:layout_marginTop="?attr/larus_dp_24"
        android:layout_marginBottom="?attr/larus_dp_24"
        android:layout_marginEnd="?attr/larus_dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/icon_creation_avatar"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_28"
        android:layout_height="?attr/larus_dp_28"
        android:layout_marginEnd="?attr/larus_dp_18"
        app:failureImage="?attr/larus_neutral_transparent_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="?attr/larus_neutral_transparent_1"
        app:roundAsCircle="true"/>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="?attr/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/text_creation_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_24"
        android:layout_marginBottom="?attr/larus_dp_24"
        android:maxWidth="?attr/larus_dp_270"
        android:text="@string/larus_create_bot_title"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
