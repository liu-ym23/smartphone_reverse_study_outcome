<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/cj_pay_one_step_layout"
        android:background="@drawable/cj_pay_bg_common_dialog_radius_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/cj_pay_one_step_close"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="12dp"
            android:src="?attr/cj_pay_icon_x_close"/>
        <View
            android:id="@+id/cj_pay_top_space"
            android:layout_width="wrap_content"
            android:layout_height="28dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/cj_layout_one_step_pay_order_info"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/cj_pay_top_space">
            <TextView
                android:textSize="14dp"
                android:textColor="?attr/cj_pay_text_primary"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/cj_pay_one_step_pay_order_info"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/cj_pay_padding_24"
                android:layout_marginRight="@dimen/cj_pay_padding_24"
                android:singleLine="true"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <include
            android:id="@+id/cj_pay_view_verify_amount_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_below="@+id/cj_layout_one_step_pay_order_info"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/cj_pay_view_verify_amount_layout"/>
        <include
            android:id="@+id/cj_pay_view_verify_discount_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="20dp"
            android:layout_below="@+id/cj_pay_view_verify_amount_layout"
            layout="@layout/cj_pay_view_verify_discount_layout"/>
        <com.android.ttcjpaysdk.thirdparty.verify.view.marketing.CJMarketingCountdownView
            android:id="@+id/cj_pay_marketing_countdown_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/cj_pay_view_verify_discount_layout"/>
        <TextView
            android:textSize="13sp"
            android:textColor="?attr/cj_pay_text_secondary"
            android:gravity="center"
            android:id="@+id/cj_pay_one_step_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="20dp"
            android:text="@string/cj_pay_one_step_payment_title_simplify"
            android:includeFontPadding="false"
            android:layout_below="@+id/cj_pay_marketing_countdown_view"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/cj_pay_bottom_not_prompt"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="20dp"
            android:layout_below="@+id/cj_pay_one_step_title">
            <com.android.ttcjpaysdk.base.theme.widget.CJPayStandardCircleCheckbox
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_one_step_checkbox"
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:CJPayWithCircleWhenUnchecked="true"/>
            <TextView
                android:textSize="13sp"
                android:textColor="?attr/cj_pay_text_tertiary"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_one_step_checkbox_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="@string/cj_pay_not_prompt"
                android:includeFontPadding="false"
                android:layout_centerVertical="true"/>
            <com.android.ttcjpaysdk.base.ui.component.security.CJSecurityTextView
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/cj_pay_button_above_security_view"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/cj_pay_one_step_confirm"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_height_44"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="20dp"
            android:layout_below="@+id/cj_pay_bottom_not_prompt">
            <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
                android:id="@+id/cj_pay_one_step_confirm_btn"
                android:background="@drawable/cj_pay_bg_red_btn_radius_4_fe2c55"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cj_pay_height_44"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/cj_pay_color_white"
                    android:id="@+id/tv_no_pwd_confirm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_centerVertical="true"/>
                <ProgressBar
                    android:layout_gravity="center_vertical"
                    android:id="@+id/cj_pay_one_step_loading"
                    android:background="@color/cj_pay_color_trans"
                    android:visibility="gone"
                    android:layout_width="@dimen/cj_pay_padding_20"
                    android:layout_height="@dimen/cj_pay_padding_20"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle"
                    android:indeterminateDuration="500"
                    android:indeterminateBehavior="repeat"
                    android:layout_toRightOf="@+id/tv_no_pwd_confirm"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"/>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</FrameLayout>
