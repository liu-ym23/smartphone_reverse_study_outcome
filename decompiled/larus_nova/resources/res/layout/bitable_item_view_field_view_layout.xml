<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.ee.bear.bitable.itemview.cell.AdaptiveRowLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="top"
    android:orientation="horizontal"
    android:id="@+id/container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.bytedance.ee.bear.bitable.common.widgets.SyncIconImageView
        android:id="@+id/cell_title_icon"
        android:visibility="gone"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="4dp"
        android:tint="@color/icon_n2"
        app:srcCompat="@drawable/ud_icon_maybe_outlined"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/field_content_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_caption"
            android:ellipsize="end"
            android:id="@+id/field_name"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:layout_weight="0"
            android:lineSpacingExtra="0dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/field_icon_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="10sp"
                android:textColor="@color/primary_pri_600"
                android:id="@+id/field_tag"
                android:background="@drawable/bitable_grid_field_tag_ai"
                android:paddingLeft="4dp"
                android:paddingTop="2dp"
                android:paddingRight="4dp"
                android:paddingBottom="2dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="4dp"
                android:layout_marginBottom="2dp"
                android:lines="1"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/desc_icon"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="3dp"
                android:layout_marginRight="4dp"
                android:layout_marginBottom="3dp"
                android:tint="@color/icon_n2"
                app:srcCompat="@drawable/ud_icon_info_outlined"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/function_danger_fill_default"
                android:ellipsize="end"
                android:id="@+id/field_require"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginRight="4dp"
                android:layout_marginBottom="2dp"
                android:lines="1"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/warning_icon"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="3dp"
                android:layout_marginRight="4dp"
                android:layout_marginBottom="3dp"
                app:srcCompat="@drawable/ud_icon_warning_colorful"/>
            <com.bytedance.ee.bear.bitable.common.widgets.SyncIconImageView
                android:id="@+id/loading_icon"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"/>
        </LinearLayout>
    </LinearLayout>
</com.bytedance.ee.bear.bitable.itemview.cell.AdaptiveRowLayout>
