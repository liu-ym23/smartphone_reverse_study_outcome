<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingRight="10dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.bytedance.ee.bear.bitable.card.view.cell.select.SelectTextView
        android:textSize="@dimen/space_kit_font_14"
        android:gravity="center_vertical"
        android:id="@+id/option_item"
        android:paddingRight="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="600dp"
        android:maxHeight="@dimen/space_kit_len_32"
        android:minHeight="@dimen/space_kit_len_24"
        android:includeFontPadding="false"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/closeIcon"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginRight="8dp"
        android:alpha="0.7"
        app:srcCompat="@drawable/ud_icon_close_bold_outlined"/>
</FrameLayout>
