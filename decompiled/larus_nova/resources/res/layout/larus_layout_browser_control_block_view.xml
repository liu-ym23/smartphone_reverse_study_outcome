<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larus.bmhome.chat.markdown.view.DeepThinkCommonToolHeader
        android:id="@+id/common_tool_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/browser_control_cover_stub"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_12"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="354:208"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/common_tool_header"
        app:roundedCornerRadius="?attr/larus_dp_8"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/browser_control_cover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/browser_control_cover_stub"
        app:layout_constraintEnd_toEndOf="@+id/browser_control_cover_stub"
        app:layout_constraintStart_toStartOf="@+id/browser_control_cover_stub"
        app:layout_constraintTop_toTopOf="@+id/browser_control_cover_stub"
        app:placeholderImage="?attr/larus_base_3_overlay"
        app:roundedCornerRadius="?attr/larus_dp_8"/>
    <com.larus.common_ui.widget.shimmer.ShimmerMaskView
        android:id="@+id/browser_control_cover_mask"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/browser_control_cover"
        app:layout_constraintEnd_toEndOf="@+id/browser_control_cover"
        app:layout_constraintStart_toStartOf="@+id/browser_control_cover"
        app:layout_constraintTop_toTopOf="@+id/browser_control_cover"/>
    <FrameLayout
        android:textSize="@dimen/dp_17"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/btn_left"
        android:background="@drawable/larus_bg_base_1_radius_8"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_44"
        android:layout_marginTop="@dimen/dp_14"
        android:layout_marginBottom="@dimen/dp_12"
        android:text="@string/larus_task_card_btn_skip"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_right"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginTop="@dimen/dp_16">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/left_button_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/larus_icon_task_card_arrow_line"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:textSize="@dimen/dp_16"
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/left_button_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_task_card_btn_continue"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:textSize="@dimen/dp_17"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/btn_right"
        android:background="@drawable/larus_bg_base_1_radius_8"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_44"
        android:layout_marginTop="@dimen/dp_14"
        android:layout_marginBottom="@dimen/dp_12"
        android:text="@string/larus_task_card_btn_skip"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/btn_left"
        app:layout_goneMarginTop="@dimen/dp_16">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/right_button_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/larus_icon_task_card_arrow_line"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:textSize="@dimen/dp_16"
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/right_button_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_task_card_btn_skip"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
    </FrameLayout>
</merge>
