<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/join_fans_notify_bg"
        android:background="@drawable/ttlive_join_notify_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:id="@+id/join_fans_info_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:layout_centerHorizontal="true">
        <View
            android:id="@+id/join_fans_info_are_bg"
            android:background="@drawable/ttlive_join_notify_info_bg"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_centerHorizontal="true"/>
        <com.bytedance.android.livesdk.widget.VHeadView
            android:id="@+id/iv_avatar"
            android:padding="3dp"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignLeft="@+id/join_fans_info_are_bg"
            fresco:overlayImage="@color/ttlive_avatar_overlay"
            fresco:placeholderImage="@drawable/ttlive_ic_default_head_small"
            fresco:retryImageScaleType="fitXY"
            fresco:roundAsCircle="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/join_fans_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="42dp"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#de000000"
                android:ellipsize="end"
                android:id="@+id/tv_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:maxEms="3"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_join_fans_success_title"
                android:id="@+id/join_fans"
                android:paddingRight="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="@string/ttlive_join_fans_success"/>
        </LinearLayout>
    </RelativeLayout>
</merge>
