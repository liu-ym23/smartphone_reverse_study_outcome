<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/toolbar_left_part_container"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_alignParentLeft="true"
    android:layout_alignParentBottom="true"
    android:layout_alignParentStart="true">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottie_left_icon_enter"
        android:visibility="gone"
        android:layout_width="54dp"
        android:layout_height="38dp"
        android:layout_marginBottom="8dp"
        android:layout_alignParentBottom="true"/>
    <FrameLayout
        android:id="@+id/left_toolbar_icon_container"
        android:layout_width="36dp"
        android:layout_height="51dp"
        android:layout_marginRight="6dp"
        android:layout_marginBottom="8dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="6dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="12dp"
        android:typeface="sans"
        android:textColor="#fe2c55"
        android:gravity="center"
        android:id="@+id/tv_promotion_goods_count"
        android:background="@drawable/ttlive_bg_white_dot_8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minWidth="14dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_alignParentRight="true"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
