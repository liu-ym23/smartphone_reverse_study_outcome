<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:visibility="invisible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/ec_store_background_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:layout_gravity="top"
            android:id="@+id/ec_store_background"
            android:background="@android:color/white"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:actualImageScaleType="fitXY"
            app:layoutMode="height_self_adjust"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/ec_store_background_bottom_to_top_gradient"
            android:layout_width="match_parent"
            android:layout_height="134dp"/>
    </FrameLayout>
    <View
        android:id="@+id/ec_store_background_gradient"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="198dp"/>
</FrameLayout>
