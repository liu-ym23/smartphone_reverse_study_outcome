<?xml version="1.0" encoding="utf-8"?>
<com.larus.bmhome.view.ChatConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/status_bar_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/result_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/instruction_tab_container_reference"
        app:layout_constraintTop_toBottomOf="@+id/status_bar_area"/>
    <FrameLayout
        android:id="@+id/instruction_tab_container_reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_4"
        app:layout_constraintBottom_toTopOf="@+id/chat_input">
        <FrameLayout
            android:id="@+id/instruction_tab_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/chat_input"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <ViewStub
            android:id="@+id/input_delegate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <com.larus.canvas.feature.component.title.widget.CanvasTitleView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60"
        app:layout_constraintTop_toBottomOf="@+id/status_bar_area"/>
    <View
        android:id="@+id/input_touch_intercept_view"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/instruction_tab_container_reference"/>
</com.larus.bmhome.view.ChatConstraintLayout>
