<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingBottom="18dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/dora_o_health_day_cell"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/dora_o_health_calendar_faint"
            android:gravity="center"
            android:id="@+id/dora_o_health_day_text"
            android:layout_width="32dp"
            android:layout_height="23dp"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"/>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginTop="4dp">
            <View
                android:layout_gravity="top|center_horizontal"
                android:id="@+id/dora_o_health_day_dot"
                android:visibility="invisible"
                android:layout_width="4dp"
                android:layout_height="4dp"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/dora_o_health_calendar_faint"
                android:id="@+id/dora_o_health_day_note"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dora_o_health_calendar_recording"
                android:includeFontPadding="false"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
