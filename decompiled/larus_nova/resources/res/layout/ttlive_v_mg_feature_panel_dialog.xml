<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_mg_feature_panel_dialog"
    android:paddingLeft="16dp"
    android:paddingTop="18dp"
    android:paddingRight="16dp"
    android:paddingBottom="46dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:id="@+id/title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_v_mg_feature_dialog_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:id="@+id/live_data_layout"
        android:background="@drawable/ttlive_bg_mg_white_radius_8"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/title_tv">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="12dp"
                android:textColor="#bf161823"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_open_platform_mg_live_show_count"/>
            <TextView
                android:textSize="17dp"
                android:textColor="#161823"
                android:id="@+id/show_count_tv"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:text="-"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="12dp"
                android:textColor="#bf161823"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_open_platform_mg_live_click_count"/>
            <TextView
                android:textSize="17sp"
                android:textColor="#161823"
                android:id="@+id/click_count_tv"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:text="-"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="12dp"
                android:textColor="#bf161823"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_open_platform_mg_live_play_count"/>
            <TextView
                android:textSize="17sp"
                android:textColor="#161823"
                android:id="@+id/play_count_tv"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:text="-"/>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/title_bar"
        android:background="@drawable/ttlive_bg_mg_white_radius_8"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/live_data_layout">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ttlive_open_feature_icon_default"
            android:layout_centerVertical="true"
            app:failureImage="@drawable/ttlive_open_feature_icon_default"
            app:placeholderImage="@drawable/ttlive_open_feature_icon_default"
            app:roundedCornerRadius="2dp"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_v_mg_feature_dialog_live_guide"
            android:layout_toRightOf="@+id/icon"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"/>
        <View
            android:background="@drawable/ttlive_mg_feature_dialog_ic_arrow_right"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/btn_list"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_list">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/change_game_btn"
            android:background="@drawable/ttlive_bg_mg_agree_star_altas_btn"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:text="@string/ttlive_v_mg_feature_dialog_change_game"
            android:layout_weight="1"/>
        <View
            android:id="@+id/space_view"
            android:visibility="gone"
            android:layout_width="8dp"
            android:layout_height="44dp"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:gravity="center"
            android:id="@+id/exit_btn"
            android:background="@drawable/ttlive_bg_mg_feature_dialog_exit_game"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:text="@string/ttlive_v_mg_feature_dialog_exit_game"
            android:layout_weight="1"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
