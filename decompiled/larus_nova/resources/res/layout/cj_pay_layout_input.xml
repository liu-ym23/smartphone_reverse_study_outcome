<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_pay_layout_input_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cj_pay_layout_input_left_container"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/cj_pay_layout_input_left_icon"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_100"
            android:id="@+id/cj_pay_layout_input_left_title"
            android:visibility="gone"
            android:layout_width="74dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/cj_pay_layout_input_left_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/cj_pay_layout_input_left_title_list_container"
            android:background="@color/cj_pay_color_trans"
            android:visibility="gone"
            android:layout_width="74dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/cj_pay_layout_input_left_icon"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_100"
                android:ellipsize="end"
                android:id="@+id/cj_pay_layout_input_left_title_list_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="48dp"
                android:maxLines="2"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginLeft="3dp"
                android:src="?attr/cj_pay_std_ui_input_left_list_dropdown"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cj_pay_layout_input_right_container"
        android:paddingTop="18dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cj_pay_layout_input_right_hint_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/cj_pay_layout_input_right_hint_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_34"
                android:id="@+id/cj_pay_layout_input_right_hint_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/cj_pay_layout_input_right_hint_icon"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/cj_pay_color_red_fe2c55"
                android:id="@+id/cj_pay_layout_input_right_hint_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="@+id/cj_pay_layout_input_right_hint_text"
                app:layout_constraintTop_toBottomOf="@+id/cj_pay_layout_input_right_hint_text"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/cj_pay_layout_input_right_hint_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                app:layout_constraintBottom_toBottomOf="@+id/cj_pay_layout_input_right_hint_text"
                app:layout_constraintLeft_toRightOf="@+id/cj_pay_layout_input_right_hint_text"
                app:layout_constraintTop_toTopOf="@+id/cj_pay_layout_input_right_hint_text"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:id="@+id/cj_pay_layout_input_right_arrow"
            android:visibility="gone"
            android:layout_width="7dp"
            android:layout_height="7dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/cj_pay_layout_input_right_hint_container"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cj_pay_layout_input_middle_container"
        android:paddingTop="18dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        app:layout_constraintLeft_toRightOf="@+id/cj_pay_layout_input_left_container"
        app:layout_constraintRight_toLeftOf="@+id/cj_pay_layout_input_right_container"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cj_pay_layout_input_middle_input_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/cj_pay_layout_input_middle_input_left_icon"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <EditText
                android:textSize="16sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_100"
                android:textColorHint="@color/cj_pay_color_gray_161823_opacity_34"
                android:id="@+id/cj_pay_layout_input_middle_input_edit"
                android:background="@android:color/transparent"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"
                android:maxLines="2"
                android:inputType="textMultiLine"
                android:textCursorDrawable="@drawable/cj_pay_std_ui_input_cursor"
                app:layout_constraintLeft_toRightOf="@+id/cj_pay_layout_input_middle_input_left_icon"
                app:layout_constraintRight_toLeftOf="@+id/cj_pay_layout_input_middle_input_edit_delete"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cj_pay_color_red_fe3824"
                android:id="@+id/cj_pay_layout_input_middle_tips"
                android:paddingBottom="8dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="@+id/cj_pay_layout_input_middle_input_edit"
                app:layout_constraintTop_toBottomOf="@+id/cj_pay_layout_input_middle_input_edit"/>
            <ImageView
                android:id="@+id/cj_pay_layout_input_middle_input_edit_delete"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginRight="4dp"
                android:src="?attr/cj_pay_std_ui_input_middle_input_delete"
                app:layout_constraintBottom_toBottomOf="@+id/cj_pay_layout_input_middle_input_edit"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/cj_pay_layout_input_middle_input_edit"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cj_pay_layout_input_middle_right_icon_container"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/cj_pay_layout_input_middle_right_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/cj_pay_color_gray_161823_opacity_100"
                    android:id="@+id/cj_pay_layout_input_middle_right_icon_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cj_pay_layout_input_middle_right_icon"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <Button
                android:textSize="13sp"
                android:textColor="@color/cj_pay_color_white"
                android:id="@+id/cj_pay_layout_input_middle_right_btn"
                android:background="@drawable/cj_pay_bg_red_btn_radis_4"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cj_pay_layout_input_middle_select_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/cj_pay_layout_input_middle_select_arrow"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="?attr/cj_pay_std_ui_input_middle_input_arrow"
                app:layout_constraintBottom_toBottomOf="@+id/cj_pay_layout_input_middle_select_text"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/cj_pay_layout_input_middle_select_text"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_100"
                android:id="@+id/cj_pay_layout_input_middle_select_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/cj_pay_layout_input_middle_select_arrow"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cj_pay_color_red_fe3824"
                android:id="@+id/cj_pay_layout_input_middle_select_tips"
                android:paddingBottom="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="@+id/cj_pay_layout_input_middle_select_text"
                app:layout_constraintTop_toBottomOf="@+id/cj_pay_layout_input_middle_select_text"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cj_pay_layout_input_middle_left_amount_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/cj_pay_layout_input_middle_left_amount_unit_contianer"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="21dp"
                android:layout_marginLeft="21dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <View
                    android:layout_gravity="center_vertical"
                    android:id="@+id/cj_pay_layout_input_middle_left_amount_unit_divider"
                    android:background="@color/cj_pay_color_gray_161823_opacity_34"
                    android:layout_width="0.5dp"
                    android:layout_height="14.5dp"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/cj_pay_color_gray_161823_opacity_34"
                    android:id="@+id/cj_pay_layout_input_middle_left_amount_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"/>
            </LinearLayout>
            <TextView
                android:textSize="32sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_100"
                android:id="@+id/cj_pay_layout_input_middle_left_amount_flag"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginTop="2dp"
                app:layout_constraintBottom_toBottomOf="@+id/cj_pay_layout_input_middle_left_amount_input"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="@+id/cj_pay_layout_input_middle_left_amount_input"/>
            <com.android.ttcjpaysdk.base.ui.component.input.CJInputAmountEditText
                android:textSize="44sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_100"
                android:textColorHint="@color/cj_pay_color_gray_161823_opacity_34"
                android:id="@+id/cj_pay_layout_input_middle_left_amount_input"
                android:background="@android:color/transparent"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:maxLength="10"
                android:inputType="numberDecimal"
                app:layout_constraintLeft_toLeftOf="@+id/cj_pay_layout_input_middle_left_amount_unit_contianer"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cj_pay_layout_input_middle_left_amount_unit_contianer"/>
            <TextView
                android:textSize="17sp"
                android:textColorHint="@color/cj_pay_color_gray_161823_opacity_34"
                android:id="@+id/cj_pay_layout_input_middle_left_amount_input_hint"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/cj_pay_layout_input_middle_left_amount_input"
                app:layout_constraintLeft_toLeftOf="@+id/cj_pay_layout_input_middle_left_amount_input"
                app:layout_constraintTop_toTopOf="@+id/cj_pay_layout_input_middle_left_amount_input"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cj_pay_color_red_fe3824"
                android:id="@+id/cj_pay_layout_input_middle_left_amount_tips"
                android:paddingBottom="8dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="@+id/cj_pay_layout_input_middle_left_amount_input"
                app:layout_constraintTop_toBottomOf="@+id/cj_pay_layout_input_middle_left_amount_input"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cj_pay_layout_input_middle_right_amount_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.android.ttcjpaysdk.base.ui.component.input.CJInputAmountEditText
                android:textSize="44sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_100"
                android:textColorHint="@color/cj_pay_color_gray_161823_opacity_34"
                android:id="@+id/cj_pay_layout_input_middle_right_amount_input"
                android:background="@android:color/transparent"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="10dp"
                android:maxLength="10"
                android:inputType="numberDecimal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="17sp"
                android:textColorHint="@color/cj_pay_color_gray_161823_opacity_34"
                android:id="@+id/cj_pay_layout_input_middle_right_amount_input_hint"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/cj_pay_layout_input_middle_right_amount_unit_contianer"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="21dp"
                app:layout_constraintBottom_toTopOf="@+id/cj_pay_layout_input_middle_right_amount_input"
                app:layout_constraintLeft_toRightOf="@+id/cj_pay_layout_input_middle_right_amount_flag">
                <View
                    android:layout_gravity="center_vertical"
                    android:id="@+id/cj_pay_layout_input_middle_right_amount_unit_divider"
                    android:background="@color/cj_pay_color_gray_161823_opacity_34"
                    android:layout_width="0.5dp"
                    android:layout_height="14.5dp"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/cj_pay_color_gray_161823_opacity_34"
                    android:id="@+id/cj_pay_layout_input_middle_right_amount_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"/>
            </LinearLayout>
            <TextView
                android:textSize="32sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_100"
                android:id="@+id/cj_pay_layout_input_middle_right_amount_flag"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/cj_pay_layout_input_middle_right_amount_input"
                app:layout_constraintRight_toLeftOf="@+id/cj_pay_layout_input_middle_right_amount_input"
                app:layout_constraintTop_toTopOf="@+id/cj_pay_layout_input_middle_right_amount_input"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cj_pay_color_red_fe3824"
                android:id="@+id/cj_pay_layout_input_middle_right_amount_tips"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintRight_toRightOf="@+id/cj_pay_layout_input_middle_right_amount_input"
                app:layout_constraintTop_toBottomOf="@+id/cj_pay_layout_input_middle_right_amount_input"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/cj_pay_layout_input_bottom_line"
        android:background="@color/cj_pay_color_gray_161823_opacity_8"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
