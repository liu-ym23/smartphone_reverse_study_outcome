<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ui.base.widget.round.RoundLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/shopwindow_video_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:bg_cornerRadius="8dp">
    <com.bytedance.android.ui.base.widget.round.RoundConstraintLayout
        android:id="@+id/ec_window_product_video_hanging_video"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bg_cornerRadius="8dp">
        <include
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/ec_shop_layout_shopwindow_product_video_hanging_video"/>
        <FrameLayout
            android:gravity="bottom"
            android:background="@drawable/shopping_bg_window_video_desc_bg"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHeight_percent="0.5"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">
            <TextView
                android:textColor="@color/white"
                android:ellipsize="none"
                android:layout_gravity="bottom"
                android:id="@+id/ec_window_video_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </FrameLayout>
    </com.bytedance.android.ui.base.widget.round.RoundConstraintLayout>
    <include layout="@layout/ec_shop_layout_shopwindow_product_video_hanging_product"/>
</com.bytedance.android.ui.base.widget.round.RoundLinearLayout>
