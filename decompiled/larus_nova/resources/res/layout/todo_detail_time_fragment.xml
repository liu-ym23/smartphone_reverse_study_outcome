<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_base"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.lark.ui.CommonTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.ss.android.lark.todo.impl.features.detail.time.TaskTimeContainer
                android:id="@+id/time_select_container"
                android:background="@color/bg_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_1"/>
            <com.larksuite.component.universe_design.datepicker.UDDatePicker
                android:id="@+id/start_month_picker"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_1"/>
            <com.larksuite.component.universe_design.datepicker.UDDatePicker
                android:id="@+id/end_month_picker"
                android:background="@color/bg_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_1"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/hour_time_container"
                android:background="@color/bg_body"
                android:paddingLeft="@dimen/dp_16"
                android:paddingRight="@dimen/dp_12"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_58"
                android:layout_marginTop="@dimen/dp_1">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20sp"
                    android:layout_height="20sp"
                    android:tint="@color/icon_n3"
                    app:srcCompat="@drawable/ud_icon_time_outlined"/>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/text_title"
                    android:id="@+id/hour_time_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Todo_TaskStartTime_SetTime_Button"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_12"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/hour_time_icon"
                    android:padding="@dimen/dp_4"
                    android:layout_width="24sp"
                    android:layout_height="24sp"
                    android:tint="@color/icon_n3"
                    app:srcCompat="@drawable/ud_icon_right_outlined"/>
            </LinearLayout>
            <com.larksuite.component.universe_design.timepicker.UDTimePicker
                android:id="@+id/time_picker"
                android:background="@color/bg_body"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_1"
                app:ud_timePicker_datePickerMode="hourMinute_24h"
                app:ud_timePicker_minuteInternal="15"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/reminder_text_container"
                android:background="@color/bg_body"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_58"
                android:layout_marginTop="@dimen/dp_16"
                android:paddingStart="@dimen/dp_16"
                android:paddingEnd="@dimen/dp_12">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/reminder_icon"
                    android:layout_width="20sp"
                    android:layout_height="20sp"
                    app:srcCompat="@drawable/ud_icon_bell_outlined"/>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/text_title"
                    android:id="@+id/reminder_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Todo_Task_AlertTimeNoAlert"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_12"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/reminder_icon_right"
                    android:padding="@dimen/dp_4"
                    android:layout_width="24sp"
                    android:layout_height="24sp"
                    android:tint="@color/icon_n3"
                    app:srcCompat="@drawable/ud_icon_right_outlined"/>
            </LinearLayout>
            <com.ss.android.lark.todo.impl.features.detail.time.TaskScrollChildLinearLayout
                android:orientation="horizontal"
                android:id="@+id/reminder_wheel_all_day_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larksuite.component.universe_design.timepicker.impl.base.WheelView
                    android:id="@+id/reminder_wheel_all_day"
                    android:background="@color/bg_body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_1"
                    android:layout_weight="1"/>
            </com.ss.android.lark.todo.impl.features.detail.time.TaskScrollChildLinearLayout>
            <com.ss.android.lark.todo.impl.features.detail.time.TaskScrollChildLinearLayout
                android:orientation="horizontal"
                android:id="@+id/reminder_wheel_all_day_custom_reminder_container"
                android:background="@color/bg_body"
                android:paddingLeft="@dimen/dp_22"
                android:paddingRight="@dimen/dp_22"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larksuite.component.universe_design.timepicker.impl.base.WheelView
                    android:id="@+id/custom_reminder_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_1"
                    android:layout_weight="1"/>
                <com.larksuite.component.universe_design.timepicker.impl.base.WheelView
                    android:id="@+id/custom_reminder_hour"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_1"
                    android:layout_weight="1"/>
                <com.larksuite.component.universe_design.timepicker.impl.base.WheelView
                    android:id="@+id/custom_reminder_minute"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_1"
                    android:layout_weight="1"/>
            </com.ss.android.lark.todo.impl.features.detail.time.TaskScrollChildLinearLayout>
            <com.ss.android.lark.todo.impl.features.detail.time.TaskScrollChildLinearLayout
                android:orientation="horizontal"
                android:id="@+id/reminder_wheel_normal_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larksuite.component.universe_design.timepicker.impl.base.WheelView
                    android:id="@+id/reminder_wheel_normal"
                    android:background="@color/bg_body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_1"
                    android:layout_weight="1"/>
            </com.ss.android.lark.todo.impl.features.detail.time.TaskScrollChildLinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/repeat_rrule_text_container"
                android:background="@color/bg_body"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_58"
                android:layout_marginTop="@dimen/dp_16"
                android:paddingStart="@dimen/dp_16"
                android:paddingEnd="@dimen/dp_16">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/repeat_rrule_icon"
                    android:layout_width="20sp"
                    android:layout_height="20sp"
                    app:srcCompat="@drawable/ud_icon_repeat_outlined"/>
                <TextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/text_title"
                    android:id="@+id/repeat_rrule_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Calendar_Detail_NoRepeat"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_12"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/repeat_rrule_right_icon"
                    android:layout_width="16sp"
                    android:layout_height="16sp"
                    app:srcCompat="@drawable/ud_icon_right_outlined"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
