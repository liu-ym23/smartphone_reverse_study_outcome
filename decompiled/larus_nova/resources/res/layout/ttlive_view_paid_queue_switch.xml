<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/paid_queue_container"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="54dp">
    <TextView
        android:textSize="17dp"
        android:textColor="@color/black"
        android:id="@+id/tv_paid_queue_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:text="@string/ttlive_live_paid_queue_start_text"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/paid_queue_guide_dot"
        android:background="@drawable/ttlive_interact_audience_setting_guide_dot"
        android:visibility="gone"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginLeft="1dp"
        android:layout_marginStart="1dp"
        app:layout_constraintStart_toEndOf="@+id/tv_paid_queue_text"
        app:layout_constraintTop_toTopOf="@+id/tv_paid_queue_text"/>
    <Switch
        android:id="@+id/switch_paid_queue"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginRight="16dp"
        android:checked="true"
        android:textOn=""
        android:textOff=""
        android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
        android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
