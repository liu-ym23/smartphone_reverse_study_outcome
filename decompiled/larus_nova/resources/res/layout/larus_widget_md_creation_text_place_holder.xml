<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="?attr/larus_neutral_70"
        android:layout_gravity="center_vertical"
        android:id="@+id/loading_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"/>
    <View
        android:layout_gravity="center_vertical"
        android:id="@+id/loading_dot"
        android:background="?attr/larus_ic_text_loading_dot"
        android:layout_width="?attr/larus_dp_8"
        android:layout_height="?attr/larus_dp_8"
        android:layout_marginTop="?attr/larus_dp_2"
        android:alpha="0.1"
        android:layout_marginStart="?attr/larus_dp_8"/>
</merge>
