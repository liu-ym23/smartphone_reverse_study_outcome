<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:id="@+id/voice_empty"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:src="?attr/larus_ic_speaker_slash"/>
        <TextView
            android:textSize="?attr/larus_dp_16"
            android:textStyle="bold"
            android:textColor="?attr/larus_neutral_50"
            android:layout_gravity="center"
            android:id="@+id/voice_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_modify_bot_voice_empty"
            android:layout_marginStart="?attr/larus_dp_12"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/voice_edit_container_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginBottom="?attr/larus_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.larus.voice_setting.voice.mix.VoiceMixedView
            android:id="@+id/voice_mix_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/adjust_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/single_mix_padding"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_20"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="?attr/larus_dp_16"
                android:textStyle="bold"
                android:textColor="?attr/larus_neutral_100"
                android:id="@+id/pitch_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_modify_bot_voice_bot_voice_card_slider_header1"
                android:layout_marginStart="?attr/larus_dp_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/single_mix_padding"/>
            <SeekBar
                android:id="@+id/pitch_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:max="12"
                android:progress="6"
                android:progressDrawable="?attr/larus_voice_general_progress"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/pitch_title"
                style="@style/larus_mix_seekbar_style"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_dp_16"
                android:textColor="?attr/larus_neutral_50"
                android:id="@+id/pitch_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:layout_marginEnd="?attr/larus_dp_16"
                app:layout_constraintBottom_toBottomOf="@+id/pitch_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/pitch_title"/>
            <TextView
                android:textSize="?attr/larus_dp_16"
                android:textStyle="bold"
                android:textColor="?attr/larus_neutral_100"
                android:id="@+id/rate_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16"
                android:text="@string/larus_modify_bot_voice_bot_voice_card_slider_header2"
                android:layout_marginStart="?attr/larus_dp_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/pitch_progress"/>
            <SeekBar
                android:id="@+id/rate_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:max="16"
                android:progress="6"
                android:progressDrawable="?attr/larus_voice_general_progress"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rate_title"
                style="@style/larus_mix_seekbar_style"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_dp_16"
                android:textColor="?attr/larus_neutral_50"
                android:id="@+id/rate_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:layout_marginEnd="?attr/larus_dp_16"
                app:layout_constraintBottom_toBottomOf="@+id/rate_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/rate_title"/>
            <FrameLayout
                android:id="@+id/play_button"
                android:background="?attr/larus_bg_voice_edit_play"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_44"
                android:layout_marginTop="?attr/larus_dp_16"
                android:layout_marginStart="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rate_progress">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/play_area"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/play_icon"
                        android:layout_width="?attr/larus_dp_20"
                        android:layout_height="?attr/larus_dp_20"
                        android:src="@drawable/larus_ic_speaker"/>
                    <com.lynx.lottieadapter.LottieAdapterView
                        android:id="@+id/play_lottie"
                        android:visibility="gone"
                        android:layout_width="?attr/larus_dp_20"
                        android:layout_height="?attr/larus_dp_20"
                        app:lottie_loop="true"/>
                    <TextView
                        android:textSize="?attr/larus_dp_16"
                        android:textStyle="bold"
                        android:textColor="?attr/larus_primary_50"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_play_mixed_sound"
                        android:layout_marginStart="?attr/larus_dp_8"/>
                </LinearLayout>
            </FrameLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_16"
                app:layout_constraintTop_toBottomOf="@+id/play_button"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</merge>
