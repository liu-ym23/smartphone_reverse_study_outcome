<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/ttlive_ktv_rt_chorus_send_gift_dialog_bg"
    android:paddingLeft="20dp"
    android:paddingTop="20dp"
    android:paddingRight="20dp"
    android:paddingBottom="0dp"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#bf161823"
        android:gravity="center_horizontal"
        android:id="@+id/content"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAlignment="center"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/confirm_btn"
        android:background="@drawable/ttlive_ktv_rt_chorus_send_gift_btn_bg"
        android:layout_width="240dp"
        android:layout_height="44dp"
        android:layout_marginTop="20dp">
        <TextView
            android:textSize="13dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/start_des"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="2dp"
            android:includeFontPadding="false"
            android:textAlignment="center"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/gift_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/gift_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:includeFontPadding="false"
            android:textAlignment="center"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/end_des"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textAlignment="center"/>
    </LinearLayout>
    <TextView
        android:textSize="15dp"
        android:textColor="#99161823"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/cancel_btn"
        android:layout_width="240dp"
        android:layout_height="44dp"
        android:textAlignment="center"/>
</LinearLayout>
