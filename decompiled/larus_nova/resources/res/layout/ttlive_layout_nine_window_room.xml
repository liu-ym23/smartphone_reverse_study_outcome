<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_top_bg"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="164dp"
        app:layout_constraintBottom_toTopOf="@+id/rv_blinddate_window"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_bottom_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_blinddate_window"/>
    <FrameLayout
        android:id="@+id/fl_window_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/rv_blinddate_window"
        app:layout_constraintLeft_toLeftOf="@+id/rv_blinddate_window"
        app:layout_constraintRight_toRightOf="@+id/rv_blinddate_window"
        app:layout_constraintTop_toTopOf="@+id/rv_blinddate_window">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="start|bottom"
            android:id="@+id/iv_left_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/iv_right_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/equal_single_view_mode_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/rv_blinddate_window"
        app:layout_constraintLeft_toLeftOf="@+id/rv_blinddate_window"
        app:layout_constraintRight_toRightOf="@+id/rv_blinddate_window"
        app:layout_constraintTop_toTopOf="@+id/rv_blinddate_window"/>
    <com.bytedance.android.live.ui.ClipImageView
        android:id="@+id/equal_talk_room_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:fadeDuration="0"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.ui.ClipImageView
        android:id="@+id/special_play_mode_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:fadeDuration="0"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/interact_render_container_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_blinddate_window"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/iv_bottom_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_top_bg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
