<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/cj_pay_bg_common_dialog"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="272dp"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="?attr/cj_pay_page_size_17"
            android:textColor="@color/cj_pay_color_black_161823"
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/cj_pay_more_card_discount_dialog_title_label"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cj_pay_padding_24"
            android:layout_marginTop="@dimen/cj_pay_padding_20"
            android:layout_marginRight="@dimen/cj_pay_padding_24"
            android:text="@string/cj_pay_more_card_discount_dialog_title"/>
        <TextView
            android:textSize="?attr/cj_pay_page_size_14"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
            android:gravity="left"
            android:id="@+id/cj_pay_more_card_discount_dialog_detail_label"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cj_pay_padding_20"
            android:layout_marginTop="@dimen/cj_pay_padding_12"
            android:layout_marginRight="@dimen/cj_pay_padding_20"
            android:layout_marginBottom="@dimen/cj_pay_padding_20"
            android:includeFontPadding="false"
            android:lineSpacingExtra="@dimen/cj_pay_padding_20"
            android:lineSpacingMultiplier="0"/>
        <View
            android:id="@+id/cj_pay_passport_dialog_divider"
            android:background="@color/cj_pay_color_gray_232"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_padding_1"/>
        <TextView
            android:textSize="?attr/cj_pay_page_size_17"
            android:textColor="@color/cj_pay_color_new_blue"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/cj_pay_passport_dialog_single_btn_view"
            android:paddingTop="@dimen/cj_pay_padding_9"
            android:paddingBottom="@dimen/cj_pay_padding_10"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/cj_pay_i_know"/>
    </LinearLayout>
</LinearLayout>
