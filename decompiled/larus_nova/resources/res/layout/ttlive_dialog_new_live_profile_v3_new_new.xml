<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.live.profile.customview.TransitionConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/new_profile_vertical_top_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/new_profile_exit_effect_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/new_profile_root_view"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <Space
            android:id="@+id/new_profile_content_white_bg_top_anchor"
            android:layout_width="0dp"
            android:layout_height="3px"
            app:layout_constraintBottom_toTopOf="@+id/new_profile_content_white_bg"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <Space
            android:id="@+id/new_profile_anchor_image_entry_container_anchor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/new_profile_content_white_bg"/>
        <FrameLayout
            android:id="@+id/new_profile_anchor_image_entry_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp"
            app:layout_constraintBottom_toTopOf="@+id/new_profile_anchor_image_entry_container_anchor"
            app:layout_constraintLeft_toLeftOf="parent"/>
        <View
            android:id="@+id/new_profile_content_white_bg"
            android:background="@drawable/ttlive_bg_new_live_profile_dialog"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="44dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/new_profile_max_border_layout"/>
        <View
            android:id="@+id/new_profile_content_bg_color"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/new_profile_content_white_bg"
            app:layout_constraintLeft_toLeftOf="@+id/new_profile_content_white_bg"
            app:layout_constraintRight_toRightOf="@+id/new_profile_content_white_bg"
            app:layout_constraintTop_toTopOf="@+id/new_profile_content_white_bg"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/new_profile_content_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:actualImageScaleType="focusCrop"
            app:layout_constraintBottom_toBottomOf="@+id/new_profile_content_white_bg"
            app:layout_constraintLeft_toLeftOf="@+id/new_profile_content_white_bg"
            app:layout_constraintRight_toRightOf="@+id/new_profile_content_white_bg"
            app:layout_constraintTop_toTopOf="@+id/new_profile_content_white_bg_top_anchor"/>
        <FrameLayout
            android:id="@+id/new_profile_panel_effect_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/new_profile_content_white_bg"
            app:layout_constraintLeft_toLeftOf="@+id/new_profile_content_white_bg"
            app:layout_constraintRight_toRightOf="@+id/new_profile_content_white_bg"
            app:layout_constraintTop_toTopOf="@+id/new_profile_content_white_bg_top_anchor"/>
        <Space
            android:id="@+id/new_live_profile_top_dynamic_space_v4"
            android:layout_width="0dp"
            android:layout_height="96dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/new_profile_max_border_layout"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/new_profile_top_skin_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="@+id/new_live_profile_top_dynamic_space_v4"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <FrameLayout
            android:id="@+id/new_profile_top_dress_lynx_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/new_profile_white_bg_top_anchor"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/new_profile_white_bg_top_anchor"/>
        <Space
            android:id="@+id/new_profile_white_bg_top_anchor"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="44dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/new_profile_max_border_layout"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/new_profile_top_skin_image_static_2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:actualImageScaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="@+id/new_profile_white_bg_top_anchor"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/new_profile_white_bg_top_anchor"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/new_profile_top_skin_image_extend"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:actualImageScaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="@+id/new_profile_white_bg_top_anchor"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/new_profile_white_bg_top_anchor"/>
        <FrameLayout
            android:id="@+id/new_profile_enter_effect_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/new_profile_content_white_bg"
            app:layout_constraintLeft_toLeftOf="@+id/new_profile_content_white_bg"
            app:layout_constraintRight_toRightOf="@+id/new_profile_content_white_bg"
            app:layout_constraintTop_toTopOf="@+id/new_profile_content_white_bg_top_anchor"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/new_profile_max_border_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">
            <View
                android:layout_width="1dp"
                android:layout_height="96dp"
                app:layout_constraintBottom_toTopOf="@+id/profile_dynamic_space"
                app:layout_constraintLeft_toLeftOf="parent"/>
            <View
                android:id="@+id/profile_dynamic_space"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:layout_marginBottom="20dp"
                app:layout_constraintBottom_toTopOf="@+id/new_live_profile_user_name"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <com.bytedance.android.live.uikit.textview.AlwaysMarqueeTextView
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_new_profile_black"
                android:ellipsize="marquee"
                android:gravity="start|center_vertical"
                android:id="@+id/new_live_profile_user_name"
                android:fadingEdge="horizontal"
                android:fadingEdgeLength="20dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:marqueeRepeatLimit="1"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toTopOf="@+id/new_profile_host_nickname"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/grade_icon"
                app:layout_constraintWidth_default="wrap"/>
            <HorizontalScrollView
                android:id="@+id/grade_icon"
                android:visibility="gone"
                android:scrollbars="none"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="10dp"
                android:overScrollMode="never"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="@+id/new_live_profile_user_name"
                app:layout_constraintLeft_toRightOf="@+id/new_live_profile_user_name"
                app:layout_constraintRight_toLeftOf="@+id/live_user_card_commerce_entrance"
                app:layout_constraintTop_toTopOf="@+id/new_live_profile_user_name">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/grade_icon_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </HorizontalScrollView>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/live_user_card_commerce_entrance"
                android:background="@drawable/ttlive_bg_live_user_card_commerce_entrance"
                android:visibility="gone"
                android:layout_width="68dp"
                android:layout_height="22dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/new_live_profile_user_name"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/new_live_profile_user_name">
                <ImageView
                    android:id="@+id/live_user_card_commerce_entrance_image"
                    android:background="@drawable/ttlive_live_user_card_commerce_entrance_image"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginLeft="6dp"
                    android:layout_marginStart="6dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#161823"
                    android:gravity="center"
                    android:id="@+id/live_user_card_commerce_entrance_text"
                    android:background="#00000000"
                    android:layout_width="wrap_content"
                    android:layout_height="17dp"
                    android:alpha="0.7"
                    android:fontFamily="PingFangSC-Medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/live_user_card_commerce_entrance_image"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/live_user_card_commerce_entrance_arrow"
                    android:background="@drawable/ttlive_live_user_card_commerce_entrance_arrow"
                    android:layout_width="6dp"
                    android:layout_height="8dp"
                    android:layout_marginRight="6dp"
                    android:layout_marginEnd="6dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/live_user_card_commerce_entrance_text"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <FrameLayout
                android:id="@+id/new_profile_host_nickname"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/new_profile_tags_flow_layout"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <com.bytedance.android.livesdk.widget.FlowLayout
                android:id="@+id/new_profile_tags_flow_layout"
                android:paddingTop="4dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/new_profile_v3_divider_space"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <View
                android:id="@+id/new_profile_v3_divider_space"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                app:layout_constraintBottom_toTopOf="@+id/new_profile_v3_divider"/>
            <View
                android:id="@+id/new_profile_v3_divider"
                android:background="@color/ttlive_new_profile_12black"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toTopOf="@+id/new_profile_info_layout"/>
            <com.bytedance.android.livesdk.widget.FlowLayout
                android:id="@+id/new_profile_info_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:layout_constraintBottom_toTopOf="@+id/new_profile_desc_layout"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/new_profile_desc_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:layout_constraintBottom_toTopOf="@+id/new_profile_space_on_the_honor_wall"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <Space
                android:id="@+id/new_profile_space_on_the_honor_wall"
                android:layout_width="0dp"
                android:layout_height="12dp"
                app:layout_constraintBottom_toTopOf="@+id/new_profile_honor_wall_scroller"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <com.bytedance.android.livesdk.widget.MaxHeightScrollView
                android:id="@+id/new_profile_honor_wall_scroller"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                app:layout_constraintBottom_toTopOf="@+id/new_profile_bottom_space"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:id="@+id/new_profile_fans_club_vip_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toTopOf="@+id/horizontal_scroll_area"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <FrameLayout
                        android:id="@+id/horizontal_scroll_area"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toTopOf="@+id/multi_link_resident_chat_room_container"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"/>
                    <FrameLayout
                        android:id="@+id/multi_link_resident_chat_room_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toTopOf="@+id/profile_anchor_home_container"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"/>
                    <FrameLayout
                        android:id="@+id/profile_anchor_home_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toTopOf="@+id/new_profile_gift_exhibition_container"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"/>
                    <FrameLayout
                        android:id="@+id/new_profile_gift_exhibition_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toTopOf="@+id/new_profile_bottom_horizontal_honour_wall_area"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"/>
                    <FrameLayout
                        android:id="@+id/new_profile_bottom_horizontal_honour_wall_area"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toTopOf="@+id/new_profile_bottom_common_area"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"/>
                    <FrameLayout
                        android:id="@+id/new_profile_bottom_common_area"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent">
                        <com.bytedance.android.livesdk.widget.FlowLayout
                            android:id="@+id/new_profile_honour_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"/>
                        <ViewStub
                            android:id="@+id/new_profile_shop"
                            android:layout="@layout/ttlive_profile_v3_shop_layout"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"/>
                        <FrameLayout
                            android:id="@+id/new_profile_shop_container"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"/>
                    </FrameLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.bytedance.android.livesdk.widget.MaxHeightScrollView>
            <Space
                android:id="@+id/new_profile_bottom_space"
                android:layout_width="0dp"
                android:layout_height="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/new_live_profile_top_right_area"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginTop="60dp"
            android:layout_marginStart="106dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/new_profile_max_border_layout"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/new_live_profile_avatar"
            android:background="@drawable/ttlive_profile_avatar_bg_oval_black"
            android:padding="2dp"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_marginTop="32dp"
            android:layout_marginStart="14dp"
            app:actualImageScaleType="fitCenter"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/new_profile_max_border_layout"
            app:overlayImage="@drawable/ttlive_profile_avatar_overlay_mask"
            app:placeholderImage="@drawable/ttlive_avatar_empty_light"
            app:roundAsCircle="true"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/new_live_profile_avatar_border"
            android:layout_width="90dp"
            android:layout_height="90dp"
            app:layout_constraintBottom_toBottomOf="@+id/new_live_profile_avatar"
            app:layout_constraintLeft_toLeftOf="@+id/new_live_profile_avatar"
            app:layout_constraintRight_toRightOf="@+id/new_live_profile_avatar"
            app:layout_constraintTop_toTopOf="@+id/new_live_profile_avatar"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/new_profile_dynamic_top_icon_for_relation_layout"
            android:background="@drawable/ttlive_bg_new_live_profile_top_dynamic_icon"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintRight_toLeftOf="@+id/new_live_profile_top_dynamic_icon_area"
            app:layout_constraintTop_toTopOf="@+id/new_live_profile_top_dynamic_icon_area">
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/new_profile_dynamic_top_icon_for_relation_left_icon"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="6dp"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/white"
                android:layout_gravity="center_vertical"
                android:id="@+id/new_profile_dynamic_top_icon_for_relation_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/new_profile_dynamic_top_icon_for_relation_right_icon"
                android:background="@drawable/ttlive_ic_profile_v3_right_arrow_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/new_live_profile_top_dynamic_icon_area"
            android:background="@drawable/ttlive_bg_new_live_profile_top_dynamic_icon"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/new_profile_max_border_layout">
            <ImageView
                android:id="@+id/new_profile_dynamic_top_icon_for_digg"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:src="@drawable/ttlive_bg_profile_dynamic_digg_button"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/new_profile_dynamic_top_icon_left_container"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.bytedance.android.live.core.widget.HSImageView
                    android:id="@+id/new_profile_dynamic_top_icon_left"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"/>
                <Space
                    android:id="@+id/new_profile_dynamic_top_icon_left_space"
                    android:visibility="gone"
                    android:layout_width="6dp"
                    android:layout_height="0dp"/>
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/white"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/new_profile_dynamic_top_icon_left_text"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/new_profile_dynamic_top_right_Layout"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <View
                    android:id="@+id/new_profile_dynamic_top_divider"
                    android:background="@color/ttlive_new_profile_20white"
                    android:layout_width="0.5dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"/>
                <LinearLayout
                    android:id="@+id/new_profile_dynamic_top_icon_right_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.bytedance.android.live.core.widget.HSImageView
                        android:id="@+id/new_profile_dynamic_top_icon_right"
