<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/shop_net_error_image"
        android:layout_width="120sp"
        android:layout_height="120sp"
        android:src="@drawable/ec_shop_net_error_icon_v2"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/shopping_std_bg_primary_1"
        android:id="@+id/shop_net_error_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/ec_shop_net_error_title"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#5c5d65"
        android:id="@+id/shop_net_error_sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ec_shop_net_error_sub_title"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/shop_net_error_refresh"
        android:background="@drawable/ec_shop_net_error_refresh_button_bg"
        android:layout_width="160dp"
        android:layout_height="44dp"
        android:layout_marginTop="40dp"
        android:text="@string/ec_shop_net_error_refresh_text"/>
</LinearLayout>
