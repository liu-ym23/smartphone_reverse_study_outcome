<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/base_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/fragment_base_pad_header"/>
        <com.bytedance.ee.bear.list.homepage.tab.HomeViewPager
            android:id="@+id/home_view_pager"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <com.bytedance.ee.bear.widgets.button.CommonCreateButton
        android:layout_gravity="end|bottom"
        android:id="@+id/pad_home_create_btn"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
