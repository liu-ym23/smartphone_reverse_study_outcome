<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="4dp"
    android:layout_marginTop="8dp"
    android:layout_marginRight="4dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/diamond_layout"
        android:background="@drawable/ttlive_bg_recharge_deal_selector"
        android:layout_width="match_parent"
        android:layout_height="68dp">
        <com.bytedance.android.live.recharge.platform.core.ui.DiamondFitTextView
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_recharge_diamond_color"
            android:gravity="bottom"
            android:layout_gravity="center"
            android:id="@+id/diamond"
            android:layout_width="wrap_content"
            android:layout_height="27dp"
            android:maxLines="1"
            app:ttlive_fit_des_text_size="13dp"/>
        <LinearLayout
            android:gravity="bottom"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ttlive_recharge_discount_price_color"
                android:id="@+id/discount_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <com.bytedance.android.live.recharge.platform.core.ui.StrikeThroughText
                android:textSize="11dp"
                android:textColor="@color/ttlive_recharge_old_price_color"
                android:id="@+id/original_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:maxLines="1"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="10dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_recharge_top_right_desc_color"
        android:gravity="center"
        android:layout_gravity="end"
        android:id="@+id/desc"
        android:background="@drawable/ttlive_bg_recharge_top_right_desc"
        android:paddingLeft="5dp"
        android:paddingTop="1dp"
        android:paddingRight="5dp"
        android:paddingBottom="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"/>
</FrameLayout>
