<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ttlive_core_bg_common"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.openplatform.impl.base.view.OpenPlatformTitleBar
        android:id="@+id/title_bar"
        android:paddingLeft="12dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/business_tools_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/title_bar">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="@string/ttlive_mini_app_shelf_management_business_tools_title"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/business_tools_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/new_page_view_container"
        android:background="@drawable/ttlive_open_platform_shelf_card_background"
        android:paddingLeft="8dp"
        android:paddingRight="12dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="8dp"
        app:layout_constraintTop_toBottomOf="@+id/business_tools_container">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/app_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="fitCenter"
            app:roundedCornerRadius="4dp"
            app:roundingBorderColor="#33000000"
            app:roundingBorderWidth="0.5dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/ttlive_uikit_const_tPrimary"
            android:id="@+id/app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>
        <TextView
            android:textColor="@color/ttlive_douyin_light_TextSecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_open_platform_shelf_management_new_page"/>
        <ImageView
            android:layout_width="6dp"
            android:layout_height="10dp"
            android:layout_marginLeft="7dp"
            android:src="@drawable/ttlive_open_platform_arrow_icon"
            android:layout_marginStart="7dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/bottom_btn_container"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="111dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/bottom_btn_edit_container"
            android:paddingLeft="9dp"
            android:paddingRight="9dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp">
            <CheckBox
                android:textSize="15sp"
                android:textColor="#222222"
                android:id="@+id/select_all_check_box"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:text="@string/ttlive_open_platform_select_all"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                style="@style/ttlive_open_platform_check_box_style"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/ttlive_douyin_text_TextQuaternary"
                android:gravity="center"
                android:id="@+id/batch_delete_btn"
                android:background="@drawable/ttlive_open_platform_gray_btn_background"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginLeft="13dp"
                android:text="@string/ttlive_open_platform_delete"
                android:layout_weight="1"
                android:layout_marginStart="13dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/start_live_btn"
                android:background="@drawable/ttlive_open_platform_red_btn_background"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginLeft="13dp"
                android:text="@string/ttlive_open_platform_start_live"
                android:layout_weight="1"
                android:layout_marginStart="13dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/finish_btn"
                android:background="@drawable/ttlive_open_platform_red_btn_background"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginLeft="13dp"
                android:text="@string/ttlive_open_platform_finish"
                android:layout_weight="1"
                android:layout_marginStart="13dp"/>
        </LinearLayout>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/shelf_card_list"
        android:background="@color/ttlive_core_bg_common"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toTopOf="@+id/divider_line"
        app:layout_constraintTop_toBottomOf="@+id/new_page_view_container"/>
    <View
        android:id="@+id/divider_line"
        android:background="#f2f2f2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_btn_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
