<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.bytedance.android.ec.core.widget.price.PriceView
        android:textSize="14dp"
        android:id="@+id/tv_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:pv_autoResize="true"
        app:pv_prefixMarginRight="1dp"
        app:pv_prefixTextSizeRatio="0.714"
        app:pv_priceBold="true"
        app:pv_priceDecimalTextSizeRatio="1"
        app:pv_priceTextColor="@color/ec_color_black_161823"
        app:pv_yuanSymbolMarginRight="3dp"
        app:pv_yuanSymbolRatioOfPriceTextSize="0.714"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_bid_info"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:id="@+id/iv_user_avatar"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="10dp"
            android:id="@+id/tv_desc_first"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_user_avatar"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#ff3344"
            android:id="@+id/tv_desc_second"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_desc_first"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
