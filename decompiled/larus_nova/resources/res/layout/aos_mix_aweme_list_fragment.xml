<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:background="@drawable/aos_mix_list_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="50dp"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="13sp"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:id="@+id/mix_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="150dp"
            android:maxLines="1"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@android:color/white"
            android:id="@+id/mix_name_center_point"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" · "/>
        <TextView
            android:textSize="13sp"
            android:textColor="@android:color/white"
            android:id="@+id/mix_updated_episode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginRight="10dp"
        android:src="@drawable/aos_mix_list_dialog_close"
        app:layout_constraintBottom_toBottomOf="@+id/top_bar"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/top_bar"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toTopOf="@+id/collect_bar"
        app:layout_constraintTop_toBottomOf="@+id/top_bar"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DoubleColorBallAnimationView
        android:id="@+id/loading_view"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toTopOf="@+id/collect_bar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/collect_bar"
        android:background="@drawable/aos_mix_list_collect_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="11dp"
        android:layout_marginRight="11dp"
        android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <ImageView
            android:id="@+id/mix_list_collect_icon"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/aos_ic_mix_list_uncollect"/>
        <TextView
            android:textSize="13sp"
            android:id="@+id/mix_list_collect_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/collect_remind"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/collect_bar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <LinearLayout
            android:gravity="center"
            android:background="@drawable/aos_mix_list_dialog_collect_remind_gb"
            android:padding="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="13sp"
                android:textColor="@android:color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/aos_mix_collect_to_mine"/>
            <View
                android:background="#33ffffff"
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/aos_mix_list_collected_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/aos_mix_collect_go_to_douyin"/>
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginLeft="2dp"
                android:src="@drawable/aos_ic_mix_collect_remind_right"/>
        </LinearLayout>
        <ImageView
            android:layout_width="20dp"
            android:layout_height="7dp"
            android:src="@drawable/aos_ic_mix_list_dialog_collect_triangle"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
