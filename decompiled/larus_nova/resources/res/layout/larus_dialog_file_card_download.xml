<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/download_dialog_root"
    android:background="@drawable/larus_bg_file_card_download_dialog"
    android:layout_width="@dimen/dp_288"
    android:layout_height="@dimen/dp_144">
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/download_title"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_24"
        android:text="@string/larus_drive_toast_downloading"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:id="@+id/download_progress"
        android:layout_width="@dimen/dp_240"
        android:layout_height="@dimen/dp_6"
        android:layout_marginTop="@dimen/dp_16"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/larus_file_card_download_progress"
        android:indeterminateTint="?attr/larus_primary_50"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/download_title"
        style="@android:style/Widget.ProgressBar.Horizontal"/>
    <View
        android:id="@+id/download_divider"
        android:background="?attr/larus_neutral_transparent_2"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_0_5"
        app:layout_constraintBottom_toTopOf="@+id/download_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/download_cancel"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_48"
        android:text="@string/larus_cancel"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
