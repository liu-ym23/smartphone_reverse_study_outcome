<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/loading_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.shopping.anchorv4.voavhs.head.base.LengthenedCompatDraweeView
            android:id="@+id/anchor_v4_frame_image"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:fadeDuration="0"/>
        <com.bytedance.android.shopping.anchorv4.widgets.WireFrameViewV2
            android:id="@+id/anchor_v4_frame_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <ViewStub
        android:id="@+id/error_view_stub"
        android:visibility="gone"
        android:layout="@layout/ec_common_layout_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/error_view_stub_v2"
        android:visibility="gone"
        android:layout="@layout/ec_pdp_network_error_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/frame_close"
        android:padding="5dp"
        android:visibility="gone"
        android:layout_width="@dimen/commerce_anchor_v3_top_tab_height"
        android:layout_height="@dimen/commerce_anchor_v3_top_tab_height"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="36dp"
        android:src="@drawable/ec_commerce_anchor_v4_back_arrow_shadow"
        android:contentDescription="@string/shopping_return"
        android:layout_marginStart="8dp"/>
    <FrameLayout
        android:id="@+id/frame_close_applet"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="30dp"/>
</FrameLayout>
