<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_interact_profile_card_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@drawable/ttlive_interact_profile_card_top_half_bg"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/image_close"
        android:background="@drawable/ttlive_interact_profile_close_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="2dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/profile_label"
        android:layout_width="50dp"
        android:layout_height="14dp"
        android:layout_marginLeft="3dp"
        android:layout_marginTop="3dp"
        android:layout_marginStart="3dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/image_avatar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="23dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAsCircle="true"/>
    <com.bytedance.android.live.ui.PingFangSCTextView
        android:textSize="12dp"
        android:textColor="#161823"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="81dp"
        android:text="@string/ttlive_interact_profile_card_title"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.ui.PingFangSCTextView
        android:textSize="10dp"
        android:textColor="#99161823"
        android:id="@+id/tv_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="101dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.liveinteract.interact.audience.ui.StarView
        android:id="@+id/star1"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="121dp"
        android:layout_marginStart="15dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.liveinteract.interact.audience.ui.StarView
        android:id="@+id/star2"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="121dp"
        android:layout_marginStart="32dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.liveinteract.interact.audience.ui.StarView
        android:id="@+id/star3"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginLeft="49dp"
        android:layout_marginTop="121dp"
        android:layout_marginStart="49dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.liveinteract.interact.audience.ui.StarView
        android:id="@+id/star4"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginLeft="66dp"
        android:layout_marginTop="121dp"
        android:layout_marginStart="66dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.liveinteract.interact.audience.ui.StarView
        android:id="@+id/star5"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginLeft="83dp"
        android:layout_marginTop="121dp"
        android:layout_marginStart="83dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.ui.PingFangSCTextView
        android:textSize="13dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/tv_confirm"
        android:background="#fe2c55"
        android:layout_width="104dp"
        android:layout_height="24dp"
        android:layout_marginBottom="4dp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
