<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="220dp"
    android:minHeight="220dp">
    <View
        android:background="@drawable/ttlive_bg_live_remind_follow"
        android:layout_width="match_parent"
        android:layout_height="178dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <View
        android:id="@+id/avatar_position"
        android:background="@drawable/ttlive_bg_avatar_border"
        android:layout_width="76dp"
        android:layout_height="76dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/avatar"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_position"
        app:layout_constraintEnd_toEndOf="@+id/avatar_position"
        app:layout_constraintLeft_toLeftOf="@+id/avatar_position"
        app:layout_constraintRight_toRightOf="@+id/avatar_position"
        app:layout_constraintStart_toStartOf="@+id/avatar_position"
        app:layout_constraintTop_toTopOf="@+id/avatar_position"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="#404040"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/name"
        android:paddingTop="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:maxLines="1"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/douyin_official_pick_top"
        app:layout_constraintTop_toBottomOf="@+id/avatar"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/douyin_official_pick_top"
        android:background="@drawable/ttlive_douyin_official_pick_follow_bg"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="15dp"
        android:text="@string/ttlive_official_pick_follow_top"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toRightOf="@+id/name"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avatar"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_core_hs_unfollow"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/ttlive_official_pick_follow"
        android:maxLines="2"
        app:layout_constraintTop_toBottomOf="@+id/name"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/follow"
        android:background="@drawable/ttlive_douyin_official_pick_follow_bg"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="28dp"
        android:layout_marginTop="25dp"
        android:layout_marginRight="28dp"
        android:text="@string/ttlive_official_pick_follow_broadcast"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/description"/>
</androidx.constraintlayout.widget.ConstraintLayout>
