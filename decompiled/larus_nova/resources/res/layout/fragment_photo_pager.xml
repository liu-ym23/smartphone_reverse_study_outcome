<?xml version="1.0" encoding="utf-8"?>
<com.larksuite.framework.palette.widget.ConstraintLayoutPalette xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_container"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.lark.widget.photo.preview.view.PhotoPagerWrapLayout
        android:id="@+id/gallery_content_wrapper"
        android:background="@color/lkui_transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.ss.android.lark.widget.previewanimation.toolkit.DragScaleView
            android:id="@+id/drag_scale_wrapper"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vp_photos"
                android:background="@color/lkui_transparent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.ss.android.lark.widget.previewanimation.toolkit.DragScaleView>
        <FrameLayout
            android:layout_gravity="top"
            android:id="@+id/photoPagerHeader"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <TextView
                android:textSize="@dimen/dp_16"
                android:textColor="@color/lkui_N00"
                android:layout_gravity="center"
                android:id="@+id/tvIndex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/ivDelete"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_16"
                app:srcCompat="@drawable/ic_trash_delete"/>
        </FrameLayout>
        <RelativeLayout
            android:layout_gravity="bottom"
            android:id="@+id/ll_action_menu"
            android:visibility="invisible"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="37dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <TextView
                android:textSize="@dimen/lkui_button_text_size_14"
                android:textColor="@color/static_white"
                android:gravity="center"
                android:id="@+id/look_origin_icon"
                android:background="@drawable/look_origin_icon_bg"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_32"
                android:minWidth="96dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:gravity="center"
                android:id="@+id/iv_translate_image"
                android:background="@drawable/action_menu_state_bg"
                android:padding="6dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginLeft="12dp"
                android:layout_toLeftOf="@+id/iv_ocr_image"
                android:layout_centerVertical="true"
                app:srcCompat="@drawable/ud_icon_translate_outlined"
                app:tint="@color/static_white"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:gravity="center"
                android:id="@+id/iv_ocr_image"
                android:background="@drawable/action_menu_bg"
                android:padding="6dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginLeft="12dp"
                android:layout_toLeftOf="@+id/iv_edit_image"
                android:layout_centerVertical="true"
                app:srcCompat="@drawable/ud_icon_extract_text_outlined"
                app:tint="@color/static_white"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:gravity="center"
                android:id="@+id/iv_edit_image"
                android:background="@drawable/action_menu_bg"
                android:padding="6dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginLeft="12dp"
                android:layout_toLeftOf="@+id/iv_download_image"
                android:layout_centerVertical="true"
                app:srcCompat="@drawable/ud_icon_edit_outlined"
                app:tint="@color/static_white"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:gravity="center"
                android:id="@+id/iv_download_image"
                android:background="@drawable/action_menu_bg"
                android:padding="6dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginLeft="12dp"
                android:layout_toLeftOf="@+id/iv_view_chat_album_from_image"
                android:layout_centerVertical="true"
                app:srcCompat="@drawable/ud_icon_download_outlined"
                app:tint="@color/static_white"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:gravity="center"
                android:id="@+id/iv_view_chat_album_from_image"
                android:background="@drawable/action_menu_bg"
                android:padding="6dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginLeft="12dp"
                android:layout_toLeftOf="@+id/iv_more_menu"
                android:layout_centerVertical="true"
                app:srcCompat="@drawable/ud_icon_photo_album_filled"
                app:tint="@color/static_white"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:gravity="center"
                android:id="@+id/iv_more_menu"
                android:background="@drawable/action_menu_bg"
                android:padding="6dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginLeft="12dp"
                android:layout_toLeftOf="@+id/iv_right_holder"
                android:layout_centerVertical="true"
                app:srcCompat="@drawable/ud_icon_more_outlined"
                app:tint="@color/static_white"/>
            <View
                android:id="@+id/iv_right_holder"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </com.ss.android.lark.widget.photo.preview.view.PhotoPagerWrapLayout>
</com.larksuite.framework.palette.widget.ConstraintLayoutPalette>
