<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="10dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/root_view"
        android:background="@drawable/dux_bg_toast"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.bytedance.dux.drawable.DoubleColorBallAnimationView
            android:id="@+id/doubleballtoast"
            android:layout_width="32sp"
            android:layout_height="32sp"
            app:dux_doublecolorball_scene="dux_internal"/>
        <com.bytedance.dux.text.DuxTextView
            android:textSize="14sp"
            android:textColor="@color/ConstTextInverse"
            android:gravity="center"
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="60sp"
            android:text="加载中"/>
    </LinearLayout>
    <com.bytedance.dux.image.DuxImageView
        android:layout_gravity="end|top"
        android:id="@+id/close_btn"
        android:visibility="gone"
        android:layout_width="12sp"
        android:layout_height="12sp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_s_s_xmark_outlined_12"
        android:layout_marginEnd="8dp"
        app:tint="@color/ConstTextInverse5"/>
</FrameLayout>
