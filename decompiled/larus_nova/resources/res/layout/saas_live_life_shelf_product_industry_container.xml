<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.lighten.loader.SmartImageView
        android:id="@+id/live_life_shelf_product_industry_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        app:actualImageScaleType="fitXY"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/live_life_shelf_product_industry_icon"
            android:layout_width="24dp"
            android:layout_height="25dp"
            android:scaleType="fitXY"
            android:layout_marginStart="8dp"
            app:actualImageScaleType="fitXY"/>
        <com.bytedance.locallife.live.goodsshelves.view.PriorityWholeChildLayout
            android:id="@+id/live_life_shelf_product_industry_content_container"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            app:layout_orientation="horizontal"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/live_life_shelf_product_industry_tips_container"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:paddingEnd="6dp"
            android:layout_marginStart="2dp">
            <com.bytedance.dux.text.DuxTextView
                android:textSize="11dp"
                android:textColor="#bf161823"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/live_life_shelf_product_industry_tips_tv"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:maxLines="1"
                android:fontFamily="PingFangSC-Medium"/>
            <com.bytedance.lighten.loader.SmartImageView
                android:id="@+id/live_life_shelf_product_brand_splitter"
                android:layout_width="12dp"
                android:layout_height="12dp"
                app:actualImageUri="https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsm_lmps_shjvs/ljhwZthlaukjlkulzlp/live/shelf/img/common/card_industry_arrow@3x.png"/>
        </LinearLayout>
    </LinearLayout>
</merge>
