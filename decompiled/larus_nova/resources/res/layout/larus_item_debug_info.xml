<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@drawable/larus_rounded_background_white"
    android:paddingLeft="?attr/larus_dp_12"
    android:paddingTop="?attr/larus_dp_8"
    android:paddingRight="?attr/larus_dp_12"
    android:paddingBottom="?attr/larus_dp_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/key_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="?attr/larus_dp_8"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/larus_neutral_70"
        android:id="@+id/value_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
</LinearLayout>
