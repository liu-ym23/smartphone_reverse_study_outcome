<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/poi_activity_poi_photes_page_472428752"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.locallife.photo.photopage.view.ScrollFlexViewPager
        android:id="@+id/album_multipage_view_pager"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/album_fragment_container_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/photos_container"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/album_page_status_bar"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
        <FrameLayout
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/POITextPrimary"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/album_page_title"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/poi_album_page"/>
            <com.bytedance.ies.dmt.ui.widget.tablayout.DmtTabLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/album_page_title_tab_layout"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                app:tabBackground="@null"
                app:tabGravity="fill"
                app:tabIndicatorColor="@color/POIPrimary2"
                app:tabIndicatorHeight="2dp"
                app:tabIndicatorWidth="24dp"
                app:tabMaxWidth="400dp"
                app:tabMinWidth="0dp"
                app:tabMode="scrollable"
                app:tabPaddingBottom="2dp"
                app:tabPaddingEnd="12dp"
                app:tabPaddingStart="12dp"
                app:tabTextAppearance="@style/poi_album_tab_style"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/album_toolbar_back"
                android:paddingLeft="0dp"
                android:paddingTop="10dp"
                android:paddingRight="20dp"
                android:paddingBottom="10dp"
                android:layout_width="40sp"
                android:layout_height="40sp"
                android:contentDescription="@string/poi_collect_back_description"
                app:srcCompat="@drawable/ic_s_s_arrowbackward_outlined"
                app:tint="@color/POITextPrimary"/>
            <com.bytedance.ies.dmt.ui.widget.DmtTextView
                android:textSize="15sp"
                android:textColor="#e6161823"
                android:layout_gravity="end|center_vertical"
                android:id="@+id/album_error_report"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/poi_album_page_photo_report"
                android:contentDescription="@string/poi_collect_back_description"/>
            <LinearLayout
                android:layout_gravity="end|center_vertical"
                android:orientation="horizontal"
                android:id="@+id/share_and_more_container"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/album_share"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="16dp"
                    app:srcCompat="@drawable/ic_s_s_arrowdowntoright_outlined_20"
                    app:tint="@color/POITextPrimary"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/album_more"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:srcCompat="@drawable/ic_s_s_ellipsis_outlined_20"
                    app:tint="@color/POITextPrimary"/>
            </LinearLayout>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/POITextPrimary"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/cancel_btn"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/poi_album_cancel"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/TextQuaternary"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/next_step"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/poi_album_next_step"/>
        </FrameLayout>
    </LinearLayout>
    <com.bytedance.locallife.cube.view.CubeContainerView
        android:layout_gravity="bottom"
        android:id="@+id/bottom_lynx_container_resident"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stateListAnimator="@null"/>
    <com.bytedance.locallife.photo.view.RoundedRelativeLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/error_toast_view"
        android:background="@drawable/poi_bg_album_error_toast_view"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="30dp">
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/POITextPrimaryDark"
            android:id="@+id/toast_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:text="@string/poi_album_page_error_report_toast"
            android:layout_toLeftOf="@+id/toast_cancel_btn"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/toast_cancel_btn"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:srcCompat="@drawable/ic_s_s_xmarkthin_outlined_16"/>
    </com.bytedance.locallife.photo.view.RoundedRelativeLayout>
</FrameLayout>
