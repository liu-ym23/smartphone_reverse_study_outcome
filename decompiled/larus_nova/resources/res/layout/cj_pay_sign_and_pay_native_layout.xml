<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_pay_sign_and_pay_native_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:id="@+id/sign_and_pay_root_view"
            android:background="@color/cj_pay_color_white"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/top_navigation_bar"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="44dp"
                    android:layout_marginRight="16dp">
                    <ImageView
                        android:id="@+id/sign_left_close_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/cj_pay_sign_and_pay_left_leave"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/sign_title_zone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_below="@+id/top_navigation_bar"
                    android:layout_centerHorizontal="true">
                    <ImageView
                        android:id="@+id/sign_title_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"/>
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/cj_pay_color_black_161823"
                        android:id="@+id/sign_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
                    android:id="@+id/sign_merchant_name_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_below="@+id/sign_title_zone"
                    android:layout_centerHorizontal="true"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/sign_price_zone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:baselineAligned="true"
                    android:layout_below="@+id/sign_merchant_name_text"
                    android:layout_centerHorizontal="true">
                    <TextView
                        android:textSize="28sp"
                        android:textColor="@color/cj_pay_color_black_161823"
                        android:id="@+id/sign_currency_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¥"/>
                    <TextView
                        android:textSize="36sp"
                        android:textColor="@color/cj_pay_color_black_161823"
                        android:id="@+id/sign_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="2dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#ffff6e26"
                    android:id="@+id/sign_voucher_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/sign_price_zone"
                    android:layout_centerHorizontal="true"/>
                <RelativeLayout
                    android:id="@+id/sign_switch_button_zone"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="40dp"
                    android:layout_marginRight="16dp"
                    android:layout_below="@+id/sign_voucher_text">
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#ff161823"
                        android:id="@+id/sign_switch_desc_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"/>
                    <FrameLayout
                        android:id="@+id/sign_switch_button_container"
                        android:layout_width="43dp"
                        android:layout_height="25dp"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
                <View
                    android:id="@+id/sign_upper_split_line"
                    android:background="#1f161823"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="24.5dp"
                    android:layout_below="@+id/sign_switch_button_zone"
                    android:layout_centerInParent="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/sign_and_pay_only_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="33dp"
                    android:layout_below="@+id/sign_switch_button_zone">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/sign_service_line_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginBottom="14dp">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#99161823"
                            android:layout_gravity="top"
                            android:id="@+id/sign_service_left"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cj_pay_sign_and_pay_service_title"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff161823"
                            android:gravity="left"
                            android:layout_gravity="top"
                            android:id="@+id/sign_service_right"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="24dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/sign_charge_line_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginBottom="24dp">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#99161823"
                            android:layout_gravity="top"
                            android:id="@+id/sign_charge_left"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cj_pay_sign_and_pay_native_deduct_period"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#ff161823"
                            android:gravity="left"
                            android:layout_gravity="top"
                            android:id="@+id/sign_charge_right"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="24dp"/>
                    </LinearLayout>
                    <View
                        android:id="@+id/sign_split_line"
                        android:background="#1f161823"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginBottom="17dp"
                        android:layout_centerInParent="true"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/sign_method_line_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:minHeight="58dp"
                        android:layout_below="@+id/sign_split_line">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#99161823"
                            android:layout_gravity="top"
                            android:id="@+id/sign_charge_left"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cj_pay_sign_and_pay_method_title"/>
                        <LinearLayout
                            android:gravity="left"
                            android:orientation="vertical"
                            android:id="@+id/sign_method_right_layout"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="24dp"
                            android:layout_weight="3">
                            <RelativeLayout
                                android:layout_gravity="center_vertical"
                                android:orientation="horizontal"
                                android:id="@+id/sign_page_method_line_right_upper"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <ImageView
                                    android:id="@+id/sign_selected_bank_icon"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_alignParentLeft="true"
                                    android:layout_centerVertical="true"/>
                                <TextView
                                    android:textSize="14sp"
                                    android:textColor="#ff161823"
                                    android:ellipsize="middle"
                                    android:id="@+id/sign_selected_bank_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="4dp"
                                    android:maxLines="1"
                                    android:layout_toLeftOf="@+id/cj_pay_sign_right_arrow"
                                    android:layout_toRightOf="@+id/sign_selected_bank_icon"
                                    android:layout_centerVertical="true"/>
                                <ImageView
                                    android:id="@+id/cj_pay_sign_right_arrow"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginLeft="2dp"
                                    android:src="@drawable/cj_pay_sign_right_arrow"
                                    android:layout_alignParentRight="true"
                                    android:layout_centerVertical="true"/>
                            </RelativeLayout>
                            <TextView
                                android:textSize="12sp"
                                android:textColor="#80161823"
                                android:id="@+id/sign_deduct_method_desc"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginLeft="20dp"
                                android:layout_below="@+id/sign_page_method_line_right_upper"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <com.android.ttcjpaysdk.base.ui.widget.LoadingButton
                    android:gravity="center"
                    android:id="@+id/sign_confirm_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cj_pay_custom_button_height_44"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="40dp"
                    android:layout_marginRight="16dp"
                    android:layout_below="@+id/sign_and_pay_only_view"
                    app:btnTextColor="@color/cj_pay_color_white"
                    app:btnTextSize="15sp"
                    app:loadingHeight="20dp"
                    app:loadingWidth="20dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
                    android:layout_gravity="left"
                    android:id="@+id/sign_agreement_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="13dp"
                    android:layout_marginRight="16dp"
                    android:layout_below="@+id/sign_confirm_btn"
                    android:lineSpacingExtra="2.5dp"/>
            </RelativeLayout>
        </ScrollView>
        <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
            android:id="@+id/sign_insurance_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="211dp"
            android:layout_marginBottom="@dimen/cj_pay_padding_16"
            android:layout_alignParentBottom="true"
            app:theme_type="0"/>
    </RelativeLayout>
    <include
        android:id="@+id/sign_method_list_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/cj_pay_activity_payment_method_layout"/>
</FrameLayout>
