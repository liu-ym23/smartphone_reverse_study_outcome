<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/cj_pay_action_chooser_root_layout"
    android:background="@drawable/cj_pay_bg_action_chooser"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_centerHorizontal="true">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/cj_pay_action_chooser_photo"
        android:background="@color/cj_pay_color_trans"
        android:layout_width="match_parent"
        android:layout_height="73dp">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="18dp"
            android:layout_marginRight="6dp"
            android:src="@drawable/cj_pay_action_chooser_camera_icon"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/cj_pay_color_black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cj_pay_action_chooser_camera"/>
    </LinearLayout>
    <View
        android:background="#1f161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/cj_pay_action_chooser_gallery"
        android:background="@color/cj_pay_color_trans"
        android:layout_width="match_parent"
        android:layout_height="73dp">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="18dp"
            android:layout_marginRight="6dp"
            android:src="@drawable/cj_pay_action_chooser_gallery_icon"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/cj_pay_color_black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cj_pay_action_chooser_gallery"/>
    </LinearLayout>
    <View
        android:background="#0d161823"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/cj_pay_action_chooser_exit"
        android:background="@color/cj_pay_color_trans"
        android:layout_width="match_parent"
        android:layout_height="73dp">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/cj_pay_color_black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cj_pay_action_chooser_cancel"/>
    </LinearLayout>
</LinearLayout>
