<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/space_kit_font_14"
        android:textColor="@color/text_placeholder"
        android:id="@+id/linkRangeTV"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_kit_len_2"
        android:text="@string/Bitable_Relation_AvailableDataScope"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/linkRangeSelector"
        android:background="@drawable/facade_round_around_xl"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_2"
        android:layout_marginBottom="@dimen/space_kit_len_16"
        android:minHeight="@dimen/space_kit_len_52"
        android:paddingStart="@dimen/space_kit_len_16"
        android:paddingEnd="@dimen/space_kit_len_16"
        android:backgroundTint="@color/facade_selector_item_float">
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_disable"
            android:id="@+id/linkRangeSelectorTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_kit_len_12"
            android:layout_marginBottom="@dimen/space_kit_len_12"
            android:text="@string/Bitable_Relation_AllRecord"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_kit_len_16"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/linkRangeSelectorIV"
            android:layout_width="@dimen/space_kit_len_16"
            android:layout_height="@dimen/space_kit_len_16"
            android:tint="@color/icon_disable"
            app:srcCompat="@drawable/ud_icon_right_outlined"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/no_permission_filter_condition_layout"
        android:background="@drawable/facade_round_around_xl"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_kit_len_16"
        android:backgroundTint="@color/facade_selector_item_float">
        <TextView
            android:textSize="@dimen/space_kit_font_14"
            android:textColor="@color/text_placeholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Bitable_AdvancedPermission_NoPermToAccessFieldDueToInaccessibleFilterCondition_Tooltip"/>
    </LinearLayout>
    <com.bytedance.ee.bear.bitable.filter.view.FilterInfoView
        android:id="@+id/filterInfoView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_kit_len_16"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/addNewRangeContainer"
        android:background="@drawable/facade_round_around_xl"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_kit_len_48"
        android:layout_marginBottom="@dimen/space_kit_len_16"
        android:paddingStart="@dimen/space_kit_len_16"
        android:paddingEnd="@dimen/space_kit_len_16"
        android:backgroundTint="@color/facade_selector_item_float">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/addNewRangeIcon"
            android:layout_width="@dimen/space_kit_len_20"
            android:layout_height="@dimen/space_kit_len_20"
            android:tint="@color/bitable_field_edit_highlight_tint"
            app:srcCompat="@drawable/ud_icon_add_outlined"/>
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/bitable_field_edit_highlight_tint"
            android:ellipsize="end"
            android:id="@+id/addNewRangeTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Bitable_Relation_AddCondition"
            android:singleLine="true"
            android:layout_marginStart="@dimen/space_kit_len_12"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/space_kit_font_14"
        android:textColor="@color/text_placeholder"
        android:id="@+id/recordNumberTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_kit_len_2"
        android:text="@string/Bitable_Relation_RecordNumSettings_Mobile"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/recordCheckerContainer"
        android:background="@drawable/facade_round_around_xl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_2"
        android:layout_marginBottom="@dimen/space_kit_len_14"
        android:minHeight="@dimen/space_kit_len_52"
        android:paddingStart="@dimen/space_kit_len_16"
        android:paddingEnd="@dimen/space_kit_len_16"
        android:backgroundTint="@color/bg_float">
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_title"
            android:id="@+id/recordCheckerTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/Bitable_Field_AddMultipleRecord"
            android:layout_weight="1"/>
        <com.larksuite.component.universe_design.udswitch.UDSwitch
            android:id="@+id/recordChecker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:layout_marginStart="@dimen/space_kit_len_16"/>
    </LinearLayout>
</LinearLayout>
