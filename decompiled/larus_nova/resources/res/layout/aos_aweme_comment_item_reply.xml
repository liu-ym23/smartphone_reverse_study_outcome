<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/aos_comment_bg_layout"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="57dp">
    <com.bytedance.awemeopen.infra.base.image.AoImageView
        android:layout_gravity="top"
        android:id="@+id/avatar"
        android:clickable="true"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/aos_text_tertiary"
        android:id="@+id/title"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        app:layout_constraintLeft_toRightOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="@+id/avatar"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/aos_s1"
        android:id="@+id/style"
        android:background="@drawable/comment_tag_style_author"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="3dp"
        android:paddingEnd="4dp"
        android:layout_marginStart="6dp"
        android:layout_toEndOf="@+id/title"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintLeft_toRightOf="@+id/title"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/reply_to_layout"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/style"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/reply_to_img"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/aweme_comment_icon_reply_to_reply_simplified_dark"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/aos_text_tertiary"
            android:ellipsize="end"
            android:id="@+id/reply_to"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
    <com.bytedance.awemeopen.apps.framework.feed.desc.MentionTextView
        android:textSize="15sp"
        android:textColor="@color/aos_text_primary"
        android:gravity="center_vertical"
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintLeft_toLeftOf="@+id/title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <com.bytedance.awemeopen.apps.framework.feed.follow.util.DuxTextView
        android:textSize="13dp"
        android:textColor="@color/TextReverse4"
        android:id="@+id/comment_fold_tips"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/aweme_comment_comment_is_folded"
        android:drawablePadding="2dp"
        android:drawableStart="@drawable/aweme_comment_exclamation_outline"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/aos_text_quaternary"
        android:id="@+id/time"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/view_stubs"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/aos_text_tertiary"
        android:id="@+id/reply"
        android:paddingLeft="4dp"
        android:paddingTop="1dp"
        android:paddingRight="4dp"
        android:paddingBottom="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:text="回复"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@+id/time"
        app:layout_constraintTop_toBottomOf="@+id/view_stubs"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/view_stubs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/content">
        <ViewStub
            android:id="@+id/image_view_stub"
            android:layout="@layout/aos_aweme_comment_view_stub_layout_image"
            android:layout_width="100dp"
            android:layout_height="100dp"/>
        <ViewStub
            android:id="@+id/gif_emoji_view_stub"
            android:layout="@layout/aos_aweme_comment_view_stub_layout_gif_emoji"
            android:layout_width="100dp"
            android:layout_height="100dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/digg_bury_container"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:paddingEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/time"/>
</androidx.constraintlayout.widget.ConstraintLayout>
