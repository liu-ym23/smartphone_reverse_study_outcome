<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@+id/sub_toolbar_item_font_color_layout"
    android:paddingLeft="6dp"
    android:paddingRight="6dp"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/sub_toolbar_item_font_color_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="1dp"
        android:src="@drawable/larus_doc_toolbar_font_icon"
        app:tint="@color/larus_neutral_100"/>
    <com.larus.office.base.plugins.toolbar.view.RoundedView
        android:layout_gravity="center_horizontal"
        android:id="@+id/sub_toolbar_item_font_color_indicator"
        android:layout_width="22dp"
        android:layout_height="3dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="1dp"
        android:layout_below="@+id/sub_toolbar_item_font_color_icon"
        android:layout_centerHorizontal="true"/>
</LinearLayout>
