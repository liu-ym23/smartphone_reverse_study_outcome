<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_game_comment_score_container"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="102dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="#f9f9f9"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="26dp"
            android:textColor="#161823"
            android:gravity="center"
            android:id="@+id/tv_average_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="12dp"
            android:includeFontPadding="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="8dp"
            android:textColor="#80161823"
            android:gravity="center"
            android:id="@+id/comment_total_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toEndOf="@+id/tv_average_score"
            app:layout_constraintStart_toStartOf="@+id/tv_average_score"
            app:layout_constraintTop_toBottomOf="@+id/tv_average_score"/>
        <TextView
            android:textSize="8dp"
            android:textColor="#80161823"
            android:gravity="center"
            android:id="@+id/current_version_score"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toEndOf="@+id/comment_total_count"
            app:layout_constraintStart_toStartOf="@+id/comment_total_count"
            app:layout_constraintTop_toBottomOf="@+id/comment_total_count"/>
        <com.bytedance.android.gamecp.business.view.GamePromoteCommonRatingBar
            android:id="@+id/ratingbar_score_distribution_five"
            android:layout_width="wrap_content"
            android:layout_height="6dp"
            android:layout_marginTop="14dp"
            android:layout_marginStart="104dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:starBgDrawable="@drawable/gamecp_ic_game_promote_score_star"
            app:starClickable="false"
            app:starCount="5"
            app:starDrawable="@drawable/gamecp_ic_game_promote_score_star"
            app:starPadding="4dp"
            app:starScrollable="false"
            app:starType="half"/>
        <ProgressBar
            android:id="@+id/progressbar_score_distribution_five"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:progress="50"
            android:progressDrawable="@drawable/gamecp_game_comment_score_seekbar"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/ratingbar_score_distribution_five"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ratingbar_score_distribution_five"
            app:layout_constraintTop_toTopOf="@+id/ratingbar_score_distribution_five"
            style="?android:attr/progressBarStyleHorizontal"/>
        <com.bytedance.android.gamecp.business.view.GamePromoteCommonRatingBar
            android:id="@+id/ratingbar_score_distribution_four"
            android:layout_width="wrap_content"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:thumb="@null"
            app:layout_constraintEnd_toEndOf="@+id/ratingbar_score_distribution_five"
            app:layout_constraintTop_toBottomOf="@+id/ratingbar_score_distribution_five"
            app:starBgDrawable="@drawable/gamecp_ic_game_promote_score_star"
            app:starClickable="false"
            app:starCount="4"
            app:starDrawable="@drawable/gamecp_ic_game_promote_score_star"
            app:starPadding="4dp"
            app:starScrollable="false"
            app:starType="half"/>
        <ProgressBar
            android:id="@+id/progressbar_score_distribution_four"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:progress="15"
            android:progressDrawable="@drawable/gamecp_game_comment_score_seekbar"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/ratingbar_score_distribution_four"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ratingbar_score_distribution_four"
            app:layout_constraintTop_toTopOf="@+id/ratingbar_score_distribution_four"
            style="?android:attr/progressBarStyleHorizontal"/>
        <com.bytedance.android.gamecp.business.view.GamePromoteCommonRatingBar
            android:id="@+id/ratingbar_score_distribution_three"
            android:layout_width="wrap_content"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="@+id/ratingbar_score_distribution_four"
            app:layout_constraintTop_toBottomOf="@+id/ratingbar_score_distribution_four"
            app:starBgDrawable="@drawable/gamecp_ic_game_promote_score_star"
            app:starClickable="false"
            app:starCount="3"
            app:starDrawable="@drawable/gamecp_ic_game_promote_score_star"
            app:starPadding="4dp"
            app:starScrollable="false"
            app:starType="half"/>
        <ProgressBar
            android:id="@+id/progressbar_score_distribution_three"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:progress="20"
            android:progressDrawable="@drawable/gamecp_game_comment_score_seekbar"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/ratingbar_score_distribution_three"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ratingbar_score_distribution_three"
            app:layout_constraintTop_toTopOf="@+id/ratingbar_score_distribution_three"
            style="?android:attr/progressBarStyleHorizontal"/>
        <com.bytedance.android.gamecp.business.view.GamePromoteCommonRatingBar
            android:id="@+id/ratingbar_score_distribution_two"
            android:layout_width="wrap_content"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="@+id/ratingbar_score_distribution_three"
            app:layout_constraintTop_toBottomOf="@+id/ratingbar_score_distribution_three"
            app:starBgDrawable="@drawable/gamecp_ic_game_promote_score_star"
            app:starClickable="false"
            app:starCount="2"
            app:starDrawable="@drawable/gamecp_ic_game_promote_score_star"
            app:starPadding="4dp"
            app:starScrollable="false"
            app:starType="half"/>
        <ProgressBar
            android:id="@+id/progressbar_score_distribution_two"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:progress="10"
            android:progressDrawable="@drawable/gamecp_game_comment_score_seekbar"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/ratingbar_score_distribution_two"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ratingbar_score_distribution_two"
            app:layout_constraintTop_toTopOf="@+id/ratingbar_score_distribution_two"
            style="?android:attr/progressBarStyleHorizontal"/>
        <com.bytedance.android.gamecp.business.view.GamePromoteCommonRatingBar
            android:id="@+id/ratingbar_score_distribution_one"
            android:layout_width="wrap_content"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="@+id/ratingbar_score_distribution_two"
            app:layout_constraintTop_toBottomOf="@+id/ratingbar_score_distribution_two"
            app:starBgDrawable="@drawable/gamecp_ic_game_promote_score_star"
            app:starClickable="false"
            app:starCount="1"
            app:starDrawable="@drawable/gamecp_ic_game_promote_score_star"
            app:starPadding="4dp"
            app:starScrollable="false"
            app:starType="half"/>
        <ProgressBar
            android:id="@+id/progressbar_score_distribution_one"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:progress="5"
            android:progressDrawable="@drawable/gamecp_game_comment_score_seekbar"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/ratingbar_score_distribution_one"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ratingbar_score_distribution_one"
            app:layout_constraintTop_toTopOf="@+id/ratingbar_score_distribution_one"
            style="?android:attr/progressBarStyleHorizontal"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
