<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_56">
    <TextView
        android:textSize="17sp"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/bottom_start_text"
        android:background="@drawable/bg_start_si"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/larus_dora_g_record_minutes_start_cn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_end_layout"
        android:background="@drawable/bg_end_si"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/larus_static_white"
            android:id="@+id/bottom_end_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/larus_dora_g_record_minutes_end_cn"
            app:layout_constraintBottom_toTopOf="@+id/recordDuration"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/recordDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bottom_end_text">
            <TextView
                android:textSize="?attr/larus_dp_13"
                android:typeface="monospace"
                android:textColor="@color/static_white_transparent_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00"/>
            <TextView
                android:textSize="?attr/larus_dp_13"
                android:textColor="@color/static_white_transparent_3"
                android:paddingBottom="?attr/larus_dp_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"/>
            <TextView
                android:textSize="?attr/larus_dp_13"
                android:typeface="monospace"
                android:textColor="@color/static_white_transparent_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00"/>
            <TextView
                android:textSize="?attr/larus_dp_13"
                android:textColor="@color/static_white_transparent_3"
                android:paddingBottom="?attr/larus_dp_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"/>
            <TextView
                android:textSize="?attr/larus_dp_13"
                android:typeface="monospace"
                android:textColor="@color/static_white_transparent_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
