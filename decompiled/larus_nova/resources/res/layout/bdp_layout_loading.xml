<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/bdp_bg_slide_hint"
    android:layout_width="167dp"
    android:layout_height="80dp"
    style="@style/bdp_popup_toast_layout">
    <ProgressBar
        android:id="@+id/bdp_loading_progress"
        android:visibility="visible"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginBottom="3dp"
        android:indeterminateOnly="true"
        android:indeterminateDrawable="@drawable/bdp_loading_progress"
        style="?android:attr/progressBarStyleSmall"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/bdp_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bdp_trying_loading"
        android:includeFontPadding="false"
        style="@style/bdp_popup_toast_text"/>
</LinearLayout>
