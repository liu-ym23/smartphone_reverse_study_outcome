<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:layout_width="102dp"
        android:layout_height="68dp">
        <ImageView
            android:layout_width="9.5dp"
            android:layout_height="9.5dp"
            android:layout_marginLeft="0.5dp"
            android:layout_marginTop="46dp"
            android:src="@drawable/ttlive_chat_channel_empty_ball_1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:layout_width="9.5dp"
            android:layout_height="9.5dp"
            android:layout_marginLeft="27dp"
            android:layout_marginTop="9.5dp"
            android:src="@drawable/ttlive_chat_channel_empty_ball_2"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_marginLeft="77.5dp"
            android:layout_marginTop="15dp"
            android:src="@drawable/ttlive_chat_channel_empty_ball_3"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerImageView
            android:id="@+id/self_avatar_in_three"
            android:layout_width="41dp"
            android:layout_height="41dp"
            android:layout_marginLeft="30dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundAsCircle="true"/>
        <com.bytedance.android.livesdk.widget.TransparentCircleIconView
            android:id="@+id/left_avatar_in_three"
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:layout_marginLeft="11dp"
            android:layout_marginTop="21dp"
            app:circleCenterLeftMargin="38.6dp"
            app:circleCenterTopMargin="12.5dp"
            app:circleRadius="22dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundAsCircle="true"/>
        <com.bytedance.android.livesdk.widget.TransparentCircleIconView
            android:id="@+id/right_avatar_in_three"
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:layout_marginTop="21dp"
            android:layout_marginRight="12dp"
            app:circleCenterLeftMargin="-12dp"
            app:circleCenterTopMargin="12.5dp"
            app:circleRadius="22dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundAsCircle="true"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
