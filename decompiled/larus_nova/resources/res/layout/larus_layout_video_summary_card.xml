<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rl_video_summary_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/iv_video_cover"
            android:background="@drawable/larus_flow_bg_black_8_rounded_rectangle"
            android:layout_width="@dimen/dp_56"
            android:layout_height="@dimen/dp_56"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundedCornerRadius="@dimen/dp_8"/>
        <TextView
            android:textSize="@dimen/dp_16"
            android:textStyle="bold"
            android:textColor="@color/neutral_100"
            android:ellipsize="end"
            android:id="@+id/tv_video_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_video_cover"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginStart="@dimen/dp_0"/>
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/neutral_50"
            android:ellipsize="end"
            android:id="@+id/tv_video_author"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_video_cover"
            app:layout_constraintTop_toBottomOf="@+id/tv_video_title"
            app:layout_goneMarginStart="@dimen/dp_0"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/v_line"
        android:background="@color/neutral_transparent_2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0_5"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginBottom="@dimen/dp_12"
        android:layout_below="@+id/rl_video_summary_header"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/rl_video_summary_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/v_line">
        <com.larus.bmhome.chat.layout.widget.MaxHeightRelativeLayout
            android:id="@+id/rl_video_summary_content_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:id="@+id/ll_loading"
                android:background="@drawable/larus_flow_bg_video_summary_loading"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_20"/>
        </com.larus.bmhome.chat.layout.widget.MaxHeightRelativeLayout>
        <View
            android:id="@+id/v_gradient"
            android:background="?attr/larus_flow_bg_vertical_linear_white_gradient"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_62"
            android:layout_above="@+id/tv_expand_all_summary"
            app:layout_constraintBottom_toBottomOf="@+id/tv_expand_all_summary"/>
        <TextView
            android:textSize="@dimen/dp_15"
            android:textColor="@color/neutral_50"
            android:gravity="center"
            android:id="@+id/tv_expand_all_summary"
            android:paddingTop="@dimen/dp_6"
            android:paddingBottom="@dimen/dp_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/larus_creation_details_label_expand"
            android:layout_below="@+id/rl_video_summary_content_wrapper"
            app:layout_constraintTop_toBottomOf="@+id/rl_video_summary_content_wrapper"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
