<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/cj_pay_bg_face_retain_or_fail_dialog"
    android:padding="@dimen/cj_pay_padding_20"
    android:layout_width="@dimen/cj_pay_height_280"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/cj_pay_face_dialog_process_title_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/cj_pay_color_black_161823"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_pay_face_dialog_process_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_pay_face_dialog_process_sub_title"
            android:paddingTop="@dimen/cj_pay_padding_8"
            android:paddingBottom="@dimen/cj_pay_padding_8"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_below="@+id/cj_pay_face_dialog_process_title"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/cj_pay_face_dialog_process_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_below="@+id/cj_pay_face_dialog_process_title_layout">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/cj_pay_color_black_161823"
            android:gravity="center"
            android:id="@+id/cj_pay_face_dialog_process_stop"
            android:background="@drawable/cj_pay_bg_face_guide_grey_button"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_custom_button_height_44"
            android:includeFontPadding="false"
            android:layout_weight="1"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/cj_pay_color_white"
            android:gravity="center"
            android:id="@+id/cj_pay_face_dialog_process_retry"
            android:background="@drawable/cj_pay_bg_face_guide_red_button"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_custom_button_height_44"
            android:layout_marginLeft="@dimen/cj_pay_padding_8"
            android:includeFontPadding="false"
            android:layout_weight="1"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/cj_pay_color_white"
            android:gravity="center"
            android:id="@+id/cj_pay_face_dialog_process_known"
            android:background="@drawable/cj_pay_bg_face_guide_red_button"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_custom_button_height_44"
            android:includeFontPadding="false"
            android:layout_weight="1"/>
    </LinearLayout>
</RelativeLayout>
