<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larksuite.component.ui.layout.LKUIRoundableLayout
        android:id="@+id/placeholder_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:rl_radius="@dimen/space_kit_len_4">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/placeholder_icon"
            android:layout_width="@dimen/space_kit_len_48"
            android:layout_height="@dimen/space_kit_len_48"/>
    </com.larksuite.component.ui.layout.LKUIRoundableLayout>
    <com.larksuite.component.ui.imageview.LKUIRoundedImageView2
        android:id="@+id/cover_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        app:radius="@dimen/space_kit_len_5"/>
    <com.larksuite.component.ui.imageview.LKUIRoundedImageView2
        android:id="@+id/cover_border"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:border_color="@color/line_border_card"
        app:border_width="@dimen/space_kit_len_1"
        app:radius="@dimen/space_kit_len_4"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/play_video_icon"
        android:visibility="gone"
        android:layout_width="@dimen/space_kit_len_40"
        android:layout_height="@dimen/space_kit_len_40"
        android:layout_centerInParent="true"
        app:srcCompat="@drawable/ud_icon_play_round_colorful"/>
    <com.larksuite.component.ui.layout.LKUIRoundableLayout
        android:id="@+id/upload_widget_container"
        android:background="@color/black_alpha_40"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:rl_radius="@dimen/space_kit_len_4">
        <RelativeLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <com.larksuite.component.universe_design.progress.UDProgress
                android:id="@+id/upload_progress_bar"
                android:layout_width="@dimen/space_kit_len_64"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0"
                android:layout_centerInParent="true"
                app:ud_progress_indicatorColor="@color/colorful_blue"
                app:ud_progress_indicatorCornerRadius="2dp"
                app:ud_progress_thickness="@dimen/space_kit_len_4"
                app:ud_progress_trackColor="@color/upload_progress_bar_track_color"
                app:ud_progress_type="linear"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="@color/static_white"
                android:id="@+id/upload_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:layout_below="@+id/upload_progress_bar"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|top"
            android:id="@+id/cancel_upload"
            android:background="@drawable/facade_circle"
            android:padding="3dp"
            android:layout_width="@dimen/dp_18"
            android:layout_height="@dimen/dp_18"
            android:layout_margin="5dp"
            android:backgroundTint="@color/static_black_60"
            app:srcCompat="@drawable/ud_icon_close_bold_outlined"
            app:tint="@color/static_white_90"/>
    </com.larksuite.component.ui.layout.LKUIRoundableLayout>
</RelativeLayout>
