<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@color/bg_body"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <RelativeLayout
        android:id="@+id/layout_font_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/larus_neutral_100"
            android:id="@+id/tv_font_name"
            android:padding="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dp_24"
            android:includeFontPadding="false"
            android:layout_centerVertical="true"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_font_name"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/font_picker_icon"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="20dp"
        android:src="@drawable/larus_doc_toobar_warn_disable_font"
        android:layout_centerVertical="true"
        android:paddingEnd="@dimen/dp_2_5"
        android:layout_marginStart="6dp"
        android:layout_toEndOf="@+id/layout_font_name"/>
    <ImageView
        android:id="@+id/iv_selected"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/larus_ic_check"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        app:tint="#007aff"/>
    <View
        android:id="@+id/divider"
        android:background="@drawable/larus_bg_divider"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
