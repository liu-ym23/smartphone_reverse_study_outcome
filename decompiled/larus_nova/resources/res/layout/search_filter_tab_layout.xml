<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/search_tab_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/search_wiki_root"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/primary_pri_500"
                android:gravity="center"
                android:id="@+id/search_tab_wiki_space"
                android:paddingTop="@dimen/dp_4"
                android:paddingBottom="@dimen/dp_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/Doc_Facade_Wiki"/>
            <View
                android:layout_gravity="bottom"
                android:id="@+id/search_tab_wiki_space_indicator"
                android:background="@color/primary_pri_500"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_kit_len_2"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/search_folder_root"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_caption"
                android:gravity="center"
                android:id="@+id/search_tab_folder"
                android:paddingTop="@dimen/dp_4"
                android:paddingBottom="@dimen/dp_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/Doc_List_DocumentTypeFolder"/>
            <View
                android:layout_gravity="bottom"
                android:id="@+id/search_tab_folder_indicator"
                android:background="@color/primary_pri_500"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_kit_len_2"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/search_doc_root"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_caption"
                android:gravity="center"
                android:id="@+id/search_tab_doc"
                android:paddingTop="@dimen/dp_4"
                android:paddingBottom="@dimen/dp_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/Doc_List_Space"/>
            <View
                android:layout_gravity="bottom"
                android:id="@+id/search_tab_doc_indicator"
                android:background="@color/primary_pri_500"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_kit_len_2"/>
        </FrameLayout>
    </LinearLayout>
    <View
        android:background="@color/line_divider_default"
        android:layout_width="match_parent"
        android:layout_height="2px"
        android:layout_marginTop="-2px"/>
    <com.suite.lark.platform.component.widget_biz_searchfilter.searchfilterv2.FilterViewV2
        android:id="@+id/search_filter_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
