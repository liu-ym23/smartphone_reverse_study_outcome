<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?attr/larus_dp_24"
    android:importantForAccessibility="yes"
    android:paddingStart="?attr/larus_dp_2">
    <View
        android:id="@+id/context_window_detail_dot"
        android:background="@drawable/larus_bg_context_window_dot"
        android:layout_width="?attr/larus_dp_8"
        android:layout_height="?attr/larus_dp_8"
        android:importantForAccessibility="no"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/larus_neutral_100"
        android:id="@+id/context_window_detail_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="?attr/larus_dp_8"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/larus_neutral_50"
        android:id="@+id/context_window_detail_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
