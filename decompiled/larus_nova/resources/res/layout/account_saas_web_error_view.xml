<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/account_saas_dp_17"
        android:textColor="@color/account_saas_neutral_100"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_accountsdk_auth_screen_error_desc"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/account_saas_dp_20">
        <TextView
            android:textSize="@dimen/account_saas_dp_16"
            android:textColor="@color/account_saas_neutral_100"
            android:gravity="center"
            android:id="@+id/account_saas_error_close"
            android:background="@drawable/account_saas_bg_base_3_overlay_r12_press"
            android:paddingTop="@dimen/account_saas_dp_11"
            android:paddingBottom="@dimen/account_saas_dp_11"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_accountsdk_auth_screen_error_btn_close"
            android:paddingStart="@dimen/account_saas_dp_36"
            android:paddingEnd="@dimen/account_saas_dp_36"/>
        <TextView
            android:textSize="@dimen/account_saas_dp_16"
            android:textColor="@color/account_saas_static_white"
            android:gravity="center"
            android:id="@+id/account_saas_error_refresh"
            android:background="@drawable/account_saas_bg_primary_50_r12_press"
            android:paddingTop="@dimen/account_saas_dp_11"
            android:paddingBottom="@dimen/account_saas_dp_11"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_accountsdk_auth_screen_error_btn_refresh"
            android:paddingStart="@dimen/account_saas_dp_36"
            android:paddingEnd="@dimen/account_saas_dp_36"
            android:layout_marginStart="@dimen/account_saas_dp_12"/>
    </LinearLayout>
</LinearLayout>
