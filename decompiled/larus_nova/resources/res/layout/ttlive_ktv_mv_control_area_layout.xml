<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/ktv_mv_separator"
        android:background="@drawable/ttlive_ktv_mv_separator_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="21dp"
        android:layout_marginRight="15dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#ccffffff"
        android:id="@+id/ktv_mv_welcome_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:text="@string/ttlive_ktv_mv_welcome_order_song"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.ktvimpl.ktvroom.view.KtvMvSingerInfoView
        android:id="@+id/ktv_mv_singer_info_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.ktvimpl.ktvroom.challenge.ui.KtvRoomChallengeProgressView
        android:id="@+id/ktv_challenge_progress_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginLeft="1dp"
        android:layout_marginRight="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/ktv_mv_singer_info_view"
        app:layout_constraintRight_toLeftOf="@+id/ktv_singing_control_area_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ktv_singing_control_area_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginRight="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/ktv_challenge_preview_switch"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ktv_anchor_control_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_constraintRight_toRightOf="parent">
            <ImageView
                android:id="@+id/ktv_mv_anchor_stop_btn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginRight="16dp"
                android:src="@drawable/ttlive_ktv_mv_stop_sing_btn"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/ktv_mv_anchor_next_btn"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/ktv_mv_anchor_next_btn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ttlive_ktv_mv_switch_next_btn"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ktv_singer_control_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_constraintRight_toRightOf="parent">
            <ImageView
                android:id="@+id/ktv_mv_singer_origin_btn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginRight="16dp"
                android:src="@drawable/ttlive_ktv_mv_origin_closed"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/ktv_mv_singer_stop_btn"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/ktv_mv_singer_stop_btn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginRight="16dp"
                android:src="@drawable/ttlive_ktv_mv_stop_sing_btn"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/ktv_mv_singer_next_btn"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/ktv_mv_singer_next_btn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginRight="16dp"
                android:src="@drawable/ttlive_ktv_mv_switch_next_btn"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/ktv_mv_singer_tone_btn"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/ktv_mv_singer_tone_btn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ttlive_ktv_mv_tone_btn"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/ktv_challenge_preview_switch"
        android:background="@drawable/ttlive_ktv_challenge_closed_btn"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginRight="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/ktv_mv_order_song_btn"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/ktv_challenge_dot_view"
        android:background="@drawable/ttlive_ic_setting_dot"
        android:visibility="gone"
        android:layout_width="6dp"
        android:layout_height="6dp"
        app:layout_constraintRight_toRightOf="@+id/ktv_challenge_preview_switch"
        app:layout_constraintTop_toTopOf="@+id/ktv_challenge_preview_switch"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#ffffffff"
        android:id="@+id/ktv_mv_order_song_btn"
        android:background="@drawable/ttlive_ktv_mv_order_bg"
        android:paddingLeft="14dp"
        android:paddingTop="6dp"
        android:paddingRight="14dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:text="@string/ttlive_interactive_audience_order_song"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#121212"
        android:gravity="center"
        android:id="@+id/ktv_mv_song_num"
        android:background="@drawable/ttlive_ktv_mv_song_count"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        app:layout_constraintEnd_toEndOf="@+id/ktv_mv_order_song_btn"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/ktv_dress_yellow_dot"
        android:background="@drawable/ttlive_ktv_dress_yellow_dot"
        android:visibility="gone"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginTop="5dp"
        app:layout_constraintEnd_toEndOf="@+id/ktv_mv_order_song_btn"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
