<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_lucky_box_sti_entry"
    android:layout_width="80dp"
    android:layout_height="96dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_user_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="21.33dp"
        android:layout_marginTop="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAsCircle="true"
        app:roundingBorderColor="#faedcd"
        app:roundingBorderWidth="1dp"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/coin_mark"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="2dp"
        app:layout_constraintBottom_toTopOf="@+id/guideline"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tv_coin_count"
        app:layout_constraintTop_toTopOf="@+id/guideline"/>
    <TextView
        android:textSize="16dp"
        android:textColor="#fcf6e3"
        android:gravity="center_horizontal"
        android:id="@+id/tv_coin_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        app:layout_constraintBottom_toTopOf="@+id/guideline"
        app:layout_constraintLeft_toRightOf="@+id/coin_mark"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guideline"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="23dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
