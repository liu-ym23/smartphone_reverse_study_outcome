<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="8dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12dp"
        android:textColor="#3c2617"
        android:gravity="center"
        android:id="@+id/live_vs_tv_paid_tag"
        android:background="@drawable/live_vs_lynx_center_bg_paid_card_label"
        android:paddingLeft="6dp"
        android:paddingTop="1.5dp"
        android:paddingRight="6dp"
        android:paddingBottom="1.5dp"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:text="@string/ttlive_lynx_center_paid_tag"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/live_vs_tv_paid_timer"
        android:background="@drawable/live_vs_lynx_center_bg_paid_card_timer"
        android:paddingLeft="6dp"
        android:paddingTop="1.5dp"
        android:paddingRight="6dp"
        android:paddingBottom="1.5dp"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        app:layout_constraintLeft_toRightOf="@+id/live_vs_tv_paid_tag"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
