<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/previewContainer"
        android:background="?attr/larus_base_1_overlay"
        android:paddingLeft="?attr/larus_dp_32"
        android:paddingRight="?attr/larus_dp_32"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/fileIcon"
            android:layout_width="?attr/larus_dp_64"
            android:layout_height="?attr/larus_dp_64"
            android:layout_marginBottom="?attr/larus_dp_16"
            app:layout_constraintBottom_toTopOf="@+id/fileName"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.48"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="?attr/larus_dp_20"
            android:textColor="?attr/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/fileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_24"
            app:layout_constraintBottom_toTopOf="@+id/preview"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fileIcon"/>
        <com.larus.common_ui.widget.roundlayout.RoundTextView
            android:textSize="?attr/larus_dp_16"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/preview"
            android:paddingLeft="?attr/larus_dp_16"
            android:paddingRight="?attr/larus_dp_16"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_44"
            android:minWidth="?attr/larus_dp_96"
            android:text="@string/larus_exportFile_btn_openWith"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fileName"
            app:rv_backgroundColor="?attr/larus_primary_50"
            app:rv_cornerRadius="?attr/larus_dp_12"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_bar"
        android:background="?attr/larus_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_close"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            android:layout_marginTop="?attr/larus_dp_8"
            android:layout_marginBottom="?attr/larus_dp_8"
            android:layout_marginStart="?attr/larus_dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="?attr/larus_ic_page_close"
            app:tint="?attr/larus_neutral_100"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_share"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            android:scaleType="centerInside"
            android:layout_marginEnd="?attr/larus_dp_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="?attr/larus_ic_page_top_share"/>
        <View
            android:id="@+id/divider"
            android:background="?attr/larus_bg_divider"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_1"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
