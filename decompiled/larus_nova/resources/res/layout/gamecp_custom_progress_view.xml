<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="horizontal"
    android:id="@+id/ll_custom_progress_view"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:layout_width="match_parent"
    android:layout_height="27dp">
    <com.bytedance.android.gamecp.business.view.CircleProgressBar
        android:id="@+id/cv_progress_bar"
        android:padding="2dp"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:defaultColor="#26161823"
        app:defaultHeight="2.5dp"
        app:radius="7dp"
        app:reachedColor="#fe2c55"
        app:reachedHeight="2.5dp"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/gamecp_game_BF161823"
        android:gravity="top"
        android:id="@+id/tv_progress_percent"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:text="下载中"/>
</LinearLayout>
