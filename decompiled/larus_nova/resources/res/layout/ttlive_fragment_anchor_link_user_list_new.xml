<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/outside"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/ttlive_label_close"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/container"
        android:background="@drawable/ttlive_bg_interact_dialog"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="488dp">
        <FrameLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="56dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/back"
                android:padding="8dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ttlive_ic_pk_back"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#161823"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/ttlive_multi_pk_title_recommend_anchor"/>
        </FrameLayout>
        <View
            android:background="#19161823"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
            android:layout_gravity="center_horizontal"
            android:id="@+id/preload_progress_icon_double_ball"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/ttlive_pk_userlist_refresh_progress_anim"
            android:indeterminateBehavior="repeat"/>
        <ProgressBar
            android:layout_gravity="center_horizontal"
            android:id="@+id/preload_progress_icon_normal"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="10dp"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/ttlive_pk_userlist_refresh_progress_anim"
            android:indeterminateBehavior="repeat"/>
        <com.bytedance.android.live.ui.PkInviteUserListRefreshLayout
            android:id="@+id/userlist_swipe_refresh_layout"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="10dp">
                <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
                    android:layout_gravity="center"
                    android:id="@+id/userlist_refresh_progress_double_ball"
                    android:visibility="gone"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="10dp"
                    android:indeterminate="true"
                    android:indeterminateDrawable="@drawable/ttlive_pk_userlist_refresh_progress_anim"
                    android:indeterminateBehavior="repeat"/>
                <ProgressBar
                    android:layout_gravity="center"
                    android:id="@+id/userlist_refresh_progress_normal"
                    android:visibility="gone"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminate="true"
                    android:indeterminateDrawable="@drawable/ttlive_pk_userlist_refresh_progress_anim"
                    android:indeterminateBehavior="repeat"/>
            </FrameLayout>
            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.google.android.material.appbar.AppBarLayout
                    android:id="@+id/app_bar_layout"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:elevation="0dp">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_scrollFlags="enterAlways|scroll">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/ll_search_and_record"
                            android:clickable="true"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <androidx.appcompat.widget.Toolbar
                                android:id="@+id/search"
                                android:background="@drawable/ttlive_bg_pk_rivals_search"
                                android:visibility="visible"
                                android:layout_width="match_parent"
                                android:layout_height="36dp"
                                android:layout_marginLeft="16dp"
                                android:layout_marginTop="8dp"
                                android:layout_marginRight="16dp"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="16dp"
                                app:contentInsetEnd="0dp"
                                app:contentInsetStart="0dp">
                                <LinearLayout
                                    android:orientation="horizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">
                                    <ImageView
                                        android:layout_gravity="center_vertical"
                                        android:id="@+id/iv_search"
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_marginLeft="4dp"
                                        android:src="@drawable/ttlive_ic_pk_search_list"
                                        android:layout_marginStart="4dp"/>
                                    <TextView
                                        android:textSize="13dp"
                                        android:textColor="#57161823"
                                        android:layout_gravity="center_vertical"
                                        android:id="@+id/tv_search"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/ttlive_interact_anchor_link_search_hint_default"
                                        android:singleLine="true"/>
                                </LinearLayout>
                            </androidx.appcompat.widget.Toolbar>
                        </LinearLayout>
                    </FrameLayout>
                    <com.bytedance.android.live.revlink.impl.multianchor.ui.MultiAnchorRandomView
                        android:id="@+id/anchor_link_random"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </com.google.android.material.appbar.AppBarLayout>
                <com.bytedance.android.live.revlink.impl.pk.ui.PkItemExposeRecyclerView
                    android:id="@+id/recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/tv_empty"
                    android:paddingBottom="20dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ttlive_live_interact_user_list_tip1"/>
                    <TextView
                        android:textSize="16dp"
                        android:id="@+id/user_list_empty_tips_line_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ttlive_live_interact_user_list_tip2"/>
                </LinearLayout>
            </androidx.coordinatorlayout.widget.CoordinatorLayout>
        </com.bytedance.android.live.ui.PkInviteUserListRefreshLayout>
    </LinearLayout>
</LinearLayout>
