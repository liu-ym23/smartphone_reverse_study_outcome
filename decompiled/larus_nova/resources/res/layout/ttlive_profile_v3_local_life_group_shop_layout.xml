<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@drawable/ttlive_bg_local_life_group_shop_component"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="20dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/right_bg_icon"
        android:visibility="gone"
        android:layout_width="25dp"
        android:layout_height="36dp"
        app:actualImageScaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_color_161823"
        android:id="@+id/shop_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="12dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/shop_icon"
        android:layout_width="67dp"
        android:layout_height="18dp"
        android:layout_marginLeft="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginStart="4dp"
        app:actualImageScaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/shop_name"
        app:layout_constraintStart_toEndOf="@+id/shop_name"
        app:layout_constraintTop_toTopOf="@+id/shop_name"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/shop_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="12dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shop_name">
        <TextView
            android:textSize="10dp"
            android:textColor="@color/ttlive_color_BF_161823"
            android:gravity="center"
            android:id="@+id/shop_goods_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/shop_divider"
            android:background="@color/ttlive_color_1F_161823"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="8dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/ttlive_color_BF_161823"
            android:id="@+id/shop_sale_count"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/shop_right_enter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_color_161823"
            android:layout_gravity="center_vertical"
            android:id="@+id/enter_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_profile_local_life_component_enter_text"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/ttlive_local_life_component_vector"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
