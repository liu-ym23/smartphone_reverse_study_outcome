<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:id="@+id/name_container"
        android:background="@drawable/ttlive_bg_mic_seat_game_mini_anchor"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.375"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/ttlive_guest_identification"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/ttlive_icon_video_silence"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.218"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/ttlive_guest_avatar"
            android:background="@drawable/ttlive_bg_default_anchor_avatar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginLeft="1dp"
            android:scaleType="centerInside"
            android:layout_marginStart="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toEndOf="@+id/ttlive_guest_identification"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.25"
            app:placeholderImage="@drawable/ttlive_img_avatar_empty"
            app:roundAsCircle="true"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/ttlive_text_white"
            android:gravity="center"
            android:id="@+id/ttlive_guest_ticket_num"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:lines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="1"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/ttlive_guest_avatar"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/space_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/name_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.0625"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="9sp"
        android:textColor="@color/ttlive_text_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_fold_status"
        android:background="@drawable/ttlive_bg_mic_seat_fold_button"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:maxLines="1"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        app:layout_constraintBottom_toTopOf="@+id/space_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.375"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="9sp"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/ttlive_empty_tips"
        android:background="@drawable/ttlive_bg_mic_seat_fold_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/ttlive_live_radio_interact_waiting"
        android:maxLines="1"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        app:layout_constraintBottom_toTopOf="@+id/space_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.375"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
