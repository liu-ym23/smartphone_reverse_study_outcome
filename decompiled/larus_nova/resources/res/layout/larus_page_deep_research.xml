<?xml version="1.0" encoding="utf-8"?>
<com.larus.bmhome.view.ChatConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/deep_research_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/deep_research_title_container"
        android:background="?attr/larus_white_black"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_44"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/deep_research_page_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="?attr/larus_dp_8"
            android:layout_alignParentStart="true"
            app:srcCompat="?attr/larus_ic_deep_research_text_close"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/deep_research_page_function_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="?attr/larus_dp_8">
            <ProgressBar
                android:id="@+id/deep_research_podcast_progress"
                android:padding="?attr/larus_dp_7"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_44"
                android:indeterminateTint="?attr/larus_neutral_100"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/deep_research_page_copy"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/deep_research_podcast"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/deep_research_page_copy"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="?attr/larus_icon_deep_research_podcast"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/deep_research_page_copy"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/deep_research_page_export"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="?attr/larus_ic_deep_research_text_copy"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/deep_research_page_export"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/deep_research_page_share"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="?attr/larus_ic_deep_research_text_export"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/deep_research_page_share"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="?attr/larus_ic_deep_research_text_share"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/research_list_parent_parent"
        android:background="?attr/larus_white_black"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_0"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/deep_research_title_container"
        app:layout_constraintVertical_weight="1">
        <ViewStub
            android:id="@+id/research_list_parent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
    </FrameLayout>
    <include
        android:id="@+id/deep_research_error"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/deep_research_title_container"
        layout="@layout/larus_page_deep_research_error"/>
    <include
        android:id="@+id/deep_research_loading"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/deep_research_title_container"
        layout="@layout/larus_page_deep_research_loading"/>
</com.larus.bmhome.view.ChatConstraintLayout>
