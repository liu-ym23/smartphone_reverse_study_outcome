<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contact_item_layout"
    android:background="@drawable/contact_item_bg_selector"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <com.larksuite.component.universe_design.checkbox.UDCheckBox
        android:id="@+id/select_box"
        android:padding="0dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="10dp"
        android:layout_alignParentStart="true"
        app:ud_checkbox_type="check_box"/>
    <com.larksuite.component.ui.imageview.LKUIRoundedImageView2
        android:id="@+id/contact_avatar"
        android:background="@drawable/icon_circle_bg"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="fitCenter"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        android:layout_toEndOf="@+id/select_box"
        app:oval="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_toEndOf="@+id/contact_avatar">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout_user_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp">
            <TextView
                android:textSize="17sp"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:id="@+id/contact_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_weight="1"/>
            <com.suite.lark.platform.component.widget_biz_userstatus.UserStatusLinearLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/contact_user_status"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_special_focus"
                android:visibility="gone"
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:layout_marginTop="3dp"
                android:layout_marginStart="@dimen/dp_4"
                app:srcCompat="@drawable/ud_icon_collect_filled"
                app:tint="@color/colorful_yellow"/>
        </LinearLayout>
        <com.suite.lark.platform.component.widget_biz_tenantname.TenantNameTextView
            android:id="@+id/contact_tenant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="22dp"
            app:textSize="14sp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/btn_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/function_danger_fill_default"
            android:gravity="center"
            android:id="@+id/delete_btn"
            android:background="@drawable/contact_item_delete_bg_selector"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:visibility="gone"
            android:layout_width="100dp"
            android:layout_height="32dp"
            android:text="@string/Lark_Legacy_Delete"
            android:layout_marginEnd="28dp"/>
    </LinearLayout>
</RelativeLayout>
