<?xml version="1.0" encoding="utf-8"?>
<com.larus.avlink.env.diary.TouchInterceptConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/diary_content_container"
    android:background="@drawable/bg_diary_card_container"
    android:paddingLeft="?attr/larus_dp_16"
    android:paddingTop="?attr/larus_dp_16"
    android:paddingRight="?attr/larus_dp_16"
    android:paddingBottom="?attr/larus_dp_16"
    android:clipChildren="true"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_500"
    android:layout_marginLeft="?attr/larus_dp_16"
    android:layout_marginRight="?attr/larus_dp_16"
    android:minHeight="?attr/larus_dp_400">
    <TextView
        android:textSize="?attr/larus_sp_40"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/diary_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:includeFontPadding="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_date_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/diary_day"
        app:layout_constraintStart_toEndOf="@+id/diary_day"
        app:layout_constraintTop_toTopOf="@+id/diary_day">
        <TextView
            android:textSize="?attr/larus_sp_13"
            android:textColor="@color/larus_neutral_85"
            android:id="@+id/diary_year_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="?attr/larus_sp_13"
            android:textColor="@color/larus_neutral_85"
            android:id="@+id/diary_weekday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_4"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/diary_status_icon"
            android:visibility="invisible"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="?attr/larus_sp_12"
            android:textColor="@color/larus_neutral_70"
            android:id="@+id/diary_status_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/diary_status_icon"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/diary_content_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="?attr/larus_dp_12"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/diary_day"
        app:layout_constraintVertical_bias="0">
        <TextView
            android:textSize="?attr/larus_sp_18"
            android:textStyle="bold"
            android:textColor="@color/larus_neutral_100"
            android:ellipsize="end"
            android:id="@+id/diary_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/diary_top_cover"
        android:background="@drawable/bg_diary_summary_bottom_cover"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_94"
        android:rotation="180"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/diary_content_area"/>
    <View
        android:id="@+id/diary_bottom_cover"
        android:background="@drawable/bg_diary_summary_bottom_cover"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_94"
        app:layout_constraintBottom_toBottomOf="@+id/diary_content_area"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</com.larus.avlink.env.diary.TouchInterceptConstraintLayout>
