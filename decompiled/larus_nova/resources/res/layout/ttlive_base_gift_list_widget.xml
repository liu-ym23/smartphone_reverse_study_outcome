<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ttlive_gift_list_widget_height">
    <com.bytedance.android.livesdk.gift.platform.business.dialog.v2.view.GiftListRecyclerView
        android:id="@+id/list"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.chatroom.ui.RtlViewPagerShower
        android:gravity="center_horizontal"
        android:id="@+id/pager_bottom_shower"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/list"/>
    <ImageView
        android:id="@+id/no_data_view"
        android:visibility="gone"
        android:layout_width="240dp"
        android:layout_height="160dp"
        app:layout_constraintBottom_toBottomOf="@+id/list"
        app:layout_constraintEnd_toEndOf="@+id/list"
        app:layout_constraintStart_toStartOf="@+id/list"
        app:layout_constraintTop_toTopOf="@+id/list"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/backpack_no_data_check_record"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:alpha="0.6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/no_data_view">
        <TextView
            android:textSize="14dp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/backpack_no_data_check_record_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_gift_backpack_empty_check_record_text"
            app:layout_constraintEnd_toStartOf="@+id/backpack_no_data_check_record_icon"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/backpack_no_data_check_record_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/backpack_no_data_check_record_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/backpack_no_data_check_record_text"
            app:layout_constraintTop_toTopOf="@+id/backpack_no_data_check_record_text"
            app:srcCompat="@drawable/ttlive_ui_gift_backpack_check_record_arrow"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
