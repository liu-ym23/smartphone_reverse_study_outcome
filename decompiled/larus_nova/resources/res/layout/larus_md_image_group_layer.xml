<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/md_image_group_layer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:id="@+id/mdCardView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardBackgroundColor="?attr/larus_neutral_transparent_1"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/md_image_group_main_layer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/image_group_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="@string/larus_accessibility_message_photo"
                app:roundedCornerRadius="8dp"/>
            <ImageView
                android:id="@+id/maskView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/larus_search_image_loading_wave"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_12"
                android:textColor="@color/larus_static_white"
                android:gravity="center"
                android:id="@+id/image_group_img_more_tag"
                android:background="@drawable/larus_md_image_group_join_vertical_more_tag_bg"
                android:paddingTop="?attr/larus_dp_4"
                android:paddingBottom="?attr/larus_dp_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="?attr/larus_dp_10"
                android:paddingStart="?attr/larus_dp_6"
                android:paddingEnd="?attr/larus_dp_6"
                android:layout_marginEnd="?attr/larus_dp_10"
                app:layout_constraintBottom_toBottomOf="@+id/image_group_img"
                app:layout_constraintEnd_toEndOf="@+id/image_group_img"/>
            <com.larus.bmhome.chat.markdown.imagegroup.view.MarkdownSourceImageView
                android:id="@+id/sourceIcon"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_16"
                android:layout_height="?attr/larus_dp_16"
                android:layout_marginTop="?attr/larus_dp_9"
                android:layout_marginEnd="?attr/larus_dp_9"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <RelativeLayout
            android:id="@+id/md_image_group_retry_layer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_30"
                android:src="?attr/md_img_error_icon"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="?attr/larus_neutral_50"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/mdImgCaption"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginTop="8dp"
        android:maxLines="1"/>
</LinearLayout>
