<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_emoji_section_layout"
    android:layout_width="56dp"
    android:layout_height="68dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center"
        android:id="@+id/iv_emoji_section_cover"
        android:layout_width="32dp"
        android:layout_height="32dp"/>
    <View
        android:layout_gravity="end|top"
        android:id="@+id/iv_dot"
        android:background="@drawable/ttlive_open_emoji_dot"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="9.5dp"/>
</FrameLayout>
