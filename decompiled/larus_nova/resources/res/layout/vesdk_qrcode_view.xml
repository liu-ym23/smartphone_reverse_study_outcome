<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintLeft_toLeftOf="parent"
    app:layout_constraintRight_toRightOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <com.ss.android.lark.qrcode.ui.ScannerView
        android:id="@+id/qrcodeview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="W, 9:16"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/space_top"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/qrcode_scan_layout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_weight="5"/>
    <com.ss.android.lark.qrcode.ui.QRCodeScanLayout
        android:id="@+id/qrcode_scan_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/space_bottom"
        app:layout_constraintDimensionRatio="H,3:5"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/space_top"
        app:layout_constraintVertical_weight="65"/>
    <Space
        android:id="@+id/space_bottom"
        android:layout_width="match_parent"
        android:layout_height="294dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/qrcode_scan_layout"
        app:layout_constraintVertical_weight="30"/>
    <ImageView
        android:id="@+id/flashlight"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="38dp"
        app:layout_constraintBottom_toTopOf="@+id/qr_code_album"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:srcCompat="@drawable/trun_off_flash_light"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ffffff"
        android:id="@+id/flashlight_tips"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/Lark_ScanCode_TapToTurnLightOn_Button"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/flashlight"/>
    <View
        android:id="@+id/qr_code_album"
        android:background="@drawable/qr_album_background"
        android:layout_width="58dp"
        android:layout_height="58dp"
        app:layout_constraintBottom_toBottomOf="@+id/qrcode_open_album"
        app:layout_constraintLeft_toLeftOf="@+id/qrcode_open_album"
        app:layout_constraintRight_toRightOf="@+id/qrcode_open_album"
        app:layout_constraintTop_toTopOf="@+id/qrcode_open_album"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/qrcode_open_album"
        android:padding="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/Lark_Legacy_Album"
        app:drawableTint="@color/static_white"
        app:drawableTopCompat="@drawable/ud_icon_nopicture_filled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/qrcode_open_my_qrcode_root"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="62dp">
        <FrameLayout
            android:background="@drawable/qr_album_background"
            android:layout_width="48dp"
            android:layout_height="48dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:srcCompat="@drawable/ud_icon_qr_outlined"
                app:tint="@color/static_white"/>
        </FrameLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/static_white"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:text="@string/Lark_Legacy_MyQrCode"
            android:maxLines="2"
            android:shadowColor="@color/black_alpha_30"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/qrcode_open_album_root"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/qrcode_open_my_qrcode_root"
        app:layout_constraintWidth_max="62dp">
        <FrameLayout
            android:background="@drawable/qr_album_background"
            android:layout_width="48dp"
            android:layout_height="48dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ud_icon_nopicture_filled"
                app:tint="@color/static_white"/>
        </FrameLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/static_white"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:text="@string/Lark_Legacy_Album"
            android:maxLines="2"
            android:shadowColor="@color/black_alpha_30"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
