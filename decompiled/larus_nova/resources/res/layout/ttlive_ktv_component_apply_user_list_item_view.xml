<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/avatarHSIv"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginLeft="14dp"
        android:layout_marginStart="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/genderIv"
        android:layout_width="12dp"
        android:layout_height="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatarHSIv"
        app:layout_constraintEnd_toEndOf="@+id/avatarHSIv"
        app:layout_constraintRight_toRightOf="@+id/avatarHSIv"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#ffffff"
        android:id="@+id/nickNameTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:maxWidth="130dp"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toTopOf="@+id/selectedMusicContain"
        app:layout_constraintLeft_toRightOf="@+id/avatarHSIv"
        app:layout_constraintStart_toEndOf="@+id/avatarHSIv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/high_score_layout"
        android:layout_width="30dp"
        android:layout_height="16dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/nickNameTv"
        app:layout_constraintStart_toEndOf="@+id/nickNameTv"
        app:layout_constraintTop_toTopOf="@+id/nickNameTv">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/iv_high_score_icon"
            android:layout_width="10dp"
            android:layout_height="10dp"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#ffffff"
            android:id="@+id/tv_high_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/selectedMusicContain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="5dp"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/avatarHSIv"
        app:layout_constraintStart_toEndOf="@+id/avatarHSIv"
        app:layout_constraintTop_toBottomOf="@+id/nickNameTv">
        <ImageView
            android:id="@+id/microphoneIcon"
            android:background="@drawable/ttlive_ktv_component_apply_list_item_mic_icn"
            android:layout_width="14dp"
            android:layout_height="14dp"/>
        <TextView
            android:textSize="11dp"
            android:textColor="#7fffffff"
            android:id="@+id/musicAndApplyTimeTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginStart="5dp"/>
    </LinearLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/ttlive_white"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/btnAccept"
        android:background="@drawable/ttlive_ktv_component_apply_user_list_accept_btn_bg"
        android:visibility="gone"
        android:layout_width="68dp"
        android:layout_height="28dp"
        android:layout_marginRight="16dp"
        android:text="@string/ttlive_live_interact_accept"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/removeBtn"
        android:background="@drawable/ttlive_ktv_component_apply_user_list_remove_ic"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginRight="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
