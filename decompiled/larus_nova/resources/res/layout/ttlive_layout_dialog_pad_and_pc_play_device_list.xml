<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.widget.roundcorner.RoundCornerConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/cast_screen_device_list_root"
    android:background="#161823"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="430dp"
    app:ttlive_leftTopRadius="8dp"
    app:ttlive_rightTopRadius="8dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/flTitle"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_cast_screen_select"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/ivRefresh"
            android:background="@drawable/ttlive_cast_screen_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/deviceContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/flTitle">
        <com.bytedance.android.livesdk.widget.MaxHeightRecyclerView
            android:id="@+id/rvList"
            android:fadingEdgeLength="13dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="23dp"
            android:maxHeight="228dp"
            android:minHeight="211dp"
            android:requiresFadingEdge="vertical"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:maxHeight="228dp"/>
        <FrameLayout
            android:orientation="vertical"
            android:id="@+id/flLoading"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="196dp"
            android:layout_marginBottom="10.5dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
                    android:id="@+id/loadingProgress"
                    android:layout_width="36dp"
                    android:layout_height="36dp"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="@color/ttlive_cast_screen_white_90"
                    android:id="@+id/tvSearching"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_cast_screen_loading"/>
            </LinearLayout>
            <View
                android:layout_gravity="bottom"
                android:id="@+id/vLoadingDivider"
                android:background="@color/ttlive_std_line_white_3"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"/>
        </FrameLayout>
        <FrameLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/flDeviceNotFound"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="196dp"
            android:layout_marginBottom="10.5dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/llNotfoundContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.3">
                <ImageView
                    android:id="@+id/ivDeviceNotFound"
                    android:background="@drawable/ttlive_cast_screen_device_no_found"
                    android:layout_width="38dp"
                    android:layout_height="38dp"/>
                <TextView
                    android:textSize="17dp"
                    android:textColor="@color/ttlive_cast_screen_white_90"
                    android:gravity="center"
                    android:id="@+id/tvDeviceNotFound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/ttlive_cast_screen_device_no_found"
                    android:layout_below="@+id/icon_device_no_found"/>
            </LinearLayout>
            <View
                android:layout_gravity="bottom"
                android:id="@+id/vEmptyDivider"
                android:background="@color/ttlive_std_line_white_3"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"/>
        </FrameLayout>
        <FrameLayout
            android:orientation="vertical"
            android:id="@+id/flScanQrCode"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="192dp"
            android:layout_marginBottom="10.5dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/ttlive_cast_screen_white_75"
                    android:gravity="center"
                    android:id="@+id/tvQrCodeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_cast_screen_scan_qr_code"/>
                <FrameLayout
                    android:layout_gravity="center_horizontal"
                    android:background="@color/white"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="20dp">
                    <com.bytedance.android.live.core.widget.HSImageView
                        android:layout_gravity="center"
                        android:id="@+id/ivQrCode"
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        app:actualImageScaleType="fitXY"/>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/flGuideContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/flTitle"/>
</com.bytedance.android.livesdk.widget.roundcorner.RoundCornerConstraintLayout>
