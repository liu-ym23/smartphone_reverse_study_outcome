<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/bg_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.ss.android.lark.ui.CommonTitleBar
            android:id="@+id/repeat_title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ListView
            android:id="@+id/lv_repeat_times"
            android:paddingLeft="@dimen/dp_15"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_14"
            android:listSelector="@color/transparent"
            android:divider="@null"/>
        <View
            android:background="@color/line_divider_default"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:layout_marginStart="16dp"/>
        <RelativeLayout
            android:id="@+id/ll_self_define_repeat"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_48">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/text_title"
                android:id="@+id/self_define_repeat_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Calendar_Edit_CustomRepeat"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/dp_16"/>
            <ImageView
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:src="@drawable/ud_icon_right_outlined"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/dp_16"
                app:tint="@color/icon_n3"/>
        </RelativeLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/repeat_fragment_container"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
