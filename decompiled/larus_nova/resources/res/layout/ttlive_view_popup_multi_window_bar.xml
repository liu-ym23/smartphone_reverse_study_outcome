<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/layout_interact_tip"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="left"
        android:id="@+id/iv_interact_tip_arrow"
        android:background="@drawable/ttlive_bg_live_pk_tip_arrow_up"
        android:layout_width="12dp"
        android:layout_height="6dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/ttlive_bg_live_multi_window_bar_tips"
        android:paddingLeft="9dp"
        android:paddingRight="7dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_pk_tips_text_color"
            android:gravity="center"
            android:id="@+id/tv_interact_tip"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/ttlive_live_interact_pk_clean_tip"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/ic_click_guide"
            android:visibility="gone"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="5dp"
            android:src="@drawable/ttlive_pk_bubble_click_icon"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="5dp"/>
    </LinearLayout>
</LinearLayout>
