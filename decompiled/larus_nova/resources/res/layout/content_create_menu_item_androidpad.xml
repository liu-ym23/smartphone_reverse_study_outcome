<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/border_rounded"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginLeft="12dp"
    app:border_width="1dp"
    app:radius="8dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/content_item_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/content_item_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:id="@+id/content_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/content_item_guideline"
        app:layout_constraintStart_toEndOf="@+id/content_item_icon"/>
    <TextView
        android:textSize="12sp"
        android:ellipsize="end"
        android:id="@+id/content_item_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:maxLines="1"
        app:layout_constraintStart_toEndOf="@+id/content_item_icon"
        app:layout_constraintTop_toBottomOf="@+id/content_item_guideline"/>
</androidx.constraintlayout.widget.ConstraintLayout>
