<?xml version="1.0" encoding="utf-8"?>
<com.larus.common_ui.venus.ShapeConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:larus_sc_cornerPosition="topRight|topLeft"
    app:larus_sc_cornerRadius="24dp"
    app:larus_sc_fillColor="@color/white"
    app:layout_constrainedHeight="true">
    <TextView
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/feedback_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="58dp"
        android:text="@string/larus_tutor_feedback_title_cn"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toTopOf="@+id/feedback_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/feedback_close_iv"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/guix_icon_feedback_close"
        android:scaleType="centerInside"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/feedback_title_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/feedback_title_tv"/>
    <ScrollView
        android:id="@+id/feedback_content"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/feedback_submit_btn"
        app:layout_constraintTop_toBottomOf="@+id/feedback_title_tv">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.larus.livetutor.impl.view.TutorStarListWithTitleView
                android:id="@+id/feedback_star_list"
                android:paddingLeft="47dp"
                android:paddingRight="47dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.google.android.flexbox.FlexboxLayout
                android:id="@+id/feedback_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:alignItems="flex_start"
                app:flexDirection="row"
                app:flexWrap="wrap"
                app:justifyContent="space_between"/>
            <com.larus.livetutor.impl.view.SafetyEditText
                android:textSize="15dp"
                android:textColor="@color/black"
                android:textColorHint="#7a1a2429"
                android:gravity="top"
                android:id="@+id/feedback_edit"
                android:background="@drawable/common_feed_back_edit_tv_bg"
                android:paddingLeft="16dp"
                android:paddingTop="12dp"
                android:paddingRight="16dp"
                android:paddingBottom="12dp"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="@string/larus_tutor_feedback_enter_cn"
                android:imeOptions="flagNoExtractUi|actionSend"
                android:textIsSelectable="false"
                android:textCursorDrawable="@drawable/common_feed_back_editview_cursor_bg"/>
        </LinearLayout>
    </ScrollView>
    <com.larus.common_ui.venus.ShapeButton
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/feedback_submit_btn"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="32dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="20dp"
        android:text="@string/larus_tutor_feedback_submit_cn"
        app:larus_sb_cornerRadius="16dp"
        app:larus_sb_fillColor="@color/primary_50"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/feedback_content"/>
</com.larus.common_ui.venus.ShapeConstraintLayout>
