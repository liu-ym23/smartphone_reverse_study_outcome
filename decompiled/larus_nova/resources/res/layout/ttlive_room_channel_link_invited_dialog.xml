<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:background="@drawable/ttlive_bg_channel_link_invited_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textColor="#161823"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/ttlive_room_channel_link_invited_dialog_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="#20161823"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="44dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/avatar_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="78dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/inviter_user_avatar_iv"
            android:layout_width="72dp"
            android:layout_height="72dp"
            app:placeholderImage="@drawable/ttlive_img_avatar_empty"/>
        <View
            android:layout_gravity="center"
            android:background="@drawable/ttlive_bg_video_talk_be_invited1"
            android:layout_width="72dp"
            android:layout_height="72dp"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/anim1"
            android:background="@drawable/ttlive_bg_video_talk_be_invited1"
            android:layout_width="100dp"
            android:layout_height="100dp"/>
    </FrameLayout>
    <TextView
        android:textSize="13dp"
        android:textColor="#161823"
        android:id="@+id/inviter_user_name_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:text="不锈钢男孩"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avatar_container"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/reject_btn"
        android:background="@drawable/ttlive_bg_channel_link_invited_button_gray"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:text="@string/ttlive_room_channel_link_invited_dialog_reject"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/accept_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/inviter_user_name_tv"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/accept_btn"
        android:background="@drawable/ttlive_bg_channel_link_invited_button_red"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:text="@string/ttlive_room_channel_link_invited_dialog_accept"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/reject_btn"
        app:layout_constraintTop_toBottomOf="@+id/inviter_user_name_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
