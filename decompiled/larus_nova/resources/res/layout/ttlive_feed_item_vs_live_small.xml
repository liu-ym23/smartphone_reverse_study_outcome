<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vs_drawer_layout"
    android:paddingLeft="4dp"
    android:paddingRight="4dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.bytedance.android.livesdk.feed.drawerfeed.widget.FixedRatioRelativeLayout
        android:id="@+id/vs_drawer_small_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.android.livesdk.chatroom.ui.LiveRoundImageView
            android:id="@+id/cover_vertical_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:ttlive_radius_top_left="5dp"
            app:ttlive_radius_top_right="5dp"/>
    </com.bytedance.android.livesdk.feed.drawerfeed.widget.FixedRatioRelativeLayout>
    <TextView
        android:textSize="10dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/tv_vs_drawer_item_season_type"
        android:background="@drawable/ttlive_feed_drawer_vs_season_type"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="4dp"
        android:layout_alignLeft="@+id/vs_drawer_small_container"
        android:layout_alignTop="@+id/vs_drawer_small_container"
        android:layout_marginStart="4dp"
        android:layout_alignStart="@+id/vs_drawer_small_container"/>
    <RelativeLayout
        android:id="@+id/vs_drawer_container_content"
        android:background="@drawable/ttlive_feed_introduction_bg"
        android:layout_width="match_parent"
        android:layout_height="87dp"
        android:layout_marginBottom="8dp"
        android:layout_below="@+id/vs_drawer_small_container">
        <TextView
            android:textSize="13dp"
            android:textColor="#e6ffffff"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/vs_drawer_item_name"
            android:layout_width="wrap_content"
            android:layout_height="21dp"
            android:layout_marginTop="12dp"
            android:maxLines="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#80ffffff"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/vs_drawer_item_introduction"
            android:layout_width="wrap_content"
            android:layout_height="39dp"
            android:layout_marginTop="33dp"
            android:maxLines="2"
            android:layout_marginStart="12dp"/>
    </RelativeLayout>
</RelativeLayout>
