<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@color/ttlive_white"
    android:layout_width="match_parent"
    android:layout_height="62dp">
    <FrameLayout
        android:id="@+id/head_living_status_view"
        android:layout_width="39dp"
        android:layout_height="39dp"
        android:layout_marginLeft="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.livesdk.widget.VHeadView
            android:layout_gravity="center"
            android:id="@+id/head_avatar"
            android:background="@drawable/ttlive_bg_circle_head"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:placeholderImage="@drawable/ttlive_ic_default_head_small"
            app:retryImageScaleType="fitXY"
            app:roundAsCircle="true"/>
        <ImageView
            android:id="@+id/circle_living_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ttlive_ic_pk_rivals_search_living"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="bottom|right"
            android:id="@+id/living_view"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="14dp"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/item_pk_record_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/head_living_status_view"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="200dp"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14dp"
                    android:textColor="#161823"
                    android:ellipsize="end"
                    android:id="@+id/tv_nick_name"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:maxLines="1"
                    android:maxEms="4"
                    android:singleLine="true"/>
                <com.bytedance.android.livesdk.widget.VHeadView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/gender_icon"
                    android:background="@drawable/ttlive_bg_circle_head"
                    android:visibility="visible"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginLeft="2dp"
                    app:retryImageScaleType="fitXY"
                    app:roundAsCircle="true"/>
                <com.bytedance.android.live.revlink.impl.pk.ui.PkTagsContainerView
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/tags_container"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"/>
            </LinearLayout>
            <TextView
                android:textSize="11dp"
                android:textColor="#161823"
                android:id="@+id/reserve_text"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginTop="6dp"
                android:maxLines="1"
                android:singleLine="true"
                android:lineSpacingExtra="5dp"
                android:alpha="0.34"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="13dp"
        android:gravity="center"
        android:id="@+id/invite_btn"
        android:background="@drawable/ttlive_bg_pk_reserve_invite_btn"
        android:layout_width="64dp"
        android:layout_height="28dp"
        android:layout_marginRight="10dp"
        android:text="发起PK"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/reply_btn"
        android:layout_width="42dp"
        android:layout_height="28dp"
        android:layout_marginRight="4dp"
        android:text="回复"
        app:layout_constraintBottom_toBottomOf="@+id/invite_btn"
        app:layout_constraintRight_toLeftOf="@+id/invite_btn"
        app:layout_constraintTop_toTopOf="@+id/invite_btn"/>
</androidx.constraintlayout.widget.ConstraintLayout>
