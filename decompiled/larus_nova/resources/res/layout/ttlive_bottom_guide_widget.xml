<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.chatroom.ui.AlwaysConsumeEventFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/ttlive_guide_content"
        android:background="@drawable/ttlive_guide_background"
        android:layout_width="match_parent"
        android:layout_height="92dp">
        <TextView
            android:textSize="15dp"
            android:textColor="#161823"
            android:id="@+id/ttlive_guide_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="19dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#80161823"
            android:id="@+id/ttlive_guide_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            app:layout_constraintLeft_toLeftOf="@+id/ttlive_guide_title"
            app:layout_constraintTop_toBottomOf="@+id/ttlive_guide_title"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#ffffff"
            android:id="@+id/ttlive_guide_btn"
            android:background="@drawable/ttlive_bottom_guide_btn_bg"
            android:paddingLeft="14dp"
            android:paddingTop="5dp"
            android:paddingRight="14dp"
            android:paddingBottom="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginRight="16dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.bytedance.android.livesdk.chatroom.ui.AlwaysConsumeEventFrameLayout>
