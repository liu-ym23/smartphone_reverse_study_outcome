<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.chatroom.viewmodule.record.RecordDragContainer xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ttlive_vs_quick_record_drag_view"
    android:background="@drawable/ttlive_quick_record_handle_ball_bg"
    android:padding="4dp"
    android:layout_width="88dp"
    android:layout_height="38dp">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginRight="4dp">
            <ImageView
                android:padding="1dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ttlive_bg_quick_record_process"/>
            <com.bytedance.android.uicomponent.loading.CircularProgressView
                android:id="@+id/ttlive_quick_recording_process"
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:cpv_animAutostart="true"
                app:cpv_color="#f1004b"
                app:cpv_maxProgress="1"
                app:cpv_startAngle="-90"
                app:cpv_thickness="2dp"/>
            <View
                android:layout_gravity="center"
                android:background="@drawable/ttlive_ic_quick_recording_rect"
                android:layout_width="10dp"
                android:layout_height="10dp"/>
        </FrameLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/ttlive_quick_recording_time"
            android:layout_width="38dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="4dp"
            android:text="@string/ttlive_quick_recording_process"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="4dp"/>
    </LinearLayout>
</com.bytedance.android.livesdk.chatroom.viewmodule.record.RecordDragContainer>
