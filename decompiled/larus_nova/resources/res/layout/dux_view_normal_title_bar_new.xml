<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dux_title_bar_height">
    <com.bytedance.dux.text.DuxTextView
        android:textSize="15sp"
        android:textColor="@color/TextPrimary"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/text_left"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginLeft="6dp"
        android:maxWidth="100dp"
        android:maxLines="1"
        android:layout_marginStart="6dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/back_btn"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginLeft="6dp"
        android:src="@drawable/dux_ic_titlebar_back"
        android:contentDescription="@string/dux_iv_back_desc"
        android:layout_marginStart="6dp"/>
    <com.bytedance.dux.text.DuxTextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:id="@+id/title"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="264dp"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/right_btn"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginRight="6dp"
        android:contentDescription="@string/dux_more_desc"
        android:layout_marginEnd="6dp"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
</merge>
