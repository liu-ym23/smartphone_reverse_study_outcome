<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.25">
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_white_90"
            android:layout_gravity="center_horizontal"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/ttlive_live_record_started_title"
            android:maxLines="1"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_white_70"
            android:layout_gravity="center_horizontal"
            android:id="@+id/message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ttlive_live_record_started_msg"
            android:maxLines="1"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/ttlive_white_90"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/open_game_button"
            android:background="@drawable/ttlive_bg_open_game_button"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="30dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_white_50"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/warning_message"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:drawableLeft="@drawable/ttlive_ic_white_warning"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/ttlive_ic_white_warning"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
