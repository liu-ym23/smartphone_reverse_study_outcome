<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/left_space"
        android:visibility="visible"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"/>
    <View
        android:id="@+id/right_space"
        android:visibility="visible"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"/>
    <View
        android:id="@+id/top_space"
        android:background="@color/aos_const_bg_container4"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignParentTop="true"/>
    <com.bytedance.awemeopen.infra.base.image.AoImageView
        android:layout_gravity="center"
        android:id="@+id/preivew_image"
        android:background="@color/aos_const_bg_inverse"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/gallery_bottom"
        android:layout_below="@+id/top_space"/>
    <View
        android:layout_gravity="center"
        android:id="@+id/preivew_mask"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/gallery_bottom"
        android:layout_below="@+id/top_space"/>
    <View
        android:id="@+id/gallery_bottom"
        android:background="@drawable/aos_familiar_gallery_bg_bottom"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_alignParentBottom="true"/>
    <com.bytedance.awemeopen.apps.framework.feed.pages.recommend.photo.ui.GalleryRecyclerView
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/gallery_recycle_view"
        android:focusable="true"
        android:clickable="true"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginBottom="66dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="58dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
            android:textSize="14sp"
            android:textColor="@color/aos_const_text_inverse"
            android:id="@+id/number_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:src="@drawable/aos_familiar_gallery_ic_count_slash"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>
        <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
            android:textSize="14sp"
            android:textColor="@color/aos_const_text_inverse5"
            android:id="@+id/count_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</RelativeLayout>
