<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ttlive_team_fight_progress_layout_height">
    <com.bytedance.android.live.liveinteract.revenue.fight.view.TeamFightProgressBar
        android:layout_gravity="center_vertical"
        android:id="@+id/pk_progressbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ttlive_team_fight_progress_bar_height"/>
    <com.bytedance.android.live.liveinteract.revenue.fight.view.CompactTailView
        android:id="@+id/wave_tail"
        android:visibility="gone"
        android:layout_width="100dp"
        android:layout_height="@dimen/ttlive_team_fight_progress_bar_height"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/pk_progressbar_anim"
        android:visibility="gone"
        android:layout_width="@dimen/ttlive_team_fight_progress_anim_width"
        android:layout_height="@dimen/ttlive_team_fight_progress_bar_height"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center"
        android:id="@+id/middle_anim"
        android:visibility="visible"
        android:layout_width="20dp"
        android:layout_height="@dimen/ttlive_team_fight_progress_layout_height"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="start|center_vertical"
        android:id="@+id/left_score_container"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ttlive_team_fight_progress_bar_height">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ttlive_team_pk_bar_left_barrier"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.android.livesdk.chatroom.view.NoPaddingTextView
                android:textSize="14sp"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_score_relative"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0dp"/>
            <com.bytedance.android.livesdk.chatroom.view.NoPaddingTextView
                android:textSize="14sp"
                android:textColor="#de000000"
                android:gravity="center"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/left_text"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/ttlive_team_fight_progress_bar_score_text_margin"
                android:text="@string/ttlive_score_zero"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0dp"
                android:layout_marginStart="@dimen/ttlive_team_fight_progress_bar_score_text_margin"/>
            <com.bytedance.android.livesdk.chatroom.view.NoPaddingTextView
                android:textSize="12sp"
                android:textColor="#ffeb98"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/left_delta_score"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0dp"/>
        </LinearLayout>
        <TextView
            android:textSize="9dp"
            android:textColor="#520137"
            android:gravity="start|center_vertical"
            android:id="@+id/ttlive_team_pk_bar_left_coefficient"
            android:background="@drawable/ttlive_teamfight_pk_bar_coefficient_left"
            android:paddingLeft="5dp"
            android:paddingRight="1dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="12dp"
            android:layout_marginLeft="2dp"
            android:paddingStart="5dp"
            android:paddingEnd="1dp"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/ttlive_team_pk_bar_left_barrier"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/right_score_container"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ttlive_team_fight_progress_bar_height">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ttlive_team_pk_bar_right_barrier"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.android.livesdk.chatroom.view.NoPaddingTextView
                android:textSize="12sp"
                android:textColor="#ffeb98"
                android:layout_gravity="center_vertical"
                android:id="@+id/right_delta_score"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="4dp"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0dp"/>
            <com.bytedance.android.livesdk.chatroom.view.NoPaddingTextView
                android:textSize="14sp"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_score_relative_right"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0dp"/>
            <com.bytedance.android.livesdk.chatroom.view.NoPaddingTextView
                android:textSize="14sp"
                android:textColor="#de000000"
                android:gravity="center"
                android:layout_gravity="end|center_vertical"
                android:id="@+id/right_text"
                android:padding="0dp"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/ttlive_team_fight_progress_bar_score_text_margin"
                android:text="@string/ttlive_score_zero"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0dp"
                android:layout_marginEnd="@dimen/ttlive_team_fight_progress_bar_score_text_margin"/>
        </LinearLayout>
        <TextView
            android:textSize="9dp"
            android:textColor="#520137"
            android:gravity="end|center_vertical"
            android:id="@+id/ttlive_team_pk_bar_right_coefficient"
            android:background="@drawable/ttlive_teamfight_pk_bar_coefficient_right"
            android:paddingLeft="1dp"
            android:paddingRight="5dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="12dp"
            android:layout_marginRight="2dp"
            android:paddingStart="1dp"
            android:paddingEnd="5dp"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/ttlive_team_pk_bar_right_barrier"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/left_gift_icon"
        android:visibility="gone"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginLeft="4dp"
        android:layout_marginStart="4dp"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/left_emoji_anim"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="@dimen/ttlive_team_fight_progress_layout_height"
        android:layout_marginLeft="8dp"
        android:layout_marginStart="8dp"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/right_gift_icon"
        android:visibility="gone"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginRight="4dp"
        android:layout_marginEnd="4dp"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/right_emoji_anim"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="@dimen/ttlive_team_fight_progress_layout_height"
        android:layout_marginRight="8dp"
        android:layout_marginEnd="8dp"/>
</FrameLayout>
