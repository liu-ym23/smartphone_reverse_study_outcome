<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:paddingLeft="6dp"
    android:paddingRight="6dp"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ec_shop_inner_flow_comment_banner_height">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/ec_shop_comment_item_avatar"
        android:layout_width="18dp"
        android:layout_height="18dp"
        app:placeholderImage="@color/shopping_color_66161823"
        app:roundAsCircle="true"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/shopping_color_99161823"
        android:ellipsize="end"
        android:id="@+id/ec_shop_comment_item_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="4dp"/>
</LinearLayout>
