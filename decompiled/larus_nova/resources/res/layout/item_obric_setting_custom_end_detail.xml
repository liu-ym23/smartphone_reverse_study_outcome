<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_basic_text_3"
        android:id="@+id/custom_end_detail_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Body_2_Regular"/>
    <com.obric.oui.badge.OBadgeView
        android:id="@+id/custom_end_red_point"
        android:visibility="gone"
        android:layout_width="@dimen/dp_8"
        android:layout_height="@dimen/dp_8"
        android:layout_marginStart="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="@+id/custom_end_detail_text"
        app:layout_constraintStart_toEndOf="@+id/custom_end_detail_text"
        app:layout_constraintTop_toTopOf="@+id/custom_end_detail_text"
        style="@style/OBadgeView.S1.Default.Red"/>
</androidx.constraintlayout.widget.ConstraintLayout>
