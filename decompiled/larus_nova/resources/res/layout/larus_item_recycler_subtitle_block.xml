<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_root"
    android:paddingLeft="?attr/larus_dp_36"
    android:paddingTop="?attr/larus_dp_12"
    android:paddingRight="?attr/larus_dp_36"
    android:paddingBottom="?attr/larus_dp_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="?attr/larus_dp_2">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_15"
        android:textColor="@color/color_4079FF"
        android:layout_gravity="end|top"
        android:id="@+id/tv_block_flag"
        android:background="?attr/larus_realtime_call_bottom_bg_start"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="block"/>
</FrameLayout>
