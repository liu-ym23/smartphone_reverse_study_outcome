<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/cj_pay_view_network_error_root"
    android:background="?attr/cj_pay_page_bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/iv_error_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="84dp"
        android:src="@drawable/cj_pay_icon_network_error"/>
    <TextView
        android:textSize="18dp"
        android:textColor="?attr/cj_pay_page_text_color"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_error_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"/>
    <TextView
        android:textSize="15dp"
        android:textColor="?attr/cj_pay_page_text_sub_color"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_error_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/cj_pay_network_error"/>
    <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
        android:textSize="@dimen/cj_pay_font_size_14"
        android:textColor="@color/cj_pay_color_white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/cj_pay_network_error_refresh_button"
        android:background="@drawable/cj_pay_bg_red_btn_radis_4"
        android:layout_width="159dp"
        android:layout_height="36dp"
        android:layout_marginTop="23dp"
        android:text="@string/cj_pay_refresh"
        android:includeFontPadding="false"/>
</LinearLayout>
