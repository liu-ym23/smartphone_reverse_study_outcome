<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/input_editor_assembler"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/input_top_expand_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/input_top_middle_container"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/float_expand_bg_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.larksuite.component.ui.layout.LKUIRoundableLayout
            android:orientation="horizontal"
            android:id="@+id/input_top_middle_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/input_top_container"
            app:rl_radius_left_top="28dp"
            app:rl_radius_right_top="28dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/input_top_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/input_container"/>
        <FrameLayout
            android:id="@+id/input_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:layout_constraintBottom_toTopOf="@+id/input_bottom_container"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/input_bottom_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/input_container"/>
    </LinearLayout>
</LinearLayout>
