<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_rounded_label_title_bg"
    android:padding="1dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:gravity="center"
        android:id="@+id/personal_pk"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text="@string/ttlive_class_personal_pk"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/team_pk"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/RounedLabelTitleItem"/>
    <TextView
        android:gravity="center"
        android:id="@+id/team_pk"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text="@string/ttlive_class_team_pk"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/personal_pk"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/RounedLabelTitleItem"/>
</androidx.constraintlayout.widget.ConstraintLayout>
