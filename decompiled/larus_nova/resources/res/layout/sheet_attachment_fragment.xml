<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/attachment_root"
    android:background="@color/lkui_transparent"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.sheet.common.SheetDragView
        android:layout_gravity="bottom"
        android:id="@+id/attachment_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:panel_drag_handler_type="downArrow"
        app:panel_max_height_percent="0.4"
        app:panel_show_drag_handler="true"
        app:panel_show_titlebar="false">
        <androidx.recyclerview.widget.RecyclerView
            android:scrollbarSize="@dimen/space_kit_len_4"
            android:scrollbarThumbVertical="@drawable/dropdown_thumb_scroll_bar"
            android:id="@+id/attachment_list"
            android:paddingBottom="50dp"
            android:scrollbars="vertical"
            android:clipToPadding="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.bytedance.ee.bear.sheet.common.SheetDragView>
    <com.bytedance.ee.bear.fabview.FabView
        android:id="@+id/sheet_operation_fab"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_alignParentEnd="true"
        app:fabColor="@color/primary_fill_default"
        app:fabImage="@drawable/ud_icon_style_outlined"
        app:fabImageTint="@color/static_white"
        app:fabType="image"
        app:layout_constraintBottom_toTopOf="@+id/attachment_panel"
        app:layout_constraintRight_toRightOf="parent"/>
    <com.bytedance.ee.bear.fabview.FabView
        android:id="@+id/sheet_input_fab"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_alignParentEnd="true"
        app:fabColor="@color/bg_float"
        app:fabImage="@drawable/ud_icon_keyboard_outlined"
        app:fabImageTint="@color/primary_fill_default"
        app:fabType="image"
        app:layout_constraintBottom_toTopOf="@+id/attachment_panel"
        app:layout_constraintRight_toLeftOf="@+id/sheet_operation_fab"/>
</androidx.constraintlayout.widget.ConstraintLayout>
