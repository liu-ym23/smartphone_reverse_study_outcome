<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/comment_input_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_weight="1">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/iv_danmaku_switch"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginLeft="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/setting_container"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginLeft="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/iv_danmaku_switch"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_danmaku_setting"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ttlive_ic_landscape_danmaku_setting"/>
            <com.bytedance.android.livesdk.chatroom.ui.RedDotView
                android:layout_gravity="top|right"
                android:id="@+id/red_dot_danmu_setting"
                android:background="@drawable/ttlive_ic_red_point_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/edit_btn_audience_container"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginLeft="14dp"
            android:minWidth="180dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/setting_container"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.android.live.core.widget.LiveTextView
                android:textSize="11dp"
                android:textColor="#e6ffffff"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/edit_btn_audience"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="12dp"
                android:text="@string/ttlive_comment_input_widget_hint"
                android:maxLines="1"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="12dp"/>
            <LinearLayout
                android:id="@+id/voice_emoji_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true">
                <com.bytedance.android.live.core.widget.HSImageView
                    android:id="@+id/emoji_entry"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/ttlive_comment_emoji_entry"
                    app:actualImageResource="@drawable/ttlive_comment_emoji_entry"/>
            </LinearLayout>
        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:layout_gravity="start|center_vertical"
        android:id="@+id/edit_btn_anchor"
        android:background="@drawable/ttlive_bg_edit_circle_selector"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"/>
    <View
        android:layout_gravity="start|center_vertical"
        android:id="@+id/ttlive_small_edit_btn"
        android:background="@drawable/ttlive_selector_action_btn_chat"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"/>
</FrameLayout>
