<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/file_apply_permission_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/no_permission_container"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/office_container"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/skeleton_loading_container"
        android:background="@color/larus_base_1"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.larus.bmhome.chat.layout.widget.ShimmerLoadingVIew
            android:layout_width="?attr/larus_dp_140"
            android:layout_height="?attr/larus_dp_32"
            android:layout_marginTop="?attr/larus_dp_18"
            android:layout_marginStart="?attr/larus_dp_18"
            android:layout_marginEnd="?attr/larus_dp_18"/>
        <com.larus.bmhome.chat.layout.widget.ShimmerLoadingVIew
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_20"
            android:layout_marginTop="?attr/larus_dp_20"
            android:layout_marginStart="?attr/larus_dp_18"
            android:layout_marginEnd="?attr/larus_dp_18"/>
        <com.larus.bmhome.chat.layout.widget.ShimmerLoadingVIew
            android:layout_width="?attr/larus_dp_160"
            android:layout_height="?attr/larus_dp_20"
            android:layout_marginTop="?attr/larus_dp_16"
            android:layout_marginStart="?attr/larus_dp_18"
            android:layout_marginEnd="?attr/larus_dp_18"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
