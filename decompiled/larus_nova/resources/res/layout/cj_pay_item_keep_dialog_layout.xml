<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/cj_pay_bg_keep_dialog_item"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <TextView
        android:textSize="10sp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/cj_pay_keep_dialog_item_left_top_text"
        android:background="@drawable/cj_pay_bg_keep_dialog_item_mark"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/cj_pay_keep_dialog_item_left_layout"
        android:layout_width="80dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="5dp">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/cj_pay_color_red_fe2c55"
            android:id="@+id/cj_pay_keep_dialog_item_left_unit"
            android:paddingTop="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cj_pay_currency_unit"/>
        <TextView
            android:textSize="24sp"
            android:textColor="@color/cj_pay_color_red_fe2c55"
            android:id="@+id/cj_pay_keep_dialog_item_left_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:letterSpacing="-0.05"/>
        <TextView
            android:textSize="22sp"
            android:textColor="@color/cj_pay_color_red_fe2c55"
            android:ellipsize="end"
            android:id="@+id/cj_pay_keep_dialog_item_left_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/cj_pay_keep_dialog_item_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/cj_pay_keep_dialog_item_line"
        android:layout_toRightOf="@+id/cj_pay_keep_dialog_item_left_layout"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_90"
        android:ellipsize="end"
        android:id="@+id/cj_pay_keep_dialog_item_right_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:maxLines="1"
        android:layout_toRightOf="@+id/cj_pay_keep_dialog_item_line"
        android:layout_centerVertical="true"/>
</RelativeLayout>
