<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/big_image_extra_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="@drawable/larus_image_detail_top_shadow"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_207">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/titleBar"
            android:background="@color/larus_static_black_transparent_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/background"
                android:background="@android:color/transparent"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_44"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/back"
                android:layout_width="?attr/larus_dp_38"
                android:layout_height="?attr/larus_dp_38"
                android:src="@drawable/larus_bg_big_close_page"
                android:contentDescription="@string/larus_accessibility_icon_close"
                android:layout_marginStart="?attr/larus_dp_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="?attr/larus_dp_15"
                android:textColor="@color/larus_static_white"
                android:id="@+id/indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/sourceIconV2"
                android:padding="?attr/larus_dp_2"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"
                android:src="@drawable/larus_layout_big_image_extra_link"
                android:layout_marginEnd="?attr/larus_dp_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/source"
                android:background="@drawable/larus_bg_big_image_icon"
                android:paddingLeft="?attr/larus_dp_12"
                android:paddingTop="?attr/larus_dp_10"
                android:paddingRight="?attr/larus_dp_12"
                android:paddingBottom="?attr/larus_dp_10"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="?attr/larus_dp_38"
                android:layout_marginEnd="?attr/larus_dp_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/sourceIcon"
                    android:layout_width="?attr/larus_dp_16"
                    android:layout_height="?attr/larus_dp_16"
                    android:layout_marginEnd="?attr/larus_dp_4"
                    app:roundBottomEnd="true"
                    app:roundBottomStart="true"
                    app:roundTopEnd="true"
                    app:roundTopStart="true"
                    app:roundedCornerRadius="?attr/larus_dp_4"/>
                <TextView
                    android:textSize="?attr/larus_dp_13"
                    android:textColor="@color/larus_static_white"
                    android:id="@+id/sourceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <ImageView
        android:layout_gravity="start|bottom"
        android:id="@+id/like"
        android:background="@drawable/larus_bg_big_image_icon"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_38"
        android:layout_height="?attr/larus_dp_38"
        android:layout_marginBottom="?attr/larus_dp_46"
        android:src="@drawable/larus_ic_like_white"
        android:layout_marginStart="?attr/larus_dp_16"/>
    <ImageView
        android:layout_gravity="start|bottom"
        android:id="@+id/dislike"
        android:background="@drawable/larus_bg_big_image_icon"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_38"
        android:layout_height="?attr/larus_dp_38"
        android:layout_marginBottom="?attr/larus_dp_46"
        android:src="@drawable/larus_ic_dislike_white"
        android:layout_marginStart="?attr/larus_dp_68"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="start|bottom"
        android:id="@+id/bottom_container"
        android:background="@color/larus_static_black_transparent_2"
        android:paddingLeft="?attr/larus_dp_12"
        android:paddingTop="?attr/larus_dp_12"
        android:paddingRight="?attr/larus_dp_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.larus.bmhome.bigimg.aibeautify.CommonAiBeautifyLayout
            android:id="@+id/ai_beautify_layout"
            android:background="@drawable/larus_bg_big_image_icon"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_44"
            android:layout_marginEnd="?attr/larus_dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/download_layout"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.larus.bmhome.bigimg.download.CommonDownLoadLayout
            android:id="@+id/download_layout"
            android:background="@drawable/larus_bg_big_image_icon"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_44"
            android:contentDescription="@string/larus_accessibility_save"
            android:layout_marginEnd="?attr/larus_dp_8"
            app:layout_constraintEnd_toStartOf="@+id/creation_view"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toEndOf="@+id/ai_beautify_layout"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginStart="?attr/larus_dp_8"/>
        <com.larus.bmhome.view.CreationOperateContainerView
            android:id="@+id/creation_view"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_44"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toEndOf="@+id/download_layout"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.larus.bmhome.bigimg.widget.BottomCreationEditView
        android:layout_gravity="start|bottom"
        android:id="@+id/bottom_tools_container"
        android:background="@color/larus_static_black_transparent_2"
        android:paddingLeft="?attr/larus_dp_12"
        android:paddingTop="?attr/larus_dp_12"
        android:paddingRight="?attr/larus_dp_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/fl_lynx_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</FrameLayout>
