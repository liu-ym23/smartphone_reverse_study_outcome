<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="72dp">
    <FrameLayout
        android:background="@drawable/ttlive_bg_interactivity_share_cover"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/iv_cover"
            android:layout_width="48dp"
            android:layout_height="48dp"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="21dp"
            android:maxLines="1"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#99161823"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="17dp"
            android:maxLines="1"/>
    </LinearLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_commonui_white"
        android:gravity="center"
        android:id="@+id/btn_operate"
        android:background="@drawable/ttlive_bg_interactivity_share_operate"
        android:layout_width="64dp"
        android:layout_height="24dp"/>
</LinearLayout>
