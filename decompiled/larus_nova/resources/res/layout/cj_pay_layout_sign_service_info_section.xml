<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/sign_and_pay_only_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/cj_deposit_merchant_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <TextView
                android:textSize="14sp"
                android:textColor="#99161823"
                android:layout_gravity="top"
                android:id="@+id/cj_deposit_service_merchant_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="24dp"
                android:text="@string/cj_pay_sign_and_pay_service_merchant"/>
            <com.android.ttcjpaysdk.base.theme.widget.CJPayFlexibleRoundCornerImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_deposit_service_merchant_icon"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="4dp"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                app:CJPayCorners="CJPay_BOTTOM_RIGHT|CJPay_BOTTOM_LEFT|CJPay_TOP_RIGHT|CJPay_TOP_LEFT"
                app:CJPayCornersRadius="8dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ff161823"
                android:ellipsize="end"
                android:id="@+id/cj_deposit_service_merchant_right"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/cj_service_post_payments_root_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</merge>
