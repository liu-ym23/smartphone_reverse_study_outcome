<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/dialog_view"
        android:background="@drawable/ttlive_effect_bg_gesture_magic_dialog_new_style"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/top_view"
        android:background="#0fffffff"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="51.5dp"
        app:layout_constraintEnd_toEndOf="@+id/dialog_view"
        app:layout_constraintRight_toRightOf="@+id/dialog_view"
        app:layout_constraintStart_toStartOf="@+id/dialog_view"
        app:layout_constraintTop_toTopOf="@+id/dialog_view"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#fff"
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_effect_gesture_magic_title"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="@+id/top_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/dialog_view"
        app:layout_constraintTop_toTopOf="@+id/dialog_view"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/gesture_magic_list"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_view"/>
    <com.bytedance.android.live.uikit.recyclerview.LoadingStatusView
        android:layout_gravity="center"
        android:id="@+id/status_view"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/dialog_view"
        app:layout_constraintEnd_toEndOf="@+id/dialog_view"
        app:layout_constraintStart_toStartOf="@+id/dialog_view"
        app:layout_constraintTop_toBottomOf="@+id/top_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
