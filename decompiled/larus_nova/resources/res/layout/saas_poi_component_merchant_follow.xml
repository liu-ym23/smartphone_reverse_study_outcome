<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.locallife.dito.baseview.RoundLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/poi_component_merchant_follow_60572503"
    android:background="@drawable/poi_merchant_follow_background"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/poi_component_merchant_follow_452603698"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/poi_component_merchant_follow_1016059106"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true">
            <com.bytedance.dux.text.DuxTextView
                android:textSize="12sp"
                android:textColor="@color/POIPrimary2"
                android:ellipsize="end"
                android:id="@+id/poi_merchant_follow_tip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/saas_poi_detail_merchant_follow_tip"
                android:maxLines="1"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="end|center_vertical"
                android:padding="1dp"
                android:layout_width="12dp"
                android:layout_height="12dp"
                app:srcCompat="@drawable/ic_s_s_arrowright_outlined"
                app:tint="@color/POITextPrimary"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/poi_merchant_follow_close"
            android:padding="1dp"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_centerVertical="true"
            android:contentDescription="@string/off"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/ic_s_s_xmark_outlined"
            app:tint="@color/POILinePrimary2"/>
    </RelativeLayout>
    <View
        android:background="@color/POIBgTab"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="13dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/poi_merchant_follow_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="4dp">
        <FrameLayout
            android:layout_width="55dp"
            android:layout_height="52dp">
            <com.bytedance.locallife.poi.newdetail.widget.CircleImageView
                android:id="@+id/poi_merchant_follow_avatar"
                android:layout_width="52dp"
                android:layout_height="52dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/poi_merchant_follow_certified"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginTop="32dp"
                android:src="@drawable/poi_merchant_follow_certified"
                android:layout_marginStart="43dp"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="11dp">
            <com.bytedance.dux.text.DuxTextView
                android:textSize="14sp"
                android:textColor="@color/POIPrimary2"
                android:ellipsize="end"
                android:id="@+id/poi_merchant_follow_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <com.bytedance.dux.text.DuxTextView
                android:textSize="12sp"
                android:textColor="@color/POILinePrimary2"
                android:ellipsize="end"
                android:id="@+id/poi_merchant_follow_intro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"/>
        </LinearLayout>
        <com.bytedance.dux.text.DuxTextView
            android:textSize="14sp"
            android:gravity="center"
            android:id="@+id/poi_merchant_follow_button"
            android:layout_width="64dp"
            android:layout_height="28dp"
            android:layout_marginStart="20dp"/>
    </LinearLayout>
</com.bytedance.locallife.dito.baseview.RoundLinearLayout>
