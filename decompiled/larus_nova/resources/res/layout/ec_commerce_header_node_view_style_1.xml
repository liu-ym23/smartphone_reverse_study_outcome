<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/header_node_title"
        android:background="@drawable/commerce_bg_brand_list_brand"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/header_node_title_icon"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginStart="2dp"
        app:layoutMode="width_self_adjust"
        app:layout_constraintBottom_toBottomOf="@+id/header_node_title"
        app:layout_constraintLeft_toRightOf="@+id/header_node_title"
        app:layout_constraintTop_toTopOf="@+id/header_node_title"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ec_more_container"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="11dp"
            android:textColor="@color/commerce_color_FE2C55"
            android:id="@+id/ec_more_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/more"/>
        <ImageView
            android:layout_width="5.3dp"
            android:layout_height="9.2dp"
            android:src="@drawable/commerce_more"
            android:layout_marginStart="5.6dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
