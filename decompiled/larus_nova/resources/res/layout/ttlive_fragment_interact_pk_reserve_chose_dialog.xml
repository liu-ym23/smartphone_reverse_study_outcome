<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ttlive_pk_reserve_sheet_background"
    android:layout_width="match_parent"
    android:layout_height="227dp">
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ttlive_douyin_text_TextReverse3"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="回复主播的PK邀请"/>
    <View
        android:background="@color/ttlive_room_notice_dialog_line_color"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/tv_accept"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="接受"/>
    <View
        android:background="@color/ttlive_room_notice_dialog_line_color"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/tv_refuse"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="拒绝"/>
    <View
        android:background="@color/ttlive_room_notice_dialog_line_color"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="取消"/>
</LinearLayout>
