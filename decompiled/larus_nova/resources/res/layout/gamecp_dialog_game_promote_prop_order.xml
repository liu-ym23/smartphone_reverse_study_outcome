<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.gamecp.common.ui.RoundRectLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:leftTopRound="12dp"
    app:rightTopRound="12dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/gamecp_bg_game_union_promote_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.gamecp.business.gamedetail.view.GamePromoteScrollView
            android:id="@+id/sv_content"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/layout_pay"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingBottom="34dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="17dp"
                    android:textColor="#23b905"
                    android:gravity="center"
                    android:id="@+id/tv_buy_success_title"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:text="@string/ttlive_game_promote_prop_order_buy_success_title"
                    android:drawablePadding="8dp"
                    android:drawableStart="@drawable/gamecp_game_promote_prop_order_pay_success"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="#80ffffff"
                    android:id="@+id/tv_buy_success_title_tips"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/ttlive_game_promote_prop_order_buy_success_title_tips"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_buy_success_title"/>
                <TextView
                    android:textSize="17dp"
                    android:textColor="#ffffff"
                    android:id="@+id/tv_confirm_order_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_game_promote_prop_order_confirm_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_buy_success_title_tips"
                    app:layout_goneMarginTop="16dp"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_prop_info"
                    android:background="@drawable/shape_bg_0dffffff_corner_4"
                    android:paddingBottom="17dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_confirm_order_title"
                    app:layout_goneMarginTop="12dp">
                    <com.bytedance.android.gamecp.common.ui.HSImageView
                        android:id="@+id/iv_game_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginStart="16dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:roundedCornerRadius="4dp"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#bfffffff"
                        android:ellipsize="end"
                        android:id="@+id/tv_game_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lines="1"
                        android:maxEms="18"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_game_icon"
                        app:layout_constraintStart_toEndOf="@+id/iv_game_icon"
                        app:layout_constraintTop_toTopOf="@+id/iv_game_icon"/>
                    <com.bytedance.android.gamecp.common.ui.HSImageView
                        android:id="@+id/iv_prop_icon"
                        android:layout_width="53dp"
                        android:layout_height="53dp"
                        android:layout_marginTop="12dp"
                        app:layout_constraintStart_toStartOf="@+id/iv_game_icon"
                        app:layout_constraintTop_toBottomOf="@+id/iv_game_icon"
                        app:roundedCornerRadius="4dp"/>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="#e6ffffff"
                        android:ellipsize="end"
                        android:id="@+id/tv_game_prop_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:lines="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintBottom_toTopOf="@+id/tv_price_final"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/iv_prop_icon"
                        app:layout_constraintTop_toTopOf="@+id/iv_prop_icon"
                        app:layout_constraintVertical_chainStyle="packed"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="#fe2c55"
                        android:id="@+id/tv_price_final_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ttlive_game_promote_prop_price_unit"
                        app:layout_constraintBaseline_toBaselineOf="@+id/tv_price_final"
                        app:layout_constraintStart_toStartOf="@+id/tv_game_prop_name"/>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="#fe2c55"
                        android:id="@+id/tv_price_final"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_prop_icon"
                        app:layout_constraintStart_toEndOf="@+id/tv_price_final_unit"
                        app:layout_constraintTop_toBottomOf="@+id/tv_game_prop_name"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="#80ffffff"
                        android:id="@+id/tv_price_origin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        app:layout_constraintBaseline_toBaselineOf="@+id/tv_price_final"
                        app:layout_constraintStart_toEndOf="@+id/tv_price_final"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#80ffffff"
                        android:id="@+id/tv_prop_intro"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:layout_marginEnd="14dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/iv_prop_icon"
                        app:layout_constraintTop_toBottomOf="@+id/iv_prop_icon"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#bfffffff"
                        android:id="@+id/tv_prop_detail_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/ttlive_game_promote_prop_order_prop_detail_title"
                        android:layout_marginEnd="14dp"
                        app:layout_constraintStart_toStartOf="@+id/iv_prop_icon"
                        app:layout_constraintTop_toBottomOf="@+id/tv_prop_intro"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_prop_detail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/tv_prop_detail_title"
                        app:layout_constraintTop_toBottomOf="@+id/tv_prop_detail_title"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:textSize="13sp"
                    android:textColor="#80ffffff"
                    android:id="@+id/cl_props_order_account_container"
                    android:background="@drawable/shape_bg_0dffffff_corner_4"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/ttlive_game_promote_prop_order_account_empty_title"
                    app:layout_constraintEnd_toEndOf="@+id/layout_prop_info"
                    app:layout_constraintStart_toStartOf="@+id/layout_prop_info"
                    app:layout_constraintTop_toBottomOf="@+id/layout_prop_info">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/gamecp_white_75"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ttlive_game_promote_prop_account_info_title2"
                        android:layout_marginStart="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textColor="@color/gamecp_white_34"
                        android:gravity="center"
                        android:id="@+id/tv_props_order_bind_account"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/ttlive_game_promote_prop_order_bind_account"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/cl_props_order_account_info"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <com.bytedance.android.gamecp.common.ui.HSImageView
                            android:id="@+id/iv_props_order_game_user_avatar"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="8dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/tv_props_order_game_user_info"
                            app:layout_constraintTop_toTopOf="parent"
                            app:roundAsCircle="true"/>
                        <TextView
                            android:textSize="13sp"
                            android:textColor="@color/gamecp_white_50"
                            android:ellipsize="end"
                            android:id="@+id/tv_props_order_game_user_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="173dp"
                            android:maxLines="1"
                            android:drawableEnd="@drawable/gamecp_ic_right_arrow_grey"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_roleid_guide"
                    android:background="@drawable/shape_bg_0dffffff_corner_4"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintEnd_toEndOf="@+id/layout_prop_info"
                    app:layout_constraintStart_toStartOf="@+id/layout_prop_info"
                    app:layout_constraintTop_toBottomOf="@+id/cl_props_order_account_container"
                    app:layout_goneMarginTop="8dp">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#bfffffff"
                        android:id="@+id/tv_roleid_guide_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/ttlive_game_promote_prop_order_roleid_guide_title"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#80ffffff"
                        android:id="@+id/tv_roleid_guide_content"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:layout_constraintEnd_toEndOf="@+id/tv_roleid_guide_title"
                        app:layout_constraintStart_toStartOf="@+id/tv_roleid_guide_title"
                        app:layout_constraintTop_toBottomOf="@+id/tv_roleid_guide_title"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_prop_image"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="12dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/tv_roleid_guide_title"
                        app:layout_constraintStart_toStartOf="@+id/tv_roleid_guide_title"
                        app:layout_constraintTop_toBottomOf="@+id/tv_roleid_guide_content"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_instruction"
                    android:background="@drawable/shape_bg_0dffffff_corner_4"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintEnd_toEndOf="@+id/layout_prop_info"
                    app:layout_constraintStart_toStartOf="@+id/layout_prop_info"
                    app:layout_constraintTop_toBottomOf="@+id/layout_roleid_guide"
                    app:layout_goneMarginTop="8dp">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#bfffffff"
                        android:id="@+id/tv_instruction_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/ttlive_game_promote_prop_order_instruction_title"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#80ffffff"
                        android:id="@+id/tv_instruction_content"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/tv_instruction_title"
                        app:layout_constraintStart_toStartOf="@+id/tv_instruction_title"
                        app:layout_constraintTop_toBottomOf="@+id/tv_instruction_title"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_price_instruction"
                    android:background="@drawable/shape_bg_0dffffff_corner_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintEnd_toEndOf="@+id/layout_prop_info"
                    app:layout_constraintStart_toStartOf="@+id/layout_prop_info"
                    app:layout_constraintTop_toBottomOf="@+id/layout_instruction">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#bfffffff"
                        android:id="@+id/tv_price_instruction_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/ttlive_game_promote_prop_detail_price_instruction_title"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#80ffffff"
                        android:id="@+id/tv_price_instruction_market_price_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/ttlive_game_promote_prop_detail_price_instruction_market_price_title"
                        app:layout_constraintEnd_toEndOf="@+id/tv_price_instruction_title"
                        app:layout_constraintStart_toStartOf="@+id/tv_price_instruction_title"
                        app:layout_constraintTop_toBottomOf="@+id/tv_price_instruction_title"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#80ffffff"
                        android:id="@+id/tv_price_instruction_market_price_content"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/ttlive_game_promote_prop_detail_price_instruction_market_price_content"
                        app:layout_constraintEnd_toEndOf="@+id/tv_price_instruction_title"
                        app:layout_constraintStart_toStartOf="@+id/tv_price_instruction_title"
                        app:layout_constraintTop_toBottomOf="@+id/tv_price_instruction_market_price_title"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#80ffffff"
                        android:id="@+id/tv_price_instruction_selling_price_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/ttlive_game_promote_prop_detail_price_instruction_selling_price_title"
                        app:layout_constraintEnd_toEndOf="@+id/tv_price_instruction_title"
                        app:layout_constraintStart_toStartOf="@+id/tv_price_instruction_title"
                        app:layout_constraintTop_toBottomOf="@+id/tv_price_instruction_market_price_content"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#80ffffff"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="16dp"
                        android:text="@string/ttlive_game_promote_prop_detail_price_instruction_selling_price_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/tv_price_instruction_title"
                        app:layout_constraintStart_toStartOf="@+id/tv_price_instruction_title"
                        app:layout_constraintTop_toBottomOf="@+id/tv_price_instruction_selling_price_title"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_order_info"
                    android:background="@drawable/shape_bg_0dffffff_corner_4"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintEnd_toEndOf="@+id/layout_prop_info"
                    app:layout_constraintStart_toStartOf="@+id/layout_prop_info"
                    app:layout_constraintTop_toBottomOf="@+id/layout_price_instruction"
                    app:layout_goneMarginTop="8dp">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#bfffffff"
                        android:id="@+id/tv_order_info_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/ttlive_game_promote_prop_order_info_title"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#80ffffff"
                        android:id="@+id/tv_order_info_num"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp"
                        app:layout_constraintEnd_toStartOf="@+id/tv_order_info_copy"
                        app:layout_constraintStart_toStartOf="@+id/tv_order_info_title"
                        app:layout_constraintTop_toBottomOf="@+id/tv_order_info_title"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#face15"
                        android:id="@+id/tv_order_info_copy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/ttlive_game_promote_prop_order_info_copy"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_order_info_num"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#80ffffff"
                        android:id="@+id/tv_order_info_time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/tv_order_info_title"
                        app:layout_constraintStart_toStartOf="@+id/tv_order_info_title"
                        app:layout_constraintTop_toBottomOf="@+id/tv_order_info_num"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="10sp"
                    android:textColor="#57ffffff"
                    android:gravity="center"
                    android:id="@+id/tv_tips_bottom_agreement"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="3dp"
                    app:layout_constraintEnd_toEndOf="@+id/layout_prop_info"
                    app:layout_constraintStart_toStartOf="@+id/layout_prop_info"
                    app:layout_constraintTop_toBottomOf="@+id/layout_order_info"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.bytedance.android.gamecp.business.gamedetail.view.GamePromoteScrollView>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_pay"
            android:background="@drawable/gamecp_game_promote_prop_order_pay_bg"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:textSize="13sp"
                android:textColor="#fe2c55"
                android:id="@+id/tv_pay_price_final_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_game_promote_prop_price_unit"
                android:layout_marginStart="16dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_pay_price_final"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:textSize="24sp"
                android:textColor="#fe2c55"
                android:id="@+id/tv_pay_price_final"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                app:layout_constraintBottom_toTopOf="@+id/tv_pay_price_origin_hint"
                app:layout_constraintStart_toEndOf="@+id/tv_pay_price_final_unit"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#80ffffff"
                android:id="@+id/tv_pay_price_origin_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@+id/tv_pay_price_final_unit"
                app:layout_constraintTop_toBottomOf="@+id/tv_pay_price_final"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#80ffffff"
                android:id="@+id/tv_pay_price_origin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_pay_price_origin_hint"
                app:layout_constraintStart_toEndOf="@+id/tv_pay_price_origin_hint"
                app:layout_constraintTop_toTopOf="@+id/tv_pay_price_origin_hint"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/tv_pay_btn"
                android:background="@drawable/shape_bg_fe2c55_corner_2"
                android:layout_width="120dp"
                android:layout_height="44dp"
