<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/voice_chat_room_confirm_bg"
        android:background="@drawable/ttlive_bg_interact_dialog"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/scene_panel_top_bar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        app:layout_constraintTop_toTopOf="@+id/voice_chat_room_confirm_bg">
        <TextView
            android:textSize="12dp"
            android:textColor="#87000000"
            android:gravity="center_vertical"
            android:layout_gravity="start"
            android:id="@+id/scene_radio_switch"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="17dp"
            android:layout_marginTop="20dp"
            android:text="@string/ttlive_live_voice_chat_switch_to_radio"
            android:layout_marginStart="16dp"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:id="@+id/scene_panel_title"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="16dp"
            android:text="@string/ttlive_live_voice_chat_room_scene"/>
    </FrameLayout>
    <View
        android:background="#19161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintTop_toBottomOf="@+id/scene_panel_top_bar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chat_room_bg"
        android:background="@drawable/ttlive_voice_chatroom_select_scene_bg"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="12dp"
        app:layout_constraintEnd_toStartOf="@+id/ktv_room_bg"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="@+id/voice_chat_room_confirm_bg"
        app:layout_constraintTop_toBottomOf="@+id/scene_panel_top_bar">
        <ImageView
            android:id="@+id/chat_current_scene_label"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ttlive_voice_current_link_mode_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/chat_room_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ttlive_voice_chatroom_icon"
            app:layout_constraintEnd_toEndOf="@+id/chat_room_bg"
            app:layout_constraintStart_toStartOf="@+id/chat_room_bg"
            app:layout_constraintTop_toTopOf="@+id/chat_room_bg"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:id="@+id/chat_room_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_live_interact_confirm_title"
            app:layout_constraintEnd_toEndOf="@+id/chat_room_bg"
            app:layout_constraintStart_toStartOf="@+id/chat_room_bg"
            app:layout_constraintTop_toBottomOf="@+id/chat_room_icon"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#66161823"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/ttlive_live_interact_confirm_chatroom_hint"
            app:layout_constraintEnd_toEndOf="@+id/chat_room_bg"
            app:layout_constraintStart_toStartOf="@+id/chat_room_bg"
            app:layout_constraintTop_toBottomOf="@+id/chat_room_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ktv_room_bg"
        android:background="@drawable/ttlive_voice_ktvroom_select_scene_bg"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:layout_marginLeft="7dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="7dp"
        app:layout_constraintEnd_toStartOf="@+id/ktv_chorus_room_bg"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/chat_room_bg"
        app:layout_constraintTop_toBottomOf="@+id/scene_panel_top_bar">
        <ImageView
            android:id="@+id/ktv_current_scene_label"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ttlive_voice_current_link_mode_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/ktv_room_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ttlive_video_ktvroom_icon"
            app:layout_constraintEnd_toEndOf="@+id/ktv_room_bg"
            app:layout_constraintStart_toStartOf="@+id/ktv_room_bg"
            app:layout_constraintTop_toTopOf="@+id/ktv_room_bg"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:id="@+id/ktv_room_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_live_interact_confirm_ktvroom_title"
            app:layout_constraintEnd_toEndOf="@+id/ktv_room_bg"
            app:layout_constraintStart_toStartOf="@+id/ktv_room_bg"
            app:layout_constraintTop_toBottomOf="@+id/ktv_room_icon"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#66161823"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/ttlive_live_interact_confirm_ktvroom_hint"
            app:layout_constraintEnd_toEndOf="@+id/ktv_room_bg"
            app:layout_constraintStart_toStartOf="@+id/ktv_room_bg"
            app:layout_constraintTop_toBottomOf="@+id/ktv_room_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ktv_chorus_room_bg"
        android:background="@drawable/ttlive_voice_chatroom_select_scene_bg"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:layout_marginLeft="7dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/ktv_room_bg"
        app:layout_constraintTop_toBottomOf="@+id/scene_panel_top_bar">
        <ImageView
            android:id="@+id/ktv_chorus_current_scene_label"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ttlive_voice_current_link_mode_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/ktv_chorus_room_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ttlive_chorus_room_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:id="@+id/ktv_chorus_room_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_live_interact_confirm_chorus_room_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ktv_chorus_room_icon"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#66161823"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/ttlive_live_interact_confirm_chorus_room_hint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ktv_chorus_room_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
