<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/cj_pay_limit_error_layout"
    android:background="?attr/cj_pay_page_bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/cj_pay_view_standard_titlebar_layout"
        layout="@layout/cj_pay_view_standard_titlebar_layout"/>
    <TextView
        android:textSize="17dp"
        android:textColor="?attr/cj_pay_limit_error_title_color"
        android:layout_gravity="center_horizontal"
        android:id="@+id/cj_pay_limit_error_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="200dp"
        android:text="@string/cj_pay_limit_error_title"
        style="@style/CJPayShadowTextStyle"/>
    <TextView
        android:textSize="14dp"
        android:textColor="?attr/cj_pay_limit_error_subtitle_color"
        android:layout_gravity="center_horizontal"
        android:id="@+id/cj_pay_limit_error_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/cj_pay_limit_error_content"/>
    <TextView
        android:textSize="15dp"
        android:textColor="?attr/cj_pay_limit_error_btn_text_color"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/cj_pay_limit_error_button"
        android:background="?attr/cj_pay_limit_error_btn"
        android:layout_width="231dp"
        android:layout_height="44dp"
        android:layout_marginTop="234dp"
        android:text="@string/cj_pay_limit_error_btn"
        style="@style/CJPayShadowTextStyle"/>
</LinearLayout>
