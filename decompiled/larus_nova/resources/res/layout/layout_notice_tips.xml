<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/dp_12"
    android:paddingBottom="@dimen/dp_14"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ud_notice_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="@dimen/dp_2"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/UDText.Body2"
        android:id="@+id/ud_notice_text"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintBottom_toTopOf="@+id/ud_notice_text_v2"
        app:layout_constraintLeft_toRightOf="@+id/ud_notice_icon"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="12dp"
        app:layout_goneMarginLeft="16dp"
        app:layout_goneMarginRight="16dp"/>
    <TextView
        android:textAppearance="@style/UDText.Body2"
        android:id="@+id/ud_notice_text_v2"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintLeft_toRightOf="@+id/ud_notice_icon"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ud_notice_text"
        app:layout_goneMarginBottom="12dp"
        app:layout_goneMarginLeft="16dp"
        app:layout_goneMarginRight="16dp"/>
    <TextView
        android:textAppearance="@style/UDText.Body2"
        android:textStyle="bold"
        android:id="@+id/ud_notice_text_v3"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintLeft_toRightOf="@+id/ud_notice_icon"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ud_notice_text_v2"
        app:layout_goneMarginBottom="12dp"
        app:layout_goneMarginLeft="16dp"
        app:layout_goneMarginRight="16dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
