<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.shopping.anchorv3.activities.view.ActivityBarBackgroundLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/anchor_v3_sv_ip_activity_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:scaleType="centerCrop"/>
    <ViewStub
        android:id="@+id/ec_commerce_layout_subsidized_activity_viewstub"
        android:layout="@layout/ec_commerce_layout_subsidized_activity_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_activity_tag"
        android:background="@drawable/ec_commerce_activity_icon_bg"
        android:paddingLeft="@dimen/commerce_ll_activity_tag_padding_left_right"
        android:paddingTop="@dimen/commerce_ll_activity_tag_padding_top_bottom"
        android:paddingRight="@dimen/commerce_ll_activity_tag_padding_left_right"
        android:paddingBottom="@dimen/commerce_ll_activity_tag_padding_top_bottom"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="7dp"
        android:paddingStart="@dimen/commerce_ll_activity_tag_padding_left_right"
        android:paddingEnd="@dimen/commerce_ll_activity_tag_padding_left_right"
        android:layout_marginStart="16dp">
        <ImageView
            android:id="@+id/iv_activity_tag"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginRight="2dp"
            android:src="@drawable/commerce_anchor_v3_activity_green"
            android:scaleType="centerCrop"
            android:layout_marginEnd="2dp"/>
        <TextView
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_activity_tag"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:includeFontPadding="false"
            style="@style/font_size_24"/>
    </LinearLayout>
    <View
        android:id="@+id/diver_stick"
        android:background="@color/commerce_color_80FFFFFF"
        android:visibility="gone"
        android:layout_width="1dp"
        android:layout_height="8dp"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="12dp"
        android:layout_toRightOf="@+id/ll_activity_tag"
        android:layout_marginStart="4dp"
        android:layout_toEndOf="@+id/ll_activity_tag"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/BGReverse"
        android:gravity="center_vertical"
        android:id="@+id/already_sold"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4.5dp"
        android:includeFontPadding="false"
        android:layout_toRightOf="@+id/diver_stick"
        android:layout_alignTop="@+id/ll_activity_tag"
        android:layout_alignBottom="@+id/ll_activity_tag"
        android:lineSpacingExtra="3dp"
        android:layout_marginStart="4.5dp"
        android:layout_toEndOf="@+id/diver_stick"/>
    <com.bytedance.android.ec.core.widget.AutoResizePriceContainer
        android:id="@+id/container_price"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="5dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp">
        <com.bytedance.android.shopping.widget.PriceView
            android:id="@+id/text_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            app:extraTextColor="@color/BGReverse"
            app:extraTextSize="12sp"
            app:priceTextColor="@color/BGReverse"
            app:priceTextSize="20sp"
            app:spaceSize="2dp"/>
        <include
            android:id="@+id/container_discount_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_toRightOf="@+id/text_price"
            android:layout_centerVertical="true"
            android:layout_marginStart="6dp"
            android:layout_toEndOf="@+id/text_price"
            layout="@layout/ec_commerce_anchor_v3_discount_price"/>
        <com.bytedance.android.shopping.widget.PriceView
            android:id="@+id/normal_text_market_price"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginBottom="2dp"
            android:layout_toRightOf="@+id/text_price"
            android:layout_alignBottom="@+id/text_price"
            android:layout_centerVertical="true"
            android:layout_marginStart="6dp"
            android:layout_toEndOf="@+id/text_price"
            app:extraTextColor="@color/commerce_color_80FFFFFF"
            app:extraTextSize="12sp"
            app:priceTextColor="@color/commerce_color_80FFFFFF"
            app:priceTextSize="12sp"
            app:showDeleteLine="true"
            app:spaceSize="0dp"
            app:yangTextSize="12sp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/anchor_v3_price_desc_layout"
            android:background="@drawable/shopping_anchor_v3_common_price_desc"
            android:paddingLeft="6dp"
            android:paddingRight="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:minHeight="18dp"
            android:layout_toRightOf="@+id/normal_text_market_price"
            android:layout_centerVertical="true"
            android:paddingStart="6dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@+id/normal_text_market_price">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/shopping_price_arrow_down"
                android:scaleType="centerInside"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/shopping_color_F5347E"
                android:gravity="center"
                android:id="@+id/anchor_v3_price_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:minHeight="18dp"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
    </com.bytedance.android.ec.core.widget.AutoResizePriceContainer>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/anchor_v3_right_background"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="4dp"
        android:scaleType="centerCrop"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:gravity="right"
        android:orientation="vertical"
        android:id="@+id/ll_sec_kill"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true">
        <TextView
            android:textSize="11sp"
            android:textColor="@color/commerce_color_E5FFFFFF"
            android:gravity="right"
            android:id="@+id/tv_sec_kill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/anchor_v3_sv_ip_activity_logo"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/ll_sec_kill_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp">
            <TextView
                android:textColor="@color/BGReverse"
                android:id="@+id/anchor_v3_tv_ip_activity_end_tips"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="4dp"
                android:includeFontPadding="false"
                android:layout_marginEnd="4dp"
                style="@style/font_size_24"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/BGReverse"
                android:gravity="center"
                android:id="@+id/tv_hours"
                android:background="@drawable/ec_commerce_bg_anchor_v3_count_down"
                android:layout_width="20dp"
                android:layout_height="match_parent"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/BGReverse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:layout_marginBottom="1dp"
                android:text="@string/colon"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/BGReverse"
                android:gravity="center"
                android:id="@+id/tv_min"
                android:background="@drawable/ec_commerce_bg_anchor_v3_count_down"
                android:layout_width="20dp"
                android:layout_height="18dp"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/BGReverse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:layout_marginBottom="1dp"
                android:text=":"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/BGReverse"
                android:gravity="center"
                android:id="@+id/tv_sec"
                android:background="@drawable/ec_commerce_bg_anchor_v3_count_down"
                android:layout_width="20dp"
                android:layout_height="18dp"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/commerce_color_E5FFFFFF"
        android:gravity="right"
        android:id="@+id/tv_pre_sale"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:lineSpacingExtra="3dp"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:gravity="right"
        android:orientation="vertical"
        android:id="@+id/ll_appoint"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/anchor_v3_sv_ip_appoint_activity_logo"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:scaleType="centerCrop"/>
        <TextView
            android:textColor="@color/commerce_color_E5FFFFFF"
            android:id="@+id/tv_appoint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/font_size_22"/>
        <LinearLayout
            android:id="@+id/anchor_v3_ll_appointment_num_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <TextView
                android:textColor="@color/BGReverse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/commerce_already_have"
                style="@style/font_size_24"/>
            <TextView
                android:textColor="@color/BGReverse"
                android:id="@+id/tv_appoint_num"
                android:background="@drawable/ec_commerce_anchor_v3_appoint_icon_bg"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:layout_marginRight="2dp"
                android:layout_marginBottom="1dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                style="@style/font_size_24"/>
            <TextView
                android:textColor="@color/BGReverse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/commerce_people_appoint"
                style="@style/font_size_24"/>
        </LinearLayout>
    </LinearLayout>
</com.bytedance.android.shopping.anchorv3.activities.view.ActivityBarBackgroundLayout>
