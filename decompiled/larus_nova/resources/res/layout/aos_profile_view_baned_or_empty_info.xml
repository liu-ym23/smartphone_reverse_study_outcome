<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/ll_empty_container"
    android:paddingTop="84dp"
    android:paddingBottom="108dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/image_info"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/aos_profile_ic_banned_info_page"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/aos_text_primary"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/title_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textAlignment="center"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"/>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textSize="14sp"
        android:textColor="@color/aos_text_tertiary"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/content_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:textAlignment="center"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"/>
</LinearLayout>
