<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.larus.common_ui.widget.CircleSimpleDraweeView
        android:id="@+id/doraOnboardingAvatar"
        android:layout_width="?attr/larus_dp_144"
        android:layout_height="?attr/larus_dp_144"
        android:layout_marginTop="?attr/larus_dp_32"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="?attr/larus_dp_90"/>
    <ImageView
        android:id="@+id/doraOnboardingBubbleBg"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_100"
        android:layout_height="?attr/larus_dp_100"
        android:layout_marginBottom="?attr/larus_dp_90"
        android:src="@drawable/larus_dora_onboarding_speaking_bubble_bg"
        android:alpha="0.6"
        android:layout_marginStart="?attr/larus_dp_90"
        app:layout_constraintBottom_toBottomOf="@+id/doraOnboardingAvatar"
        app:layout_constraintStart_toStartOf="@+id/doraOnboardingAvatar"/>
    <com.lynx.lottieadapter.LottieAdapterView
        android:id="@+id/doraOnboardingBubbleThinking"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_61"
        android:layout_height="?attr/larus_dp_61"
        android:layout_marginBottom="?attr/larus_dp_110"
        android:layout_marginStart="?attr/larus_dp_110"
        app:layout_constraintBottom_toBottomOf="@+id/doraOnboardingAvatar"
        app:layout_constraintStart_toStartOf="@+id/doraOnboardingAvatar"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/guideRecyclerView"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_110"
        android:layout_marginTop="?attr/larus_dp_16"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@+id/doraOnboardingAvatar"/>
</merge>
