<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/cj_pay_payment_method_root_view"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cj_pay_height_470">
    <include layout="@layout/cj_pay_view_titlebar_noise_reduction_layout"/>
    <ListView
        android:id="@+id/cj_pay_payment_method_list_view"
        android:background="@color/cj_pay_color_trans"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/cj_pay_color_trans"
        android:dividerHeight="0dp"
        android:layout_below="@+id/cj_pay_titlebar_root_view"/>
</RelativeLayout>
