<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/larus_bg_bottom_sheet"
    android:paddingBottom="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="center"
        android:background="@drawable/larus_bg_sheet_handle"
        android:layout_width="?attr/larus_dp_40"
        android:layout_height="?attr/larus_dp_4"
        android:layout_marginTop="?attr/larus_dp_10"
        android:layout_marginBottom="?attr/larus_dp_18"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"/>
    <com.zhpan.bannerview.indicator.DrawableIndicator
        android:layout_gravity="center_horizontal"
        android:id="@+id/indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginBottom="?attr/larus_dp_16"/>
    <include
        android:layout_gravity="center"
        android:id="@+id/error_lay"
        android:layout_width="match_parent"
        android:layout_height="450dp"
        layout="@layout/larus_layout_bot_edit_error_lay"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/confirm_btn"
        android:background="@drawable/larus_bg_confirm_btn_r16"
        android:paddingTop="?attr/larus_dp_16"
        android:paddingBottom="?attr/larus_dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/larus_choose_bot_avatar_select_btn"
        android:alpha="0.3"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"/>
</LinearLayout>
