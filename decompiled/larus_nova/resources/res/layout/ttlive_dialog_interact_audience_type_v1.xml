<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="112dp">
    <View
        android:id="@+id/double_talk"
        android:background="@drawable/ttlive_double_talk_bg_big"
        android:layout_width="345dp"
        android:layout_height="80dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_width="100dp"
        android:layout_height="53dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/ttlive_double_talk_icon"
        android:layout_marginEnd="31dp"
        app:layout_constraintRight_toRightOf="@+id/double_talk"
        app:layout_constraintTop_toTopOf="@+id/double_talk"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_audience_link_tips"
        android:id="@+id/tv_interact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:src="@drawable/ttlive_double_talk_icon"
        android:text="@string/ttlive_live_interact_title_audience"
        android:layout_marginStart="20dp"
        app:layout_constraintLeft_toLeftOf="@+id/double_talk"
        app:layout_constraintTop_toTopOf="@+id/double_talk"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_audience_link_small_tips"
        android:id="@+id/tv_interact_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:src="@drawable/ttlive_double_talk_icon"
        android:text="@string/ttlive_double_talk_tips"
        android:layout_marginStart="20dp"
        app:layout_constraintLeft_toLeftOf="@+id/double_talk"
        app:layout_constraintTop_toTopOf="@+id/double_talk"/>
    <View
        android:id="@+id/video_talk_room"
        android:background="@drawable/ttlive_video_talkroom_bg"
        android:visibility="gone"
        android:layout_width="172dp"
        android:layout_height="124dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="7dp"
        app:layout_constraintLeft_toRightOf="@+id/double_talk"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
