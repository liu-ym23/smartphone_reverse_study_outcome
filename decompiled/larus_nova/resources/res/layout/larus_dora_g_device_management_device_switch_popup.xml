<?xml version="1.0" encoding="utf-8"?>
<com.larus.common_ui.widget.ShadowLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:ux_shadow_color="#26000000"
    app:ux_shadow_offset_x="0dp"
    app:ux_shadow_offset_y="?attr/larus_dp_6"
    app:ux_shadow_radius="?attr/larus_dp_16"
    app:ux_shadow_size="?attr/larus_dp_12">
    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/larus_base_3"
        app:cardCornerRadius="?attr/larus_dp_16"
        app:cardElevation="0dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="?attr/larus_dp_200"
            android:layout_height="wrap_content">
            <androidx.recyclerview.widget.RecyclerView
                android:scrollbarThumbVertical="@drawable/larus_dora_g_device_switch_scrollbar"
                android:id="@+id/recycler_view"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fadeScrollbars="false"
                android:overScrollMode="ifContentScrolls"
                app:layout_constraintBottom_toTopOf="@+id/divider_add"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/divider_add"
                android:background="@color/larus_neutral_transparent_1"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_8"
                app:layout_constraintBottom_toTopOf="@+id/btn_add_device"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/recycler_view"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/btn_add_device"
                android:paddingTop="?attr/larus_dp_13"
                android:paddingBottom="?attr/larus_dp_13"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_48"
                android:paddingStart="?attr/larus_dp_16"
                android:paddingEnd="?attr/larus_dp_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider_add">
                <ImageView
                    android:layout_width="?attr/larus_dp_20"
                    android:layout_height="?attr/larus_dp_20"
                    android:src="@drawable/larus_dora_g_device_management_switch_add_icon"
                    app:tint="@color/larus_neutral_100"/>
                <com.larus.dora.impl.view.DoraTextView
                    android:textSize="?attr/larus_sp_16"
                    android:textColor="@color/larus_neutral_100"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_g_device_add_new_device_cn"
                    android:layout_marginStart="?attr/larus_dp_12"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</com.larus.common_ui.widget.ShadowLayout>
