<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.ee.bear.wikiv2.sidebar.wikitree.widget.view.SidebarWikiTreeEmptyView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.ee.bear.wikiv2.sidebar.wikitree.widget.view.SidebarEmptyItemView xmlns:app="http://schemas.android.com/apk/res-auto"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/sidebar_tree_empty_view"
        android:paddingTop="@dimen/space_kit_len_13"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/guide_img"
            android:layout_width="207dp"
            android:layout_height="162dp"
            app:srcCompat="@drawable/sidebar_empty_guide_img"/>
        <TextView
            android:textSize="@dimen/font_size_17"
            android:textStyle="bold"
            android:textColor="@color/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_kit_len_16"
            android:text="@string/LarkCCM_NewCM_Onboarding_PersonalContent_Title"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/text_caption"
            android:gravity="center_horizontal"
            android:layout_width="254dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_kit_len_8"
            android:text="@string/LarkCCM_NewCM_Mobile_Onboarding_UseContentToOrganizeDocuments_Desc"
            android:singleLine="false"/>
        <Button
            android:textSize="@dimen/space_kit_len_16"
            android:textColor="@color/text_title"
            android:id="@+id/empty_view_add_node"
            android:background="@drawable/sidebar_wiki_create_btn_bg"
            android:layout_width="96dp"
            android:layout_height="@dimen/space_kit_len_36"
            android:layout_marginTop="@dimen/space_kit_len_16"
            android:text="@string/LarkCCM_NewCM_Sidebar_Web_CreateNew_Button"
            style="@style/Widget.AppCompat.Button.Borderless"/>
    </com.bytedance.ee.bear.wikiv2.sidebar.wikitree.widget.view.SidebarEmptyItemView>
    <com.bytedance.ee.bear.wikiv2.sidebar.wikitree.widget.view.SidebarEmptyItemView
        android:orientation="vertical"
        android:id="@+id/sidebar_tree_error_view"
        android:paddingTop="@dimen/dp_24"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_gravity="start"
            android:orientation="vertical"
            android:id="@+id/wiki_default_empty_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/empty_img"
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:srcCompat="@drawable/ccm_empty_neutral_restoring"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/text_caption"
                android:gravity="center"
                android:id="@+id/empty_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/LarkCCM_NewCM_TryAgain_Tooltip"/>
        </LinearLayout>
    </com.bytedance.ee.bear.wikiv2.sidebar.wikitree.widget.view.SidebarEmptyItemView>
</com.bytedance.ee.bear.wikiv2.sidebar.wikitree.widget.view.SidebarWikiTreeEmptyView>
