<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/inflow_feed_comment_view_comment_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/inflow_feed_comment_view_avatar"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginRight="4dp"
        app:layoutMode="round"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/commerce_color_90161823"
        android:id="@+id/inflow_feed_comment_view_comment_prefix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/shopping_inflow_feed_comment_prefix"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/commerce_color_90161823"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/inflow_feed_comment_view_comment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/commerce_color_90161823"
        android:id="@+id/inflow_feed_comment_view_comment_suffix"
        android:layout_width="10dp"
        android:layout_height="wrap_content"
        android:text="@string/shopping_inflow_feed_comment_suffix"/>
</LinearLayout>
