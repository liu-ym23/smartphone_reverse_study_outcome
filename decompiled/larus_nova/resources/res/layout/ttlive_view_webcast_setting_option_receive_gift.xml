<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/allow_receive_gift"
    android:paddingLeft="16dp"
    android:paddingBottom="16dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="yes"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintLeft_toLeftOf="parent"
    app:layout_constraintRight_toRightOf="parent"
    app:layout_constraintStart_toStartOf="parent">
    <TextView
        android:textSize="15dp"
        android:textColor="#e6ffffff"
        android:id="@+id/allow_receive_gift_title"
        android:layout_width="wrap_content"
        android:layout_height="25dp"
        android:layout_marginTop="13dp"
        android:text="@string/ttlive_allow_receive_gift_title"/>
    <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
        android:id="@+id/allow_receive_gift_switch"
        android:layout_width="43dp"
        android:layout_height="25dp"
        android:layout_marginTop="25dp"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"
        app:lsb_background="@color/ttlive_prelive_setting_switch_dark_fill"
        app:lsb_button_color="#ffffff"
        app:lsb_checked_color="#67dca0"
        app:lsb_effect_duration="50"
        app:lsb_shadow_radius="0dp"
        app:lsb_show_indicator="false"
        app:lsb_uncheck_color="@color/transparent"
        app:lsb_uncheckbutton_color="#d9ffffff"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#80ffffff"
        android:id="@+id/allow_receive_gift_desc"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/ttlive_allow_receive_gift_valid_desc"
        android:layout_below="@+id/allow_receive_gift_title"
        android:contentDescription="@string/ttlive_allow_receive_gift_valid_desc"
        android:importantForAccessibility="yes"/>
    <RelativeLayout
        android:id="@+id/allow_receive_invalid_layout"
        android:focusable="true"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/allow_receive_gift_title"
        android:importantForAccessibility="yes">
        <TextView
            android:textSize="13dp"
            android:textColor="#80ffffff"
            android:id="@+id/allow_receive_invalid_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ttlive_allow_receive_gift_invalid_desc"/>
        <LinearLayout
            android:id="@+id/verify_layout"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_toRightOf="@+id/allow_receive_invalid_desc"
            android:contentDescription="去认证"
            android:importantForAccessibility="yes">
            <TextView
                android:textSize="13dp"
                android:textColor="#ecc316"
                android:id="@+id/allow_receive_verify"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_allow_receive_gift_verify"/>
            <ImageView
                android:layout_gravity="center"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ttlive_audience_verify_arrow"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
