<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.widget.opt.MeasureOptFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/xplay_root_container"
    android:background="#161823"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/xplay_sonic_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <com.bytedance.android.livesdk.common.LiveViewStub
        android:id="@+id/xplay_view"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/xplay_fail_view"
        android:background="@color/black"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="225dp">
            <ImageView
                android:layout_width="180dp"
                android:layout_height="120dp"
                android:src="@drawable/ttlive_open_feature_list_network_error"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#80ffffff"
                android:gravity="center"
                android:id="@+id/xplay_fail_reason"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:text="@string/ttlive_open_platform_panel_load_fail"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/ttlive_live_game_interact_panel_loading_text_color"
                android:gravity="center"
                android:id="@+id/xplay_retry_btn"
                android:background="#26ffffff"
                android:visibility="gone"
                android:layout_width="170dp"
                android:layout_height="45dp"
                android:text="@string/ttlive_xplay_retry"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/ttlive_live_game_interact_panel_loading_text_color"
                android:gravity="center"
                android:id="@+id/xplay_close_btn"
                android:background="#26ffffff"
                android:visibility="gone"
                android:layout_width="170dp"
                android:layout_height="45dp"
                android:text="@string/ttlive_xplay_close"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/xplay_loading_view_new"
        android:background="@drawable/ttlive_xplay_loading_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/xplay_loading_game_icon"
            android:layout_width="65dp"
            android:layout_height="65dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:id="@+id/xplay_loading_game_name"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginTop="15dp"/>
        <ProgressBar
            android:id="@+id/xplay_loading_progress_bar"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="15dp"
            android:max="100"
            android:progressDrawable="@drawable/ttlive_xplay_loading_progress_bg"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            style="?android:attr/progressBarStyleHorizontal"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/xplay_loading_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="17dp"
            android:layout_marginTop="15dp"/>
    </LinearLayout>
</com.bytedance.android.livesdk.widget.opt.MeasureOptFrameLayout>
