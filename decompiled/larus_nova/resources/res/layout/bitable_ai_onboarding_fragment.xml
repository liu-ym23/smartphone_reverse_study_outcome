<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/closeOnboardingImg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        app:srcCompat="@drawable/ud_icon_close_small_outlined"/>
    <TextView
        android:textAppearance="@style/UDText.Body2"
        android:textSize="20sp"
        android:textColor="@color/primary_pri_500"
        android:layout_gravity="center_horizontal"
        android:id="@+id/titleTv"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/Bitable_BaseAI_Onboarding_GenerateFields_Title"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                app:srcCompat="@drawable/ud_icon_edit_discription_outlined"
                app:tint="@color/ud_B600"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_toRightOf="@+id/iv_1">
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/N900"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Bitable_BaseAI_Onboarding_Labeling_Title"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/N600"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Bitable_BaseAI_Onboarding_Labeling_Desc"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp">
            <ImageView
                android:id="@+id/iv_2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                app:srcCompat="@drawable/ud_icon_edit_outlined"
                app:tint="@color/ud_B600"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_toRightOf="@+id/iv_2">
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/N900"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Bitable_BaseAI_Onboarding_AutoExtract_Title"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/N600"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Bitable_BaseAI_Onboarding_AutoExtract_Desc"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp">
            <ImageView
                android:id="@+id/iv_3"
                android:layout_width="20dp"
                android:layout_height="20dp"
                app:srcCompat="@drawable/ud_icon_mark_outlined"
                app:tint="@color/ud_B600"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_toRightOf="@+id/iv_3">
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/N900"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Bitable_BaseAI_Onboarding_Summarize_Title"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/N600"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/Bitable_BaseAI_Onboarding_Summarize_Desc"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <com.larksuite.component.ui.layout.LKUIRoundableLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/notify_btn"
        android:background="@color/primary_fill_default"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="16dp"
        app:rl_border_color="@color/line_border_component"
        app:rl_border_width="@dimen/space_kit_len_1"
        app:rl_radius="@dimen/ud_radius_m">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/primary_on_primary_fill"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Bitable_BaseAI_Onboarding_TryNow_Button"/>
    </com.larksuite.component.ui.layout.LKUIRoundableLayout>&gt; 
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_disable"
        android:id="@+id/tx_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="60dp"/>
</LinearLayout>
