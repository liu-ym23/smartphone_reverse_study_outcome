<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/input_container"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ttlive_input_dialog_input_container_height">
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <HorizontalScrollView
            android:layout_gravity="center_vertical"
            android:id="@+id/left_scroll_container"
            android:background="@color/white"
            android:scrollbars="none"
            android:layout_width="200dp"
            android:layout_height="@dimen/ttlive_input_dialog_input_container_height">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/recommend_emoji_list_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
        </HorizontalScrollView>
        <View
            android:layout_gravity="right"
            android:background="@drawable/ttlive_input_control_fade_bg"
            android:layout_width="12dp"
            android:layout_height="@dimen/ttlive_input_dialog_input_container_height"/>
    </FrameLayout>
    <HorizontalScrollView
        android:layout_gravity="right"
        android:id="@+id/right_scroll_container"
        android:background="@color/white"
        android:scrollbars="none"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ttlive_input_dialog_input_container_height">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/input_function_list_container"
            android:background="@color/white"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ttlive_input_dialog_input_container_height"/>
    </HorizontalScrollView>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/input_function_fold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <View
        android:layout_gravity="bottom"
        android:background="@color/ttlive_input_v3_divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
</FrameLayout>
