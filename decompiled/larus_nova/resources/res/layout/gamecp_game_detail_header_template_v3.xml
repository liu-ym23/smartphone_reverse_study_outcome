<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/v_game_header_full_bg_atmosphere_ly"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="128dp"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.gamecp.common.ui.HSImageView
            android:id="@+id/v_game_header_full_bg_atmosphere_img"
            android:background="@color/gamecp_color_0B1926"
            android:layout_width="match_parent"
            android:layout_height="@dimen/gamecp_detail_full_image_height"
            app:actualImageScaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent"/>
    </FrameLayout>
    <View
        android:id="@+id/v_game_header_full_bg"
        android:background="@color/gamecp_color_0B1926"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/v_game_header_top_alpha_atmosphere"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:contentDescription="关闭, 按钮"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/v_game_header_full_shape"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_game_header_full_bg_atmosphere_ly">
        <View
            android:id="@+id/v_game_header_full_shape_sub1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/v_game_header_full_shape_sub2"
            android:layout_width="match_parent"
            android:layout_height="60dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/v_game_header_full_light_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_game_header_content_ly"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.gamecp.common.ui.RoundRectLayoutV2
        android:id="@+id/v_game_header_content_ly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/v_game_header_top_alpha_atmosphere"
        app:leftTopRound="12dp"
        app:rightTopRound="12dp">
        <View
            android:id="@+id/v_game_header_half_gradient_bg"
            android:background="@color/gamecp_color_0B1926"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/v_game_header_half_shape_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.android.gamecp.common.ui.HSImageView
                android:id="@+id/v_game_header_half_img"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                app:actualImageScaleType="centerCrop"/>
            <FrameLayout
                android:id="@+id/v_game_header_half_shape"
                android:background="@drawable/gamecp_shape_shadow_half_bg"
                android:layout_width="match_parent"
                android:layout_height="60dp"/>
        </FrameLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_game_header_info_container"
            android:paddingTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">
            <com.bytedance.android.gamecp.common.ui.HSImageView
                android:id="@+id/iv_game_header_icon"
                android:background="@drawable/gamecp_game_detail_img_default_bg_8dp"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:roundedCornerRadius="12dp"/>
            <View
                android:id="@+id/iv_game_header_icon_frame"
                android:background="@drawable/gamecp_game_detail_img_default_bg_8dp_frame"
                android:layout_width="72dp"
                android:layout_height="72dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_game_header_icon"
                app:layout_constraintEnd_toEndOf="@+id/iv_game_header_icon"
                app:layout_constraintStart_toStartOf="@+id/iv_game_header_icon"
                app:layout_constraintTop_toTopOf="@+id/iv_game_header_icon"/>
            <TextView
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="@color/gamecp_white"
                android:ellipsize="end"
                android:id="@+id/tv_game_header_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="4dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toTopOf="@+id/tags_and_account_container"
                app:layout_constraintEnd_toStartOf="@+id/cl_game_header_rating_container"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/iv_game_header_icon"
                app:layout_constraintTop_toTopOf="@+id/iv_game_header_icon"
                app:layout_constraintVertical_chainStyle="packed"/>
            <TextView
                android:textSize="10dp"
                android:textColor="#e5ffffff"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/mini_game_tag"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="24dp"
                android:text="@string/gamecp_mini_game_tag_v2"
                android:maxLines="1"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="@+id/tv_game_header_name"
                app:layout_constraintEnd_toStartOf="@+id/cl_game_header_rating_container"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/tv_game_header_name"
                app:layout_constraintTop_toTopOf="@+id/tv_game_header_name"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/tags_and_account_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:layout_constraintBottom_toTopOf="@+id/tv_game_header_short_additional_desc"
                app:layout_constraintStart_toStartOf="@+id/tv_game_header_name"
                app:layout_constraintTop_toBottomOf="@+id/tv_game_header_name">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/official_account_container"
                    android:background="@drawable/gamecp_shape_bg_1affffff_corner_2"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:id="@+id/iv_official_account"
                        android:background="@drawable/gamecp_game_promote_official_cert_icon"
                        android:visibility="visible"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="3dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="#99ffffff"
                        android:id="@+id/tv_official_account"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gamecp_official_account"
                        android:layout_marginStart="2dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/iv_official_account"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:id="@+id/official_account_arrow"
                        android:background="@drawable/gamecp_ic_official_account_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tv_official_account"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.bytedance.android.gamecp.common.ui.FlowLayout
                    android:orientation="horizontal"
                    android:id="@+id/fl_game_tags_container"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="185dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/official_account_container"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/gamecp_game_80ffffff"
                android:id="@+id/tv_game_header_short_additional_desc"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="1dp"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_game_header_icon"
                app:layout_constraintStart_toEndOf="@+id/iv_game_header_icon"
                app:layout_constraintTop_toBottomOf="@+id/tags_and_account_container"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/gamecp_game_80ffffff"
                android:id="@+id/tv_game_header_short_additional_desc_2"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toStartOf="@+id/tv_game_header_short_additional_desc"
                app:layout_constraintTop_toBottomOf="@+id/tv_game_header_short_additional_desc"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:id="@+id/cl_game_header_rating_container"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/iv_game_header_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/iv_game_header_icon">
                <TextView
                    android:textSize="28dp"
                    android:textStyle="bold"
                    android:textColor="@color/gamecp_white"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tv_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    app:layout_constraintBottom_toTopOf="@+id/tv_comment_count"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="11dp"
                    android:textStyle="normal"
                    android:textColor="@color/gamecp_game_99FFFFFF"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/tv_comment_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_score"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.bytedance.android.gamecp.common.ui.RoundRectLayoutV2>
</androidx.constraintlayout.widget.ConstraintLayout>
