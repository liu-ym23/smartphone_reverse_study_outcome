<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/markdown_view_and_btn_container"
        android:paddingBottom="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/markdown_text_view_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_56"
            android:layout_marginRight="@dimen/dp_16"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textColor="?attr/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/doc_create_btn"
            android:background="?attr/larus_bg_block_button_card"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_44"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_16"
            android:text="@string/larus_aiDoc_msgLongPressMenu_createDoc"
            android:fontFamily="sans-serif-medium"/>
        <View
            android:id="@+id/card_bottom_split_line"
            android:background="?attr/larus_neutral_transparent_1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_1"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_16"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/doc_op_header_container"
        android:paddingTop="@dimen/dp_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/doc_op_header"
            android:background="?attr/larus_bg_doc_op_header"
            android:paddingLeft="@dimen/dp_16"
            android:paddingRight="@dimen/dp_16"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56">
            <TextView
                android:textSize="@dimen/sp_15"
                android:textColor="?attr/larus_neutral_70"
                android:ellipsize="end"
                android:id="@+id/expand_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/copy_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="?attr/larus_dp_4"
                app:srcCompat="?attr/larus_doc_card_ic_copy"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/export_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="?attr/larus_dp_4"
                app:srcCompat="?attr/larus_ic_card_deep_research_report_export"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/create_doc_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="?attr/larus_dp_4"
                app:srcCompat="?attr/larus_doc_card_ic_edit"/>
        </LinearLayout>
    </FrameLayout>
    <View
        android:layout_gravity="top"
        android:id="@+id/card_separate_line"
        android:background="?attr/larus_neutral_transparent_1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
