<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.canvas.feature.component.resultdisplay.image.widget.RatioFrameLayout
        android:layout_gravity="center"
        android:id="@+id/image_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="center"
            android:id="@+id/bottom_image_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@drawable/larus_generate_image_error"
            app:roundedCornerRadius="?attr/larus_dp_8"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="center"
            android:id="@+id/image_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@drawable/larus_generate_image_error"
            app:roundedCornerRadius="?attr/larus_dp_8"/>
        <ImageView
            android:layout_gravity="start|bottom"
            android:id="@+id/left_bottom_iv"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_30"
            android:layout_height="?attr/larus_dp_30"
            android:layout_marginBottom="?attr/larus_dp_8"
            android:src="@drawable/larus_ic_canvas_compare"
            android:layout_marginStart="?attr/larus_dp_8"/>
        <FrameLayout
            android:layout_gravity="start|bottom"
            android:id="@+id/left_bottom_save_container"
            android:background="@drawable/larus_bg_canvas_image_action_button"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="?attr/larus_dp_30"
            android:layout_height="?attr/larus_dp_30"
            android:layout_marginBottom="?attr/larus_dp_8"
            android:layout_marginStart="?attr/larus_dp_8">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/left_bottom_save_icon"
                android:layout_width="?attr/larus_dp_16"
                android:layout_height="?attr/larus_dp_16"
                android:src="@drawable/larus_ic_canvas_download"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/left_bottom_save_loading"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_18"
                android:layout_height="?attr/larus_dp_18"
                android:indeterminate="true"
                android:indeterminateDrawable="@drawable/larus_ic_common_download_loading_animated"
                android:indeterminateDuration="1000"
                android:repeatCount="infinite"/>
        </FrameLayout>
        <ImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/right_bottom_iv"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_30"
            android:layout_height="?attr/larus_dp_30"
            android:layout_marginBottom="?attr/larus_dp_8"
            android:src="@drawable/larus_ic_canvas_regenerate"
            android:layout_marginEnd="?attr/larus_dp_8"/>
        <ViewStub
            android:id="@+id/image_loading"
            android:layout="@layout/larus_sketch_progress_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ViewStub
            android:id="@+id/image_above_layer"
            android:layout="@layout/larus_canvas_page_image_above_layer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.larus.canvas.feature.component.resultdisplay.image.widget.RatioFrameLayout>
</FrameLayout>
