<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ccmtoken_message_card_paragraph_loading_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <com.bytedance.ee.bear.facade.common.widget.RoundFrameLayout
        android:id="@+id/v1"
        android:background="@color/static_black_5"
        android:layout_width="0dp"
        android:layout_height="10dp"
        android:layout_marginTop="@dimen/dp_5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.78"
        app:radius="14dp"/>
    <com.bytedance.ee.bear.facade.common.widget.RoundFrameLayout
        android:id="@+id/v2"
        android:background="@color/static_black_5"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v1"
        app:radius="14dp"/>
    <com.bytedance.ee.bear.facade.common.widget.RoundFrameLayout
        android:id="@+id/v3"
        android:background="@color/static_black_5"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v2"
        app:radius="14dp"/>
    <com.bytedance.ee.bear.facade.common.widget.RoundFrameLayout
        android:id="@+id/v4"
        android:background="@color/static_black_5"
        android:layout_width="0dp"
        android:layout_height="10dp"
        android:layout_marginTop="@dimen/dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v3"
        app:layout_constraintWidth_percent="0.57"
        app:radius="14dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
