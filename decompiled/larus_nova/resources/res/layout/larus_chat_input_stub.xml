<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chat_input_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ViewStub
        android:id="@+id/action_modify_cancel"
        android:visibility="gone"
        android:duplicateParentState="true"
        android:inflatedId="@+id/action_modify_cancel"
        android:layout_width="?attr/larus_dp_32"
        android:layout_height="?attr/larus_dp_32"
        android:layout_marginBottom="?attr/larus_dp_24"
        android:layout_marginStart="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/input_area_container"
        app:layout_constraintStart_toStartOf="parent"/>
    <ViewStub
        android:id="@+id/action_modify_confirm"
        android:duplicateParentState="true"
        android:inflatedId="@+id/action_modify_confirm"
        android:layout_width="?attr/larus_dp_32"
        android:layout_height="?attr/larus_dp_32"
        android:layout_marginBottom="?attr/larus_dp_24"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/input_area_container"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.larus.common_ui.view.GradientMaskView
        android:id="@+id/action_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        app:layout_constraintBottom_toTopOf="@+id/input_area_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadeScrollbars="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    </com.larus.common_ui.view.GradientMaskView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/input_area_container"
        android:paddingLeft="?attr/larus_dp_12"
        android:paddingTop="?attr/larus_dp_12"
        android:paddingRight="?attr/larus_dp_12"
        android:paddingBottom="?attr/larus_dp_12"
        android:duplicateParentState="true"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/voice_input_container"
        app:layout_constraintEnd_toStartOf="@+id/action_modify_confirm"
        app:layout_constraintStart_toEndOf="@+id/action_modify_cancel">
        <FrameLayout
            android:id="@+id/input_above_layout"
            android:layout_width="?attr/larus_dp_0"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/input_area"
            app:layout_constraintEnd_toEndOf="@+id/input_area"
            app:layout_constraintStart_toStartOf="@+id/input_area"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/input_above_ll_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ViewStub
                    android:id="@+id/input_editor_container"
                    android:visibility="gone"
                    android:inflatedId="@+id/input_editor_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <EditText
                android:id="@+id/focus_holder"
                android:layout_width="?attr/larus_dp_0"
                android:layout_height="?attr/larus_dp_0"
                android:alpha="0"
                app:layout_constraintBottom_toBottomOf="@+id/input_editor_container"
                app:layout_constraintEnd_toEndOf="@+id/input_editor_container"
                app:layout_constraintStart_toStartOf="@+id/input_editor_container"
                app:layout_constraintTop_toTopOf="@+id/input_editor_container"/>
        </FrameLayout>
        <View
            android:id="@+id/divider_input_area_above"
            android:background="?attr/larus_neutral_transparent_2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1px"
            app:layout_constraintBottom_toTopOf="@+id/input_area"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/input_above_layout"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/input_area"
            android:duplicateParentState="true"
            android:layout_width="?attr/larus_dp_0"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/divider_input_area_below"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider_input_area_above">
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/input_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="top"/>
            <com.larus.common_ui.view.ChatInputInnerView
                android:id="@+id/speak_area"
                android:paddingTop="?attr/larus_dp_11"
                android:paddingBottom="?attr/larus_dp_11"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_56"
                android:minHeight="?attr/larus_dp_56"
                android:paddingStart="?attr/larus_dp_100"
                android:paddingEnd="?attr/larus_dp_100"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <ImageView
                android:id="@+id/action_full_screen"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_32"
                android:layout_height="?attr/larus_dp_54"
                android:scaleType="centerInside"
                android:contentDescription="@string/larus_accessibility_input_fullScreen"
                android:paddingStart="?attr/larus_dp_0"
                android:paddingEnd="?attr/larus_dp_12"
                app:layout_constraintEnd_toEndOf="parent"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/action_area"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="?attr/larus_dp_56"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/action_ai_gen"
                    android:visibility="gone"
                    android:layout_width="?attr/larus_dp_44"
                    android:layout_height="?attr/larus_dp_56"
                    android:paddingStart="?attr/larus_dp_0"
                    android:paddingEnd="?attr/larus_dp_12"
                    app:srcCompat="@drawable/larus_ic_ai_gen"/>
                <ProgressBar
                    android:id="@+id/progress_ai_gen"
                    android:visibility="gone"
                    android:layout_width="?attr/larus_dp_44"
                    android:layout_height="?attr/larus_dp_56"
                    android:indeterminate="true"
                    android:indeterminateDrawable="@drawable/larus_bg_ai_gen_loading_dy"
                    android:indeterminateDuration="2000"
                    android:paddingStart="?attr/larus_dp_0"
                    android:paddingEnd="?attr/larus_dp_12"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/action_voice_input"
                    android:visibility="gone"
                    android:layout_width="?attr/larus_dp_44"
                    android:layout_height="?attr/larus_dp_56"
                    android:paddingStart="?attr/larus_dp_0"
                    android:paddingEnd="?attr/larus_dp_12"/>
                <ImageView
                    android:id="@+id/action_input"
                    android:visibility="visible"
                    android:layout_width="?attr/larus_dp_44"
                    android:layout_height="?attr/larus_dp_56"
                    android:paddingStart="?attr/larus_dp_0"
                    android:paddingEnd="?attr/larus_dp_12"/>
                <FrameLayout
                    android:id="@+id/action_speak_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/action_speak"
                        android:visibility="visible"
                        android:layout_width="?attr/larus_dp_44"
                        android:layout_height="?attr/larus_dp_56"
                        android:paddingStart="?attr/larus_dp_0"
                        android:paddingEnd="?attr/larus_dp_12"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_gravity="center"
                        android:id="@+id/action_press_speak_group"
                        android:paddingLeft="?attr/larus_dp_8"
                        android:paddingTop="?attr/larus_dp_3"
                        android:paddingRight="?attr/larus_dp_8"
                        android:paddingBottom="?attr/larus_dp_3"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="?attr/larus_dp_6"
                        android:layout_marginRight="?attr/larus_dp_6">
                        <TextView
                            android:textSize="?attr/larus_dp_14"
                            android:textStyle="bold"
                            android:textColor="?attr/larus_neutral_100"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:id="@+id/action_press_speak_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="?attr/larus_dp_20"
                            android:text="@string/larus_hold_to_speak"
                            android:maxLines="1"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/action_press_speak_icon"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView
                            android:id="@+id/action_press_speak_icon"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scaleType="center"
                            android:layout_marginStart="2dp"
                            app:layout_constraintBottom_toBottomOf="@+id/action_press_speak_text"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/action_press_speak_text"
                            app:layout_constraintTop_toTopOf="@+id/action_press_speak_text"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </FrameLayout>
                <ImageView
                    android:id="@+id/action_send"
                    android:visibility="visible"
                    android:layout_width="?attr/larus_dp_44"
                    android:layout_height="?attr/larus_dp_56"
                    android:paddingStart="?attr/larus_dp_0"
                    android:paddingEnd="?attr/larus_dp_12"/>
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:id="@+id/action_menu_entrance"
                        android:layout_width="?attr/larus_dp_44"
                        android:layout_height="?attr/larus_dp_56"
                        android:paddingStart="?attr/larus_dp_0"
                        android:paddingEnd="?attr/larus_dp_12">
                        <ImageView
                            android:id="@+id/iv_action_menu_entrance"
                            android:layout_width="?attr/larus_dp_32"
                            android:layout_height="?attr/larus_dp_56"/>
                    </FrameLayout>
                    <ImageView
                        android:id="@+id/action_break"
                        android:visibility="gone"
                        android:layout_width="?attr/larus_dp_44"
                        android:layout_height="?attr/larus_dp_56"
                        android:paddingStart="?attr/larus_dp_0"
                        android:paddingEnd="?attr/larus_dp_12"/>
                </FrameLayout>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/action_entrance"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_56"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/action_entrance_iv"
                    android:layout_width="?attr/larus_dp_32"
                    android:layout_height="?attr/larus_dp_32"/>
                <TextView
                    android:textSize="?attr/larus_sp_8"
                    android:textColor="@color/larus_static_white"
                    android:gravity="center"
                    android:layout_gravity="end|top"
                    android:id="@+id/action_entrance_red_dot"
                    android:background="@drawable/larus_red_dot_bg_large"
                    android:layout_width="?attr/larus_dp_8"
                    android:layout_height="?attr/larus_dp_8"
                    android:layout_marginTop="?attr/larus_dp_2"
                    android:layout_marginEnd="?attr/larus_dp_4"/>
            </FrameLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/action_speech"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_32"
                android:layout_height="?attr/larus_dp_56"
                android:layout_marginStart="?attr/larus_dp_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/action_entrance"
                app:layout_goneMarginStart="?attr/larus_dp_12"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/divider_input_area_below"
            android:background="?attr/larus_neutral_transparent_2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1px"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/input_area"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/voice_input_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="parent"/>
</merge>
