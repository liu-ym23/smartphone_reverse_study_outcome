<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.widgets.universedesign.SpaceLoadingImage
        android:layout_gravity="center"
        android:id="@+id/digit_refresh_progress"
        android:layout_width="@dimen/space_kit_len_20"
        android:layout_height="@dimen/space_kit_len_20"
        app:loading_circle_color="@color/primary_pri_500"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/text_placeholder"
        android:layout_gravity="center"
        android:id="@+id/digit_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
