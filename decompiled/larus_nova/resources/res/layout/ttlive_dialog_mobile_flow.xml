<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#80000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/content_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="19dp"
            android:textStyle="bold"
            android:textColor="#e6ffffff"
            android:id="@+id/ttlive_dialog_flow_des"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_live_flow_text_des"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="19dp"
            android:textStyle="bold"
            android:textColor="#e6ffffff"
            android:id="@+id/ttlive_dialog_flow_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_live_flow_tip"
            android:layout_below="@+id/ttlive_dialog_flow_des"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textStyle="bold"
            android:textColor="#e6ffffff"
            android:gravity="center"
            android:id="@+id/ttlive_flow_ok"
            android:background="@drawable/ttlive_flow_know_bg"
            android:layout_width="240dp"
            android:layout_height="44dp"
            android:layout_marginTop="28dp"
            android:text="@string/ttlive_I_know"
            android:layout_below="@+id/ttlive_dialog_flow_tip"
            android:layout_centerHorizontal="true"/>
        <RelativeLayout
            android:gravity="center"
            android:id="@+id/ttlive_buy_flow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_below="@+id/ttlive_flow_ok">
            <TextView
                android:textSize="13dp"
                android:textColor="#ffffff"
                android:id="@+id/ttlive_buy_flow_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_go_to_buy_flow"
                android:layout_centerVertical="true"/>
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginLeft="2dp"
                android:src="@drawable/ttlive_ic_flow_arrow"
                android:layout_toRightOf="@+id/ttlive_buy_flow_text"
                android:layout_centerVertical="true"
                android:layout_marginStart="2dp"
                android:layout_toEndOf="@+id/ttlive_buy_flow_text"/>
        </RelativeLayout>
    </RelativeLayout>
</FrameLayout>
