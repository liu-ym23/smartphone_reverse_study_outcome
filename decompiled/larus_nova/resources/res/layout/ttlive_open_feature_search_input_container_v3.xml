<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/live_open_platform_anchor_search_height">
    <RelativeLayout
        android:background="@drawable/ttlive_bg_anchor_search_cell_new"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toLeftOf="@+id/cancel_search"
        android:layout_toStartOf="@+id/cancel_search">
        <ImageView
            android:id="@+id/search_glass"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="4dp"
            android:src="@drawable/ttlive_ic_anchor_search_glass_black"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="4dp"
            android:layout_alignParentStart="true"/>
        <EditText
            android:textSize="15dp"
            android:textColor="@color/ttlive_color_161823"
            android:textColorHint="@color/ttlive_color_161823_alpha60"
            android:id="@+id/search_edit"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="21dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_toLeftOf="@+id/clear_search_input"
            android:layout_toRightOf="@+id/search_glass"
            android:layout_centerVertical="true"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:layout_toStartOf="@+id/clear_search_input"
            android:layout_toEndOf="@+id/search_glass"/>
        <ImageView
            android:id="@+id/clear_search_input"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="4dp"
            android:src="@drawable/ttlive_ic_search_delete_dark"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="4dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_color_161823"
        android:gravity="center"
        android:id="@+id/cancel_search"
        android:paddingLeft="16dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/ttlive_open_platform_search_cancel"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:paddingStart="16dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
