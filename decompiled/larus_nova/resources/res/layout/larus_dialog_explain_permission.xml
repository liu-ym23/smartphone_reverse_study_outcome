<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/larus_toast_background"
    android:paddingTop="?attr/larus_dp_16"
    android:paddingBottom="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="?attr/larus_dp_16"
    android:paddingStart="?attr/larus_dp_16"
    android:paddingEnd="?attr/larus_dp_16"
    android:layout_marginStart="?attr/larus_dp_14"
    android:layout_marginEnd="?attr/larus_dp_14"
    android:elevation="?attr/larus_dp_5">
    <TextView
        android:textSize="?attr/larus_dp_18"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/dialog_permission_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"/>
    <TextView
        android:textSize="?attr/larus_dp_16"
        android:textColor="@color/larus_neutral_70"
        android:id="@+id/dialog_permission_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"/>
</LinearLayout>
