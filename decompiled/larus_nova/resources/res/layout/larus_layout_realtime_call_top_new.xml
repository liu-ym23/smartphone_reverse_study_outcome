<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/realtime_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/larus_ic_call_setting_dark"
        android:contentDescription="@string/larus_call_accessibility_moreMenu"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/realtime_take_photo_on_left"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:src="@drawable/larus_ic_photo"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/realtime_call_name_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="?attr/larus_dp_200"
        android:layout_marginStart="?attr/larus_dp_5"
        android:layout_marginEnd="?attr/larus_dp_5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.larus.common_ui.view.NoSpaceTextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="@color/larus_static_white"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/realtime_call_name"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="?attr/larus_dp_200"
            android:maxLines="1"/>
        <com.larus.av_call.view.SceneModeButton
            android:layout_gravity="center"
            android:id="@+id/realtime_call_scene_button_top"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_38"/>
    </FrameLayout>
    <com.lynx.lottieadapter.LottieAdapterView
        android:id="@+id/realtime_call_top_status_anim"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/realtime_call_name_container"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"/>
    <ImageView
        android:id="@+id/switchCamera"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/larus_ic_call_switch_camera"
        android:contentDescription="switch camera"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/realtime_call_subtitle_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="8dp"/>
    <ImageView
        android:id="@+id/flashlightIcon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/larus_ic_light_switch"
        android:contentDescription="@string/larus_accessibility_icon_flashOff"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/switchCamera"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.common_ui.widget.roundlayout.CustomRoundImageView
        android:id="@+id/realtime_call_subtitle_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/larus_ic_call_subtitle_cn_dark"
        android:contentDescription="@string/larus_call_accessibility_showCaptions"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
