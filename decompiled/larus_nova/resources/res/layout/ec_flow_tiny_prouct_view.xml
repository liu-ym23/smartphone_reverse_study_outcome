<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_flow_product_rootview"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.ec.core.widget.RoundedFrameLayout
        android:id="@+id/tiny_product_img_container"
        android:layout_width="114dp"
        android:layout_height="114dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rounded_radius="6dp">
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:id="@+id/tiny_product_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutMode="square"
            app:placeholderImage="@drawable/commerce_promotion_place_holder"
            app:placeholderImageScaleType="centerCrop"/>
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/tiny_product_sold_out_tag"
            android:background="#70000000"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="20dp">
            <TextView
                android:textSize="13dp"
                android:textColor="#ffffff"
                android:layout_gravity="center"
                android:id="@+id/tiny_product_sold_out_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/commerce_sold_out"/>
        </FrameLayout>
    </com.bytedance.android.ec.core.widget.RoundedFrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintLeft_toRightOf="@+id/tiny_product_img_container"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tiny_product_img_container">
        <com.bytedance.android.shopping.product.flow.view.info.ProductFlowCardTitleView
            android:id="@+id/tiny_product_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.bytedance.android.shopping.feed.widget.SellPointView
            android:id="@+id/tiny_product_sell_point_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"/>
        <com.bytedance.android.shopping.anchorv3.detail.widget.InflowFeedServiceView
            android:id="@+id/tiny_product_service_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#161823"
            android:id="@+id/tiny_product_sell_info_tv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:alpha="0.34"/>
    </LinearLayout>
    <com.bytedance.android.shopping.feed.widget.TinyCardPriceView
        android:id="@+id/tiny_product_price_and_sales"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tiny_product_img_container"
        app:layout_constraintLeft_toRightOf="@+id/tiny_product_img_container"/>
    <com.bytedance.android.shopping.product.flow.view.bottom.ProductFlowCardBuyButton
        android:id="@+id/tiny_product_buy_button"
        android:layout_width="59dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <include
        android:id="@+id/tiny_skeleton_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/tiny_product_img_container"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/ec_flow_tiny_card_skeleton_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
