<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="top|right"
        android:background="#99000000"
        android:padding="10dp"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="150dp">
        <TextView
            android:textColor="@color/white"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SEI稳定性调试信息"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <Button
            android:id="@+id/btn_mock_update"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="mock更新"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <TextView
            android:textColor="@color/white"
            android:id="@+id/tv_mock_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:text="MockState: "
            app:layout_constraintBottom_toBottomOf="@+id/btn_mock_update"
            app:layout_constraintLeft_toRightOf="@+id/btn_mock_update"
            app:layout_constraintTop_toTopOf="@+id/btn_mock_update"/>
        <TextView
            android:textColor="@color/white"
            android:id="@+id/tv_cdn_pts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="cdn_pts:"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_mock_update"/>
        <TextView
            android:textColor="@color/white"
            android:id="@+id/tv_cdn_sei_index"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="cdn_sei_index:"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_cdn_pts"/>
        <TextView
            android:textColor="@color/white"
            android:id="@+id/tv_backup_msg_hit_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="backup_msg_hit_rate:"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_cdn_sei_index"/>
        <TextView
            android:textColor="@color/white"
            android:id="@+id/tv_pts_diff_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="cdn-sei ptsDiff:"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_backup_msg_hit_rate"/>
        <TextView
            android:textColor="@color/white"
            android:id="@+id/tv_pts_diff_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="cdn-backup ptsDiff:"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_pts_diff_1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
