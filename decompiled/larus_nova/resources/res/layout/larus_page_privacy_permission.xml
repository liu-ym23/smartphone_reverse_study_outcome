<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/larus_page_privacy_permission_2013255662"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/privacy_title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"/>
    <ScrollView
        android:id="@+id/scroll_view"
        android:paddingBottom="?attr/larus_dp_16"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/container_layout"
            android:paddingLeft="?attr/larus_dp_16"
            android:paddingRight="?attr/larus_dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/data_permissions_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/larus_neutral_50"
                    android:id="@+id/data_permissions_title"
                    android:paddingLeft="?attr/larus_dp_4"
                    android:paddingRight="?attr/larus_dp_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="?attr/larus_dp_8"
                    android:text="@string/larus_privacySettings_menuTitle_data"/>
                <com.larus.bmhome.view.item.ItemGroup
                    android:id="@+id/data_permissions_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/allow_training_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:larus_image_height="?attr/larus_dp_32"
                        app:larus_image_src="@drawable/larus_ic_privacy_model_train_small"
                        app:larus_image_width="?attr/larus_dp_32"/>
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/voice_improvement_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_privacySettings_dataMenuOption_speech"
                        app:larus_image_height="?attr/larus_dp_32"
                        app:larus_image_src="@drawable/larus_icon_tts_speaker"
                        app:larus_image_width="?attr/larus_dp_32"/>
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/noise_reduction_item"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_privacySetting_bottomsheet_title_voiceFocus"
                        app:larus_image_height="?attr/larus_dp_32"
                        app:larus_image_src="@drawable/larus_ic_privacy_noise_reduction"
                        app:larus_image_width="?attr/larus_dp_32"/>
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/face_memory_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_facemem_popup_auth_title_cn"
                        app:larus_image_height="?attr/larus_dp_32"
                        app:larus_image_src="@drawable/larus_ic_privacy_face_recognition"
                        app:larus_image_width="?attr/larus_dp_32"/>
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/personalized_content_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_switch_button_copywriting"
                        app:larus_image_height="?attr/larus_dp_32"
                        app:larus_image_src="@drawable/larus_ic_privacy_recommendations"
                        app:larus_image_width="?attr/larus_dp_32"/>
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/picture_location_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_photoLocation_accountSettings_toggle_locationAllow"
                        app:larus_image_height="?attr/larus_dp_32"
                        app:larus_image_src="@drawable/larus_ic_privacy_photo_location"
                        app:larus_image_width="?attr/larus_dp_32"/>
                </com.larus.bmhome.view.item.ItemGroup>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/contact_permissions_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/larus_neutral_50"
                    android:id="@+id/contact_permissions_title"
                    android:paddingLeft="?attr/larus_dp_4"
                    android:paddingRight="?attr/larus_dp_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="?attr/larus_dp_8"
                    android:text="@string/larus_settings_permission_contact_sectionTitle"/>
                <com.larus.bmhome.view.item.ItemGroup
                    android:id="@+id/contact_permissions_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/find_my_way"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_settings_permission_contact_findMe"
                        app:larus_image_height="?attr/larus_dp_32"
                        app:larus_image_src="@drawable/larus_icon_find_my_way"
                        app:larus_image_width="?attr/larus_dp_32"/>
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/add_my_way"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_settings_permission_contact_addMe"
                        app:larus_image_height="?attr/larus_dp_32"
                        app:larus_image_src="@drawable/larus_icon_add_my_way"
                        app:larus_image_width="?attr/larus_dp_32"/>
                </com.larus.bmhome.view.item.ItemGroup>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/system_permissions_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_24">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/larus_neutral_50"
                    android:id="@+id/system_permissions_title"
                    android:paddingLeft="?attr/larus_dp_4"
                    android:paddingRight="?attr/larus_dp_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="?attr/larus_dp_8"
                    android:text="@string/larus_privacySettings_menuTitle_system"/>
                <com.larus.bmhome.view.item.ItemGroup
                    android:id="@+id/system_permissions_group"
                    android:background="@drawable/larus_bg_setting_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/microphone_permission_item"
                        android:background="@drawable/larus_bg_item_selector_first"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_systemPrivacySetting_menuOption_microphone"
                        app:larus_image_height="?attr/larus_dp_32"
                        app:larus_image_src="@drawable/larus_ic_privacy_microphone_permission"
                        app:larus_image_width="?attr/larus_dp_32"
                        app:larus_sub_text="@string/larus_privacySetting_bottomsheet_btn_microphone"/>
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/camera_permission_item"
                        android:background="@drawable/larus_bg_item_selector_middle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_systemPrivacySetting_menuOption_camara"
                        app:larus_image_height="?attr/larus_dp_32"
                        app:larus_image_src="@drawable/larus_ic_privacy_camera_permission"
                        app:larus_image_width="?attr/larus_dp_32"
                        app:larus_sub_text="@string/larus_privacySetting_bottomsheet_btn_camera"/>
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/photo_permission_item"
                        android:background="@drawable/larus_bg_item_selector_middle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_systemPrivacySetting_menuOption_photos"
                        app:larus_image_height="?attr/larus_dp_32"
                        app:larus_image_src="@drawable/larus_ic_privacy_gallery_permission"
                        app:larus_image_width="?attr/larus_dp_32"
                        app:larus_sub_text="@string/larus_privacySetting_bottomsheet_btn_photo"/>
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/location_permission_item"
                        android:background="@drawable/larus_bg_item_selector_middle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_systemPrivacySetting_menuOption_location"
                        app:larus_image_height="?attr/larus_dp_32"
                        app:larus_image_src="@drawable/larus_ic_privacy_location_permission"
                        app:larus_image_width="?attr/larus_dp_32"
                        app:larus_sub_text="@string/larus_privacySetting_bottomsheet_btn_location"/>
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/push_permission_item"
                        android:background="@drawable/larus_bg_item_selector_middle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_systemPrivacySetting_menuOption_notif"
                        app:larus_image_height="?attr/larus_dp_32"
                        app:larus_image_src="@drawable/larus_ic_privacy_push_notification_permission"
                        app:larus_image_width="?attr/larus_dp_32"
                        app:larus_sub_text="@string/larus_privacySetting_bottomsheet_btn_notif"/>
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/cutting_permission_item"
                        android:background="@drawable/larus_bg_item_selector_middle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_systemPrivacySetting_menuOption_copy"
                        app:larus_image_height="?attr/larus_dp_32"
                        app:larus_image_src="@drawable/larus_ic_privacy_clipboard_permission"
                        app:larus_image_width="?attr/larus_dp_32"
                        app:larus_sub_text="@string/larus_privacySetting_bottomsheet_btn_copy"/>
                    <ViewStub
                        android:id="@+id/obric_system_permission_items_stub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/more_permission_item"
                        android:background="@drawable/larus_bg_item_selector_last"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_systemPrivacySetting_menuOption_more"
                        app:larus_image_height="?attr/larus_dp_32"
                        app:larus_image_src="@drawable/larus_ic_privacy_more_permission"
                        app:larus_image_width="?attr/larus_dp_32"
                        app:larus_sub_text="@string/larus_privacySetting_bottomsheet_btn_other"/>
                </com.larus.bmhome.view.item.ItemGroup>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/authorization_management_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_24">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/larus_neutral_50"
                    android:id="@+id/authorization_management_title"
                    android:paddingLeft="?attr/larus_dp_4"
                    android:paddingRight="?attr/larus_dp_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="?attr/larus_dp_8"
                    android:text="@string/larus_appEntry_privacyAccess_header_app"/>
                <com.larus.bmhome.view.item.ItemGroup
                    android:id="@+id/authorization_management_group"
                    android:background="@drawable/larus_bg_setting_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/authorization_management_item"
                        android:background="@drawable/larus_bg_item_selector_first"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_appEntry_privacyAccess_menu_appAccess"
                        app:larus_image_height="?attr/larus_dp_32"
                        app:larus_image_src="@drawable/larus_ic_authorization_management"
                        app:larus_image_width="?attr/larus_dp_32"
                        app:larus_sub_text="@string/larus_privacySetting_bottomsheet_btn_microphone"/>
                </com.larus.bmhome.view.item.ItemGroup>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/other_permissions_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_24"
                android:layout_marginBottom="@dimen/dp_16">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/larus_neutral_50"
                    android:id="@+id/other_permissions_title"
                    android:paddingLeft="?attr/larus_dp_4"
                    android:paddingRight="?attr/larus_dp_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="?attr/larus_dp_8"
                    android:text="@string/larus_privacySettings_menuTitle_other"/>
                <androidx.cardview.widget.CardView
                    android:id="@+id/other_permissions_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/dp_12"
                    app:cardElevation="0dp">
                    <com.larus.bmhome.view.item.ItemTextArrow
                        android:id="@+id/block_setting"
                        android:background="@drawable/larus_bg_item_selector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/larus_blocked_account"
                        app:larus_image_height="?attr/larus_dp_32"
                        app:larus_image_src="@drawable/larus_ic_privacy_blacklist"
                        app:larus_image_width="?attr/larus_dp_32"/>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
