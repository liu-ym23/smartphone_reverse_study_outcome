<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/music_cover"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginRight="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:placeholderImage="@drawable/ttlive_bg_ktv_stub"
        app:placeholderImageScaleType="fitXY"
        app:roundedCornerRadius="4dp"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/music_duration"
        android:background="@drawable/ttlive_bg_music_duration"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/music_cover"
        app:layout_constraintLeft_toLeftOf="@+id/music_cover"
        app:layout_constraintRight_toRightOf="@+id/music_cover"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/music_audition"
        android:background="@color/ttlive_ktv_music_audition_bg"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginRight="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_ic_music_audition_playing"
        app:placeholderImageScaleType="centerInside"
        app:roundedCornerRadius="4dp"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#cdffffff"
        android:ellipsize="end"
        android:id="@+id/music_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:maxWidth="175dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/music_author"
        app:layout_constraintStart_toEndOf="@+id/music_cover"
        app:layout_constraintTop_toTopOf="@+id/music_cover"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#80ffffff"
        android:ellipsize="end"
        android:id="@+id/music_author"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="4dp"
        android:maxWidth="130dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/music_cover"
        app:layout_constraintStart_toEndOf="@+id/music_cover"
        app:layout_constraintTop_toBottomOf="@+id/music_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
