<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/close_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/content_ll"
        android:background="#ffffff"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="484dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/title_container"
            android:layout_width="match_parent"
            android:layout_height="52dp">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:gravity="center"
                android:id="@+id/ktv_feedback_title"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:text="@string/ttlive_ktv_music_feedback_dialog_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/ktv_feedback_dialog_back"
                android:background="@drawable/ttlive_ktv_panel_left_back_light"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginLeft="8dp"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/ktv_feedback_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/ktv_feedback_title"/>
            <View
                android:id="@+id/driver"
                android:background="#f1f1f2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ScrollView
            android:id="@+id/main_content_sv"
            android:layout_width="match_parent"
            android:layout_height="354dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ktv_feedback_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/music_name_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#000000"
                            android:id="@+id/music_name_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/ttlive_ktv_music_feedback_dialog_music_name"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <View
                            android:background="@drawable/ttlive_ic_ktv_music_feedback_must"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginLeft="4dp"
                            android:layout_marginStart="4dp"
                            app:layout_constraintBottom_toBottomOf="@+id/music_name_title"
                            app:layout_constraintStart_toEndOf="@+id/music_name_title"
                            app:layout_constraintTop_toTopOf="@+id/music_name_title"/>
                        <EditText
                            android:textSize="15sp"
                            android:textColor="#000000"
                            android:textColorHint="#898a8f"
                            android:id="@+id/music_name"
                            android:background="@color/transparent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:minHeight="21dp"
                            android:hint="@string/ttlive_ktv_music_feedback_dialog_music_name_hint"
                            android:maxLength="150"
                            android:textCursorDrawable="@drawable/ttlive_bg_ktv_edit_cursor"
                            app:layout_constraintStart_toStartOf="@+id/music_name_title"
                            app:layout_constraintTop_toBottomOf="@+id/music_name_title"/>
                        <View
                            android:id="@+id/music_name_driver"
                            android:background="#e7e7e8"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="8dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/music_name"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/music_singer_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/music_name_container">
                        <TextView
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#000000"
                            android:id="@+id/music_singer_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/ttlive_ktv_music_feedback_dialog_singer_name"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <EditText
                            android:textSize="15sp"
                            android:textColor="#000000"
                            android:textColorHint="#898a8f"
                            android:id="@+id/music_singer"
                            android:background="@color/transparent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:minHeight="21dp"
                            android:hint="@string/ttlive_ktv_music_feedback_dialog_singer_name_hint"
                            android:maxLength="150"
                            android:textCursorDrawable="@drawable/ttlive_bg_ktv_edit_cursor"
                            app:layout_constraintStart_toStartOf="@+id/music_singer_title"
                            app:layout_constraintTop_toBottomOf="@+id/music_singer_title"/>
                        <View
                            android:id="@+id/music_singer_driver"
                            android:background="#e7e7e8"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="8dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/music_singer"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.bytedance.android.live.ktv.common.ordersong.feedback.KtvFeedbackComponentView
                    android:id="@+id/feedback_categories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:title="@string/ttlive_ktv_music_feedback_dialog_issue_select_title"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp">
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ttlive_ktv_music_feedback_dialog_issue_detail"/>
                    <EditText
                        android:textSize="15sp"
                        android:textColor="#000000"
                        android:textColorHint="#7c7d83"
                        android:gravity="top"
                        android:id="@+id/issue_detail"
                        android:background="@drawable/ttlive_bg_ktv_music_feedback_edit_light"
                        android:paddingLeft="8dp"
                        android:paddingTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="65dp"
                        android:layout_marginTop="8dp"
                        android:hint="@string/ttlive_ktv_music_feedback_dialog_issue_detail_hint"
                        android:maxLength="1000"
                        android:textCursorDrawable="@drawable/ttlive_bg_ktv_edit_cursor"
                        android:paddingStart="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/ktv_music_feedback_submit"
                android:background="@drawable/ttlive_bg_ktv_bt"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="32dp"
                android:text="@string/ttlive_submit_text"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</FrameLayout>
