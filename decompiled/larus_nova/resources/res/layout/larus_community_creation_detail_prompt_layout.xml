<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_16"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/caption_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_15"
        android:textColor="@color/larus_neutral_50"
        android:ellipsize="end"
        android:id="@+id/prompt_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:lineSpacingExtra="?attr/larus_dp_1_5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/caption_text"/>
    <androidx.recyclerview.widget.RecyclerView
        android:gravity="start"
        android:id="@+id/rv_ref_images"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/prompt_text"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_13"
        android:textColor="@color/larus_neutral_50"
        android:id="@+id/use_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_ref_images"/>
    <com.larus.community.impl.detail.bottomtools.CreationDetailBottomToolsView
        android:id="@+id/prompt_tools_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/use_count"/>
    <View
        android:id="@+id/divider"
        android:background="@color/larus_neutral_transparent_2"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_1"
        android:layout_marginTop="?attr/larus_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/prompt_tools_view"/>
</merge>
