<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@drawable/bg_ttlive_dialog_round"
    android:padding="16dp"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="24dp"
        android:text=""/>
    <TextView
        android:textSize="14dp"
        android:textColor="#6b6f76"
        android:gravity="center"
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""/>
    <View
        android:id="@+id/divider"
        android:background="@drawable/divider_solid_horizontal"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="20dp"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/btn_confirm"
        android:paddingTop="13.5dp"
        android:paddingBottom="13.5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="回到个播"/>
</LinearLayout>
