<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="?attr/larus_dp_8"
    android:paddingBottom="?attr/larus_dp_8"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="?attr/larus_dp_0"
    android:layout_height="wrap_content"
    android:layout_weight="1">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/calendar_day_cell"
        android:layout_width="?attr/larus_dp_48"
        android:layout_height="?attr/larus_dp_48">
        <FrameLayout
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/day_emoji"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"/>
            <View
                android:layout_gravity="center"
                android:id="@+id/day_empty_ball"
                android:background="@drawable/dora_o_bg_calendar_ball_past"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_22"
                android:layout_height="?attr/larus_dp_22"/>
        </FrameLayout>
        <TextView
            android:textSize="?attr/larus_sp_12"
            android:textColor="@color/dora_o_text_primary"
            android:gravity="center"
            android:id="@+id/day_text"
            android:layout_width="?attr/larus_dp_40"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</FrameLayout>
