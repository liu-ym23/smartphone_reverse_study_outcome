<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="149dp">
    <TextView
        android:textSize="13dp"
        android:textColor="#ffffff"
        android:id="@+id/area_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/ttlive_enhance_share_area_title"
        android:textAlignment="center"
        android:layout_marginStart="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/area_content_rv"
        android:fadingEdge="horizontal"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginTop="12dp"
        android:requiresFadingEdge="horizontal"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/ext_panel_share_behavior"
        app:layout_constraintTop_toBottomOf="@+id/area_title"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ext_panel_share_behavior"
        android:visibility="invisible"
        android:layout_width="70dp"
        android:layout_height="72dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/area_content_rv">
        <View
            android:background="@drawable/ttlive_enhance_share_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/ttlive_new_profile_90white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/ext_share_title"
            android:layout_width="match_parent"
            android:layout_height="15dp"
            android:layout_marginTop="7dp"
            android:text="@string/ttlive_more_share_to_more_share_dialog"
            android:maxLines="1"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </LinearLayout>
    <com.bytedance.android.livesdk.chatroom.ui.DouyinLoadingLayout
        android:id="@+id/ext_share_panel_loading_view"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        app:layout_constraintTop_toTopOf="@+id/area_content_rv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
