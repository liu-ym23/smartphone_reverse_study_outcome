<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.livesdk.livecommerce.promotion.cardV2.widget.ECPromotionImageView
        android:id="@+id/piv_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.livesdk.livecommerce.view.roundcorner.ECPromotionTopTagLinearlayout
        android:orientation="horizontal"
        android:id="@+id/top_left_tag_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="noHideDescendants">
        <TextView
            android:textSize="11sp"
            android:textColor="@color/shopping_std_text_white_1"
            android:gravity="center"
            android:id="@+id/tv_promotion_index"
            android:background="@color/shopping_color_73161823"
            android:layout_width="26dp"
            android:layout_height="20dp"
            android:maxLines="1"
            android:includeFontPadding="false"/>
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:id="@+id/iv_status_tag"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            app:layoutMode="width_self_adjust"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/status_fold_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
                android:id="@+id/status_fold_bg"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toBottomOf="@+id/status_fold_ll"
                app:layout_constraintEnd_toEndOf="@+id/status_fold_ll"
                app:layout_constraintStart_toStartOf="@+id/status_fold_ll"
                app:layout_constraintTop_toTopOf="@+id/status_fold_ll"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/status_fold_ll"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
                    android:id="@+id/status_fold_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/shopping_std_text_white_1"
                    android:gravity="center_vertical"
                    android:id="@+id/status_fold_text"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:maxLines="1"
                    android:paddingEnd="8dp"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.bytedance.android.livesdk.livecommerce.view.roundcorner.ECPromotionTopTagLinearlayout>
    <com.bytedance.android.ec.core.widget.ECHotAtmosphereView
        android:id="@+id/layout_hot_atmosphere"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="noHideDescendants"
        android:layout_marginStart="-8dp"/>
    <ViewStub
        android:id="@+id/layout_hot_atmosphere_auction_stub"
        android:visibility="gone"
        android:layout="@layout/shopping_view_stub_layout_auction_hot_atmosphere"
        android:inflatedId="@+id/layout_hot_atmosphere_auction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="-8dp"/>
    <androidx.cardview.widget.CardView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/tv_explain_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginBottom="8dp">
        <LinearLayout
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="60dp"
            android:paddingStart="9.5dp"
            android:paddingEnd="9.5dp">
            <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
                android:id="@+id/tv_explain_left_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginRight="2dp"
                android:layout_marginEnd="2dp"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/commerce_color_BF161823"
                android:gravity="center"
                android:id="@+id/tv_explain_end"
                android:paddingBottom="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ec_promotion_list_tip_look_explain"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"/>
            <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
                android:id="@+id/tv_explain_right_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginLeft="2dp"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</merge>
