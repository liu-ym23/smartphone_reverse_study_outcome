<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_kit_len_5"
    android:layout_marginBottom="@dimen/space_kit_len_5"
    android:layout_marginStart="@dimen/space_kit_len_2"
    android:layout_marginEnd="@dimen/space_kit_len_2">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cell_item"
        android:background="@drawable/bitable_card_field_item_bg_normal"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/space_kit_len_24"
        android:paddingStart="@dimen/space_kit_len_6"
        android:paddingEnd="@dimen/space_kit_len_6">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icon_done"
            android:visibility="gone"
            android:layout_width="@dimen/space_kit_len_10"
            android:layout_height="@dimen/space_kit_len_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/icon_ring"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ud_icon_list_check_bold_outlined"
            app:tint="@color/static_white"/>
        <com.bytedance.ee.bear.bitable.common.widgets.common.RingView
            android:id="@+id/icon_ring"
            android:padding="@dimen/space_kit_len_2"
            android:visibility="visible"
            android:layout_width="@dimen/space_kit_len_10"
            android:layout_height="@dimen/space_kit_len_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/icon_done"
            app:layout_constraintRight_toLeftOf="@+id/tv_name"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_title"
            android:ellipsize="end"
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="@dimen/space_kit_len_4"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/icon_ring"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
