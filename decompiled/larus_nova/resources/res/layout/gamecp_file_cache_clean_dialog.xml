<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/cl_dialog_parent"
    android:background="@drawable/gamecp_shape_file_cache_dialog_bg"
    android:paddingTop="12dp"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_file_cache_dialog_tip_icon"
        android:visibility="gone"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/gamecp_icon_file_cache_tips"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_file_cache_dialog_close_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/gamecp_icon_file_cache_clean_close"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/gamecp_game_161823"
        android:id="@+id/tv_file_cache_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/gamecp_file_cache_clean_dialog_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_file_cache_dialog_tip_icon"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/gamecp_game_64666B"
        android:id="@+id/tv_file_cache_dialog_storage_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/gamecp_file_cache_clean_dialog_storage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_file_cache_dialog_title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_file_cache_dialog_pkg_container"
        android:background="@drawable/gamecp_shape_file_cache_clean_btn_bg"
        android:paddingTop="17dp"
        android:paddingBottom="17dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_file_cache_dialog_storage_size">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/gamecp_game_161823"
            android:id="@+id/tv_file_clean_install_pkg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gamecp_file_cache_clean_dialog_pkg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/gamecp_game_323335"
            android:id="@+id/tv_file_clean_install_pkg_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="120MB"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_file_clean_install_pkg"
            app:layout_constraintStart_toEndOf="@+id/tv_file_clean_install_pkg"
            app:layout_constraintTop_toTopOf="@+id/tv_file_clean_install_pkg"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/gamecp_game_64666B"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gamecp_file_cache_clean_dialog_pkg_tip"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_file_clean_install_pkg"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="@color/gamecp_game_161823"
            android:gravity="center"
            android:id="@+id/tv_file_clean_delete_pkg"
            android:background="@drawable/gamecp_file_clean_delete_btn_bg"
            android:layout_width="54dp"
            android:layout_height="24dp"
            android:text="@string/gamecp_file_cache_clean_dialog_pkg_delete"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ProgressBar
            android:id="@+id/tv_file_clean_delete_pkg_progress"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:indeterminateDrawable="@drawable/gamecp_progress_circle_shape"
            app:layout_constraintBottom_toBottomOf="@+id/tv_file_clean_delete_pkg"
            app:layout_constraintEnd_toEndOf="@+id/tv_file_clean_delete_pkg"
            app:layout_constraintStart_toStartOf="@+id/tv_file_clean_delete_pkg"
            app:layout_constraintTop_toTopOf="@+id/tv_file_clean_delete_pkg"
            style="?android:attr/progressBarStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_file_cache_dialog_btn_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_file_cache_dialog_pkg_container">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/gamecp_game_161823"
            android:gravity="center"
            android:id="@+id/tv_file_clean_cancel"
            android:background="@drawable/gamecp_shape_file_cache_clean_btn_bg"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:text="@string/ttlive_game_promote_prop_account_input_cancel"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/tv_file_clean_confirm"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/gamecp_game_FFFFFF"
            android:gravity="center"
            android:id="@+id/tv_file_clean_confirm"
            android:background="@drawable/gamecp_shape_file_clean_confirm_bg"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:text="@string/gamecp_file_cache_clean_dialog_open_setting"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toRightOf="@+id/tv_file_clean_cancel"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_file_clean_bottom_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_file_cache_dialog_btn_container">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/gamecp_game_99161823"
            android:id="@+id/tv_file_clean_space_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gamecp_file_cache_clean_dialog_space2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_file_clean_space_tip_btn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/gamecp_game_04498D"
            android:id="@+id/tv_file_clean_space_tip_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gamecp_file_cache_clean_dialog_go"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_file_clean_space_tip"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
