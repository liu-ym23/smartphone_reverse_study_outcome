<?xml version="1.0" encoding="utf-8"?>
<com.ss.android.lark.todo.impl.features.chatlist.recyclerView.PerfLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_body"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larksuite.component.blockit.hashtag.widget.SwipeLayout
        android:id="@+id/swipeLayout"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:drag_edge="right|left">
        <LinearLayout
            android:layout_gravity="left"
            android:orientation="horizontal"
            android:id="@+id/behind_left_view"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:foregroundGravity="center"/>
        <LinearLayout
            android:layout_gravity="right"
            android:orientation="horizontal"
            android:id="@+id/behind_right_view"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:foregroundGravity="center"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/container_view"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:paddingTop="17sp"
                android:paddingBottom="17sp"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center"
                    android:id="@+id/complete_checkbox_container"
                    android:clipChildren="false"
                    android:layout_width="40sp"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/complete_checkbox"
                        android:layout_width="22sp"
                        android:layout_height="22sp"
                        app:srcCompat="@drawable/todo_svg_icon_uncheck_new"/>
                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/complete_checkbox_lottie"
                        android:visibility="gone"
                        android:layout_width="33sp"
                        android:layout_height="33sp"
                        app:lottie_autoPlay="false"
                        app:lottie_loop="true"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:clipChildren="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/sp_16"
                            android:ellipsize="end"
                            android:id="@+id/title_rich_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:layout_toStartOf="@+id/avatar_container"/>
                        <LinearLayout
                            android:id="@+id/avatar_container"
                            android:paddingRight="@dimen/dp_16"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentTop="true"
                            android:paddingStart="@dimen/dp_16"
                            android:layout_alignParentEnd="true">
                            <com.ss.android.lark.todo.impl.features.common.widget.TaskUDAvatarList
                                android:id="@+id/task_owners"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:task_ud_avatarList_avatarSize="28sp"
                                app:task_ud_avatarList_maxCount="1"
                                app:task_ud_avatarList_overlapSize="4sp"
                                app:task_ud_avatarList_text_size="14sp"/>
                        </LinearLayout>
                    </RelativeLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/time_icon_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        android:layout_marginEnd="@dimen/dp_16">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@+id/time_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:textSize="@dimen/sp_14"
                                android:textColor="@color/text_caption"
                                android:ellipsize="end"
                                android:id="@+id/time_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:singleLine="true"
                                android:layout_weight="1"/>
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/remind_icon"
                                android:layout_width="19sp"
                                android:layout_height="14sp"
                                android:paddingStart="@dimen/dp_7"
                                app:srcCompat="@drawable/ud_icon_bell_outlined"/>
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/repeat_icon"
                                android:layout_width="19sp"
                                android:layout_height="14sp"
                                android:paddingStart="@dimen/dp_7"
                                app:srcCompat="@drawable/ud_icon_repeat_outlined"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/second_icon_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/third_icon_container"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_5"
                        android:layout_marginEnd="@dimen/dp_16"/>
                </LinearLayout>
            </LinearLayout>
            <View
                android:id="@+id/divider_todo_item"
                android:background="@color/line_divider_default"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:paddingStart="@dimen/dp_44"/>
        </LinearLayout>
    </com.larksuite.component.blockit.hashtag.widget.SwipeLayout>
</com.ss.android.lark.todo.impl.features.chatlist.recyclerView.PerfLinearLayout>
