<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/head_bar_root"
    android:background="@color/order_list_F5F6F9"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/search_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/search_bar_iv_back"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/order_list_icon_back_black"
            android:paddingStart="13dp"
            android:paddingEnd="7dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/search_bar_head_img"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:src="@drawable/order_list_head_bar_for_list"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/search_bar_iv_back"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tab_bar_container"
        android:background="@color/order_list_F5F6F9"
        android:paddingTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintTop_toBottomOf="@+id/search_bar_container">
        <com.bytedance.android.ui.base.widget.round.RoundView
            android:id="@+id/tab_bar_view_start"
            android:layout_width="36dp"
            android:layout_height="18dp"
            android:layout_marginStart="16dp"
            app:bg_color="@color/order_list_0D161823"
            app:bg_cornerRadius="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="18dp"
            app:layout_constraintEnd_toStartOf="@+id/tab_bar_view_end"
            app:layout_constraintStart_toEndOf="@+id/tab_bar_view_start">
            <com.bytedance.android.ui.base.widget.round.RoundView
                android:id="@+id/tab_bar_view_1"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                app:bg_color="@color/order_list_0D161823"
                app:bg_cornerRadius="2dp"
                app:layout_constraintEnd_toStartOf="@+id/tab_bar_view_2"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.bytedance.android.ui.base.widget.round.RoundView
                android:id="@+id/tab_bar_view_2"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                app:bg_color="@color/order_list_0D161823"
                app:bg_cornerRadius="2dp"
                app:layout_constraintEnd_toStartOf="@+id/tab_bar_view_3"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tab_bar_view_1"/>
            <com.bytedance.android.ui.base.widget.round.RoundView
                android:id="@+id/tab_bar_view_3"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                app:bg_color="@color/order_list_0D161823"
                app:bg_cornerRadius="2dp"
                app:layout_constraintEnd_toStartOf="@+id/tab_bar_view_4"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tab_bar_view_2"/>
            <com.bytedance.android.ui.base.widget.round.RoundView
                android:id="@+id/tab_bar_view_4"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                app:bg_color="@color/order_list_0D161823"
                app:bg_cornerRadius="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tab_bar_view_3"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.bytedance.android.ui.base.widget.round.RoundView
            android:id="@+id/tab_bar_view_end"
            android:layout_width="36dp"
            android:layout_height="18dp"
            android:layout_marginEnd="16dp"
            app:bg_color="@color/order_list_0D161823"
            app:bg_cornerRadius="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
