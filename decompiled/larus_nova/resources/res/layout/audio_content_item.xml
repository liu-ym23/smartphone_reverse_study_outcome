<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/bubble_space"
        android:layout_width="140dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bubble_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/red_dot"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/red_dot"
        android:layout_width="9dp"
        android:layout_height="6dp"
        android:scaleType="fitXY"
        android:paddingStart="3dp"
        android:paddingEnd="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/common_radius6dp_color_c15"/>
    <androidx.legacy.widget.Space
        android:id="@+id/left_line"
        android:layout_width="12dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.legacy.widget.Space
        android:id="@+id/top_line"
        android:layout_width="0dp"
        android:layout_height="13dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/recognize_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/text_space"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/left_line"
        app:layout_constraintTop_toBottomOf="@+id/top_line">
        <com.ss.android.lark.widget.light.LKUILightTextView
            android:id="@+id/text"
            android:paddingBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.ss.android.lark.widget.light.LKUILightTextView
            android:id="@+id/rich_text"
            android:paddingBottom="12dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <androidx.legacy.widget.Space
        android:id="@+id/text_space"
        android:layout_width="14dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/recognize_container"
        app:layout_constraintEnd_toStartOf="@+id/red_dot"
        app:layout_constraintStart_toEndOf="@+id/recognize_container"
        app:layout_constraintTop_toTopOf="@+id/recognize_container"/>
    <ViewStub
        android:id="@+id/text_translation_stub"
        android:layout="@layout/audio_content_edited_text_translation"
        android:inflatedId="@+id/text_translation_stub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/text_translation_space"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/left_line"
        app:layout_constraintTop_toBottomOf="@+id/recognize_container"/>
    <androidx.legacy.widget.Space
        android:id="@+id/text_translation_space"
        android:layout_width="14dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/text_translation_stub"
        app:layout_constraintEnd_toStartOf="@+id/red_dot"
        app:layout_constraintStart_toEndOf="@+id/text_translation_stub"
        app:layout_constraintTop_toTopOf="@+id/text_translation_stub"/>
    <View
        android:id="@+id/play_cb_space"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="@+id/play_cb"
        app:layout_constraintEnd_toEndOf="@+id/bubble_bg"
        app:layout_constraintHeight_min="46dp"
        app:layout_constraintStart_toStartOf="@+id/bubble_bg"
        app:layout_constraintTop_toTopOf="@+id/play_cb"/>
    <com.suite.lark.platform.component.widget_biz_chatkeyboard.widget.PlayControlBar
        android:id="@+id/play_cb"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="@+id/bubble_bg"
        app:layout_constraintStart_toStartOf="@+id/bubble_bg"
        app:layout_constraintTop_toBottomOf="@+id/text_translation_stub"/>
    <com.ss.android.lark.widget.light.LKUILightTextView
        android:id="@+id/recognized_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/recognized_text_space"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/left_line"
        app:layout_constraintTop_toBottomOf="@+id/play_cb"/>
    <androidx.legacy.widget.Space
        android:id="@+id/recognized_text_space"
        android:layout_width="14dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/recognized_text"
        app:layout_constraintEnd_toStartOf="@+id/red_dot"
        app:layout_constraintStart_toEndOf="@+id/recognized_text"
        app:layout_constraintTop_toTopOf="@+id/recognized_text"/>
    <ViewStub
        android:id="@+id/recognized_translation_stub"
        android:layout="@layout/audio_content_recognized_text_translation"
        android:inflatedId="@+id/recognized_translation_stub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/recognized_translation_space"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/left_line"
        app:layout_constraintTop_toBottomOf="@+id/recognized_text"/>
    <androidx.legacy.widget.Space
        android:id="@+id/recognized_translation_space"
        android:layout_width="14dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/recognized_translation_stub"
        app:layout_constraintEnd_toStartOf="@+id/red_dot"
        app:layout_constraintStart_toEndOf="@+id/recognized_translation_stub"
        app:layout_constraintTop_toTopOf="@+id/recognized_translation_stub"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:textColor="@color/text_caption"
        android:id="@+id/recognized_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/Lark_Chat_AudioConvertToTextSuccess"
        android:drawablePadding="4dp"
        app:drawableStartCompat="@drawable/ic_svg_chat_audio_message_text_flag_gray_n500"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/recognized_status_space"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/left_line"
        app:layout_constraintTop_toBottomOf="@+id/recognized_translation_stub"/>
    <androidx.legacy.widget.Space
        android:id="@+id/recognized_status_space"
        android:layout_width="14dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/recognized_status"
        app:layout_constraintEnd_toStartOf="@+id/red_dot"
        app:layout_constraintStart_toEndOf="@+id/recognized_status"
        app:layout_constraintTop_toTopOf="@+id/recognized_status"/>
    <androidx.legacy.widget.Space
        android:id="@+id/bottom_line"
        android:layout_width="0dp"
        android:layout_height="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recognized_status"/>
    <View
        android:id="@+id/audio_mask"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
