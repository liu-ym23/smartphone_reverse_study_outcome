<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/uikit_default_title_bar_height">
    <com.bytedance.ies.dmt.ui.widget.DmtTextView
        android:textSize="15sp"
        android:textColor="@color/reverse_tPrimary"
        android:ellipsize="end"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/text_left"
        android:padding="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:maxWidth="100dp"
        android:maxLines="1"
        android:lineSpacingExtra="0.5dp"
        android:layout_marginStart="6dp"
        app:fontType="regular"/>
    <com.bytedance.ies.dmt.ui.widget.AutoRTLImageView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/back_btn"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/uikit_ic_titlebar_back"
        android:contentDescription="@string/back"
        style="@style/uikit_back_btn_padding"/>
    <com.bytedance.ies.dmt.ui.widget.DmtTextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:ellipsize="end"
        android:layout_gravity="center"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:lineSpacingExtra="0.5dp"
        app:fontType="bold"/>
    <com.bytedance.ies.dmt.ui.widget.DmtTextView
        android:textSize="15dp"
        android:textColor="@color/reverse_tPrimary"
        android:ellipsize="end"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/text_right"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:maxWidth="100dp"
        android:maxLines="1"
        android:lineSpacingExtra="0.5dp"
        android:layout_marginEnd="16dp"
        app:fontType="regular"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
</merge>
