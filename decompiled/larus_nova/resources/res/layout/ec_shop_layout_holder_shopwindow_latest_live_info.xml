<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingLeft="10dp"
    android:paddingTop="8dp"
    android:paddingRight="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/ec_shop_100161823"
        android:ellipsize="end"
        android:id="@+id/ec_shop_tv_hot_sale_latest_info_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ec_shop_60161823"
            android:ellipsize="end"
            android:id="@+id/ec_shop_tv_hot_sale_latest_info_msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <View
            android:id="@+id/ec_shop_tv_hot_sale_latest_info_separator"
            android:background="@color/shopping_color_1A161823"
            android:layout_width="1dp"
            android:layout_height="12dp"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="0dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ec_shop_60161823"
            android:ellipsize="end"
            android:id="@+id/ec_shop_tv_hot_sale_latest_info_watching_cnt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
</LinearLayout>
