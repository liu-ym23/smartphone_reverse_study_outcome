<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.lark.ui.CommonTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ImageView
        android:layout_gravity="center"
        android:layout_width="@dimen/dp_100"
        android:layout_height="@dimen/dp_100"
        android:layout_marginTop="@dimen/dp_100"
        app:srcCompat="@drawable/illustration_empty_neutral_no_access"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/text_title"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/Todo_List_NoPermission_EmptyTitle"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/text_caption"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/description_txt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:text="@string/Todo_List_NoPermission_EmptyDesc"
        android:layout_marginStart="@dimen/dp_34"
        android:layout_marginEnd="@dimen/dp_34"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/task_list_permission_bg_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginStart="@dimen/dp_42"
        android:layout_marginEnd="@dimen/dp_42">
        <TextView
            android:textColor="@color/text_title"
            android:id="@+id/permission_former_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_17"
            android:layout_marginBottom="@dimen/dp_17"
            android:text="@string/Todo_List_NoPermissionRequestFormer_Text"
            android:layout_marginStart="@dimen/dp_12"/>
        <com.suite.lark.emm.design.edittext.SCEditText
            android:textSize="@dimen/sp_12"
            android:textColor="@color/text_title"
            android:textColorHint="@color/text_placeholder"
            android:id="@+id/note_text"
            android:background="@drawable/task_list_permission_note_panel"
            android:paddingTop="@dimen/dp_10"
            android:paddingBottom="@dimen/dp_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_17"
            android:hint="@string/Todo_List_NoPermissionRequest_AddNote_Placeholder"
            android:singleLine="true"
            android:paddingStart="@dimen/dp_12"
            android:paddingEnd="@dimen/dp_12"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_12"/>
        <com.larksuite.component.universe_design.button.UDButton
            android:textSize="@dimen/sp_16"
            android:textColor="@color/static_white"
            android:gravity="center"
            android:id="@+id/send_btn"
            android:paddingTop="@dimen/dp_9"
            android:paddingBottom="@dimen/dp_9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_16"
            android:text="@string/Todo_List_NoPermissionEmptyRequest_Button"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_12"
            app:ud_backgroundColor="@color/ud_button_blue_bg"
            app:ud_radius="m"/>
    </LinearLayout>
</LinearLayout>
