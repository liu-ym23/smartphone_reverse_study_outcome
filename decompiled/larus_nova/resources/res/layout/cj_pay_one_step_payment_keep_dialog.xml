<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:background="@drawable/cj_pay_bg_common_dialog_radius_8"
    android:paddingBottom="@dimen/cj_pay_padding_18"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/cj_pay_one_step_keep_dialog_close"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:src="?attr/cj_pay_icon_titlebar_left_close_noise_reduction"
        android:layout_alignParentLeft="true"/>
    <TextView
        android:textSize="@dimen/cj_pay_font_size_17"
        android:textColor="?attr/cj_pay_text_primary"
        android:id="@+id/cj_pay_one_step_keep_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/cj_pay_one_step_payment_keep_title"
        android:includeFontPadding="false"
        android:layout_centerHorizontal="true"
        style="@style/CJPayShadowTextStyle"/>
    <TextView
        android:textSize="@dimen/cj_pay_font_size_14"
        android:textColor="?attr/cj_pay_text_secondary"
        android:gravity="center"
        android:id="@+id/cj_pay_one_step_keep_dialog_subtitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_20"
        android:layout_marginTop="10dp"
        android:layout_marginRight="@dimen/cj_pay_padding_20"
        android:includeFontPadding="false"
        android:layout_below="@+id/cj_pay_one_step_keep_dialog_title"
        android:layout_centerHorizontal="true"/>
    <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
        android:textSize="15sp"
        android:textColor="@color/cj_pay_color_white"
        android:gravity="center"
        android:id="@+id/cj_pay_one_step_keep_dialog_confirm"
        android:background="@drawable/cj_pay_bg_red_btn_radius_4_fe2c55"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_44"
        android:layout_marginLeft="@dimen/cj_pay_padding_20"
        android:layout_marginTop="24dp"
        android:layout_marginRight="@dimen/cj_pay_padding_20"
        android:text="@string/cj_pay_one_step_payment_keep_continue"
        android:includeFontPadding="false"
        android:layout_below="@+id/cj_pay_one_step_keep_dialog_subtitle"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/cj_pay_font_size_13"
        android:textColor="?attr/cj_pay_text_tertiary"
        android:id="@+id/cj_pay_one_step_keep_dialog_change"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cj_pay_padding_16"
        android:layout_below="@+id/cj_pay_one_step_keep_dialog_confirm"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
