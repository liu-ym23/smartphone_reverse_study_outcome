<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shopping_bg_feed_store_card_round_white"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/dv_store_logo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundAsCircle="true"
        app:roundingBorderColor="@color/shopping_color_12000000"
        app:roundingBorderWidth="0.5dp"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/tv_enter_store"
        android:background="@drawable/shopping_bg_round_or_circle_red"
        android:layout_width="68dp"
        android:layout_height="24dp"
        android:text="@string/shopping_store_enter"
        app:layout_constraintBottom_toBottomOf="@+id/dv_store_logo"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/dv_store_logo"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_store_name_brand"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="19dp"
        app:layout_constraintLeft_toRightOf="@+id/dv_store_logo"
        app:layout_constraintRight_toLeftOf="@+id/tv_enter_store"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="@color/shopping_color_161823"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_store_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="center_vertical"
            android:id="@+id/dv_store_brand"
            android:layout_width="28dp"
            android:layout_height="16dp"
            android:layout_marginLeft="2dp"
            app:actualImageScaleType="fitCenter"/>
    </LinearLayout>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/shopping_color_75161823"
        android:id="@+id/tv_store_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintLeft_toLeftOf="@+id/ll_store_name_brand"
        app:layout_constraintTop_toBottomOf="@+id/ll_store_name_brand"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/shopping_color_75161823"
        android:id="@+id/tv_store_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:drawableLeft="@drawable/shopping_inflow_feed_store_card_divider"
        android:drawablePadding="4dp"
        app:layout_constraintLeft_toRightOf="@+id/tv_store_score"
        app:layout_constraintTop_toTopOf="@+id/tv_store_score"/>
</androidx.constraintlayout.widget.ConstraintLayout>
