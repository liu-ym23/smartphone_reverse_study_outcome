<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/CustomBottomSheetDialogTheme.Light"
    android:id="@+id/comment_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/root_container"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <View
            android:id="@+id/space"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sr_comment_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="?attr/larus_dp_8"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="@+id/keyboad_wrapper"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/view_bottom_shaddow"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            app:layout_constraintBottom_toTopOf="@+id/keyboad_wrapper"/>
        <View
            android:id="@+id/navigation_bar"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_1"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/keyboad_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/navigation_bar">
            <View
                android:layout_gravity="bottom"
                android:background="?attr/base_2"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_25"
                app:layout_constraintBottom_toBottomOf="parent"/>
            <View
                android:background="@drawable/larus_chat_common_shadow_bg"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_0"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.story.ai.biz.comment.view.KeyBoardWrapperView
                android:orientation="horizontal"
                android:id="@+id/ll_keyboard_wrapper_view"
                android:background="?attr/bg_input_normal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:minHeight="?attr/larus_dp_56"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="?attr/larus_dp_17"
                    android:textColor="?attr/neutral_100"
                    android:textColorHint="?attr/neutral_50"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/edt_comment"
                    android:background="@null"
                    android:scrollbars="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:minHeight="40dp"
                    android:hint="@string/larus_botsComment_commentPanel_inputField_placeholder"
                    android:maxLines="5"
                    android:layout_weight="1"
                    android:textCursorDrawable="?attr/comment_dialog_edit_cursor"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="end|bottom"
                    android:id="@+id/img_comment_send"
                    android:visibility="invisible"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginBottom="12dp"
                    android:src="?attr/ic_comment_send_normal"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"/>
            </com.story.ai.biz.comment.view.KeyBoardWrapperView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
