<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_commerce_anchor_v3_recommend_feedback_layout_834298030"
    android:background="@drawable/ec_commerce_anchor_v3_bg_guess_u_like_feedback"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/feedback_exit"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginTop="13dp"
        android:layout_marginRight="10dp"
        android:src="@drawable/ec_commerce_gul_feedback_exit"
        android:layout_marginEnd="10dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/white"
        android:id="@+id/feedback_back"
        android:paddingLeft="10dp"
        android:paddingTop="12dp"
        android:paddingRight="10dp"
        android:paddingBottom="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ec_commerce_gul_feedback_back_text"
        android:drawableLeft="@drawable/ec_commerce_gul_feedback_back"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/feedback_recyclerview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        app:layout_constraintBottom_toTopOf="@+id/search_same_style_product"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/feedback_exit"/>
    <FrameLayout
        android:id="@+id/search_same_style_product"
        android:background="@color/commerce_color_80000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shopping_tip_recommend_search_same_style_product"
            android:drawableRight="@drawable/shopping_right_arrow_white_12dp"
            android:drawableEnd="@drawable/shopping_right_arrow_white_12dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
