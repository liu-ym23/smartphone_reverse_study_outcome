<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/new_profile_honour_card_view"
    android:background="@drawable/ttlive_profile_v3_honour_card_bg"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <TextView
        android:textSize="11dp"
        android:textColor="@color/ttlive_new_profile_70black"
        android:id="@+id/new_profile_honour_card_title"
        android:layout_width="wrap_content"
        android:layout_height="15dp"
        android:layout_marginTop="7dp"
        android:layout_marginStart="12dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/new_profile_honour_card_title_arrow"
        android:visibility="invisible"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/ttlive_ic_profile_v3_right_arrow_8"
        app:layout_constraintBottom_toBottomOf="@+id/new_profile_honour_card_title"
        app:layout_constraintLeft_toRightOf="@+id/new_profile_honour_card_title"
        app:layout_constraintTop_toTopOf="@+id/new_profile_honour_card_title"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/new_profile_honour_act_badge_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintLeft_toLeftOf="@+id/new_profile_honour_card_title"
        app:layout_constraintTop_toBottomOf="@+id/new_profile_honour_card_title"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/new_profile_honour_card_image"
        android:layout_width="24dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
