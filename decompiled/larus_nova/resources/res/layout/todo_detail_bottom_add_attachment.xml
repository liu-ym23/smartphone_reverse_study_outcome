<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="@dimen/dp_6"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_48"
        android:paddingEnd="@dimen/dp_16">
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/primary_fill_default"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/detail_attachment_more"
            android:paddingLeft="@dimen/dp_16"
            android:paddingTop="11dp"
            android:paddingRight="@dimen/dp_16"
            android:paddingBottom="11dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Todo_ViewMoreAttachments_Button"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottom_detail_attachment_container"
        android:paddingLeft="@dimen/dp_12"
        android:paddingRight="@dimen/dp_12"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_36"
        android:layout_marginTop="@dimen/dp_2"
        android:layout_marginStart="@dimen/dp_34">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:layout_width="16sp"
            android:layout_height="16sp"
            android:tint="@color/icon_n3"
            android:layout_marginEnd="8dp"
            app:srcCompat="@drawable/ud_icon_add_outlined"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_placeholder"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Todo_Task_AddAttachment"/>
    </LinearLayout>
</LinearLayout>
