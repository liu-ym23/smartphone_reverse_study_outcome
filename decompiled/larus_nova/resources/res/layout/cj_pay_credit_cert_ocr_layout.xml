<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.android.ttcjpaysdk.ocr.view.OCRCodeView
        android:id="@+id/tt_cj_pay_ocr_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cj_pay_ocr_preview_maskColor="@color/cj_pay_color_trans"/>
    <RelativeLayout
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/back_view"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/cj_pay_ocr_back_icon"
            android:layout_marginStart="16dp"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:id="@+id/light_view"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/cj_pay_ocr_light_icon"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true"/>
        <include
            android:id="@+id/cj_pay_ocr_scan_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="56dp"
            android:layout_marginBottom="146dp"
            android:layout_above="@+id/bottom_tab_layout"
            layout="@layout/cj_pay_view_full_scan"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/cj_pay_color_white_90"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_ocr_scan_tips"
            android:background="@drawable/cj_pay_ocr_tips_bg"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="84dp"
            android:maxLines="2"
            android:layout_above="@+id/bottom_tab_layout"
            android:layout_centerHorizontal="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>
        <ImageView
            android:id="@+id/btn_take_photo"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_marginBottom="50dp"
            android:src="@drawable/cj_pay_ocr_take_photo_icon"
            android:layout_above="@+id/bottom_tab_layout"
            android:layout_centerHorizontal="true"/>
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/bottom_tab_layout"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="50dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            app:tabBackground="@android:color/transparent"
            app:tabIndicatorColor="@android:color/transparent"
            app:tabIndicatorHeight="0dp"
            app:tabRippleColor="@null"
            app:tabSelectedTextColor="@color/cj_pay_color_white"
            app:tabTextAppearance="@style/TabLayoutTextAppearance"
            app:tabTextColor="@color/cj_pay_color_white_60">
            <com.google.android.material.tabs.TabItem
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cj_pay_ocr_upload_picture"/>
            <com.google.android.material.tabs.TabItem
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cj_pay_ocr_scan_picture"/>
            <com.google.android.material.tabs.TabItem
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cj_pay_ocr_take_photo"/>
        </com.google.android.material.tabs.TabLayout>
    </RelativeLayout>
    <com.android.ttcjpaysdk.base.ui.widget.CJPayTextLoadingView
        android:id="@+id/ocr_loading_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.android.ttcjpaysdk.ocr.view.CJOCRTakePhotoPreview
        android:id="@+id/cj_pay_take_photo_preview"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
