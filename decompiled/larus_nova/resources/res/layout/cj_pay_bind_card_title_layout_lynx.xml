<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#00ffffff"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/ll_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_16"
        android:layout_marginRight="@dimen/cj_pay_padding_16"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.android.ttcjpaysdk.base.ui.widget.CJPayBoldTextView
                android:textSize="22dp"
                android:textStyle="bold"
                android:textColor="@color/cj_pay_color_black_161823"
                android:id="@+id/tv_title_left"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/cj_pay_padding_4"
                android:includeFontPadding="false"/>
            <ImageView
                android:id="@+id/iv_title_icon"
                android:layout_width="@dimen/cj_pay_padding_22"
                android:layout_height="@dimen/cj_pay_padding_22"
                android:layout_marginRight="@dimen/cj_pay_padding_4"/>
            <com.android.ttcjpaysdk.base.ui.widget.CJPayBoldTextView
                android:textSize="22dp"
                android:textStyle="bold"
                android:textColor="@color/cj_pay_color_black_161823"
                android:ellipsize="middle"
                android:id="@+id/tv_title_right"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <com.android.ttcjpaysdk.base.ui.widget.CJPayBoldTextView
            android:textSize="26dp"
            android:textStyle="bold"
            android:textColor="@color/cj_pay_color_black_161823"
            android:id="@+id/tv_title_bottom"
            android:paddingTop="2dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ll_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_16"
        android:layout_marginTop="@dimen/cj_pay_padding_4"
        android:layout_marginRight="@dimen/cj_pay_padding_16"
        android:layout_below="@+id/ll_title"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/iv_sub_title_icon"
            android:layout_width="@dimen/cj_pay_padding_16"
            android:layout_height="@dimen/cj_pay_padding_16"
            android:layout_marginRight="@dimen/cj_pay_padding_4"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
            android:gravity="center"
            android:id="@+id/tv_sub_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</RelativeLayout>
