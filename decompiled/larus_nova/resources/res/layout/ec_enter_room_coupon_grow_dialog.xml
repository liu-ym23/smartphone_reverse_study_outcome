<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:background="@drawable/bg_coupon_dialog"
    android:paddingBottom="34dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textColor="#161823"
        android:id="@+id/tv_coupon_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/ec_coupon_login_hint"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_coupon_grow_ago"
        android:background="@drawable/ec_bg_coupon_grow"
        android:layout_width="80dp"
        android:layout_height="96dp"
        app:layout_constraintBottom_toBottomOf="@+id/cl_coupon_grow_after"
        app:layout_constraintLeft_toLeftOf="@+id/btn_direct_obtain"
        app:layout_constraintRight_toRightOf="@+id/btn_direct_obtain">
        <TextView
            android:textSize="11dp"
            android:textColor="@color/ec_color_white"
            android:id="@+id/tv_grow_ago_coupon_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="17dp"
            android:textColor="@color/ec_color_white"
            android:id="@+id/tv_grow_ago_coupon_prefix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/ec_rmb_symbol"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toStartOf="@+id/tv_grow_ago_coupon_num"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_grow_ago_coupon_info"/>
        <TextView
            android:textSize="32sp"
            android:textColor="@color/ec_color_white"
            android:id="@+id/tv_grow_ago_coupon_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="1dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/tv_grow_ago_coupon_prefix"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_grow_ago_coupon_prefix"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="@color/ec_color_white"
            android:id="@+id/tv_grow_ago_coupon_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="9dp"
            android:text="@string/ec_base_coupon"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_coupon_grow_after"
        android:background="@drawable/ec_bg_coupon_grow"
        android:layout_width="90dp"
        android:layout_height="109dp"
        android:layout_marginTop="17dp"
        app:layout_constraintLeft_toLeftOf="@+id/btn_coupon_grow"
        app:layout_constraintRight_toRightOf="@+id/btn_coupon_grow"
        app:layout_constraintTop_toBottomOf="@+id/tv_coupon_title">
        <TextView
            android:textSize="11dp"
            android:textColor="@color/ec_color_white"
            android:id="@+id/tv_grow_after_coupon_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="17dp"
            android:textColor="@color/ec_color_white"
            android:id="@+id/tv_grow_after_coupon_prefix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="@string/ec_rmb_symbol"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toStartOf="@+id/tv_grow_after_coupon_num"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_grow_after_coupon_info"/>
        <TextView
            android:textSize="32sp"
            android:textColor="@color/ec_color_white"
            android:id="@+id/tv_grow_after_coupon_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="1dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/tv_grow_after_coupon_prefix"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_grow_after_coupon_prefix"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="@color/ec_color_white"
            android:id="@+id/tv_grow_after_coupon_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/ec_grow_coupon"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:layout_width="34dp"
        android:layout_height="26dp"
        android:src="@drawable/ec_coupon_grow_arrow"
        app:layout_constraintBottom_toBottomOf="@+id/cl_coupon_grow_after"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cl_coupon_grow_after"/>
    <Button
        android:textSize="15dp"
        android:textColor="@color/ec_color_black_161823"
        android:id="@+id/btn_direct_obtain"
        android:background="@drawable/ec_bg_coupon_direct_obtain"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="@string/ec_direct_obtain"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toStartOf="@+id/btn_coupon_grow"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_coupon_grow_after"/>
    <Button
        android:textSize="15dp"
        android:textColor="@color/ec_color_white"
        android:id="@+id/btn_coupon_grow"
        android:background="@color/commerce_primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="@string/ec_to_grow_couponmoney"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/btn_direct_obtain"
        app:layout_constraintTop_toBottomOf="@+id/cl_coupon_grow_after"/>
</androidx.constraintlayout.widget.ConstraintLayout>
