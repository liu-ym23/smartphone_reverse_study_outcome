<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/cj_pay_payment_method_root_view"
        android:background="@drawable/cj_pay_bg_payment_method_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_470">
        <include layout="@layout/cj_pay_view_titlebar_layout"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.android.ttcjpaysdk.base.ui.anim.CJBoundScrollView
                android:scrollbars="none"
                android:clipToPadding="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:layout_below="@+id/cj_pay_payment_method_desc_layout"
                android:overScrollMode="always">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/cj_pay_method_content_holder"
                    android:paddingBottom="8dp"
                    android:descendantFocusability="blocksDescendants"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="14dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="14dp"/>
            </com.android.ttcjpaysdk.base.ui.anim.CJBoundScrollView>
            <View
                android:id="@+id/cj_pay_empty_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <include
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/cj_pay_view_half_screen_loading_layout"/>
            <include
                android:id="@+id/cj_pay_security_panel_loading_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/cj_pay_view_security_panel_loading_container"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
