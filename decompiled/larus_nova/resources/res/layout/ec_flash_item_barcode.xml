<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/ec_flash_item_text"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="84dp"
        android:paddingTop="8dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ec_color_34_161823"
            android:id="@+id/tv_gen_barcode_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ec_color_FE2C55"
            android:gravity="center"
            android:id="@+id/tv_gen_barcode"
            android:background="@drawable/ec_bg_btn_flash_gen_barcode"
            android:paddingLeft="11dp"
            android:paddingRight="11dp"
            android:layout_width="wrap_content"
            android:layout_height="29dp"/>
    </LinearLayout>
</LinearLayout>
