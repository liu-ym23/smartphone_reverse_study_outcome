<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/mock_channel_info"
                android:background="#55ffffff"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="好友频道"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center"
                android:id="@+id/mock_invite"
                android:background="@color/white"
                android:layout_width="60dp"
                android:layout_height="25dp"
                android:layout_marginRight="5dp"
                android:text="邀请"/>
            <TextView
                android:gravity="center"
                android:id="@+id/mock_invite_id"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:layout_marginRight="5dp"
                android:text="空"/>
            <TextView
                android:gravity="center"
                android:id="@+id/mock_copy"
                android:background="@color/white"
                android:layout_width="60dp"
                android:layout_height="25dp"
                android:layout_marginRight="5dp"
                android:text="复制"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <EditText
                android:gravity="center"
                android:id="@+id/mock_edit"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="5dp"
                android:hint="填入邀请码"/>
            <TextView
                android:gravity="center"
                android:id="@+id/mock_edit_join"
                android:background="@color/white"
                android:layout_width="60dp"
                android:layout_height="25dp"
                android:layout_marginRight="5dp"
                android:text="加入频道"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <TextView
                android:gravity="center"
                android:id="@+id/mock_create"
                android:background="@color/white"
                android:layout_width="60dp"
                android:layout_height="25dp"
                android:layout_marginRight="5dp"
                android:text="创建"/>
            <TextView
                android:gravity="center"
                android:id="@+id/mock_join"
                android:background="@color/white"
                android:layout_width="60dp"
                android:layout_height="25dp"
                android:layout_marginRight="5dp"
                android:text="加入"/>
            <TextView
                android:gravity="center"
                android:id="@+id/mock_join_apply"
                android:background="@color/white"
                android:layout_width="100dp"
                android:layout_height="25dp"
                android:layout_marginRight="5dp"
                android:text="加入被通过"/>
            <TextView
                android:gravity="center"
                android:id="@+id/mock_join_apply_fail"
                android:background="@color/white"
                android:layout_width="100dp"
                android:layout_height="25dp"
                android:layout_marginRight="5dp"
                android:text="加入被拒绝"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <TextView
                android:gravity="center"
                android:id="@+id/mock_quit"
                android:background="@color/white"
                android:layout_width="60dp"
                android:layout_height="25dp"
                android:layout_marginRight="5dp"
                android:text="退出"/>
            <TextView
                android:gravity="center"
                android:id="@+id/mock_dissolve"
                android:background="@color/white"
                android:layout_width="60dp"
                android:layout_height="25dp"
                android:layout_marginRight="5dp"
                android:text="解散"/>
            <TextView
                android:gravity="center"
                android:id="@+id/mock_kickout"
                android:background="@color/white"
                android:layout_width="60dp"
                android:layout_height="25dp"
                android:layout_marginRight="5dp"
                android:text="被踢出"/>
            <TextView
                android:gravity="center"
                android:id="@+id/mock_disslove"
                android:background="@color/white"
                android:layout_width="60dp"
                android:layout_height="25dp"
                android:layout_marginRight="5dp"
                android:text="被解散"/>
            <TextView
                android:gravity="center"
                android:id="@+id/mock_show_and_hide"
                android:background="@color/white"
                android:layout_width="100dp"
                android:layout_height="25dp"
                android:layout_marginRight="5dp"
                android:text="展示/隐藏Info"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <TextView
                android:gravity="center"
                android:id="@+id/mock_be_mamager"
                android:background="@color/white"
                android:layout_width="60dp"
                android:layout_height="25dp"
                android:layout_marginRight="5dp"
                android:text="被移交"/>
            <TextView
                android:gravity="center"
                android:id="@+id/mock_member_change"
                android:background="@color/white"
                android:layout_width="60dp"
                android:layout_height="25dp"
                android:layout_marginRight="5dp"
                android:text="人员变更"/>
            <TextView
                android:gravity="center"
                android:id="@+id/mock_setting_change"
                android:background="@color/white"
                android:layout_width="60dp"
                android:layout_height="25dp"
                android:layout_marginRight="5dp"
                android:text="设置变更"/>
            <TextView
                android:gravity="center"
                android:id="@+id/mock_receive_join"
                android:background="@color/white"
                android:layout_width="100dp"
                android:layout_height="25dp"
                android:layout_marginRight="5dp"
                android:text="收到待审核消息"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <TextView
                android:gravity="center"
                android:id="@+id/mock_system"
                android:background="@color/white"
                android:layout_width="60dp"
                android:layout_height="25dp"
                android:layout_marginRight="5dp"
                android:text="系统提示"/>
            <TextView
                android:gravity="center"
                android:id="@+id/mock_chat"
                android:background="@color/white"
                android:layout_width="60dp"
                android:layout_height="25dp"
                android:layout_marginRight="5dp"
                android:text="评论消息"/>
            <TextView
                android:gravity="center"
                android:id="@+id/mock_emoji"
                android:background="@color/white"
                android:layout_width="60dp"
                android:layout_height="25dp"
                android:layout_marginRight="5dp"
                android:text="表情消息"/>
            <TextView
                android:gravity="center"
                android:id="@+id/mock_enter"
                android:background="@color/white"
                android:layout_width="60dp"
                android:layout_height="25dp"
                android:layout_marginRight="5dp"
                android:text="加入消息"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
