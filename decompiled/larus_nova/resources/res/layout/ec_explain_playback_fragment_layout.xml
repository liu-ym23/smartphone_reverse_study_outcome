<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ui.base.widget.round.RoundConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/commerce_video_playback_rootview"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/commerce_playback_video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/commerce_iv_playback_play_video"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ec_explain_playback_ic_playback_activity_play"/>
    </FrameLayout>
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/commerce_iv_video_blur_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.ui.base.widget.round.RoundView
        android:layout_width="match_parent"
        android:layout_height="108dp"
        app:bg_endColor="@color/explain_playback_color_start_color"
        app:bg_startColor="@color/ec_color_black_34"/>
    <com.bytedance.android.ui.ec.widget.loading.ECDuxLoadingAnimationView
        android:id="@+id/loading_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/commerce_playback_title_area"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp">
        <com.bytedance.android.ui.base.widget.round.RoundLinearLayout
            android:gravity="center_vertical"
            android:id="@+id/commerce_playback_return_live_container"
            android:paddingLeft="16dp"
            android:paddingRight="12dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:bg_color="@color/ec_commerce_color_292929_34"
            app:bg_cornerRadius_BR="16dp"
            app:bg_cornerRadius_TR="16dp">
            <com.bytedance.android.ui.base.widget.icon.IconImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ec_dux_ic_s_s_arrowleft_outlined"
                app:icon_color="@color/ec_color_white_50"/>
            <TextView
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ec_explain_playback_back_live"
                style="@style/font_size_28"/>
        </com.bytedance.android.ui.base.widget.round.RoundLinearLayout>
        <com.bytedance.android.ui.base.widget.icon.IconImageView
            android:id="@+id/commerce_ic_playback_activity_back"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/ec_dux_ic_s_s_arrowleft_outlined"
            android:layout_centerVertical="true"
            app:icon_color="@color/ec_color_white_50"/>
        <TextView
            android:textColor="@color/white_90"
            android:id="@+id/commerce_video_playback_tv_title"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            style="@style/font_size_34"/>
        <include
            android:id="@+id/layout_live_playing_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginRight="-1dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="-1dp"
            android:layout_alignParentEnd="true"
            layout="@layout/ec_explain_playback_live_playing_icon_layout"/>
    </RelativeLayout>
    <com.bytedance.android.ui.base.widget.round.RoundView
        android:id="@+id/commerce_playback_page_bg_bottom_view"
        android:layout_width="match_parent"
        android:layout_height="232dp"
        app:bg_endColor="@color/ec_color_black_50"
        app:bg_startColor="@color/explain_playback_color_start_color"
        app:layout_constraintBottom_toTopOf="@+id/commerce_playback_video_bottom_view_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/commerce_video_playback_author_info_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/commerce_playback_title_area"/>
    <FrameLayout
        android:id="@+id/commerce_video_playback_top_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/commerce_video_playback_author_info_layout"/>
    <ViewStub
        android:id="@+id/vs_protect_tip"
        android:visibility="gone"
        android:layout="@layout/ec_explain_playback_protect_tip_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/fl_card_view_container_layout"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/fl_card_view_container_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/commerce_playback_video_bottom_view_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <FrameLayout
            android:id="@+id/commerce_video_promotion_card_view_container"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <com.bytedance.android.ui.base.widget.round.RoundConstraintLayout
                android:id="@+id/promotion_loading"
                android:layout_width="match_parent"
                android:layout_height="124dp"
                app:bg_color="@color/white"
                app:bg_cornerRadius="6dp">
                <com.bytedance.android.ui.base.widget.round.RoundView
                    android:id="@+id/promotion_pic"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="8dp"
                    app:bg_color="@color/ec_dux_black_161823_34"
                    app:bg_cornerRadius="6dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.bytedance.android.ui.base.widget.round.RoundFrameLayout
                    android:layout_width="80dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    app:bg_cornerRadius="4dp"
                    app:layout_constraintBottom_toBottomOf="@+id/promotion_pic"
                    app:layout_constraintEnd_toEndOf="parent">
                    <TextView
                        android:background="@drawable/ec_explain_playback_buy_button_enable_react"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </com.bytedance.android.ui.base.widget.round.RoundFrameLayout>
            </com.bytedance.android.ui.base.widget.round.RoundConstraintLayout>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/commerce_video_promotion_small_card_view_container"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingBottom="12dp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_multi_card_view_container_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/commerce_playback_video_bottom_view_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.bytedance.android.ec.core.widget.ECAutoScaleLayout
        android:id="@+id/sl_subtile"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@+id/fl_multi_card_view_container_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.bytedance.android.livesdk.livecommerce.playback.widget.StrokedTextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_subtile_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="@color/ec_color_black_25"
            android:shadowDy="1"
            android:shadowRadius="5"
            app:strokeColor="@color/shopping_std_bg_primary_1"
            app:strokeWidth="0.5sp"/>
    </com.bytedance.android.ec.core.widget.ECAutoScaleLayout>
    <FrameLayout
        android:id="@+id/fl_interaction_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/fl_multi_card_view_container_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/commerce_playback_video_bottom_view_container"
        android:background="@color/ec_color_black_50"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/commerce_playback_show_living_room_bottom_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ViewStub
            android:id="@+id/commerce_search_enter_live_room_viewstub"
            android:visibility="gone"
            android:layout="@layout/ec_explain_playback_enter_live_room_layout"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="12dp"/>
        <include
            android:id="@+id/commerce_playback_video_seekbar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            layout="@layout/ec_explain_playback_seekbar_layout"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/commerce_playback_show_living_room_bottom_container"
        android:background="@color/ec_color_black_50"
        android:paddingBottom="30dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.bytedance.android.ui.base.widget.round.RoundConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            app:bg_color="#26ffffff"
            app:bg_cornerRadius="40dp"
            app:bg_strokeColor="#4dffffff"
            app:bg_strokeWidth="0.5dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.bytedance.android.ec.core.widget.ECLottieAnimationView
                    android:id="@+id/explaining_douyin"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="4dp"
                    app:layout_constraintRight_toLeftOf="@+id/ec_commerce_playback_show_living_room_bottom"
                    app:lottie_autoPlay="true"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#ffffff"
                    android:id="@+id/ec_commerce_playback_show_living_room_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.bytedance.android.ui.base.widget.round.RoundConstraintLayout>
    </FrameLayout>
</com.bytedance.android.ui.base.widget.round.RoundConstraintLayout>
