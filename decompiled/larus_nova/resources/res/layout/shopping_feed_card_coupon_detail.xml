<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="80dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_coupon_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="28dp"
                android:textStyle="bold"
                android:textColor="@color/shopping_color_FE2C55"
                android:id="@+id/tv_coupon_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="11dp"
                android:textColor="@color/shopping_color_FE2C55"
                android:id="@+id/tv_coupon_label_yuan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="@string/shopping_currency_yuan"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/shopping_color_FE2C55"
            android:gravity="center_horizontal"
            android:id="@+id/tv_coupon_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginBottom="6dp"
            app:layout_constraintTop_toBottomOf="@+id/ll_coupon_amount"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2.2">
        <TextView
            android:textColor="@color/shopping_color_FE2C55"
            android:id="@+id/tv_coupon_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="14dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/shopping_color_161823"
            android:id="@+id/tv_coupon_type_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.5"
            app:layout_constraintLeft_toLeftOf="@+id/tv_coupon_type"
            app:layout_constraintTop_toBottomOf="@+id/tv_coupon_type"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/shopping_color_FE2C55"
            android:gravity="center"
            android:id="@+id/tv_apply"
            android:background="@drawable/shopping_border_inflow_feed_coupon_button"
            android:layout_width="52dp"
            android:layout_height="24dp"
            android:layout_marginRight="13dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
