<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/work_experience_title_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"/>
    <com.larus.bmhome.view.item.ItemTextToggle
        android:id="@+id/work_experience_enabled"
        android:background="@drawable/larus_bg_office_task_setting_item_normal"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginRight="?attr/larus_dp_16"
        android:text="@string/larus_moa_work_experience_cn"
        app:larus_image_height="?attr/larus_dp_32"
        app:larus_image_src="@drawable/larus_ic_work_experience_entry"
        app:larus_image_width="?attr/larus_dp_32"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/work_experience_list"
            android:paddingLeft="?attr/larus_dp_16"
            android:paddingRight="?attr/larus_dp_16"
            android:paddingBottom="?attr/larus_dp_24"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/work_experience_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="?attr/larus_neutral_50"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/work_experience_empty"
            android:padding="?attr/larus_dp_24"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_LarkIM_Feed_UserChats_Empty"/>
    </FrameLayout>
</LinearLayout>
