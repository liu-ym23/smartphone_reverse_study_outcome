<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.livesdk.gift.platform.business.dialog.v3.view.LiveGiftHonorProgressView
        android:id="@+id/honor_progress"
        android:padding="1dp"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ttlive_gift_honor_level_progress_height"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="8dp"
        android:layout_toRightOf="@+id/left_level_img"
        android:layout_alignTop="@+id/left_level_img"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/honor_progress_anim"
        android:visibility="gone"
        android:layout_width="17dp"
        android:layout_height="14dp"
        android:layout_marginTop="-4dp"
        android:layout_toRightOf="@+id/left_level_img"
        android:layout_alignTop="@+id/honor_progress"
        android:layout_toEndOf="@+id/left_level_img"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/ttlive_level_honor_need_label_normal"
        android:id="@+id/buff_status"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_toRightOf="@+id/left_level_img"
        android:layout_below="@+id/honor_progress"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/ttlive_level_honor_need_label_normal"
        android:ellipsize="end"
        android:id="@+id/need_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:maxLines="1"
        android:layout_toRightOf="@+id/buff_status"
        android:layout_below="@+id/honor_progress"/>
    <ImageView
        android:id="@+id/query_icon"
        android:background="@drawable/ttlive_icon_gift_query"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginLeft="2dp"
        android:layout_marginTop="2.5dp"
        android:layout_toRightOf="@+id/need_label"
        android:layout_below="@+id/honor_progress"/>
    <FrameLayout
        android:id="@+id/levelup_effect"
        android:background="@drawable/ttlive_bg_gift_honor_levelup"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginLeft="20dp"
        android:layout_alignLeft="@+id/left_level_img"
        android:layout_centerVertical="true">
        <TextView
            android:textSize="10dp"
            android:textColor="#face15"
            android:ellipsize="none"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/levelup_effect_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:singleLine="true"/>
    </FrameLayout>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/left_level_img"
        android:layout_width="46dp"
        android:layout_height="21dp"
        android:layout_marginLeft="16dp"
        android:layout_centerVertical="true"/>
    <com.bytedance.android.live.core.widget.FitTextView
        android:textSize="12dp"
        android:textColor="#face15"
        android:gravity="start"
        android:id="@+id/zeropay_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_centerVertical="true"/>
    <View
        android:id="@+id/gift_honor_divider"
        android:background="#33ffffff"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
