<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:background="@drawable/ttlive_effect_bg_sticker_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ttlive_effect_icon_hint_container"
        android:background="@drawable/ttlive_effect_bg_tab_strip"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="16dp"
            android:src="@drawable/ttlive_effect_icon_hint"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="normal"
            android:textColor="#d6ffffff"
            android:id="@+id/ttlive_effect_icon_hint_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/top_view"
        android:background="@drawable/ttlive_effect_bg_tab_strip"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <Button
            android:layout_gravity="center_vertical"
            android:id="@+id/bt_clear"
            android:background="@drawable/ttlive_effect_ic_sticker_clean"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="16dp"
            android:contentDescription="@string/ttlive_effect_sticker_clear_description"
            android:layout_marginStart="16dp"/>
        <Button
            android:layout_gravity="center_vertical"
            android:id="@+id/btn_share"
            android:background="@drawable/ttlive_effect_ic_enable_share_sticker"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="12dp"
            android:contentDescription="@string/ttlive_effect_sticker_linkage_share_switch_description"
            android:layout_marginStart="12dp"/>
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/top_line"
            android:background="#28ffffff"
            android:layout_width="1px"
            android:layout_height="16dp"
            android:layout_marginLeft="16dp"
            android:layout_marginStart="16dp"/>
        <com.bytedance.android.live.effect.base.LiveEffectPagerSlidingTabStrip
            android:layout_gravity="center_vertical"
            android:id="@+id/tab_strip"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:layout_marginStart="8dp"
            app:ttlive_effect_tab_background="@color/transparent"
            app:ttlive_effect_tab_indicator_color="#ffffff"
            app:ttlive_effect_tab_indicator_height="2dp"
            app:ttlive_effect_tab_indicator_width="30dp"
            app:ttlive_effect_tab_padding_left_right="12dp"
            app:ttlive_effect_tab_scroll_offset="112dp"
            app:ttlive_effect_tab_text_color="@color/ttlive_effect_live_sticker_tab_text_color_v2"
            app:ttlive_effect_tab_text_size="15dp"
            app:ttlive_effect_tab_typeface_style="normal"
            app:ttlive_effect_tab_underline_color="#0fffffff"
            app:ttlive_effect_tab_underline_height="0.5dp"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_tip_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        app:layout_constraintBottom_toTopOf="@+id/sticker_pager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_view">
        <TextView
            android:textSize="12dp"
            android:textColor="#e5ffffff"
            android:ellipsize="end"
            android:id="@+id/tip_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tip_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/tip_button"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ttlive_effect_icon_tip_bar_enter"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tip_content"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.live.uikit.rtl.RtlViewPager
        android:id="@+id/sticker_pager"
        android:layout_width="match_parent"
        android:layout_height="273dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_tip_bar"/>
    <View
        android:id="@+id/shadow_view"
        android:background="@drawable/ttlive_effect_sticker_dialog_page_shadow"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="27dp"
        app:layout_constraintEnd_toEndOf="@+id/sticker_pager"
        app:layout_constraintStart_toStartOf="@+id/sticker_pager"
        app:layout_constraintTop_toTopOf="@+id/sticker_pager"/>
    <com.bytedance.android.live.uikit.recyclerview.LoadingStatusView
        android:layout_gravity="center"
        android:id="@+id/status_view"
        android:layout_width="match_parent"
        android:layout_height="273dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/effect_preview_guide_container"
        android:background="@drawable/ttlive_effect_bg_sticker_preview_panel_tips"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="313dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <View
            android:id="@+id/effect_preview_tips_border"
            android:background="@drawable/ttlive_effect_bg_sticker_preview_guide_border"
            android:layout_width="97dp"
            android:layout_height="194dp"
            app:layout_constraintBottom_toTopOf="@+id/effect_preview_tips_textview"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/effect_preview_tips_image_view"
            android:layout_width="89dp"
            android:layout_height="158dp"
            android:layout_marginTop="4dp"
            app:actualImageScaleType="fitCenter"
            app:layout_constraintEnd_toEndOf="@+id/effect_preview_tips_border"
            app:layout_constraintStart_toStartOf="@+id/effect_preview_tips_border"
            app:layout_constraintTop_toTopOf="@+id/effect_preview_tips_border"
            app:roundedCornerRadius="4dp"/>
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="60dp"
            android:src="@drawable/ttlive_effect_preview_guid_click"
            app:layout_constraintStart_toStartOf="@+id/effect_preview_tips_image_button_textview"
            app:layout_constraintTop_toTopOf="@+id/effect_preview_tips_image_button_textview"/>
        <TextView
            android:textSize="12dp"
            android:gravity="center"
            android:id="@+id/effect_preview_tips_image_button_textview"
            android:background="@drawable/ttlive_effect_bg_sticker_preview_button"
            android:layout_width="89dp"
            android:layout_height="19dp"
            android:layout_marginBottom="6dp"
            android:text="应用"
            app:layout_constraintBottom_toBottomOf="@+id/effect_preview_tips_border"
            app:layout_constraintEnd_toEndOf="@+id/effect_preview_tips_border"
            app:layout_constraintStart_toStartOf="@+id/effect_preview_tips_border"/>
        <TextView
            android:textSize="20dp"
            android:textStyle="bold"
            android:id="@+id/effect_preview_tips_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="特效支持预览了，点击应用生效"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/effect_preview_tips_border"
            app:layout_constraintVertical_chainStyle="packed"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
