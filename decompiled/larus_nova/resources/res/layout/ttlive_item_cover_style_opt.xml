<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/live_cover_opt_container"
    android:background="@null"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/live_operation_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:scaleType="centerInside"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="8dp"
        android:layout_alignParentStart="true"
        app:roundBottomLeft="false"
        app:roundBottomRight="true"
        app:roundTopLeft="true"
        app:roundTopRight="false"
        app:roundedCornerRadius="2dp"/>
    <View
        android:id="@+id/cover_mask"
        android:background="@drawable/ttlive_bg_cover"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/live_cover_bottom_container"
        android:background="@drawable/ttlive_bg_cover"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/live_content_label_left"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginLeft="8dp"
            android:layout_marginBottom="6dp"
            android:scaleType="centerInside"/>
        <FrameLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="10dp"
                android:textColor="@color/white"
                android:gravity="bottom"
                android:layout_gravity="bottom"
                android:id="@+id/live_locate"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginLeft="8dp"
                android:singleLine="true"
                android:layout_marginStart="8dp"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="right"
                android:id="@+id/live_content_label_right"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginRight="8dp"
                android:scaleType="centerInside"/>
        </FrameLayout>
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/live_avatar_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:layout_marginEnd="8dp">
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/live_avatar"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginLeft="8dp"
                android:scaleType="centerInside"
                android:layout_marginStart="8dp"
                app:placeholderImage="@drawable/ttlive_ic_default_head_small"
                app:roundAsCircle="true"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/live_nickname"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginLeft="4dp"
                android:maxEms="8"
                android:singleLine="true"
                android:layout_toRightOf="@+id/live_avatar"
                android:layout_marginStart="4dp"
                android:layout_toEndOf="@+id/live_avatar"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:gravity="center"
                android:id="@+id/user_verify_tag"
                android:visibility="gone"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginLeft="2dp"
                android:layout_marginTop="5dp"
                android:layout_toRightOf="@+id/live_nickname"
                android:layout_marginStart="2dp"
                android:layout_toEndOf="@+id/live_nickname"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#a4ffffff"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/live_city_distance"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginRight="8dp"
                android:maxEms="8"
                android:singleLine="true"
                android:layout_marginEnd="8dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/live_audience_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="6dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">
            <com.bytedance.android.live.core.widget.CustomFontTextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="#b3ffffff"
                android:gravity="center_vertical"
                android:id="@+id/live_audience_count"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:singleLine="true"
                android:layout_alignParentRight="true"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/live_title"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginRight="5dp"
                android:singleLine="true"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="2"
                android:layout_toLeftOf="@+id/live_audience_count"
                android:layout_alignParentLeft="true"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
