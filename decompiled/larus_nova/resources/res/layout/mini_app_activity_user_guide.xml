<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.common_ui.widget.roundlayout.RoundLinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/mini_app_user_guide_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:rv_backgroundColor="@color/base_1"
        app:rv_cornerRadius="@dimen/dp_32">
        <FrameLayout
            android:id="@+id/mini_app_user_guide_frameLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_36"
            android:layout_marginBottom="@dimen/dp_52">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/dp_19"
                    android:textStyle="bold"
                    android:textColor="@color/neutral_100"
                    android:ellipsize="end"
                    android:id="@+id/mini_app_add_desktop_icon_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mini_app_add_icon"
                    android:maxLines="1"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/dp_15"
                    android:textColor="@color/neutral_50"
                    android:id="@+id/mini_app_add_desktop_icon_hint"
                    android:layout_width="@dimen/dp_338"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_13"
                    android:text="@string/mini_app_add_icon_hint"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/mini_app_add_desktop_icon_title"/>
                <ImageView
                    android:id="@+id/mini_app_add_desktop_icon_content"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_410"
                    android:layout_marginTop="@dimen/dp_24"
                    android:src="@drawable/mini_app_calender_content_guide"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/mini_app_add_desktop_icon_hint"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/mini_app_add_desktop_icon_btn_add"
                    android:background="@drawable/mini_app_bg_user_guide_open"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_56"
                    android:layout_marginLeft="@dimen/dp_26"
                    android:layout_marginTop="@dimen/dp_22"
                    android:layout_marginRight="@dimen/dp_26"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/mini_app_add_desktop_icon_content">
                    <TextView
                        android:textSize="@dimen/dp_17"
                        android:textColor="@color/static_white"
                        android:id="@+id/mini_app_add_desktop_icon_add_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mini_app_add"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/mini_app_add_desktop_icon_btn_added"
                    android:background="@drawable/mini_app_bg_user_guide_opened"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_56"
                    android:layout_marginLeft="@dimen/dp_26"
                    android:layout_marginTop="@dimen/dp_22"
                    android:layout_marginRight="@dimen/dp_26"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/mini_app_add_desktop_icon_content">
                    <TextView
                        android:textSize="@dimen/dp_17"
                        android:textColor="#ff5d8b"
                        android:id="@+id/mini_app_add_desktop_icon_checked_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mini_app_added"
                        android:layout_marginStart="@dimen/dp_8"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/mini_app_add_desktop_icon_btn_ignore"
                    android:background="@drawable/mini_app_bg_user_guide_ignore"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_56"
                    android:layout_marginLeft="@dimen/dp_24"
                    android:layout_marginTop="@dimen/dp_91"
                    android:layout_marginRight="@dimen/dp_24"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/mini_app_add_desktop_icon_content">
                    <TextView
                        android:textSize="@dimen/dp_17"
                        android:textColor="@color/neutral_70"
                        android:id="@+id/mini_app_add_desktop_icon_ignore_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mini_app_ignore"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
    </com.larus.common_ui.widget.roundlayout.RoundLinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
