<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/replay_gesture_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.livesdk.widget.gesture.BrightnessView
            android:id="@+id/replay_brightness_view"
            android:background="@drawable/ttlive_bg_live_interaction_brightness_volume"
            android:visibility="invisible"
            android:layout_width="200dp"
            android:layout_height="36dp"
            android:layout_marginTop="50dp"
            android:layout_centerHorizontal="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.livesdk.widget.gesture.VolumeView
            android:id="@+id/replay_volume_view"
            android:background="@drawable/ttlive_bg_live_interaction_brightness_volume"
            android:visibility="invisible"
            android:layout_width="200dp"
            android:layout_height="36dp"
            android:layout_marginTop="50dp"
            android:layout_centerHorizontal="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:textColor="@color/white"
            android:id="@+id/fast_forward_container"
            android:background="@drawable/ttlive_bg_live_interaction_brightness_volume"
            android:visibility="invisible"
            android:layout_width="142dp"
            android:layout_height="32dp"
            android:layout_marginTop="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.airbnb.lottie.LottieAnimationView
                android:layout_gravity="center_vertical"
                android:id="@+id/fast_forward_icon"
                android:layout_width="20dp"
                android:layout_height="14dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="3dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:layout_gravity="center_vertical"
                android:id="@+id/fast_forward_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="38dp"
                android:text="@string/ttlive_fast_forward_tip"/>
        </FrameLayout>
        <View
            android:id="@+id/pause_icon"
            android:visibility="invisible"
            android:layout_width="58dp"
            android:layout_height="58dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
