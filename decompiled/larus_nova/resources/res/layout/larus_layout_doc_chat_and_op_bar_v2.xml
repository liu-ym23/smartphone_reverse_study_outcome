<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/chat_input_bg_mask_v3"
        android:background="@color/larus_neutral_transparent_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.office.plugins.input.view.TextLoadingView
        android:id="@+id/loading_text"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:larus_tlv_loadingIconRes="@drawable/larus_office_bg_loading_dot"
        app:larus_tlv_text="@string/larus_thinking_state"
        app:larus_tlv_textColor="@color/larus_neutral_100"
        app:larus_tlv_text_weight="400"
        app:layout_constraintBottom_toTopOf="@+id/office_chat_input_container"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.larus.office.plugins.input.view.CotHeaderView
        android:id="@+id/office_cot_view"
        android:background="?attr/larus_base_1"
        android:paddingTop="?attr/larus_dp_12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?attr/larus_dp_12"
        app:layout_constraintBottom_toTopOf="@+id/office_chat_input_container"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/office_chat_input_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/office_full_chat_input_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
