<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:background="@drawable/cj_pay_bg_common_dialog_radius_12"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_title_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
            android:id="@+id/tv_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"/>
    </LinearLayout>
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/cj_pay_color_black_161823"
        android:gravity="center"
        android:id="@+id/keep_dialog_title"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="67dp"
        android:layout_centerHorizontal="true"/>
    <FrameLayout
        android:id="@+id/keep_dialog_content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/keep_dialog_title">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
            android:ellipsize="middle"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/keep_dialog_text"
            android:paddingTop="10dp"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:maxWidth="240dp"
            android:maxLines="2"/>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/keep_dialog_btn_layout"
        android:layout_width="240dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="20dp"
        android:layout_below="@+id/keep_dialog_content_layout"
        android:layout_centerHorizontal="true">
        <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
            android:textSize="15sp"
            android:textColor="@color/cj_pay_color_white"
            android:gravity="center"
            android:id="@+id/keep_dialog_btn"
            android:background="@color/cj_pay_color_red_fe2c55"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/cj_pay_keep_window_keep"
            android:includeFontPadding="false"/>
        <ProgressBar
            android:id="@+id/keep_dialog_btn_loading"
            android:background="@color/cj_pay_color_trans"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_white"
            android:indeterminateDuration="500"
            android:indeterminateBehavior="repeat"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
        android:gravity="center_horizontal"
        android:id="@+id/keep_dialog_another_verify_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13dp"
        android:maxLines="1"
        android:layout_below="@+id/keep_dialog_btn_layout"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
