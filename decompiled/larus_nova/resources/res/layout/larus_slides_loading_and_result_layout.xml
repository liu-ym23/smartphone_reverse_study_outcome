<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/slides_loading_and_result_layout"
    android:background="@color/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/slides_loading_image_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.larus.bmhome.chat.layout.widget.SlidesShimmerLoadingVIew
            android:id="@+id/loading_rect1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="?attr/larus_dp_12"
            android:layout_marginStart="?attr/larus_dp_12"
            android:layout_marginEnd="?attr/larus_dp_12"
            app:layout_constraintDimensionRatio="16:9"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.larus.bmhome.chat.layout.widget.SlidesShimmerLoadingVIew
            android:id="@+id/loading_rect2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="?attr/larus_dp_12"
            android:alpha="0.7"
            android:layout_marginStart="?attr/larus_dp_12"
            android:layout_marginEnd="?attr/larus_dp_12"
            app:layout_constraintDimensionRatio="16:9"
            app:layout_constraintTop_toBottomOf="@+id/loading_rect1"/>
        <com.larus.bmhome.chat.layout.widget.SlidesShimmerLoadingVIew
            android:id="@+id/loading_rect3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="?attr/larus_dp_12"
            android:alpha="0.4"
            android:layout_marginStart="?attr/larus_dp_12"
            android:layout_marginEnd="?attr/larus_dp_12"
            app:layout_constraintDimensionRatio="16:9"
            app:layout_constraintTop_toBottomOf="@+id/loading_rect2"/>
        <com.larus.bmhome.chat.layout.widget.SlidesShimmerLoadingVIew
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="?attr/larus_dp_12"
            android:alpha="0.2"
            android:layout_marginStart="?attr/larus_dp_12"
            android:layout_marginEnd="?attr/larus_dp_12"
            app:layout_constraintDimensionRatio="16:9"
            app:layout_constraintTop_toBottomOf="@+id/loading_rect3"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/slides_load_error_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/slides_load_error_icon"
            android:layout_width="?attr/larus_dp_40"
            android:layout_height="?attr/larus_dp_40"
            android:scaleType="centerInside"/>
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:id="@+id/slides_load_error_msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_18"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
