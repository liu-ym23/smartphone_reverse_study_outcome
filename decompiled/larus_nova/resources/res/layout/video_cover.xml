<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_video_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/chat_bubble_self_pressed_bg"
        android:scaleType="centerCrop"/>
    <ImageView
        android:id="@+id/iv_video_cover"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/iv_shadow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/iv_play_video_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_play_video_btn"
        android:layout_centerInParent="true"/>
    <com.ss.android.lark.widget.mark.MarkView
        android:id="@+id/tv_video_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="6dp"
        app:icon="@drawable/ud_icon_video_filled"
        app:tint="@color/static_white"/>
</RelativeLayout>
