<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:alpha="0">
    <FrameLayout
        android:id="@+id/ec_store_topbar_background_wrapper"
        android:visibility="gone"
        android:clipChildren="true"
        android:layout_width="match_parent"
        android:layout_height="88dp">
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:id="@+id/ec_store_topbar_background"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layoutMode="height_self_adjust"/>
        <View
            android:id="@+id/ec_store_topbar_background_mask"
            android:layout_width="match_parent"
            android:layout_height="300dp"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="top"
        android:id="@+id/ec_store_top_bar_promotion_background_wrapper_without_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_gravity="top"
            android:id="@+id/ec_store_top_bar_promotion_background_without_tips_mask"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="top"
            android:id="@+id/ec_store_top_bar_promotion_background_without_tips"
            android:background="@android:color/white"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:actualImageScaleType="fitXY"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ec_store_top_bar_without_tips_container"
        android:clickable="true"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/ec_store_status_bar_placeholder"
            android:layout_width="match_parent"
            android:layout_height="44dp"/>
        <RelativeLayout
            android:id="@+id/ec_store_top_bar_container"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/ec_store_top_bar_container_inner"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="44sp">
                <ImageView
                    android:id="@+id/ec_store_top_bar_back_btn"
                    android:layout_width="24sp"
                    android:layout_height="24sp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:src="@drawable/shopping_ic_store_compat_back_white"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"
                    android:layout_alignParentStart="true"/>
                <FrameLayout
                    android:id="@+id/ec_store_applet_back_container"
                    android:visibility="gone"
                    android:clipChildren="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"/>
                <FrameLayout
                    android:orientation="horizontal"
                    android:id="@+id/ec_store_top_bar_mini_info_wrapper"
                    android:visibility="invisible"
                    android:clipChildren="false"
                    android:layout_width="wrap_content"
                    android:layout_height="32sp"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="12dp"
                    android:layout_toRightOf="@+id/ec_store_top_bar_back_btn"
                    android:layout_centerVertical="true"/>
                <com.bytedance.android.ec.store.product.widget.ECStoreTabLayout
                    android:id="@+id/ec_store_tab_layout_top"
                    android:paddingTop="6dp"
                    android:visibility="gone"
                    android:fadingEdgeLength="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_toLeftOf="@+id/ec_store_right_item_container"
                    android:layout_toRightOf="@+id/ec_store_top_bar_back_btn"
                    android:layout_centerVertical="true"
                    android:requiresFadingEdge="horizontal"
                    android:layout_marginStart="4dp"
                    app:tabGravity="center"
                    app:tabIndicator="@drawable/ec_store_top_bar_indicator_white"
                    app:tabIndicatorColor="@color/transparent"
                    app:tabIndicatorHeight="2dp"
                    app:tabMinWidth="0dp"
                    app:tabMode="scrollable"
                    app:tabPaddingEnd="0dp"
                    app:tabPaddingStart="0dp"
                    app:tabRippleColor="@color/transparent"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ec_store_right_item_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="16dp"
                    android:layout_alignParentEnd="true">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:id="@+id/ec_store_top_bar_search_area"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp">
                        <ImageView
                            android:id="@+id/ec_store_top_bar_search_icon"
                            android:layout_width="24sp"
                            android:layout_height="24sp"
                            android:src="@drawable/shopping_ic_store_compat_search_icon_white"
                            android:layout_centerVertical="true"/>
                    </LinearLayout>
                    <com.facebook.drawee.view.SimpleDraweeView
                        android:id="@+id/ec_store_top_bar_service_btn"
                        android:focusable="true"
                        android:visibility="gone"
                        android:layout_width="24sp"
                        android:layout_height="24sp"
                        app:actualImageResource="@drawable/ec_shop_ic_shopservice"
                        app:actualImageScaleType="fitXY"/>
                    <FrameLayout
                        android:id="@+id/ec_store_top_more_or_share_btn"
                        android:layout_width="24sp"
                        android:layout_height="24sp">
                        <com.facebook.drawee.view.SimpleDraweeView
                            android:id="@+id/ec_store_top_bar_more_btn"
                            android:focusable="true"
                            android:layout_width="24sp"
                            android:layout_height="24sp"
                            android:src="@drawable/shopping_ic_store_compat_more_white"
                            android:contentDescription="@string/shopping_more"/>
                        <com.facebook.drawee.view.SimpleDraweeView
                            android:id="@+id/ec_store_top_bar_share_btn"
                            android:focusable="true"
                            android:visibility="gone"
                            android:layout_width="24sp"
                            android:layout_height="24sp"
                            android:src="@drawable/ec_shop_ic_share"
                            app:actualImageScaleType="fitXY"/>
                    </FrameLayout>
                    <FrameLayout
                        android:id="@+id/ec_store_fold_close_btn"
                        android:visibility="gone"
                        android:layout_width="24sp"
                        android:layout_height="24sp"
                        android:layout_marginLeft="8dp">
                        <ImageView
                            android:id="@+id/ec_store_fold_close_btn_image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/shopping_ic_store_sheet_close_black"/>
                    </FrameLayout>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/ec_store_applet_capsule_container"
                    android:visibility="gone"
                    android:clipChildren="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/ec_store_top_bar_tool_btn"
                    android:focusable="true"
                    android:visibility="gone"
                    android:layout_width="30sp"
                    android:layout_height="30sp"
                    android:layout_marginLeft="12dp"
                    android:src="@drawable/shopping_ic_store_compat_more_white"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="13dp"
                    android:layout_alignParentEnd="true"
                    app:actualImageScaleType="fitXY"/>
                <com.bytedance.android.shopping.store.home.view.ECStoreCollapsibleTextView
                    android:gravity="start|center_vertical"
                    android:id="@+id/ec_store_top_bar_search"
                    android:visibility="invisible"
                    android:layout_width="match_parent"
                    android:layout_height="33dp"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/commerce_search"
                    android:layout_marginStart="48dp"
                    android:layout_toStartOf="@+id/ec_store_right_item_container"/>
            </RelativeLayout>
            <FrameLayout
                android:id="@+id/ec_store_top_bar_container_slice"
                android:visibility="gone"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="44sp"/>
            <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
                android:id="@+id/ec_shop_top_bar_cross_shop_title_image"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </LinearLayout>
</FrameLayout>
