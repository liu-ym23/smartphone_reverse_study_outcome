<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_white_radius8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/token_login_close_icon"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ttlive_ic_close_black_vector"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/ttlive_color_161823"
        android:id="@+id/token_login_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/ttlive_token_login_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/ttlive_color_BF_161823"
        android:id="@+id/token_login_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ttlive_token_login_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/token_login_title"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/token_login_avatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/token_login_hint"
        app:placeholderImage="@drawable/ttlive_ic_default_head_small"
        app:roundAsCircle="true"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/ttlive_color_161823"
        android:id="@+id/token_login_username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/ttlive_token_login_username"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/token_login_avatar"/>
    <Button
        android:textColor="@color/ttlive_color_161823"
        android:id="@+id/token_login_cancel_btn"
        android:background="@drawable/ttlive_bg_0d161823_round_8_btn"
        android:layout_width="0dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="16dp"
        android:text="@string/ttlive_token_login_cancel_btn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/token_login_confirm_btn"
        app:layout_constraintTop_toBottomOf="@+id/token_login_username"
        app:layout_constraintVertical_bias="1"
        style="@style/uicomponent_button_style_secondary_l"/>
    <Button
        android:id="@+id/token_login_confirm_btn"
        android:background="@drawable/ttlive_bg_fe2c55_round_8_btn"
        android:layout_width="0dp"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/ttlive_token_login_confirm_btn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/token_login_cancel_btn"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/token_login_username"
        app:layout_constraintVertical_bias="1"
        style="@style/uicomponent_button_style_primary_l"/>
</androidx.constraintlayout.widget.ConstraintLayout>
