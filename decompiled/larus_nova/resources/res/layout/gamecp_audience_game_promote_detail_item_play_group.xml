<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/gamecp_game_F8F8F8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/shape_bg_ffffff_corner_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15dp"
            android:textColor="#161823"
            android:id="@+id/tv_item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:text="@string/ttlive_game_promote_anchor_playwith"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/view_bg"
            android:background="@drawable/shape_bg_08161823_conrner_2"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_margin="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_item_title"/>
        <com.bytedance.android.gamecp.common.ui.HSImageView
            android:id="@+id/group_portrait"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/view_bg"
            app:layout_constraintStart_toStartOf="@+id/view_bg"
            app:layout_constraintTop_toTopOf="@+id/view_bg"
            app:placeholderImage="@drawable/gamecp_game_avatar_placeholder"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/gamecp_black"
            android:ellipsize="end"
            android:id="@+id/tv_group_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/group_portrait"
            app:layout_constraintEnd_toStartOf="@+id/tv_group_num"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/group_portrait"
            app:layout_constraintTop_toTopOf="@+id/group_portrait"
            app:layout_constraintVertical_bias="0"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/gamecp_black"
            android:ellipsize="end"
            android:id="@+id/tv_group_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:maxLines="1"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/tv_group_name"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintLeft_toRightOf="@+id/tv_group_name"
            app:layout_constraintRight_toLeftOf="@+id/btn_confirm"
            app:layout_constraintTop_toTopOf="@+id/tv_group_name"
            app:layout_constraintVertical_bias="0"/>
        <TextView
            android:textSize="12dp"
            android:ellipsize="end"
            android:id="@+id/tv_group_des"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="20dp"
            android:maxLines="1"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/group_portrait"
            app:layout_constraintEnd_toStartOf="@+id/btn_confirm"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintLeft_toLeftOf="@+id/tv_group_name"
            app:layout_constraintRight_toRightOf="@+id/tv_group_name"
            app:layout_constraintStart_toStartOf="@+id/tv_group_name"
            app:layout_constraintTop_toBottomOf="@+id/tv_group_name"
            app:layout_constraintVertical_bias="0.2"/>
        <Button
            android:textSize="13dp"
            android:id="@+id/btn_confirm"
            android:background="@drawable/gamecp_bg_order_join_group_btn"
            android:layout_width="70dp"
            android:layout_height="28dp"
            android:layout_marginRight="12dp"
            android:text="@string/ttlive_game_promote_join"
            app:layout_constraintBottom_toBottomOf="@+id/group_portrait"
            app:layout_constraintEnd_toEndOf="@+id/view_bg"
            app:layout_constraintTop_toTopOf="@+id/group_portrait"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
