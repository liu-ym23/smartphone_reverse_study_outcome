<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.shopping.inflow.view.TopRoundRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/product_feed_detail_roundlayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/product_feed_main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.shopping.anchorv3.widget.FixedRecyclerView
            android:id="@+id/product_feed_recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/product_feed_swipe_tip_bar"
            android:background="@drawable/commerce_swipe_tip_bar"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <com.bytedance.android.shopping.feed.view.InnerFeedPageHeadWidget
        android:id="@+id/product_feed_head_view"
        android:layout_width="match_parent"
        android:layout_height="100dp"/>
    <com.bytedance.android.shopping.feed.view.InnerFeedPageRightWidget
        android:id="@+id/product_feed_right_bottom_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="35dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
</com.bytedance.android.shopping.inflow.view.TopRoundRelativeLayout>
