<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#85000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout
        android:layout_gravity="center"
        android:id="@+id/round_container"
        android:layout_width="262dp"
        android:layout_height="468dp"
        app:ttlive_allRadius="8dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/cover_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <TextureView
            android:id="@+id/tv_render"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.live.ktv.common.view.PreviewProgressView
            android:layout_gravity="bottom"
            android:id="@+id/preview_progress"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/play_btn"
            android:background="@drawable/ttlive_opus_preview_play"
            android:visibility="gone"
            android:layout_width="55dp"
            android:layout_height="55dp"/>
        <View
            android:background="@drawable/opus_preview_selected_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout>
    <com.bytedance.android.live.ktv.common.view.CommomKtvButton
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/tv_comfirm"
        android:visibility="gone"
        android:layout_width="330dp"
        android:layout_height="45dp"
        android:layout_marginBottom="20dp"
        android:text="播放此MV"/>
</FrameLayout>
