<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/share_product_container"
        android:layout_width="?attr/larus_dp_1"
        android:layout_height="?attr/larus_dp_1"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="?attr/larus_neutral_100"
        android:id="@+id/failed_state_container"
        android:background="?attr/larus_card_bg_static_disable"
        android:paddingTop="?attr/larus_dp_12"
        android:paddingBottom="?attr/larus_dp_12"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="?attr/larus_dp_300"
        android:text="@string/larus_music_generate_failed"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_16"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/enable_state_container"
        android:layout_width="?attr/larus_dp_300"
        android:layout_height="?attr/larus_dp_400">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/cover_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@drawable/larus_bg_ugc_create_failure_placeholder"
            app:failureImageScaleType="centerCrop"
            app:placeholderImage="@drawable/larus_bg_ugc_create_failure_placeholder"
            app:placeholderImageScaleType="centerCrop"
            app:roundedCornerRadius="?attr/larus_dp_10"/>
        <com.larus.bmhome.chat.layout.holder.progressloading.ImageWebpLoadingBgView
            android:id="@+id/cover_loading_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.7"
            app:actualImageScaleType="centerCrop"
            app:placeholderImage="@drawable/larus_bg_ugc_create_placeholder"/>
        <View
            android:id="@+id/tint_shadow_layer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:alpha="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/container_cover_thumb"
            android:layout_width="?attr/larus_dp_64"
            android:layout_height="?attr/larus_dp_64"
            android:layout_marginTop="?attr/larus_dp_16"
            android:layout_marginStart="?attr/larus_dp_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.lynx.lottieadapter.LottieAdapterView
                android:layout_gravity="center"
                android:id="@+id/loading_view"
                android:visibility="visible"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/cover_image_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:actualImageScaleType="centerCrop"
                app:failureImage="@drawable/larus_bg_music_save_cover_default_2"
                app:failureImageScaleType="centerCrop"
                app:placeholderImage="@drawable/larus_bg_music_transparent_cover_placeholder"
                app:placeholderImageScaleType="centerCrop"
                app:roundedCornerRadius="?attr/larus_dp_8"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/player_container"
            android:layout_width="?attr/larus_dp_48"
            android:layout_height="?attr/larus_dp_48"
            android:layout_marginEnd="?attr/larus_dp_8"
            app:layout_constraintBottom_toBottomOf="@+id/container_cover_thumb"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/container_cover_thumb">
            <com.larus.common_ui.widget.CircleProgressBar
                android:layout_gravity="center"
                android:id="@+id/progress_bar"
                android:visibility="invisible"
                android:layout_width="?attr/larus_dp_33"
                android:layout_height="?attr/larus_dp_33"
                android:progress="2"
                app:larus_maxProgress="100"
                app:larus_progressbarBackgroundColor="@color/static_white_transparent_2"
                app:larus_progressbarColor="@color/larus_static_white"
                app:larus_radius="3dp"
                app:larus_strokeWidth="2.5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/play_image"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@null"
                app:srcCompat="@drawable/larus_music_play_img"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/pause_image"
                android:visibility="visible"
                android:layout_width="?attr/larus_dp_10"
                android:layout_height="?attr/larus_dp_13"
                android:layout_marginBottom="?attr/larus_dp_1"
                android:contentDescription="@null"
                app:srcCompat="@drawable/larus_music_pause_img"/>
        </FrameLayout>
        <TextView
            android:textSize="?attr/larus_sp_16"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:ellipsize="end"
            android:id="@+id/song_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="?attr/larus_dp_128"
            android:maxLines="1"
            android:layout_marginStart="?attr/larus_dp_16"
            android:layout_alignParentStart="true"
            app:layout_constraintBottom_toTopOf="@+id/song_author"
            app:layout_constraintStart_toEndOf="@+id/container_cover_thumb"
            app:layout_constraintTop_toTopOf="@+id/container_cover_thumb"/>
        <com.larus.bmhome.music.widget.AuthorView
            android:textSize="?attr/larus_sp_13"
            android:textColor="@color/static_white_transparent_4"
            android:ellipsize="end"
            android:id="@+id/song_author"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="?attr/larus_dp_16"
            android:layout_marginEnd="?attr/larus_dp_16"
            android:layout_alignParentStart="true"
            app:layout_constraintBottom_toBottomOf="@+id/container_cover_thumb"
            app:layout_constraintEnd_toStartOf="@+id/player_container"
            app:layout_constraintStart_toEndOf="@+id/container_cover_thumb"
            app:layout_constraintTop_toBottomOf="@+id/song_name"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_edit"
            android:padding="?attr/larus_dp_4"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/song_name"
            app:layout_constraintStart_toEndOf="@+id/song_name"
            app:layout_constraintTop_toTopOf="@+id/song_name"
            app:srcCompat="@drawable/larus_ic_edit_white"/>
        <com.larus.bmhome.music.widget.MusicBoxLyricView
            android:id="@+id/lyrics_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="?attr/larus_dp_16"
            android:layout_marginBottom="?attr/larus_dp_5"
            android:layout_marginStart="?attr/larus_dp_16"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="@+id/divider"
            app:layout_constraintTop_toBottomOf="@+id/container_cover_thumb"/>
        <View
            android:id="@+id/divider"
            android:background="@color/static_white_transparent_2"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginBottom="?attr/larus_dp_10"
            android:layout_marginStart="?attr/larus_dp_16"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintBottom_toTopOf="@+id/btn_share"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_download"
            android:layout_width="?attr/larus_dp_36"
            android:layout_height="?attr/larus_dp_36"
            android:layout_marginBottom="?attr/larus_dp_16"
            android:contentDescription="@string/larus_accessibility_save"
            android:layout_marginStart="?attr/larus_dp_10"
            android:layout_marginEnd="?attr/larus_dp_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/larus_ic_download_white"/>
        <ProgressBar
            android:id="@+id/btn_download_loading"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="?attr/larus_dp_8"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/larus_ic_common_download_loading_animated"
            android:indeterminateDuration="2000"
            app:layout_constraintBottom_toBottomOf="@+id/btn_download"
            app:layout_constraintEnd_toEndOf="@+id/btn_download"
            app:layout_constraintStart_toStartOf="@+id/btn_download"
            app:layout_constraintTop_toTopOf="@+id/btn_download"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_share"
            android:layout_width="?attr/larus_dp_36"
            android:layout_height="?attr/larus_dp_36"
            android:layout_marginBottom="?attr/larus_dp_16"
            android:contentDescription="@string/larus_accessibility_icon_share"
            android:layout_marginStart="?attr/larus_dp_5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btn_download"
            app:srcCompat="@drawable/larus_ic_share_white"/>
        <com.larus.common_ui.widget.roundlayout.RoundConstraintLayout
            android:id="@+id/publish_container"
            android:paddingLeft="?attr/larus_dp_10"
            android:paddingRight="?attr/larus_dp_10"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_36"
            android:layout_marginBottom="?attr/larus_dp_16"
            android:minWidth="?attr/larus_dp_100"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:rv_backgroundColor="@color/static_white_transparent_1"
            app:rv_cornerRadius="?attr/larus_dp_8">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/publish_icon"
                    android:layout_width="?attr/larus_dp_18"
                    android:layout_height="?attr/larus_dp_18"
                    android:src="@drawable/larus_creation_publish_card"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_sp_14"
                    android:textColor="@color/larus_static_white"
                    android:ellipsize="end"
                    android:id="@+id/publish_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_ccMob_PreviewPage_btn_makePublic"
                    android:maxLines="1"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="?attr/larus_dp_4"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/publish_icon"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.larus.common_ui.widget.roundlayout.RoundConstraintLayout>
        <com.larus.common_ui.widget.roundlayout.RoundConstraintLayout
            android:id="@+id/privacy_button_container"
            android:paddingLeft="?attr/larus_dp_12"
            android:paddingRight="?attr/larus_dp_12"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_36"
            android:layout_marginBottom="?attr/larus_dp_16"
            android:minWidth="?attr/larus_dp_98"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:rv_backgroundColor="@color/static_white_transparent_1"
            app:rv_cornerRadius="?attr/larus_dp_8">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_sp_14"
                    android:textColor="@color/larus_static_white"
                    android:ellipsize="end"
                    android:id="@+id/privacy_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="?attr/larus_dp_170"
                    android:text="@string/larus_add_creation_private"
                    android:maxLines="1"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/more"
                    android:layout_width="?attr/larus_dp_14"
                    android:layout_height="?attr/larus_dp_14"
                    android:src="@drawable/larus_creation_private_more_message"
                    android:layout_marginStart="?attr/larus_dp_4"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/privacy_text"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.larus.common_ui.widget.roundlayout.RoundConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
