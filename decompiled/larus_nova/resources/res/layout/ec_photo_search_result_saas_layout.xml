<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/search_mix_feed_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/tool_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/list_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.ss.android.ugc.aweme.search.vision.result.panel.widget.PhotoSearchCoordinatorLayout
            android:id="@+id/nested_coordinator"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/search_photo_appbar_bg"
                android:background="@drawable/search_photo_bg_appbar"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="88dp"/>
            <com.ss.android.ugc.aweme.search.vision.result.panel.widget.PhotoSearchAppbarLayout
                android:id="@+id/photo_search_appbar"
                android:fadingEdge="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:elevation="0dp"
                app:layout_behavior="com.ss.android.ugc.aweme.search.vision.result.panel.widget.PhotoSearchAppbarLayout$Behavior"
                app:liftOnScroll="true">
                <com.ss.android.ugc.aweme.search.vision.widget.header.AppBarHeaderLevelViewContainer
                    android:orientation="vertical"
                    android:id="@+id/photo_search_fixed_top_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/photo_search_fixed_top_level1_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/photo_search_fixed_top_level2_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </com.ss.android.ugc.aweme.search.vision.widget.header.AppBarHeaderLevelViewContainer>
            </com.ss.android.ugc.aweme.search.vision.result.panel.widget.PhotoSearchAppbarLayout>
            <FrameLayout
                android:id="@+id/feed_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">
                <FrameLayout
                    android:id="@+id/feed_list_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.ss.android.ugc.aweme.search.common.list.ESSaasCommonList
                        android:id="@+id/ec_search_common_list"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </FrameLayout>
                <com.ss.android.ugc.aweme.search.vision.result.status.DefaultStatusView
                    android:id="@+id/status"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
        </com.ss.android.ugc.aweme.search.vision.result.panel.widget.PhotoSearchCoordinatorLayout>
        <com.ss.android.ugc.aweme.search.vision.filter.PhotoSearchFilterBoard
            android:id="@+id/filter_board_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <include layout="@layout/ec_search_right_bottom_btn_container"/>
    </FrameLayout>
</LinearLayout>
