<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/anchor_v3_guess_u_like_rootview"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.ec.core.widget.RoundedLinearLayout
        android:orientation="vertical"
        android:id="@+id/anchor_v3_recommend_product_container"
        android:background="@color/BGReverse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:rounded_radius="4dp">
        <com.bytedance.android.ec.core.widget.RoundedLinearLayout
            android:orientation="vertical"
            android:id="@+id/anchor_v3_guess_u_like_touch_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rounded_radius="4dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.bytedance.android.shopping.widget.legacy.SquareImageView
                    android:id="@+id/iv_guess_u_like_image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:placeholderImage="@drawable/commerce_promotion_place_holder"
                    app:placeholderImageScaleType="fitCenter"/>
                <TextView
                    android:textSize="8dp"
                    android:textColor="@color/ec_color_white"
                    android:layout_gravity="bottom|right"
                    android:id="@+id/tv_ad_tag"
                    android:background="@drawable/anchor_v3_guess_u_like_advertisement_bg"
                    android:padding="1dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:layout_marginBottom="5dp"
                    android:text="@string/guess_u_like_advertisement"
                    android:alpha="0.75"/>
            </FrameLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/ec_std_recommend_title_text"
                android:id="@+id/tv_guess_u_like_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="10dp"
                android:maxLines="2"
                android:lineSpacingExtra="2dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_guess_u_like_extra_info_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp">
                <TextView
                    android:textColor="@color/Primary"
                    android:gravity="center"
                    android:id="@+id/anchor_v3_guess_u_like_seckill_tag"
                    android:background="@drawable/ec_commerce_bg_discount_tag_view"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginRight="4dp"
                    android:text="@string/sec_kill"
                    android:layout_marginEnd="4dp"
                    style="@style/font_size_22"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/cv_guess_u_like_coupon"
                    android:background="@drawable/ec_commerce_bg_discount_tag_view"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp">
                    <TextView
                        android:textColor="@color/Primary"
                        android:gravity="center"
                        android:id="@+id/anchor_v4_gul_coupon_prefix_text"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/coupon_coupon"
                        style="@style/font_size_22"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/anchor_v4_gul_coupon_divider"
                        android:visibility="visible"
                        android:layout_width="0.5dp"
                        android:layout_height="match_parent"
                        android:src="@drawable/ecommerce_coupon_divider"/>
                    <TextView
                        android:textColor="@color/Primary"
                        android:gravity="center"
                        android:id="@+id/anchor_v4_gul_coupon_text"
                        android:paddingLeft="4dp"
                        android:paddingRight="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        style="@style/font_size_22"/>
                </LinearLayout>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/anchorv3_price_info_layout"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginLeft="@dimen/commerce_anchor_v3_recommend_price_margin_left"
                android:layout_marginStart="@dimen/commerce_anchor_v3_recommend_price_margin_left">
                <com.bytedance.android.shopping.widget.PriceView
                    android:id="@+id/anchorv3_guess_u_like_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    app:priceBold="true"
                    app:priceDecimalTextSize="17sp"
                    app:priceText="111"
                    app:priceTextColor="@color/ec_std_recommend_price_text"
                    app:priceTextSize="17sp"
                    app:pv_suffixTextMarginLeft="4dp"
                    app:pv_suffixTextSizeRatio="0.6111"
                    app:spaceSize="2dp"
                    app:thinDecimal="true"
                    app:yangTextSize="13sp"/>
                <TextView
                    android:textColor="@color/ec_std_recommend_sale_text"
                    android:id="@+id/anchorv3_guess_u_like_sales"
                    android:focusable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/commerce_anchor_v3_recommend_price_margin_right"
                    android:layout_marginTop="9dp"
                    android:layout_toRightOf="@+id/anchorv3_guess_u_like_price"
                    android:layout_alignBaseline="@+id/anchorv3_guess_u_like_price"
                    android:layout_marginStart="@dimen/commerce_anchor_v3_recommend_price_margin_right"
                    android:layout_toEndOf="@+id/anchorv3_guess_u_like_price"
                    style="@style/font_size_22"/>
                <ImageView
                    android:id="@+id/anchor_v3_iv_guess_u_like_more"
                    android:paddingLeft="4dp"
                    android:paddingTop="10dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone"
                    android:layout_width="@dimen/commerce_anchor_v3_recommend_more_btn_size"
                    android:layout_height="match_parent"
                    android:src="@drawable/ec_commerce_guess_u_like_more_btn"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/shopping_more"
                    android:paddingStart="4dp"
                    android:paddingEnd="8dp"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/anchorv3_recommend_price_info_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginLeft="@dimen/commerce_anchor_v3_recommend_price_margin_left"
                android:layout_marginRight="8dp"
                android:layout_marginStart="@dimen/commerce_anchor_v3_recommend_price_margin_left"
                android:layout_marginEnd="8dp">
                <com.bytedance.android.shopping.widget.PriceView
                    android:id="@+id/anchorv3_recommend_guess_u_like_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    app:priceBold="true"
                    app:priceDecimalTextSize="17sp"
                    app:priceText="111"
                    app:priceTextColor="@color/Primary"
                    app:priceTextSize="17sp"
                    app:pv_suffixTextMarginLeft="4dp"
                    app:pv_suffixTextSizeRatio="0.6111"
                    app:spaceSize="2dp"
                    app:thinDecimal="true"
                    app:yangTextSize="13sp"/>
                <TextView
                    android:textColor="@color/ec_std_recommend_sale_text"
                    android:id="@+id/anchorv3_recommend_tv_guess_u_like_sales"
                    android:focusable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true"
                    style="@style/font_size_22"/>
            </RelativeLayout>
        </com.bytedance.android.ec.core.widget.RoundedLinearLayout>
        <include
            android:id="@+id/anchor_v3_recommend_reason_info"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/ec_commerce_anchor_v3_recommend_reason_layout"/>
        <FrameLayout
            android:id="@+id/anchor_v3_new_recommend_reason_info"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:layout_marginBottom="9dp">
            <TextView
                android:textSize="12sp"
                android:textColor="#fa9446"
                android:ellipsize="end"
                android:id="@+id/anchor_v3_new_recommend_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:includeFontPadding="false"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/anchor_v3_new_rank"
                android:background="@drawable/ec_commerce_bg_new_recomend"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="11sp"
                    android:textColor="@color/commerce_color_FE2C55"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/anchor_v3_new_rank_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="11dp"
                    android:textColor="@color/commerce_color_FE2C55"
                    android:id="@+id/anchor_v3_new_rank_No"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="3dp"
                    android:includeFontPadding="false"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/anchor_v3_new_rank_arrow"
                    android:layout_width="9dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_down"
                    android:rotation="-90"/>
            </LinearLayout>
        </FrameLayout>
    </com.bytedance.android.ec.core.widget.RoundedLinearLayout>
    <com.bytedance.android.shopping.anchorv3.view.AnchorV3GuessULikeFeedbackView
        android:id="@+id/anchor_v3_recommend_feedback_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
