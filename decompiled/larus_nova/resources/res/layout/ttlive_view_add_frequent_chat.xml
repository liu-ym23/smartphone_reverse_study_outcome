<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_frequent_chat_add_btn"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <TextView
            android:layout_gravity="center"
            android:id="@+id/add_icon"
            android:background="@drawable/ttlive_add_frequent_comment_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginRight="6dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/ttlive_color_BF_161823"
            android:layout_gravity="center_vertical"
            android:id="@+id/add_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/frequent_chat_add_chat"/>
    </LinearLayout>
</LinearLayout>
