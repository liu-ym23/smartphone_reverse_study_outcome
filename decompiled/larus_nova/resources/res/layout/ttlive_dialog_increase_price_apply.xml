<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/increase_price_apply_dialog_layout"
    android:background="@drawable/ttlive_bg_interact_dialog"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="17dp"
        android:textColor="#161823"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="52dp"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center"
        android:id="@+id/iv_icon"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/ttlive_icon_increase_price_apply_dialog"
        app:actualImageResource="@drawable/ttlive_icon_increase_price_apply_dialog"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <TextView
            android:textSize="20dp"
            android:textColor="#161823"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_paid_count"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/minus_btn"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="24dp"
            android:src="@drawable/ttlive_paid_audience_minus_price_button"
            app:layout_constraintBottom_toBottomOf="@+id/tv_paid_count"
            app:layout_constraintRight_toLeftOf="@+id/tv_paid_count"
            app:layout_constraintTop_toTopOf="@+id/tv_paid_count"/>
        <ImageView
            android:id="@+id/plus_btn"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="24dp"
            android:src="@drawable/ttlive_paid_audience_add_price_button"
            app:layout_constraintBottom_toBottomOf="@+id/tv_paid_count"
            app:layout_constraintLeft_toRightOf="@+id/tv_paid_count"
            app:layout_constraintTop_toTopOf="@+id/tv_paid_count"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_increase_price_tips_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <TextView
            android:textSize="12dp"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_after_increase_price_sort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/increase_price_apply_sort_tips"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_red"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_apply_success_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/debit_after_apply_success_tips"/>
    </LinearLayout>
    <Button
        android:textSize="15dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/btn_increase_price"
        android:background="@drawable/ttlive_increase_price_btn_background"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="20dp"
        android:text="@string/increase_price_immediately_tips"/>
</LinearLayout>
