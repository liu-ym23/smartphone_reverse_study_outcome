<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/anchor_v4_find_same_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.shopping.anchorv4.voavhs.head.view.AnchorV4FindSameItemView
        android:id="@+id/find_same_item_1"
        android:background="@drawable/commerce_anchor_v4_find_same_item_bg"
        android:layout_width="128dp"
        android:layout_height="128dp"
        app:layout_constraintBottom_toTopOf="@+id/find_same_item_3"
        app:layout_constraintEnd_toStartOf="@+id/find_same_item_2"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:roundedCornerRadius="8dp"/>
    <com.bytedance.android.shopping.anchorv4.voavhs.head.view.AnchorV4FindSameItemView
        android:id="@+id/find_same_item_2"
        android:background="@drawable/commerce_anchor_v4_find_same_item_bg"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:layout_marginLeft="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/find_same_item_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/find_same_item_1"
        app:layout_constraintTop_toTopOf="@+id/find_same_item_1"
        app:roundedCornerRadius="8dp"/>
    <com.bytedance.android.shopping.anchorv4.voavhs.head.view.AnchorV4FindSameItemView
        android:id="@+id/find_same_item_3"
        android:background="@drawable/commerce_anchor_v4_find_same_item_bg"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/find_same_item_1"
        app:layout_constraintRight_toRightOf="@+id/find_same_item_1"
        app:layout_constraintTop_toBottomOf="@+id/find_same_item_1"
        app:roundedCornerRadius="8dp"/>
    <ImageView
        android:id="@+id/find_same_item_4"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:layout_marginLeft="8dp"
        android:src="@drawable/commerce_anchor_v4_find_same_item_4_bg"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/find_same_item_3"
        app:layout_constraintLeft_toRightOf="@+id/find_same_item_3"
        app:layout_constraintTop_toTopOf="@+id/find_same_item_3"
        app:roundedCornerRadius="8dp"/>
    <ImageView
        android:id="@+id/find_same_blur_mask"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@color/commerce_color_80FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/find_same_fall_back_img"
        android:visibility="gone"
        android:layout_width="196dp"
        android:layout_height="196dp"
        app:layout_constraintBottom_toTopOf="@+id/find_same_fall_back_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:roundedCornerRadius="8dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/find_same_fall_back_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ec_commerce_find_same_fall_back_text"
        android:drawableRight="@drawable/commerce_anchor_v4_find_same_fall_back_arrow"
        android:drawablePadding="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/find_same_fall_back_img"
        app:layout_constraintStart_toStartOf="@+id/find_same_fall_back_img"
        app:layout_constraintTop_toBottomOf="@+id/find_same_fall_back_img"/>
</androidx.constraintlayout.widget.ConstraintLayout>
