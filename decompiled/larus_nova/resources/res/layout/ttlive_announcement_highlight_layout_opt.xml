<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.interactivity.api.DragContainer xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:layout_width="106dp"
    android:layout_height="wrap_content"
    android:maxHeight="68dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_root"
        android:layout_width="106dp"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="11dp"
            android:textStyle="bold"
            android:id="@+id/text_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="5dp"
            android:text="直播预告的"
            android:maxLines="2"
            android:lineSpacingExtra="3dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/btn_close"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/btn_close"
            android:padding="6dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/live_announce_highlight_close_anchor_opt"
            android:contentDescription="@string/ttlive_advance_announcement_close_content_description"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/divider"
            android:background="@color/ttlive_color_1F_161823"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0.5dp"
            android:layout_marginTop="7dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_desc"/>
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/layout_anchor_subscribe_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="7dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_desc">
            <TextView
                android:textSize="13dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/text_subscribe_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="10dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_announcement_highlight_subscribe_count_suffix"
                android:layout_alignBaseline="@+id/text_subscribe_count"
                android:layout_marginStart="2dp"
                android:layout_toEndOf="@+id/text_subscribe_count"/>
        </RelativeLayout>
        <LinearLayout
            android:id="@+id/layout_audience_subscribe_info"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:contentDescription="@string/ttlive_announcement_highlight_subscribe_content_description"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_icon"
                android:visibility="visible"
                android:layout_width="12dp"
                android:layout_height="12dp"/>
            <TextView
                android:textSize="11dp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_announcement_highlight_title_color_audience_opt"
                android:gravity="center"
                android:id="@+id/btn_subscribe"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginLeft="5dp"
                android:text="@string/ttlive_announcement_highlight_subscribe_btn"
                android:importantForAccessibility="no"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.bytedance.android.livesdk.interactivity.api.DragContainer>
