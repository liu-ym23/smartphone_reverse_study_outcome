<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/commerce_color_FF264A"
        android:gravity="center_vertical"
        android:background="@drawable/ec_commerce_anchor_v3_bg_pre_seckill_tip"
        android:paddingLeft="6dp"
        android:paddingTop="3dp"
        android:paddingRight="6dp"
        android:paddingBottom="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/commerce_tip_pre_seckill"
        style="@style/font_size_20"/>
    <TextView
        android:textColor="@color/commerce_color_80161823"
        android:id="@+id/commerce_anchor_v3_tv_pre_seckill_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginStart="8dp"
        style="@style/font_size_24"/>
    <TextView
        android:textColor="@color/commerce_color_80161823"
        android:paddingBottom="0.5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:text="@string/commerce_tip_pre_seckill_price"
        android:layout_marginStart="6dp"
        style="@style/font_size_24"/>
    <com.bytedance.android.shopping.widget.PriceView
        android:id="@+id/commerce_anchor_v3_pre_seckill_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="0.5dp"
        android:layout_marginStart="4dp"
        app:extraTextColor="@color/commerce_color_80161823"
        app:extraTextSize="12dp"
        app:priceText="100.1"
        app:priceTextColor="@color/commerce_color_80161823"
        app:priceTextSize="12dp"
        app:spaceSize="0dp"
        app:yangTextSize="12dp"/>
</LinearLayout>
