<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <FrameLayout
        android:id="@+id/bank_icon_item2_layout"
        android:layout_width="@dimen/cj_pay_padding_24"
        android:layout_height="@dimen/cj_pay_padding_24"
        android:layout_marginLeft="16dp"
        android:layout_centerVertical="true">
        <ImageView
            android:id="@+id/bank_card__item2_icon"
            android:layout_width="@dimen/cj_pay_padding_24"
            android:layout_height="@dimen/cj_pay_padding_24"/>
        <ImageView
            android:id="@+id/bank_card_icon_unable_item2_mask"
            android:visibility="gone"
            android:layout_width="@dimen/cj_pay_padding_24"
            android:layout_height="@dimen/cj_pay_padding_24"
            android:src="@drawable/cj_pay_bg_payment_icon_unable_style_5"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bank_card_content_item2_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="52dp"
        android:layout_centerVertical="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <TextView
                android:textSize="15sp"
                android:textColor="#161823"
                android:ellipsize="end"
                android:id="@+id/bank_card_name_item2_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:includeFontPadding="false"/>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#57161823"
                    android:ellipsize="end"
                    android:id="@+id/bank_card_sub_title_item2_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cj_pay_padding_4"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/cj_pay_color_red"
                    android:gravity="center"
                    android:id="@+id/bank_card_recommend_mark_item2_tv"
                    android:background="@drawable/cj_pay_bg_payment_method_recommend_way"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cj_pay_padding_4"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    <com.android.ttcjpaysdk.base.theme.widget.CJPayCircleCheckBox
        android:id="@+id/bank_card_select_item2_checkbox"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="@dimen/cj_pay_padding_16"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        app:CJPayEnableBgDrawable="@drawable/cj_pay_icon_check_box_pressed2"
        app:CJPayUnenbleBgDrawable="@drawable/cj_pay_icon_check_box_normal2"
        app:CJPayWithCircleWhenUnchecked="true"/>
</RelativeLayout>
