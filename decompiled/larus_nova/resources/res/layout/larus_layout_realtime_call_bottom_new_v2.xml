<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/voice_call_status_container"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_68"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@+id/voice_call_bottom_control_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintVertical_chainStyle="packed">
        <FrameLayout
            android:id="@+id/realtime_call_status_icon_container"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/voice_call_status_text"
            app:layout_constraintEnd_toStartOf="@+id/voice_call_status_text"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/voice_call_status_text">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/realtime_call_status_icon"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.larus.av_call.view.RealtimeCallStatusAudioVisualizer
                android:layout_gravity="center"
                android:id="@+id/realtime_call_status_icon_anim"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <com.larus.common_ui.widget.UrlSpanTextView
            android:textSize="?attr/larus_dp_16"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/voice_call_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:larus_linkColor="@color/larus_rtc_notification_btn_light"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/realtime_call_status_icon_container"/>
        <ProgressBar
            android:id="@+id/realtime_call_loading"
            android:paddingTop="?attr/larus_dp_5"
            android:layout_width="?attr/larus_dp_29"
            android:layout_height="?attr/larus_dp_29"
            android:layout_marginBottom="?attr/larus_dp_16"
            android:indeterminateDrawable="@drawable/larus_bg_loading_process_dark"
            app:layout_constraintBottom_toTopOf="@+id/voice_call_status_text"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <com.larus.common_ui.view.CustomBarCountAudioVisualizer
            android:id="@+id/realtime_call_status_anim"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_120"
            android:layout_height="?attr/larus_dp_29"
            android:layout_marginBottom="?attr/larus_dp_16"
            app:layout_constraintBottom_toTopOf="@+id/voice_call_status_text"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <com.larus.common_ui.view.ChatContinuousAudioVisualizerOpt
            android:id="@+id/continuous_talk_listening_anim"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_68"
            android:layout_height="?attr/larus_dp_48"
            android:layout_marginBottom="?attr/larus_dp_6"
            app:larus_bar_color="@color/larus_neutral_100"
            app:larus_bar_max_height="?attr/larus_dp_46"
            app:larus_bar_min_height="?attr/larus_dp_3"
            app:larus_group_bar_count="4"
            app:larus_side_margin="?attr/larus_dp_0"
            app:larus_top_group_count="1"
            app:layout_constraintBottom_toTopOf="@+id/voice_call_status_text"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/realtime_call_interrupt"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_29"
            android:layout_height="?attr/larus_dp_29"
            android:layout_marginBottom="?attr/larus_dp_16"
            app:layout_constraintBottom_toTopOf="@+id/voice_call_status_text"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:srcCompat="@drawable/larus_ic_realtime_call_interrupt"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.larus.av_call.view.RealtimeCallSuggestView
        android:id="@+id/realtime_call_suggest"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_68"
        android:layout_marginLeft="?attr/larus_dp_30"
        android:layout_marginRight="?attr/larus_dp_30"
        android:layout_marginBottom="?attr/larus_dp_24"
        app:layout_constraintBottom_toTopOf="@+id/voice_call_bottom_control_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintVertical_chainStyle="packed"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/voice_call_bottom_control_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_49"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voice_call_status_container">
        <FrameLayout
            android:id="@+id/realtime_call_mute_container"
            android:layout_width="?attr/larus_dp_76"
            android:layout_height="?attr/larus_dp_76">
            <View
                android:layout_gravity="center"
                android:id="@+id/realtime_call_mute"
                android:background="@drawable/larus_ic_rtc_mute"
                android:layout_width="?attr/larus_dp_76"
                android:layout_height="?attr/larus_dp_76"
                android:contentDescription="@string/larus_call_accessibility_muteHint"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/voice_call_share_screen_container"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_76"
            android:layout_height="?attr/larus_dp_76">
            <View
                android:layout_gravity="center"
                android:id="@+id/voice_call_share_screen"
                android:layout_width="?attr/larus_dp_76"
                android:layout_height="?attr/larus_dp_76"
                android:contentDescription="@string/larus_call_shareScreen_title"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/realtime_call_play_mute_container"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_76"
            android:layout_height="?attr/larus_dp_76">
            <View
                android:layout_gravity="center"
                android:id="@+id/realtime_call_play_mute"
                android:layout_width="?attr/larus_dp_76"
                android:layout_height="?attr/larus_dp_76"
                android:contentDescription="播放静音"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/voice_call_video_container"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_76"
            android:layout_height="?attr/larus_dp_76">
            <View
                android:layout_gravity="center"
                android:id="@+id/voice_call_video"
                android:layout_width="?attr/larus_dp_76"
                android:layout_height="?attr/larus_dp_76"
                android:contentDescription="@string/larus_call_videoCall_title"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/voice_call_subtitle_container"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_76"
            android:layout_height="?attr/larus_dp_76">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/voice_call_subtitle"
                android:layout_width="?attr/larus_dp_76"
                android:layout_height="?attr/larus_dp_76"
                android:scaleType="center"
                android:contentDescription="@string/larus_call_accessibility_showCaptions"/>
        </FrameLayout>
        <com.google.android.material.circularreveal.CircularRevealFrameLayout
            android:id="@+id/voice_call_more_container"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_76"
            android:layout_height="?attr/larus_dp_76">
            <com.larus.av_call.util.RealtimeBottomMoreBtn
                android:layout_gravity="center"
                android:id="@+id/voice_call_more_btn"
                android:layout_width="?attr/larus_dp_76"
                android:layout_height="?attr/larus_dp_76"/>
        </com.google.android.material.circularreveal.CircularRevealFrameLayout>
        <FrameLayout
            android:id="@+id/voice_call_hangup_container"
            android:layout_width="?attr/larus_dp_76"
            android:layout_height="?attr/larus_dp_76"
            android:layout_marginStart="?attr/larus_dp_40"
            android:layout_marginEnd="?attr/larus_dp_40">
            <View
                android:layout_gravity="center"
                android:id="@+id/voice_call_hangup"
                android:background="@drawable/larus_ic_realtime_call_hangup_old_dark"
                android:layout_width="?attr/larus_dp_76"
                android:layout_height="?attr/larus_dp_76"
                android:contentDescription="@string/larus_call_accessibility_endCall"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/voice_call_camera_container"
            android:layout_width="?attr/larus_dp_76"
            android:layout_height="?attr/larus_dp_76">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/voice_call_camera"
                android:layout_width="?attr/larus_dp_76"
                android:layout_height="?attr/larus_dp_76"
                android:src="@drawable/larus_realtime_camera_dark"
                android:alpha="0.4"/>
        </FrameLayout>
    </LinearLayout>
    <TextView
        android:textSize="?attr/larus_dp_12"
        android:textColor="?attr/larus_neutral_transparent_3"
        android:gravity="center"
        android:id="@+id/realtime_call_disclaimer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_12"
        android:text="@string/larus_ai_content_disclaimer_cn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</merge>
