<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ec_color_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.ec.window.base.view.ECWindowRemoteVideoView
        android:id="@+id/ec_shop_inner_flow_video_view"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:paused_icon_height="72dp"
        app:paused_icon_width="72dp"/>
    <com.bytedance.android.window.shop.innerflow.holder.element.barrage.BarrageFrameLayout
        android:id="@+id/ec_shop_inner_flow_barrage_root_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <com.bytedance.android.window.shop.innerflow.holder.element.barrage.BarrageRecycleView
            android:orientation="horizontal"
            android:id="@+id/ec_shop_inner_flow_barrage_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.bytedance.android.window.shop.innerflow.holder.element.barrage.BarrageFrameLayout>
    <com.bytedance.android.window.shop.innerflow.widget.ECControllerViewGroup
        android:gravity="center_vertical"
        android:layout_gravity="bottom|right"
        android:orientation="horizontal"
        android:id="@+id/ec_shop_inner_flow_controller_group"
        android:background="@drawable/shopping_bg_controller_view"
        android:paddingLeft="6dp"
        android:paddingTop="1dp"
        android:paddingRight="6dp"
        android:paddingBottom="1dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:minWidth="26dp"
        android:minHeight="26dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
