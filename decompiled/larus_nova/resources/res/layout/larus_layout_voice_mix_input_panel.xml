<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/audio_visualizer_group"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        app:layout_constraintBottom_toTopOf="@+id/control_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <View
        android:id="@+id/group_shadow"
        android:background="@drawable/larus_fast_button_bg_shadow"
        android:layout_width="?attr/larus_dp_100"
        android:layout_height="?attr/larus_dp_100"
        app:layout_constraintBottom_toBottomOf="@+id/control_container"
        app:layout_constraintEnd_toEndOf="@+id/control_container"
        app:layout_constraintStart_toStartOf="@+id/control_container"
        app:layout_constraintTop_toTopOf="@+id/control_container"/>
    <com.larus.common_ui.widget.roundlayout.RoundConstraintLayout
        android:id="@+id/control_container"
        android:layout_width="?attr/larus_dp_60"
        android:layout_height="?attr/larus_dp_60"
        android:layout_marginTop="?attr/larus_dp_60"
        app:layout_constraintBottom_toTopOf="@+id/audio_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/audio_visualizer_group"
        app:rv_backgroundColor="?attr/larus_base_2"
        app:rv_cornerRadius="?attr/larus_dp_30">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/control_icon"
            android:layout_width="?attr/larus_dp_18"
            android:layout_height="?attr/larus_dp_18"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="?attr/larus_ic_voice_mix_input_start"/>
    </com.larus.common_ui.widget.roundlayout.RoundConstraintLayout>
    <TextView
        android:textSize="?attr/larus_dp_16"
        android:textColor="?attr/larus_neutral_50"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/audio_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        android:text="@string/larus_typeASR_stop"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/control_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
