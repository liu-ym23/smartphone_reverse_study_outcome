<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center"
        android:id="@+id/ttlive_guest_bg"
        android:background="@drawable/ttlive_equal_talkroom_window_empty_bg"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="#57000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/guest_info_container"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/ttlive_guest_container"
            android:visibility="invisible"
            android:layout_width="105dp"
            android:layout_height="105dp"
            app:layout_constraintBottom_toBottomOf="@+id/guest_info_container"
            app:layout_constraintLeft_toLeftOf="@+id/guest_info_container"
            app:layout_constraintRight_toRightOf="@+id/guest_info_container"
            app:layout_constraintTop_toTopOf="@+id/guest_info_container">
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/ttlive_guest_avatar_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.bytedance.android.live.core.widget.HSImageView
                    android:layout_gravity="center"
                    android:id="@+id/ttlive_guest_avatar"
                    android:background="@drawable/ttlive_build_linking_avatar"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    app:roundAsCircle="true"/>
                <com.bytedance.android.livesdk.common.AnchorPauseTipsView
                    android:layout_gravity="center"
                    android:id="@+id/ttlive_leave_view"
                    android:visibility="gone"
                    android:layout_width="86dp"
                    android:layout_height="86dp"/>
            </FrameLayout>
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="center"
                android:id="@+id/ttlive_volume_Anim"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/ttlive_surface_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ttlive_guest_name_container"
            android:background="@drawable/ttlive_bg_guest_camera_user_info"
            android:paddingLeft="4dp"
            android:paddingTop="3dp"
            android:paddingRight="2dp"
            android:paddingBottom="3dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="@+id/guest_info_container"
            app:layout_constraintRight_toRightOf="@+id/guest_info_container">
            <ImageView
                android:id="@+id/ttlive_guest_identification"
                android:visibility="gone"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginRight="2dp"
                android:src="@drawable/ttlive_icon_video_silence"
                android:layout_marginEnd="2dp"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#e6ffffff"
                android:ellipsize="end"
                android:id="@+id/ttlive_guest_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:maxLength="15"
                android:layout_weight="1"/>
            <FrameLayout
                android:id="@+id/ttlive_guest_fans_ticket_count_container"
                android:clipChildren="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:layout_marginTop="1dp"
                android:layout_marginStart="2dp">
                <com.bytedance.android.live.liveinteract.videotalk.quickinteract.interactView.LinkMicQuickInteractView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/ttlive_guest_fans_ticket_count"
                    android:visibility="gone"
                    android:clipChildren="false"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"/>
                <com.bytedance.android.live.liveinteract.videotalk.quickinteract.interactView.ThemedCompetitionQuickInteractView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/ttlive_themed_competition_score"
                    android:visibility="gone"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"/>
            </FrameLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/self_discipline_container"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:layout_marginTop="3dp"
            android:layout_marginStart="3dp"
            app:layout_constraintLeft_toLeftOf="@+id/guest_info_container"
            app:layout_constraintTop_toTopOf="@+id/guest_info_container">
            <com.bytedance.android.live.liveinteract.videotalk.selfdiscipline.ui.SelfDisciplineTimerView
                android:id="@+id/ttlive_self_discipline_timer_view"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="bottom"
                android:id="@+id/ttlive_self_discipline_like_effect"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="7dp"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
