<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">
    <TextView
        android:textSize="17dp"
        android:textColor="#161823"
        android:ellipsize="end"
        android:id="@+id/title_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ttlive_room_channel_member_manage_title"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/count_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/ttlive_room_channel_member_manage_total_member_count"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_view"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/setting_view"
        android:background="@drawable/ttlive_room_channel_member_manage_title_bg"
        android:layout_width="0dp"
        android:layout_height="66dp"
        android:layout_marginTop="20dp"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/invite_view"
        app:layout_constraintTop_toBottomOf="@+id/count_view">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ttlive_icon_room_channel_member_dialog_setting"/>
        <TextView
            android:textSize="13dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_color_161823"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ttlive_chat_channel_setting_title"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/invite_view"
        android:background="@drawable/ttlive_room_channel_member_manage_title_bg"
        android:layout_width="0dp"
        android:layout_height="66dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="20dp"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/setting_view"
        app:layout_constraintRight_toLeftOf="@+id/notice_view"
        app:layout_constraintTop_toBottomOf="@+id/count_view">
        <ImageView
            android:id="@+id/iv_invite_view"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ttlive_icon_room_channel_member_dialog_invite"/>
        <TextView
            android:textSize="13dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_color_161823"
            android:id="@+id/tv_invite_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ttlive_chat_channel_setting_invite"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/notice_view"
        android:background="@drawable/ttlive_room_channel_member_manage_title_bg"
        android:layout_width="0dp"
        android:layout_height="66dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="20dp"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/invite_view"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/count_view">
        <ImageView
            android:id="@+id/iv_notice_view"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ttlive_icon_room_channel_member_dialog_notice"/>
        <TextView
            android:textSize="13dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_color_161823"
            android:id="@+id/tv_notice_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ttlive_chat_channel_notice"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
