<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:overScrollMode="never"
    android:nestedScrollingEnabled="true"
    app:layout_constraintLeft_toLeftOf="parent"
    app:layout_constraintRight_toRightOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ktv_my_dress_tag_container"
            android:background="@drawable/ttlive_bg_ktv_dress_tab_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="13dp"
                android:textColor="#cc000000"
                android:id="@+id/ktv_my_dress_tag_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="13dp"
                android:text="@string/ttlive_ktv_dress_honor_tag_title"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/ktv_my_dress_tag_rule_btn"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ttlive_ic_help"
                app:layout_constraintBottom_toBottomOf="@+id/ktv_my_dress_tag_title"
                app:layout_constraintLeft_toRightOf="@+id/ktv_my_dress_tag_title"
                app:layout_constraintTop_toTopOf="@+id/ktv_my_dress_tag_title"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ktv_my_dress_tag_fold_container"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginRight="8dp"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="13dp"
                    android:textColor="#7f161823"
                    android:id="@+id/ktv_my_dress_tag_fold_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_ktv_dress_unfold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toLeftOf="@+id/ktv_my_dress_tag_fold_iv"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/ktv_my_dress_tag_fold_iv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ttlive_ktv_dress_fold_down"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ktv_my_dress_tag_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="12dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ktv_my_dress_tag_title"/>
            <TextView
                android:textSize="11dp"
                android:textColor="#7f161823"
                android:gravity="center"
                android:id="@+id/ktv_my_dress_honor_tag_empty_tips"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:text="@string/ttlive_ktv_dress_honor_tag_empty_text"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ktv_my_dress_tag_title"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ktv_my_dress_midi_skin_container"
            android:background="@drawable/ttlive_bg_ktv_dress_tab_item"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="20dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ktv_my_dress_tag_container">
            <TextView
                android:textSize="13dp"
                android:textColor="#cc000000"
                android:id="@+id/ktv_my_dress_midi_skin_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="13dp"
                android:text="@string/ttlive_ktv_dress_midi_skin_title"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ktv_my_dress_midi_skin_fold_container"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginRight="8dp"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="13dp"
                    android:textColor="#7f161823"
                    android:id="@+id/ktv_my_dress_midi_skin_fold_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_ktv_dress_unfold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toLeftOf="@+id/ktv_my_dress_midi_skin_fold_iv"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/ktv_my_dress_midi_skin_fold_iv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ttlive_ktv_dress_fold_down"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ktv_my_dress_midi_skin_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="12dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ktv_my_dress_midi_skin_title"/>
            <TextView
                android:textSize="11dp"
                android:textColor="#7f161823"
                android:gravity="center"
                android:id="@+id/ktv_my_dress_midi_skin_empty_tips"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:text="@string/ttlive_ktv_dress_midi_skin_empty_text"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ktv_my_dress_midi_skin_title"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
