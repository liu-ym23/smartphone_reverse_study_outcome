<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_dynamic_emoji_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:id="@+id/avatarEmojiTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:text="@string/ttlive_digit_avatar_emoji_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:id="@+id/operatLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="14dp"
            android:textColor="#808080"
            android:id="@+id/recognitionBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_ktv_avatar_recognition_redo"/>
        <View
            android:layout_gravity="center_vertical"
            android:background="#525252"
            android:layout_width="1px"
            android:layout_height="11dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#808080"
            android:id="@+id/stopAvatarBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_video_avatar_close_avatar"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/talk_room_emoji_list"
        android:paddingLeft="9dp"
        android:paddingRight="9dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@+id/avatarEmojiTitle"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="20dp"
        app:layout_constraintTop_toBottomOf="@+id/talk_room_emoji_list"/>
    <com.bytedance.android.livesdk.chatroom.ui.RtlViewPagerShower
        android:gravity="center"
        android:id="@+id/pager_bottom_shower"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginTop="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/talk_room_emoji_list"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#525252"
        android:gravity="center"
        android:id="@+id/empty_list_tips"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:text="@string/ttlive_talk_room_emoji_list_error_tip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avatarEmojiTitle"/>
    <com.bytedance.android.livesdk.chatroom.ui.DouyinLoadingLayout
        android:id="@+id/list_loading_webp_view"
        android:visibility="gone"
        android:layout_width="90dp"
        android:layout_height="90dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/avatarEmojiTitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
