<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/download_dialog_panel"
        android:background="@drawable/document_select_download_dialog_panel_bg"
        android:paddingTop="@dimen/space_kit_len_8"
        android:paddingBottom="50dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_kit_len_16"
        android:paddingEnd="@dimen/space_kit_len_16">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/download_dialog_close"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/ud_icon_close_small_outlined"
                app:tint="@color/facade_selector_icon_n1"/>
            <TextView
                android:textSize="@dimen/space_kit_font_17"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/download_dialog_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="@dimen/space_kit_len_16"
                android:paddingEnd="@dimen/space_kit_len_16"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/download_dialog_option_container"
            android:background="@drawable/document_select_download_dialog_group_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_kit_len_20"/>
    </LinearLayout>
</FrameLayout>
