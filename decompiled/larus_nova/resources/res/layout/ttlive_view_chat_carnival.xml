<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/chat_carnival_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ttlive_carnival_view_height">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chat_carnival_content_layout"
        android:layout_width="0dp"
        android:layout_height="26dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/chat_carnival_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/chat_carnival_container">
        <ImageView
            android:id="@+id/chat_carnival_bg_black"
            android:background="@drawable/ttlive_bg_black_chat_carnival"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/chat_carnival_bg"
            android:background="@drawable/ttlive_bg_chat_carnival"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/chat_carnival_red_ball"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="25dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/chat_carnival_img_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            app:layout_constraintStart_toStartOf="@+id/chat_carnival_content_layout"
            app:layout_constraintTop_toBottomOf="parent"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/white"
            android:id="@+id/chat_carnival_msg_content"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/chat_carnival_content_layout"
            app:layout_constraintStart_toEndOf="@+id/chat_carnival_img_title"
            app:layout_constraintTop_toTopOf="@+id/chat_carnival_content_layout"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/carnival_countdown"
            android:paddingLeft="2dp"
            android:visibility="visible"
            android:layout_width="45dp"
            android:layout_height="20dp"
            android:layout_marginRight="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/chat_carnival_content_layout"
            app:layout_constraintEnd_toEndOf="@+id/chat_carnival_content_layout"
            app:layout_constraintStart_toEndOf="@+id/chat_carnival_msg_content"
            app:layout_constraintTop_toTopOf="@+id/chat_carnival_content_layout"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/chat_carnival_loading"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="20dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/chat_carnival_content_layout"
            app:layout_constraintEnd_toEndOf="@+id/chat_carnival_content_layout"
            app:layout_constraintStart_toEndOf="@+id/chat_carnival_msg_content"
            app:layout_constraintTop_toTopOf="@+id/chat_carnival_content_layout"/>
        <ImageView
            android:id="@+id/chat_carnival_img_end"
            android:background="@drawable/ttlive_eye_chat_carnival_open"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/chat_carnival_content_layout"
            app:layout_constraintEnd_toEndOf="@+id/chat_carnival_content_layout"
            app:layout_constraintStart_toEndOf="@+id/chat_carnival_msg_content"
            app:layout_constraintTop_toTopOf="@+id/chat_carnival_content_layout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
