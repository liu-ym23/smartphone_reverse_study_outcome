<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_white_round_corner_rect"
    android:layout_width="300dp"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/live_dialog_image_block"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/live_dialog_image"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="50dp"
        android:layout_marginRight="50dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"/>
    <View
        android:id="@+id/live_dialog_top_block"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="16dp"/>
    <TextView
        android:textSize="18dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_live_dialog_title"
        android:gravity="center_horizontal"
        android:id="@+id/live_dialog_title"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <View
        android:id="@+id/live_dialog_title_message_block"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_live_dialog_message"
        android:gravity="center"
        android:id="@+id/live_dialog_message"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:textAllCaps="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <View
        android:id="@+id/live_dialog_bottom_block"
        android:layout_width="match_parent"
        android:layout_height="16dp"/>
    <FrameLayout
        android:id="@+id/live_dialog_frame"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:gravity="end"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <LinearLayout
            android:gravity="end"
            android:orientation="horizontal"
            android:id="@+id/live_dialog_container"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.android.livesdk.widget.FitButton
                android:textSize="15dp"
                android:id="@+id/live_dialog_btn_2"
                android:background="@drawable/ttlive_bg_live_dialog_new"
                android:layout_width="0dp"
                android:layout_weight="1"
                style="@style/ttlive_live_dialog_button_horizontal"/>
            <com.bytedance.android.livesdk.widget.FitButton
                android:textSize="15dp"
                android:textStyle="bold"
                android:id="@+id/live_dialog_btn_1"
                android:background="@drawable/ttlive_bg_live_dialog_new"
                android:layout_width="0dp"
                android:layout_weight="1"
                style="@style/ttlive_live_dialog_button_horizontal"/>
        </LinearLayout>
        <View
            android:background="@drawable/ttlive_dialog_divider_horizontal"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/live_dialog_divider_vertical"
            android:background="@drawable/ttlive_dialog_divider_vertical"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="1dp"/>
    </FrameLayout>
</LinearLayout>
