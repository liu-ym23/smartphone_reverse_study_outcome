<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/credit_pay_voucher_item_layout"
        android:layout_width="124dp"
        android:layout_height="62dp"
        android:layout_marginRight="@dimen/cj_pay_padding_8">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/credit_pay_voucher_item_content_layout"
            android:background="@drawable/cj_pay_bg_credit_pay_voucher_item"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cj_pay_color_red_fe2c55"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_tip_one"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="不分期"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/cj_pay_color_red_fe2c55_opacity_75"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_tip_two"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="免手续费"/>
        </LinearLayout>
        <com.android.ttcjpaysdk.base.ui.component.tag.CJTagView
            android:layout_gravity="right"
            android:id="@+id/tv_right_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</LinearLayout>
