<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:roundedCornerRadius="@dimen/ttlive_dimen_draw_feed_img_corner_radius"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_hs_s5"
        android:id="@+id/text"
        android:paddingLeft="5.5dp"
        android:paddingRight="5.5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginBottom="16dp"
        android:layout_alignLeft="@+id/image"
        android:layout_alignBottom="@+id/image"
        android:importantForAccessibility="no"
        android:paddingStart="5.5dp"
        android:paddingEnd="5.5dp"
        android:layout_marginStart="15dp"
        android:layout_alignStart="@+id/image"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#a3ffffff"
        android:id="@+id/ttlive_label"
        android:background="@drawable/ttlive_bg_banner_label"
        android:paddingLeft="6dp"
        android:paddingTop="3dp"
        android:paddingRight="6dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginBottom="6dp"
        android:includeFontPadding="false"
        android:layout_alignParentLeft="true"
        android:layout_alignParentBottom="true"
        android:importantForAccessibility="no"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:layout_marginStart="8dp"
        android:layout_alignParentStart="true"/>
</RelativeLayout>
