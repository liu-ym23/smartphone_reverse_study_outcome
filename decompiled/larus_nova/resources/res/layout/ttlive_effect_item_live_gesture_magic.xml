<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="80dp"
    android:layout_height="80dp">
    <ImageView
        android:id="@+id/image"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ttlive_effect_ic_gesture_yeah"
        android:layout_centerInParent="true"/>
    <View
        android:id="@+id/background"
        android:background="@drawable/ttlive_effect_bg_dialog_gesture_select"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_centerInParent="true"/>
    <View
        android:id="@+id/red_point"
        android:background="@drawable/ttlive_effect_core_bg_red_point"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="2dp"
        android:layout_alignTop="@+id/image"
        android:layout_alignRight="@+id/image"
        android:layout_marginEnd="2dp"
        android:layout_alignEnd="@+id/image"/>
    <ImageView
        android:id="@+id/download_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ttlive_effect_ic_sticker_download"
        android:layout_alignRight="@+id/image"
        android:layout_alignBottom="@+id/image"
        android:layout_alignEnd="@+id/image"/>
    <ProgressBar
        android:id="@+id/loading"
        android:visibility="gone"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_centerInParent="true"/>
</RelativeLayout>
