<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/cj_pay_bg_grey_f8f8f8_radius_8"
    android:paddingLeft="@dimen/cj_pay_padding_16"
    android:paddingRight="@dimen/cj_pay_padding_16"
    android:layout_width="match_parent"
    android:layout_height="76dp">
    <com.android.ttcjpaysdk.thirdparty.view.CJPayCircularImageView
        android:id="@+id/iv_avatar"
        android:visibility="visible"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@color/cj_pay_color_gray_248"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/cj_pay_color_black_161823"
        android:ellipsize="end"
        android:id="@+id/tv_user_name"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_user_iphone_number"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_avatar"
        app:layout_constraintTop_toTopOf="@+id/iv_avatar"
        app:layout_constraintVertical_bias="0.5"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
        android:id="@+id/tv_user_iphone_number"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cj_pay_padding_4"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_avatar"
        app:layout_constraintStart_toEndOf="@+id/iv_avatar"
        app:layout_constraintTop_toBottomOf="@+id/tv_user_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
