<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.widgets.BaseTitleBar
        android:id="@+id/batch_auth_title_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:widget_widgets_tb_divider_visible="false"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/text_title"
        android:id="@+id/chat_tips"
        android:background="@color/bg_body"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/CreationMobile_Docs_EmbeddedFiles_AccessDetails_Subtitle_Chat_ver2"
        android:layout_below="@+id/batch_auth_title_bar"/>
    <include
        android:id="@+id/chat_layout"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_below="@+id/chat_tips"
        layout="@layout/batch_auth_chat_layout"/>
    <FrameLayout
        android:background="@color/bg_body"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/chat_layout">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/auth_content"
            android:background="@color/bg_body_overlay"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <TextView
                android:layout_gravity="center_vertical"
                android:id="@+id/auth_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="21dp"
                android:text=""
                android:layout_weight="1"/>
            <TextView
                android:textColor="@color/text_link_hover"
                android:layout_gravity="center"
                android:id="@+id/auth_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/recycle_layout"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="44dp">
            <com.scwang.smartrefresh.layout.SmartRefreshLayout
                android:id="@+id/auth_list_refresh_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:srlEnableLoadMore="false"
                app:srlEnableOverScrollBounce="false"
                app:srlEnableOverScrollDrag="false"
                app:srlEnablePreviewInEditMode="true"
                app:srlEnableRefresh="true">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/doc_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.scwang.smartrefresh.layout.SmartRefreshLayout>
        </LinearLayout>
        <com.bytedance.ee.bear.facade.common.widget.BearLottieView
            android:layout_gravity="center"
            android:id="@+id/loading_anim_view"
            android:visibility="gone"
            app:lottie_autoPlay="false"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/loading_anim"
            style="@style/BearLottieView"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/loadingFailedLayout"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="88dp"
            android:layout_marginBottom="88dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:layout_width="125dp"
                android:layout_height="125dp"
                app:srcCompat="@drawable/ccm_empty_negative_load_failed"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/CreationMobile_Common_Placeholder_FailedToLoad"/>
            <com.larksuite.component.universe_design.button.UDButton
                android:textSize="16sp"
                android:textColor="@color/static_white"
                android:layout_gravity="center"
                android:id="@+id/retryBtn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginLeft="7dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="7dp"
                android:text="@string/CreationMobile_Common_ButtonRetry"
                app:ud_backgroundColor="@color/primary_fill_default"
                app:ud_radius="l"
                style="@style/UDButton.Small.Primary"/>
        </LinearLayout>
    </FrameLayout>
</RelativeLayout>
