<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.livesdk.widget.EdgeTransparentView
        android:id="@+id/top_border_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ceremony_top_border"
            android:layout_width="100dp"
            android:layout_height="20dp"/>
    </com.bytedance.android.livesdk.widget.EdgeTransparentView>
    <com.bytedance.android.livesdk.widget.EdgeTransparentView
        android:id="@+id/left_border_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ceremony_left_border"
            android:layout_width="20dp"
            android:layout_height="100dp"/>
    </com.bytedance.android.livesdk.widget.EdgeTransparentView>
    <com.bytedance.android.livesdk.widget.EdgeTransparentView
        android:id="@+id/right_border_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ceremony_right_border"
            android:layout_width="20dp"
            android:layout_height="100dp"/>
    </com.bytedance.android.livesdk.widget.EdgeTransparentView>
    <com.bytedance.android.livesdk.widget.EdgeTransparentView
        android:id="@+id/bottom_border_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ceremony_bottom_border"
            android:layout_width="100dp"
            android:layout_height="20dp"/>
    </com.bytedance.android.livesdk.widget.EdgeTransparentView>
</androidx.constraintlayout.widget.ConstraintLayout>
