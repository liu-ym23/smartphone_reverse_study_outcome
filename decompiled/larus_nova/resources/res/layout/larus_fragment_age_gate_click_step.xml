<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_click_step_back"
        android:padding="?attr/larus_dp_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/larus_ic_back_left"
        android:layout_marginStart="?attr/larus_dp_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_24"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/tv_click_step_title"
        android:paddingLeft="?attr/larus_dp_32"
        android:paddingTop="?attr/larus_dp_30"
        android:paddingRight="?attr/larus_dp_32"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_ageGate_select_title_global"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_click_step_back"/>
    <TextView
        android:textSize="?attr/larus_dp_15"
        android:textColor="@color/neutral_50"
        android:id="@+id/tv_click_step_desc"
        android:paddingLeft="@dimen/dp_32"
        android:paddingRight="@dimen/dp_32"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/larus_dola_ageGate_select_desc_verify_global"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_click_step_title"/>
    <TextView
        android:textSize="?attr/larus_dp_16"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/tv_click_step_cur_step"
        android:paddingLeft="?attr/larus_dp_32"
        android:paddingRight="?attr/larus_dp_32"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_40"
        android:text="@string/larus_ageGate_select_subtitle_range_global"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_click_step_desc"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/indicator_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        android:layout_marginStart="?attr/larus_dp_32"
        android:layout_marginEnd="?attr/larus_dp_32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_click_step_cur_step">
        <View
            android:id="@+id/indicator1"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_2"
            android:layout_weight="1"
            android:layout_marginEnd="?attr/larus_dp_4"/>
        <View
            android:id="@+id/indicator2"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_2"
            android:layout_weight="1"
            android:layout_marginEnd="?attr/larus_dp_4"/>
        <View
            android:id="@+id/indicator3"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_2"
            android:layout_weight="1"
            android:layout_marginEnd="?attr/larus_dp_4"/>
        <View
            android:id="@+id/indicator4"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_2"
            android:layout_weight="1"/>
    </LinearLayout>
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:paddingLeft="?attr/larus_dp_32"
        android:paddingRight="?attr/larus_dp_32"
        android:paddingBottom="?attr/larus_dp_76"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/indicator_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
