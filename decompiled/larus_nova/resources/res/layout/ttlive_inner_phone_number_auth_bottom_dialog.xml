<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bottom_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/close_btn"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="14dp"
        android:layout_alignParentTop="true"
        android:layout_marginStart="20dp"
        android:layout_alignParentStart="true"
        app:srcCompat="@drawable/ttlive_vector_drawable_close"/>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/black"
        android:id="@+id/auth_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="164dp"
        android:text="@string/ttlive_inner_phone_number_auth_dialog_auth_and_interaction"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="36dp"
        android:textColor="@color/black"
        android:id="@+id/masked_phone_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_below="@+id/auth_title"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_core_hs_s25"
        android:id="@+id/service_provider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_below="@+id/masked_phone_number"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/btn_confirm"
        android:background="@drawable/ttlive_confirm_btn_bg"
        android:layout_width="343dp"
        android:layout_height="44dp"
        android:layout_marginTop="60dp"
        android:layout_below="@+id/service_provider"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textColor="#161823"
        android:id="@+id/use_dy_auth_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/ttlive_inner_auth_dialog_use_dy_auth"
        android:layout_below="@+id/btn_confirm"
        android:layout_alignStart="@+id/btn_confirm"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_core_hs_s25"
        android:id="@+id/auth_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_below="@+id/use_dy_auth_btn"
        android:layout_alignStart="@+id/btn_confirm"
        android:layout_alignEnd="@+id/btn_confirm"/>
    <TextView
        android:textColor="@color/ttlive_core_hs_s25"
        android:gravity="center"
        android:id="@+id/agreement_line"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:layout_above="@+id/bottom_space"
        android:layout_centerHorizontal="true"/>
    <View
        android:id="@+id/bottom_space"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
