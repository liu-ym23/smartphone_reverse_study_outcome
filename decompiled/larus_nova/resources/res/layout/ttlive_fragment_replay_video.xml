<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/vs_video_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/video_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/replay_paid_block_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/replay_background_widget"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/interaction_layer_top_margin_bg"
            android:background="@color/transparent"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
        <FrameLayout
            android:id="@+id/fragment_container"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="end"
        android:id="@+id/recommend_lynx_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/portrait_toolbar_skeleton"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <View
            android:layout_gravity="center_vertical"
            android:background="@drawable/ttlive_replay_bg_toolbar_icon_skeleton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="16dp"/>
        <View
            android:layout_gravity="center_vertical"
            android:background="@drawable/ttlive_replay_bg_toolbar_icon_skeleton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="14dp"/>
        <View
            android:layout_gravity="center_vertical"
            android:background="@drawable/ttlive_replay_bg_toolbar_icon_skeleton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="14dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/cast_screen_loading_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/loading_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/vs_drawer_guide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/top_block_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/full_lynx_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
