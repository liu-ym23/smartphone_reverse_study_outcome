<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.ee.bear.bitable.card.view.cell.text.BitableAtEditText
        android:textSize="14sp"
        android:textColor="@color/text_title"
        android:textColorHint="@color/text_placeholder"
        android:id="@+id/uneditable_tv"
        android:paddingLeft="10dp"
        android:paddingTop="12dp"
        android:paddingRight="10dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/Bitable_Form_ShowCalculationResults"
        android:maxLength="10000"
        android:lineSpacingMultiplier="1.2"
        android:inputType="textMultiLine"
        android:imeOptions="actionNext"
        app:ud_backgroundColor="@color/uneditable_field_background"
        app:ud_editText_leftIconTint="@color/primary_fill_default"
        app:ud_radius="s"/>
</LinearLayout>
