<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#f8f8f8"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        layout="@layout/solo_ktv_karaoke_station_double_title_layout"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/first_tab_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="44dp">
        <View
            android:id="@+id/divider_line"
            android:background="#1f161823"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ktv_search_container"
            android:background="@drawable/solo_ktv_karaoke_station_search_bg"
            android:clipChildren="true"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="16dp">
            <View
                android:id="@+id/ktv_search_icon"
                android:background="@drawable/ttlive_ktv_search_icon_v2"
                android:layout_width="16sp"
                android:layout_height="16sp"
                android:layout_marginLeft="8dp"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.android.live.ktv.common.ordersong.view.KtvTextSwitcher
                android:id="@+id/text_switcher"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ktv_search_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:switcher_text_color="#66ffffff"
                app:switcher_text_size="15sp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:id="@+id/search_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp">
            <com.google.android.material.appbar.AppBarLayout
                android:orientation="vertical"
                android:id="@+id/top_area"
                android:fadingEdge="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:elevation="0dp">
                <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout
                    android:id="@+id/banner_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="12dp"
                    app:layout_scrollFlags="enterAlways|scroll"
                    app:ttlive_allRadius="8dp"/>
                <FrameLayout
                    android:id="@+id/function_container"
                    android:background="@drawable/solo_ktv_karaoke_station_function_area_bg"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="12dp"
                    app:layout_scrollFlags="enterAlways|scroll"/>
                <com.bytedance.android.live.ktv.common.karaokestation.view.secondleveltab.SecondLevelTabView
                    android:orientation="horizontal"
                    android:id="@+id/tab_container"
                    android:background="@drawable/solo_ktv_karaoke_station_tab_bg"
                    android:paddingLeft="16dp"
                    android:paddingTop="20dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:layoutManager="LinearLayoutManager"/>
            </com.google.android.material.appbar.AppBarLayout>
            <com.bytedance.android.live.ktv.common.karaokestation.view.ScrollControlViewPager
                android:id="@+id/content_area"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </LinearLayout>
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout
        android:id="@+id/second_container"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="58dp"
        android:layout_marginRight="15dp"
        app:ttlive_leftTopRadius="8dp"
        app:ttlive_rightTopRadius="8dp">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ktv_room_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="75dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/error_view"
            android:background="@color/white"
            android:paddingTop="210dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:layout_gravity="center_horizontal"
                android:background="@drawable/ttlive_solo_live_error_icon"
                android:layout_width="80sp"
                android:layout_height="80sp"/>
            <TextView
                android:textSize="17sp"
                android:textColor="#000000"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="内容为空"
                android:drawablePadding="5dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#73747a"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="暂无更多内容，请刷新后重试"
                android:drawablePadding="5dp"/>
        </LinearLayout>
        <com.bytedance.android.live.ktv.common.view.CommomKtvButton
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/btn_start_live"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="30dp"
            android:text="创建KTV歌房"/>
    </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout>
    <FrameLayout
        android:id="@+id/second_container_fl"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="44dp"/>
</FrameLayout>
