<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="76dp">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="204.97dp"
            android:layout_height="16dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/ecommerce_text_slogan"/>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/store_v2_iv_image"
            android:layout_width="240dp"
            android:layout_height="160dp"
            android:src="@drawable/ecommerce_store_ic_goods_empty"/>
        <TextView
            android:textSize="13dp"
            android:textStyle="bold"
            android:textColor="@color/ec_store_9A161823"
            android:gravity="center"
            android:id="@+id/store_tv_new_product_comming"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ec_store_commerce_store_product_coming"/>
        <RelativeLayout
            android:id="@+id/store_to_shop_entrance_wrraper"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/shopping_std_text_black_4"
                android:gravity="center"
                android:id="@+id/no_product"
                android:paddingTop="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/store_to_shop_entrance"
                android:background="@drawable/shopping_shop_to_store_bottom_block"
                android:layout_width="110dp"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:layout_below="@+id/no_product"
                android:layout_centerHorizontal="true">
                <TextView
                    android:textSize="15dp"
                    android:textStyle="bold"
                    android:textColor="@color/shopping_std_text_black_2"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/strore_or_shop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ec_store_commerce_go_store_v2"
                    android:layout_marginStart="2dp"/>
                <com.facebook.drawee.view.SimpleDraweeView
                    android:layout_gravity="center"
                    android:id="@+id/store_to_shop_img"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
        </RelativeLayout>
        <TextView
            android:textColor="@color/shopping_std_bg_primary_1"
            android:layout_gravity="center_horizontal"
            android:id="@+id/store_v2_tv_hint_head"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/shopping_network_error_and_refresh"
            style="@style/font_size_34"/>
        <TextView
            android:textColor="@color/shopping_std_text_black_3"
            android:layout_gravity="center_horizontal"
            android:id="@+id/store_v2_tv_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/shopping_network_error_and_refresh"
            style="@style/font_size_28"/>
        <TextView
            android:textColor="@color/shopping_std_text_black_3"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/store_v2_tv_refresh"
            android:background="@drawable/shopping_bg_store_v2_refresh_button"
            android:padding="5dp"
            android:layout_width="231dp"
            android:layout_height="44dp"
            android:layout_marginTop="15dp"
            android:text="@string/shopping_refresh"
            style="@style/font_size_30"/>
    </LinearLayout>
</LinearLayout>
