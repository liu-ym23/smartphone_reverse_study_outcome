<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <com.bytedance.android.livesdk.chatroom.view.VSLinkedAvatarContainer
        android:id="@+id/container"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginLeft="12dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:roundAsCircle="true"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="end|bottom"
            android:id="@+id/living_view"
            android:tag="living_view"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:scaleType="centerCrop"/>
    </com.bytedance.android.livesdk.chatroom.view.VSLinkedAvatarContainer>
    <TextView
        android:textSize="15dp"
        android:textColor="#e5ffffff"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_nick_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:maxLines="1"
        android:layout_marginStart="10dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/container"
        app:layout_constraintRight_toLeftOf="@+id/go_to_live_room"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#e5ffffff"
        android:gravity="center"
        android:id="@+id/go_to_live_room"
        android:background="@drawable/ttlive_bg_relevant_live_watch_btn"
        android:layout_width="64dp"
        android:layout_height="24dp"
        android:layout_marginRight="16dp"
        android:text="@string/ttlive_open_live"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
