<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_commerce_anchor_v3_comment_nps_questionnaire_2035879252"
    style="@style/comment_questionnaire_style">
    <ImageView
        android:id="@+id/comment_nps_questionnaire_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:src="@drawable/ec_commerce_anchor_v3_comment_questionnaire_tv"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="#f2a741"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/comment_nps_questionnaire_text"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginLeft="9dp"
        android:layout_marginRight="8dp"
        android:maxLines="1"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/comment_nps_questionnaire_tv"
        app:layout_constraintRight_toLeftOf="@+id/comment_nps_questionnaire_option_1"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textStyle="bold"
        android:textColor="#f2a741"
        android:gravity="center"
        android:id="@+id/comment_nps_questionnaire_option_1"
        android:background="@drawable/ec_commerce_anchor_v3_comment_nps_oval"
        android:layout_width="54dp"
        android:layout_height="24dp"
        android:layout_marginRight="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/comment_nps_questionnaire_option_2"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textStyle="bold"
        android:textColor="#f2a741"
        android:gravity="center"
        android:id="@+id/comment_nps_questionnaire_option_2"
        android:background="@drawable/ec_commerce_anchor_v3_comment_nps_oval"
        android:layout_width="54dp"
        android:layout_height="24dp"
        android:layout_marginRight="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
