<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reward_msg_list_dialog"
    android:background="@drawable/ttlive_bg_open_game_panel"
    android:layout_width="match_parent"
    android:layout_height="366dp"
    android:maxHeight="484dp">
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_open_platform_msg_center"
        android:layout_alignParentTop="true"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rank_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/title"/>
    <com.bytedance.android.live.uikit.recyclerview.LoadingStatusView
        android:layout_gravity="center"
        android:id="@+id/status_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"/>
</RelativeLayout>
