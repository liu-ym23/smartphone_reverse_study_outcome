<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="50dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/normal_gift_bg_view"
        android:layout_width="168dp"
        android:layout_height="44dp"
        android:layout_marginLeft="12dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/user_avatar_iv"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="4dp"
        android:src="@drawable/ttlive_img_avatar_empty"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/normal_gift_bg_view"
        app:layout_constraintStart_toStartOf="@+id/normal_gift_bg_view"
        app:layout_constraintTop_toTopOf="@+id/normal_gift_bg_view"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_avatar_border"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:layout_constraintBottom_toBottomOf="@+id/user_avatar_iv"
        app:layout_constraintEnd_toEndOf="@+id/user_avatar_iv"
        app:layout_constraintStart_toStartOf="@+id/user_avatar_iv"
        app:layout_constraintTop_toTopOf="@+id/user_avatar_iv"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/linearLayout"
        android:layout_width="78dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginBottom="0dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/normal_gift_bg_view"
        app:layout_constraintStart_toEndOf="@+id/user_avatar_iv"
        app:layout_constraintTop_toTopOf="@+id/normal_gift_bg_view">
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/user_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:maxLines="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#a3ffffff"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/gift_description_tv"
            android:layout_width="match_parent"
            android:layout_height="17dp"
            android:layout_marginBottom="1dp"
            android:maxLines="1"/>
    </LinearLayout>
    <com.bytedance.android.livesdk.gift.platform.business.normal.view.v2.GiftIconMaskView
        android:id="@+id/gift_icon_animation_view"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/normal_gift_bg_view"
        app:layout_constraintEnd_toEndOf="@+id/normal_gift_bg_view"
        app:layout_constraintTop_toTopOf="@+id/normal_gift_bg_view"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/dynamic_gift_icon"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginRight="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/normal_gift_bg_view"/>
    <View
        android:id="@+id/dummy_view"
        android:layout_width="0.5dp"
        android:layout_height="0.5dp"
        app:layout_constraintStart_toEndOf="@+id/gift_icon_animation_view"
        app:layout_constraintTop_toTopOf="@+id/normal_gift_bg_view"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/group_body"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/dummy_view"
        app:layout_constraintTop_toTopOf="@+id/normal_gift_bg_view">
        <TextView
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:gravity="bottom"
            android:id="@+id/group_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:text="x"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/combo_body"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/normal_gift_bg_view"
        app:layout_constraintStart_toEndOf="@+id/normal_gift_bg_view">
        <TextView
            android:textSize="18sp"
            android:textColor="#ffffff"
            android:gravity="bottom"
            android:id="@+id/combo_count_x"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="x"/>
        <TextView
            android:textSize="24dp"
            android:textColor="#ffffff"
            android:gravity="bottom"
            android:id="@+id/combo_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
