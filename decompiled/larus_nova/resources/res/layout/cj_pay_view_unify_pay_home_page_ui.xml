<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/cj_unify_pay_payment_confirm_root_view"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/cj_unify_pay_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/cj_unify_pay_top_extend_layout"
            android:layout_width="match_parent"
            android:layout_height="29dp"
            android:layout_marginBottom="8dp"
            layout="@layout/cj_pay_top_extend_info_layout"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="bottom"
            android:id="@+id/cj_unify_pay_core_root"
            android:background="@color/cj_pay_color_gray_248"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.android.ttcjpaysdk.base.theme.widget.CJPayFlexibleRoundCornerImageView
                android:id="@+id/cj_unify_front_homepage_background"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="182dp"
                android:scaleType="centerCrop"
                app:CJPayCorners="CJPay_TOP_RIGHT|CJPay_TOP_LEFT"
                app:CJPayCornersRadius="@dimen/cj_pay_padding_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cj_unify_pay_payment_confirm_content_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constrainedHeight="true"
                app:layout_constraintBottom_toTopOf="@+id/cj_unify_pay_bottom_layout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="spread_inside">
                <include
                    android:id="@+id/cj_unify_pay_titlebar_root_view"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    layout="@layout/cj_pay_view_titlebar_noise_reduction_layout"/>
                <Space
                    android:id="@+id/cj_unify_pay_space_above_order_info"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/cj_unify_pay_order_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/cj_pay_padding_24"
                    android:layout_marginRight="@dimen/cj_pay_padding_24"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
                <include
                    android:id="@+id/cj_unify_amount_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cj_pay_padding_8"
                    layout="@layout/cj_pay_amount_view_layout"/>
                <include
                    android:id="@+id/cj_unify_voucher_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cj_pay_padding_8"
                    layout="@layout/cj_pay_voucher_layout"/>
                <View
                    android:id="@+id/view_unify_pay_below_voucher_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"/>
                <androidx.core.widget.NestedScrollView
                    android:id="@+id/unify_pay_scroll_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/unify_rec_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.android.ttcjpaysdk.thirdparty.front.counter.unifypay.homepage.view.CJUnifyPayXRecTopView
                            android:id="@+id/unify_pay_x_rec_top_view"
                            android:background="@drawable/cj_pay_bg_r8_white"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="12dp"
                            android:layout_marginRight="12dp"
                            android:layout_marginBottom="10dp"/>
                        <com.android.ttcjpaysdk.thirdparty.front.counter.unifypay.method.view.CJUnifySelectMethodView
                            android:id="@+id/unify_select_method_view"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/cj_pay_padding_12"
                            android:layout_marginRight="@dimen/cj_pay_padding_12"/>
                        <FrameLayout
                            android:id="@+id/cj_unify_pay_payment_method_operation_layout"
                            android:background="@drawable/cj_pay_bg_r8_gray"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/cj_pay_padding_12"
                            android:layout_marginTop="@dimen/cj_pay_padding_10"
                            android:layout_marginRight="@dimen/cj_pay_padding_12"/>
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
                <com.android.ttcjpaysdk.thirdparty.front.counter.unifypay.method.view.CJUnifySelectMethodView
                    android:id="@+id/unify_new_select_method_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/cj_pay_padding_12"
                    android:layout_marginRight="@dimen/cj_pay_padding_12"/>
                <com.android.ttcjpaysdk.thirdparty.front.counter.unifypay.homepage.view.CJUnifyPayNestedScrollContainer
                    android:id="@+id/unify_pay_payment_method_layout"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
            </LinearLayout>
            <View
                android:id="@+id/cj_unify_pay_scroll_view_overlay"
                android:focusable="false"
                android:visibility="gone"
                android:clickable="false"
                android:layout_width="0dp"
                android:layout_height="@dimen/cj_pay_height_20"
                app:layout_constraintBottom_toBottomOf="@+id/cj_unify_pay_payment_confirm_content_layout"
                app:layout_constraintEnd_toEndOf="@+id/cj_unify_pay_payment_confirm_content_layout"
                app:layout_constraintStart_toStartOf="@+id/cj_unify_pay_payment_confirm_content_layout"/>
            <FrameLayout
                android:id="@+id/cj_unify_pay_bottom_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintTop_toBottomOf="@+id/cj_unify_pay_payment_confirm_content_layout">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/cj_unify_pay_bottom_operation_and_confirm_layout"
                    android:background="@drawable/cj_pay_bg_r8_white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/cj_pay_padding_12"
                    android:layout_marginTop="@dimen/cj_pay_padding_20"
                    android:layout_marginRight="@dimen/cj_pay_padding_12"
                    android:layout_marginBottom="@dimen/cj_pay_padding_16">
                    <FrameLayout
                        android:id="@+id/cj_unify_pay_bottom_operation_layout"
                        android:background="@drawable/cj_pay_bg_r8_white"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <com.android.ttcjpaysdk.base.ui.component.security.CJSecurityTextView
                        android:gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:id="@+id/cj_pay_button_above_security_view"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"/>
                    <com.android.ttcjpaysdk.base.ui.widget.CJPayIconLoadingButton
                        android:gravity="center"
                        android:id="@+id/cj_unify_pay_confirm"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/cj_pay_height_48"
                        app:btnTextSize="16sp"
                        app:enablePressedState="true"/>
                    <com.android.ttcjpaysdk.base.ui.component.security.CJSecurityTextView
                        android:gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:id="@+id/cj_pay_button_below_security_view"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:id="@+id/unify_pay_pre_verify_layout"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <View
                        android:id="@+id/cj_unify_pay_keyboard_place_view"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"/>
                </LinearLayout>
                <include
                    android:id="@+id/cj_unify_pay_front_home_page_layout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/cj_pay_padding_16"
                    android:layout_marginRight="@dimen/cj_pay_padding_16"
                    android:layout_marginBottom="@dimen/cj_pay_padding_16"
                    layout="@layout/cj_pay_view_unify_front_home_page_layout"/>
            </FrameLayout>
            <include
                android:id="@+id/cj_pay_security_panel_loading_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cj_unify_pay_payment_confirm_content_layout"
                layout="@layout/cj_pay_view_security_panel_loading_container"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/cj_unify_pay_verify_overlay_host"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</FrameLayout>
