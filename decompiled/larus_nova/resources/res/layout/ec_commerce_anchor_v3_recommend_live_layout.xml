<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/anchor_v3_recommend_live_rootview"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.ec.core.widget.RoundedLinearLayout
        android:orientation="vertical"
        android:id="@+id/anchor_v3_recommend_live_container"
        android:background="@color/BGReverse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:rounded_radius="6dp">
        <RelativeLayout
            android:id="@+id/anchor_v3_recommend_live_rl_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/anchor_v3_sv_recommend_live_cover"
                android:layout_width="match_parent"
                android:layout_height="213dp"
                app:placeholderImage="@color/shopping_color_08161823"
                app:placeholderImageScaleType="centerCrop"/>
            <View
                android:background="@drawable/ec_commerce_bg_recommend_live_bottom"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_alignBottom="@+id/anchor_v3_sv_recommend_live_cover"/>
            <TextView
                android:textColor="@color/commerce_color_FFFFFF"
                android:id="@+id/anchor_v3_tv_author_relationship"
                android:background="@drawable/ec_commerce_bg_alpha_30_black_radius_16dp"
                android:paddingLeft="6dp"
                android:paddingTop="2dp"
                android:paddingRight="6dp"
                android:paddingBottom="2dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginBottom="6dp"
                android:layout_above="@+id/anchor_v3_live_author_container"
                android:layout_marginStart="6dp"
                style="@style/font_size_24"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/anchor_v3_live_author_container"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:layout_alignBottom="@+id/anchor_v3_sv_recommend_live_cover">
                <com.bytedance.android.shopping.anchorv3.widget.RoundAvatarView
                    android:id="@+id/anchor_v3_sv_live_avatar"
                    android:layout_width="@dimen/commerce_anchor_v3_recommend_live_avatar_size"
                    android:layout_height="@dimen/commerce_anchor_v3_recommend_live_avatar_size"
                    android:layout_marginRight="6dp"
                    android:scaleType="centerCrop"
                    android:layout_marginEnd="6dp"
                    app:placeholderImage="@color/BGPlaceholderDefault"
                    app:placeholderImageScaleType="centerCrop"
                    app:roundAsCircle="true"/>
                <TextView
                    android:textColor="@color/commerce_color_FFFFFF"
                    android:ellipsize="end"
                    android:id="@+id/anchor_v3_tv_live_author_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    style="@style/font_size_26"/>
            </LinearLayout>
            <com.bytedance.android.ec.core.widget.RoundedLinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/anchor_v3_recommend_live_audience_container"
                android:background="@drawable/ec_bg_alpha_50_black_radius_2dp"
                android:paddingRight="3dp"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginLeft="6dp"
                android:layout_marginTop="6dp"
                android:paddingEnd="3dp"
                android:layout_marginStart="6dp"
                app:rounded_radius="2dp">
                <RelativeLayout
                    android:background="@drawable/ec_commerce_bg_recommend_live_anim"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginRight="3dp"
                    android:layout_marginEnd="3dp">
                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/anchor_v3_recommend_live_lottie_anim_view"
                        android:layout_width="10dp"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"/>
                </RelativeLayout>
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/anchor_v3_recommend_live_desc_icon"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="2dp"
                    android:layout_marginEnd="2dp"/>
                <TextView
                    android:textColor="@color/shopping_std_text_white_3"
                    android:id="@+id/anchor_v3_tv_recommend_live_audience_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/font_size_24"/>
            </com.bytedance.android.ec.core.widget.RoundedLinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/anchor_v3_recommend_product_container"
            android:paddingLeft="@dimen/commerce_anchor_v3_recommend_product_padding_left"
            android:paddingTop="6dp"
            android:paddingRight="@dimen/commerce_anchor_v3_recommend_product_padding_right"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="@dimen/commerce_anchor_v3_recommend_product_padding_right">
            <FrameLayout
                android:id="@+id/anchor_v3_sv_recommend_product_cover_layout"
                android:layout_width="@dimen/commerce_anchor_v3_recommend_live_product_size"
                android:layout_height="@dimen/commerce_anchor_v3_recommend_live_product_size">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/anchor_v3_sv_recommend_product_cover"
                    android:layout_width="@dimen/commerce_anchor_v3_recommend_live_product_size"
                    android:layout_height="@dimen/commerce_anchor_v3_recommend_live_product_size"
                    android:scaleType="centerCrop"
                    app:placeholderImage="@color/shopping_std_bg_black_2"
                    app:placeholderImageScaleType="centerCrop"
                    app:roundedCornerRadius="4dp"/>
                <TextView
                    android:textSize="8dp"
                    android:textColor="@color/ec_color_white"
                    android:layout_gravity="bottom|right"
                    android:id="@+id/tv_ad_tag"
                    android:background="@drawable/anchor_v3_guess_u_like_ad_live_bg"
                    android:padding="1dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="1dp"
                    android:text="@string/guess_u_like_advertisement"
                    android:alpha="0.75"/>
            </FrameLayout>
            <TextView
                android:textColor="@color/commerce_color_161823"
                android:id="@+id/anchor_v3_tv_recommend_product_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:layout_toRightOf="@+id/anchor_v3_sv_recommend_product_cover_layout"
                android:layout_marginStart="4dp"
                style="@style/font_size_26"/>
            <com.bytedance.android.shopping.widget.PriceView
                android:id="@+id/anchor_v3_tv_product_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/commerce_anchor_v3_recommend_live_price_margin_left"
                android:layout_marginTop="4dp"
                android:layout_toRightOf="@+id/anchor_v3_sv_recommend_product_cover_layout"
                android:layout_below="@+id/anchor_v3_tv_recommend_product_title"
                android:layout_marginStart="4dp"
                app:priceBold="true"
                app:priceDecimalTextSize="17dp"
                app:priceText="111"
                app:priceTextColor="@color/Primary"
                app:priceTextSize="17dp"
                app:spaceSize="2dp"
                app:thinDecimal="true"
                app:yangTextSize="13dp"/>
            <ImageView
                android:id="@+id/anchor_v3_sv_recommend_live_more_btn"
                android:paddingLeft="4dp"
                android:paddingTop="10dp"
                android:paddingRight="6dp"
                android:paddingBottom="10dp"
                android:visibility="gone"
                android:layout_width="@dimen/commerce_anchor_v3_recommend_live_more_btn_size"
                android:layout_height="26dp"
                android:src="@drawable/ec_commerce_guess_u_like_more_btn"
                android:layout_below="@+id/anchor_v3_tv_recommend_product_title"
                android:layout_alignParentRight="true"
                android:paddingStart="4dp"
                android:paddingEnd="6dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/anchor_v3_recommend_bottom_info_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="38dp">
            <com.bytedance.android.shopping.anchorv3.widget.RoundAvatarView
                android:id="@+id/anchor_v3_recommend_bottom_info_avatar"
                android:layout_width="@dimen/commerce_anchor_v3_recommend_live_avatar_size"
                android:layout_height="@dimen/commerce_anchor_v3_recommend_live_avatar_size"
                android:layout_marginLeft="6dp"
                android:scaleType="centerCrop"
                app:placeholderImage="@color/BGPlaceholderDefault"
                app:placeholderImageScaleType="centerCrop"
                app:roundAsCircle="true"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#3e3e3e"
                android:ellipsize="end"
                android:id="@+id/anchor_v3_tv_recommend_bottom_info_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="15dp"
                android:maxLines="1"
                android:layout_weight="1"/>
            <TextView
                android:textSize="8dp"
                android:textColor="#bfffffff"
                android:id="@+id/anchor_v3_tv_recommend_bottom_info_ad"
                android:background="@drawable/anchor_v3_guess_u_like_bottom_ad_live_bg"
                android:padding="1dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="4dp"
                android:text="@string/guess_u_like_advertisement"/>
            <ImageView
                android:id="@+id/anchor_v3_iv_recommend_bottom_info_hot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginRight="3dp"
                android:src="@drawable/ec_commerce_guess_u_like_bottom_hot"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#57161823"
                android:ellipsize="end"
                android:id="@+id/anchor_v3_tv_recommend_bottom_info_hot_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="6dp"
                android:maxLines="1"/>
        </LinearLayout>
    </com.bytedance.android.ec.core.widget.RoundedLinearLayout>
    <com.bytedance.android.shopping.anchorv3.view.AnchorV3GuessULikeFeedbackView
        android:id="@+id/anchor_v3_recommend_feedback_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
