<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="?attr/larus_bg_top_half_round"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end"
            android:id="@+id/cancel"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"
            app:srcCompat="?attr/larus_ic_input_dialog_close"/>
        <TextView
            android:textSize="?attr/larus_sp_22"
            android:textColor="?attr/larus_neutral_100"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_4"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_20"
            android:layout_marginEnd="?attr/larus_dp_20"/>
        <TextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="?attr/larus_neutral_70"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/dialog_sub_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_20"
            android:maxLines="2"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_20"
            android:layout_marginEnd="?attr/larus_dp_20"/>
        <RelativeLayout
            android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginTop="?attr/larus_dp_20"
            android:layout_marginStart="?attr/larus_dp_20"
            android:layout_marginEnd="?attr/larus_dp_20">
            <EditText
                android:textSize="?attr/larus_dp_17"
                android:id="@+id/dialog_input"
                android:background="?attr/larus_bg_input_selector"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/larus_setting_profile_nickname_placeholder"
                android:maxEms="40"
                android:singleLine="true"
                android:paddingStart="12dp"
                android:paddingEnd="56dp"
                android:backgroundTint="?attr/larus_base_3_overlay"
                style="@style/larus_EditTextStyle"/>
            <ProgressBar
                android:id="@+id/loading_view"
                android:padding="?attr/larus_dp_2"
                android:visibility="gone"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_alignEnd="@+id/dialog_input"
                style="@style/larus_LoadingProgressBar"/>
            <ImageView
                android:id="@+id/confirm"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/larus_ic_blue_selected"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_alignEnd="@+id/dialog_input"/>
        </RelativeLayout>
        <View
            android:background="?attr/larus_item_divider"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_0_5"
            android:layout_marginTop="?attr/larus_dp_24"/>
    </LinearLayout>
</RelativeLayout>
