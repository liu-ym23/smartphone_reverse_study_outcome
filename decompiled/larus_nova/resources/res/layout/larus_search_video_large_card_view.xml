<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    app:rv_backgroundColor="?attr/larus_base_2"
    app:rv_backgroundPressColor="?attr/larus_neutral_transparent_2"
    app:rv_cornerRadius="?attr/larus_dp_12"
    app:rv_strokeColor="?attr/larus_press"
    app:rv_strokeWidth="?attr/larus_dp_1">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/image_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:placeholderImage="?attr/larus_base_2_overlay"
        app:roundBottomEnd="true"
        app:roundBottomStart="true"
        app:roundTopEnd="true"
        app:roundTopStart="true"
        app:roundedCornerRadius="?attr/larus_dp_12"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end|top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_10"
        android:layout_marginEnd="?attr/larus_dp_10"
        app:srcCompat="@drawable/larus_ic_searchlist_video_play_little_new"/>
    <com.larus.bmhome.chat.markdown.imagegroup.view.MarkdownSourceImageView
        android:id="@+id/sourceIcon"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_16"
        android:layout_height="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_10"
        android:layout_marginStart="?attr/larus_dp_10"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/image_creator_avatar"
        android:layout_width="?attr/larus_dp_16"
        android:layout_height="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_10"
        android:layout_marginStart="?attr/larus_dp_10"
        app:placeholderImage="?attr/larus_base_2_overlay"
        app:roundBottomEnd="true"
        app:roundBottomStart="true"
        app:roundTopEnd="true"
        app:roundTopStart="true"
        app:roundedCornerRadius="?attr/larus_dp_4"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:background="@drawable/larus_searchlist_rich_video_title_bg"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_65"/>
    <LinearLayout
        android:gravity="start|bottom"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        android:layout_marginStart="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_11">
        <TextView
            android:textSize="?attr/larus_dp_13"
            android:textColor="@color/larus_static_white"
            android:ellipsize="end"
            android:id="@+id/text_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
    </LinearLayout>
</merge>
