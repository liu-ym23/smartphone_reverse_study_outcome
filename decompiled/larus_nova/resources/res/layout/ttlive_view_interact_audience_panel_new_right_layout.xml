<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/interact_setting_icon"
                android:background="@drawable/ttlive_icon_interact_audience_setting"
                android:layout_width="32dp"
                android:layout_height="32dp"/>
            <View
                android:layout_gravity="end|top"
                android:id="@+id/setting_guide_dot"
                android:background="@drawable/ttlive_interact_audience_setting_guide_dot"
                android:visibility="gone"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="2dp"
                android:layout_marginEnd="2dp"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/interact_switch_scene_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/interact_switch_scene"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginLeft="12dp"
                android:src="@drawable/ttlive_icon_interact_switch_scene"/>
            <View
                android:layout_gravity="end|top"
                android:id="@+id/switch_guide_dot"
                android:background="@drawable/ttlive_interact_audience_setting_guide_dot"
                android:visibility="gone"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginTop="2dp"
                android:layout_marginRight="2dp"
                android:layout_marginEnd="2dp"/>
        </FrameLayout>
    </LinearLayout>
    <TextView
        android:textSize="14dp"
        android:textColor="#88000000"
        android:gravity="center"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/admin_operation"
        android:paddingRight="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/ttlive_video_talk_room_audio_apply"
        android:paddingEnd="4dp"/>
</FrameLayout>
