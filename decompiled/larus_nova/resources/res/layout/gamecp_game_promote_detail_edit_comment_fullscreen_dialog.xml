<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/hide_soft_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/rv_toolbar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/ll_game_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <com.bytedance.android.gamecp.common.ui.HSImageView
                android:id="@+id/iv_game_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:placeholderImage="@drawable/gamecp_game_promote_comment_editor_game_icon_bg"
                app:roundedCornerRadius="4dp"/>
            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="@color/gamecp_game_161823"
                android:ellipsize="end"
                android:id="@+id/tv_game_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="150dp"
                android:maxLines="1"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/gamecp_game_promote_detail_edit_comment_close"
            android:layout_centerVertical="true"
            android:layout_marginStart="20dp"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="@color/gamecp_game_FFFFFF"
            android:gravity="center"
            android:id="@+id/tv_send_comment"
            android:background="@drawable/shape_bg_fe2c55_corner_4"
            android:layout_width="54dp"
            android:layout_height="24dp"
            android:text="@string/ttlive_game_promote_send_comment"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/divider"
        android:background="#1f161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintTop_toBottomOf="@+id/rv_toolbar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider">
        <com.bytedance.android.gamecp.business.view.GamePromoteCommonRatingBar
            android:id="@+id/rating_bar"
            android:layout_width="148dp"
            android:layout_height="20dp"
            android:layout_marginTop="23.5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:starBgDrawable="@drawable/gamecp_ic_game_promote_star_bg_v2"
            app:starClickable="true"
            app:starCount="5"
            app:starDrawable="@drawable/gamecp_ic_game_promote_star_v2"
            app:starPadding="12dp"
            app:starScrollable="false"
            app:starType="whole"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/gamecp_game_80161823"
            android:id="@+id/tv_star_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rating_bar"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_editor_container"
            android:background="@drawable/gamecp_bg_comment_edit_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_star_desc">
            <com.bytedance.android.gamecp.business.comment.edit.view.CommentLabelsRecycleView
                android:id="@+id/rv_label_list"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toTopOf="@+id/edit_panel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.android.gamecp.business.comment.edit.view.CommentEditText
                android:textSize="14dp"
                android:textColor="@color/gamecp_game_161823"
                android:textColorHint="@color/gamecp_game_57161823"
                android:gravity="top"
                android:id="@+id/edit_panel"
                android:background="@null"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="191dp"
                android:layout_marginTop="12dp"
                android:hint="@string/ttlive_game_promote_comment_full_hint"
                android:lineSpacingExtra="1.5dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toTopOf="@+id/rv_images_summary"
                app:layout_constraintTop_toBottomOf="@+id/rv_label_list"/>
            <TextView
                android:textSize="12dp"
                android:textStyle="normal"
                android:textColor="#80161823"
                android:id="@+id/tv_input_count"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:layout_marginEnd="6dp"
                app:layout_constraintBottom_toBottomOf="@+id/edit_panel"
                app:layout_constraintEnd_toEndOf="@+id/edit_panel"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_images_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:overScrollMode="never"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/edit_panel"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="12dp"
            android:textStyle="normal"
            android:textColor="#80161823"
            android:id="@+id/tv_read_and_agree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ttlive_game_promote_read_and_agree"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cl_editor_container"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="normal"
            android:textColor="#04498d"
            android:id="@+id/tv_comment_protocol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_game_promote_comment_protocol"
            app:layout_constraintLeft_toRightOf="@+id/tv_read_and_agree"
            app:layout_constraintTop_toTopOf="@+id/tv_read_and_agree"/>
        <CheckBox
            android:textSize="12dp"
            android:textColor="@color/gamecp_game_80161823"
            android:ellipsize="end"
            android:id="@+id/cb_device_series"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="100dp"
            android:text="@string/gamecp_game_promote_comment_show_device"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:layout_marginStart="23dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_read_and_agree"
            style="@style/ttlive_live_game_comment_check_box"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.gamecp.common.ui.LoadingStatusView
        android:id="@+id/loading"
        android:background="@color/white"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_toolbar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_bottom_labels"
        android:background="@color/gamecp_white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="11dp"
            android:textColor="@color/gamecp_game_99161823"
            android:id="@+id/tv_bottom_labels_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_game_promote_comment_editor_label_title"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.gamecp.business.comment.edit.view.CommentLabelsRecycleView
            android:id="@+id/rv_bottom_label_list"
            android:background="#ffffff"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_bottom_labels_title"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
