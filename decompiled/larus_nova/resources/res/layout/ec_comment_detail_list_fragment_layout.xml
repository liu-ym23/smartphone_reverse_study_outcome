<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ec_comment_detail_fragment_rootview"
    android:background="@color/shopping_color_000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.shopping.commentfeed.widget.OverScrolledViewPager
        android:id="@+id/ec_comment_detail_list_viewpager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <include
        android:layout_gravity="center"
        android:id="@+id/ec_comment_network_error_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/ec_commerce_comment_network_error_layout"/>
    <com.bytedance.android.shopping.commentfeed.widget.CommonPageLoadingView
        android:layout_gravity="center"
        android:id="@+id/ec_comment_loading_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:id="@+id/ec_comment_detail_iv_back"
        android:padding="5dp"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="43dp"
        android:src="@drawable/ec_commerce_icon_back_white"
        android:contentDescription="@string/shopping_return"
        android:layout_marginStart="15dp"/>
    <com.bytedance.android.ec.core.widget.ECStatusView
        android:layout_gravity="bottom"
        android:id="@+id/ec_comment_detail_load_status"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="64dp"/>
</FrameLayout>
