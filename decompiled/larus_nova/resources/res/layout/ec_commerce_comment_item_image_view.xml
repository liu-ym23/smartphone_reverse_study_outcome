<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.shopping.widget.RemoteRoundImageView
        android:id="@+id/comment_sv_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:failureImage="@color/shopping_color_1F161823"
        app:placeholderImage="@color/shopping_color_1F161823"/>
    <com.bytedance.android.ui.base.widget.round.RoundFrameLayout
        android:id="@+id/comment_image_tag_container"
        android:visibility="gone"
        android:layout_width="42dp"
        android:layout_height="18dp"
        app:bg_color="#99161823"
        app:bg_cornerRadius_BR="10dp"
        app:bg_cornerRadius_TL="10dp">
        <TextView
            android:textSize="10sp"
            android:textColor="#ffffff"
            android:layout_gravity="center"
            android:id="@+id/comment_image_tag"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </com.bytedance.android.ui.base.widget.round.RoundFrameLayout>
</FrameLayout>
