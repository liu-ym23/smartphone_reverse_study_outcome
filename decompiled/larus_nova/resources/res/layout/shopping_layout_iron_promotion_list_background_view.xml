<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.bytedance.android.ec.core.widget.ECNetImageView
        android:layout_gravity="bottom"
        android:id="@+id/niv_background_bg_fallback"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:actualImageScaleType="fitXY"/>
    <com.bytedance.android.ec.core.widget.ECNetImageView
        android:id="@+id/niv_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="fitXY"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_market_component_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="11dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/left_content"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/right_min_space"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
                android:id="@+id/dv_left_icon"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tv_left_format"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textStyle="bold"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_left_format"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="239dp"
                android:lines="1"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/dv_right_icon"
                app:layout_constraintStart_toEndOf="@+id/dv_left_icon"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/font_size_26"/>
            <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
                android:id="@+id/dv_right_icon"
                android:background="@drawable/ec_icon_list_top_right_arrow"
                android:visibility="gone"
                android:layout_width="6dp"
                android:layout_height="11dp"
                android:layout_marginStart="3dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_left_format"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.bytedance.android.livesdk.livecommerce.iron.ui.ECCustomizedElementView
            android:id="@+id/left_elements"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/right_min_space"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/shopping_color_FF255D"
            android:gravity="center_vertical"
            android:id="@+id/tv_market_component"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:layout_marginEnd="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/niv_entry"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/font_size_26"/>
        <com.bytedance.android.ec.core.widget.ECNetImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/niv_entry"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_market_component"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_market_component"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_market_component"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tv_market_component,niv_entry"/>
        <Space
            android:id="@+id/right_min_space"
            android:layout_width="40dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/right_interest_elements"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.livesdk.livecommerce.iron.ui.ECCustomizedElementView
            android:id="@+id/right_interest_elements"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
