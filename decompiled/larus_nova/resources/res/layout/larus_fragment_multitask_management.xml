<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mtm_root"
    android:background="@drawable/larus_mtm_bottom_sheet_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/mtm_drag_handle"
        android:background="@drawable/larus_mtm_drag_handle_bg"
        android:layout_width="?attr/larus_dp_36"
        android:layout_height="?attr/larus_dp_4"
        android:layout_marginTop="?attr/larus_dp_8"
        android:contentDescription="@string/larus_accessibility_dragClose"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mtm_sheet_container"
        android:paddingBottom="?attr/larus_dp_60"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="?attr/larus_dp_24"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_16"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mtm_drag_handle"
        app:layout_constraintWidth_max="560dp"
        app:layout_goneMarginTop="?attr/larus_dp_16"/>
    <View
        android:id="@+id/mtm_top_mask"
        android:background="@drawable/larus_mtm_top_mask_bg"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_24"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mtm_drag_handle"
        app:layout_goneMarginTop="?attr/larus_dp_16"/>
</androidx.constraintlayout.widget.ConstraintLayout>
