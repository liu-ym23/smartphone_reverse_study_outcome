<?xml version="1.0" encoding="utf-8"?>
<com.ss.android.lark.widget.photopicker.widget.SquareItemLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/photo_divider_style">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"/>
    <View
        android:background="@color/fill_img_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignTop="@+id/iv_photo"
        android:layout_alignBottom="@+id/iv_photo"
        android:layout_alignStart="@+id/iv_photo"
        android:layout_alignEnd="@+id/iv_photo"/>
    <com.ss.android.lark.widget.mark.MarkView
        android:id="@+id/tv_duration"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="6dp"
        app:icon="@drawable/ud_icon_video_filled"
        app:tint="@color/static_white"/>
    <androidx.appcompat.widget.AppCompatCheckBox
        android:textSize="16dp"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/v_selected"
        android:background="@drawable/checkbox_bg_selector"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="5dp"
        android:button="@null"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
    <com.ss.android.lark.widget.mark.MarkView
        android:id="@+id/tv_image_tag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="6dp"
        app:text="@string/Lark_IM_GIF_Tag"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/v_mask"
        android:background="@color/static_white_60"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:translationZ="1dp"/>
</com.ss.android.lark.widget.photopicker.widget.SquareItemLayout>
