<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/item_trip_head_video_container"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_centerVertical="true">
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/item_trip_head_video_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <com.bytedance.locallife.poi.newdetail.widget.seekbar.PoiSeekBar
        android:id="@+id/item_trip_head_video_seek_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/item_trip_head_video_container"/>
    <com.bytedance.dux.image.DuxImageView
        android:id="@+id/item_trip_head_video_play"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/poi_head_video_play"
        android:layout_centerInParent="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/title_container"
        android:background="@drawable/poi_content_player_bg_gradient_saas"
        android:paddingLeft="16dp"
        android:paddingBottom="53dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignLeft="@+id/item_trip_head_video_container"
        android:layout_alignParentBottom="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.bytedance.dux.text.DuxTextView
                android:textSize="16dp"
                android:textStyle="bold"
                android:id="@+id/title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.bytedance.dux.image.DuxImageView
                android:id="@+id/title_text_arrow"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/icon_title_arrowright"/>
        </LinearLayout>
        <com.bytedance.dux.text.DuxTextView
            android:textSize="12dp"
            android:ellipsize="end"
            android:id="@+id/subtitle_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:maxEms="20"/>
    </LinearLayout>
</RelativeLayout>
