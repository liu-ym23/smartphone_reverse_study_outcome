<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/main_content_page_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.ss.android.lark.keyboard.keyboard2.LogMeasureFrameLayout
        android:id="@+id/top_insets"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/middle_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false">
        <com.ss.android.lark.keyboard.keyboard2.LogMeasureFrameLayout
            android:id="@+id/left_insets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.ss.android.lark.keyboard.keyboard2.LogMeasureFrameLayout
            android:id="@+id/menu_wrapper"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <com.ss.android.lark.keyboard.keyboard2.LogMeasureFrameLayout
            android:id="@+id/right_insets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <com.ss.android.lark.keyboard.keyboard2.LogMeasureFrameLayout
        android:id="@+id/bottom_insets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/ime_wrapper_delegate_view"
        android:background="@color/bg_base"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
</LinearLayout>
