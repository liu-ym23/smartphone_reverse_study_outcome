<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp">
        <com.obric.oui.text.OTextView
            android:textSize="16sp"
            android:textColor="@color/obric_custom_action_bar_blue_icon_and_text_color"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/voiceprint_phone_record_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/obric_setting_voice_print_management_record_new"/>
    </LinearLayout>
</FrameLayout>
