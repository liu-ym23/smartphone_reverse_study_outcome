<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="80dp">
    <View
        android:id="@+id/ktv_midi_bg"
        android:background="@drawable/ttlive_bg_ktv_room_midi_view"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="7dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <TextSwitcher
        android:layout_gravity="center_vertical"
        android:id="@+id/score_switcher"
        android:background="@drawable/ttlive_ktv_mv_midi_score_bg"
        android:paddingLeft="8dp"
        android:paddingTop="2dp"
        android:paddingRight="8dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/ktv_midi_bg"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ktv_midi_bg">
        <TextView
            android:textSize="12dp"
            android:textColor="#ffffff"
            android:layout_gravity="center_vertical"
            android:id="@+id/current_score_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#ffffff"
            android:layout_gravity="center_vertical"
            android:id="@+id/next_score_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </TextSwitcher>
    <FrameLayout
        android:id="@+id/ktv_icon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.ktv.common.midi.KtvComponentProgressView
            android:layout_gravity="center"
            android:id="@+id/ktv_progress"
            android:layout_width="45dp"
            android:layout_height="45dp"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/ktv_icon_iv"
            android:visibility="visible"
            android:layout_width="43dp"
            android:layout_height="43dp"/>
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/ktv_icon_tv"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ktv_icon_animation"
            android:visibility="gone"
            android:layout_width="60dp"
            android:layout_height="60dp"/>
    </FrameLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="#ffffff"
        android:id="@+id/ktv_no_midi_hint"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_ktv_no_support_midi"
        app:layout_constraintBottom_toBottomOf="@+id/ktv_midi_bg"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ktv_midi_bg"/>
    <com.bytedance.android.live.ktv.common.midi.KtvMidiView
        android:id="@+id/midi_view"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginRight="75dp"
        android:layout_marginBottom="7dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <com.bytedance.android.live.ktv.common.midi.KtvHitAnimationView
        android:id="@+id/hit_animation"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <ImageView
        android:id="@+id/each_score"
        android:layout_width="32dp"
        android:layout_height="21dp"
        android:layout_marginLeft="66dp"
        app:layout_constraintBottom_toBottomOf="@+id/midi_view"
        app:layout_constraintLeft_toLeftOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
