<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.ee.bear.wikiv2.wikitreev2.panel.CustomConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:id="@+id/decor"
    android:background="@drawable/facade_round_top_xxl"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="@color/bg_body">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/close_icon"
        android:background="@drawable/wiki_create_close_circle_shape"
        android:padding="@dimen/space_kit_len_5"
        android:visibility="visible"
        android:layout_width="@dimen/space_kit_len_24"
        android:layout_height="@dimen/space_kit_len_24"
        android:layout_marginTop="@dimen/space_kit_len_12"
        android:scaleType="fitCenter"
        android:tint="@color/icon_n1"
        android:layout_marginEnd="@dimen/space_kit_len_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ud_icon_close_bold_outlined"/>
    <TextView
        android:textSize="@dimen/space_kit_font_16"
        android:textStyle="bold"
        android:textColor="@color/text_title"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/wiki_panel_title"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:lines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/notification_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/wiki_panel_title"/>
    <com.bytedance.ee.bear.wikiv2.searchv2.WikiSearchPickerView
        android:id="@+id/wiki_search_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/notification_container"/>
    <com.bytedance.ee.bear.wikiv2.wikitreev2.widget.view.WikiTreeCtrlView
        android:id="@+id/wiki_tree_ctrl_view"
        android:background="@color/bg_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/notification_container"/>
</com.bytedance.ee.bear.wikiv2.wikitreev2.panel.CustomConstraintLayout>
