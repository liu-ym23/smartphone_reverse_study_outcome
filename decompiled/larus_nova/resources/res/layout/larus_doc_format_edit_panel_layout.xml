<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@color/larus_base_1_overlay"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_1"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="?attr/larus_dp_16"
                android:layout_marginRight="16dp">
                <TextView
                    android:textSize="?attr/larus_sp_21"
                    android:textColor="@color/larus_doc_edit_menu_item_color"
                    android:gravity="center"
                    android:id="@+id/format_h1"
                    android:background="@drawable/larus_doc_text_format_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="?attr/larus_dp_44"
                    android:text="@string/larus_aiDoc_keyboard_actionBar_tools_h1"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="?attr/larus_sp_19"
                    android:textColor="@color/larus_doc_edit_menu_item_color"
                    android:gravity="center"
                    android:id="@+id/format_h2"
                    android:background="@drawable/larus_doc_text_format_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="?attr/larus_dp_44"
                    android:text="@string/larus_aiDoc_keyboard_actionBar_tools_h2"
                    android:layout_weight="1"
                    android:layout_marginStart="?attr/larus_dp_15"/>
                <TextView
                    android:textSize="?attr/larus_sp_17"
                    android:textColor="@color/larus_doc_edit_menu_item_color"
                    android:gravity="center"
                    android:id="@+id/format_h3"
                    android:background="@drawable/larus_doc_text_format_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="?attr/larus_dp_44"
                    android:text="@string/larus_aiDoc_keyboard_actionBar_tools_h3"
                    android:layout_weight="1"
                    android:layout_marginStart="?attr/larus_dp_15"/>
                <TextView
                    android:textSize="?attr/larus_sp_17"
                    android:textColor="@color/larus_doc_edit_menu_item_color"
                    android:gravity="center"
                    android:id="@+id/format_plaintext"
                    android:background="@drawable/larus_doc_text_format_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="?attr/larus_dp_44"
                    android:text="@string/larus_aiDoc_keyboard_actionBar_tools_text"
                    android:layout_weight="1"
                    android:layout_marginStart="15dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="?attr/larus_dp_16"
                android:layout_marginTop="?attr/larus_dp_20"
                android:layout_marginRight="?attr/larus_dp_16">
                <ImageView
                    android:id="@+id/format_bold"
                    android:background="@drawable/larus_doc_edit_btn_left_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:src="@drawable/larus_doc_icon_text_bold"
                    android:scaleType="centerInside"
                    android:layout_weight="1"
                    app:tint="@color/larus_doc_edit_menu_item_color"/>
                <ImageView
                    android:id="@+id/format_italic"
                    android:background="@drawable/larus_doc_edit_btn_center_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:src="@drawable/larus_doc_icon_text_italic"
                    android:scaleType="centerInside"
                    android:layout_weight="1"
                    android:layout_marginStart="1dp"
                    app:tint="@color/larus_doc_edit_menu_item_color"/>
                <ImageView
                    android:id="@+id/format_underline"
                    android:background="@drawable/larus_doc_edit_btn_center_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:src="@drawable/larus_doc_icon_text_underline"
                    android:scaleType="centerInside"
                    android:layout_weight="1"
                    android:layout_marginStart="1dp"
                    app:tint="@color/larus_doc_edit_menu_item_color"/>
                <ImageView
                    android:id="@+id/format_strikethrough"
                    android:background="@drawable/larus_doc_edit_btn_right_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:src="@drawable/larus_doc_icon_text_strikethrough"
                    android:scaleType="centerInside"
                    android:layout_weight="1"
                    android:layout_marginStart="1dp"
                    app:tint="@color/larus_doc_edit_menu_item_color"/>
                <ImageView
                    android:id="@+id/format_blockquote"
                    android:background="@drawable/larus_doc_edit_btn_round_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:src="@drawable/larus_doc_icon_text_blockquote"
                    android:scaleType="centerInside"
                    android:layout_weight="1"
                    android:layout_marginStart="35dp"
                    app:tint="@color/larus_doc_edit_menu_item_color"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="16dp">
                <ImageView
                    android:id="@+id/format_unordered_list"
                    android:background="@drawable/larus_doc_edit_btn_left_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:src="@drawable/larus_doc_icon_unordered_list"
                    android:scaleType="centerInside"
                    android:layout_weight="1"
                    app:tint="@color/larus_doc_edit_menu_item_color"/>
                <ImageView
                    android:id="@+id/format_ordered_list"
                    android:background="@drawable/larus_doc_edit_btn_center_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:src="@drawable/larus_doc_icon_ordered_list"
                    android:scaleType="centerInside"
                    android:layout_weight="1"
                    android:layout_marginStart="1dp"
                    app:tint="@color/larus_doc_edit_menu_item_color"/>
                <ImageView
                    android:id="@+id/format_checkbox"
                    android:background="@drawable/larus_doc_edit_btn_right_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:src="@drawable/larus_doc_icon_checkbox_mark"
                    android:scaleType="centerInside"
                    android:layout_weight="1"
                    android:layout_marginStart="1dp"
                    app:tint="@color/larus_doc_edit_menu_item_color"/>
                <ImageView
                    android:id="@+id/format_indent_right"
                    android:background="@drawable/larus_doc_edit_btn_left_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:src="@drawable/larus_doc_icon_indentright"
                    android:scaleType="centerInside"
                    android:layout_weight="1"
                    android:layout_marginStart="34dp"
                    app:tint="@color/larus_doc_edit_menu_item_color"/>
                <ImageView
                    android:id="@+id/format_indent_left"
                    android:background="@drawable/larus_doc_edit_btn_right_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:src="@drawable/larus_doc_icon_indentleft"
                    android:scaleType="centerInside"
                    android:layout_weight="1"
                    android:layout_marginStart="1dp"
                    app:tint="@color/larus_doc_edit_menu_item_color"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="16dp">
                <ImageView
                    android:id="@+id/format_align_left"
                    android:background="@drawable/larus_doc_edit_btn_left_bg"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:src="@drawable/larus_doc_icon_text_alignleft"
                    android:scaleType="centerInside"
                    android:layout_weight="1"
                    app:tint="@color/larus_doc_edit_menu_item_color"/>
                <ImageView
                    android:id="@+id/format_align_center"
                    android:background="@drawable/larus_doc_edit_btn_center_bg"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:src="@drawable/larus_doc_icon_text_aligncenter"
                    android:scaleType="centerInside"
                    android:layout_weight="1"
                    android:layout_marginStart="1dp"
                    app:tint="@color/larus_doc_edit_menu_item_color"/>
                <ImageView
                    android:id="@+id/format_align_right"
                    android:background="@drawable/larus_doc_edit_btn_right_bg"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:src="@drawable/larus_doc_icon_text_alignright"
                    android:scaleType="centerInside"
                    android:layout_weight="1"
                    android:layout_marginStart="1dp"
                    app:tint="@color/larus_doc_edit_menu_item_color"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="2"
                    android:layout_marginStart="34dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
