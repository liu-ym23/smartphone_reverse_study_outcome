<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/record_page_view_header_right_bg"
        android:layout_width="500dp"
        android:layout_height="250dp"
        android:scaleType="fitXY"
        android:layout_marginStart="42dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/bitable_card_page_header_bg_right"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/record_page_view_header_left_bg"
        android:layout_width="500dp"
        android:layout_height="250dp"
        android:scaleType="fitXY"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/bitable_card_page_header_bg_left"/>
</merge>
