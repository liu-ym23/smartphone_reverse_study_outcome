<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:id="@+id/layout_deep_research_item_fold"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/deep_research_item_icon"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        android:layout_marginEnd="?attr/larus_dp_4"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/deepResearchArrowContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.larus.bmhome.chat.layout.widget.ShimmerTextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="?attr/larus_neutral_70"
            android:gravity="center_vertical"
            android:id="@+id/deepResearchShimmerTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/deepResearchArrow"
            android:layout_width="?attr/larus_dp_14"
            android:layout_height="?attr/larus_dp_14"
            android:layout_marginStart="?attr/larus_dp_2"
            android:layout_marginEnd="?attr/larus_dp_12"
            app:srcCompat="@drawable/larus_ic_tool_header_arrow_right"/>
    </LinearLayout>
</LinearLayout>
