<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.dux.text.DuxTextView
        android:textSize="15dp"
        android:textColor="#161823"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/live_life_shelf_product_title_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:fontFamily="sans-serif-medium"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:id="@+id/live_life_shelf_product_poi_container"
        android:layout_width="match_parent"
        android:layout_height="16dp">
        <com.bytedance.locallife.live.goodsshelves.view.LiveLifeShelfTextComponentView
            android:id="@+id/live_life_shelf_product_poi_distance_tv"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.locallife.live.goodsshelves.view.LiveLifeShelfTextComponentView
            android:id="@+id/live_life_shelf_product_poi_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/live_life_shelf_product_poi_tip_tv"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/live_life_shelf_product_poi_distance_tv"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.locallife.live.goodsshelves.view.LiveLifeShelfTextComponentView
            android:id="@+id/live_life_shelf_product_poi_tip_tv"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/live_life_shelf_product_poi_name_tv"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/live_life_shelf_product_labels_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.dux.text.DuxTextView
            android:textSize="10dp"
            android:textColor="#99161823"
            android:gravity="center_vertical"
            android:id="@+id/live_life_shelf_product_label_sold_count"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:maxLines="1"
            android:fontFamily="PingFangSC-Regular"
            android:layout_marginStart="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <com.bytedance.locallife.live.goodsshelves.view.PriorityWholeChildLayout
            android:id="@+id/live_life_shelf_product_labels"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxHeight="36dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/live_life_shelf_product_label_sold_count"
            app:layout_constraintHeight_max="36dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_orientation="vertical">
            <com.bytedance.locallife.live.goodsshelves.view.PriorityWholeChildLayout
                android:id="@+id/live_life_shelf_product_selling_labels"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                app:maxCount="1"/>
            <com.bytedance.locallife.live.goodsshelves.view.PriorityWholeChildLayout
                android:id="@+id/live_life_shelf_product_right_labels"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                app:overflowStrategy="stop"/>
        </com.bytedance.locallife.live.goodsshelves.view.PriorityWholeChildLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/live_life_shelf_product_lottery_label_container"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginTop="3dp">
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/live_life_shelf_product_lottery_label"
                android:background="@drawable/bg_live_local_life_lottery"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">
                <com.ss.android.ugc.aweme.live.dsl.view.CountDownTextView
                    android:id="@+id/live_life_shelf_product_lottery_label_count_down"
                    android:layout_width="30dp"
                    android:layout_height="match_parent"/>
                <com.bytedance.dux.text.DuxTextView
                    android:textSize="10dp"
                    android:textColor="#fe3c55"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/live_life_shelf_product_lottery_label_text"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:maxLines="1"/>
                <com.bytedance.dux.text.DuxTextView
                    android:textSize="10dp"
                    android:textColor="#fe3c55"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/live_life_shelf_product_lottery_label_join"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:maxLines="1"
                    android:layout_marginStart="2dp"/>
                <com.bytedance.lighten.loader.SmartImageView
                    android:id="@+id/live_life_shelf_product_lottery_label_join_arrow"
                    android:layout_width="4dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>
        </FrameLayout>
        <com.bytedance.dux.text.DuxTextView
            android:textSize="10dp"
            android:textColor="#99161823"
            android:gravity="center_vertical"
            android:id="@+id/live_life_shelf_product_lottery_label_sold_count"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:fontFamily="PingFangSC-Regular"
            android:layout_marginStart="5dp"/>
    </LinearLayout>
</merge>
