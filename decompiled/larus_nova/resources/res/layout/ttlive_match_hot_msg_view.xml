<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/match_hot_view_container"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:alpha="0">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_webp_spread_bg"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginLeft="166dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/text_container"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="12dp">
        <ImageView
            android:id="@+id/text_container_bg"
            android:background="@drawable/ttlive_match_hot_msg_bg"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/hot_msg_text_layout"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginLeft="@dimen/ttlive_match_hot_content_part_margin_left"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/combo_container"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_default="wrap">
            <TextView
                android:textSize="14.2dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/hot_msg_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:maxLines="1"
                android:maxEms="8"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/combo_container"
            android:visibility="visible"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/ttlive_match_hot_combo_part_margin_right"
            android:layout_marginStart="@dimen/ttlive_match_hot_combo_part_margin_left"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/hot_msg_text_layout"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="10sp"
                android:textColor="#ffffff"
                android:layout_gravity="bottom"
                android:id="@+id/hot_msg_combo_count_x"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_match_combo_x"
                android:includeFontPadding="false"/>
            <com.bytedance.android.livesdk.widget.MaxWidthTextView
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:layout_gravity="center_vertical"
                android:id="@+id/hot_msg_combo_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/ttlive_match_hot_combo_count_in_combo_part_margin_left"
                android:text=""
                android:includeFontPadding="false"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/match_hot_msg_applause_webp"
        android:layout_width="200dp"
        android:layout_height="60dp"/>
</FrameLayout>
