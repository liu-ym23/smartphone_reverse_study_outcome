<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.awemeopen.apps.framework.story.view.AoStoryVideoView
        android:id="@+id/ao_story_video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.awemeopen.infra.base.image.AoImageView
        android:id="@+id/ao_story_video_blue_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.awemeopen.infra.base.image.AoImageView
        android:id="@+id/ao_story_video_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/story_feed_gesture_fl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:id="@+id/story_video_float_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/aos_s1"
            android:ellipsize="end"
            android:id="@+id/story_video_title_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="12dp"
            android:maxLines="2"
            android:layout_alignParentTop="true"/>
        <com.bytedance.awemeopen.infra.base.image.AoImageView
            android:id="@+id/story_video_play_or_pause_icon"
            android:padding="14dp"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerInside"
            android:layout_centerInParent="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/story_fast_speed_layout"
            android:background="@drawable/story_fast_speed_bg"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true">
            <com.bytedance.awemeopen.infra.base.anim.lottie.AoAnimationLottieView
                android:id="@+id/story_fast_speed_lottie_view"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:scaleType="centerInside"
                android:importantForAccessibility="no"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/aos_main_level_1"
                android:id="@+id/story_fast_speed_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/story_fast_speed"/>
        </LinearLayout>
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/story_video_bottom_play_lt"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_alignParentBottom="true">
            <TextView
                android:textSize="11sp"
                android:textColor="@color/aos_s1"
                android:id="@+id/story_seek_bar_play_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"/>
            <SeekBar
                android:id="@+id/video_seek_bar"
                android:layout_width="238dp"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:maxHeight="2dp"
                android:max="10000"
                android:progress="0"
                android:progressDrawable="@drawable/aos_story_feed_video_seek_bar_layer_stable_progress"
                android:thumb="@drawable/aos_story_feed_seek_bar_middle_circle_small"
                android:thumbOffset="1dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:layout_toEndOf="@+id/story_seek_bar_play_time"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/aos_s1"
                android:id="@+id/story_seek_bar_end_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@+id/video_seek_bar"/>
            <TextView
                android:id="@+id/story_video_inner_feed_tv"
                android:background="@drawable/aos_story_feed_inner_bg"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="16dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <ProgressBar
            android:id="@+id/story_video_bottom_progress_bar"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:maxHeight="2dp"
            android:max="10000"
            android:progress="60"
            android:layout_alignParentBottom="true"
            style="@style/story_video_progress"/>
        <RelativeLayout
            android:orientation="horizontal"
            android:id="@+id/story_video_bottom_info_lt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:layout_alignParentBottom="true">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/aos_s1"
                android:id="@+id/story_video_info_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/aos_s1"
                android:id="@+id/story_video_total_time_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
