<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/llGuideContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp">
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerLinearlayout
        android:orientation="vertical"
        android:id="@+id/llPcGuideContainer"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ttlive_allRadius="8dp">
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/ttlive_layout_pc_play_guide_item"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/svPc"
            android:visibility="gone"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp">
            <include
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/ttlive_layout_pc_play_guide_content"/>
        </androidx.core.widget.NestedScrollView>
    </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerLinearlayout>
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerLinearlayout
        android:orientation="vertical"
        android:id="@+id/llPadGuideContainer"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="21dp"
        app:ttlive_allRadius="8dp">
        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/ttlive_layout_pad_play_guide_item"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/svPad"
            android:visibility="gone"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp">
            <include
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/ttlive_layout_pad_play_guide_content"/>
        </androidx.core.widget.NestedScrollView>
    </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerLinearlayout>
</LinearLayout>
