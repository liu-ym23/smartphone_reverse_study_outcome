<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="32dp">
    <ProgressBar
        android:id="@+id/ktv_challenge_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/ktv_room_challenge_progress"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#ffffff"
        android:gravity="center_vertical"
        android:id="@+id/ktv_challenge_count_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:text=""
        android:drawableLeft="@drawable/ttlive_ktv_mv_singer_hot_icon"
        android:drawablePadding="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#ffffff"
        android:gravity="center_vertical"
        android:id="@+id/ktv_challenge_current_value"
        android:paddingRight="0dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:shadowColor="#4d2d2459"
        android:shadowDx="0"
        android:shadowDy="1.67"
        android:shadowRadius="3.33"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/ktv_challenge_count_type"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#7fffffff"
        android:gravity="center_vertical"
        android:id="@+id/ktv_challenge_target_value"
        android:paddingLeft="0dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:shadowColor="#4d2d2459"
        android:shadowDx="0"
        android:shadowDy="1.67"
        android:shadowRadius="3.33"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/ktv_challenge_current_value"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ktv_challenge_count_down_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="10dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/ktv_challenge_count_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:enabled="true"
                android:textSize="8dp"
                android:textColor="#e6ffffff"
                android:ellipsize="marquee"
                android:gravity="start|center_vertical"
                android:id="@+id/ktv_challenge_song_title"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fadingEdge="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:id="@+id/ktv_challenge_result_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
