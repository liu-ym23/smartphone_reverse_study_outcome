<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/BGPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/board_button_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/left_view_layout"
            android:visibility="gone"
            android:layout_width="95dp"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/board_content_text_rv"
                android:layout_width="95dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/place_holder"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/board_content_text_rv"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/board_content_rv"
            android:paddingLeft="12dp"
            android:paddingTop="3.5dp"
            android:paddingRight="12dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/board_button_layout"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content_layout">
        <com.ss.android.ugc.aweme.search.filter.view.ui.NoPaddingTextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/TextPrimary"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/board_reset_btn"
            android:background="@color/BGInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:text="@string/search_filter_board_reset"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:layout_marginEnd="7.5dp"/>
        <com.ss.android.ugc.aweme.search.common.ECSearchBrandRedGradientBackgroundView
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/board_ensure_btn"
            android:background="@color/Primary"
            android:clipChildren="true"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/board_ensure_btn_loading"
                android:layout_width="16dp"
                android:layout_height="16dp"/>
            <com.ss.android.ugc.aweme.search.common.ECSearchBrandRedGradientTextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/ConstTextInverse"
                android:gravity="center"
                android:id="@+id/board_ensure_btn_text"
                android:background="@color/Primary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/search_filter_board_ensure_confirm"/>
        </com.ss.android.ugc.aweme.search.common.ECSearchBrandRedGradientBackgroundView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
