<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="6dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="6dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/talent_avatar_border"
            android:background="@drawable/ttlive_bg_vs_talent_avatar_border"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/talent_avatar"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/talent_verify_icon"
            android:layout_width="10dp"
            android:layout_height="10dp"/>
    </FrameLayout>
    <com.bytedance.android.livesdk.chatroom.replay.interactionmsg.danmaku.barrage.view.VSGifDanmuTextView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_danmaku_text"
        android:paddingRight="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        android:includeFontPadding="false"
        android:paddingEnd="10dp"
        app:sectionText="HHHHHHHHHH"
        app:sectionTextColor="@color/white"
        app:sectionTextSize="16dp"/>
</LinearLayout>
