<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_dialog_ktv_sing_mode_setting_dialog"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="15dp"
        android:textColor="#e6ffffff"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:text="@string/ttlive_ktv_sing_mode_text"/>
    <View
        android:background="#64ffffff"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:alpha="0.8"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/singModeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="16dp"
        android:divider="@drawable/ttlive_ktv_sing_mode_item_divider"
        android:showDividers="middle">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/singModeAudioView"
            android:layout_width="@dimen/ttlive_ktv_sing_mode_setting_item_width"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/singModeAudioImageContent"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ttlive_ktv_sing_mode_setting_item_image_height">
                <com.bytedance.android.live.core.widget.HSImageView
                    android:id="@+id/audioModeIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:actualImageScaleType="fitXY"
                    app:failureImage="@drawable/ttlive_ktv_sing_mode_item_default_bg"
                    app:failureImageScaleType="fitXY"
                    app:placeholderImage="@drawable/ttlive_ktv_sing_mode_item_default_bg"
                    app:placeholderImageScaleType="fitXY"
                    app:roundedCornerRadius="8dp"/>
                <FrameLayout
                    android:layout_gravity="center_horizontal"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="42dp">
                    <com.bytedance.android.live.core.widget.HSImageView
                        android:id="@+id/singEffectAnimView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <com.bytedance.android.live.core.widget.HSImageView
                        android:id="@+id/avatarView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="6dp"
                        app:roundAsCircle="true"/>
                </FrameLayout>
                <View
                    android:id="@+id/audioSelectedView"
                    android:background="@drawable/ttlive_ktv_sing_mode_item_selector"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ttlive_ktv_sing_mode_item_text_color"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ttlive_ktv_sing_mode_audio"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/singModeVideoView"
            android:layout_width="@dimen/ttlive_ktv_sing_mode_setting_item_width"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/singModeVideoImageContent"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ttlive_ktv_sing_mode_setting_item_image_height">
                <com.bytedance.android.live.core.widget.HSImageView
                    android:id="@+id/videoModeIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:actualImageScaleType="fitXY"
                    app:failureImage="@drawable/ttlive_ktv_sing_mode_item_default_bg"
                    app:failureImageScaleType="fitXY"
                    app:placeholderImage="@drawable/ttlive_ktv_sing_mode_item_default_bg"
                    app:placeholderImageScaleType="fitXY"
                    app:roundedCornerRadius="8dp"/>
                <FrameLayout
                    android:layout_gravity="bottom"
                    android:id="@+id/videoSettingLayout"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_margin="4dp">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/videoSettingView"
                        android:background="@drawable/ttlive_ktv_sing_mode_item_setting_bg"
                        android:layout_width="match_parent"
                        android:layout_height="30dp">
                        <View
                            android:background="@drawable/ttlive_ktv_sing_mode_preview_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"/>
                        <TextView
                            android:textSize="12dp"
                            android:textColor="#fff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ttlive_ktv_sing_mode_set_beauty_effect"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/videoSwitchCameraView"
                        android:background="@drawable/ttlive_ktv_sing_mode_item_setting_bg"
                        android:layout_width="match_parent"
                        android:layout_height="30dp">
                        <View
                            android:background="@drawable/ttlive_ktv_sing_mode_camera_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"/>
                        <TextView
                            android:textSize="12dp"
                            android:textColor="#fff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ttlive_ktv_sing_mode_set_switch_camera"/>
                    </LinearLayout>
                </FrameLayout>
                <View
                    android:id="@+id/videoSelectedView"
                    android:background="@drawable/ttlive_ktv_sing_mode_item_selector"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ttlive_ktv_sing_mode_item_text_color"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ttlive_ktv_sing_mode_video"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="15dp"
        android:textColor="#fff"
        android:gravity="center"
        android:id="@+id/btn_ok"
        android:background="@drawable/ttlive_bg_ktv_avatar_btn_common_red"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="25dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="18dp"
        android:text="@string/ttlive_ok"/>
</LinearLayout>
