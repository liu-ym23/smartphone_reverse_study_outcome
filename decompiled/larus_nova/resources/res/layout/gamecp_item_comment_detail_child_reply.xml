<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:paddingStart="56dp"
    android:paddingEnd="16dp">
    <com.bytedance.android.gamecp.common.ui.UserAvatarImageView
        android:id="@+id/iv_comment_detail_child_reply_item_avatar"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/gamecp_game_promote_comment_default_avatar_bg"
        app:roundAsCircle="true"/>
    <LinearLayout
        android:id="@+id/ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/gamecp_game_99161823"
            android:ellipsize="end"
            android:id="@+id/tv_comment_detail_child_reply_item_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="150dp"
            android:lines="1"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_comment_detail_child_reply_item_icon"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/gamecp_ic_comment_detail_reply_to_user"
            android:layout_marginStart="4dp"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/gamecp_game_99161823"
            android:ellipsize="end"
            android:id="@+id/tv_comment_detail_child_reply_to_user_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_weight="1"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/gamecp_game_57161823"
        android:id="@+id/tv_comment_detail_child_reply_item_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/cl_comment_detail_child_reply_item_like_container"
        app:layout_constraintStart_toStartOf="@+id/tv_comment_detail_child_reply_item_content"
        app:layout_constraintTop_toTopOf="@+id/cl_comment_detail_child_reply_item_like_container"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/gamecp_game_BF161823"
        android:id="@+id/tv_comment_detail_child_reply_item_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll"/>
    <ImageView
        android:id="@+id/iv_comment_detail_child_reply_item_option"
        android:background="@drawable/gamecp_ic_comment_options"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_comment_detail_child_reply_item_like_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_comment_detail_child_reply_item_content">
        <ImageView
            android:id="@+id/iv_comment_detail_child_reply_item_like"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/gamecp_ic_game_promote_comment_like_v2"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/gamecp_game_80161823"
            android:id="@+id/tv_comment_detail_child_reply_item_like_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_comment_detail_child_reply_item_like"
            app:layout_constraintStart_toEndOf="@+id/iv_comment_detail_child_reply_item_like"
            app:layout_constraintTop_toTopOf="@+id/iv_comment_detail_child_reply_item_like"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
