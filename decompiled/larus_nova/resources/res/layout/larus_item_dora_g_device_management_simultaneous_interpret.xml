<?xml version="1.0" encoding="utf-8"?>
<com.larus.common_ui.widget.roundlayout.RoundRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_154"
    android:layout_marginTop="?attr/larus_dp_12"
    android:layout_marginStart="?attr/larus_dp_4"
    android:layout_marginEnd="?attr/larus_dp_16"
    app:rv_backgroundColor="@color/larus_base_2"
    app:rv_cornerRadius="?attr/larus_dp_16">
    <ImageView
        android:id="@+id/icon_si"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:src="@drawable/larus_dora_icon_si"/>
    <TextView
        android:textSize="?attr/larus_dp_16"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/tv_si_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_dora_g_device_simult_trans_cn"
        android:layout_marginStart="?attr/larus_dp_6"
        android:layout_toEndOf="@+id/icon_si"/>
    <ImageView
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:src="@drawable/larus_ic_arrow"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/icon_switch_language"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_27"
        android:src="@drawable/larus_dora_icon_switch_language"
        android:layout_below="@+id/icon_si"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="?attr/larus_dp_12"
        android:textColor="@color/larus_neutral_50"
        android:id="@+id/tv_start_language"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_23"
        android:text="@string/larus_dora_g_device_lang_chinese_cn"
        android:layout_below="@+id/icon_si"
        android:layout_marginEnd="?attr/larus_dp_10"
        android:layout_toStartOf="@+id/icon_switch_language"/>
    <TextView
        android:textSize="?attr/larus_dp_12"
        android:textColor="@color/larus_neutral_50"
        android:id="@+id/tv_end_language"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_23"
        android:text="@string/larus_dora_g_device_lang_english_cn"
        android:layout_below="@+id/icon_si"
        android:layout_marginStart="?attr/larus_dp_10"
        android:layout_toEndOf="@+id/icon_switch_language"/>
    <com.larus.common_ui.widget.roundlayout.RoundTextView
        android:textSize="?attr/larus_dp_14"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/btn_start_si"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_36"
        android:text="@string/larus_dora_g_device_start_trans_cn"
        android:layout_alignParentBottom="true"
        app:rv_backgroundColor="@color/larus_base_3_overlay"
        app:rv_cornerRadius="?attr/larus_dp_8"/>
</com.larus.common_ui.widget.roundlayout.RoundRelativeLayout>
