<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_title"
        android:background="@color/bg_body"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_alignParentTop="true">
        <TextView
            android:textSize="17sp"
            android:gravity="center_vertical"
            android:id="@+id/btn_back"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:drawableLeft="@drawable/icon_back_white"/>
        <androidx.appcompat.widget.AppCompatCheckBox
            android:textSize="16dp"
            android:textColor="@color/static_white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/cb_select_photo"
            android:background="@drawable/checkbox_bg_selector"
            android:clickable="true"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginRight="17dp"
            android:button="@null"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/photo_bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <include
            android:id="@+id/layout_photo_insert_message_new"
            layout="@layout/photo_picker_insert_to_input_bar"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layout_original_photo"
            android:background="@color/bg_body"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="visible"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/origin_zone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0">
                <com.larksuite.component.ui.button.LKUICheckBox
                    android:id="@+id/cb_original_photo"
                    android:paddingLeft="18dp"
                    android:paddingRight="18dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:minHeight="28dp"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/white_text_enable_selector"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:layout_gravity="center"
                    android:id="@+id/original_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="-7dp"
                    android:minHeight="28dp"
                    android:text="@string/Lark_Legacy_OriginPic"
                    android:maxLines="12"
                    android:layout_toRightOf="@+id/cb_original_photo"/>
            </RelativeLayout>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/text_title"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:layout_gravity="center"
                    android:id="@+id/tv_edit_photo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="100dp"
                    android:minHeight="28dp"
                    android:text="@string/Lark_Legacy_Edit"
                    android:maxLines="12"/>
            </FrameLayout>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <FrameLayout
                android:id="@+id/layout_photo_insert_message"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0">
                <com.larksuite.component.universe_design.button.UDButton
                    android:textSize="14sp"
                    android:textColor="@color/photo_picker_insert_message_text_color"
                    android:ellipsize="end"
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/btn_photo_insert_message"
                    android:layout_marginRight="12dp"
                    android:minWidth="64dp"
                    android:text="@string/Lark_IM_Attach_InsertIntoMessage_Button"
                    android:maxLines="1"
                    android:textAllCaps="false"
                    app:ud_backgroundColor="@color/N900_5"
                    style="@style/UDButton.Small.Primary"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/layout_photo_send"
                android:paddingRight="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0">
                <com.larksuite.component.universe_design.button.UDButton
                    android:textColor="@color/static_white"
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/btn_photo_send"
                    android:text="@string/Lark_Legacy_Send"
                    app:ud_backgroundColor="@color/ud_button_blue_bg"
                    style="@style/UDButton.Small.Primary"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/photo_bottom_content_anchor"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_alignParentBottom="true"/>
    <FrameLayout
        android:id="@+id/container"
        android:background="@color/lkui_transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/photo_bottom_content_anchor"
        android:layout_below="@+id/layout_title">
        <FrameLayout
            android:id="@+id/photoPagerFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</RelativeLayout>
