<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/divider_2"
        android:background="@drawable/ttlive_ktv_shadow_divider_light"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="9dp"
        app:layout_constraintBottom_toTopOf="@+id/go_ktv_dialog"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="#9d9d9d"
        android:id="@+id/cur_play_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/go_ktv_dialog"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/go_ktv_dialog"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cut_song_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/go_ktv_dialog"
        app:layout_constraintRight_toLeftOf="@+id/go_ktv_dialog"
        app:layout_constraintTop_toTopOf="@+id/go_ktv_dialog">
        <View
            android:id="@+id/cut_song_img"
            android:background="@drawable/ttlive_ktv_music_controller_next_song_light"
            android:layout_width="28dp"
            android:layout_height="28dp"
            app:layout_constraintBottom_toTopOf="@+id/cut_music_tv"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="8dp"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/cut_music_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_ktv_sing_next_song"
            android:includeFontPadding="false"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cut_song_img"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pause_restart_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/go_ktv_dialog"
        app:layout_constraintRight_toLeftOf="@+id/cut_song_container"
        app:layout_constraintTop_toTopOf="@+id/go_ktv_dialog">
        <View
            android:id="@+id/pause_restart_img"
            android:background="@drawable/ttlive_ktv_music_controller_start_light"
            android:layout_width="28dp"
            android:layout_height="28dp"
            app:layout_constraintBottom_toTopOf="@+id/pause_restart_tv"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="8dp"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/pause_restart_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_ktv_sing_pause"
            android:includeFontPadding="false"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pause_restart_img"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <Button
        android:textSize="13dp"
        android:textColor="@color/ttlive_white"
        android:gravity="center"
        android:id="@+id/go_ktv_dialog"
        android:background="@drawable/ttlive_bg_ktv_red_bt"
        android:layout_width="100dp"
        android:layout_height="36dp"
        android:layout_marginBottom="5dp"
        android:text="@string/ttlive_ktv_room_go_dialog"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider_2"/>
</merge>
