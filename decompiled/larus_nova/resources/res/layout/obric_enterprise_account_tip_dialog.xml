<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_container"
        android:paddingBottom="@dimen/dp_18"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_8"
        android:paddingEnd="@dimen/dp_8">
        <include
            android:id="@+id/system_storage_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/obric_enterprise_account_tip_list_item"/>
        <include
            android:id="@+id/cloud_space_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/obric_enterprise_account_tip_list_item"/>
        <include
            android:id="@+id/phone_control_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/obric_enterprise_account_tip_list_item"/>
        <include
            android:id="@+id/memory_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/obric_enterprise_account_tip_list_item"/>
        <include
            android:id="@+id/wakeup_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/obric_enterprise_account_tip_list_item"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_16">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/never_show_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_32">
            <com.obric.oui.checkbox.OCheckBoxLayout
                android:id="@+id/never_show_checkbox"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:checked="false"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/oui_basic_text_1"
                android:gravity="center_vertical"
                android:id="@+id/never_show_text"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_30"
                android:text="@string/obric_enterprise_account_tip_never_show"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
