<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/talkroom_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/cameraroom_layout"
        android:visibility="gone"
        layout="@layout/ttlive_video_cameraroom"/>
    <include
        android:id="@+id/cameraroom_new"
        android:visibility="gone"
        layout="@layout/ttlive_video_talkroom"/>
    <include
        android:id="@+id/nine_window_layout"
        android:visibility="gone"
        layout="@layout/ttlive_layout_nine_window_room"/>
    <include
        android:id="@+id/base_common_window_layout"
        android:visibility="gone"
        layout="@layout/ttlive_base_multi_link_window_manager"/>
    <FrameLayout
        android:id="@+id/dynamic_layers_front"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include
        android:id="@+id/dynamic_float_anchor_window_layout"
        android:visibility="gone"
        layout="@layout/ttlive_video_dynamic_float_anchor_multi_link_window_manager"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/play_mode_status_effect"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="50dp"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center"
        android:id="@+id/request_song_status_effect"
        android:visibility="gone"
        android:layout_width="111dp"
        android:layout_height="121dp"
        app:actualImageScaleType="fitCenter"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center"
        android:id="@+id/themed_competition_status_effect"
        android:visibility="gone"
        android:layout_width="150dp"
        android:layout_height="110dp"
        app:actualImageScaleType="fitCenter"/>
    <FrameLayout
        android:id="@+id/ktv_chorus_concert_lynx_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/video_chorus_lynx_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/guest_battle_rank_transition_container_root"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/guest_battle_rank_first_transition_icon_root"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            app:placeholderImage="@drawable/ttlive_guest_battle_tiny_crown"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/voice_chat_interact_emoji_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <android.opengl.GLSurfaceView
        android:id="@+id/interact_render_container_talkroom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
