<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="#ffffffff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedance.locallife.photo.layout.FlowLayout
                android:id="@+id/flow_tag_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                app:life_photo_tag_maxline="3"
                app:life_photo_tag_space_horizontal="8dp"
                app:life_photo_tag_space_vertical="8dp"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="bottom|right"
                android:id="@+id/more_tag"
                android:background="#ffffff"
                android:paddingLeft="12dp"
                android:paddingTop="5dp"
                android:paddingRight="12dp"
                android:paddingBottom="5dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.bytedance.dux.text.DuxTextView
                    android:textColor="#161823"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/poi_album_more_tags"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/album_share"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_poi_album_tag_more"/>
            </LinearLayout>
        </FrameLayout>
        <com.bytedance.locallife.photo.photopage.view.PoiAlbumHorizontalTag
            android:id="@+id/album_horizontal_tag"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <View
        android:background="#ffffffff"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <View
        android:id="@+id/shadow_view"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
</merge>
