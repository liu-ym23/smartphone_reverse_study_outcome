<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_layout"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="@drawable/ttlive_bg_qa_title_prefix"
                android:layout_width="2dp"
                android:layout_height="10dp"/>
            <com.bytedance.android.live.ui.artist.ArtistTextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="52dp"/>
            <TextView
                android:textSize="11dp"
                android:ellipsize="end"
                android:id="@+id/tv_title_rendertext"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="52dp"/>
        </LinearLayout>
        <RelativeLayout
            android:textColor="#161823"
            android:id="@+id/micro_app_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">
            <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerImageView
                android:id="@+id/iv_micro_app_cover"
                android:layout_width="38dp"
                android:layout_height="38dp"
                app:ttlive_allRadius="4dp"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="#161823"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_micro_app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="20dp"
                android:maxLines="1"
                android:layout_marginStart="6dp"
                android:layout_toEndOf="@+id/iv_micro_app_cover"/>
            <TextView
                android:textSize="11dp"
                android:textColor="#99161823"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_micro_app_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:minHeight="15dp"
                android:maxLines="1"
                android:layout_below="@+id/tv_micro_app_title"
                android:layout_marginStart="6dp"
                android:layout_toEndOf="@+id/iv_micro_app_cover"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/review_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp">
            <TextView
                android:textSize="12dp"
                android:textColor="#57000000"
                android:gravity="center_vertical"
                android:id="@+id/tv_review"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="16dp"
                android:text="@string/ttlive_comment_pin_waiting"
                android:includeFontPadding="false"/>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/waiting"
                android:layout_width="20dp"
                android:layout_height="12dp"
                android:scaleType="centerInside"
                android:layout_marginStart="4dp"
                app:lottie_autoPlay="false"
                app:lottie_fileName="pin_reviewing.json"
                app:lottie_loop="true"/>
        </LinearLayout>
        <include layout="@layout/ttlive_pin_container_process_area"/>
    </LinearLayout>
</merge>
