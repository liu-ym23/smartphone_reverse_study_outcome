<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_pay_payment_confirm_root_view"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/cj_pay_inner_root"
        android:background="@color/cj_pay_color_gray_248"
        android:paddingTop="44dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="99dp">
        <ImageView
            android:id="@+id/cj_pay_iv_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cj_pay_iv_title_container"
                android:background="@color/cj_pay_color_trans"
                android:layout_width="match_parent"
                android:layout_height="52dp">
                <com.android.ttcjpaysdk.base.ui.component.CJCarouselView
                    android:id="@+id/cj_pay_carousel_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginLeft="40dp"
                    android:layout_marginRight="40dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/cj_pay_back_view"
                    android:background="@drawable/cj_pay_close_press_selector"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginLeft="@dimen/cj_pay_font_size_16"
                    android:layout_marginTop="12dp"
                    android:src="@drawable/cj_pay_ic_titlebar_close_onlight"
                    android:scaleType="centerCrop"
                    android:alpha="0.75"
                    android:layout_marginStart="12dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.android.ttcjpaysdk.thirdparty.view.CJPayCircularImageView
                    android:id="@+id/cj_pay_user_info"
                    android:visibility="gone"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginRight="16dp"
                    android:foreground="@drawable/cj_pay_iv_foreground_press_selector"
                    android:src="@drawable/cj_pay_bg_circle_placeholder_image"
                    android:scaleType="centerCrop"
                    android:alpha="0.75"
                    app:border_color="@color/cj_pay_color_gray_161823_opacity_12"
                    app:border_width="0.5dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/cj_pay_order_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/cj_pay_padding_24"
                android:layout_marginTop="0dp"
                android:layout_marginRight="@dimen/cj_pay_padding_24"
                android:singleLine="true"
                android:includeFontPadding="false"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cj_pay_total_value_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <TextView
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:id="@+id/cj_pay_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cj_pay_currency_unit"
                    app:layout_constraintBaseline_toBaselineOf="@+id/cj_pay_total_value"
                    app:layout_constraintEnd_toStartOf="@+id/cj_pay_total_value"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"/>
                <com.android.ttcjpaysdk.base.ui.widget.ScrollAnimTextView
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:id="@+id/cj_pay_total_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/cj_pay_padding_2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/cj_pay_unit"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/cj_pay_color_gray_161823_opacity_40"
                    android:ellipsize="end"
                    android:id="@+id/tv_origin_price"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBaseline_toBaselineOf="@+id/cj_pay_total_value"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toEndOf="@+id/cj_pay_total_value"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <RelativeLayout
                android:id="@+id/rl_voucher_layout"
                android:paddingLeft="28dp"
                android:paddingRight="28dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cj_pay_padding_6">
                <HorizontalScrollView
                    android:scrollbars="none"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/voucher_content_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </HorizontalScrollView>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/cj_ic_voucher_mask"
                    android:layout_alignParentRight="true"/>
            </RelativeLayout>
            <View
                android:id="@+id/view_below_voucher_layout"
                android:layout_width="wrap_content"
                android:layout_height="22dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_payment_notice_layout"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginRight="2dp"
                    android:src="@drawable/cj_ic_info"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/cj_pay_color_gray_161823_opacity_34"
                    android:ellipsize="end"
                    android:id="@+id/tv_payment_notice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"/>
            </LinearLayout>
            <FrameLayout
                android:id="@+id/cj_payment_addi_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.android.ttcjpaysdk.bdpay.counter.outer.customView.CJXRequiredView
                android:id="@+id/v_x_required_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:id="@+id/fl_payment_method"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cj_pay_bg_r8_white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="12dp"
                android:layout_marginBottom="16dp">
                <com.android.ttcjpaysdk.bdpay.counter.outer.customView.CJXEasyRecView
                    android:id="@+id/v_x_optional_layout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"/>
                <com.android.ttcjpaysdk.base.ui.widget.LoadingButton
                    android:id="@+id/cj_pay_confirm"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cj_pay_height_48"
                    app:btnTextSize="16sp"
                    app:enablePressedState="true"/>
            </LinearLayout>
            <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
                android:id="@+id/bottom_insurance_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_alignParentBottom="true"
                app:theme_type="0"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
