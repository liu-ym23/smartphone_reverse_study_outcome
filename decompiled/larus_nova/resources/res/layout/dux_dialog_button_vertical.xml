<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/divider_line_top"
        android:background="@color/LineReverse2"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <com.bytedance.dux.button.DuxButton
        android:textColor="@color/TextReverse"
        android:gravity="center"
        android:id="@+id/actionPositive"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:lines="1"
        style="@style/DuxDialog.Button.Text.Primary.Large"/>
    <View
        android:id="@+id/divider_line_middle"
        android:background="@color/LineReverse2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <com.bytedance.dux.button.DuxButton
        android:textStyle="normal"
        android:textColor="@color/TextReverse2"
        android:gravity="center"
        android:id="@+id/actionNeutral"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:lines="1"
        style="@style/DuxDialog.Button.Text.Primary.Large"/>
    <View
        android:id="@+id/divider_line_neutral"
        android:background="@color/LineReverse2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <com.bytedance.dux.button.DuxButton
        android:textStyle="normal"
        android:textColor="@color/TextReverse2"
        android:gravity="center"
        android:id="@+id/actionNegative"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:lines="1"
        style="@style/DuxDialog.Button.Text.Primary.Large"/>
</LinearLayout>
