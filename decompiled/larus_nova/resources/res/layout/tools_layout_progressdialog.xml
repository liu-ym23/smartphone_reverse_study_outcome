<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@drawable/tools_bg_progressdialog"
    android:paddingLeft="8dp"
    android:paddingTop="15.5dp"
    android:paddingRight="8dp"
    android:paddingBottom="15.5dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="44dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/customProgressView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false">
        <com.ss.android.ugc.tools.view.widget.CircularProgressView
            android:layout_gravity="center"
            android:id="@+id/iv_loading"
            android:background="@drawable/tools_bg_upload_progress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:cpv_animAutostart="true"
            app:cpv_color="@color/tools_white"
            app:cpv_indeterminate="true"
            app:cpv_maxProgress="100"
            app:cpv_startAngle="180"
            app:cpv_thickness="2dp"/>
        <com.ss.android.ugc.tools.view.style.StyleTextView
            android:textColor="@color/tools_white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            style="@style/tools_font_size_20"/>
    </FrameLayout>
    <com.ss.android.ugc.tools.view.style.StyleTextView
        android:textColor="@color/tools_white"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/message"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:autoSizeMaxTextSize="15sp"
        app:autoSizeMinTextSize="10sp"
        app:autoSizeStepGranularity="1dp"
        app:autoSizeTextType="uniform"/>
    <com.ss.android.ugc.tools.view.style.StyleTextView
        android:textSize="12sp"
        android:textColor="@color/tools_white"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/tip_content"
        android:visibility="gone"
        android:layout_width="170dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"/>
</LinearLayout>
