<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="@dimen/dp_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp_48"
    android:paddingEnd="16dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/cardContainer"
        android:background="@drawable/obric_omni_bg_card_grey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layoutCompletedHeader"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp_8"
            android:paddingEnd="@dimen/dp_12">
            <ImageView
                android:layout_width="@dimen/dp_18"
                android:layout_height="@dimen/dp_18"
                android:src="@drawable/obric_omni_ic_operate_phone"/>
            <TextView
                android:textSize="@dimen/dp_14"
                android:textColor="?attr/larus_neutral_70"
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="手机任务"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="@dimen/dp_5"/>
            <ImageView
                android:id="@+id/ivArrow"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/obric_icon_bold_gray_right_arrow"
                android:layout_marginStart="@dimen/dp_2"
                app:tint="?attr/larus_neutral_70"/>
        </LinearLayout>
        <View
            android:id="@+id/divider"
            android:background="?attr/larus_neutral_transparent_1"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/bodyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp_8"
            android:paddingEnd="@dimen/dp_12">
            <com.larus.bmhome.chat.layout.widget.ShimmerLinearLayout
                android:orientation="horizontal"
                android:id="@+id/progressContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/leftIcon"
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginBottom="@dimen/dp_12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.larus.bmhome.view.textview.impl.CustomMarkdownTextView
                        android:textSize="@dimen/dp_14"
                        android:textColor="?attr/larus_primary_50"
                        android:ellipsize="end"
                        android:id="@+id/tvProcessContent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_11"
                        android:layout_marginBottom="@dimen/dp_12"
                        android:maxLines="2"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginStart="@dimen/dp_5"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/rightIcon"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/rightIcon"
                        android:background="@drawable/obric_omni_ic_operate_phone_arrow"
                        android:layout_width="@dimen/dp_18"
                        android:layout_height="@dimen/dp_18"
                        android:layout_marginTop="@dimen/dp_12"
                        android:layout_marginStart="@dimen/dp_2"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintStart_toEndOf="@+id/tvProcessContent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.larus.bmhome.chat.layout.widget.ShimmerLinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/innerRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_11"
                android:layout_marginBottom="@dimen/dp_4"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
