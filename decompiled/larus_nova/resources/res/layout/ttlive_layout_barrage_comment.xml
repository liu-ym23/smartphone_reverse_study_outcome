<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/carnival_danmaku_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/container_horizontal"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/horizontal_danmaku_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textColor="@color/black"
            android:layout_gravity="center_vertical"
            android:id="@+id/horizontal_danmaku_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/container_vertical"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="30dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/vertical_inner_first_container"
            android:clipChildren="false"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:transformPivotX="18dp"
            android:transformPivotY="13dp"
            android:rotation="-90">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/vertical_inner_second_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/vertical_danmaku_icon"
                    android:background="@drawable/ttlive_img_avatar_empty"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:scaleType="fitCenter"/>
                <TextView
                    android:textSize="18dp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/vertical_danmaku_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxEms="1"
                    android:ems="1"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
