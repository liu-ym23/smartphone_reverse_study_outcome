<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.locallife.live.goodsshelves.view.LiveLifeShelfProductContentContainerView
        android:id="@+id/live_life_shelf_product_content_container"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.locallife.live.goodsshelves.view.LiveLifeShelfProductPriceAndBtnContainerView
        android:id="@+id/live_life_shelf_product_price_and_btn_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.bytedance.dux.text.DuxTextView
        android:textSize="10dp"
        android:textColor="#99161823"
        android:gravity="center_vertical"
        android:id="@+id/live_life_shelf_product_sold_count"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:maxLines="1"
        android:fontFamily="PingFangSC-Regular"
        app:layout_constraintBottom_toTopOf="@+id/live_life_shelf_product_price_and_btn_container"
        app:layout_constraintEnd_toEndOf="@+id/live_life_shelf_product_price_and_btn_container"/>
</merge>
