<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dora_device_info_scroll_view"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:paddingLeft="?attr/larus_dp_12"
        android:paddingTop="?attr/larus_dp_76"
        android:paddingRight="?attr/larus_dp_12"
        android:paddingBottom="?attr/larus_dp_10"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/dora_device_anchor_view"
            android:layout_width="?attr/larus_dp_120"
            android:layout_height="?attr/larus_dp_216"
            android:layout_marginTop="?attr/larus_dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/dora_device_dark_highlight_mask"
            android:layout_width="?attr/larus_dp_400"
            android:layout_height="?attr/larus_dp_400"
            android:src="@drawable/larus_dora_device_dark_highlight_bg"
            app:layout_constraintBottom_toBottomOf="@+id/dora_device_anchor_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/dora_device_anchor_view"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dora_device_header_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/dora_device_img_left"
                android:layout_width="?attr/larus_dp_120"
                android:layout_height="?attr/larus_dp_216"
                app:layout_constraintEnd_toStartOf="@+id/dora_device_img_box"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/dora_device_img_box"
                android:layout_width="?attr/larus_dp_120"
                android:layout_height="?attr/larus_dp_216"
                app:layout_constraintEnd_toStartOf="@+id/dora_device_img_right"
                app:layout_constraintStart_toEndOf="@+id/dora_device_img_left"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/dora_device_img_right"
                android:layout_width="?attr/larus_dp_120"
                android:layout_height="?attr/larus_dp_216"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/dora_device_img_box"
                app:layout_constraintTop_toTopOf="parent"/>
            <include
                android:id="@+id/dora_device_battery_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_4"
                app:layout_constraintEnd_toEndOf="@+id/dora_device_img_left"
                app:layout_constraintStart_toStartOf="@+id/dora_device_img_left"
                app:layout_constraintTop_toBottomOf="@+id/dora_device_img_left"
                layout="@layout/larus_dora_device_battery_layout"/>
            <include
                android:id="@+id/dora_device_battery_box"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_4"
                app:layout_constraintEnd_toEndOf="@+id/dora_device_img_box"
                app:layout_constraintStart_toStartOf="@+id/dora_device_img_box"
                app:layout_constraintTop_toBottomOf="@+id/dora_device_img_box"
                layout="@layout/larus_dora_device_battery_layout"/>
            <include
                android:id="@+id/dora_device_battery_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_4"
                app:layout_constraintEnd_toEndOf="@+id/dora_device_img_right"
                app:layout_constraintStart_toStartOf="@+id/dora_device_img_right"
                app:layout_constraintTop_toBottomOf="@+id/dora_device_img_right"
                layout="@layout/larus_dora_device_battery_layout"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <include
            android:id="@+id/dora_soda_vip_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dora_device_header_group"
            layout="@layout/larus_dora_soda_vip_banner"/>
        <com.larus.bmhome.view.item.ItemGroup
            android:id="@+id/dora_device_name_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dora_soda_vip_banner"
            app:layout_goneMarginTop="?attr/larus_dp_20">
            <com.larus.bmhome.view.item.ItemTextArrow
                android:id="@+id/dora_device_name"
                android:background="@drawable/larus_bg_item_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_device_name_cn"/>
        </com.larus.bmhome.view.item.ItemGroup>
        <com.larus.bmhome.view.item.ItemGroup
            android:id="@+id/dora_wlan_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dora_device_name_group"
            app:layout_goneMarginTop="?attr/larus_dp_20">
            <com.larus.bmhome.view.item.ItemTextArrow
                android:id="@+id/dora_wlan_state"
                android:background="@drawable/larus_bg_item_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="联网状态"
                app:larus_sub_text="@string/larus_dora_device_disconnected_state_cn"/>
        </com.larus.bmhome.view.item.ItemGroup>
        <com.larus.bmhome.view.item.ItemGroup
            android:id="@+id/dora_device_settings_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dora_wlan_group">
            <com.larus.bmhome.view.item.ItemTextArrow
                android:id="@+id/dora_device_sound_settings"
                android:background="@drawable/larus_bg_item_selector_first"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_device_sound_settings_cn"/>
            <com.larus.bmhome.view.item.ItemTextArrow
                android:id="@+id/dora_device_gesture_settings"
                android:background="@drawable/larus_bg_item_selector_middle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_device_gesture_settings_cn"/>
            <com.larus.bmhome.view.item.ItemTextArrow
                android:id="@+id/dora_device_general_settings"
                android:background="@drawable/larus_bg_item_selector_last"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_device_general_settings_cn"/>
        </com.larus.bmhome.view.item.ItemGroup>
        <com.larus.bmhome.view.item.ItemGroup
            android:id="@+id/dora_proactive_group"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dora_device_settings_group">
            <com.larus.bmhome.view.item.ItemTextArrow
                android:id="@+id/dora_proactive_settings"
                android:background="@drawable/larus_bg_item_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/larus_doubao_active_notification_entrance_cn"/>
        </com.larus.bmhome.view.item.ItemGroup>
        <com.larus.bmhome.view.item.ItemGroup
            android:id="@+id/dora_simultaneously_interpret_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dora_proactive_group"
            app:layout_goneMarginTop="?attr/larus_dp_16">
            <com.larus.bmhome.view.item.ItemTextArrow
                android:id="@+id/dora_simultaneously_interpret"
                android:background="@drawable/larus_bg_item_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_lite_simultaneous_interpretation_cn"/>
        </com.larus.bmhome.view.item.ItemGroup>
        <com.larus.bmhome.view.item.ItemGroup
            android:id="@+id/dora_device_ai_lab_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dora_simultaneously_interpret_group">
            <com.larus.bmhome.view.item.ItemTextArrow
                android:id="@+id/dora_device_ai_lab"
                android:background="@drawable/larus_bg_item_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="豆包语音能力"/>
        </com.larus.bmhome.view.item.ItemGroup>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_13"
            android:textColor="@color/larus_neutral_50"
            android:id="@+id/dora_device_ai_lab_tips"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_8"
            android:text="@string/larus_dora_device_ai_lab_tips_cn"
            android:textAlignment="viewStart"
            android:layout_marginStart="?attr/larus_dp_16"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dora_device_ai_lab_group"/>
        <com.larus.bmhome.view.item.ItemGroup
            android:id="@+id/dora_device_vision_lab_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dora_device_ai_lab_tips">
            <com.larus.bmhome.view.item.ItemTextArrow
                android:id="@+id/dora_device_camera_settings"
                android:background="@drawable/larus_bg_item_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="豆包视觉能力"/>
        </com.larus.bmhome.view.item.ItemGroup>
        <com.larus.bmhome.view.item.ItemGroup
            android:id="@+id/dora_keep_alive_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dora_device_vision_lab_group">
            <com.larus.bmhome.view.item.ItemTextArrow
                android:id="@+id/dora_keep_alive"
                android:background="@drawable/larus_bg_item_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_keep_alive_settings_cn"/>
        </com.larus.bmhome.view.item.ItemGroup>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_13"
            android:textColor="@color/larus_neutral_50"
            android:id="@+id/dora_keep_alive_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_8"
            android:text="@string/larus_dora_keep_alive_settings_hint_cn"
            android:textAlignment="viewStart"
            android:layout_marginStart="?attr/larus_dp_16"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dora_keep_alive_group"/>
        <com.larus.bmhome.view.item.ItemGroup
            android:id="@+id/dora_device_bot_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dora_keep_alive_hint">
            <com.larus.bmhome.view.item.ItemTextArrow
                android:id="@+id/dora_device_bot_switch"
                android:background="@drawable/larus_bg_item_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_device_bot_switch_cn"/>
        </com.larus.bmhome.view.item.ItemGroup>
        <Spinner
            android:id="@+id/vui_main_bot"
            android:background="@android:color/transparent"
            android:visibility="invisible"
            android:layout_width="?attr/larus_dp_200"
            android:layout_height="0dp"
            android:layout_marginTop="431dp"
            android:popupBackground="@drawable/larus_bg_action_bar_instruction_spinner_item"
            android:layout_weight="1"
            android:spinnerMode="dropdown"
            android:layout_marginStart="?attr/larus_dp_155"
            android:overlapAnchor="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
