<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/hsiv_promotion_img"
        android:background="@color/shopping_std_bg_black_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.ec.core.widget.ECNetImageView
        android:id="@+id/hsiv_promotion_border_img"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="商品活动氛围图边框"/>
    <View
        android:id="@+id/view_img_fg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ec_color_white"
        android:gravity="center"
        android:id="@+id/tv_status"
        android:background="@drawable/ec_shape_promotion_status"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/ec_no_stock"
        android:includeFontPadding="false"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/ll_explaining"
        android:layout_width="match_parent"
        android:layout_height="20dp">
        <com.bytedance.android.ec.core.widget.ECExplainingView
            android:id="@+id/ec_explaining_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/explaining_douyin_wrapper"
        android:background="@drawable/ec_explain_bg"
        android:layout_width="match_parent"
        android:layout_height="22dp">
        <com.bytedance.android.ec.core.widget.ECLottieAnimationView
            android:id="@+id/explaining_douyin"
            android:layout_width="12dp"
            android:layout_height="12dp"
            app:lottie_autoPlay="false"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ec_color_white"
            android:id="@+id/tv_explaining_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:text="@string/ec_explaining_text"
            android:includeFontPadding="false"/>
        <com.bytedance.android.ec.core.widget.ECNetImageView
            android:id="@+id/eiv_explaining_right_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:scaleType="fitXY"
            android:layout_marginStart="3dp"/>
    </LinearLayout>
</merge>
