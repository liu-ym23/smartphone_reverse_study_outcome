<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="69dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_label"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <ImageView
            android:id="@+id/iv_icon"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="4dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/cj_pay_color_gray_153"
            android:id="@+id/tv_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_toRightOf="@+id/iv_icon"/>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/cj_pay_color_gray_153"
        android:textColorHint="@color/cj_pay_color_gray_153"
        android:id="@+id/tv_input_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_below="@+id/layout_label"/>
    <ImageView
        android:id="@+id/iv_info_not_focus"
        android:paddingLeft="12dp"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="24dp"
        android:layout_marginLeft="12dp"
        android:src="@drawable/cj_pay_icon_info"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:layout_below="@+id/layout_label">
        <com.android.ttcjpaysdk.thirdparty.view.CJPayPasteAwareEditText
            android:textSize="16sp"
            android:textColor="@color/cj_pay_color_black_34"
            android:layout_gravity="center_vertical"
            android:id="@+id/et_input"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textCursorDrawable="@drawable/cj_pay_bg_universal_cursor"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_close"
            android:visibility="gone"
            android:layout_width="@dimen/cj_pay_height_24"
            android:layout_height="@dimen/cj_pay_height_24"
            android:src="@drawable/cj_pay_icon_delete_gray_background"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/cj_pay_color_gray_202"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_right_label"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:includeFontPadding="false"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_info"
            android:paddingLeft="12dp"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="24dp"
            android:layout_marginLeft="12dp"
            android:src="@drawable/cj_pay_icon_info"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/layout_auth"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="12dp">
            <View
                android:background="@color/cj_pay_color_gray_161823_opacity_10"
                android:layout_width="1dp"
                android:layout_height="16dp"/>
            <ImageView
                android:id="@+id/iv_auth_icon"
                android:layout_width="10dp"
                android:layout_height="12dp"
                android:layout_marginLeft="12dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:id="@+id/tv_auth_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/divider_input"
        android:background="@color/cj_pay_color_gray_232"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_alignParentBottom="true"/>
    <View
        android:id="@+id/mask_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
