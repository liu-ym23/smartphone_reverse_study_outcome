<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="200dp"
    android:layout_height="375dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="200dp"
        android:layout_height="375dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_auto"
            android:background="@drawable/ttlive_bg_black_radius100"
            android:paddingLeft="14dp"
            android:paddingTop="13dp"
            android:paddingRight="25dp"
            android:paddingBottom="13dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_auto_indicator"
                android:background="@drawable/ttlive_ic_yellow_point"
                android:layout_width="5dp"
                android:layout_height="5dp"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/ttlive_color_FECB00"
                android:id="@+id/tv_auto_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="@string/ttlive_picture_type_auto"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_stretch"
            android:background="@drawable/ttlive_bg_black_radius100"
            android:paddingLeft="14dp"
            android:paddingTop="13dp"
            android:paddingRight="25dp"
            android:paddingBottom="13dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_stretch_indicator"
                android:layout_width="5dp"
                android:layout_height="5dp"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/ttlive_color_90_opacity_FFFFFF"
                android:id="@+id/tv_stretch_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="@string/ttlive_picture_type_stretch"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_enlarge"
            android:background="@drawable/ttlive_bg_black_radius100"
            android:paddingLeft="14dp"
            android:paddingTop="13dp"
            android:paddingRight="25dp"
            android:paddingBottom="13dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_enlarge_indicator"
                android:layout_width="5dp"
                android:layout_height="5dp"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/ttlive_color_90_opacity_FFFFFF"
                android:id="@+id/tv_enlarge_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="@string/ttlive_picture_type_enlarge"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
