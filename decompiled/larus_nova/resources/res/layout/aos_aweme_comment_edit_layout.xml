<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/comment_input_layout_container"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="12dp"
    android:paddingEnd="4dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/comment_content_container"
        android:background="@drawable/aos_aweme_comment_bg_input_comment_light"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/comment_publish_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.awemeopen.apps.framework.comment.widget.view.CommentMentionEditText
            android:textSize="15sp"
            android:textColor="@color/aos_comment_text_color"
            android:textColorHint="@color/aos_comment_text_hint_color"
            android:gravity="start|center_vertical"
            android:id="@+id/comment_edit"
            android:background="@android:color/transparent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:hint="@string/aos_write_comment_hint"
            android:imeOptions="flagNoFullscreen"
            android:textCursorDrawable="@drawable/aos_aweme_comment_cursor_drawable"
            android:textDirection="ltr"
            android:textAlignment="viewStart"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_emoji"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginStart="2dp"/>
        <com.bytedance.awemeopen.apps.framework.comment.widget.view.FadeImageView
            android:id="@+id/iv_emoji"
            android:padding="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/aos_write_comment_emoji"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/comment_publish_container"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/comment_content_container"
        app:layout_constraintLeft_toRightOf="@+id/comment_content_container"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/comment_content_container">
        <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
            android:textSize="13sp"
            android:textColor="@color/aos_negative"
            android:ellipsize="end"
            android:id="@+id/words_count"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginStart="12dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="13dp"
            android:textStyle="bold"
            android:textColor="@color/aos_comment_publish_button_text_color_selector"
            android:gravity="center"
            android:id="@+id/comment_publish_text_button"
            android:background="@drawable/aweme_comment_selector_send_button"
            android:layout_width="60dp"
            android:layout_height="40dp"
            android:text="发送"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
