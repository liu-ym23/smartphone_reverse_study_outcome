<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.ee.bear.widget.AtFinderView
            android:id="@+id/atView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_10"
            app:layout_constraintBottom_toTopOf="@+id/keyboard_toolbar_divider"
            app:layout_constraintHeight_max="260dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1"/>
        <View
            android:id="@+id/keyboard_toolbar_divider"
            android:background="@color/line_divider_default"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_kit_len_divider"
            app:layout_constraintBottom_toTopOf="@+id/dragView"/>
        <com.bytedance.ee.bear.bitable.card.view.cell.CellEditDragView
            android:id="@+id/dragView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:panel_background_color="@color/bg_float"
            app:panel_enable_drag="false"
            app:panel_right_menu_type="text"
            app:panel_right_text="@string/Bitable_Common_ButtonDone"
            app:panel_right_text_color="@color/primary_content_default"
            app:panel_show_divider="false"
            app:panel_show_drag_handler="false"
            app:panel_show_left_icon="false">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/text_editor_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.bytedance.ee.bear.bitable.card.view.cell.text.BitableTextFieldEditor
                        android:textSize="16sp"
                        android:textColor="@color/text_title"
                        android:textColorHint="@color/text_placeholder"
                        android:id="@+id/text_editor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_kit_len_10"
                        android:layout_marginBottom="@dimen/space_kit_len_10"
                        android:maxHeight="184dp"
                        android:hint="@string/Bitable_Common_PleaseEnterMobileVer"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_kit_len_16"
                        android:layout_marginEnd="@dimen/space_kit_len_16"
                        style="@style/UDEditText.Normal"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/voice_input_icon"
                        android:padding="@dimen/space_kit_len_8"
                        android:visibility="gone"
                        android:layout_width="@dimen/space_kit_len_36"
                        android:layout_height="@dimen/space_kit_len_36"
                        android:layout_marginTop="@dimen/space_kit_len_16"
                        android:tint="@color/icon_n2"
                        android:layout_marginEnd="@dimen/space_kit_len_16"
                        app:srcCompat="@drawable/ud_icon_mic_outlined"/>
                </LinearLayout>
            </LinearLayout>
        </com.bytedance.ee.bear.bitable.card.view.cell.CellEditDragView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
