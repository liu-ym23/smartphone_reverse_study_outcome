<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:background="@color/larus_static_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.video.impl.widget.VideoView
        android:id="@+id/video_view"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0"
        android:layout_centerInParent="true"
        custom:layout_constraintBottom_toTopOf="@+id/bottom_bg"
        custom:layout_constraintEnd_toEndOf="parent"
        custom:layout_constraintStart_toStartOf="parent"
        custom:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/video_info"
        android:background="@drawable/larus_video_bottom_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        custom:layout_constraintBottom_toBottomOf="parent"
        custom:layout_constraintBottom_toTopOf="@+id/bottom_bg"
        custom:layout_constraintStart_toStartOf="parent">
        <LinearLayout
            android:gravity="bottom"
            android:id="@+id/sync_from_layout"
            android:background="@drawable/larus_bg_video_from"
            android:paddingTop="?attr/larus_dp_3"
            android:paddingBottom="?attr/larus_dp_3"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_6"
            android:paddingStart="?attr/larus_dp_4"
            android:paddingEnd="?attr/larus_dp_3"
            android:layout_marginStart="?attr/larus_dp_12">
            <TextView
                android:textSize="?attr/larus_dp_12"
                android:textColor="@color/larus_static_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:id="@+id/sync_from_icon"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_15"
                android:layout_height="?attr/larus_dp_15"
                android:layout_marginBottom="?attr/larus_dp_1"
                android:src="@drawable/larus_icon_tiktok_img"
                android:layout_marginStart="?attr/larus_dp_2"/>
        </LinearLayout>
        <TextView
            android:textSize="?attr/larus_dp_16"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:ellipsize="end"
            android:id="@+id/video_account"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_6"
            android:maxLines="1"
            android:maxEms="50"
            android:shadowColor="@color/larus_static_black_transparent_1"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:layout_marginStart="?attr/larus_dp_12"
            android:layout_marginEnd="?attr/larus_dp_12"/>
        <TextView
            android:textSize="?attr/larus_dp_16"
            android:textColor="@color/larus_static_white"
            android:ellipsize="end"
            android:id="@+id/video_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_12"
            android:maxLines="3"
            android:shadowColor="@color/larus_static_black_transparent_1"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="2"
            android:layout_marginStart="?attr/larus_dp_12"
            android:layout_marginEnd="?attr/larus_dp_12"/>
        <SeekBar
            android:id="@+id/progress"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="?attr/larus_dp_1"
            android:max="100"
            android:indeterminateOnly="false"
            android:progressDrawable="@drawable/larus_tiktok_video_progress"
            android:thumb="@drawable/larus_tiktok_video_progress_thumb"
            android:paddingStart="?attr/larus_dp_0"
            android:paddingEnd="?attr/larus_dp_0"
            style="@style/larus_common_progress_bar_horizontal"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:id="@+id/bottom_bg"
        android:background="@color/larus_static_black_transparent_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        custom:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:id="@+id/bottom_view"
            android:paddingTop="?attr/larus_dp_10"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_48"
            custom:layout_constraintBottom_toBottomOf="parent">
            <ImageView
                android:id="@+id/status_image"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                android:src="@drawable/larus_up_to_see_more_image"/>
            <TextView
                android:textSize="?attr/larus_dp_14"
                android:textColor="@color/larus_static_white"
                android:gravity="center_vertical"
                android:id="@+id/load_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_slip_to_see_more_video"
                android:alpha="0.5"
                android:layout_marginStart="?attr/larus_dp_4"
                custom:layout_constraintBottom_toBottomOf="parent"/>
            <ProgressBar
                android:id="@+id/load_more_indicator"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_32"
                android:layout_height="?attr/larus_dp_32"
                android:indeterminateTint="@color/larus_neutral_50"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
