<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_detect_root"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.bdturing.livedetect.view.LiveDetectView
        android:id="@+id/turing_ldv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="155dp"
        android:layout_centerHorizontal="true"
        app:width_height_ratio="0.75"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_debug_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14dp"
            android:textColor="#00ff00"
            android:id="@+id/tv_test_img_detect_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#0000ff"
            android:id="@+id/tv_test_time_use"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#ff0000"
            android:id="@+id/tv_test_img_detect_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView
        android:textSize="23dp"
        android:textColor="#0c0d0e"
        android:gravity="center_horizontal"
        android:id="@+id/tv_detect_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="130dp"/>
    <ImageView
        android:id="@+id/loading"
        android:visibility="invisible"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/loading_ic"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
