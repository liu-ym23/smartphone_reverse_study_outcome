<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/game_detail_compatible_bg"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="28dp"/>
    <com.bytedance.android.gamecp.common.ui.RoundRectLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:leftTopRound="12dp"
        app:rightTopRound="12dp">
        <View
            android:id="@+id/v_game_detail_video_top_bg"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="28dp"/>
    </com.bytedance.android.gamecp.common.ui.RoundRectLayout>
    <View
        android:layout_gravity="center"
        android:id="@+id/v_game_detail_video_top_drag_icon"
        android:background="@drawable/gamecp_shape_game_detail_video_drag_icon"
        android:layout_width="32dp"
        android:layout_height="4dp"/>
</FrameLayout>
