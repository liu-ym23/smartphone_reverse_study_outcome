<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:layout_width="?attr/larus_dp_80"
    android:layout_height="?attr/larus_dp_80"
    android:layout_marginEnd="8dp">
    <FrameLayout
        android:background="@drawable/bg_round_base2overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/iv_image_preview"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <View
            android:id="@+id/upload_overlay"
            android:background="@color/static_black_transparent_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/video_gradient_overlay"
            android:background="@drawable/video_gradient_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.larus.common_ui.widget.CircleProgressBar
            android:layout_gravity="center"
            android:id="@+id/circle_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:larus_progressbarBackgroundColor="@color/static_white_transparent_3"
            app:larus_progressbarColor="@color/larus_static_white"
            app:larus_radius="?attr/larus_dp_12"
            app:larus_strokeWidth="?attr/larus_dp_2_5"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_retry_upload"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:src="@drawable/larus_retry_icon"/>
        <ImageView
            android:layout_gravity="end|top"
            android:id="@+id/iv_remove_image"
            android:background="@android:color/transparent"
            android:padding="4dp"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:src="@drawable/larus_ic_close_circle"/>
        <ImageView
            android:layout_gravity="start|bottom"
            android:id="@+id/iv_is_video"
            android:background="@android:color/transparent"
            android:visibility="visible"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="wrap_content"
            android:layout_margin="?attr/larus_dp_6"
            android:src="@drawable/ic_is_video"/>
    </FrameLayout>
</RelativeLayout>
