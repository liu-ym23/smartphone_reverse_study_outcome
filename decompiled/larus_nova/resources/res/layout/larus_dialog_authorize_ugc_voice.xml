<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/larus_bg_bottom_sheet"
    android:paddingBottom="?attr/larus_dp_28"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/cancel"
        android:layout_width="?attr/larus_dp_32"
        android:layout_height="?attr/larus_dp_32"
        android:layout_marginTop="?attr/larus_dp_12"
        android:contentDescription="@string/larus_accessibility_icon_close"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/larus_ic_close_dialog"/>
    <TextView
        android:textSize="?attr/larus_sp_24"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:id="@+id/text_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_83"
        android:text="@string/larus_voice_creation_authorization_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/layout_item_sound"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_80"
        app:layout_constraintTop_toBottomOf="@+id/text_title"
        layout="@layout/larus_item_authorize_ugc_voice"/>
    <include
        android:id="@+id/layout_item_home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_36"
        app:layout_constraintTop_toBottomOf="@+id/layout_item_sound"
        layout="@layout/larus_item_authorize_ugc_voice"/>
    <include
        android:id="@+id/layout_item_limit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_36"
        app:layout_constraintTop_toBottomOf="@+id/layout_item_home"
        layout="@layout/larus_item_authorize_ugc_voice"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="?attr/larus_sp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:gravity="center_horizontal"
        android:id="@+id/button_agree"
        android:background="?attr/larus_bg_audio_visualizer"
        android:paddingTop="?attr/larus_dp_17"
        android:paddingBottom="?attr/larus_dp_17"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_12"
        android:text="@string/larus_voice_creation_authorization_confirm"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
