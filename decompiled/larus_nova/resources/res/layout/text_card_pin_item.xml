<?xml version="1.0" encoding="utf-8"?>
<com.larksuite.component.ui.layout.LKUIRoundableLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:rl_border_color="@color/line_border_card">
    <com.ss.android.lark.message.card.view.MaxHeightInterruptEventScrollView
        android:id="@+id/scroll_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp">
        <LinearLayout
            android:layout_gravity="top"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/fl_lynx_parent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:id="@+id/header_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:id="@+id/layout_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.ss.android.lark.message.card.view.MaxHeightInterruptEventScrollView>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/mask_view"
        android:background="@drawable/card_preview_ellipsize_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="50dp"/>
</com.larksuite.component.ui.layout.LKUIRoundableLayout>
