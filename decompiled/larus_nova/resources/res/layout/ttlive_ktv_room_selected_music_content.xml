<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/music_cover"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:failureImage="@drawable/ttlive_bg_ktv_stub"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_bg_ktv_stub"
        app:placeholderImageScaleType="fitXY"
        app:roundedCornerRadius="4dp"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/music_duration"
        android:background="@drawable/ttlive_bg_music_duration"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/music_cover"
        app:layout_constraintLeft_toLeftOf="@+id/music_cover"
        app:layout_constraintRight_toRightOf="@+id/music_cover"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/music_info_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:divider="@color/transparent"
        android:showDividers="middle"
        android:dividerPadding="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/music_cover"
        app:layout_constraintLeft_toRightOf="@+id/music_cover"
        app:layout_constraintTop_toTopOf="@+id/music_cover">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/first_line_info_cl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#cdffffff"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/music_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="105dp"
                android:singleLine="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/second_line_info_cl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/user_avatar"
                android:layout_width="18dp"
                android:layout_height="18dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImage="@drawable/ttlive_img_avatar_empty"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#80ffffff"
                android:ellipsize="end"
                android:id="@+id/user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:maxWidth="91dp"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_marginStart="6dp"
                app:layout_constraintBottom_toBottomOf="@+id/user_avatar"
                app:layout_constraintStart_toEndOf="@+id/user_avatar"
                app:layout_constraintTop_toTopOf="@+id/user_avatar"/>
            <com.bytedance.android.livesdk.ktvimpl.ktvcomponent.dialog.selected.view.MultiUserAvatarView
                android:id="@+id/multi_user_avatar"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.android.livesdk.ktvimpl.ktvcomponent.dialog.common.topcontrolbar.view.KtvCommonStackAvatarView
                android:id="@+id/common_stack_user_avatar"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#80ffffff"
                android:ellipsize="end"
                android:id="@+id/multi_user_count"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:maxWidth="91dp"
                android:singleLine="true"
                android:layout_marginStart="6dp"
                app:layout_constraintBottom_toBottomOf="@+id/multi_user_avatar"
                app:layout_constraintStart_toEndOf="@+id/multi_user_avatar"
                app:layout_constraintTop_toTopOf="@+id/multi_user_avatar"/>
            <include
                android:id="@+id/want_listen_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/ttlive_ktv_want_listen_content"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/third_line_info_cl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/rt_chorus_info_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/ttlive_ktv_real_time_chorus_info_content"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
