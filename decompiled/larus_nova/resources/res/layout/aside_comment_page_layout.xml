<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_float"
    android:layout_width="296dp"
    android:layout_height="match_parent">
    <View
        android:id="@+id/comment_header_line_top"
        android:background="@color/line_border_card"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/comment_header"
        android:layout_width="match_parent"
        android:layout_height="41dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/comment_header_line_top">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_title"
            android:gravity="center"
            android:id="@+id/comment_count"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="17dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/close"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:paddingEnd="16dp"
            app:srcCompat="@drawable/ud_icon_close_outlined"
            app:tint="@color/icon_n1"/>
    </LinearLayout>
    <View
        android:id="@+id/comment_header_line"
        android:background="@color/line_border_card"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toBottomOf="@+id/comment_header"/>
    <com.ss.android.lark.widget.recyclerview.CommonRecyclerView
        android:id="@+id/doc_comment_page"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/comment_header_line"/>
    <View
        android:background="@color/line_border_card"
        android:layout_width="1dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
