<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_write_comment_guide"
    android:background="@drawable/shape_bg_ffffff_corner_16"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/gamecp_game_161823"
        android:gravity="center_horizontal"
        android:id="@+id/comment_guide_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/ttlive_game_promote_star_success_tip"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/comment_guide_divider"
        android:background="#1f161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/comment_guide_title"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/gamecp_game_161823"
        android:gravity="center"
        android:id="@+id/tv_next_time"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="@string/ttlive_game_promote_comment_next_time"
        app:layout_constraintEnd_toStartOf="@+id/tv_write_comment"
        app:layout_constraintHorizontal_weight="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/comment_guide_divider"/>
    <View
        android:id="@+id/v_button_divider"
        android:background="#1f161823"
        android:layout_width="0.5dp"
        android:layout_height="48dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/comment_guide_divider"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/gamecp_game_161823"
        android:gravity="center"
        android:id="@+id/tv_write_comment"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="@string/ttlive_game_promote_input_comment"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="0.5"
        app:layout_constraintStart_toEndOf="@+id/tv_next_time"
        app:layout_constraintTop_toBottomOf="@+id/comment_guide_divider"/>
</androidx.constraintlayout.widget.ConstraintLayout>
