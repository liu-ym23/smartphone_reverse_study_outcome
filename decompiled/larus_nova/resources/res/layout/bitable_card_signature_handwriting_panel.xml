<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:paddingTop="10dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="65dp"
            android:paddingEnd="65dp">
            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_title"
                android:id="@+id/cancelButton"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/space_kit_len_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Bitable_Common_ButtonCancel"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <TextView
                android:enabled="false"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/bitable_signature_save_text_color"
                android:id="@+id/saveButton"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/space_kit_len_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Bitable_Common_ButtonSave"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <FrameLayout
            android:background="@drawable/bitable_signature_canvas_bg"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="34dp"
            android:layout_weight="1"
            android:layout_marginStart="65dp"
            android:layout_marginEnd="65dp">
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_placeholder"
                android:layout_gravity="center"
                android:id="@+id/placeholderText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Bitable_DB_SignatureField_SignHere_Placeholder"/>
            <com.bytedance.ee.bear.bitable.celleditor.editor.signature.SignatureCanvasView
                android:id="@+id/canvasView"
                android:background="@android:color/transparent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:enabled="false"
                android:layout_gravity="end|bottom"
                android:id="@+id/clearButton"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="2dp"
                android:layout_width="@dimen/space_kit_len_28"
                android:layout_height="@dimen/space_kit_len_28"
                android:layout_margin="@dimen/space_kit_len_12"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ud_icon_reset_outlined"
                app:tint="@color/bitable_signature_clear_icon_tint"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
