<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/dialog_icon_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        app:srcCompat="@drawable/ud_icon_close_small_outlined"/>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/text_title"
        android:id="@+id/dialog_tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/LarkCCM_Docs_MeetingAgenda_EditTime_Button"
        android:layout_centerInParent="true"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/text_link_normal"
        android:gravity="center"
        android:id="@+id/dialog_tv_right_action"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/Doc_Facade_Confirm"
        android:layout_centerVertical="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
