<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/cj_pay_keep_dialog_v2_bg_voucher_tag_allline"
    android:layout_width="match_parent"
    android:layout_height="80dp">
    <RelativeLayout
        android:gravity="center_horizontal"
        android:id="@+id/voucher_tag_left"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="100">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/cj_pay_padding_8"
            android:paddingRight="@dimen/cj_pay_padding_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_toRightOf="@+id/voucher_tag_number_pre_des_layout"
            android:layout_centerVertical="true">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/voucher_tag_number_pre_des_layout"
                    android:background="@drawable/cj_pay_voucher_tag_pre_desc_bg"
                    android:paddingLeft="2dp"
                    android:paddingTop="2dp"
                    android:paddingRight="2dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/cj_pay_padding_2">
                    <TextView
                        android:textSize="9sp"
                        android:textColor="#fffe2c55"
                        android:gravity="center"
                        android:id="@+id/voucher_tag_number_pre_des"
                        android:layout_width="9sp"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="0sp"/>
                </LinearLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="18sp"
                        android:textColor="#fffe2c55"
                        android:gravity="center"
                        android:id="@+id/voucher_tag_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:lineSpacingExtra="4sp"
                        android:layout_marginEnd="@dimen/cj_pay_padding_2"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/voucher_tag_number_after_desc"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#fffe2c55"
                        android:id="@+id/voucher_tag_number_after_desc"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        app:layout_constraintBaseline_toBaselineOf="@+id/voucher_tag_number"
                        app:layout_constraintEnd_toEndOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
            <TextView
                android:textSize="11sp"
                android:textColor="#fffe2c55"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/voucher_left_msg_desc"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </LinearLayout>
    </RelativeLayout>
    <View
        android:id="@+id/voucher_tag_middle_line"
        android:background="@drawable/cj_pay_voucher_tag_middle_line_v2"
        android:layout_width="2dp"
        android:layout_height="56dp"
        android:layout_centerVertical="true"/>
    <RelativeLayout
        android:id="@+id/voucher_tag_right"
        android:paddingLeft="12dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="241"
        android:layout_toRightOf="@+id/voucher_tag_middle_line">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="14sp"
                android:textColor="#fffe2c55"
                android:ellipsize="end"
                android:id="@+id/voucher_tag_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_alignParentLeft="true"/>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/voucher_tag_text"
                android:layout_alignParentLeft="true">
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/cj_pay_color_gray_8a8b91"
                    android:ellipsize="end"
                    android:id="@+id/voucher_tag_desc"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:singleLine="true"/>
                <com.android.ttcjpaysdk.base.ui.widget.CJPayFollowNameView
                    android:id="@+id/voucher_follow_name_view"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/voucher_tag_right_tip"
            android:background="@drawable/cj_pay_voucher_tag_top_right_tip_bg"
            android:paddingLeft="4dp"
            android:paddingTop="1dp"
            android:paddingRight="4dp"
            android:paddingBottom="1dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true">
            <TextView
                android:textSize="9sp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:id="@+id/voucher_tag_top_right_tip_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
