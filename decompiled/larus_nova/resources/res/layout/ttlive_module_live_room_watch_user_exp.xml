<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.widget.ReverseHorizontalLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_gravity="right"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="44dp"
    app:layout_constraintRight_toRightOf="parent">
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/online_info_root_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="4dp"
        android:layout_centerVertical="true"
        android:layout_marginEnd="4dp"
        app:ttlive_allRadius="15dp">
        <RelativeLayout
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="30dp">
            <RelativeLayout
                android:id="@+id/online_info_area"
                android:background="@drawable/ttlive_bg_round_new_style_uv_indicator"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="30dp"
                android:layout_centerVertical="true">
                <com.bytedance.android.livesdk.chatroom.ui.StrokeTextView
                    android:textSize="11sp"
                    android:textColor="@color/ttlive_white"
                    android:gravity="center_horizontal"
                    android:id="@+id/online_info"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_centerInParent="true"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/dou_plus_root_view"
                android:background="@drawable/ttlive_bg_watch_info_indicator"
                android:visibility="gone"
                android:layout_width="52dp"
                android:layout_height="30dp"
                android:layout_toRightOf="@+id/online_info_area"
                android:layout_toEndOf="@+id/online_info_area">
                <com.bytedance.android.live.room.incentiveinfo.IncentiveInfoLayout
                    android:id="@+id/incentive_info_area"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <RelativeLayout
                    android:id="@+id/alpha_change_area"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <View
                        android:id="@+id/indicator_boundary"
                        android:background="@drawable/ttlive_bg_watch_user_info_indicator_boundary"
                        android:layout_width="1dp"
                        android:layout_height="26dp"
                        android:layout_centerVertical="true"/>
                    <View
                        android:id="@+id/indicator_dou"
                        android:background="@drawable/ttlive_bg_watch_user_info_new_indicator_dou"
                        android:layout_width="25dp"
                        android:layout_height="11dp"
                        android:layout_marginTop="3dp"
                        android:layout_centerHorizontal="true"/>
                    <com.bytedance.android.live.room.view.IndicatorTextSwitcher
                        android:id="@+id/indicator_new_order_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:layout_alignLeft="@+id/indicator_new_order_copy_writer"
                        android:alpha="0"
                        android:layout_alignStart="@+id/indicator_new_order_copy_writer"/>
                    <TextView
                        android:textSize="9dp"
                        android:textColor="@color/commonui_white"
                        android:id="@+id/indicator_new_order_copy_writer"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="13dp"
                        android:layout_below="@+id/indicator_new_order_user_name"
                        android:layout_centerInParent="true"
                        android:alpha="0"
                        android:letterSpacing="0.04"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/data_info_area"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:layout_below="@+id/indicator_dou"
                        android:layout_centerHorizontal="true">
                        <com.bytedance.android.live.room.view.IndicatorTextSwitcher
                            android:id="@+id/plus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <com.bytedance.android.live.room.view.IndicatorTextSwitcher
                            android:id="@+id/thousand"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <com.bytedance.android.live.room.view.IndicatorTextSwitcher
                            android:id="@+id/hundreds"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <com.bytedance.android.live.room.view.IndicatorTextSwitcher
                            android:id="@+id/decade"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:textSize="10dp"
                            android:textColor="@color/commonui_white"
                            android:id="@+id/point"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ttlive_dou_plus_indicator_point"/>
                        <com.bytedance.android.live.room.view.IndicatorTextSwitcher
                            android:id="@+id/bits"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <com.bytedance.android.live.room.view.IndicatorTextSwitcher
                            android:id="@+id/unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <com.bytedance.android.live.room.view.IndicatorTextSwitcher
                        android:gravity="center"
                        android:id="@+id/info_label"
                        android:visibility="visible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:layout_below="@+id/indicator_dou"
                        android:layout_centerHorizontal="true"/>
                </RelativeLayout>
            </RelativeLayout>
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/sweep_anim"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout>
    <com.bytedance.android.live.room.widget.NoTouchRecyclerView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/watch_user_list_view"
        android:visibility="gone"
        android:fadingEdgeLength="24dp"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginLeft="-2dp"
        android:requiresFadingEdge="horizontal"/>
</com.bytedance.android.livesdk.widget.ReverseHorizontalLinearLayout>
