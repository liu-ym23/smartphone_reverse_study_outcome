<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/danmu_input_container"
    android:layout_width="42dp"
    android:layout_height="24dp">
    <View
        android:id="@+id/danmu_input_layout"
        android:background="@drawable/ttlive_bg_danmu_input_layout_ts"
        android:layout_width="42dp"
        android:layout_height="24dp"/>
    <View
        android:id="@+id/danmu_input"
        android:background="@drawable/ttlive_bg_danmu_input_ts"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"/>
    <View
        android:id="@+id/danmu_input_loading_back"
        android:background="@drawable/ttlive_bg_danmu_input_loading"
        android:visibility="gone"
        android:layout_width="19dp"
        android:layout_height="19dp"
        android:layout_marginLeft="1dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="2dp"
        android:layout_centerInParent="true"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="2dp"
        android:layout_alignParentEnd="true"/>
    <View
        android:id="@+id/danmu_input_loading"
        android:background="@drawable/ttlive_ic_privilege_loading"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginLeft="1dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="5.5dp"
        android:layout_centerInParent="true"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="5.5dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
