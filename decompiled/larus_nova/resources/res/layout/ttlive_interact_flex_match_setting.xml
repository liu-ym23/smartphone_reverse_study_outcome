<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/ttlive_flex_activity_count_down_bg_color"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="17dp"
            android:textColor="@color/ttlive_multi_pk_invite_text_color"
            android:gravity="center"
            android:id="@+id/setting_confirm"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="0.5dp"
            android:text="@string/ttlive_flex_invite_match_setting_confirm"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/setting_cancel"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="8dp">
            <TextView
                android:textSize="17dp"
                android:textColor="@color/ttlive_multi_pk_invite_text_color"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginTop="16dp"
                android:text="@string/ttlive_flex_invite_match_setting_cancel"/>
            <View
                android:layout_gravity="center"
                android:background="@drawable/ttlive_interact_flex_match_setting"
                android:layout_width="134dp"
                android:layout_height="5dp"
                android:layout_marginTop="36dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
