<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/project_header"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_40"
        android:paddingStart="?attr/larus_dp_12"
        android:paddingEnd="?attr/larus_dp_12">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_project_icon"
            android:layout_width="?attr/larus_dp_28"
            android:layout_height="?attr/larus_dp_28"
            android:src="@drawable/larus_icon_project_folder"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/project_title_container"
            android:duplicateParentState="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="?attr/larus_dp_8"
            android:layout_marginEnd="?attr/larus_dp_8"
            app:layout_constraintEnd_toStartOf="@+id/tv_project_red_badge"
            app:layout_constraintStart_toEndOf="@+id/iv_project_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginEnd="0dp">
            <TextView
                android:textSize="?attr/larus_dp_17"
                android:textColor="@color/larus_neutral_100"
                android:id="@+id/tv_project_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/iv_project_expand_arrow"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/iv_project_expand_arrow"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_12"
                android:layout_height="?attr/larus_dp_12"
                android:src="@drawable/larus_ic_text_right_arrow"
                android:contentDescription="@null"
                android:layout_marginStart="?attr/larus_dp_2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_project_title"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/project_title_end_gradient"
                android:background="?attr/larus_right_gradient_mask_state_list"
                android:visibility="invisible"
                android:duplicateParentState="true"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/tv_project_title"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.larus.common_ui.widget.RedDotTextView
            android:textSize="?attr/larus_dp_11"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/tv_project_red_badge"
            android:background="@drawable/larus_red_dot_bg"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_18"
            android:layout_height="?attr/larus_dp_18"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/project_conversations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:nestedScrollingEnabled="false"/>
</LinearLayout>
