        android:layout_gravity="center"
        android:id="@+id/live_end_guide_circle"
        android:layout_width="30dp"
        android:layout_height="30dp"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/skylight_avatar"
        android:layout_width="28dp"
        android:layout_height="28dp"/>
</FrameLayout>
