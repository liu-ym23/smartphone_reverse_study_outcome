<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/pwd_related_guide_root_view"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cj_pay_height_470">
    <include
        android:id="@+id/cj_pay_titlebar_root_view"
        layout="@layout/cj_pay_view_titlebar_icon_layout"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/pwd_related_guide_icon"
        android:layout_width="@dimen/cj_pay_height_88"
        android:layout_height="@dimen/cj_pay_height_88"
        android:layout_marginTop="@dimen/cj_pay_height_60"
        android:src="@drawable/cj_pay_icon_pay_no_pwd_guide"/>
    <TextView
        android:textSize="22dp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_90"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/pwd_related_guide_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_16"
        android:layout_marginTop="@dimen/cj_pay_padding_16"
        android:layout_marginRight="@dimen/cj_pay_padding_16"
        android:includeFontPadding="false"/>
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/sub_guide_rl"
        android:paddingTop="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/pwd_related_guide_picture">
        <ImageView
            android:id="@+id/iv_sub_guide_icon"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="6dp"
            android:scaleType="fitXY"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
            android:id="@+id/pwd_related_guide_sub_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_toRightOf="@+id/iv_sub_guide_icon"
            android:layout_alignBaseline="@+id/iv_sub_guide_icon"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/pwd_related_guide_picture"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="173dp"
            android:layout_marginTop="24dp"
            android:scaleType="fitXY"/>
        <LinearLayout
            android:paddingTop="65dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="30dp"
                android:textColor="@color/cj_pay_color_red_11"
                android:id="@+id/tv_discount_amount"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/cj_pay_color_red_11"
                android:id="@+id/tv_cny"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:text="@string/cj_pay_cny"
                android:includeFontPadding="false"
                android:layout_toRightOf="@+id/tv_discount_amount"
                android:layout_alignBaseline="@+id/tv_discount_amount"/>
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/cj_pay_guide_security_tip_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cj_pay_padding_6"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
            android:id="@+id/cj_pay_guide_agreement"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginBottom="16dp"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="@+id/bubble_label_layout"
            app:layout_constraintBottom_toTopOf="@+id/cj_pay_open_btn_layout"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <LinearLayout
            android:layout_gravity="right"
            android:orientation="horizontal"
            android:id="@+id/bubble_label_layout"
            android:background="@drawable/cj_pay_bg_pay_again_voucher_label"
            android:paddingLeft="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="33dp"
            android:layout_marginRight="16dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            app:layout_constraintBottom_toTopOf="@+id/cj_pay_open_btn_layout"
            app:layout_constraintEnd_toEndOf="parent">
            <TextView
                android:textSize="12dp"
                android:textColor="@color/cj_pay_color_red_fe2c55"
                android:id="@+id/bubble_label"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:singleLine="true"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/cj_pay_open_btn_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <include
            android:gravity="center"
            android:id="@+id/cj_pay_guide_btn_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_height_44"
            android:layout_marginLeft="@dimen/cj_pay_padding_24"
            android:layout_marginRight="@dimen/cj_pay_padding_24"
            android:layout_marginBottom="@dimen/cj_pay_padding_16"
            layout="@layout/cj_pay_common_loading_btn"/>
        <com.android.ttcjpaysdk.base.ui.widget.CJFlashLightingView
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_pay_flashlight"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            app:cjpay_animationDuration="1"
            app:cjpay_roundedCornerRadius="4dp"/>
    </FrameLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
        android:gravity="left"
        android:layout_gravity="left"
        android:id="@+id/cj_pay_guide_agreement_below"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:includeFontPadding="false"/>
    <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
        android:id="@+id/cj_pay_guide_insurance_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/cj_pay_padding_16"
        app:theme_type="0"/>
</LinearLayout>
