<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.ugc.aweme.dito.poi.player.ui.HorizontalOverScrollLayout
        android:id="@+id/content_swiper_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/content_view_more_container"
            android:background="@color/black"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentTop="true">
            <com.bytedance.lighten.loader.SmartImageView
                android:id="@+id/content_view_more"
                android:layout_width="12dp"
                android:layout_height="105dp"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <androidx.viewpager2.widget.ViewPager2
            android:orientation="horizontal"
            android:id="@+id/content_view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.ss.android.ugc.aweme.dito.poi.player.ui.HorizontalOverScrollLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_tags_container"
        android:visibility="visible"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.locallife.poi.newdetail.widget.trip.TripPoiHeadTagsWidget
            android:id="@+id/poi_content_player_tags"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="75dp"
            fresco:layout_constraintStart_toStartOf="parent"
            fresco:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.locallife.poi.newdetail.widget.PoiHeartbeatBadgeView
            android:id="@+id/head_image_heart"
            android:visibility="gone"
            android:layout_width="110dp"
            android:layout_height="122dp"
            android:translationY="0.5dp"
            fresco:layout_constraintRight_toRightOf="parent"
            fresco:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
