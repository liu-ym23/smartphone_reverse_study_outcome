<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/close"
            android:padding="?attr/larus_dp_10"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            android:layout_marginTop="?attr/larus_dp_8"
            android:layout_marginBottom="?attr/larus_dp_8"
            android:src="?attr/larus_ic_close_fill"
            android:layout_marginStart="?attr/larus_dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="?attr/larus_dp_17"
            android:textStyle="bold"
            android:textColor="?attr/larus_neutral_100"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_db_feed_titleBar_name_cn"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/layout_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_container"/>
    <FrameLayout
        android:id="@+id/outer_chat_input"
        android:background="?attr/larus_bg_widget_outer_chat_input"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.larus.common_ui.venus.ShapeLinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/back"
        android:paddingTop="?attr/larus_dp_14"
        android:paddingBottom="?attr/larus_dp_14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_14"
        app:larus_sc_cornerRadius="?attr/larus_dp_20"
        app:larus_sc_fillColor="?attr/larus_base_3"
        app:larus_sc_pressedColor="?attr/larus_press"
        app:larus_sc_shadow_blur_radius="?attr/larus_dp_4"
        app:larus_sc_shadow_color="#1f000000"
        app:layout_constraintBottom_toTopOf="@+id/outer_chat_input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textStyle="bold"
            android:textColor="?attr/larus_neutral_100"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_db_feed_backToChat_cn"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="?attr/larus_dp_13"
            android:layout_height="?attr/larus_dp_13"
            android:layout_marginTop="?attr/larus_dp_1"
            android:src="?attr/larus_icon_arrow_up_fill"
            android:layout_marginStart="?attr/larus_dp_4"/>
    </com.larus.common_ui.venus.ShapeLinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
