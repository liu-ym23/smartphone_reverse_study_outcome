<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_body"
    android:paddingLeft="16dp"
    android:paddingTop="13dp"
    android:paddingBottom="13dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larksuite.component.ui.avatar.v2.LarkAvatarView
        android:layout_gravity="center_vertical"
        android:id="@+id/collaborator_avatar"
        android:layout_width="40sp"
        android:layout_height="40sp"
        android:tint="@color/fill_img_mask"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="52sp"
        android:layout_marginRight="@dimen/dp_120">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_title"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/collaborator_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_placeholder"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/collaborator_department"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/collaborator_more"
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_40">
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/text_title"
            android:ellipsize="end"
            android:id="@+id/collaborator_role_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Todo_ShareList_ManageCollaboratorsCanView_Text"
            android:maxLines="2"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_32"
            android:layout_alignParentEnd="true"/>
        <ImageView
            android:id="@+id/collaborator_role_icon"
            android:layout_width="8sp"
            android:layout_height="8sp"
            android:tint="@color/icon_n3"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_20"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/ud_icon_expand_down_filled"/>
    </RelativeLayout>
</FrameLayout>
