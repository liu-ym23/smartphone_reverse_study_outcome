<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ttlive_broadcast_toolbar_video_interact"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="38dp"
    android:layout_height="38dp"
    android:layout_marginLeft="8dp"
    android:layout_marginStart="8dp">
    <ImageView
        android:layout_gravity="bottom"
        android:id="@+id/webp_bg_iv"
        android:layout_width="38dp"
        android:layout_height="38dp"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="bottom"
        android:id="@+id/webp_iv"
        android:layout_width="38dp"
        android:layout_height="38dp"/>
    <com.airbnb.lottie.LottieAnimationView
        android:layout_gravity="bottom"
        android:id="@+id/iv"
        android:layout_width="38dp"
        android:layout_height="38dp"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/red_dot"
        android:background="@drawable/ttlive_ic_red_point_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="2dp"
        android:layout_alignTop="@+id/icon"
        android:layout_alignEnd="@+id/icon"/>
    <FrameLayout
        android:layout_width="28dp"
        android:layout_height="14dp"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="-6dp"
        android:layout_marginStart="22dp">
        <TextView
            android:textSize="9dp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/number_dot"
            android:background="@drawable/ttlive_number_dot_bg"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="14dp"/>
    </FrameLayout>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/webp_first_discount_anim"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="49dp"
        android:layout_marginTop="-11dp"/>
</FrameLayout>
