<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_ban_tips_notice_dialog"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_room_notice_dialog_main_textcolor"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/room_center_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:includeFontPadding="false"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_room_notice_dialog_minor_textcolor"
        android:layout_gravity="center_horizontal"
        android:id="@+id/room_center_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:textAlignment="center"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/tips_enter_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/ttlive_room_notice_dialog_details_color"
            android:layout_gravity="center"
            android:id="@+id/tips_enter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_ban_tips_enter"/>
        <ImageView
            android:id="@+id/tips_enter_icon"
            android:layout_width="7dp"
            android:layout_height="11dp"
            android:layout_marginLeft="3dp"
            android:src="@drawable/ttlive_banned_tips_enter_icon_blue"
            android:layout_marginStart="3dp"/>
    </LinearLayout>
    <View
        android:id="@+id/live_dialog_divider_1"
        android:layout_marginTop="24dp"
        style="@style/ttlive_live_dialog_divider_horizontal"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="47dp">
        <Button
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_room_notice_dialog_minor_textcolor"
            android:id="@+id/room_left_button"
            android:background="@drawable/ttlive_bg_room_review_dialog_btn_left"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <TextView
            android:id="@+id/room_center_padding"
            android:background="@color/ttlive_core_live_dialog_divider"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"/>
        <Button
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_room_notice_dialog_main_textcolor"
            android:id="@+id/room_right_button"
            android:background="@drawable/ttlive_bg_room_review_dialog_btn_right"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
