<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/office_grid_card"
    android:background="@drawable/office_list_grid_item_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/office_list_grid_item_height">
    <View
        android:id="@+id/office_grid_shadow"
        android:background="@drawable/list_grid_item_shadow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        android:backgroundTint="@color/bg_body"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/office_grid_thumbnail"
        android:background="@drawable/list_grid_item_shadow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        android:scaleType="centerCrop"
        android:backgroundTint="@color/bg_body"
        app:srcCompat="@drawable/list_grid_placeholder"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/office_grid_folder_thumbnail"
        android:visibility="gone"
        android:layout_width="41dp"
        android:layout_height="32dp"
        android:layout_marginTop="26dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ud_icon_file_sharefolder_colorful"/>
    <View
        android:id="@+id/office_grid_bottom_divider"
        android:background="@color/line_border_card"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintBottom_toTopOf="@+id/office_grid_bottom"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/office_grid_bottom"
        android:background="@drawable/list_pin_item_container_bg"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="1dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <FrameLayout
            android:id="@+id/office_grid_type_icon_container"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/office_grid_type_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:srcCompat="@drawable/ud_icon_file_doc_colorful"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/office_grid_shortcut"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ud_icon_wiki_shortcutarrow_colorful"/>
        </FrameLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_title"
            android:ellipsize="end"
            android:id="@+id/office_grid_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toTopOf="@+id/office_grid_tag"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/office_grid_type_icon_container"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.ee.bear.widgets.tagview.SpaceTagTitleView
            android:id="@+id/office_grid_tag"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/office_grid_type_icon_container"
            app:layout_constraintTop_toBottomOf="@+id/office_grid_title"
            app:titleTagMargin="0dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/office_grid_more"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/list_grid_more_dot"
            app:tint="@color/icon_n3"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/office_grid_selected_overlay"
        android:background="@drawable/office_list_grid_selected_overlay"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/office_grid_checkbox_container"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/office_grid_checkbox"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/office_list_grid_checkbox_selector"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
