<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.awemeopen.apps.framework.base.view.VideoViewHolderRootView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.awemeopen.apps.framework.player.FullVideoView
        android:id="@+id/item_feeditem_videoview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/item_gesture_fl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include layout="@layout/aos_familiar_slides_photos_view"/>
    <com.bytedance.awemeopen.apps.framework.base.view.DiggLayout
        android:id="@+id/item_digg_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/feed_page"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/pinch_root_container"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/pinch_progress_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="60dp"/>
    </FrameLayout>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/pause_btn"
        android:background="@null"
        android:visibility="gone"
        android:layout_width="50dp"
        android:layout_height="60dp"
        android:src="@drawable/aos_legacy_ic_play_pause"
        android:layout_centerInParent="true"/>
</com.bytedance.awemeopen.apps.framework.base.view.VideoViewHolderRootView>
