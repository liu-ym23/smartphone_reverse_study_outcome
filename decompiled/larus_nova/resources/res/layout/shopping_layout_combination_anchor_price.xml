<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.bytedance.android.ec.core.widget.price.PriceView
        android:textSize="12sp"
        android:gravity="center"
        android:id="@+id/pv_combination_price"
        android:layout_width="wrap_content"
        android:layout_height="13dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:pv_autoResize="true"
        app:pv_prefixMarginRight="1dp"
        app:pv_prefixText="@string/shopping_combination_price"
        app:pv_prefixTextBold="true"
        app:pv_prefixTextColor="@color/shopping_color_161823"
        app:pv_priceBold="true"
        app:pv_priceDecimalTextSizeRatio="0.833"
        app:pv_priceTextColor="@color/shopping_color_161823"
        app:pv_showStrikeThrough="false"
        app:pv_yuanSymbolBold="true"
        app:pv_yuanSymbolRatioOfPriceTextSize="1"/>
    <com.bytedance.android.ec.core.widget.price.PriceView
        android:textSize="10sp"
        android:gravity="center"
        android:id="@+id/pv_origin_price"
        android:layout_width="wrap_content"
        android:layout_height="11dp"
        android:layout_marginTop="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pv_combination_price"
        app:pv_autoResize="true"
        app:pv_prefixMarginRight="1dp"
        app:pv_prefixText="@string/shopping_original_price"
        app:pv_prefixTextColor="@color/shopping_color_57182357"
        app:pv_priceTextColor="@color/shopping_color_57182357"
        app:pv_showStrikeThrough="true"
        app:pv_yuanSymbolRatioOfPriceTextSize="1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
