<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/action_area"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="68dp">
    <RelativeLayout
        android:id="@+id/icon_game"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_centerVertical="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/icon_game_img"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ttlive_open_feature_icon_default"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundedCornerRadius="8dp"/>
        <TextView
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:id="@+id/doing_area"
            android:background="@drawable/ttlive_open_feature_doing_shape"
            android:visibility="gone"
            android:layout_width="35dp"
            android:layout_height="14dp"
            android:text="@string/ttlive_open_platform_feature_icon_ongoing_tip"
            android:layout_alignTop="@+id/icon_game_img"
            android:layout_alignRight="@+id/icon_game_img"
            android:textAlignment="center"
            android:layout_alignEnd="@+id/icon_game_img"/>
        <TextView
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:id="@+id/bind_self_mount_area"
            android:background="@drawable/ttlive_open_feature_doing_shape"
            android:visibility="gone"
            android:layout_width="35dp"
            android:layout_height="14dp"
            android:text="@string/ttlive_open_platform_bind_self_mount"
            android:layout_alignTop="@+id/icon_game_img"
            android:layout_alignRight="@+id/icon_game_img"
            android:textAlignment="center"
            android:layout_alignEnd="@+id/icon_game_img"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#161823"
            android:id="@+id/count_tv"
            android:background="@drawable/ttlive_bg_yellow_count_dot"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:layout_marginRight="-8dp"
            android:maxWidth="33dp"
            android:text="@string/ttlive_open_platform_feature_icon_corner_tip"
            android:layout_alignTop="@+id/icon_game_img"
            android:layout_alignRight="@+id/icon_game_img"
            android:layout_marginEnd="-8dp"
            android:layout_alignEnd="@+id/icon_game_img"/>
        <ImageView
            android:id="@+id/red_dot"
            android:background="@drawable/ttlive_ic_red_dot"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="-6dp"
            android:layout_alignTop="@+id/icon_game_img"
            android:layout_alignRight="@+id/icon_game_img"
            android:layout_marginEnd="-6dp"
            android:layout_alignEnd="@+id/icon_game_img"/>
    </RelativeLayout>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/txt_game_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="56dp"
        android:singleLine="true"
        android:layout_marginStart="56dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/txt_game_summary"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/txt_game_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="56dp"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:alpha="0.5"
        android:layout_marginStart="56dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_game_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
