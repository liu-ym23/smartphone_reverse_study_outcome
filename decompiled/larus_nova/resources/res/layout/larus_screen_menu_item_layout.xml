<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/text_icon"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:layout_marginEnd="?attr/larus_dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/menu_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_16"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="end"
            android:id="@+id/menu_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/holder"
            app:layout_constraintStart_toEndOf="@+id/text_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_default="wrap"
            app:layout_constraintWidth_max="?attr/larus_dp_150"/>
        <View
            android:id="@+id/holder"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/menu_icon_container"
            app:layout_constraintStart_toEndOf="@+id/menu_text"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_min="?attr/larus_dp_0"/>
        <FrameLayout
            android:id="@+id/menu_icon_container"
            android:layout_width="?attr/larus_dp_22"
            android:layout_height="?attr/larus_dp_22"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/holder"
            app:layout_constraintTop_toTopOf="parent">
            <com.lynx.lottieadapter.LottieAdapterView
                android:id="@+id/menu_lottie_icon"
                android:layout_width="?attr/larus_dp_22"
                android:layout_height="?attr/larus_dp_22"
                android:scaleType="center"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/menu_icon"
                android:layout_width="?attr/larus_dp_22"
                android:layout_height="?attr/larus_dp_22"
                android:scaleType="centerInside"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/menu_url_icon"
                android:layout_width="?attr/larus_dp_22"
                android:layout_height="?attr/larus_dp_22"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
