<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.ss.android.lark.picker.base.view.avataritem.AvatarItemView
        android:id="@+id/avatar_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@+id/chat_preview_icon"/>
    <View
        android:id="@+id/avatar_item_mask"
        android:background="@color/avatar_item_mask"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_alignTop="@+id/avatar_item"
        android:layout_alignBottom="@+id/avatar_item"
        android:layout_alignStart="@+id/avatar_item"
        android:layout_alignEnd="@+id/avatar_item"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/chat_preview_icon"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="20dp"
        android:layout_centerVertical="true"
        android:paddingEnd="16dp"
        android:layout_alignParentEnd="true"
        app:srcCompat="@drawable/ud_icon_info_outlined"
        app:tint="@color/icon_n3"/>
</merge>
