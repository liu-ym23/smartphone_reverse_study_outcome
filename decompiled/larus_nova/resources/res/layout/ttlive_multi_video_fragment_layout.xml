<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/multi_video_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/play_control_visibility_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/video_bottom_area_group"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="90dp">
        <FrameLayout
            android:id="@+id/video_bottom_shadow"
            android:background="@drawable/ttlive_video_bottom_shadow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="bottom"
            android:id="@+id/video_bottom_progress_group"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginBottom="12dp">
            <FrameLayout
                android:id="@+id/video_play_control_container"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="6dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/progress_area_container"/>
            <FrameLayout
                android:id="@+id/progress_area_container"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/enter_full_container"
                app:layout_constraintStart_toEndOf="@+id/video_play_control_container"/>
            <FrameLayout
                android:id="@+id/enter_full_container"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/progress_area_container"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/top_area_container"
        android:layout_width="match_parent"
        android:layout_height="90dp">
        <FrameLayout
            android:id="@+id/video_top_shadow"
            android:background="@drawable/ttlive_video_top_shadow_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/top_bar_container"
            android:paddingLeft="16dp"
            android:paddingRight="50dp"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="44dp"
            android:paddingStart="16dp"
            android:paddingEnd="50dp">
            <ImageView
                android:id="@+id/exit_multi_video"
                android:background="@drawable/ttlive_full_view_exit_btn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="退出"/>
            <FrameLayout
                android:gravity="center"
                android:id="@+id/multi_video_title_container"
                android:layout_width="match_parent"
                android:layout_height="24dp"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
