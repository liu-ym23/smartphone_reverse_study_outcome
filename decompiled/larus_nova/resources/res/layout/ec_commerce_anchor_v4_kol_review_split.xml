<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ec_commerce_anchor_v4_kol_review_split_889604526"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/ec_commerce_anchor_v4_kol_review_split_1652743921"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.MediaBoxElementView
            android:id="@+id/anchor_v4_kol_review_media"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/anchor_v4_kol_review_bottom_mask"
            android:background="@drawable/ec_commerce_kol_review_shader"
            android:layout_width="match_parent"
            android:layout_height="32dp"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/anchor_v4_kol_type_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextWithOneIconElementView
            android:layout_gravity="bottom|left"
            android:id="@+id/anchor_v4_kol_follow_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginBottom="4dp"/>
        <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextWithOneIconElementView
            android:layout_gravity="top|right"
            android:id="@+id/anchor_v4_kol_like_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginRight="4dp"/>
    </FrameLayout>
    <com.bytedance.android.shopping.anchorv4.voavhs.base.elements.TextWithOneIconElementView
        android:id="@+id/anchor_v4_kol_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"/>
</LinearLayout>
