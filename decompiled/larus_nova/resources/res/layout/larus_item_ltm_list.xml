<?xml version="1.0" encoding="utf-8"?>
<com.larus.bmhome.chat.layout.holder.progressloading.RadiusCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Theme.MaterialComponents"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="?attr/larus_dp_16"
    android:layout_marginRight="?attr/larus_dp_16"
    android:elevation="0dp">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/delete_area"
            android:background="#ff3b30"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/dp_80"
            android:layout_height="match_parent"
            android:contentDescription="@string/larus_accessibility_delete">
            <ImageView
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:src="@drawable/larus_ic_delete_white"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/memory_foreground"
            android:background="@color/base_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/memory_foreground_transparent"
                android:background="@color/primary_transparent_1"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/neutral_100"
                android:ellipsize="end"
                android:id="@+id/text_view"
                android:paddingTop="?attr/larus_dp_16"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingStart="?attr/larus_dp_16"
                android:layout_marginEnd="12dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/divider"
                android:background="@color/larus_neutral_transparent_2"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_0_5"
                android:layout_marginTop="?attr/larus_dp_16"
                android:paddingStart="?attr/larus_dp_16"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/memory_date_text"/>
            <TextView
                android:textSize="?attr/larus_sp_12"
                android:textColor="@color/neutral_70"
                android:id="@+id/memory_date_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_5"
                android:paddingStart="?attr/larus_dp_16"
                app:layout_constraintStart_toStartOf="@+id/text_view"
                app:layout_constraintTop_toBottomOf="@+id/text_view"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</com.larus.bmhome.chat.layout.holder.progressloading.RadiusCardView>
