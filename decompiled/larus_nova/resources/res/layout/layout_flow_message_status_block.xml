<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/flow_send_failed_icon"
        android:layout_width="12.83dp"
        android:layout_height="12.83dp"
        android:src="@drawable/ic_flow_send_message_failed"/>
    <TextView
        android:textSize="12sp"
        android:id="@+id/message_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"/>
    <com.ss.android.lark.chatbase.view.ChatMessageEditStatusView
        android:id="@+id/message_edit_status_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
