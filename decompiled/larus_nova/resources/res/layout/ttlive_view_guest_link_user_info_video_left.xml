<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_personal_score_container"
        android:background="@drawable/ttlive_bg_guest_link_personnal_score"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="4dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/iv_personal_score"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/ttlive_ic_guest_link_score"
            app:failureImage="@drawable/ttlive_ic_guest_link_score"
            app:placeholderImage="@drawable/ttlive_ic_guest_link_score"/>
        <TextView
            android:textSize="9sp"
            android:textColor="@color/ttlive_text_white"
            android:id="@+id/tv_personal_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="1dp"
            android:text="0"
            android:textAlignment="center"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_user_name_container"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginBottom="3dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent">
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/tv_user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="95dp"
            android:text="@string/ttlive_guest_link_waiting"
            android:maxLines="1"
            android:textAlignment="center"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_user_role"
            android:background="@drawable/ttlive_bg_guest_link_main_page_user_tag"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="14dp"
            android:layout_marginLeft="4dp"
            android:text="@string/ttlive_guest_link_inviter"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
