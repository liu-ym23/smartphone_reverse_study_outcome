<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ec_commerce_item_gallery_photo_with_btn_1836708829"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.ui.ec.widget.photodraweeview.transition.TransitionPhotoDraweeView
        android:id="@+id/photo_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.ec.core.widget.ECStatusView
        android:layout_gravity="center"
        android:id="@+id/ec_status_view"
        android:layout_width="36dp"
        android:layout_height="36dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/ec_ll_find_same_goods"
        android:background="@drawable/commerce_anchor_v4_find_same_button_bg"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginBottom="64dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_search"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="4dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="17dp"
            android:textColor="@color/white"
            android:id="@+id/tv_find_same"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shopping_search_for_similar_goods"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_right_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/shopping_right_arrow_white_12dp"
            android:layout_marginStart="7dp"/>
    </LinearLayout>
</FrameLayout>
