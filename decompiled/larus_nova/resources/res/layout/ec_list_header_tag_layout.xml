<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.livesdk.livecommerce.iron.listheader.ListHeaderTagWidget
        android:id="@+id/front_tags_ll"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"/>
    <com.bytedance.android.livesdk.livecommerce.iron.widgets.ECNewReputationLayout
        android:id="@+id/reputation_tag"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.bytedance.android.livesdk.livecommerce.iron.widgets.ECFlagShipReputationView
        android:layout_gravity="center_vertical"
        android:id="@+id/reputation_flagship"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="16dp"/>
    <com.bytedance.android.livesdk.livecommerce.iron.listheader.ListHeaderTagWidget
        android:orientation="horizontal"
        android:id="@+id/tags_ll"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="3dp"
        android:layout_marginStart="3dp"/>
    <com.bytedance.android.livesdk.livecommerce.iron.widgets.ECShopETAView
        android:layout_gravity="center_vertical"
        android:id="@+id/eta_info"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"/>
</merge>
