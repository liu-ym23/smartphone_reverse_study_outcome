<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/poi_detail_sataus_error_1559028716"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_parent"
        android:paddingLeft="@dimen/empty_page_padding"
        android:paddingRight="@dimen/empty_page_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp">
        <com.bytedance.dux.text.DuxTextView
            android:textColor="@color/POITextPrimary"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/uikit_network_error"
            app:fontType="medium"
            style="@style/font_size_34_sp"/>
        <com.bytedance.dux.text.DuxTextView
            android:textColor="@color/POITextTertiary"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/uikit_check_and_retry"
            style="@style/font_size_28_sp"/>
    </LinearLayout>
    <com.bytedance.dux.text.DuxTextView
        android:textSize="14sp"
        android:textColor="@color/POITextPrimary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_retry"
        android:background="@drawable/poi_dito_bg_status_button_saas"
        android:layout_width="230dp"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:text="@string/uikit_retry"/>
</LinearLayout>
