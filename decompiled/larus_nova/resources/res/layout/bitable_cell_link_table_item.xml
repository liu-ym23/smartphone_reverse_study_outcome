<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/link_table_item_content"
    android:paddingBottom="2dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bitable_cell_link_table_item_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.ee.bear.bitable.infoarch.nativeview.BitableNativeViewContainer
            android:id="@+id/nativeViewContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="@dimen/bitable_native_view_divider_size"
            android:layout_weight="1"/>
        <View
            android:background="@color/line_divider_default"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bitable_native_view_divider_size"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/link_table_item_container"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:paddingStart="16dp">
            <View
                android:id="@+id/link_table_bottom_loading"
                android:background="@drawable/bitable_native_view_loading_bg"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_caption"
                android:id="@+id/link_table_item_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="100dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/link_table_item_add"
                android:padding="8dp"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:tint="@color/icon_n2"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/link_table_item_divider"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ud_icon_add_outlined"/>
            <View
                android:id="@+id/link_table_item_divider"
                android:background="@color/line_divider_default"
                android:visibility="gone"
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/link_table_item_expand"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/link_table_item_expand"
                android:padding="8dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:tint="@color/icon_n2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ud_icon_expand_outlined"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</FrameLayout>
