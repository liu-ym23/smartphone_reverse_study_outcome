<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.ee.bear.widgets.panel.CommonActionPanelLayout
        android:id="@+id/url_edit_panel"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:panel_custom_left_icon="@drawable/ud_icon_close_small_outlined"
        app:panel_left_menu_type="icon"
        app:panel_right_menu_type="text"
        app:panel_right_text="@string/Bitable_Common_ButtonDone"
        app:panel_right_text_color="@color/text_link_normal"
        app:panel_title="@string/Bitable_Field_Hyperlink">
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_kit_len_16"
            android:text="@string/Bitable_Field_HyperlinkText"
            android:layout_marginStart="@dimen/space_kit_len_16"
            android:layout_marginEnd="@dimen/space_kit_len_16"/>
        <com.bytedance.ee.bear.bitable.card.view.cell.text.BitableSpaceEditText
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_title"
            android:textColorHint="@color/text_placeholder"
            android:gravity="center_vertical"
            android:id="@+id/text_et"
            android:paddingLeft="@dimen/space_kit_len_12"
            android:paddingRight="@dimen/space_kit_len_12"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_kit_len_40"
            android:layout_marginTop="@dimen/space_kit_len_8"
            android:hint="@string/Bitable_Common_PleaseEnterMobileVer"
            android:maxLines="1"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:layout_marginStart="@dimen/space_kit_len_16"
            android:layout_marginEnd="@dimen/space_kit_len_16"
            app:ud_radius="m"
            app:ud_strokeColor="@color/bitable_field_edittext_stroke_color"
            app:ud_strokeWidth="@dimen/space_kit_len_1"
            style="@style/SpaceEditTextStyle"/>
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_kit_len_20"
            android:text="@string/Bitable_Field_HyperlinkAddress"
            android:layout_marginStart="@dimen/space_kit_len_16"
            android:layout_marginEnd="@dimen/space_kit_len_16"/>
        <com.bytedance.ee.bear.bitable.card.view.cell.text.BitableAtEditText
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_title"
            android:textColorHint="@color/text_placeholder"
            android:gravity="center_vertical"
            android:id="@+id/url_et"
            android:paddingLeft="@dimen/space_kit_len_12"
            android:paddingRight="@dimen/space_kit_len_12"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_kit_len_40"
            android:layout_marginTop="@dimen/space_kit_len_8"
            android:layout_marginBottom="@dimen/space_kit_len_16"
            android:hint="@string/Bitable_Form_EnterOrPasteLinkMobileVer"
            android:maxLines="1"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:layout_marginStart="@dimen/space_kit_len_16"
            android:layout_marginEnd="@dimen/space_kit_len_16"
            app:ud_radius="m"
            app:ud_strokeColor="@color/bitable_field_edittext_stroke_color"
            app:ud_strokeWidth="@dimen/space_kit_len_1"
            style="@style/SpaceEditTextStyle"/>
        <com.bytedance.ee.bear.document.widget.KeyboardPlaceholderView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.bytedance.ee.bear.widgets.panel.CommonActionPanelLayout>
</FrameLayout>
