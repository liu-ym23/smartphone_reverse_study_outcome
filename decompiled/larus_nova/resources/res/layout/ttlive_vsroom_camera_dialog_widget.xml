<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.livesdk.widget.LivePagerSlidingTabStrip
        android:id="@+id/tab_strip"
        android:layout_width="0dp"
        android:layout_height="40dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tab_background="@color/transparent"
        app:tab_indicator_color="@color/white"
        app:tab_indicator_height="2dp"
        app:tab_indicator_radius="10dp"
        app:tab_indicator_width="30dp"
        app:tab_margin_right="40dp"
        app:tab_padding_left_right="0dp"
        app:tab_text_color="#80ffffff"
        app:tab_text_size="15dp"
        app:tab_underline_color="@color/transparent"/>
    <com.bytedance.android.live.uikit.viewpager.SSViewPager
        android:id="@+id/viewpager"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tab_strip"
        app:layout_goneMarginTop="0dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
