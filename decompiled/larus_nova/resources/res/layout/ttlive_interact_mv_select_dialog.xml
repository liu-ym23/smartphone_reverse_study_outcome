<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:id="@+id/fragment_container"
    android:background="@drawable/ttlive_bg_mv_select_panel_corner"
    android:layout_width="match_parent"
    android:layout_height="600dp">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_interactive_song_mv_select"/>
        <View
            android:layout_gravity="bottom"
            android:background="#1f161823"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="44dp"
        android:layout_marginBottom="68dp">
        <com.bytedance.android.live.liveinteract.interactivesong.panel.MvSelectTabView
            android:id="@+id/mv_panel_tab_view"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/mv_panel_viewpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:background="#161823"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="68dp">
        <TextView
            android:textSize="15dp"
            android:textColor="#ffffff"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/mv_panel_preview_btn"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_interactive_song_mv_preview"/>
        <FrameLayout
            android:layout_gravity="end|center_vertical"
            android:id="@+id/mv_panel_operation_container"
            android:layout_width="140dp"
            android:layout_height="38dp">
            <View
                android:id="@+id/mv_panel_operation_bg"
                android:background="@drawable/ttlive_bg_mv_select_panel_red"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#ffffff"
                android:layout_gravity="center"
                android:id="@+id/mv_panel_operation_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_interactive_song_mv_play"/>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
