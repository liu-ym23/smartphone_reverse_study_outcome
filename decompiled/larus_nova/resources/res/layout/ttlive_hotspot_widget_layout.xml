<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/hotspot_container"
    android:background="@drawable/ttlive_bg_hashtag_widget"
    android:layout_width="wrap_content"
    android:layout_height="22dp"
    android:shadowColor="#4cff358d"
    android:shadowDy="2"
    android:shadowRadius="4">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/icon_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/icon_hotspot_iv"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginLeft="6dp"
            android:src="@drawable/ttlive_ic_hotspot"
            android:layout_marginStart="6dp"/>
        <ImageView
            android:gravity="center"
            android:id="@+id/icon_hotspot_desc"
            android:layout_width="24dp"
            android:layout_height="12dp"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="4dp"
            android:src="@drawable/ttlive_icon_hotspot_desc"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="4dp"/>
        <ImageView
            android:id="@+id/icon_hotspot_new"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="1dp"
            android:src="@drawable/ttlive_ic_hotspot_new"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="1dp"/>
    </LinearLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/hotspot_desc_tv"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:maxWidth="80dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/icon_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/fold_iv"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="6dp"
        android:src="@drawable/ttlive_ic_below_arrow_white"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/hotspot_desc_tv"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
