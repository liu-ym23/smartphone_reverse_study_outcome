<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_dialog_inroom_user"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp">
        <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
            android:layout_gravity="center"
            android:id="@+id/change_room_top_loading_view"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="3.5dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/change_room_top_loading_view_hotsoon"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ttlive_ic_category_loading"
            android:layout_marginEnd="3.5dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#7f161823"
            android:id="@+id/change_room_from_top"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_anchor_link_window_change_room_top"/>
        <View
            android:id="@+id/change_room_top_gap"
            android:background="@color/black"
            android:visibility="gone"
            android:layout_width="1px"
            android:layout_height="14dp"
            android:alpha="0.2"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#7f161823"
            android:id="@+id/cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_anchor_link_window_cancel_apply"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp">
        <com.bytedance.android.live.liveinteract.interact.audience.ui.AudienceInteractWaitingView
            android:id="@+id/waiting_view"
            android:layout_width="56dp"
            android:layout_height="56dp"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/apply_lottie"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            app:lottie_autoPlay="true"
            app:lottie_fileName="link_apply_waiting.json"
            app:lottie_loop="true"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/anchor_avatar"
            android:layout_width="56dp"
            android:layout_height="56dp"/>
    </LinearLayout>
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:layout_gravity="center_horizontal"
        android:id="@+id/has_apply_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ttlive_interact_audience_has_apply"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#57161823"
        android:layout_gravity="center_horizontal"
        android:id="@+id/waiting_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"/>
    <Button
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#1e1e1e"
        android:id="@+id/btn_reason"
        android:background="@drawable/ttlive_bg_btn_apply_reason"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="28dp"
        android:layout_marginRight="16dp"
        android:text="@string/ttlive_interact_add_reason"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/reason_container"
        android:background="@drawable/ttlive_bg_interact_applied_reason"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="28dp"
        android:layout_marginRight="16dp">
        <TextView
            android:textColor="#80161823"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/apply_reason"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="1"
            android:layout_marginStart="12dp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_change"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ttlive_ic_interact_edit_reason"
            android:layout_marginEnd="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/change_room_from_bottom"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <TextView
            android:textSize="14dp"
            android:textColor="#161823"
            android:id="@+id/change_room_from_bottom_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_anchor_link_window_change_room_bottom"/>
        <ImageView
            android:id="@+id/change_room_from_bottom_iv"
            android:layout_width="5dp"
            android:layout_height="10dp"
            android:src="@drawable/ttlive_chat_room_change_room"
            android:layout_marginStart="7dp"/>
    </LinearLayout>
</LinearLayout>
