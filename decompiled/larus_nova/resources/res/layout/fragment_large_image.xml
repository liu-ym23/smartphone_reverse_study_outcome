<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/info_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="65dp"/>
    <com.larksuite.common_selection.SelectionContainer
        android:id="@+id/selection_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.ss.android.lark.widget.photo.preview.image.NonSelectableLargeImageView
            android:id="@+id/scale_image_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.ss.android.lark.widget.photo.preview.ocr.TextGraphicOverlay
            android:id="@+id/text_graphic_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.larksuite.common_selection.SelectionContainer>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/error_image"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:adjustViewBounds="true"
        app:srcCompat="@drawable/ud_icon_loadfail_filled"/>
    <TextView
        android:textColor="@color/static_white"
        android:layout_gravity="bottom"
        android:id="@+id/failed_path_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="60dp"
        android:maxLines="2"/>
    <com.ss.android.lark.ui.RotateLoadingView
        android:layout_gravity="center"
        android:id="@+id/loading"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:tint="@color/static_white"
        app:rotate_src="@drawable/ud_icon_chat_loading_outlined"/>
    <FrameLayout
        android:id="@+id/flag_container"
        android:background="@color/bg_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/error_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_54"
            android:layout_marginStart="@dimen/dp_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/video_ctrl_close"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/static_white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/flag_resource_cleaned"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Lark_IM_ImageCleanedByAdmin_Error"
            android:drawablePadding="@dimen/dp_12"
            android:textAlignment="center"/>
    </FrameLayout>
    <com.ss.android.lark.imageocr.view.OCRScanView
        android:id="@+id/image_ocr_scan_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
