<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="?attr/larus_citation_item_bg"
    android:layout_width="wrap_content"
    android:layout_height="32dp"
    android:paddingStart="?attr/larus_dp_12"
    android:paddingEnd="?attr/larus_dp_12">
    <TextView
        android:textSize="?attr/larus_dp_12"
        android:textColor="?attr/larus_neutral_70"
        android:layout_gravity="center_vertical"
        android:id="@+id/citation_index"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:layout_gravity="center_vertical"
        android:id="@+id/citation_icon"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:layout_marginStart="?attr/larus_dp_8"
        app:failureImage="@drawable/larus_citation_default_web_site_icon"
        app:placeholderImage="@drawable/larus_citation_default_web_site_icon"
        app:roundedCornerRadius="?attr/larus_dp_4"/>
    <TextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="?attr/larus_neutral_100"
        android:layout_gravity="center_vertical"
        android:id="@+id/citation_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_8"/>
</LinearLayout>
