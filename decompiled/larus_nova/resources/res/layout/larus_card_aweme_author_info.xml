<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:paddingLeft="?attr/larus_dp_8"
    android:paddingTop="?attr/larus_dp_8"
    android:paddingRight="?attr/larus_dp_8"
    android:paddingBottom="?attr/larus_dp_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larus.bmhome.view.RoundAvatarImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/avatar"
        android:layout_width="?attr/larus_dp_16"
        android:layout_height="?attr/larus_dp_16"
        app:avatar_placeholder="@drawable/aweme_avatar_placeholder"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/like_icon"
        android:layout_width="?attr/larus_dp_14"
        android:layout_height="?attr/larus_dp_14"
        android:layout_marginTop="?attr/larus_dp_1"
        android:layout_marginEnd="?attr/larus_dp_2"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/like_count"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"
        app:srcCompat="?attr/larus_bg_aweme_like"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_12"
        android:textColor="?attr/larus_neutral_70"
        android:id="@+id/like_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_12"
        android:textColor="?attr/larus_neutral_70"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/nick_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="?attr/larus_dp_4"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/like_icon"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5"/>
</androidx.constraintlayout.widget.ConstraintLayout>
