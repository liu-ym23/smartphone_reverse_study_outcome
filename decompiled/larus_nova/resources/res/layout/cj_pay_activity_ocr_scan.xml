<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.android.ttcjpaysdk.ocr.view.OCRCodeView
        android:id="@+id/tt_cj_pay_ocr_view"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:CJPayScanBoxLayout="@layout/cj_pay_view_scan_box"/>
    <ImageView
        android:id="@+id/back_view"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:src="@drawable/cj_pay_ocr_back_icon"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/light_view"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:src="@drawable/cj_pay_ocr_light_icon"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="22dp"
        android:textColor="@color/cj_pay_color_white_90"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/cj_pay_ocr_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="104dp"
        android:text="@string/cj_pay_ocr_scan_bank_card_title"
        android:lines="1"
        android:maxEms="15"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/warning_tips_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="210dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/cj_pay_ocr_warning_icon"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/cj_pay_color_white"
            android:layout_gravity="center"
            android:id="@+id/tv_warning_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cj_pay_ocr_warning_bank_card_not_in_the_scan_area"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/cj_pay_color_white"
        android:gravity="center_vertical"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/album_view"
        android:background="@drawable/cj_pay_bg_ocr_album"
        android:paddingLeft="43dp"
        android:paddingTop="9dp"
        android:paddingRight="43dp"
        android:paddingBottom="9dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="134dp"
        android:text="@string/cj_pay_ocr_upload_pictures"
        android:drawableLeft="@drawable/cj_pay_ocr_album_icon"
        android:drawablePadding="2dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
        android:id="@+id/bottom_insurance_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_alignParentBottom="true"
        app:theme_type="1"/>
    <com.android.ttcjpaysdk.base.ui.widget.CJPayTextLoadingView
        android:id="@+id/ocr_loading_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
