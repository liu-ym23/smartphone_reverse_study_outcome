<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_pay_complete_root_view"
    android:background="@color/cj_pay_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/cj_pay_page_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="44dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <ImageView
                android:id="@+id/cj_pay_left_close"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginLeft="16dp"
                android:src="@drawable/cj_pay_sign_and_pay_left_leave"
                android:layout_centerVertical="true"/>
            <ImageView
                android:id="@+id/navigation_bar_icon"
                android:layout_width="85dp"
                android:layout_height="18dp"
                android:src="@drawable/cj_pay_dy_pay_icon"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/cj_pay_result_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/cj_pay_color_black_161823"
            android:id="@+id/cj_pay_result_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
            android:gravity="center"
            android:id="@+id/cj_pay_result_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"/>
        <View
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <Button
            android:textSize="15sp"
            android:textColor="@color/cj_pay_color_black_161823"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/cj_pay_bottom_button"
            android:background="@drawable/cj_pay_bg_round_corner_btn_radius_4"
            android:visibility="gone"
            android:layout_width="165dp"
            android:layout_height="44dp"/>
        <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
            android:id="@+id/bottom_insurance_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="-8dp"
            app:theme_type="0"/>
        <View
            android:id="@+id/cj_pay_bottom_margin"
            android:layout_width="wrap_content"
            android:layout_height="20dp"/>
    </LinearLayout>
</FrameLayout>
