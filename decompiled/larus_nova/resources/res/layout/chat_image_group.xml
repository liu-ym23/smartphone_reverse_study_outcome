<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.ss.android.lark.chatbase.view.ChatImageView
        android:id="@+id/chat_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerInside"/>
    <com.ss.android.lark.widget.AutoRecycleGifImageView
        android:id="@+id/chat_sticker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerInside"/>
    <com.ss.android.lark.widget.DonutProgress
        android:layout_gravity="center"
        android:id="@+id/upload_progress"
        android:visibility="gone"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:progress="50"
        app:donut_background_color="@color/bg_body"
        app:donut_circle_starting_degree="270"
        app:donut_finished_color="@color/primary_fill_default"
        app:donut_finished_stroke_width="2dp"
        app:donut_text_color="@color/text_title"
        app:donut_text_size="15sp"
        app:donut_unfinished_color="@color/line_border_card"
        app:donut_unfinished_stroke_width="2dp"/>
    <com.ss.android.lark.widget.mark.MarkView
        android:layout_gravity="bottom|right"
        android:id="@+id/tv_image_tag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_marginEnd="6dp"
        app:text="@string/Lark_IM_GIF_Tag"/>
    <com.ss.android.lark.widget.mark.MarkView
        android:layout_gravity="bottom|right"
        android:id="@+id/resource_is_cleaned_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_marginEnd="6dp"
        app:text="@string/Lark_IM_FileExpiredByAdmin_Label"/>
    <com.ss.android.lark.chat.chatwindow.chat.view.IMCircleLoadingView
        android:layout_gravity="center"
        android:id="@+id/loading_view"
        android:visibility="gone"
        android:layout_width="25dp"
        android:layout_height="25dp"/>
</merge>
