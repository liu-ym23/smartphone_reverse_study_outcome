<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.chatroom.miniapp.views.TTLiveDragRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/microapp_m_live_drag_layout"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:ttlive_dock_margin_left="10dp"
    app:ttlive_dock_margin_right="10dp"
    app:ttlive_dock_mode="left_right">
    <com.bytedance.android.livesdk.chatroom.miniapp.views.LiveMiniAppRoundedRelativeLayout
        android:id="@+id/microapp_m_out_box"
        android:layout_width="90dp"
        android:layout_height="160dp"
        android:layout_marginBottom="70dp"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="-90dp"
        android:layout_alignParentEnd="true"
        app:rounded_radius="2dp">
        <com.bytedance.android.livesdkapi.roomplayer.LivePlayerView
            android:id="@+id/live_window_player_view"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <RelativeLayout
            android:id="@+id/microapp_m_live_window_mask"
            android:background="#80000000"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textColor="@color/ttlive_microapp_m_p_white_1"
                android:id="@+id/microapp_m_live_window_new_user"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_float_back_room"
                android:layout_centerInParent="true"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/microapp_m_live_window_end"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <com.bytedance.android.livesdk.chatroom.miniapp.views.LiveMiniAppRoundedImageView
                    android:id="@+id/microapp_m_live_avatar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"/>
                <TextView
                    android:textColor="@color/ttlive_microapp_m_p_white_6"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/microapp_m_live_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:width="60dp"
                    android:singleLine="true"
                    style="@style/ttlive_microapp_m_font_size_22"/>
                <TextView
                    android:textColor="@color/ttlive_microapp_m_p_white_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_live_end_label"
                    style="@style/ttlive_microapp_m_font_size_24"/>
            </LinearLayout>
        </RelativeLayout>
        <View
            android:id="@+id/microapp_m_float_video_close"
            android:background="@drawable/ttlive_commerce_ic_commerce_float_video_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"/>
    </com.bytedance.android.livesdk.chatroom.miniapp.views.LiveMiniAppRoundedRelativeLayout>
</com.bytedance.android.livesdk.chatroom.miniapp.views.TTLiveDragRelativeLayout>
