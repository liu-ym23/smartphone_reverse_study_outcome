<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/iv_file_icon"
        android:layout_width="@dimen/dp_36"
        android:layout_height="@dimen/dp_36"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_16"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/file_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_16"
        android:layout_marginStart="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_download"
        app:layout_constraintStart_toEndOf="@+id/iv_file_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="@dimen/dp_16">
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_file_name"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_22"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="@dimen/dp_12"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_subtitle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_18"
            android:maxLines="1"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:alpha="0.35"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_download"
        android:layout_width="@dimen/dp_18"
        android:layout_height="@dimen/dp_18"
        android:importantForAccessibility="no"
        android:layout_marginEnd="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/larus_pc_remote_file_download"
        app:tint="?attr/larus_neutral_70"/>
    <ProgressBar
        android:id="@+id/loading_indicator"
        android:visibility="gone"
        android:layout_width="@dimen/dp_18"
        android:layout_height="@dimen/dp_18"
        android:indeterminate="true"
        android:importantForAccessibility="no"
        android:indeterminateTint="?attr/larus_neutral_100"
        app:layout_constraintStart_toStartOf="@+id/iv_download"
        app:layout_constraintTop_toTopOf="@+id/iv_download"
        style="?android:attr/progressBarStyleSmall"/>
    <View
        android:id="@+id/download_action"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="48dp"
        android:layout_height="0dp"
        android:contentDescription="@string/larus_slides_download_btn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
