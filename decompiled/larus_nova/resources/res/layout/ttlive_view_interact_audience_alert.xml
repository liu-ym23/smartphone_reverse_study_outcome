<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_interact_audience_alert"
    android:layout_width="@dimen/ttlive_interact_window_width"
    android:layout_height="@dimen/ttlive_interact_window_height">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="fitXY"/>
    <ImageView
        android:id="@+id/close"
        android:padding="3dp"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:src="@drawable/ttlive_ic_interact_window_close"
        android:scaleType="fitXY"
        android:layout_alignParentEnd="true"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/nickname"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:singleLine="true"
        android:layout_below="@+id/avatar"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"/>
    <FrameLayout
        android:background="@drawable/ttlive_bg_live_red_btn"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_margin="4dp"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/accept"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/ttlive_interact_accept_link"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/loading"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/apply_lottie"
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:lottie_autoPlay="true"
                app:lottie_fileName="connect_loading.json"
                app:lottie_loop="true"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ttlive_white"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_live_interact_loading"/>
        </LinearLayout>
    </FrameLayout>
</RelativeLayout>
