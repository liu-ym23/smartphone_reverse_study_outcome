<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:weightSum="1">
    <GridLayout
        android:id="@+id/image_4_container"
        android:background="?attr/larus_base_1"
        android:layout_width="?attr/larus_dp_300"
        android:layout_height="?attr/larus_dp_300"
        android:layout_weight="1"
        android:rowCount="2"
        android:columnCount="2">
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="?attr/larus_img_4_box_divider"
            android:layout_column="0"
            android:layout_row="0"
            android:layout_marginEnd="?attr/larus_img_4_box_divider"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">
            <com.larus.bmhome.chat.plugin.image4.view.ImageViewWithLastMotion
                android:id="@+id/img4_no1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                app:failureImage="@drawable/larus_generate_image_error"
                app:placeholderImage="?attr/larus_base_2_overlay"
                app:roundBottomEnd="false"
                app:roundBottomStart="false"
                app:roundTopEnd="false"
                app:roundTopStart="true"
                app:roundedCornerRadius="?attr/larus_dp_8"/>
            <ViewStub
                android:id="@+id/img4_no1_loading"
                android:layout="@layout/larus_sketch_progress_loading"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="?attr/larus_img_4_box_divider"
            android:layout_column="1"
            android:layout_row="0"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">
            <com.larus.bmhome.chat.plugin.image4.view.ImageViewWithLastMotion
                android:id="@+id/img4_no2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                app:failureImage="@drawable/larus_generate_image_error"
                app:placeholderImage="?attr/larus_base_2_overlay"
                app:roundBottomEnd="false"
                app:roundBottomStart="false"
                app:roundTopEnd="true"
                app:roundTopStart="false"
                app:roundedCornerRadius="?attr/larus_dp_8"/>
            <ViewStub
                android:id="@+id/img4_no2_loading"
                android:layout="@layout/larus_sketch_progress_loading"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_column="0"
            android:layout_row="1"
            android:layout_marginEnd="?attr/larus_img_4_box_divider"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">
            <com.larus.bmhome.chat.plugin.image4.view.ImageViewWithLastMotion
                android:id="@+id/img4_no3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                app:failureImage="@drawable/larus_generate_image_error"
                app:placeholderImage="?attr/larus_base_2_overlay"
                app:roundBottomEnd="false"
                app:roundBottomStart="true"
                app:roundTopEnd="false"
                app:roundTopStart="false"
                app:roundedCornerRadius="?attr/larus_dp_8"/>
            <ViewStub
                android:id="@+id/img4_no3_loading"
                android:layout="@layout/larus_sketch_progress_loading"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_column="1"
            android:layout_row="1"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">
            <com.larus.bmhome.chat.plugin.image4.view.ImageViewWithLastMotion
                android:id="@+id/img4_no4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                app:failureImage="@drawable/larus_generate_image_error"
                app:placeholderImage="?attr/larus_base_2_overlay"
                app:roundBottomEnd="true"
                app:roundBottomStart="false"
                app:roundTopEnd="false"
                app:roundTopStart="false"
                app:roundedCornerRadius="?attr/larus_dp_8"/>
            <ViewStub
                android:id="@+id/img4_no4_loading"
                android:layout="@layout/larus_sketch_progress_loading"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </GridLayout>
    <TextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="?attr/larus_neutral_70"
        android:gravity="center_vertical"
        android:id="@+id/regenerate_btn"
        android:background="?attr/larus_bg_prompt_vertical"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_38"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginBottom="?attr/larus_dp_12"
        android:text="@string/larus_generate_again"
        android:drawablePadding="?attr/larus_dp_4"
        android:paddingStart="?attr/larus_dp_12"
        android:paddingEnd="?attr/larus_dp_12"
        app:drawableEndCompat="?attr/larus_arow_right"/>
</LinearLayout>
