<?xml version="1.0" encoding="utf-8"?>
<com.larksuite.component.ui.layout.LKUIRoundableLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_float"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="24dp"
    android:layout_marginTop="24dp"
    android:layout_marginRight="24dp"
    android:layout_marginBottom="24dp"
    app:rl_border_color="@color/line_border_card"
    app:rl_border_width="0.5dp"
    app:rl_radius="8dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingLeft="12dp"
        android:paddingTop="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="24dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.larksuite.component.ui.layout.LKUIRoundableLayout
            android:id="@+id/fold_header_region_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/fold_header_divider_region"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:rl_border_width="0dp"
            app:rl_radius="8dp">
            <FrameLayout
                android:id="@+id/fold_header_region"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.ss.android.lark.widget.light.LKUILightTextView
                        android:textSize="17sp"
                        android:textColor="@color/text_title"
                        android:gravity="center"
                        android:id="@+id/tv_fold_card_text_content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorful_orange"
                        android:id="@+id/tv_fold_follow_total_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </FrameLayout>
        </com.larksuite.component.ui.layout.LKUIRoundableLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/fold_header_divider_region"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintBottom_toTopOf="@+id/fold_card_flow_detail"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fold_header_region_wrapper">
            <View
                android:background="@drawable/bg_devider_gradient_right"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/text_caption"
                android:id="@+id/tv_fold_follower_total_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <View
                android:background="@drawable/bg_devider_gradient_left"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/see_fold_detail_wrapper"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:layout_constraintBottom_toTopOf="@+id/btn_follow_fold"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fold_card_flow_detail">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/text_caption"
                android:id="@+id/tv_fold_detail_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:tint="@color/text_caption"
                app:srcCompat="@drawable/ud_icon_right_outlined"/>
        </LinearLayout>
        <com.ss.android.lark.chat.chatwindow.chat.message.cell.fold.FoldFollowButton
            android:textSize="16sp"
            android:textColor="@color/primary_fill_default"
            android:layout_gravity="center_horizontal"
            android:id="@+id/btn_follow_fold"
            android:background="@drawable/bg_btn_follow_message"
            android:paddingLeft="22dp"
            android:paddingTop="7dp"
            android:paddingRight="22dp"
            android:paddingBottom="7dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:drawablePadding="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/see_fold_detail_wrapper"/>
        <FrameLayout
            android:id="@+id/layout_fold_anim_wrapper"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_marginBottom="110dp"
            app:layout_constraintBottom_toBottomOf="@+id/btn_follow_fold"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">
            <com.ss.android.lark.chat.chatwindow.chat.message.cell.fold.FoldFollowAnimView
                android:layout_gravity="center"
                android:id="@+id/layout_fold_anim"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
        </FrameLayout>
        <com.ss.android.lark.chat.chatwindow.chat.message.cell.fold.FoldCardFlowLayout
            android:id="@+id/fold_card_flow_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintBottom_toTopOf="@+id/see_fold_detail_wrapper"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fold_header_divider_region"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/click_mask_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.larksuite.component.ui.layout.LKUIRoundableLayout>
