<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_bind_b_root_view"
    android:background="?attr/cj_pay_quick_bind_card_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/cj_pay_quick_card_list_title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true">
        <com.android.ttcjpaysdk.base.ui.widget.CJPayBoldTextView
            android:textSize="?attr/cj_pay_page_size_15"
            android:textStyle="bold"
            android:textColor="@color/cj_pay_color_black_161823"
            android:gravity="center_vertical"
            android:id="@+id/cj_pay_quick_bind_card_title"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="4dp"
            android:text="@string/cj_pay_quick_bind_fragment_b_title"
            android:includeFontPadding="false"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/cj_pay_quick_bind_title_arrow"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/cj_pay_arrow_down"
            android:alpha="0"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/cj_pay_quick_bind_card_subtitle_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_16"
        android:layout_marginTop="@dimen/cj_pay_padding_3"
        android:layout_marginBottom="-4dp"
        android:layout_below="@+id/cj_pay_quick_card_list_title_container">
        <TextView
            android:textSize="?attr/cj_pay_page_size_12"
            android:textColor="?attr/cj_pay_quick_bind_card_subtitle"
            android:id="@+id/cj_pay_quick_bind_card_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cj_pay_quick_bind_card_header_subtitle"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:background="?attr/cj_pay_page_bg_shape_color"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="16dp"
        android:layout_below="@+id/cj_pay_quick_bind_card_subtitle_layout"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/quick_bind_card_recylerview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/divider"
        android:layout_alignParentLeft="true"
        android:overScrollMode="never"
        android:layout_alignParentStart="true"
        android:nestedScrollingEnabled="false"/>
    <View
        android:id="@+id/divider_2"
        android:background="?attr/cj_pay_page_bg_shape_color"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="50dp"
        android:layout_marginRight="16dp"
        android:layout_below="@+id/quick_bind_card_recylerview"
        android:layout_alignParentLeft="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/cj_pay_quick_bind_card_b_bottom"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="50dp"
        android:layout_below="@+id/divider_2"
        android:layout_alignParentLeft="true">
        <TextView
            android:textSize="?attr/cj_pay_page_size_14"
            android:textColor="#161823"
            android:id="@+id/quick_bind_card_bottom_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cj_pay_quick_bind_bottom_text"/>
        <ImageView
            android:id="@+id/quick_bind_card_bottom_b_unfold_arrow"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="6dp"
            android:src="@drawable/cj_pay_arrow_down"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/query_card_no_arrow"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/cj_pay_bindcard_right_arrow"/>
    </LinearLayout>
</RelativeLayout>
