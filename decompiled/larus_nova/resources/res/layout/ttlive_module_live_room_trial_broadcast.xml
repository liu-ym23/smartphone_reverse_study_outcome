<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="right"
    android:id="@+id/trial_broadcast_whole"
    android:background="@drawable/ttlive_bg_trial_broadcast_unverified"
    android:layout_width="wrap_content"
    android:layout_height="30dp">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/trial_broadcast_lv"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginLeft="14.5dp"
        android:layout_marginStart="14.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/trial_broadcasting"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_fileName="ttlive_trial_broadcast_white.json"
        app:lottie_loop="true"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_white"
        android:gravity="center"
        android:id="@+id/trial_broadcasting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4.5dp"
        android:text="试播中"
        android:singleLine="true"
        android:layout_marginStart="4.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/trial_broadcast_text"
        app:layout_constraintStart_toEndOf="@+id/trial_broadcast_lv"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_white"
        android:gravity="center"
        android:id="@+id/trial_broadcast_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:text="完成实名认证正式开播"
        android:singleLine="true"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/trial_broadcast_arrow"
        app:layout_constraintStart_toEndOf="@+id/trial_broadcasting"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/trial_broadcast_arrow"
        android:background="@drawable/ttlive_trial_broadcast_arrow_white"
        android:layout_width="4dp"
        android:layout_height="8dp"
        android:layout_marginLeft="7dp"
        android:layout_marginRight="11dp"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="11dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/trial_broadcast_text"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
