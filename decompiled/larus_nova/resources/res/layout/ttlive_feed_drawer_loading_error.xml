<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/status_error"
    android:background="#000000"
    android:paddingTop="15dp"
    android:paddingBottom="15dp"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="240dp"
        android:layout_height="160dp"
        android:layout_marginTop="100dp"
        android:src="@drawable/ttlive_bg_network_error"/>
    <TextView
        android:textSize="17dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/ttlive_feed_drawer_no_network"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#80ffffff"
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ttlive_feed_drawer_no_tip"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/error_retry"
        android:background="@drawable/ttlive_feed_drawer_retry_bg"
        android:layout_width="112dp"
        android:layout_height="36dp"
        android:layout_marginTop="16dp"
        android:text="@string/ttlive_feed_drawer_click_retry"/>
</LinearLayout>
