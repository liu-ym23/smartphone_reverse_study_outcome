<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#252427"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_photo_preview"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        android:layout_weight="1"/>
    <RelativeLayout
        android:background="#252427"
        android:layout_width="match_parent"
        android:layout_height="96dp">
        <Button
            android:textSize="16dp"
            android:textColor="@color/cj_pay_color_white"
            android:id="@+id/btn_take_photo_retry"
            android:background="@android:color/transparent"
            android:layout_width="100dp"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:text="@string/cj_pay_ocr_take_photo_retry"
            android:layout_marginStart="24dp"/>
        <Button
            android:textSize="16dp"
            android:textColor="@color/cj_pay_color_white"
            android:id="@+id/btn_take_photo_confirm"
            android:background="@android:color/transparent"
            android:layout_width="100dp"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:text="@string/cj_pay_ocr_take_photo_ok"
            android:layout_marginEnd="24dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
