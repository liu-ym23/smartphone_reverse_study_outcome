<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/bg_border"
        android:background="@drawable/ttlive_bg_broadcast_more_action"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:id="@+id/more_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ttlive_small_window_question_desc"
        android:alpha="0.9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider"
        android:background="@color/ttlive_std_line_white_3"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="10.5dp"
        app:layout_constraintTop_toBottomOf="@+id/more_dialog_title"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider">
        <TextView
            android:textSize="13sp"
            android:textColor="#e5ffffff"
            android:layout_gravity="center_vertical"
            android:id="@+id/hint_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_small_window_question_desc_text"
            android:alpha="0.7"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="20dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/lottery_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="22dp">
                <RelativeLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:background="@drawable/ttlive_small_window_question_circle_bg"
                    android:layout_width="68dp"
                    android:layout_height="68dp">
                    <View
                        android:background="@drawable/ttlive_icon_small_window_lottery"
                        android:layout_width="36dp"
                        android:layout_height="36dp"/>
                </RelativeLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#e5ffffff"
                    android:layout_gravity="center"
                    android:id="@+id/lottery_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:layout_marginBottom="15dp"
                    android:text="@string/ttlive_small_window_question_desc_text_lottery"
                    android:alpha="0.5"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:background="@drawable/ttlive_small_window_question_circle_bg"
                    android:layout_width="68dp"
                    android:layout_height="68dp">
                    <View
                        android:background="@drawable/ttlive_icon_small_window_link"
                        android:layout_width="36dp"
                        android:layout_height="36dp"/>
                </RelativeLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#e5ffffff"
                    android:layout_gravity="center"
                    android:id="@+id/red_package_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:layout_marginBottom="15dp"
                    android:text="@string/ttlive_small_window_question_desc_text_link"
                    android:alpha="0.5"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
