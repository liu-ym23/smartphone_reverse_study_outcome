<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/poi_commponent_collect_recommend_item_585623417"
    android:layout_width="match_parent"
    android:layout_height="92dp">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/poi_recommend_collect_img"
        android:layout_width="76dp"
        android:layout_height="76dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="2dp"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/poi_recommend_collect_btn"
        android:layout_width="60dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.locallife.poi.newdetail.widget.CheckableImageView
            android:id="@+id/poi_recommend_collect_btn_ic"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="2dp"/>
        <com.bytedance.dux.text.DuxTextView
            android:textColor="@color/ConstTextInverse"
            android:id="@+id/poi_recommend_collect_btn_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/poi_collect_new_style"
            style="@style/font_size_24_sp"/>
    </LinearLayout>
    <com.bytedance.dux.text.DuxTextView
        android:textStyle="bold"
        android:textColor="@color/POITextPrimary"
        android:ellipsize="end"
        android:id="@+id/poi_recommend_collect_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="22dp"
        android:layout_marginRight="12dp"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toStartOf="@+id/poi_recommend_collect_btn"
        app:layout_constraintStart_toEndOf="@+id/poi_recommend_collect_img"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/font_size_28_sp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/poi_recommend_message_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="5dp"
        android:layout_marginRight="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toStartOf="@+id/poi_recommend_collect_btn"
        app:layout_constraintStart_toEndOf="@+id/poi_recommend_collect_img"
        app:layout_constraintTop_toBottomOf="@+id/poi_recommend_collect_title">
        <com.bytedance.dux.text.DuxTextView
            android:textColor="@color/POITextTertiary"
            android:ellipsize="end"
            android:id="@+id/poi_recommend_message_rank"
            android:background="@drawable/poi_bg_poi_recommend_rank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/font_size_24_sp"/>
        <com.bytedance.dux.text.DuxTextView
            android:textColor="@color/POITextTertiary"
            android:ellipsize="end"
            android:id="@+id/poi_recommend_message_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/font_size_24_sp"/>
        <com.bytedance.dux.text.DuxTextView
            android:textColor="@color/POITextTertiary"
            android:ellipsize="end"
            android:id="@+id/poi_recommend_message_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="8dp"
            style="@style/font_size_24_sp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
