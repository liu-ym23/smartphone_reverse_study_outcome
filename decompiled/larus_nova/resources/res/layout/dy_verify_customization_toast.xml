<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="horizontal"
    android:background="@drawable/dy_verify_toast_bg_customization_toast"
    android:paddingLeft="@dimen/cj_pay_padding_20"
    android:paddingTop="@dimen/cj_pay_padding_16"
    android:paddingRight="@dimen/cj_pay_padding_20"
    android:paddingBottom="@dimen/cj_pay_padding_16"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/cj_pay_color_white"
        android:gravity="center"
        android:id="@+id/cj_pay_view_customization_toast_text"
        android:padding="0dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"/>
</LinearLayout>
