<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/realtime_call_root_bottom"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.av_call.view.VoiceCallBottomLayout
        android:id="@+id/voice_call_bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_13"
        android:textColor="@color/larus_danger_50"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/connect_info"
        android:paddingBottom="?attr/larus_dp_12"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:layout_marginStart="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
