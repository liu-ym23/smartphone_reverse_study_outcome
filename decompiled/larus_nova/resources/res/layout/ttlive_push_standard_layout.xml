<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_push_bg"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:elevation="8dp">
    <com.bytedance.android.livesdkapi.view.SaasLiveCircleView
        android:id="@+id/ttlive_live_circle"
        android:padding="3dp"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:live_strokeWidth="2dp"/>
    <ImageView
        android:id="@+id/ttlive_push_avatar"
        android:padding="2dp"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_push_text_color"
        android:ellipsize="end"
        android:id="@+id/ttlive_push_anchor_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="9dp"
        android:layout_marginTop="18dp"
        android:maxLines="1"
        app:layout_constraintLeft_toRightOf="@+id/ttlive_push_avatar"
        app:layout_constraintRight_toLeftOf="@+id/ttlive_push_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_push_text_color"
        android:ellipsize="end"
        android:id="@+id/ttlive_push_info_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="9dp"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        app:layout_constraintLeft_toRightOf="@+id/ttlive_push_avatar"
        app:layout_constraintRight_toLeftOf="@+id/ttlive_push_icon"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_push_anchor_name"/>
    <ImageView
        android:id="@+id/ttlive_push_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="16dp"
        android:src="@drawable/ttlive_push_go"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
