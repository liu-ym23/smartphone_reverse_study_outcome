<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:background="@color/larus_static_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:transitionName="share_video">
    <FrameLayout
        android:id="@+id/fragment_container"
        android:background="@color/larus_static_black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="?attr/larus_dp_50"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/layout_up_slide"
        android:background="@color/larus_static_black"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_50">
        <ImageView
            android:id="@+id/icon_up_slide"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/larus_icon_up_slide"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/text_up_slide"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginEnd="0dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/static_white_transparent_3"
            android:id="@+id/text_up_slide"
            android:background="@color/larus_static_black"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/icon_up_slide"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginStart="0dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/back"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_8"
        android:src="@drawable/larus_ic_left_back"
        android:layout_marginStart="?attr/larus_dp_8"
        app:tint="@color/larus_static_white"/>
</FrameLayout>
