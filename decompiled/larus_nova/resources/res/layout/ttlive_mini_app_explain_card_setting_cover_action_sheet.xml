<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ttlive_mini_app_explain_card_setting_cover_action_sheet_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="#1f161823"
        android:showDividers="middle">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/ttlive_douyin_light_TextPrimary"
            android:gravity="center"
            android:id="@+id/cover_action_sheet_album"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/ttlive_open_platform_customized_cover_desc"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/cover_action_sheet_text_poster_layout"
            android:layout_width="match_parent"
            android:layout_height="77dp">
            <TextView
                android:textSize="17sp"
                android:textColor="@color/ttlive_douyin_light_TextPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_open_platform_text_poster_cover_desc"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ttlive_douyin_text_TextTertiary"
                android:id="@+id/cover_action_sheet_text_poster_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_open_platform_cover_action_sheet_cancel"/>
        </LinearLayout>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/ttlive_douyin_light_TextPrimary"
            android:gravity="center"
            android:id="@+id/cover_action_sheet_preset"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/ttlive_open_platform_preset_cover_desc"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/ttlive_douyin_light_TextPrimary"
            android:gravity="center"
            android:id="@+id/cover_action_sheet_screenshot"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/ttlive_open_platform_screenshot_cover_desc"/>
    </LinearLayout>
    <View
        android:background="@color/ttlive_dialog_divider_line"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/ttlive_douyin_light_TextPrimary"
        android:gravity="center"
        android:id="@+id/cover_action_sheet_cancel"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_open_platform_cover_action_sheet_cancel"/>
</LinearLayout>
