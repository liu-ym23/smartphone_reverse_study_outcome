<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/cj_pay_payment_confirm_root_view"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cj_pay_height_470">
    <FrameLayout
        android:id="@+id/cj_pay_titlebar_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_50">
        <include
            android:id="@+id/cj_pay_titlebar_root_view"
            layout="@layout/cj_pay_view_titlebar_noise_reduction_layout"/>
    </FrameLayout>
    <RelativeLayout
        android:gravity="center_horizontal"
        android:id="@+id/cj_pay_red_envelope_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="58dp"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
            android:id="@+id/cj_pay_red_envelope"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center_horizontal"
        android:id="@+id/cj_pay_total_value_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_below="@+id/cj_pay_red_envelope_layout"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="28sp"
            android:textColor="@color/cj_pay_color_black_161823"
            android:id="@+id/cj_pay_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/cj_pay_padding_5"
            android:layout_marginBottom="@dimen/cj_pay_padding_10"
            android:text="@string/cj_pay_currency_unit"
            android:layout_alignBottom="@+id/cj_pay_total_value"/>
        <TextView
            android:textSize="36sp"
            android:textColor="@color/cj_pay_color_black_161823"
            android:id="@+id/cj_pay_total_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_toRightOf="@+id/cj_pay_unit"/>
    </RelativeLayout>
    <View
        android:id="@+id/cj_pay_order_info_divider"
        android:background="@color/cj_pay_color_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_half_1"
        android:layout_marginLeft="@dimen/cj_pay_padding_16"
        android:layout_marginTop="48dp"
        android:layout_marginRight="@dimen/cj_pay_padding_16"
        android:layout_below="@+id/cj_pay_total_value_layout"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/cj_payment_method_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_56"
        android:layout_marginLeft="@dimen/cj_pay_padding_16"
        android:layout_marginRight="@dimen/cj_pay_padding_8"
        android:layout_below="@+id/cj_pay_order_info_divider">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/cj_pay_padding_16"
            android:text="@string/cj_pay_payment_method"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <LinearLayout
                android:layout_gravity="right"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/cj_payment_method_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="@dimen/cj_pay_padding_16"
                    android:layout_marginRight="@dimen/cj_pay_padding_8"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:ellipsize="middle"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/cj_payment_method"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cj_pay_color_gray_8a8b91"
                android:ellipsize="end"
                android:layout_gravity="right"
                android:id="@+id/cj_payment_method_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cj_pay_padding_1"
                android:singleLine="true"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <FrameLayout
            android:layout_gravity="right"
            android:layout_width="@dimen/cj_pay_height_24"
            android:layout_height="match_parent">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_payment_method_arrow"
                android:layout_width="@dimen/cj_pay_height_24"
                android:layout_height="@dimen/cj_pay_height_24"
                android:src="@drawable/cj_pay_icon_right_arrow"
                android:scaleType="centerCrop"/>
            <ProgressBar
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_payment_method_loading"
                android:background="@color/cj_pay_color_trans"
                android:visibility="gone"
                android:layout_width="@dimen/cj_pay_padding_24"
                android:layout_height="@dimen/cj_pay_padding_24"
                android:indeterminateOnly="true"
                android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_gray"
                android:indeterminateDuration="500"
                android:indeterminateBehavior="repeat"/>
        </FrameLayout>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/combine_pay_layout"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:layout_below="@+id/cj_payment_method_layout">
        <LinearLayout
            android:id="@+id/balance_pay_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_90"
                android:id="@+id/combine_balance_item_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
                android:id="@+id/combine_balance_pay"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cj_pay_pay_with_space"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_90"
                android:id="@+id/combine_balance_item_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_below="@+id/balance_pay_layout">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_90"
                android:id="@+id/combine_bankcard_item_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_combine_change_arrow"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/cj_pay_icon_right_arrow"
                android:scaleType="centerCrop"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
                android:id="@+id/combine_bankcard_pay"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cj_pay_pay_with_space"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_90"
                android:id="@+id/combine_bankcard_item_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </RelativeLayout>
    <View
        android:id="@+id/cj_payment_method_divider"
        android:background="@color/cj_pay_color_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_half_1"
        android:layout_marginLeft="@dimen/cj_pay_padding_16"
        android:layout_marginRight="@dimen/cj_pay_padding_16"
        android:layout_below="@+id/cj_payment_method_layout"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
            android:textSize="15sp"
            android:textColor="?attr/cj_pay_button_text_white_color"
            android:gravity="center"
            android:id="@+id/cj_pay_confirm"
            android:background="@drawable/cj_pay_bg_red_btn_radius_2_fe2c55"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_height_44"
            android:layout_marginLeft="@dimen/cj_pay_padding_16"
            android:layout_marginRight="@dimen/cj_pay_padding_16"
            android:layout_marginBottom="@dimen/cj_pay_padding_20"
            android:includeFontPadding="false"/>
        <ProgressBar
            android:id="@+id/cj_pay_confirm_loading"
            android:background="@color/cj_pay_color_trans"
            android:visibility="gone"
            android:layout_width="@dimen/cj_pay_padding_20"
            android:layout_height="@dimen/cj_pay_padding_20"
            android:layout_marginTop="@dimen/cj_pay_padding_14"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_white"
            android:indeterminateDuration="500"
            android:indeterminateBehavior="repeat"
            android:layout_alignTop="@+id/cj_pay_confirm"
            android:layout_centerHorizontal="true"/>
        <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
            android:id="@+id/cj_pay_insurance_tips_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:layout_below="@+id/cj_pay_confirm"
            app:theme_type="0"/>
    </RelativeLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp"
        layout="@layout/cj_pay_view_half_screen_loading_layout"/>
    <include
        android:id="@+id/cj_pay_security_panel_loading_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp"
        layout="@layout/cj_pay_view_security_panel_loading_container"/>
</RelativeLayout>
