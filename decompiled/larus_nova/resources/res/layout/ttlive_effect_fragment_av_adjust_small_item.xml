<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.effect.base.AdjustPercentBar
        android:id="@+id/color_adjust_seek_bar"
        android:background="#0000"
        android:padding="0dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginBottom="207dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:ttlive_effect_bar_padding="24dp"
        app:ttlive_effect_lineWidth="4dp"
        app:ttlive_effect_textColor="#ffffff"
        app:ttlive_effect_textSize="14dp"/>
    <View
        android:id="@+id/content_background_view"
        android:background="@color/transparent"
        android:layout_width="0dp"
        android:layout_height="@dimen/ttlive_effect_beauty_panel_content_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:id="@+id/color_adjust_reset_view"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:layout_marginRight="@dimen/ttlive_effect_beauty_panel_reset_margin_right"
        android:layout_marginBottom="@dimen/ttlive_effect_beauty_panel_reset_margin_bottom"
        android:layout_marginEnd="@dimen/ttlive_effect_beauty_panel_reset_margin_right"
        app:layout_constraintBottom_toTopOf="@+id/small_item_beauty_recycle_view"
        app:layout_constraintEnd_toEndOf="parent">
        <View
            android:id="@+id/icon"
            android:background="@drawable/ttlive_effect_ic_beauty_item_refresh"
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/color_adjust_reset_tv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_effect_broadcast_beauty_item_reset_color"
            android:id="@+id/color_adjust_reset_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:text="@string/ttlive_effect_live_beauty_small_reset"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/icon"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/small_item_beauty_recycle_view"
        android:layout_width="0dp"
        android:layout_height="@dimen/ttlive_effect_beauty_common_list_height"
        android:layout_marginBottom="@dimen/ttlive_effect_beauty_common_list_margin_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.bytedance.android.live.uikit.recyclerview.LoadingStatusView
        android:id="@+id/small_item_beauty_loading_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/small_item_beauty_recycle_view"
        app:layout_constraintEnd_toEndOf="@+id/small_item_beauty_recycle_view"
        app:layout_constraintStart_toStartOf="@+id/small_item_beauty_recycle_view"
        app:layout_constraintTop_toTopOf="@+id/small_item_beauty_recycle_view"/>
    <View
        android:id="@+id/toast_view"
        android:background="@color/transparent"
        android:layout_width="0dp"
        android:layout_height="150dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
