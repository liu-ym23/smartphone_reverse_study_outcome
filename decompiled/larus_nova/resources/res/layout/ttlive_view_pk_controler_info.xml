<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/ll_top_info"
    android:background="@drawable/ttlive_bg_pk_guest_info"
    android:clipChildren="false"
    android:layout_width="70dp"
    android:layout_height="20dp">
    <FrameLayout
        android:clipChildren="false"
        android:layout_width="20dp"
        android:layout_height="20dp">
        <com.bytedance.android.livesdk.widget.VHeadView
            android:id="@+id/head_view_top"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_marginRight="4dp"
            android:scaleType="fitXY"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/radio_effect"
            android:visibility="gone"
            android:layout_width="28dp"
            android:layout_height="28dp"
            app:actualImageScaleType="fitXY"/>
    </FrameLayout>
    <TextView
        android:textSize="9dp"
        android:textColor="@color/ttlive_white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_nick_name_top"
        android:layout_width="35dp"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_interact_link_game_role_select"
        android:lines="1"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="0"/>
    <ImageView
        android:id="@+id/iv_mute_top"
        android:visibility="visible"
        android:layout_width="11dp"
        android:layout_height="11dp"
        android:src="@drawable/ttlive_pk_icon_state_unmute"
        android:scaleType="centerInside"
        android:layout_marginStart="1dp"/>
</merge>
