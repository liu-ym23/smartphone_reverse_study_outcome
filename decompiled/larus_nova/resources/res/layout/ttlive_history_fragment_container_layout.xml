<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/history_back"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:src="@drawable/ttlive_history_back_ic"
        android:contentDescription="@string/ttlive_label_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17sp"
        android:textColor="#e6ffffff"
        android:gravity="center_vertical"
        android:id="@+id/history_title"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:text="@string/ttlive_history_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/history_swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/history_title">
        <include
            android:id="@+id/history_login"
            android:visibility="gone"
            layout="@layout/ttlive_feed_drawer_loading_login_history"/>
        <com.bytedance.android.live.ui.FadingEdgeRecyclerview
            android:id="@+id/history_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/history_no_history_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/history_title">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/empty_history_view"
            android:layout_width="240dp"
            android:layout_height="160dp"
            android:layout_marginTop="240dp"
            android:src="@drawable/ttlive_empty_content_dark"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#80ffffff"
            android:layout_gravity="center"
            android:id="@+id/empty_history_tip_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/ttlive_history_no_his"/>
    </LinearLayout>
    <com.bytedance.android.livesdk.chatroom.ui.DouyinLoadingLayout
        android:layout_gravity="center"
        android:id="@+id/history_loading_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
