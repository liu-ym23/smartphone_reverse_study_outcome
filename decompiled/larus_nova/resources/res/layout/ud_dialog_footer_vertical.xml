<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/ud_dialog_padding_footer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/ud_dialog_primary_btn_divider"
        android:background="@color/line_divider_default"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ud_divider_size"
        app:layout_constraintBottom_toTopOf="@+id/ud_dialog_btn_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larksuite.component.universe_design.button.UDButton
        android:textColor="@color/ud_button_blue_text"
        android:id="@+id/ud_dialog_btn_primary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/ud_dialog_secondary_btn_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ud_dialog_primary_btn_divider"
        app:ud_backgroundColor="@color/ud_dialog_default_button_bg"
        app:ud_radius="none"
        style="@style/UDDialogButton"/>
    <View
        android:id="@+id/ud_dialog_secondary_btn_divider"
        android:background="@color/line_divider_default"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ud_divider_size"
        app:layout_constraintBottom_toTopOf="@+id/ud_dialog_btn_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ud_dialog_btn_primary"/>
    <com.larksuite.component.universe_design.button.UDButton
        android:textColor="@color/ud_button_grey_text"
        android:id="@+id/ud_dialog_btn_secondary"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/ud_dialog_secondary_btn_divider2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ud_dialog_secondary_btn_divider"
        app:ud_backgroundColor="@color/ud_dialog_default_button_bg"
        app:ud_radius="none"
        style="@style/UDDialogButton"/>
    <View
        android:id="@+id/ud_dialog_secondary_btn_divider2"
        android:background="@color/line_divider_default"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ud_divider_size"
        app:layout_constraintBottom_toTopOf="@+id/ud_dialog_btn_secondary2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ud_dialog_btn_secondary"/>
    <com.larksuite.component.universe_design.button.UDButton
        android:textColor="@color/ud_button_grey_text"
        android:id="@+id/ud_dialog_btn_secondary2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ud_dialog_secondary_btn_divider2"
        app:ud_backgroundColor="@color/ud_dialog_default_button_bg"
        app:ud_radius="none"
        style="@style/UDDialogButton"/>
</merge>
