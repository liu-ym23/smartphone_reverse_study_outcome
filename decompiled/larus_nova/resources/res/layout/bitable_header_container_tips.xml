<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/header_container_tips_layout"
    android:layout_width="232dp"
    android:layout_height="52dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="25dp"
        app:srcCompat="@drawable/bitable_view_drawer_first_use_tips_triangle"/>
    <RelativeLayout
        android:layout_width="232dp"
        android:layout_height="36dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/header_container_tips_bg"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            app:srcCompat="@drawable/bitable_view_drawer_first_use_tips"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:text="@string/Bitable_Mobile_ClickToReopen_Tooltip"
            android:layout_centerVertical="true"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/header_container_tips_close"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginRight="12dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:srcCompat="@drawable/ud_icon_close_outlined"
            app:tint="@color/white"/>
    </RelativeLayout>
</LinearLayout>
