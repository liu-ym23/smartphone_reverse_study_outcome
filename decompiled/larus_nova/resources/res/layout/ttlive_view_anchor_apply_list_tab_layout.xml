<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/apply_list_tab_container"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingEnd="16dp">
    <TextView
        android:textSize="11dp"
        android:textColor="#ff161823"
        android:id="@+id/common_queue_btn"
        android:background="@drawable/ttlive_bg_apply_type_tab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_paid_common_queue_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="11dp"
        android:textColor="#ff161823"
        android:id="@+id/paid_queue_btn"
        android:background="@drawable/ttlive_bg_apply_type_tab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:text="@string/ttlive_paid_queue_text"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/common_queue_btn"
        app:layout_constraintLeft_toRightOf="@+id/common_queue_btn"
        app:layout_constraintTop_toTopOf="@+id/common_queue_btn"/>
    <TextView
        android:textSize="11dp"
        android:textColor="#7f161823"
        android:id="@+id/apply_sort_type"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="2dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_rule"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_rule"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ttlive_guest_send_gift_rule"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/switch_sort_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="12dp"
            android:id="@+id/tv_sort_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="18dp"
            android:text="@string/order_by_waiting_time"
            android:layout_marginEnd="18dp"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/iv_switcher"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ttlive_icon_switch_sort_vertical"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
