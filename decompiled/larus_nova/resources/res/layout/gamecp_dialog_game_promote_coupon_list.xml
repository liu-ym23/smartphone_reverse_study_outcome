<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/gamecp_shape_bg_ffffff_top_corner_12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="17dp"
        android:textColor="@color/gamecp_game_161823"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/ttlive_game_promote_prop_order_prop_coupon_title"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_gamecp_coupon_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/gamecp_white"
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <View
            android:background="@color/gamecp_game_1A000000"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/gamecp_white"
            android:gravity="center"
            android:id="@+id/tv_coupon_list_confirm"
            android:background="@drawable/shape_bg_fe2c55_corner_4"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/ttlive_game_promote_prop_order_prop_coupon_list_confirm"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"/>
    </LinearLayout>
</LinearLayout>
