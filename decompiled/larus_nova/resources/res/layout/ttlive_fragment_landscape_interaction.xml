<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.widget.GestureDetectLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/parent_view"
    android:fitsSystemWindows="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/content_layer_master_view"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/vr_gesture_guide_area"
            android:visibility="gone"
            android:layout_width="260dp"
            android:layout_height="197dp">
            <com.airbnb.lottie.LottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/vr_gesture_guide_anim"
                android:layout_width="160dp"
                android:layout_height="160dp"/>
            <TextView
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/vr_gesture_guide_text"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:text="@string/ttlive_vr_gesture_guide_text"/>
        </LinearLayout>
        <com.bytedance.android.livesdk.castscreen.views.bytecast.LiveCastControlLayout
            android:id="@+id/cast_screen_landscape_control_bg"
            android:background="@color/black"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/interact_theme_bg_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/normal_interact_window_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/video_talkroom_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/new_video_talkroom_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/mic_seat_ui_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/interact_debug_info_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/interact_screen_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/interact_pk_audience_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/interact_multi_container"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/interact_multi_container_preload_ui"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/interact_revenue_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/revenue_load_service_holder"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"/>
        <FrameLayout
            android:id="@+id/mic_room_backup_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/multi_anchor_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/screen_live_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/decoration_layer_master_view"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/cast_tv_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/end_widget_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/pk_audience_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/pk_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/obs_barrage_layout"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/live_decoration_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/listen_live_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/broadcast_pause_page_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.livesdk.common.AnchorPauseTipsView
            android:layout_gravity="center"
            android:id="@+id/anchor_pause_tips_view"
            android:visibility="gone"
            android:layout_width="188dp"
            android:layout_height="166dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/font_layer_master_view"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:id="@+id/interaction_layer_master_view"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/top_widget_container_place_holder"
            android:layout_width="match_parent"
            android:layout_height="59dp"/>
        <FrameLayout
            android:id="@+id/red_envelope_container"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/pk_promotion_container"
            android:layout_below="@+id/top_widget_container_place_holder"/>
        <FrameLayout
            android:id="@+id/daily_rank"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_toRightOf="@+id/mic_room_container"
            android:layout_below="@+id/top_widget_container_place_holder"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@+id/mic_room_container"/>
        <FrameLayout
            android:id="@+id/guard_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/ttlive_guard_widget_margin_start"
            android:layout_toRightOf="@+id/daily_rank"
            android:layout_below="@+id/top_widget_container_place_holder"
            android:layout_marginStart="@dimen/ttlive_guard_widget_margin_start"
            android:layout_toEndOf="@+id/daily_rank"/>
        <FrameLayout
            android:id="@+id/top_left_activity_banner_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_toRightOf="@+id/guard_container"
            android:layout_below="@+id/top_widget_container_place_holder"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@+id/guard_container"/>
        <ViewStub
            android:id="@+id/landscape_bottom_right_indicator_container"
            android:visibility="visible"
            android:layout="@layout/ttlive_layout_landscape_indicator_container"
            android:inflatedId="@+id/landscape_bottom_right_indicator_container"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ttlive_landscape_sti_container_height"
            android:layout_marginRight="22dp"
            android:layout_marginBottom="60dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="22dp"
            android:layout_alignParentEnd="true"/>
        <com.bytedance.android.livesdk.common.LiveViewStub
            android:id="@+id/live_media_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/video_animate_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/paid_profile_card_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/live_layer_master_view"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/floating_layer_master_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_landscape_rank_info_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="61dp">
            <FrameLayout
                android:id="@+id/live_scene_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginStart="6dp"/>
            <FrameLayout
                android:id="@+id/landscape_mic_room_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:layout_marginEnd="8dp"/>
            <FrameLayout
                android:id="@+id/landscape_rank_info_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginStart="4dp"/>
            <FrameLayout
                android:id="@+id/landscape_drawer_entrance_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </FrameLayout>
</com.bytedance.android.livesdk.widget.GestureDetectLayout>
