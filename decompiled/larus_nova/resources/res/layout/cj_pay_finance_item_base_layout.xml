<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_pay_payment_method_normal_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/cj_pay_payment_method_icon"
        android:visibility="gone"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginLeft="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/cj_pay_payment_method_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cj_pay_payment_method_title"/>
    <ImageView
        android:id="@+id/cj_pay_payment_method_icon_unable_mask"
        android:visibility="gone"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginLeft="16dp"
        android:src="@drawable/cj_pay_bg_payment_icon_unable_style_5"
        app:layout_constraintBottom_toBottomOf="@+id/cj_pay_payment_method_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cj_pay_payment_method_title"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/cj_pay_color_black_161823"
        android:ellipsize="end"
        android:id="@+id/cj_pay_payment_method_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:singleLine="true"
        android:includeFontPadding="false"
        app:layout_constraintStart_toEndOf="@+id/cj_pay_payment_method_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginLeft="44dp"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/cj_pay_color_white"
        android:id="@+id/cj_pay_payment_method_recommend_tag"
        android:background="@drawable/cj_pay_bg_recommend_red_tag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="@+id/cj_pay_payment_method_title"
        app:layout_constraintStart_toEndOf="@+id/cj_pay_payment_method_title"
        app:layout_constraintTop_toTopOf="@+id/cj_pay_payment_method_title"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
        android:ellipsize="end"
        android:id="@+id/cj_pay_payment_method_sub_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        android:includeFontPadding="false"
        app:layout_constraintStart_toStartOf="@+id/cj_pay_payment_method_title"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_payment_method_title"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
        android:ellipsize="end"
        android:id="@+id/cj_pay_payment_method_desc_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:singleLine="true"
        android:includeFontPadding="false"
        app:layout_constraintStart_toStartOf="@+id/cj_pay_payment_method_sub_title"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_payment_method_sub_title"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/cj_pay_color_red"
        android:gravity="center"
        android:id="@+id/cj_pay_payment_method_sub_title_icon"
        android:background="@drawable/cj_pay_bg_payment_method_recommend_way"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        android:includeFontPadding="false"
        app:layout_constraintStart_toStartOf="@+id/cj_pay_payment_method_desc_title"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_payment_method_desc_title"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/cj_pay_color_red"
        android:gravity="center"
        android:id="@+id/cj_pay_payment_method_sub_title_icon_next"
        android:background="@drawable/cj_pay_bg_payment_method_recommend_way"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:singleLine="true"
        android:includeFontPadding="false"
        app:layout_constraintLeft_toRightOf="@+id/cj_pay_payment_method_sub_title_icon"
        app:layout_constraintTop_toTopOf="@+id/cj_pay_payment_method_sub_title_icon"/>
    <FrameLayout
        android:id="@+id/cj_pay_payment_select_default_Layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/cj_pay_payment_method_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cj_pay_payment_method_title">
        <com.android.ttcjpaysdk.base.theme.widget.CJPayCircleCheckBox
            android:id="@+id/cj_pay_payment_method_checkbox"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:scaleType="centerCrop"/>
        <ImageView
            android:id="@+id/cj_pay_payment_method_arrow"
            android:visibility="visible"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/cj_pay_icon_right_arrow_noise_reduction"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/cj_pay_payment_select_customer_Layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/cj_pay_payment_method_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cj_pay_payment_method_title"/>
    <ProgressBar
        android:id="@+id/cj_pay_payment_method_loading"
        android:background="@color/cj_pay_color_trans"
        android:visibility="gone"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginRight="13dp"
        android:indeterminateOnly="true"
        android:indeterminateDrawable="@drawable/cj_pay_method_loading_circle"
        android:indeterminateDuration="500"
        android:indeterminateBehavior="repeat"
        app:layout_constraintBottom_toBottomOf="@+id/cj_pay_payment_method_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cj_pay_payment_method_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
