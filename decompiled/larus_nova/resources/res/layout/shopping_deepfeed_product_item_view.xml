<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.shopping.deepfeed.weights.DeepFeedProductHeaderView
        android:id="@+id/deepFeed_product_header_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="60dp"
        app:layout_constraintBottom_toTopOf="@+id/deep_feed_bottom_fill"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.shopping.deepfeed.weights.DeepFeedProductToolContainer
        android:id="@+id/deep_feed_tool_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/deep_feed_info_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/deep_feed_new_search_location"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="34dp"
        app:layout_constraintBottom_toTopOf="@+id/deep_feed_info_container"/>
    <com.bytedance.android.shopping.deepfeed.weights.DeepFeedSearchBarView
        android:id="@+id/deepFeed_live_searchbar_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintTop_toBottomOf="@+id/deep_feed_new_search_location"/>
    <com.bytedance.android.shopping.deepfeed.weights.DeepFeedAiContainerView
        android:id="@+id/deep_feed_center_ai_rec_container"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/deep_feed_info_container"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/deep_feed_info_container"
        android:background="@drawable/shopping_bg_deep_feed_product_info_container"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/deep_feed_bottom_fill">
        <View
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.shopping.deepfeed.weights.DeepFeedAiContainerView
            android:id="@+id/deep_feed_under_ai_rec_container"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toTopOf="@+id/deepFeed_product_bottom_view"/>
        <com.bytedance.android.shopping.deepfeed.weights.DeepFeedProductAbilityView
            android:id="@+id/deepFeed_product_bottom_view"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="54dp"
            app:layout_constraintTop_toBottomOf="@+id/deepFeed_product_info_view"
            app:layout_goneMarginBottom="0dp"/>
        <com.bytedance.android.shopping.deepfeed.weights.DeepFeedProductInfoView
            android:id="@+id/deepFeed_product_info_view"
            android:background="@drawable/shopping_bg_deepfeed_product_info"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.shopping.deepfeed.weights.DeepFeedAiLoadingContainer
        android:id="@+id/deep_feed_ai_loading_lottie_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/deep_feed_bottom_fill"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/deep_feed_bottom_fill"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</merge>
