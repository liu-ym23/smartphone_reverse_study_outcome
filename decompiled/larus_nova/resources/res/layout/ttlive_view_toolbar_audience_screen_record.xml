<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/initial_view"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ttlive_ic_toolbar_audience_record_initial60"
        android:layout_centerInParent="true"/>
    <RelativeLayout
        android:id="@+id/progress_view"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/progress_record_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ttlive_ic_toolbar_audience_record_progress"
            android:layout_centerInParent="true"/>
        <com.bytedance.android.livesdk.chatroom.widget.LiveCircleProgressView
            android:id="@+id/progress"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginLeft="2dp"
            android:layout_marginBottom="4dp"
            android:layout_alignLeft="@+id/progress_record_icon"
            android:layout_alignBottom="@+id/progress_record_icon"
            android:layout_alignStart="@+id/progress_record_icon"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/finished_view"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ttlive_ic_toolbar_audience_record_finished"
        android:layout_centerInParent="true"/>
</RelativeLayout>
