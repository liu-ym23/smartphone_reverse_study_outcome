<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/facade_round_top_xxl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/bg_float_base">
    <com.bytedance.ee.bear.widgets.BaseTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:widget_widgets_tb_back_icon="@drawable/ud_icon_close_small_outlined"
        app:widget_widgets_tb_background="@color/color_transparent"
        app:widget_widgets_tb_divider_height="@dimen/ud_divider_size"
        app:widget_widgets_tb_divider_visible="true"
        app:widget_widgets_tb_title="@string/Doc_Facade_Share"/>
    <com.larksuite.component.universe_design.notice.UDNotice
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/titleBackIcon"
        app:ud_notice_icon="@drawable/ud_icon_warning_hollow_filled"
        app:ud_notice_text="@string/Doc_Permission_AddUserSendNotice"
        style="@style/UDNotice.Warning"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/text_title"
        android:id="@+id/secretLevelTip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginRight="@dimen/dp_16"/>
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/stateLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.ee.bear.facade.common.widget.BearLottieView
            android:layout_gravity="center"
            android:id="@+id/loadingView"
            android:layout_marginTop="94dp"
            android:layout_marginBottom="113dp"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/loading_anim"
            style="@style/BearLottieView"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/loadingFailedLayout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="88dp"
            android:layout_marginBottom="88dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:layout_width="125dp"
                android:layout_height="125dp"
                app:srcCompat="@drawable/ccm_empty_negative_load_failed"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/CreationMobile_Common_Placeholder_FailedToLoad"/>
        </LinearLayout>
    </FrameLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <RelativeLayout
                android:id="@+id/secretLevelRoot"
                android:background="@drawable/secret_backgroud"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">
                <TextView
                    android:textSize="@dimen/space_kit_font_16"
                    android:textColor="@color/text_title"
                    android:id="@+id/sharePermSetEntranceTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:layout_marginBottom="13dp"
                    android:text="@string/LarkCCM_Docs_PermissionDetails_Menu_Mob"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/sharePermSetEntranceIcon"
                    android:layout_width="@dimen/space_kit_len_12"
                    android:layout_height="@dimen/space_kit_len_12"
                    android:scaleType="centerInside"
                    android:tint="@color/text_placeholder"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/space_kit_len_16"
                    android:layout_alignParentEnd="true"
                    app:srcCompat="@drawable/ud_icon_right_outlined"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/btnLayout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">
                <com.larksuite.component.universe_design.button.UDButton
                    android:textSize="16sp"
                    android:textColor="@color/text_title"
                    android:id="@+id/cancelBtn"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:text="@string/Doc_Facade_Cancel"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    app:ud_backgroundColor="@color/ud_button_white_blue_bg"
                    app:ud_radius="l"
                    app:ud_strokeColor="@color/line_border_component"
                    app:ud_strokeWidth="1dp"
                    style="@style/UDButton.Small.Primary"/>
                <com.larksuite.component.universe_design.button.UDButton
                    android:enabled="false"
                    android:textSize="16sp"
                    android:textColor="@color/static_white"
                    android:id="@+id/doneBtn"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:text="@string/CreationMobile_SecureLabel_Edit_Apply"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="16dp"
                    app:ud_backgroundColor="@color/ud_button_blue_bg"
                    app:ud_radius="l"
                    style="@style/UDButton.Small.Primary"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
