<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textColor="#404040"
        android:gravity="center_vertical"
        android:id="@+id/ttlive_content_tv"
        android:background="@drawable/ttlive_bg_live_white_btn"
        android:padding="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_live_beauty_popup_tip"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@drawable/ttlive_bg_live_gift_tip_arrow"
        android:layout_width="12dp"
        android:layout_height="6dp"
        app:layout_constraintLeft_toLeftOf="@+id/ttlive_content_tv"
        app:layout_constraintRight_toRightOf="@+id/ttlive_content_tv"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_content_tv"/>
</androidx.constraintlayout.widget.ConstraintLayout>
