<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="112dp"
    android:layout_height="135dp">
    <com.bytedance.lighten.loader.SmartImageView
        android:id="@+id/merge_drawer_holder_image"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="12dp"/>
    <FrameLayout
        android:id="@+id/merge_drawer_holder_image_shadow"
        android:background="@drawable/ttlive_merge_drawer_holder_shadow"
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:layout_constraintStart_toStartOf="@+id/merge_drawer_holder_image"
        app:layout_constraintTop_toTopOf="@+id/merge_drawer_holder_image"/>
    <com.airbnb.lottie.LottieAnimationView
        android:layout_gravity="center"
        android:id="@+id/merge_drawer_holder_live_playing"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/merge_drawer_holder_image"
        app:layout_constraintStart_toStartOf="@+id/merge_drawer_holder_image"
        app:lottie_autoPlay="true"
        app:lottie_fileName="feed_live_volume_icon_lottie.json"
        app:lottie_loop="true"/>
    <TextView
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/merge_drawer_holder_big_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/merge_drawer_holder_image"
        app:layout_constraintStart_toStartOf="@+id/merge_drawer_holder_image"
        app:layout_constraintTop_toBottomOf="@+id/merge_drawer_holder_image"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/ttlive_merge_drawer_small_tiltle"
        android:ellipsize="end"
        android:id="@+id/merge_drawer_holder_small_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="@+id/merge_drawer_holder_image"
        app:layout_constraintStart_toStartOf="@+id/merge_drawer_holder_image"
        app:layout_constraintTop_toBottomOf="@+id/merge_drawer_holder_big_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
