<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/larus_bg_task_mode_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingLeft="?attr/larus_dp_4"
        android:paddingRight="?attr/larus_dp_4"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/office_task_preference_close"
            android:padding="?attr/larus_dp_8"
            android:focusable="true"
            android:layout_width="?attr/larus_dp_48"
            android:layout_height="?attr/larus_dp_48"
            android:contentDescription="@string/larus_accessibility_icon_close"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="?attr/larus_ic_close_dialog"/>
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="?attr/larus_neutral_100"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_agents_md_office_task_preference_instructions_cn"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/office_task_preference_save"
            android:padding="?attr/larus_dp_8"
            android:focusable="true"
            android:layout_width="?attr/larus_dp_48"
            android:layout_height="?attr/larus_dp_48"
            android:contentDescription="@string/larus_agents_md_save_cn"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="?attr/larus_ic_input_modify_confirm"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.larus.agents.impl.ui.OfficeTaskPreferenceScrollView
        android:background="@drawable/larus_bg_office_task_instruction_editor"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_10"
        android:layout_marginRight="?attr/larus_dp_16"
        android:fillViewport="true"
        android:layout_weight="1">
        <androidx.appcompat.widget.AppCompatEditText
            android:textSize="?attr/larus_sp_15"
            android:textColor="?attr/larus_neutral_100"
            android:textColorHint="?attr/larus_neutral_50"
            android:gravity="start|top"
            android:id="@+id/office_task_preference_input"
            android:background="@null"
            android:paddingTop="?attr/larus_dp_16"
            android:paddingBottom="?attr/larus_dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/larus_agents_md_preference_instructions_placeholder_cn"
            android:inputType="textMultiLine"
            android:paddingStart="?attr/larus_dp_16"
            android:paddingEnd="?attr/larus_dp_16"/>
    </com.larus.agents.impl.ui.OfficeTaskPreferenceScrollView>
    <TextView
        android:textSize="?attr/larus_sp_12"
        android:textColor="?attr/larus_neutral_50"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/larus_dp_20"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginRight="?attr/larus_dp_20"
        android:layout_marginBottom="?attr/larus_dp_20"
        android:text="@string/larus_agents_md_extra_instructions_context_for_all_office_tasks_cn"/>
</LinearLayout>
