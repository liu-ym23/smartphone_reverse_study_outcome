<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:id="@+id/download_dialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/larus_base_3"
        app:cardCornerRadius="?attr/larus_dp_20"
        app:cardElevation="?attr/larus_dp_8"
        app:cardUseCompatPadding="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="?attr/larus_dp_128"
            android:layout_height="?attr/larus_dp_120">
            <ImageView
                android:id="@+id/cancel"
                android:layout_width="?attr/larus_dp_16"
                android:layout_height="?attr/larus_dp_16"
                android:layout_marginTop="?attr/larus_dp_12"
                android:src="@drawable/larus_ic_popup_window_close"
                android:contentDescription="@null"
                android:layout_marginEnd="?attr/larus_dp_12"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ProgressBar
                android:id="@+id/downloading"
                android:layout_width="?attr/larus_dp_30"
                android:layout_height="?attr/larus_dp_30"
                android:layout_marginTop="?attr/larus_dp_29"
                android:indeterminate="true"
                android:indeterminateDrawable="@drawable/larus_office_file_download_loading"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="?attr/larus_sp_16"
                android:textColor="@color/larus_neutral_100"
                android:id="@+id/downloading_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_5"
                android:text="@string/larus_drive_toast_downloading_s"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/downloading"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
