<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_ktv_challenge_custom_dialog"
    android:paddingBottom="15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textColor="#161823"
        android:id="@+id/target_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/ttlive_ktv_challenge_target_dialog_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#161823"
        android:id="@+id/target_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:text="@string/ttlive_ktv_challenge_cancel_confirm"
        app:layout_constraintBottom_toBottomOf="@+id/target_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/target_title"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#fe2c55"
        android:id="@+id/target_confirm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:text="@string/ttlive_ktv_challenge_confirm"
        app:layout_constraintBottom_toBottomOf="@+id/target_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/target_title"/>
    <TextView
        android:textSize="11dp"
        android:textColor="#80161823"
        android:id="@+id/target_range"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="22dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/target_title"/>
    <EditText
        android:textSize="14dp"
        android:textColor="#161823"
        android:id="@+id/target_input"
        android:background="@drawable/ttlive_bg_ktv_challenge_custom_target_input"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="16dp"
        android:hint="@string/ttlive_ktv_challenge_target_score_enter"
        android:maxLines="1"
        android:inputType="number"
        android:paddingStart="12dp"
        app:layout_constraintTop_toBottomOf="@+id/target_range"/>
</androidx.constraintlayout.widget.ConstraintLayout>
