<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_pay_set_password_layout"
    android:background="@drawable/cj_pay_bind_card_safe_white_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/set_pwd_title_layout"
        android:background="@android:color/transparent"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <ImageView
            android:id="@+id/set_pwd_title_back_view"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:src="@drawable/cj_pay_icon_left_close"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <com.android.ttcjpaysdk.bindcard.base.view.CJPayBindCardTitle
        android:id="@+id/bind_card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:layout_below="@+id/set_pwd_title_layout"/>
    <com.android.ttcjpaysdk.base.ui.component.input.PwdEditTextNoiseReduction
        android:id="@+id/cj_pay_pwd_view"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="28dp"
        android:layout_marginRight="20dp"
        android:layout_below="@+id/bind_card_title"
        app:CJPayDotRadius="6dp"
        app:CJPayPwdCount="6"
        app:CJPayPwdEditShapeStyle="CJPayRoundRectangle"
        app:CJPayStrokeColor="@color/cj_pay_color_white_F1F1F2"
        app:CJPayStrokeRadius="4dp"
        app:CJPayStrokeWidth="0dp"/>
    <TextView
        android:textSize="?attr/cj_pay_page_size_14"
        android:textColor="@color/cj_pay_color_red"
        android:gravity="center_horizontal"
        android:id="@+id/cj_pay_input_error_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_24"
        android:layout_marginTop="@dimen/cj_pay_padding_24"
        android:layout_marginRight="@dimen/cj_pay_padding_24"
        android:includeFontPadding="false"
        android:layout_below="@+id/cj_pay_pwd_view"
        android:layout_centerHorizontal="true"
        android:lineSpacingExtra="2dp"/>
    <View
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="32dp"
        android:layout_below="@+id/cj_pay_pwd_view"/>
</RelativeLayout>
