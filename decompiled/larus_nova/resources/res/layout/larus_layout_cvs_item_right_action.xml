<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="start|center_vertical"
        android:id="@+id/icon_container"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44">
        <com.larus.common_ui.widget.RedDotTextView
            android:textSize="?attr/larus_dp_13"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/message_red_dot"
            android:background="@drawable/larus_red_dot_bg"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_22"
            android:layout_height="?attr/larus_dp_22"
            android:includeFontPadding="false"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="center"
            android:id="@+id/realtime_call_icon"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            app:failureImage="?attr/larus_ic_conversation_item_phone_fill"/>
    </FrameLayout>
</merge>
