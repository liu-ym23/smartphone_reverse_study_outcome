<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/commerce_sv_anchor_v3_crossbord_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:scaleType="centerCrop"
        android:layout_marginEnd="12dp"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/commerce_sv_anchor_v3_brand_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginRight="1dp"
        android:scaleType="centerCrop"
        android:layout_marginEnd="1dp"/>
    <TextView
        android:textColor="@color/TextReverse4"
        android:id="@+id/commerce_tv_anchor_v3_brand_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/font_size_26"/>
</LinearLayout>
