<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/pinch_scale_fixed_root_view"
    android:layout_width="match_parent"
    android:layout_height="60dp">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/pinch_scale_restore_root_view"
        android:background="@drawable/pinch_scale_restore_background"
        android:layout_width="70dp"
        android:layout_height="32dp"
        android:layout_marginStart="12dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/pinch_scale_restore_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="centerCrop"/>
        <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
            android:textSize="14sp"
            android:textColor="@color/ConstTextInverse2"
            android:layout_gravity="center_vertical"
            android:id="@+id/pinch_scale_restore_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <com.bytedance.awemeopen.apps.framework.feed.pinch.ui.PinchPlayPauseView
        android:layout_gravity="center"
        android:id="@+id/play_view"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/familiar_pinch_play_btn"/>
</FrameLayout>
