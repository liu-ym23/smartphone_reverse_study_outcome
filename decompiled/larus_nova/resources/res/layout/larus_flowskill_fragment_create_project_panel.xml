<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/larus_flowskill_bg_create_project_panel"
    android:paddingBottom="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_header"
        android:paddingLeft="?attr/larus_dp_12"
        android:paddingRight="?attr/larus_dp_12"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_close"
            android:background="@drawable/larus_flowskill_bg_create_project_icon_button"
            android:padding="?attr/larus_dp_7"
            android:layout_width="?attr/larus_dp_28"
            android:layout_height="?attr/larus_dp_28"
            android:layout_marginTop="?attr/larus_dp_12"
            android:contentDescription="@string/larus_accessibility_icon_close"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/larus_flowskill_ic_create_project_close"/>
        <TextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="?attr/larus_neutral_100"
            android:id="@+id/tv_panel_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_groupChats_navBar_projects_newProject_popupTitle_createProject"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif"
            app:layout_constraintBottom_toBottomOf="@+id/iv_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_close"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_add_folder"
            android:background="@drawable/larus_flowskill_bg_create_project_icon_button"
            android:padding="?attr/larus_dp_6"
            android:layout_width="?attr/larus_dp_28"
            android:layout_height="?attr/larus_dp_28"
            android:layout_marginTop="?attr/larus_dp_12"
            android:contentDescription="@string/larus_accessibility_addFolder"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/larus_flowskill_ic_add_project_folder"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_name_input"
        android:background="@drawable/larus_flowskill_bg_create_project_input"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginRight="?attr/larus_dp_16">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_name_leading"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:layout_marginStart="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/larus_ic_side_bar_project"
            app:tint="?attr/larus_neutral_50"/>
        <EditText
            android:textSize="?attr/larus_dp_16"
            android:textColor="?attr/larus_neutral_100"
            android:textColorHint="?attr/larus_neutral_50"
            android:gravity="center_vertical"
            android:id="@+id/et_project_name"
            android:background="@null"
            android:padding="?attr/larus_dp_0"
            android:layout_width="?attr/larus_dp_0"
            android:layout_height="match_parent"
            android:hint="@string/larus_groupChats_navBar_projects_newProject_popupPlaceholder_enterName"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:fontFamily="sans-serif"
            android:layout_marginStart="?attr/larus_dp_8"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_name_leading"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_local_resource"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16">
        <TextView
            android:textSize="?attr/larus_dp_13"
            android:textColor="?attr/larus_neutral_50"
            android:id="@+id/tv_local_resource_label"
            android:paddingBottom="?attr/larus_dp_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/larus_dp_32"
            android:layout_marginRight="?attr/larus_dp_32"
            android:text="@string/larus_groupChats_navBar_projects_newProject_popupHeader_localFolder"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_folder_row"
            android:background="@drawable/larus_flowskill_bg_create_project_input"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_56"
            android:layout_marginLeft="?attr/larus_dp_16"
            android:layout_marginRight="?attr/larus_dp_16">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_folder_leading"
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"
                android:layout_marginStart="?attr/larus_dp_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/larus_flowskill_ic_add_local_resource"/>
            <TextView
                android:textSize="?attr/larus_dp_16"
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:id="@+id/tv_folder_name"
                android:layout_width="?attr/larus_dp_0"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif"
                android:layout_marginStart="?attr/larus_dp_8"
                android:layout_marginEnd="?attr/larus_dp_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/iv_folder_arrow"
                app:layout_constraintStart_toEndOf="@+id/iv_folder_leading"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_folder_arrow"
                android:layout_width="?attr/larus_dp_24"
                android:layout_height="?attr/larus_dp_24"
                android:layout_marginEnd="?attr/larus_dp_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="?attr/larus_ic_choose_local_resource"
                app:tint="?attr/larus_neutral_30"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <TextView
        android:enabled="false"
        android:textSize="?attr/larus_dp_17"
        android:textColor="?attr/larus_static_white"
        android:gravity="center"
        android:id="@+id/tv_create_action"
        android:background="?attr/larus_bg_confirm_btn_r16"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_24"
        android:layout_marginRight="?attr/larus_dp_16"
        android:text="@string/larus_groupChats_navBar_projects_newProject_popupBtn_create"
        android:alpha="0.3"
        android:fontFamily="sans-serif"/>
</LinearLayout>
