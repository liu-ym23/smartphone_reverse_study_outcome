<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ttlive_beinvited_constraintlayout"
    android:background="@color/ttlive_white"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toTopOf="parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/new_panel_info_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.livesdk.widget.VHeadView
            android:id="@+id/iv_avatar"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="26dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/view_wave"
            android:background="@drawable/ttlive_bg_anchor_link_inviter_or_applier"
            android:visibility="gone"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:layout_constraintLeft_toLeftOf="@+id/iv_avatar"
            app:layout_constraintTop_toTopOf="@+id/iv_avatar"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/anim_wave"
            android:background="@drawable/ttlive_bg_anchor_link_inviter_or_applier"
            android:visibility="gone"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="16dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_std_text_black_1"
            android:id="@+id/iv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="92dp"
            android:layout_marginTop="39dp"
            android:maxWidth="175dp"
            android:singleLine="true"
            android:textAlignment="center"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/invite_tags_container"
            android:visibility="invisible"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:layout_marginTop="2dp"
            android:maxHeight="45dp"
            android:minHeight="13dp"
            app:layout_constraintLeft_toRightOf="@+id/iv_name"
            app:layout_constraintTop_toTopOf="@+id/iv_name"/>
        <TextView
            android:textSize="11dp"
            android:gravity="center_vertical"
            android:id="@+id/invite_description_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="92dp"
            android:layout_marginTop="12dp"
            android:maxWidth="290dp"
            android:maxHeight="36dp"
            android:singleLine="false"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/invite_tags_container"/>
        <com.bytedance.android.livesdk.widget.VHeadView
            android:id="@+id/iv_gender"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginLeft="62dp"
            android:layout_marginTop="75dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_std_text_black_1"
            android:gravity="center"
            android:id="@+id/new_btn_refuse"
            android:background="@drawable/ttlive_bg_pk_feedback_another"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="122dp"
            android:layout_marginRight="4dp"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/new_btn_accept"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_std_text_white_1"
            android:gravity="center"
            android:id="@+id/new_btn_accept"
            android:background="@drawable/ttlive_bg_pk_cancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="122dp"
            android:layout_marginRight="16dp"
            android:text="@string/ttlive_anchor_link_invite_accept"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toRightOf="@+id/new_btn_refuse"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="11dp"
            android:textStyle="normal"
            android:textColor="@color/ttlive_pk_rule_text_color"
            android:gravity="center"
            android:id="@+id/private_hint_new"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/new_btn_accept"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
