<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/dialog_room_quit_layout"
    android:background="@color/ttlive_black_50"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/dialog_with_top_image"
        android:background="@color/white"
        android:layout_width="281dp"
        android:layout_height="wrap_content">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/dialog_top_image"
            android:layout_width="match_parent"
            android:layout_height="140dp"/>
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="#181823"
            android:layout_gravity="center_horizontal"
            android:id="@+id/dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/ttlive_video_float_window_dialog_title"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#bf161823"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/dialog_content"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="@string/ttlive_video_float_window_dialog_hint"/>
        <View
            android:background="#1e181823"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#181823"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/notified_action"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_dialog_notified"/>
    </LinearLayout>
</LinearLayout>
