<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sticker_tab"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/layout_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/v_left_padding"
            android:visibility="gone"
            android:layout_width="@dimen/ttlive_tabs_padding"
            android:layout_height="10dp"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_tabs_text_color"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:textAlignment="center"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/icon_right"
            android:visibility="gone"
            android:layout_width="10dp"
            android:layout_height="6dp"
            android:src="@drawable/ttlive_match_tab_chat_popup_arrow"
            android:scaleType="center"
            android:layout_marginEnd="8dp"/>
        <View
            android:id="@+id/v_right_padding"
            android:visibility="gone"
            android:layout_width="@dimen/ttlive_tabs_padding"
            android:layout_height="1dp"/>
    </LinearLayout>
    <View
        android:id="@+id/center"
        android:layout_width="1dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/tab_red_dot"
        android:background="@drawable/ttlive_match_tab_red_dot"
        android:visibility="gone"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginLeft="22dp"
        android:layout_marginStart="22dp"
        app:layout_constraintLeft_toRightOf="@+id/center"
        app:layout_constraintTop_toTopOf="@+id/layout_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>
