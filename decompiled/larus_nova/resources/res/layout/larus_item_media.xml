<?xml version="1.0" encoding="utf-8"?>
<com.larus.photopicker.v2.impl.ui.AspectRatioFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/media_image_view"
        android:background="?attr/larus_image_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:fadeDuration="10"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="#ffffff"
        android:gravity="start|center_vertical"
        android:layout_gravity="end|bottom"
        android:id="@+id/media_item_video_duration"
        android:background="@null"
        android:paddingBottom="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:shadowColor="#99000000"
        android:shadowDx="0"
        android:shadowDy="3"
        android:shadowRadius="6"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        style="@style/tools_font_size_24"/>
    <View
        android:id="@+id/media_item_shadow_view"
        android:background="@color/larus_tools_media_item_shadow"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:layout_gravity="end"
        android:id="@+id/media_item_select_indicator_container"
        android:background="@drawable/larus_tools_media_import_bg_media_select_indicator"
        android:visibility="gone"
        android:layout_width="64dp"
        android:layout_height="64dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/media_item_select_indicator_check_box"
            android:background="@drawable/larus_tools_media_import_bg_image_select"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="6dp"
            android:button="@null"
            android:layout_marginEnd="6dp"/>
    </FrameLayout>
</com.larus.photopicker.v2.impl.ui.AspectRatioFrameLayout>
