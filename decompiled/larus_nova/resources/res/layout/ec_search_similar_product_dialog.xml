<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.shopping.inflow.view.TopRoundRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_search_similar_product_dialog_1660740597"
    android:background="@color/commerce_color_FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:rounded_radius="8dp">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/ec_sv_search_similar_product_content"
        android:layout_width="match_parent"
        android:layout_height="303dp"
        android:layout_marginBottom="24dp"
        android:scaleType="centerCrop"/>
    <ImageView
        android:id="@+id/ec_iv_similar_product_dialog_close"
        android:padding="4dp"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:src="@drawable/commerce_ic_similar_product_notice_close"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="12dp"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="46dp"
        android:layout_below="@+id/ec_sv_search_similar_product_content">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/shopping_color_161823"
            android:gravity="center"
            android:id="@+id/ec_search_similar_tv_product_cancel_button"
            android:background="@drawable/ec_bg_search_similar_dialog_cancel_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_weight="1"
            android:layout_marginStart="16dp"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ec_uikit_white"
            android:gravity="center"
            android:id="@+id/ec_search_similar_tv_product_confirm_button"
            android:background="@drawable/ec_bg_search_similar_dialog_confirm_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="16dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
</com.bytedance.android.shopping.inflow.view.TopRoundRelativeLayout>
