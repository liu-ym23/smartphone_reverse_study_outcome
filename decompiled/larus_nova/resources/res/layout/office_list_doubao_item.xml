<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:foreground="?attr/selectableItemBackground"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/office_item_card"
        android:background="@color/bg_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/office_item_checkbox_container"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/office_item_checkbox"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/office_list_checkbox_selector"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/office_item_icon_container"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/office_item_checkbox_container"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/office_item_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerCrop"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ud_icon_file_doc_colorful"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/office_item_shortcut"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ud_icon_wiki_shortcutarrow_colorful"/>
        </FrameLayout>
        <com.bytedance.ee.bear.widgets.tagview.SpaceTagTitleView
            android:id="@+id/office_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toTopOf="@+id/office_item_desc"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/office_item_icon_container"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:titleColor="@color/text_title"
            app:titleMaxLines="1"
            app:titleSize="17sp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_placeholder"
            android:ellipsize="end"
            android:id="@+id/office_item_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/office_item_title"
            app:layout_constraintTop_toBottomOf="@+id/office_item_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
