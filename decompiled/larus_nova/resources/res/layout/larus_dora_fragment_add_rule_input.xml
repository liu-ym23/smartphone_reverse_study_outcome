<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:paddingTop="?attr/larus_dp_24"
    android:paddingBottom="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/title"
        android:paddingBottom="?attr/larus_dp_8"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_34"
        android:text="@string/larus_dora_broadcast_btn_add_custom_rule_cn"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_14"
        android:textStyle="normal"
        android:textColor="@color/larus_neutral_70"
        android:gravity="center"
        android:id="@+id/sub_title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_21"
        android:text="@string/larus_dora_broadcast_half_dialog_add_custom_rule_desc_cn"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/input_outer_container"
        android:layout_width="?attr/larus_dp_358"
        android:layout_height="?attr/larus_dp_166"
        android:layout_marginTop="?attr/larus_dp_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sub_title">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/input_container"
            android:background="@drawable/larus_bg_base_2_radius_16"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_140"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="?attr/larus_sp_17"
                android:textStyle="normal"
                android:textColor="@color/larus_neutral_100"
                android:textColorHint="@color/larus_neutral_50"
                android:gravity="top|left"
                android:id="@+id/rule_input"
                android:background="@null"
                android:paddingLeft="?attr/larus_dp_16"
                android:paddingTop="?attr/larus_dp_12"
                android:paddingRight="?attr/larus_dp_16"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/larus_dora_broadcast_half_dialog_add_custom_rule_placeholder_cn"
                android:maxLength="100"
                style="@style/larus_EditTextStyle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="?attr/larus_sp_12"
            android:textColor="@color/neutral_30"
            android:gravity="end|center_vertical"
            android:id="@+id/char_count"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_18"
            android:layout_marginTop="?attr/larus_dp_8_5"
            android:text="0/100"
            android:layout_marginEnd="?attr/larus_dp_10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/input_container"/>
        <TextView
            android:textSize="?attr/larus_sp_12"
            android:textColor="@color/larus_danger_50"
            android:id="@+id/error_tips"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_broadcast_toast_error_incomplete_sentence_cn"
            android:layout_marginStart="?attr/larus_dp_16"
            android:layout_marginEnd="?attr/larus_dp_8"
            app:layout_constraintBottom_toBottomOf="@+id/char_count"
            app:layout_constraintEnd_toStartOf="@+id/char_count"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/char_count"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/btn_container"
        android:layout_width="?attr/larus_dp_358"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginTop="?attr/larus_dp_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_outer_container">
        <com.larus.dora.impl.view.DoraTextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/cancel_btn"
            android:background="@drawable/larus_bg_base_2_radius_16"
            android:layout_width="?attr/larus_dp_171"
            android:layout_height="match_parent"
            android:text="@string/larus_dora_broadcast_cancel_cn"
            android:layout_marginEnd="?attr/larus_dp_16"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/generate_btn_ll"
            android:background="@drawable/larus_dora_btn_primary_bg_rule"
            android:layout_width="?attr/larus_dp_171"
            android:layout_height="match_parent">
            <ProgressBar
                android:layout_gravity="center_vertical"
                android:id="@+id/generate_btn_pb"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                android:indeterminateDrawable="@drawable/larus_dora_progressbar_loading"
                android:indeterminateDuration="750"/>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/white"
                android:layout_gravity="center_vertical"
                android:id="@+id/generate_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_broadcast_half_dialog_add_custom_rule_btn_generate_cn"
                android:layout_marginStart="?attr/larus_dp_5"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
