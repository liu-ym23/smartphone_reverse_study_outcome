<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/share_item_content"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="66dp">
    <com.larksuite.component.universe_design.checkbox.UDCheckBox
        android:id="@+id/share_checkbox"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ud_checkbox_size="small"/>
    <com.larksuite.component.universe_design.image.UDAvatar
        android:id="@+id/share_item_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_icon_usergroup"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/share_checkbox"
        app:layout_constraintTop_toTopOf="parent"
        app:ud_avatar_borderWidth="0dp"
        app:ud_avatar_size="large"
        style="@style/UDAvatar.Circle"/>
    <com.bytedance.ee.bear.facade.common.widget.CustomTitleView
        android:gravity="center_vertical"
        android:id="@+id/share_item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toTopOf="@+id/share_item_subtitle"
        app:layout_constraintLeft_toRightOf="@+id/share_item_icon"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleColor="@color/text_title"
        app:titleSize="16sp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_placeholder"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/share_item_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/share_item_icon"
        app:layout_constraintLeft_toLeftOf="@+id/share_item_name"
        app:layout_constraintRight_toRightOf="parent"/>
    <View
        android:background="@color/line_border_card"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/share_item_icon"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
