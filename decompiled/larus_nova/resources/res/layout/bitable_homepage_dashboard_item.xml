<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@color/bg_float_base"
    android:paddingTop="@dimen/dp_12"
    android:paddingBottom="@dimen/dp_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp_20"
    android:paddingEnd="@dimen/dp_20">
    <ImageView
        android:layout_width="@dimen/dp_14"
        android:layout_height="@dimen/dp_14"
        app:srcCompat="@drawable/ud_icon_burnlife_notime_outlined"
        app:tint="@color/icon_n1"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/text_title"
        android:ellipsize="end"
        android:id="@+id/hp_dashboard_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/space_radius_m"/>
    <ImageView
        android:id="@+id/hp_dashboard_expand_status"
        android:layout_width="@dimen/dp_12"
        android:layout_height="@dimen/dp_12"
        android:layout_marginStart="@dimen/dp_8"
        app:srcCompat="@drawable/bitable_homepage_dashboard_collapse_expand_arrow"
        app:tint="@color/icon_n3"/>
</LinearLayout>
