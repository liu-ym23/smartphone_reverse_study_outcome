<?xml version="1.0" encoding="utf-8"?>
<com.larus.business.markdown.impl.markwon.core.spans.codeblock.replacementspan.ui.MaxHeightLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/markdownCodeLinearLayout"
    android:background="@drawable/markdown_impl_markdown_code_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/markdownCodeHeader"
        android:paddingTop="@dimen/dp_2"
        android:paddingBottom="@dimen/dp_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/markdownCodeTitleContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_14"
            android:layout_marginEnd="@dimen/dp_4"
            android:layout_toStartOf="@+id/markdownCodePreviewButton"
            android:layout_alignParentStart="true">
            <TextView
                android:textSize="?attr/larus_dp_14"
                android:textColor="?attr/larus_neutral_70"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/markdownCodeLanguage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/markdownCodeAddedLines"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_default="wrap"/>
            <TextView
                android:textSize="?attr/larus_dp_14"
                android:textColor="?attr/larus_success_50"
                android:id="@+id/markdownCodeAddedLines"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:fontFamily="monospace"
                android:layout_marginStart="?attr/larus_dp_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/markdownCodeDeletedLines"
                app:layout_constraintStart_toEndOf="@+id/markdownCodeLanguage"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="?attr/larus_dp_14"
                android:textColor="?attr/larus_danger_50"
                android:id="@+id/markdownCodeDeletedLines"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:fontFamily="monospace"
                android:layout_marginStart="?attr/larus_dp_4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/markdownCodeAddedLines"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.larus.bmhome.chat.detail.code.view.PreviewSwitchButton
            android:id="@+id/markdownCodePreviewSwitch"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_28"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/dp_6"/>
        <ImageView
            android:id="@+id/markdownCodePreviewButton"
            android:padding="@dimen/dp_8"
            android:visibility="gone"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:layout_marginTop="@dimen/dp_2"
            android:layout_marginBottom="@dimen/dp_2"
            android:src="@drawable/markdown_impl_preview_button_large"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_4"
            android:layout_toStartOf="@+id/markdownCodeCopyButton"/>
        <ImageView
            android:id="@+id/markdownCodeCopyButton"
            android:padding="@dimen/dp_8"
            android:visibility="gone"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:layout_marginTop="@dimen/dp_2"
            android:layout_marginBottom="@dimen/dp_2"
            android:src="@drawable/markdown_impl_copy_button"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_4"
            android:layout_toStartOf="@+id/markdownCodeDownloadButton"/>
        <ImageView
            android:id="@+id/markdownCodeDownloadButton"
            android:padding="@dimen/dp_8"
            android:visibility="gone"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:layout_marginTop="@dimen/dp_2"
            android:layout_marginBottom="@dimen/dp_2"
            android:src="@drawable/markdown_impl_markdown_download_button"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_4"
            android:layout_toStartOf="@+id/markdownCodeFullscreenButton"/>
        <ImageView
            android:id="@+id/markdownCodeFullscreenButton"
            android:padding="@dimen/dp_8"
            android:visibility="gone"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:layout_marginTop="@dimen/dp_2"
            android:layout_marginBottom="@dimen/dp_2"
            android:src="@drawable/markdown_impl_fullscreen_button_large"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_4"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/codeViewSeparator"
        android:background="?attr/larus_base_2_overlay"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"/>
    <FrameLayout
        android:id="@+id/markdownPreviewContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/markdownCodeContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.larus.bmhome.view.textview.impl.CustomMarkdownTextView
            android:gravity="bottom"
            android:id="@+id/markdownCodeTextView"
            android:paddingBottom="@dimen/dp_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"/>
        <TextView
            android:textSize="@dimen/dp_15"
            android:textColor="?attr/larus_neutral_50"
            android:gravity="center_horizontal"
            android:layout_gravity="bottom"
            android:id="@+id/markdownCodeFoldDesc"
            android:background="@drawable/markdown_impl_markdown_code_mask_bg"
            android:paddingTop="?attr/larus_dp_52"
            android:paddingBottom="?attr/larus_dp_10"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</com.larus.business.markdown.impl.markwon.core.spans.codeblock.replacementspan.ui.MaxHeightLinearLayout>
