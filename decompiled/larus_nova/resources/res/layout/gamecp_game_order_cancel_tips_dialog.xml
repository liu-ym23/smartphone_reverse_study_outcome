<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/shape_bg_ffffff_corner_16"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:minHeight="144dp">
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:gravity="bottom|center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="确定要取消预约吗"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#161823"
        android:gravity="center"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="20dp"
        android:text="若取消预约，则无法收到上线通知"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="20dp"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="15sp"
                android:textColor="#bf161823"
                android:gravity="center"
                android:id="@+id/id_gamecp_order_cancel_tips_cancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="再想想"
                android:layout_weight="1"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#161823"
                android:gravity="center"
                android:id="@+id/id_gamecp_order_cancel_tips_ok"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="确定"
                android:layout_weight="1"/>
        </LinearLayout>
        <View
            android:background="@drawable/shape_bg_1f161823"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <View
            android:layout_gravity="center_horizontal"
            android:background="@drawable/shape_bg_1f161823"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
