<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?android:attr/selectableItemBackground"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?attr/larus_dp_80">
    <ImageView
        android:id="@+id/larus_drive_file_icon"
        android:layout_width="?attr/larus_dp_48"
        android:layout_height="?attr/larus_dp_48"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginBottom="?attr/larus_dp_12"
        android:src="@drawable/larus_ud_icon_file_docx_colorful"
        android:scaleType="centerInside"
        android:contentDescription="@null"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_16"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/larus_drive_file_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/larus_drive_file_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/larus_drive_file_icon"
        app:layout_constraintTop_toTopOf="@+id/larus_drive_file_icon"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/larus_neutral_50"
        android:ellipsize="end"
        android:id="@+id/larus_drive_file_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_2"
        android:maxLines="1"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="@+id/larus_drive_file_icon"
        app:layout_constraintEnd_toEndOf="@+id/larus_drive_file_name"
        app:layout_constraintStart_toStartOf="@+id/larus_drive_file_name"
        app:layout_constraintTop_toBottomOf="@+id/larus_drive_file_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
