<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.livesdk.gift.platform.business.dialog.v3.mviview.adapter.GiftRecyclerView
        android:scrollbarSize="6dp"
        android:scrollbarThumbVertical="@drawable/ttlive_scroll_bar_vertical_thumb"
        android:id="@+id/recycler_view"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/no_data_view"
        android:visibility="visible"
        android:layout_width="180dp"
        android:layout_height="120dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/no_data_desc"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttilive_gift_interact_gift_empty"
        android:alpha="0.6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/no_data_view"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/backpack_no_data_check_record"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/no_data_view">
        <TextView
            android:textSize="12dp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/backpack_no_data_check_record_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_gift_backpack_empty_check_record_text"
            app:layout_constraintEnd_toStartOf="@+id/backpack_no_data_check_record_icon"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/backpack_no_data_check_record_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/backpack_no_data_check_record_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/backpack_no_data_check_record_text"
            app:layout_constraintTop_toTopOf="@+id/backpack_no_data_check_record_text"
            app:srcCompat="@drawable/ttlive_ui_gift_backpack_check_record_arrow"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
