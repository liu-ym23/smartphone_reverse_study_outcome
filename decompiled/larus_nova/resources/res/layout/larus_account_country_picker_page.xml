<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/country_pick_close"
        android:padding="?attr/larus_dp_10"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_8"
        android:src="@drawable/larus_ic_close"
        android:layout_marginStart="?attr/larus_dp_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:id="@+id/country_pick_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_phone_select_country_region"
        app:layout_constraintBottom_toBottomOf="@+id/country_pick_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/country_pick_close"/>
    <com.larus.common_ui.search.SearchBar
        android:id="@+id/search_country"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:larus_hint_text="@string/larus_search"
        app:larus_style="full"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/country_pick_title"/>
    <com.larus.common_ui.search.SearchBar
        android:id="@+id/search_country_no_cancel"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:larus_hint_text="@string/larus_search"
        app:larus_style="simple"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/country_pick_title"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_country_code_list"
        android:background="@drawable/larus_bg_country_code"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_country"/>
    <com.larus.login.impl.SideIndexBar
        android:id="@+id/slide_index_bar"
        android:layout_width="?attr/larus_dp_30"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/rv_country_code_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/rv_country_code_list"
        app:layout_constraintTop_toTopOf="@+id/rv_country_code_list"/>
    <com.larus.login.impl.CenterTextView
        android:id="@+id/center_text_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
