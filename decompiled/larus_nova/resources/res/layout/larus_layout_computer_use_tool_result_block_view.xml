<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larus.bmhome.chat.markdown.view.DeepThinkCommonToolHeader
        android:id="@+id/common_tool_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/computer_use_tool_result_code_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginBottom="?attr/larus_dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/common_tool_header"/>
    <View
        android:id="@+id/computer_use_tool_result_cover_stub"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_140"
        android:layout_height="?attr/larus_dp_97"
        android:layout_marginTop="?attr/larus_dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/computer_use_tool_result_code_container"
        app:roundedCornerRadius="?attr/larus_dp_4"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/computer_use_tool_result_cover"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/computer_use_tool_result_cover_stub"
        app:layout_constraintEnd_toEndOf="@+id/computer_use_tool_result_cover_stub"
        app:layout_constraintStart_toStartOf="@+id/computer_use_tool_result_cover_stub"
        app:layout_constraintTop_toTopOf="@+id/computer_use_tool_result_cover_stub"
        app:placeholderImage="?attr/larus_base_3_overlay"
        app:roundedCornerRadius="?attr/larus_dp_4"/>
    <com.larus.common_ui.widget.shimmer.ShimmerMaskView
        android:id="@+id/computer_use_tool_result_cover_mask"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/computer_use_tool_result_cover"
        app:layout_constraintEnd_toEndOf="@+id/computer_use_tool_result_cover"
        app:layout_constraintStart_toStartOf="@+id/computer_use_tool_result_cover"
        app:layout_constraintTop_toTopOf="@+id/computer_use_tool_result_cover"/>
</merge>
