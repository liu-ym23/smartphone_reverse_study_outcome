<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_interact_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14dp"
        android:textColor="#80161823"
        android:gravity="center"
        android:id="@+id/hint"
        android:background="@color/ttlive_white"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/ttlive_live_interact_hint_self"/>
    <View
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="0.5px"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/silence"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_live_radio_silence"/>
    <View
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="0.5px"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/cancel_silence"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_live_radio_silence_cancel"/>
    <View
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="0.5px"/>
    <View
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/cancel"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_cancel"/>
</LinearLayout>
