<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@+id/feedback_close"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/shopping_homepage_feedback_close_6x"
        android:contentDescription="@string/shopping_mall_close_button"
        android:importantForAccessibility="yes"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/feedback_back_image"
        android:paddingLeft="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="20dp"
        android:layout_height="28dp"
        android:src="@drawable/shopping_homepage_feedback_back_icon_6x"
        android:importantForAccessibility="no"
        android:paddingStart="8dp"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/shopping_home_color_FFFFFF"
        android:gravity="center_vertical"
        android:id="@+id/feedback_back_text"
        android:paddingRight="11dp"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginLeft="4dp"
        android:text="@string/shopping_mall_back"
        android:contentDescription="@string/shopping_mall_back_button"
        android:importantForAccessibility="yes"
        android:paddingEnd="11dp"
        app:layout_constraintLeft_toRightOf="@+id/feedback_back_image"
        app:layout_constraintTop_toTopOf="@+id/feedback_back_image"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/feedback_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/feedback_find_similar_bg"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/feedback_find_similar_bg"
        android:background="#4d000000"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/shopping_home_color_FFFFFF"
        android:id="@+id/feedback_find_similar_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/shopping_mall_find_similar"
        android:includeFontPadding="false"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/feedback_find_similar_bg"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="@+id/feedback_find_similar_bg"
        app:layout_constraintRight_toLeftOf="@+id/feedback_find_similar_image"
        app:layout_constraintTop_toTopOf="@+id/feedback_find_similar_bg"/>
    <ImageView
        android:id="@+id/feedback_find_similar_image"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/shopping_homepage_feedback_arrow_right"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/feedback_find_similar_bg"
        app:layout_constraintLeft_toRightOf="@+id/feedback_find_similar_text"
        app:layout_constraintRight_toRightOf="@+id/feedback_find_similar_bg"
        app:layout_constraintTop_toTopOf="@+id/feedback_find_similar_bg"/>
</merge>
