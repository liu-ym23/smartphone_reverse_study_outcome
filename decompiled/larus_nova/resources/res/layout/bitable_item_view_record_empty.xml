<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/no_permission_layout"
    android:background="@color/bg_body"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/close"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="12dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:tint="@color/icon_n1"
            app:srcCompat="@drawable/ud_icon_left_outlined"/>
    </FrameLayout>
    <com.larksuite.component.universe_design.emptystate.UDEmptyState
        android:layout_gravity="center"
        android:id="@+id/emptyState"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ud_empty_desc="@string/Bitable_Core_RecordDeletedOrNoPerm"
        app:ud_empty_imageRes="@drawable/bitable_permission_limited_view"/>
</FrameLayout>
