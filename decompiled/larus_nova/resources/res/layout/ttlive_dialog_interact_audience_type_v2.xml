<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="152dp">
    <View
        android:id="@+id/double_talk"
        android:background="@drawable/ttlive_double_talk_bg"
        android:layout_width="0dp"
        android:layout_height="124dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="4dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/video_talk_room"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_width="100dp"
        android:layout_height="53dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/ttlive_double_talk_icon"
        app:layout_constraintLeft_toLeftOf="@+id/double_talk"
        app:layout_constraintRight_toRightOf="@+id/double_talk"
        app:layout_constraintTop_toTopOf="@+id/double_talk"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_audience_link_tips"
        android:id="@+id/tv_interact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="74dp"
        android:src="@drawable/ttlive_double_talk_icon"
        android:text="@string/ttlive_live_interact_title_audience"
        app:layout_constraintLeft_toLeftOf="@+id/double_talk"
        app:layout_constraintRight_toRightOf="@+id/double_talk"
        app:layout_constraintTop_toTopOf="@+id/double_talk"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_audience_link_small_tips"
        android:id="@+id/tv_interact_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="96dp"
        android:src="@drawable/ttlive_double_talk_icon"
        android:text="@string/ttlive_double_talk_tips"
        app:layout_constraintLeft_toLeftOf="@+id/double_talk"
        app:layout_constraintRight_toRightOf="@+id/double_talk"
        app:layout_constraintTop_toTopOf="@+id/double_talk"/>
    <View
        android:id="@+id/video_talk_room"
        android:background="@drawable/ttlive_video_talkroom_bg"
        android:layout_width="0dp"
        android:layout_height="124dp"
        android:layout_marginLeft="7dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="12dp"
        app:layout_constraintLeft_toRightOf="@+id/double_talk"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/video_talk_room_icon"
        android:layout_width="90dp"
        android:layout_height="62dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/ttlive_video_talkroom_icon"
        app:layout_constraintLeft_toLeftOf="@+id/video_talk_room"
        app:layout_constraintRight_toRightOf="@+id/video_talk_room"
        app:layout_constraintTop_toTopOf="@+id/video_talk_room"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_audience_link_tips"
        android:id="@+id/tv_video_talk_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="74dp"
        android:src="@drawable/ttlive_double_talk_icon"
        android:text="@string/ttlive_video_talk_room"
        app:layout_constraintLeft_toLeftOf="@+id/video_talk_room"
        app:layout_constraintRight_toRightOf="@+id/video_talk_room"
        app:layout_constraintTop_toTopOf="@+id/video_talk_room"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_audience_link_small_tips"
        android:id="@+id/tv_video_talk_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="96dp"
        android:src="@drawable/ttlive_double_talk_icon"
        android:text="@string/ttlive_video_talk_room_tips"
        app:layout_constraintLeft_toLeftOf="@+id/video_talk_room"
        app:layout_constraintRight_toRightOf="@+id/video_talk_room"
        app:layout_constraintTop_toTopOf="@+id/video_talk_room"/>
</androidx.constraintlayout.widget.ConstraintLayout>
