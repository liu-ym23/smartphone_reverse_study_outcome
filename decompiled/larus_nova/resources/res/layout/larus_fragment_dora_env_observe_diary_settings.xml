<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/diary_settings_icon"
                android:layout_width="?attr/larus_dp_72"
                android:layout_height="?attr/larus_dp_72"
                android:layout_marginTop="?attr/larus_dp_24"
                android:src="@drawable/larus_ic_diary_setting_logo"
                android:contentDescription="@string/larus_dora_lab_dairy_cn"/>
            <TextView
                android:textSize="?attr/larus_sp_20"
                android:textColor="?attr/larus_neutral_100"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_20"
                android:text="@string/larus_dora_personal_diary_settings_desc_1_cn"/>
            <TextView
                android:textSize="?attr/larus_sp_16"
                android:textColor="?attr/larus_neutral_70"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/diary_settings_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="?attr/larus_dp_32"
                android:layout_marginTop="?attr/larus_dp_12"
                android:layout_marginRight="?attr/larus_dp_32"
                android:text="@string/larus_dora_personal_diary_settings_desc_2_cn"/>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/diary_settings_photo_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="?attr/larus_dp_16"
                android:layout_marginTop="?attr/larus_dp_36"
                android:layout_marginRight="?attr/larus_dp_16">
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/diary_settings_insert_photo_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_personal_diary_settings_show_photos_cn"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <TextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="?attr/larus_neutral_50"
                android:id="@+id/diary_settings_insert_photo_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="?attr/larus_dp_28"
                android:layout_marginTop="?attr/larus_dp_8"
                android:layout_marginRight="?attr/larus_dp_28"
                android:text="@string/larus_dora_personal_diary_settings_show_photos_desc_cn"/>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/diary_settings_style_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="?attr/larus_dp_16"
                android:layout_marginTop="?attr/larus_dp_28"
                android:layout_marginRight="?attr/larus_dp_16">
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/diary_settings_style_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_personal_diary_cn"
                    app:larus_sub_text="@string/larus_dora_personal_diary_default_style_cn"/>
            </com.larus.bmhome.view.item.ItemGroup>
        </LinearLayout>
    </ScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>
