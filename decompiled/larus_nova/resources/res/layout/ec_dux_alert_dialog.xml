<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.ui.base.widget.round.RoundLinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        app:bg_color="@color/white"
        app:bg_cornerRadius="16dp">
        <FrameLayout
            android:id="@+id/top_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:id="@+id/view_title_top_place_holder"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="24dp"/>
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="@color/ec_dux_black_161823"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <FrameLayout
            android:id="@+id/fl_content"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:visibility="gone"
            android:clipToPadding="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedance.android.ui.base.widget.scroll.MaxHeightScrollView
                android:id="@+id/scroll_view"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                app:scroll_view_max_height="284dp">
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/ec_dux_black_161823_75"
                    android:gravity="center"
                    android:id="@+id/tv_message"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.2"/>
            </com.bytedance.android.ui.base.widget.scroll.MaxHeightScrollView>
            <com.bytedance.android.ui.base.widget.round.RoundView
                android:layout_gravity="bottom"
                android:id="@+id/view_forground"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                app:bg_colorOrientation="t2b"
                app:bg_endColor="@color/white"
                app:bg_startColor="@color/white_0"/>
        </FrameLayout>
        <View
            android:id="@+id/view_divider_1"
            android:background="@color/ec_dux_black_161823_15"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <LinearLayout
            android:id="@+id/ll_button"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="47.5dp">
            <com.bytedance.android.ui.ec.widget.button.ECButton
                android:textSize="15dp"
                android:textColor="@color/ec_dux_black_161823_75"
                android:gravity="center"
                android:id="@+id/tv_cancel"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/ec_cancel"
                android:maxLines="1"
                android:layout_weight="1"
                app:foreground_tint="@color/ui_ec_bg_btn_foreground"/>
            <View
                android:id="@+id/view_divider"
                android:background="@color/ec_dux_black_161823_15"
                android:visibility="gone"
                android:layout_width="0.5dp"
                android:layout_height="match_parent"/>
            <com.bytedance.android.ui.ec.widget.button.ECButton
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="@color/ec_dux_black_161823"
                android:gravity="center"
                android:id="@+id/tv_confirm"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/ec_confirm"
                android:maxLines="1"
                android:layout_weight="1"
                app:foreground_tint="@color/ui_ec_bg_btn_foreground"/>
        </LinearLayout>
    </com.bytedance.android.ui.base.widget.round.RoundLinearLayout>
</FrameLayout>
