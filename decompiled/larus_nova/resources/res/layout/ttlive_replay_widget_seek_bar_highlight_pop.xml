<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="67dp">
    <View
        android:id="@+id/high_light_background"
        android:background="@drawable/ttlive_replay_bg_high_light_pop"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="@+id/hold"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/high_light_arrow"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="36dp"
        android:layout_height="7dp"
        android:src="@drawable/ttlive_replay_high_light_pop_arrow"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/high_light_background"/>
    <com.bytedance.android.livesdk.chatroom.ui.LiveRoundDraweeImageView
        android:id="@+id/high_light_image"
        android:layout_width="75dp"
        android:layout_height="44dp"
        android:layout_marginLeft="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/high_light_background"
        app:layout_constraintLeft_toLeftOf="@+id/high_light_background"
        app:layout_constraintTop_toTopOf="@+id/high_light_background"
        app:ttlive_radius="4dp"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/high_light_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:maxWidth="170dp"
        android:lines="2"
        app:layout_constraintBottom_toBottomOf="@+id/high_light_background"
        app:layout_constraintLeft_toRightOf="@+id/high_light_image"
        app:layout_constraintTop_toTopOf="@+id/high_light_background"
        app:layout_goneMarginLeft="17dp"/>
    <View
        android:id="@+id/hold"
        android:layout_width="17dp"
        android:layout_height="0dp"
        app:layout_constraintLeft_toRightOf="@+id/high_light_text"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
