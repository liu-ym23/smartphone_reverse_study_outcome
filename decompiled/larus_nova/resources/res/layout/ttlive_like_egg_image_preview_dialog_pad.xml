<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/click_outside"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/dialog_root"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/dialog_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/dialog_background"
        android:background="@drawable/ttlive_like_egg_dialog_root"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/dialog_root"
        app:layout_constraintEnd_toEndOf="@+id/dialog_root"
        app:layout_constraintStart_toStartOf="@+id/dialog_root"
        app:layout_constraintTop_toTopOf="@+id/dialog_root"
        app:roundBottomLeft="true"
        app:roundBottomRight="true"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="8dp"/>
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/ttlive_like_egg_preview_dialog_title"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@+id/dialog_root"
        app:layout_constraintTop_toTopOf="@+id/dialog_root"/>
    <ImageView
        android:id="@+id/btn_close"
        android:background="@drawable/ttlive_like_egg_image_picker_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="@+id/dialog_root"
        app:layout_constraintTop_toTopOf="@+id/dialog_root"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/image_preview_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="68dp"
        android:layout_marginBottom="108dp"
        app:layout_constraintBottom_toBottomOf="@+id/dialog_root"
        app:layout_constraintStart_toStartOf="@+id/dialog_root"
        app:layout_constraintTop_toTopOf="@+id/dialog_root"/>
    <ImageView
        android:background="@drawable/ttlive_like_egg_template_source"
        android:layout_width="33dp"
        android:layout_height="12dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/image_save_button"
        app:layout_constraintStart_toStartOf="@+id/dialog_root"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#80ffffff"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/template_author"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginBottom="16dp"
        android:maxEms="12"
        android:singleLine="true"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/image_pick_button"
        app:layout_constraintEnd_toEndOf="@+id/dialog_root"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/image_save_button"
        android:background="@drawable/ttlive_like_egg_button_bg_grey"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginBottom="16dp"
        android:text="@string/ttlive_like_egg_image_save_button"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/dialog_root"
        app:layout_constraintEnd_toStartOf="@+id/image_pick_button"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="@+id/dialog_root"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/image_pick_button"
        android:background="@drawable/ttlive_like_egg_button_bg_magenta"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginBottom="16dp"
        android:text="@string/ttlive_like_egg_image_pick_button"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/dialog_root"
        app:layout_constraintEnd_toEndOf="@+id/dialog_root"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/image_save_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>
