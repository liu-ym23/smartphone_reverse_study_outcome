<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/larus_bg_bottom_sheet"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_close"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_44"
                android:layout_marginTop="?attr/larus_dp_16"
                android:src="@drawable/larus_icon_dialog_close_v2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/iv_icon"
                android:layout_width="?attr/larus_dp_80"
                android:layout_height="?attr/larus_dp_80"
                android:layout_marginTop="?attr/larus_dp_32"
                android:src="@drawable/larus_icon_dialog_v2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="?attr/larus_dp_22"
                android:textColor="@color/larus_neutral_100"
                android:gravity="center_horizontal"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_20"
                android:text="@string/larus_visibility_double_check_title_2"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_icon"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/privacy_container"
            android:background="@drawable/larus_bg_permission_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_20">
            <com.larus.bot.impl.feature.edit.view.BotAccessPermissionItem
                android:id="@+id/i_public"
                android:background="@drawable/larus_bg_bot_access_permission_dialog_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/larus_dp_56"
                android:text="@string/larus_option_public"
                app:larus_item_icon_src="@drawable/larus_icon_bot_permission_public_v3"
                app:larus_item_selected="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/i_public_div"
                android:background="@color/larus_neutral_transparent_2"
                android:layout_width="?attr/larus_dp_306"
                android:layout_height="0.5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/i_public"/>
            <com.larus.bot.impl.feature.edit.view.BotAccessPermissionItem
                android:id="@+id/i_unfind"
                android:background="@drawable/larus_bg_bot_access_permission_dialog_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/larus_dp_56"
                android:text="@string/larus_unlisted"
                app:larus_item_icon_src="@drawable/larus_icon_bot_permission_unfind_v3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/i_public_div"/>
            <View
                android:id="@+id/i_unfind_div"
                android:background="@color/larus_neutral_transparent_2"
                android:layout_width="?attr/larus_dp_306"
                android:layout_height="0.5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/i_unfind"/>
            <com.larus.bot.impl.feature.edit.view.BotAccessPermissionItem
                android:id="@+id/i_private"
                android:background="@drawable/larus_bg_bot_access_permission_dialog_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/larus_dp_56"
                android:text="@string/larus_option_private"
                app:larus_item_icon_src="@drawable/larus_icon_bot_permission_private_v3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/i_unfind_div"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="@color/larus_neutral_50"
            android:gravity="center_horizontal"
            android:id="@+id/bottom_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_20"
            android:text="@string/larus_visibility_double_check_tip"/>
        <TextView
            android:textSize="?attr/larus_dp_17"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/confirm_btn"
            android:background="@drawable/larus_bg_confirm_btn_r16"
            android:paddingTop="?attr/larus_dp_16"
            android:paddingBottom="?attr/larus_dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_24"
            android:layout_marginBottom="?attr/larus_dp_8"
            android:text="@string/larus_report_select_done"
            app:layout_constraintBottom_toTopOf="@+id/create_quota"/>
    </LinearLayout>
</ScrollView>
