<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ScrollView
        android:id="@+id/scroll_view"
        android:paddingTop="?attr/larus_dp_8"
        android:paddingBottom="?attr/larus_dp_8"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="?attr/larus_dp_12"
        android:paddingEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="?attr/larus_dp_56"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/dora_device_item"
                android:layout_width="?attr/larus_dp_214"
                android:layout_height="?attr/larus_dp_178"
                android:layout_marginTop="?attr/larus_dp_8"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/larus_neutral_50"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_10"
                android:layout_marginBottom="?attr/larus_dp_26"
                android:text="@string/larus_dora_gesture_touch_area_cn"/>
            <com.larus.bmhome.view.item.ItemGroupTitle
                android:id="@+id/dora_gesture_wakeup_group_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_wakeup_gesture_title_cn"/>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_gesture_wakeup_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="?attr/larus_dp_24">
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/dora_gesture_wakeup_left"
                    android:background="@drawable/larus_bg_item_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_long_press_left_cn"/>
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/dora_gesture_wakeup_right"
                    android:background="@drawable/larus_bg_item_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_long_press_right_cn"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.bmhome.view.item.ItemGroupTitle
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_gesture_media_cn"/>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_gesture_media_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="?attr/larus_dp_24">
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/dora_gesture_media_left_ear"
                    android:background="@drawable/larus_bg_item_selector_first"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_gesture_double_click_left_cn"/>
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/dora_gesture_media_right_ear"
                    android:background="@drawable/larus_bg_item_selector_last"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_gesture_double_click_right_cn"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.bmhome.view.item.ItemGroupTitle
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_gesture_calling_cn"/>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/dora_gesture_calling_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/dora_gesture_calling_left_ear"
                    android:background="@drawable/larus_bg_item_selector_first"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_gesture_double_click_left_cn"/>
                <com.larus.bmhome.view.item.ItemTextArrow
                    android:id="@+id/dora_gesture_calling_right_ear"
                    android:background="@drawable/larus_bg_item_selector_last"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_gesture_double_click_right_cn"/>
            </com.larus.bmhome.view.item.ItemGroup>
        </LinearLayout>
    </ScrollView>
    <View
        android:id="@+id/dora_page_mask"
        android:background="@color/larus_dora_page_mask_color"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
