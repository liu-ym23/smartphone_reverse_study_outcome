<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:id="@+id/action_item"
    android:background="?attr/larus_bg_sug_bar"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/action_single_selected_button"
        android:padding="?attr/larus_dp_7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.lynx.lottieadapter.LottieAdapterView
            android:id="@+id/action_button_lottie"
            android:layout_width="?attr/larus_dp_22"
            android:layout_height="?attr/larus_dp_22"
            android:scaleType="centerInside"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/action_button_icon"
            android:layout_width="?attr/larus_dp_22"
            android:layout_height="?attr/larus_dp_22"
            android:scaleType="centerInside"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/action_url_icon"
            android:layout_width="?attr/larus_dp_22"
            android:layout_height="?attr/larus_dp_22"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_16"
            android:textColor="?attr/larus_primary_50"
            android:id="@+id/action_button_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_regenerate_better"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_4"
            android:layout_marginEnd="?attr/larus_dp_3"/>
    </LinearLayout>
</merge>
