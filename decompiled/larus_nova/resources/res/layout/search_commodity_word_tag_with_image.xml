<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <com.bytedance.lighten.loader.SmartImageView
        android:id="@+id/item_cover"
        android:background="@color/BGInput2"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:actualImageScaleType="focusCrop"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundBottomLeft="true"
        app:roundBottomRight="true"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="4dp"/>
    <com.bytedance.ies.dmt.ui.widget.DmtTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/TextPrimary"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_word"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:maxLines="1"
        android:drawableRight="@drawable/search_commodity_related_search_arrow_list"
        android:lineSpacingExtra="2sp"
        android:drawableEnd="@drawable/search_commodity_related_search_arrow_list"
        android:layout_marginStart="12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/item_cover"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
