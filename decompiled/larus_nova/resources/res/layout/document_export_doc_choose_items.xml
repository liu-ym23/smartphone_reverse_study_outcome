<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/document_doc_choose_layout"
    android:paddingTop="16dp"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <HorizontalScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/export_type_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.bytedance.ee.bear.document.export.view.FileExportTypeItemView
                android:id="@+id/export_item_word"
                android:layout_width="96dp"
                android:layout_height="match_parent"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="8dp"/>
            <com.bytedance.ee.bear.document.export.view.FileExportTypeItemView
                android:id="@+id/export_item_pdf"
                android:layout_width="96dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"/>
            <com.bytedance.ee.bear.document.export.view.FileExportTypeItemView
                android:id="@+id/export_item_image"
                android:layout_width="96dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"/>
            <com.bytedance.ee.bear.document.export.view.FileExportTypeItemView
                android:id="@+id/export_item_markdown"
                android:visibility="gone"
                android:layout_width="96dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"/>
            <com.bytedance.ee.bear.document.export.view.FileExportTypeItemView
                android:id="@+id/export_item_txt"
                android:visibility="gone"
                android:layout_width="96dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="15dp"/>
        </LinearLayout>
    </HorizontalScrollView>
    <TextView
        android:textSize="17sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/export_confirm_button"
        android:background="@drawable/document_export_primary_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:text="@string/Doc_BizWidget_Export"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
</LinearLayout>
