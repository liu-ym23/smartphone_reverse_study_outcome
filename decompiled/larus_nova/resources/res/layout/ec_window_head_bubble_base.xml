<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.window.shop.widget.WindowHeadBubbleBaseCard xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ec_window_bubble_background"
    android:layout_width="106dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12dp"
        android:textColor="@color/commerce_color_BF161823"
        android:ellipsize="end"
        android:id="@+id/ec_window_head_bubble_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="6dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ec_window_head_bubble_cover"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/ec_window_head_bubble_cover"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:roundBottomLeft="false"
        app:roundBottomRight="false"
        app:roundedCornerRadius="10dp"
        app:viewAspectRatio="1"/>
    <View
        android:background="@color/commerce_color_08161823"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/ec_window_head_bubble_cover"
        app:layout_constraintLeft_toLeftOf="@+id/ec_window_head_bubble_cover"
        app:layout_constraintRight_toRightOf="@+id/ec_window_head_bubble_cover"
        app:layout_constraintTop_toTopOf="@+id/ec_window_head_bubble_cover"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/ec_window_head_bubble_just_watched"
        android:background="@drawable/shape_shopping_window_just_watched_thri_background"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ec_window_just_watched"
        app:layout_constraintBottom_toBottomOf="@+id/ec_window_head_bubble_head_icon"
        app:layout_constraintLeft_toRightOf="@+id/ec_window_head_bubble_just_watched_space"
        app:layout_constraintTop_toTopOf="@+id/ec_window_head_bubble_head_icon"/>
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/ec_window_head_bubble_head_icon"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        app:layoutMode="width_self_adjust"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/ec_window_head_bubble_just_watched_space"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="9dp"
        app:layout_constraintBottom_toBottomOf="@+id/ec_window_head_bubble_head_icon"
        app:layout_constraintRight_toRightOf="@+id/ec_window_head_bubble_head_icon"
        app:layout_constraintTop_toTopOf="@+id/ec_window_head_bubble_head_icon"/>
</com.bytedance.android.window.shop.widget.WindowHeadBubbleBaseCard>
