<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.locallife.dito.baseview.RoundFrameLayout
        android:id="@+id/ditoBackgroundContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ditoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/ditoHeaderGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/dito_coordinator_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <FrameLayout
                android:id="@+id/ditoCoordinatorContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.bytedance.locallife.dito.baseview.RoundFrameLayout
                    android:id="@+id/ditoListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ViewStub
                        android:id="@+id/vs_dito_list"
                        android:layout="@layout/dito_list_v1_saas"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </com.bytedance.locallife.dito.baseview.RoundFrameLayout>
                <com.bytedance.locallife.dito.baseview.DitoStickLayout
                    android:id="@+id/ditoStickContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/ditoLoadingContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_anchor="@+id/ditoCoordinatorContainer"
                app:layout_anchorGravity="center"/>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
        <FrameLayout
            android:id="@+id/ditoFooterGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/ditoBackContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/ditoFloatContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
