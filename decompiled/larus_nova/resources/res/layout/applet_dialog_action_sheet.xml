<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/applet_action_sheet_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/applet_action_sheet_panel"
        android:background="@drawable/bg_applet_share_sheet"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/dp_16">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/applet_action_sheet_header_container"
            android:paddingTop="@dimen/dp_16"
            android:paddingBottom="@dimen/dp_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp_20"
            android:paddingEnd="@dimen/dp_12">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/applet_action_sheet_icon"
                android:background="@drawable/bg_applet_share_sheet_app_icon"
                android:layout_width="@dimen/dp_48"
                android:layout_height="@dimen/dp_48"
                app:actualImageScaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/applet_action_sheet_title_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                android:layout_marginEnd="@dimen/dp_16"
                app:layout_constraintBottom_toBottomOf="@+id/applet_action_sheet_icon"
                app:layout_constraintEnd_toStartOf="@+id/applet_action_sheet_close"
                app:layout_constraintStart_toEndOf="@+id/applet_action_sheet_icon"
                app:layout_constraintTop_toTopOf="@+id/applet_action_sheet_icon">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/applet_action_sheet_title_color"
                        android:ellipsize="end"
                        android:id="@+id/applet_action_sheet_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:layout_weight="1"/>
                    <ImageView
                        android:id="@+id/applet_action_sheet_chevron"
                        android:visibility="gone"
                        android:clickable="false"
                        android:layout_width="@dimen/dp_12"
                        android:layout_height="@dimen/dp_12"
                        android:src="@drawable/ic_applet_chevron_right_12"
                        android:layout_marginStart="@dimen/dp_2"
                        app:tint="@color/applet_action_sheet_title_color"/>
                </LinearLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/applet_action_sheet_subtitle_color"
                    android:ellipsize="end"
                    android:id="@+id/applet_action_sheet_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:maxLines="1"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/applet_action_sheet_close"
                android:background="@drawable/bg_applet_action_sheet_close"
                android:layout_width="@dimen/dp_30"
                android:layout_height="@dimen/dp_30"
                android:src="@drawable/ic_applet_close"
                android:scaleType="centerInside"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/applet_action_sheet_close_icon_tint"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/applet_action_sheet_header_divider"
            android:background="@color/applet_action_sheet_divider_color"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/applet_action_sheet_menu_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginBottom="@dimen/dp_12">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/applet_action_sheet_menu_list_row1"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_12"
                android:overScrollMode="never"
                android:paddingStart="@dimen/dp_8"
                android:paddingEnd="@dimen/dp_8"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/applet_action_sheet_menu_list_row2"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_12"
                android:overScrollMode="never"
                android:paddingStart="@dimen/dp_8"
                android:paddingEnd="@dimen/dp_8"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
