<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/recycler_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0"
        android:layout_marginLeft="?attr/larus_dp_12"
        android:layout_marginRight="?attr/larus_dp_12"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <View
        android:id="@+id/create_ugc_voice_btn"
        android:background="?attr/larus_bg_create_ugc_voice_btn"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_176"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginBottom="?attr/larus_dp_50"
        android:contentDescription="@string/larus_create_my_voice"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/create_ugc_voice_btn_icon"
        android:padding="?attr/larus_dp_6"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_32"
        android:layout_height="?attr/larus_dp_32"
        app:layout_constraintBottom_toBottomOf="@+id/create_ugc_voice_btn"
        app:layout_constraintEnd_toStartOf="@+id/create_ugc_voice_btn_text"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/create_ugc_voice_btn"
        app:layout_constraintTop_toTopOf="@+id/create_ugc_voice_btn"
        app:srcCompat="@drawable/larus_ic_voice_clone"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_16"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:id="@+id/create_ugc_voice_btn_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_create_my_voice"
        app:layout_constraintBottom_toBottomOf="@+id/create_ugc_voice_btn_icon"
        app:layout_constraintEnd_toEndOf="@+id/create_ugc_voice_btn"
        app:layout_constraintStart_toEndOf="@+id/create_ugc_voice_btn_icon"
        app:layout_constraintTop_toTopOf="@+id/create_ugc_voice_btn_icon"/>
    <View
        android:id="@+id/create_btn_mask"
        android:background="?attr/larus_base_1_overlay"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/create_bot_btn"/>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textStyle="bold"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/create_bot_btn"
        android:background="?attr/larus_bg_confirm_btn_r16"
        android:paddingTop="?attr/larus_dp_16"
        android:paddingBottom="?attr/larus_dp_16"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:text="@string/larus_create_bot_button"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
