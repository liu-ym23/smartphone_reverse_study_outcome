<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="80dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/dora_g_env_observe_wifi_scan_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.larus.dora.impl.view.DoraTextView
                android:textColor="@color/larus_neutral_70"
                android:gravity="center"
                android:id="@+id/dora_g_env_observe_wifi_scan_cancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="取消"
                android:layout_weight="1"
                android:textAlignment="center"/>
            <com.larus.dora.impl.view.DoraTextView
                android:textColor="@color/larus_neutral_70"
                android:gravity="center"
                android:id="@+id/dora_g_env_observe_wifi_scan_confirm"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="同意"
                android:layout_weight="1"
                android:textAlignment="center"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/dora_g_env_observe_wifi_scan_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dora_g_env_observe_wifi_scan_top">
        <ImageView
            android:id="@+id/dora_g_env_observe_wifi_scan_retry"
            android:layout_width="?attr/larus_dp_32"
            android:layout_height="?attr/larus_dp_32"
            android:src="@drawable/larus_retry_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <com.larus.dora.impl.view.DoraTextView
            android:textColor="@color/larus_neutral_70"
            android:gravity="center"
            android:id="@+id/dora_g_env_observe_wifi_scan_none_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_8"
            android:text="附近无可用 WiFi"
            android:layout_weight="1"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dora_g_env_observe_wifi_scan_retry"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
