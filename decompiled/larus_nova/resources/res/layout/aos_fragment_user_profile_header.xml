<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/user_info_cl"
    android:paddingTop="88dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toTopOf="parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/profile_header_linear_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="33dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/header_frameLayout"
            android:layout_width="88dp"
            android:layout_height="88dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.awemeopen.infra.base.image.AoImageView
                android:layout_gravity="center"
                android:id="@+id/header_image"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:scaleType="centerCrop"/>
            <View
                android:layout_gravity="center"
                android:id="@+id/header_normal_border"
                android:background="@drawable/aos_profile_normal_bg"
                android:layout_width="80dp"
                android:layout_height="80dp"/>
            <FrameLayout
                android:id="@+id/header_livehead_border"
                android:visibility="invisible"
                android:layout_width="88dp"
                android:layout_height="85dp">
                <View
                    android:background="@drawable/aos_profile_livehead_bg"
                    android:layout_width="88dp"
                    android:layout_height="88dp"/>
                <FrameLayout
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="@drawable/aos_profile_livehead_tag"
                    android:layout_width="64dp"
                    android:layout_height="20dp">
                    <com.bytedance.awemeopen.infra.base.anim.lottie.AoAnimationLottieView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/header_livehead_anim"
                        android:layout_width="9dp"
                        android:layout_height="11dp"
                        android:layout_marginStart="9dp"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="#ffffff"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="直播中"
                        android:layout_marginStart="22dp"/>
                </FrameLayout>
            </FrameLayout>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="88dp"
            android:layout_marginStart="12dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/aos_s1"
                    android:ellipsize="end"
                    android:id="@+id/user_name_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"/>
                <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                    android:textSize="12sp"
                    android:textColor="@color/aos_uikit_t_primary_dark"
                    android:gravity="center"
                    android:id="@+id/user_verify_type_tv"
                    android:background="@drawable/aos_douyin_verify_bg"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/aos_douyin_verify"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/user_profile_verify_ll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                    android:textSize="12sp"
                    android:textColor="@color/aos_uikit_t_inverse_light"
                    android:ellipsize="end"
                    android:id="@+id/user_verify_tv"
                    android:layout_width="227dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:layout_marginStart="2dp"/>
            </LinearLayout>
            <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                android:textSize="12sp"
                android:textColor="@color/aos_uikit_t_inverse_light"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/benefit_info_tv"
                android:layout_width="227dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:layout_marginStart="2dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/user_profile_verify_ll"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/aos_feed_profile_header_panel_shape"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_header_linear_layout">
        <include
            android:id="@+id/profile_user_relation_layout_beside_avatar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            layout="@layout/aos_profile_viewstub_profile_head_user_ralation_layout"/>
        <com.bytedance.awemeopen.apps.framework.base.view.ProfileSignatureView
            android:textSize="14sp"
            android:textColor="@color/aos_text_primary"
            android:gravity="left"
            android:id="@+id/user_desc_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:maxLines="4"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <HorizontalScrollView
            android:id="@+id/user_tags_sl"
            android:scrollbars="none"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fadeScrollbars="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/user_tags_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </HorizontalScrollView>
        <HorizontalScrollView
            android:id="@+id/user_card_entries_sl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/user_card_entries_ll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </HorizontalScrollView>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/profile_follow_cl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="10dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/profile_btn_follow_ll"
                android:background="@drawable/aos_profile_bg_red_full_rectangular_with_padding"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/profile_btn_follow_add_iv"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/aos_ic_s_s_plus_outlined_16"
                    android:layout_marginEnd="4dp"/>
                <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                    android:textColor="@color/aos_const_text_inverse"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/profile_btn_follow_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/aos_follow"
                    android:maxLines="1"
                    android:drawablePadding="4dp"
                    style="@style/font_size_30"/>
            </LinearLayout>
            <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                android:textSize="15sp"
                android:textColor="@color/aos_uikit_t_primary_light"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/profile_btn_im_tv"
                android:background="@drawable/aos_profile_bg_black_full_rectangular_with_padding"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                app:layout_constraintEnd_toEndOf="@+id/profile_follow_cl"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
