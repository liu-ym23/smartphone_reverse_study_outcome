<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/cj_pay_color_120c18"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/cj_unify_pay_homepage_bg"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/cj_pay_bg_dark_colored"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"/>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/cj_unify_pay_homepage_bg_logo"
        android:visibility="gone"
        android:layout_width="211dp"
        android:layout_height="211dp"
        android:layout_marginTop="0dp"
        android:src="@drawable/cj_unify_o_bg_logo_icon"
        android:scaleType="fitCenter"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:layout_marginEnd="0dp"/>
</FrameLayout>
