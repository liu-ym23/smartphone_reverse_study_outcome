<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/linear_top_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.android.live.core.widget.LiveTextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/ttlive_top_desc_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="16dp"
            android:text="@string/ttlive_recommend_top_desc_tv_prima_tips"
            android:maxLines="2"/>
        <RelativeLayout
            android:id="@+id/relative_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">
            <com.bytedance.android.live.core.widget.LiveTextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/drag_down_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/ttlive_recommend_top_desc_tv_second_tips"
                android:lines="1"
                android:layout_alignParentTop="true"
                android:alpha="0"/>
            <ImageView
                android:id="@+id/image_arrow_down"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ttlive_follow_empty_recommend_down_arrow"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </LinearLayout>
    <View
        android:background="@color/ttlive_transparent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/linear_bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/relative_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <ImageView
                android:id="@+id/image_arrow_up"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ttlive_follow_empty_recommend_up_arrow"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"/>
            <com.bytedance.android.live.core.widget.LiveTextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/swipe_up_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/ttlive_recommend_bottom_desc_tv_second_tips"
                android:lines="1"
                android:layout_alignParentBottom="true"
                android:alpha="0"/>
        </RelativeLayout>
        <com.bytedance.android.live.core.widget.LiveTextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/ttlive_bottom_desc_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="20dp"
            android:text="@string/ttlive_recommend_bottom_desc_tv_prima_tips"
            android:maxLines="2"/>
    </LinearLayout>
</LinearLayout>
