<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/cj_pay_payment_complete_root_view"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/rl_root"
        android:background="@drawable/cj_pay_bg_fragment_container_gray"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.android.ttcjpaysdk.base.theme.widget.CJPayFlexibleRoundCornerImageView
            android:id="@+id/iv_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            app:CJPayCorners="CJPay_TOP_RIGHT|CJPay_TOP_LEFT"
            app:CJPayCornersRadius="20dp"/>
        <RelativeLayout
            android:id="@+id/layout_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true">
            <RelativeLayout
                android:id="@+id/layout_titlebar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:gravity="center"
                    android:id="@+id/tv_right_top"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginRight="16dp"
                    android:layout_alignParentRight="true"
                    android:layout_marginEnd="16dp"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <ImageView
                android:id="@+id/iv_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="28dp"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_below="@+id/iv_icon"
                android:layout_centerHorizontal="true"/>
            <RelativeLayout
                android:gravity="center_horizontal"
                android:id="@+id/layout_total_value"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_below="@+id/tv_status">
                <TextView
                    android:textSize="40sp"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:id="@+id/cj_pay_total_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.05"/>
                <TextView
                    android:textSize="28sp"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:id="@+id/cj_pay_total_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="2dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/cj_pay_currency_unit"
                    android:layout_toLeftOf="@+id/cj_pay_total_value"
                    android:layout_alignBottom="@+id/cj_pay_total_value"
                    android:layout_marginEnd="2dp"
                    android:layout_toStartOf="@+id/cj_pay_total_value"/>
            </RelativeLayout>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cj_pay_color_orange_FF6E26"
                android:ellipsize="end"
                android:id="@+id/tv_discount_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_below="@+id/layout_total_value"
                android:layout_centerHorizontal="true"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_detail_info"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:layout_below="@+id/tv_discount_info"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_lynx_card"
            android:layout_width="match_parent"
            android:layout_height="155dp"
            android:layout_marginTop="16dp"
            android:layout_below="@+id/layout_top"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_bottom"
            android:background="@color/cj_pay_color_gray_248"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/layout_lynx_card">
            <TextView
                android:textSize="11dp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_34"
                android:gravity="center"
                android:id="@+id/bottom_guide_info"
                android:background="@drawable/cj_pay_bg_gray_border_radius_8"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="16dp"/>
            <Button
                android:textSize="15sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/btn_bottom"
                android:background="@drawable/cj_pay_bg_round_corner_btn_radius_8"
                android:visibility="gone"
                android:layout_width="160dp"
                android:layout_height="42dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>
            <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
                android:id="@+id/bottom_insurance_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:layout_alignParentBottom="true"/>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
