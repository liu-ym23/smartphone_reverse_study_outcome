<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/multi_pro_card_container"
    android:background="@drawable/commerce_bg_multi_pro_card"
    android:layout_width="257dp"
    android:layout_height="88dp">
    <com.bytedance.awemeopen.infra.base.image.AoImageView
        android:id="@+id/pro_image"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="6dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="8dp">
        <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/aos_commerce_color_FF161823"
            android:ellipsize="end"
            android:id="@+id/pro_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/market_exp_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pro_title">
            <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                android:textSize="12dp"
                android:textColor="@color/aos_commerce_color_73161823"
                android:ellipsize="end"
                android:id="@+id/pro_discount"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/discount_timeliness_delimiter"
                android:background="@drawable/aos_commerce_bg_multi_pro_delimiter"
                android:visibility="gone"
                android:layout_width="0.5dp"
                android:layout_height="12dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"/>
            <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                android:textSize="12dp"
                android:textColor="@color/aos_commerce_color_73161823"
                android:ellipsize="end"
                android:id="@+id/pro_timeliness"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent">
            <com.bytedance.awemeopen.bizmodels.feed.shopping.card.widget.ECMultiProCardPriceContainer
                android:orientation="horizontal"
                android:id="@+id/price_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp">
                <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                    android:textSize="15dp"
                    android:textStyle="bold"
                    android:textColor="@color/aos_commerce_color_FF1C49"
                    android:id="@+id/pro_price_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/aos_chinese_yuan"
                    android:maxLines="1"/>
                <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                    android:textSize="18dp"
                    android:textStyle="bold"
                    android:textColor="@color/aos_commerce_color_FF1C49"
                    android:id="@+id/pro_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
                <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                    android:textSize="12dp"
                    android:textColor="@color/aos_commerce_color_FF3344"
                    android:id="@+id/pro_price_suffix"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginStart="2dp"/>
                <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                    android:textSize="12dp"
                    android:textColor="@color/aos_commerce_color_FF3344"
                    android:ellipsize="end"
                    android:id="@+id/tt_coupon_text"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginStart="4dp"/>
                <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                    android:textSize="12dp"
                    android:textColor="@color/aos_commerce_color_FF3344"
                    android:id="@+id/pro_price_desc"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginStart="4dp"/>
            </com.bytedance.awemeopen.bizmodels.feed.shopping.card.widget.ECMultiProCardPriceContainer>
            <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="@color/aos_commerce_color_FFFFFF"
                android:gravity="center"
                android:id="@+id/btn_buy"
                android:background="@drawable/commerce_bg_multi_pro_buy"
                android:layout_width="48dp"
                android:layout_height="24dp"
                android:text="@string/aos_commerce_buy"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
