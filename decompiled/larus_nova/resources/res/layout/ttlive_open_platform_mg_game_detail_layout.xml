<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_minigame_bottom_dialog"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/head_img"
        android:layout_width="match_parent"
        android:layout_height="188dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_preview_mg_bottom_dialog_bg"
        app:placeholderImageScaleType="fitXY"
        app:roundBottomLeft="false"
        app:roundBottomRight="false"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="12dp"/>
    <ImageView
        android:id="@+id/close_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:layout_marginRight="12dp"
        android:src="@drawable/ttlive_open_platform_mg_close_detail"
        android:layout_marginEnd="12dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/game_info_icon"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginTop="144dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="17dp"
        app:roundingBorderColor="#99ffffff"
        app:roundingBorderWidth="2dp"/>
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:id="@+id/game_info_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/game_info_icon"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#161823"
        android:ellipsize="end"
        android:id="@+id/game_info_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/game_info_name"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/game_tag_rv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/game_info_summary"/>
    <LinearLayout
        android:id="@+id/user_info_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/game_tag_rv">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/user_head_1"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="-4.72dp"
            android:layout_marginEnd="-4.72dp"
            app:roundAsCircle="true"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/user_head_2"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="-4.72dp"
            android:layout_marginEnd="-4.72dp"
            app:roundAsCircle="true"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/user_head_3"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:roundAsCircle="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#80161823"
            android:layout_gravity="center_vertical"
            android:id="@+id/user_count_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <Button
        android:textSize="16sp"
        android:textColor="@color/white"
        android:id="@+id/open_game_btn"
        android:background="@drawable/ttlive_bg_fe2c55_round_8_btn"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:text="@string/ttlive_open_platform_mg_live_open_game"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/user_info_ll"/>
</androidx.constraintlayout.widget.ConstraintLayout>
