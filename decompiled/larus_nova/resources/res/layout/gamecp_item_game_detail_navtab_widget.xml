<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_nav_view_parent"
    android:background="@color/gamecp_game_FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/vp_game_detail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="39dp"/>
    <View
        android:id="@+id/nav_bar_mask"
        android:background="@drawable/gamecp_bg_detail_nav_bar_mask"
        android:layout_width="match_parent"
        android:layout_height="56dp"/>
    <LinearLayout
        android:id="@+id/ll_game_detail_tab_layout"
        android:background="@drawable/gamecp_bg_dialog_bottom_white_top_radius_12dp"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <com.google.android.material.tabs.TabLayout
            android:layout_gravity="bottom"
            android:id="@+id/tl_game_detail_tab_layout"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginLeft="18dp"
            android:layout_marginRight="18dp"
            android:layout_marginBottom="5dp"
            app:tabBackground="@color/white"
            app:tabGravity="fill"
            app:tabIndicator="@drawable/gamecp_game_detail_navbar_indicator"
            app:tabIndicatorColor="@color/gamecp_game_161823"
            app:tabIndicatorHeight="2dp"
            app:tabMaxWidth="0dp"
            app:tabMode="fixed"
            app:tabPaddingEnd="0dp"
            app:tabPaddingStart="0dp"
            app:tabRippleColor="@color/transparent"/>
    </LinearLayout>
</FrameLayout>
