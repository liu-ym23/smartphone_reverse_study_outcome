<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="54dp"
    android:layout_marginRight="48dp"
    android:layout_marginStart="54dp"
    android:layout_marginEnd="48dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_reply_comment_button"
        android:paddingLeft="6dp"
        android:paddingRight="0dp"
        android:visibility="visible"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="0dp">
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/divider"
            android:background="@color/aos_line_primary"
            android:layout_width="20dp"
            android:layout_height="1dp"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="8dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textColor="@color/aos_text_tertiary"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_reply_comment_title"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/img_reply_comment_collapse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:src="@drawable/aos_ic_s_s_arrowdown_outlined_12"
            android:rotation="180"
            android:layout_marginStart="2dp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/img_reply_comment_expand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:src="@drawable/aos_ic_s_s_arrowdown_outlined_12"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtLoadingLayout
        android:layout_gravity="center"
        android:id="@+id/layout_reply_comment_loading"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="0dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="0dp"/>
</FrameLayout>
