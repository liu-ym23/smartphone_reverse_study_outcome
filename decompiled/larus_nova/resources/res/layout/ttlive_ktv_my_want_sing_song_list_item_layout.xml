<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#59000000"
        android:gravity="center_horizontal"
        android:id="@+id/sequence_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/music_cover"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginLeft="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/sequence_num"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_bg_ktv_stub_light"
        app:placeholderImageScaleType="fitXY"
        app:roundedCornerRadius="4dp"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/music_duration"
        android:background="@drawable/ttlive_bg_music_duration"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/music_cover"
        app:layout_constraintLeft_toLeftOf="@+id/music_cover"
        app:layout_constraintRight_toRightOf="@+id/music_cover"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:ellipsize="end"
        android:id="@+id/music_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:maxWidth="170dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/music_author"
        app:layout_constraintStart_toEndOf="@+id/music_cover"
        app:layout_constraintTop_toTopOf="@+id/music_cover"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#80000000"
        android:ellipsize="end"
        android:id="@+id/music_author"
        android:layout_width="wrap_content"
        android:layout_height="15dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="8dp"
        android:maxWidth="130dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/music_cover"
        app:layout_constraintStart_toEndOf="@+id/music_cover"
        app:layout_constraintTop_toBottomOf="@+id/music_name"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.bytedance.android.livesdk.ktvimpl.ktvcomponent.dialog.selected.view.MultiUserAvatarView
        android:id="@+id/multi_chorus_user_avatar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/music_cover"
        app:layout_constraintStart_toEndOf="@+id/music_cover"
        app:layout_constraintTop_toBottomOf="@+id/music_name"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#80000000"
        android:ellipsize="end"
        android:id="@+id/multi_user_count"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:maxWidth="190dp"
        android:maxEms="8"
        android:singleLine="true"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/multi_chorus_user_avatar"
        app:layout_constraintStart_toEndOf="@+id/multi_chorus_user_avatar"
        app:layout_constraintTop_toTopOf="@+id/multi_chorus_user_avatar"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/remove_want_sing"
        android:background="@drawable/ttlive_multi_chorus_leave_btn_bg"
        android:visibility="visible"
        android:layout_width="44dp"
        android:layout_height="20dp"
        android:layout_marginRight="16dp"
        android:text="@string/ttlive_ktv_multi_chorus_leave"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
