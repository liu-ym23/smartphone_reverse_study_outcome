<?xml version="1.0" encoding="utf-8"?>
<com.larus.bmhome.chat.layout.widget.RelativeLayoutWithLastMotion xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/larus_music_bg"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <TextView
        android:textSize="?attr/larus_dp_12"
        android:textColor="?attr/larus_neutral_100"
        android:id="@+id/error_message"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_error_music_message"/>
    <RelativeLayout
        android:id="@+id/music_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/title_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_12"
            android:layout_marginStart="?attr/larus_dp_12">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/app_from_icon"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                app:placeholderImage="@drawable/larus_qishui_music_icon"
                app:roundedCornerRadius="?attr/larus_dp_4"/>
            <TextView
                android:textSize="?attr/larus_dp_13"
                android:textStyle="bold"
                android:textColor="?attr/larus_neutral_50"
                android:layout_gravity="center_vertical"
                android:id="@+id/video_source_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="?attr/larus_dp_6"/>
            <ImageView
                android:id="@+id/more_app"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_16"
                android:layout_height="?attr/larus_dp_16"
                android:src="@drawable/larus_more_info_img"
                android:layout_marginStart="?attr/larus_dp_6"/>
        </LinearLayout>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/cover_image"
            android:background="?attr/larus_base_2_overlay"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_190"
            android:layout_marginTop="?attr/larus_dp_12"
            android:layout_below="@+id/title_view"
            app:actualImageScaleType="centerCrop"
            app:placeholderImageScaleType="centerCrop"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/cover_image"
            android:paddingStart="?attr/larus_dp_12">
            <TextView
                android:textSize="?attr/larus_dp_13"
                android:textStyle="bold"
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:id="@+id/song_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_12"
                android:maxLines="2"
                android:layout_marginEnd="?attr/larus_dp_56"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="?attr/larus_dp_13"
                android:textColor="?attr/larus_neutral_50"
                android:ellipsize="end"
                android:id="@+id/singer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_4"
                android:layout_marginBottom="?attr/larus_dp_12"
                android:maxLines="1"
                android:layout_below="@+id/song_des"
                android:layout_marginEnd="?attr/larus_dp_56"
                android:layout_alignParentStart="true"/>
            <RelativeLayout
                android:id="@+id/player_container"
                android:layout_width="?attr/larus_dp_56"
                android:layout_height="?attr/larus_dp_56"
                android:layout_alignParentEnd="true">
                <com.larus.common_ui.widget.CircleProgressBar
                    android:id="@+id/progress"
                    android:visibility="gone"
                    android:layout_width="?attr/larus_dp_35"
                    android:layout_height="?attr/larus_dp_35"
                    android:progress="2"
                    android:layout_centerInParent="true"
                    app:larus_maxProgress="100"
                    app:larus_progressbarBackgroundColor="?attr/larus_neutral_50"
                    app:larus_progressbarColor="?attr/larus_primary_50"
                    app:larus_radius="?attr/larus_dp_3"
                    app:larus_strokeWidth="?attr/larus_dp_3"/>
                <ImageView
                    android:id="@+id/play_image"
                    android:background="@drawable/larus_video_play_img"
                    android:visibility="visible"
                    android:layout_width="?attr/larus_dp_56"
                    android:layout_height="?attr/larus_dp_56"
                    android:layout_centerInParent="true"/>
                <ProgressBar
                    android:id="@+id/loading_view"
                    android:visibility="gone"
                    android:layout_width="?attr/larus_dp_30"
                    android:layout_height="?attr/larus_dp_30"
                    android:indeterminate="true"
                    android:layout_centerInParent="true"
                    android:indeterminateTint="?attr/larus_primary_50"/>
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>
</com.larus.bmhome.chat.layout.widget.RelativeLayoutWithLastMotion>
