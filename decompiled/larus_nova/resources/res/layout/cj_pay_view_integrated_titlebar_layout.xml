<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cj_pay_titlebar_root_view"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cj_pay_height_50">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/cj_pay_back_view"
        android:padding="@dimen/cj_pay_padding_12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/cj_pay_icon_titlebar_left_arrow"
        android:scaleType="centerCrop"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/cj_pay_color_black_161823"
        android:ellipsize="middle"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/cj_pay_middle_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="300dp"
        android:singleLine="true"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/cj_pay_right_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/cj_pay_padding_12"
        android:src="@drawable/cj_pay_icon_titlebar_left_arrow"
        android:scaleType="centerCrop"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/cj_pay_bottom_divider_line"
        android:background="@color/cj_pay_color_gray_232"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_half_1"/>
</FrameLayout>
