<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/receiver_content_container"
        android:background="@drawable/ttlive_bg_gift_receiver_new"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:paddingEnd="28dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/receiver_info_container"
            android:padding="4dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/give_for_title"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/receiver_item_list"
                android:fadingEdge="horizontal"
                android:fadingEdgeLength="50dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:requiresFadingEdge="horizontal"
                android:paddingEnd="1.75dp"
                app:layout_constraintBottom_toBottomOf="@+id/receiver_info_container"
                app:layout_constraintStart_toStartOf="@+id/receiver_info_container"
                app:layout_constraintTop_toTopOf="@+id/receiver_info_container"/>
            <ImageView
                android:id="@+id/user_avatar"
                android:visibility="gone"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ttlive_img_avatar_empty"
                android:layout_marginStart="2dp"
                app:layout_constraintBottom_toBottomOf="@+id/receiver_info_container"
                app:layout_constraintStart_toStartOf="@+id/receiver_info_container"
                app:layout_constraintTop_toTopOf="@+id/receiver_info_container"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#face15"
                android:ellipsize="end"
                android:id="@+id/user_name"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="1dp"
                app:layout_constraintBottom_toBottomOf="@+id/receiver_info_container"
                app:layout_constraintEnd_toStartOf="@+id/space"
                app:layout_constraintStart_toEndOf="@+id/receiver_item_list"
                app:layout_constraintTop_toTopOf="@+id/receiver_info_container"/>
            <View
                android:gravity="end"
                android:id="@+id/space"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="5dp"
                android:layout_marginStart="116dp"
                app:layout_constraintBottom_toBottomOf="@+id/receiver_info_container"
                app:layout_constraintStart_toStartOf="@+id/receiver_info_container"
                app:layout_constraintTop_toTopOf="@+id/receiver_info_container"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/right_back"
                android:visibility="gone"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/receiver_info_container"
                app:layout_constraintStart_toStartOf="@+id/space"
                app:layout_constraintTop_toTopOf="@+id/receiver_info_container"
                app:srcCompat="@drawable/ttlive_ui_gift_change_receiver_arrow"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/gift_receiver_more_container"
                android:visibility="visible"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/receiver_info_container"
                app:layout_constraintStart_toEndOf="@+id/receiver_item_list"
                app:layout_constraintTop_toTopOf="@+id/receiver_info_container">
                <ImageView
                    android:id="@+id/more_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ttlive_base_gift_more_receiver"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="8dp"
                    android:textColor="@color/ttlive_colorffffff_80"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_width="28dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="2dp"
                    android:text="更多"
                    android:maxLines="1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/more_icon"/> /&gt; 
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/give_for_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="16dp"
            android:text="@string/ttlive_live_send_text"
            android:alpha="0.8"
            app:layout_constraintStart_toStartOf="@+id/receiver_content_container"
            app:layout_constraintTop_toTopOf="@+id/receiver_content_container"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
