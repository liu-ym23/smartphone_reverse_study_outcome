<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/unlike_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/item_icon"
            android:background="@drawable/ttlive_audience_panel_icon_like_normal"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_audience_item_text_color"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/item_desc_unlike"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/like_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:background="@drawable/ttlive_audience_panel_icon_like_highlight"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
        <com.bytedance.android.livesdk.interactivity.publicscreen.panel.view.PSGradientTextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_audience_item_text_color"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/item_desc_like"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>
    </LinearLayout>
</FrameLayout>
