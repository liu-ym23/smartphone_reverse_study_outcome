<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/tab_icon"
            android:layout_width="?attr/larus_dp_30"
            android:layout_height="?attr/larus_dp_30"
            android:layout_marginTop="?attr/larus_dp_5"
            android:src="@drawable/larus_tab_icon_conversation_select"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/retry_icon"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:layout_marginTop="?attr/larus_dp_8"
            android:src="@drawable/larus_tab_retry"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/tab_red_point"
            android:background="@drawable/larus_shape_red_circle"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_9"
            android:layout_height="?attr/larus_dp_9"
            android:layout_marginTop="?attr/larus_dp_3"
            android:layout_marginEnd="?attr/larus_dp_3"
            app:layout_constraintEnd_toEndOf="@+id/tab_icon"
            app:layout_constraintTop_toTopOf="@+id/tab_icon"/>
        <View
            android:id="@+id/mine_tab_red_point"
            android:background="@drawable/larus_ic_red_mine"
            android:visibility="invisible"
            android:layout_width="?attr/larus_dp_10"
            android:layout_height="?attr/larus_dp_10"
            app:layout_constraintEnd_toEndOf="@+id/tab_icon"
            app:layout_constraintTop_toTopOf="@+id/tab_icon"/>
        <com.larus.common_ui.widget.RedDotTextView
            android:textSize="?attr/larus_sp_12"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:id="@+id/tab_unread_count"
            android:background="@drawable/larus_red_dot_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_14"
            android:includeFontPadding="false"
            android:layout_marginStart="?attr/larus_dp_18"
            app:larus_dimension_style="1"
            app:layout_constraintBottom_toBottomOf="@+id/tab_icon"
            app:layout_constraintStart_toStartOf="@+id/tab_icon"/>
        <com.larus.home.impl.main.tab.config.BottomTabGradientTextView
            android:textSize="?attr/larus_sp_12"
            android:textColor="@color/larus_neutral_100"
            android:ellipsize="end"
            android:id="@+id/tab_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/larus_dp_8"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="@+id/tab_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tab_icon"
            app:layout_constraintTop_toTopOf="@+id/tab_icon"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
