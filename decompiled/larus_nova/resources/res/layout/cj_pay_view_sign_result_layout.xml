<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/cj_pay_color_white"
    android:layout_width="match_parent"
    android:layout_height="420dp">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/cj_pay_status_icon_layout"
        android:layout_width="@dimen/cj_pay_height_60"
        android:layout_height="@dimen/cj_pay_height_60"
        android:layout_marginTop="60dp">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_pay_status_icon"
            android:layout_width="@dimen/cj_pay_height_60"
            android:layout_height="@dimen/cj_pay_height_60"
            android:scaleType="centerCrop"/>
    </FrameLayout>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/cj_pay_color_black_161823"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/cj_pay_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:includeFontPadding="false"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/cj_pay_status_desc"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:includeFontPadding="false"/>
    <LinearLayout
        android:gravity="center"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_80"
            android:id="@+id/cj_pay_service_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/cj_pay_color_black_161823"
            android:id="@+id/cj_pay_service_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
        android:textSize="15sp"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/cj_pay_btn_back"
        android:visibility="visible"
        android:layout_width="165dp"
        android:layout_height="44dp"
        android:layout_marginBottom="32dp"
        android:text="@string/cj_pay_outer_return_merchant"
        android:includeFontPadding="false"/>
    <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
        android:id="@+id/cj_pay_complete_insurance_tips_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:theme_type="0"/>
</LinearLayout>
