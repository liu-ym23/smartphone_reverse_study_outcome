<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/new_profile_comment_component_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/mysterious_man_panel_root"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mysterious_man_panel_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/mysterious_man_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:actualImageScaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"
            app:placeholderImage="@color/ttlive_mysterious_man_profile_default_background"
            app:placeholderImageScaleType="centerCrop"
            app:roundedCornerRadius="8dp"/>
        <LinearLayout
            android:id="@+id/top_right_button_area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="14dp"
                android:textColor="#80ffffff"
                android:id="@+id/manage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_live_profile_button_manage"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#80ffffff"
                android:id="@+id/report"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_report_report"
                android:layout_marginStart="16dp"/>
        </LinearLayout>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/mysterious_man_avatar"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_marginTop="76.29dp"
            app:actualImageScaleType="fitCenter"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="@drawable/ttlive_avatar_empty_light"
            app:roundAsCircle="true"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/mysterious_man_avatar_border"
            android:layout_width="82dp"
            android:layout_height="85dp"
            app:layout_constraintBottom_toBottomOf="@+id/mysterious_man_avatar"
            app:layout_constraintLeft_toLeftOf="@+id/mysterious_man_avatar"
            app:layout_constraintRight_toRightOf="@+id/mysterious_man_avatar"
            app:layout_constraintTop_toTopOf="@+id/mysterious_man_avatar"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center"
            android:id="@+id/mysterious_man_name_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/mysterious_man_avatar">
            <TextView
                android:textSize="18dp"
                android:textColor="#e6ffffff"
                android:id="@+id/mysterious_man_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/grade_icon_scroll_container"
                app:layout_constraintTop_toTopOf="parent"/>
            <HorizontalScrollView
                android:id="@+id/grade_icon_scroll_container"
                android:visibility="gone"
                android:scrollbars="none"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:layout_marginStart="4dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/mysterious_man_name"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="260dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/grade_icon_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </HorizontalScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="14dp"
            android:textColor="#d2936f"
            android:id="@+id/mysterious_man_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/mysterious_man_name_container"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#b3ffffff"
            android:gravity="center"
            android:id="@+id/find_out_mysterious_man"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="71dp"
            android:text="@string/ttlive_mysterious_find_out"
            android:includeFontPadding="false"
            android:drawablePadding="5dp"
            android:drawableEnd="@drawable/ttlive_mysterious_man_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/mysterious_man_tip"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
