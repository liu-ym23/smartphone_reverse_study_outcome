<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/mLlAnnouncementInstructionDialogContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_white"
            android:layout_gravity="center_horizontal"
            android:id="@+id/mTvAnnouncementInstructionDialogTitle"
            android:padding="18dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="直播公告展示说明"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/mIvAnnouncementInstructionDialogClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:src="@drawable/ttlive_ic_close"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/mAnnouncementInstructionDialogDividerLine"
        android:background="@color/ttlive_douyin_dark_DialogDivider"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mRvAnnouncementInstructionDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
