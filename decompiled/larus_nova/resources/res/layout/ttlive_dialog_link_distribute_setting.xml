<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_dynamic_emoji_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="55dp">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/ttlive_core_hs_s5_41"
            android:id="@+id/tv_link_distribute_setting_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/ttlive_chatroom_distribute_tips_new"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_link_distribute_help"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginRight="20dp"
            android:src="@drawable/ic_linkmic_distribution_help"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_link_dialog_item_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/ttlive_link_distribute_item_line"/>
    <View
        android:id="@+id/cancel_btn_line"
        android:background="@color/ttlive_dialog_grey_f4"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/tv_dialog_link_distribute_setting_cancel_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/ttlive_link_text_color"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_dialog_link_distribute_setting_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="19dp"
            android:text="@string/ttlive_button_cancel"
            android:lineSpacingExtra="2dp"/>
    </LinearLayout>
</LinearLayout>
