<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/shopping_bg_live_list_banner"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:layout_width="match_parent"
    android:layout_height="34dp">
    <TextView
        android:textColor="@color/shopping_std_text_white_1"
        android:gravity="center"
        android:id="@+id/tv_index"
        android:background="@drawable/ec_bg_explaining_index"
        android:layout_width="19dp"
        android:layout_height="14dp"
        style="@style/font_size_20"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/shopping_color_FF3344"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:text="@string/ec_explaining_text"
        android:includeFontPadding="false"
        android:layout_marginStart="4dp"
        style="@style/font_size_20"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/shopping_std_text_black_1"
        android:gravity="center"
        android:layout_width="6dp"
        android:layout_height="16dp"
        android:text="@string/ec_explaining_divide"
        android:includeFontPadding="false"
        android:layout_marginStart="2dp"
        style="@style/font_size_20"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/shopping_std_text_black_1"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_promotion_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_weight="1"
        android:layout_marginStart="2dp"
        style="@style/font_size_24"/>
    <View
        android:background="@drawable/shopping_ic_list_banner_info_gray_arrow_right"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginStart="5dp"/>
</LinearLayout>
