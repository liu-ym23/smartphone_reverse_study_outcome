<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="65dp">
    <FrameLayout
        android:id="@+id/anchor_avatar_container"
        android:clipChildren="false"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginLeft="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.ktv.common.view.LiveOnlineAvatarView
            android:layout_gravity="center"
            android:id="@+id/anchor_avatar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="3dp"
            app:roundAsCircle="true"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="bottom|right"
            android:id="@+id/living_icon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            app:placeholderImageScaleType="fitXY"/>
    </FrameLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/anchor_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="9dp"
        android:layout_marginTop="3dp"
        android:layout_marginRight="10dp"
        android:lines="1"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/anchor_avatar_container"
        app:layout_constraintRight_toLeftOf="@+id/online_count"
        app:layout_constraintTop_toTopOf="@+id/anchor_avatar_container"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#8a8b91"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/sing_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="2dp"
        android:lines="1"
        android:singleLine="true"
        android:drawableLeft="@drawable/ttlive_mic_icon"
        android:drawablePadding="5dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/anchor_avatar_container"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="@+id/anchor_name"
        app:layout_constraintRight_toLeftOf="@+id/online_count"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/black"
        android:id="@+id/online_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
