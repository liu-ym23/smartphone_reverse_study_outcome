<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/idl"
        android:background="@drawable/ttlive_bg_rematch_guest_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/white"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp"
            android:text="@string/ttlive_pk_guest_finish_ahead"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="70dp">
            <Button
                android:textSize="12dp"
                android:textStyle="normal"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/finish_idl"
                android:background="@drawable/ttlive_bg_rematch_btn_finish"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_marginLeft="13dp"
                android:layout_marginRight="8dp"
                android:text="@string/ttlive_pk_finish_pk"
                android:layout_weight="1"/>
            <Button
                android:textSize="12dp"
                android:textColor="@color/white"
                android:id="@+id/rematch"
                android:background="@drawable/ttlive_bg_rematch_btn_match"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_marginRight="13dp"
                android:text="@string/ttlive_live_interact_pk_restart_match"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/rb_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <androidx.appcompat.widget.AppCompatRadioButton
                android:theme="@style/ttlive_uncheck_radio_button"
                android:layout_gravity="center_vertical"
                android:id="@+id/rb"
                android:background="@drawable/ttlive_ic_pk_rematch_radio"
                android:clickable="false"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:checked="false"
                android:button="@null"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#80ffffff"
                android:id="@+id/tv_rb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:text="@string/ttlive_pk_rematch_remember"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/matching"
        android:background="@drawable/ttlive_bg_rematch_anchor"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/anim"
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="32dp"
            android:layout_marginRight="24dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="86dp"
            android:text="@string/ttlive_pk_guest_finish_ahead_match_for_you"
            android:lineSpacingExtra="3dp"/>
        <Button
            android:textSize="12dp"
            android:textStyle="normal"
            android:textColor="@color/white"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/finish_match"
            android:background="@drawable/ttlive_bg_rematch_btn_finish"
            android:layout_width="64dp"
            android:layout_height="24dp"
            android:layout_marginBottom="64dp"
            android:text="@string/ttlive_cancel"/>
    </FrameLayout>
</FrameLayout>
