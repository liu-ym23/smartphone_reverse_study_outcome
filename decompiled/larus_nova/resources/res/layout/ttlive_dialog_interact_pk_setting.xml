<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/outside"
        android:background="#57000000"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/setting_content"
        android:background="@drawable/ttlive_bg_interact_dialog"
        android:layout_width="match_parent"
        android:layout_height="484dp">
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/pk_interact_setting_title"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="@string/ttlive_video_talk_integration_link_setting"/>
        <View
            android:background="#1a161823"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animateLayoutChanges="false">
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="24dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="13dp"
                    android:textColor="#57000000"
                    android:paddingLeft="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_interact_video_talk_permission_setting"
                    android:paddingStart="16dp"/>
                <FrameLayout
                    android:id="@+id/fl_pk_link_permission"
                    android:layout_width="match_parent"
                    android:layout_height="54dp">
                    <TextView
                        android:textSize="17dp"
                        android:textColor="@color/black"
                        android:layout_gravity="start|center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:text="@string/ttlive_interact_link_permission"
                        android:layout_marginStart="16dp"/>
                    <TextView
                        android:textSize="15dp"
                        android:textColor="#80161823"
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/tv_is_need_apply"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="36dp"
                        android:text="@string/ttlive_interact_link_need_apply"
                        android:layout_marginEnd="36dp"/>
                    <ImageView
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/iv_enter_interact_permission_dialog"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginRight="16dp"
                        android:src="@drawable/ttlive_ic_talk_room_setting_arrow"
                        android:layout_marginEnd="16dp"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/pk_support_admin_operate_v2"
                    android:layout_width="match_parent"
                    android:layout_height="54dp">
                    <TextView
                        android:textSize="17dp"
                        android:textColor="@color/black"
                        android:layout_gravity="start|center_vertical"
                        android:id="@+id/pk_admin_operation_text_v2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:text="@string/ttlive_interact_support_admin_operate"
                        android:layout_marginStart="16dp"/>
                    <ImageView
                        android:layout_gravity="end|center_vertical"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginRight="16dp"
                        android:src="@drawable/ttlive_ic_talk_room_setting_arrow"
                        android:layout_marginEnd="16dp"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/pk_video_audio_permission_container"
                    android:layout_width="match_parent"
                    android:layout_height="54dp">
                    <TextView
                        android:textSize="17dp"
                        android:textColor="@color/black"
                        android:layout_gravity="start|center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:text="@string/ttlive_interact_pk_av_permission"
                        android:layout_marginStart="16dp"/>
                    <ImageView
                        android:layout_gravity="end|center_vertical"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginRight="16dp"
                        android:src="@drawable/ttlive_ic_talk_room_setting_arrow"
                        android:layout_marginEnd="16dp"/>
                </FrameLayout>
                <RelativeLayout
                    android:gravity="center_vertical"
                    android:id="@+id/pk_allow_send_gift"
                    android:layout_width="match_parent"
                    android:layout_height="54dp">
                    <TextView
                        android:textSize="17dp"
                        android:textColor="@color/black"
                        android:layout_gravity="start|center_vertical"
                        android:id="@+id/pk_allow_send_gift_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:text="@string/ttlive_interact_pk_allow_send_gift"
                        android:layout_marginStart="16dp"/>
                    <ImageView
                        android:id="@+id/pk_allow_send_gift_rule_img"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:src="@drawable/ttlive_guest_send_gift_rule"
                        android:layout_toRightOf="@+id/pk_allow_send_gift_tv"
                        android:layout_marginStart="4dp"
                        android:layout_toEndOf="@+id/pk_allow_send_gift_tv"/>
                    <FrameLayout
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/pk_switch_send_gift_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="16dp"
                        android:layout_alignParentRight="true"
                        android:layout_marginEnd="16dp"
                        android:layout_alignParentEnd="true">
                        <Switch
                            android:id="@+id/pk_switch_send_gift"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:checked="true"
                            android:textOn=""
                            android:textOff=""
                            android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
                            android:track="@drawable/ttlive_selector_interact_dialog_switch_track"/>
                    </FrameLayout>
                </RelativeLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="16dp"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</LinearLayout>
