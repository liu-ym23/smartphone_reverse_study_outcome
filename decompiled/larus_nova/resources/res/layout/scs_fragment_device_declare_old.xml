<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="@style/UDText.Body2"
        android:textColor="@color/text_caption"
        android:id="@+id/tv_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/Lark_Conditions_DeviceSecurity"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/deviceInfoContainer"
        android:background="@drawable/scs_bg_white_card"
        android:paddingTop="@dimen/dp_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginBottom="@dimen/dp_8"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_hint"
        app:layout_constraintVertical_bias="0">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/deviceNameContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_device_icon"
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/deviceName"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ud_icon_cellphone_outlined"
                app:tint="@color/ud_primary_icon_color"/>
            <TextView
                android:textAppearance="@style/UDText.Headline"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/deviceName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="@dimen/dp_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/deviceApplyStatus"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@+id/iv_device_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_default="wrap"/>
            <TextView
                android:textAppearance="@style/UDText.Body2"
                android:textColor="@color/udtoken_tag_neutral_text_normal"
                android:gravity="center"
                android:id="@+id/deviceApplyStatus"
                android:background="@drawable/scs_bg_grey_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Lark_Conditions_StatusOfThis"
                android:paddingStart="@dimen/dp_5"
                android:paddingEnd="@dimen/dp_5"
                android:layout_marginStart="@dimen/dp_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@+id/deviceName"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/deviceOSContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginStart="@dimen/dp_40"
            android:layout_marginEnd="@dimen/dp_12"
            app:alignItems="stretch"
            app:dividerDrawableHorizontal="@drawable/device_apply_divider"
            app:flexWrap="wrap"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/deviceNameContainer"
            app:showDividerHorizontal="middle">
            <TextView
                android:textAppearance="@style/UDText.Body2"
                android:textColor="@color/text_placeholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Lark_Conditions_System"/>
            <TextView
                android:textAppearance="@style/UDText.Body2"
                android:textColor="@color/text_placeholder"
                android:id="@+id/deviceOS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </com.google.android.flexbox.FlexboxLayout>
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/deviceOwnerContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"
            app:alignContent="center"
            app:alignItems="stretch"
            app:dividerDrawableHorizontal="@drawable/device_apply_divider"
            app:flexWrap="wrap"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/deviceOSContainer"
            app:layout_constraintTop_toBottomOf="@+id/deviceOSContainer"
            app:showDivider="middle"
            app:showDividerHorizontal="middle">
            <TextView
                android:textAppearance="@style/UDText.Body2"
                android:textColor="@color/text_placeholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Lark_Conditions_DeviceBelonging"/>
            <TextView
                android:textAppearance="@style/UDText.Body2"
                android:textColor="@color/text_placeholder"
                android:id="@+id/deviceOwner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </com.google.android.flexbox.FlexboxLayout>
        <ScrollView
            android:id="@+id/rejectReasonContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/emptySpace"
            app:layout_constraintEnd_toEndOf="@+id/deviceOSContainer"
            app:layout_constraintHeight_default="wrap"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/deviceOSContainer"
            app:layout_constraintTop_toBottomOf="@+id/deviceOwnerContainer"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintVertical_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textAppearance="@style/UDText.Body2"
                    android:textColor="@color/text_placeholder"
                    android:id="@+id/rejectReason"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    app:layout_constraintHorizontal_bias="0"/>
            </LinearLayout>
        </ScrollView>
        <Space
            android:id="@+id/emptySpace"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_12"
            app:layout_constraintBottom_toTopOf="@+id/lineApply"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rejectReasonContainer"/>
        <View
            android:id="@+id/lineApply"
            android:background="@color/line_divider_module"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/emptySpace"/>
        <View
            android:id="@+id/lineRefresh"
            android:background="@color/line_divider_module"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/emptySpace"/>
        <TextView
            android:textAppearance="@style/UDText.Body2"
            android:textColor="@color/text_link_normal"
            android:gravity="center"
            android:id="@+id/applyButton"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_8"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/Lark_Conditions_Apply"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lineApply"/>
        <TextView
            android:textAppearance="@style/UDText.Body2"
            android:textColor="@color/text_link_normal"
            android:gravity="center"
            android:id="@+id/refreshButton"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_8"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/Lark_Conditions_Refresh"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lineRefresh"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/applyGroup"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:constraint_referenced_ids="lineApply,applyButton"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/refreshGroup"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:constraint_referenced_ids="lineRefresh,refreshButton"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
