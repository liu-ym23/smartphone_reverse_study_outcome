<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.live.profile.customview.TransitionConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="end|bottom"
    android:id="@+id/new_profile_root_view"
    android:paddingBottom="12dp"
    android:visibility="invisible"
    android:layout_width="352dp"
    android:layout_height="wrap_content">
    <Space
        android:id="@+id/new_profile_content_white_bg_top_anchor"
        android:layout_width="0dp"
        android:layout_height="3px"
        app:layout_constraintBottom_toTopOf="@+id/new_profile_content_white_bg"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <View
        android:id="@+id/new_profile_content_white_bg"
        android:background="@drawable/ttlive_bg_new_live_profile_dialog_white"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/new_profile_max_border_layout_top_anchor"
        app:layout_constraintRight_toRightOf="@+id/new_profile_max_border_layout_top_anchor"
        app:layout_constraintTop_toTopOf="@+id/new_profile_max_border_layout_top_anchor"/>
    <View
        android:id="@+id/new_profile_content_bg_color"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/new_profile_content_white_bg"
        app:layout_constraintLeft_toLeftOf="@+id/new_profile_content_white_bg"
        app:layout_constraintRight_toRightOf="@+id/new_profile_content_white_bg"
        app:layout_constraintTop_toTopOf="@+id/new_profile_content_white_bg"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/new_profile_content_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:actualImageScaleType="focusCrop"
        app:layout_constraintBottom_toBottomOf="@+id/new_profile_content_white_bg"
        app:layout_constraintLeft_toLeftOf="@+id/new_profile_content_white_bg"
        app:layout_constraintRight_toRightOf="@+id/new_profile_content_white_bg"
        app:layout_constraintTop_toTopOf="@+id/new_profile_content_white_bg_top_anchor"
        app:roundTopEnd="false"
        app:roundTopStart="false"
        app:roundedCornerRadius="8dp"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/new_profile_content_background_my_live"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:actualImageScaleType="fitCenter"
        app:layout_constraintLeft_toLeftOf="@+id/new_profile_content_white_bg"
        app:layout_constraintRight_toRightOf="@+id/new_profile_content_white_bg"
        app:layout_constraintTop_toTopOf="@+id/new_profile_content_white_bg_top_anchor"
        app:roundTopEnd="false"
        app:roundTopStart="false"
        app:roundedCornerRadius="8dp"/>
    <FrameLayout
        android:id="@+id/new_profile_panel_effect_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/new_profile_content_white_bg"
        app:layout_constraintLeft_toLeftOf="@+id/new_profile_content_white_bg"
        app:layout_constraintRight_toRightOf="@+id/new_profile_content_white_bg"
        app:layout_constraintTop_toTopOf="@+id/new_profile_content_white_bg_top_anchor"/>
    <FrameLayout
        android:id="@+id/new_profile_enter_effect_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/new_profile_content_white_bg"
        app:layout_constraintLeft_toLeftOf="@+id/new_profile_content_white_bg"
        app:layout_constraintRight_toRightOf="@+id/new_profile_content_white_bg"
        app:layout_constraintTop_toTopOf="@+id/new_profile_content_white_bg_top_anchor"/>
    <Space
        android:id="@+id/new_profile_max_border_layout_top_anchor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="22dp"
        app:layout_constraintBottom_toTopOf="@+id/new_profile_max_border_layout_scroll_container"
        app:layout_constraintLeft_toLeftOf="@+id/new_profile_max_border_layout_scroll_container"
        app:layout_constraintRight_toRightOf="@+id/new_profile_max_border_layout_scroll_container"/>
    <com.bytedance.android.live.profile.customview.ProfileNestedScrollView
        android:id="@+id/new_profile_max_border_layout_scroll_container"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/new_profile_max_border_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/new_profile_top_skin_image"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="74dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:visibility="invisible"
                android:layout_width="1dp"
                android:layout_height="52dp"
                app:layout_constraintBottom_toTopOf="@+id/profile_dynamic_space"
                app:layout_constraintLeft_toLeftOf="parent"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/new_live_profile_top_right_area"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginTop="33dp"
                android:layout_marginStart="106dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/new_live_profile_avatar"
                android:background="@drawable/ttlive_profile_avatar_bg_oval_black"
                android:padding="2dp"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="14dp"
                app:actualImageScaleType="fitCenter"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:overlayImage="@drawable/ttlive_profile_avatar_overlay_mask"
                app:placeholderImage="@drawable/ttlive_avatar_empty_light"
                app:roundAsCircle="true"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/new_live_profile_avatar_border"
                android:layout_width="90dp"
                android:layout_height="90dp"
                app:layout_constraintBottom_toBottomOf="@+id/new_live_profile_avatar"
                app:layout_constraintLeft_toLeftOf="@+id/new_live_profile_avatar"
                app:layout_constraintRight_toRightOf="@+id/new_live_profile_avatar"
                app:layout_constraintTop_toTopOf="@+id/new_live_profile_avatar"/>
            <View
                android:id="@+id/profile_dynamic_space"
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginBottom="20dp"
                app:layout_constraintBottom_toTopOf="@+id/new_live_profile_user_name_container"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <FrameLayout
                android:id="@+id/new_live_profile_user_name_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/new_profile_name_space_normal"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/grade_icon"
                app:layout_constraintWidth_default="wrap">
                <com.bytedance.android.live.uikit.textview.AlwaysMarqueeTextView
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/ttlive_new_profile_black"
                    android:ellipsize="marquee"
                    android:gravity="start|center_vertical"
                    android:id="@+id/new_live_profile_user_name"
                    android:fadingEdge="horizontal"
                    android:fadingEdgeLength="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:marqueeRepeatLimit="1"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toTopOf="@+id/new_profile_name_space_normal"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@+id/grade_icon"
                    app:layout_constraintWidth_default="wrap"/>
            </FrameLayout>
            <HorizontalScrollView
                android:id="@+id/grade_icon"
                android:visibility="gone"
                android:scrollbars="none"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="10dp"
                android:overScrollMode="never"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="@+id/new_live_profile_user_name_container"
                app:layout_constraintLeft_toRightOf="@+id/new_live_profile_user_name_container"
                app:layout_constraintRight_toLeftOf="@+id/live_user_card_commerce_entrance"
                app:layout_constraintTop_toTopOf="@+id/new_live_profile_user_name_container">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/grade_icon_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </HorizontalScrollView>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/live_user_card_commerce_entrance"
                android:background="@drawable/ttlive_bg_live_user_card_commerce_entrance"
                android:visibility="gone"
                android:layout_width="68dp"
                android:layout_height="22dp"
                android:layout_marginRight="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/new_live_profile_user_name_container"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/new_live_profile_user_name_container">
                <ImageView
                    android:id="@+id/live_user_card_commerce_entrance_image"
                    android:background="@drawable/ttlive_live_user_card_commerce_entrance_image"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginLeft="6dp"
                    android:layout_marginStart="6dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="#161823"
                    android:gravity="center"
                    android:id="@+id/live_user_card_commerce_entrance_text"
                    android:background="#00000000"
                    android:layout_width="wrap_content"
                    android:layout_height="17dp"
                    android:alpha="0.7"
                    android:fontFamily="PingFangSC-Medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/live_user_card_commerce_entrance_image"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/live_user_card_commerce_entrance_arrow"
                    android:background="@drawable/ttlive_live_user_card_commerce_entrance_arrow"
                    android:layout_width="6dp"
                    android:layout_height="8dp"
                    android:layout_marginRight="6dp"
                    android:layout_marginEnd="6dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/live_user_card_commerce_entrance_text"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:id="@+id/new_profile_name_space_normal"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="4dp"
                app:layout_constraintBottom_toTopOf="@+id/new_profile_my_live_base_info_layout"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/new_profile_my_live_base_info_layout"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/new_profile_tags_flow_layout"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent">
                <View
                    android:id="@+id/new_profile_my_live_name_space_inline"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.bytedance.android.livesdk.widget.FlowLayout
                    android:id="@+id/new_profile_my_live_tags_flow_layout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/new_profile_my_live_name_space_inline"/>
                <View
                    android:id="@+id/new_profile_my_live_component_space"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/new_profile_my_live_tags_flow_layout"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/new_profile_my_live_desc_layout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/new_profile_my_live_component_space"/>
                <View
                    android:id="@+id/new_profile_my_live_bottom_space"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/new_profile_my_live_desc_layout"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.bytedance.android.livesdk.widget.FlowLayout
                android:id="@+id/new_profile_tags_flow_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/new_profile_v3_divider_space"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <View
                android:id="@+id/new_profile_v3_divider_space"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                app:layout_constraintBottom_toTopOf="@+id/new_profile_v3_divider"/>
            <View
                android:id="@+id/new_profile_v3_divider"
                android:background="@color/ttlive_new_profile_12black"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toTopOf="@+id/new_profile_my_live_fold_name_space"/>
            <View
                android:id="@+id/new_profile_my_live_fold_name_space"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="4dp"
                app:layout_constraintBottom_toTopOf="@+id/new_profile_info_layout"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <com.bytedance.android.livesdk.widget.FlowLayout
                android:id="@+id/new_profile_info_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:layout_constraintBottom_toTopOf="@+id/new_profile_desc_layout"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/new_profile_desc_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:layout_constraintBottom_toTopOf="@+id/new_profile_space_on_the_honor_wall"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <Space
                android:id="@+id/new_profile_space_on_the_honor_wall"
                android:layout_width="0dp"
                android:layout_height="12dp"
                app:layout_constraintBottom_toTopOf="@+id/new_profile_bottom_common_area"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <FrameLayout
                android:id="@+id/new_profile_bottom_common_area"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/new_profile_spread_more_container"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent">
                <androidx.core.widget.NestedScrollView
                    android:id="@+id/new_profile_scroll_container"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:overScrollMode="never">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <FrameLayout
                            android:id="@+id/new_profile_fans_club_vip_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintBottom_toTopOf="@+id/new_profile_gift_exhibition_container"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"/>
                        <FrameLayout
                            android:id="@+id/new_profile_gift_exhibition_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintBottom_toTopOf="@+id/new_profile_bottom_common_area"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"/>
                        <com.bytedance.android.livesdk.widget.FlowLayout
                            android:id="@+id/new_profile_honour_layout_land_new"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"/>
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
                <ViewStub
                    android:id="@+id/new_profile_shop"
                    android:layout="@layout/ttlive_profile_v3_shop_layout"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
                <FrameLayout
                    android:id="@+id/new_profile_shop_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/new_profile_spread_more_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/new_profile_tab_container"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <FrameLayout
                android:id="@+id/new_profile_tab_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/new_profile_bottom_space"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"/>
            <Space
                android:id="@+id/new_profile_bottom_space"
                android:layout_width="0dp"
                android:layout_height="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.bytedance.android.live.profile.customview.ProfileNestedScrollView>
    <FrameLayout
        android:id="@+id/new_profile_my_live_avatar_name_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="@+id/new_profile_max_border_layout_top_anchor"
        app:layout_constraintRight_toRightOf="@+id/new_profile_max_border_layout_top_anchor"
        app:layout_constraintTop_toTopOf="@+id/new_profile_content_white_bg"/>
    <TextView
        android:textSize="@dimen/ttlive_profile_setting_text_size"
        android:textColor="@color/ttlive_core_hs_g3"
        android:id="@+id/debug_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_live_profile_debug"
        android:paddingStart="@dimen/ttlive_profile_setting_padding_right"
        app:layout_constraintLeft_toLeftOf="@+id/new_profile_max_border_layout_scroll_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/ttlive_profile_setting_text_size"
        android:textColor="@color/ttlive_core_hs_g3"
        android:id="@+id/debug_mock_panel"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="mock面板"
        android:paddingStart="@dimen/ttlive_profile_setting_padding_right"
        app:layout_constraintLeft_toRightOf="@+id/debug_view"
        app:layout_constraintTop_toTopOf="parent"/>
</com.bytedance.android.live.profile.customview.TransitionConstraintLayout>
