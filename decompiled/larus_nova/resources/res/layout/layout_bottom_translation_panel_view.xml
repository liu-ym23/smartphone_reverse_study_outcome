<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_translate_panel_si"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/icon_device"
        android:layout_width="?attr/larus_dp_36"
        android:layout_height="?attr/larus_dp_36"
        android:layout_marginTop="?attr/larus_dp_16"
        android:src="@drawable/icon_right_earphone_translating_si"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/neutral_30"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/neutral_30"
        android:id="@+id/text_language_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_chinese_language"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/icon_device"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/icon_device"/>
    <TextView
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/neutral_30"
        android:id="@+id/text_listening"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_6"
        android:layout_marginStart="?attr/larus_dp_22"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon_device"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/translation_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon_device"/>
    <View
        android:id="@+id/gradient_view"
        android:background="@drawable/gradient_top_to_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_no_start_translate"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="icon_place_phone, layout_select_language"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_select_language"
        android:background="@drawable/bg_select_language_si"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        app:layout_constraintBottom_toTopOf="@+id/icon_place_phone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/neutral_100"
            android:gravity="center"
            android:id="@+id/text_select_language"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="@string/larus_chinese_language"
            android:layout_marginStart="?attr/larus_dp_24"
            android:layout_marginEnd="?attr/larus_dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/icon_more_language"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_more_small_si"
            android:layout_marginStart="?attr/larus_dp_12"
            android:layout_marginEnd="?attr/larus_dp_14"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/text_select_language"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/icon_place_phone"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="?attr/larus_dp_48"
        android:layout_marginBottom="?attr/larus_dp_60"
        android:src="@drawable/icon_right_earphone_si"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_select_language"
        app:tint="@color/neutral_100"/>
</androidx.constraintlayout.widget.ConstraintLayout>
