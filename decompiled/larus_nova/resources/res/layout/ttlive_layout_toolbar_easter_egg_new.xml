<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="44dp"
    android:layout_height="52dp"
    android:layout_marginLeft="4dp"
    android:layout_marginStart="4dp">
    <View
        android:id="@+id/static_icon"
        android:background="@drawable/ttlive_ic_easter_egg_toolbar_new"
        android:layout_width="@dimen/ttlive_bottom_area_height_new"
        android:layout_height="@dimen/ttlive_bottom_area_height_new"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <com.bytedance.android.livesdk.widget.CircleProgressViewV3
        android:id="@+id/progress"
        android:layout_width="39dp"
        android:layout_height="39dp"
        android:layout_marginBottom="-0.5dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/animated_icon"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_marginBottom="-14dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        app:fadeDuration="0"/>
    <ImageView
        android:id="@+id/easter_egg_halo"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginBottom="-3dp"
        android:src="@drawable/ttlive_easter_egg_toolbar_button_halo_new"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
