<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.widgets.BaseTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:widget_widgets_tb_background="@color/bg_float_base"
        app:widget_widgets_tb_divider_visible="false"
        app:widget_widgets_tb_title="@string/Bitable_Integration_Mobile_SelectBase_Title"/>
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/webview_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/loading_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.ee.bear.facade.common.widget.BearLottieView
                android:layout_gravity="center"
                android:id="@+id/subpage_loading_view"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/loading_anim"
                style="@style/BearLottieView"/>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
