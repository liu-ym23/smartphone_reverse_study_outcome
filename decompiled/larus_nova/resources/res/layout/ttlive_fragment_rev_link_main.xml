<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ttlive_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/anchor_list_main_container"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
            android:layout_gravity="center_horizontal"
            android:id="@+id/preload_progress_icon_double_ball"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/ttlive_pk_userlist_refresh_progress_anim"
            android:indeterminateBehavior="repeat"/>
        <com.bytedance.android.live.revlink.impl.pk.ui.PkTopTipView
            android:id="@+id/top_tip_view"
            android:duplicateParentState="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/tv_empty"
            android:paddingBottom="20dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_live_interact_user_list_tip1"/>
            <TextView
                android:textSize="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_live_interact_user_list_tip2"/>
        </LinearLayout>
        <com.bytedance.android.live.ui.PkInviteUserListRefreshLayout
            android:id="@+id/swipe_refresh_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="10dp">
                <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
                    android:layout_gravity="center"
                    android:id="@+id/pk_userlist_refresh_progress_double_ball"
                    android:visibility="gone"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:indeterminate="true"
                    android:indeterminateDrawable="@drawable/ttlive_pk_userlist_refresh_progress_anim"
                    android:indeterminateBehavior="repeat"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.coordinatorlayout.widget.CoordinatorLayout
                    android:id="@+id/cl_default_pk"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <com.google.android.material.appbar.AppBarLayout
                        android:id="@+id/app_bar_layout"
                        android:background="@null"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:elevation="0dp">
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/top_area"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            app:layout_scrollFlags="scroll">
                            <FrameLayout
                                android:id="@+id/top_banner"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="60dp"
                                android:layout_marginLeft="16dp"
                                android:layout_marginTop="4dp"
                                android:layout_marginRight="16dp"
                                app:layout_scrollFlags="scroll"/>
                            <com.bytedance.android.live.revlink.impl.pk.ui.PkRandomView
                                android:id="@+id/pk_random"
                                android:paddingTop="4dp"
                                android:focusable="true"
                                android:visibility="visible"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="16dp"
                                android:layout_marginTop="3dp"
                                android:layout_marginRight="16dp"
                                android:minHeight="64dp"/>
                            <FrameLayout
                                android:id="@+id/pk_rank_random_lynx"
                                android:paddingTop="4dp"
                                android:focusable="true"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="16dp"
                                android:layout_marginTop="3dp"
                                android:layout_marginRight="16dp"
                                android:minHeight="64dp"/>
                        </LinearLayout>
                        <com.bytedance.android.live.revlink.impl.pk.ui.TouchConflictPkExposeRecyclerView
                            android:id="@+id/top_follow_area"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_scrollFlags="scroll"/>
                        <com.bytedance.android.live.revlink.impl.pk.ui.TouchUpConflictTabLayout
                            android:id="@+id/tab"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="match_parent"
                            android:layout_height="28dp"
                            android:layout_marginLeft="5dp"
                            android:layout_marginTop="4dp"
                            android:layout_marginRight="5dp"
                            android:layout_marginBottom="4dp"
                            app:layout_collapseMode="pin"
                            app:tabGravity="fill"
                            app:tabMaxWidth="0dp"
                            app:tabMode="scrollable"
                            app:tabPaddingEnd="5dp"
                            app:tabPaddingStart="5dp"
                            app:tabRippleColor="@null"/>
                    </com.google.android.material.appbar.AppBarLayout>
                    <com.bytedance.android.live.uikit.viewpager.SSViewPager
                        android:id="@+id/subs_pager"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
                </androidx.coordinatorlayout.widget.CoordinatorLayout>
            </LinearLayout>
        </com.bytedance.android.live.ui.PkInviteUserListRefreshLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/top_banner_unlock"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="16dp"
        app:layout_constraintBottom_toTopOf="@+id/anchor_rank_unlock_view"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="20dp"/>
    <com.bytedance.android.live.revlink.impl.pk.ui.PKRankUnlockView
        android:id="@+id/anchor_rank_unlock_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_banner_unlock"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/ll_pk_invite_list_hint"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:translationZ="10dp"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="11dp"
            android:textStyle="normal"
            android:textColor="@color/ttlive_pk_rule_text_color"
            android:gravity="center"
            android:id="@+id/private_hint"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toTopOf="@+id/pk_rule_text"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginBottom="8dp"/>
        <TextView
            android:textSize="11dp"
            android:textStyle="normal"
            android:textColor="@color/ttlive_pk_rule_text_color"
            android:gravity="center"
            android:id="@+id/pk_rule_text"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:text="@string/ttlive_anchor_interact_pk_rule_notice"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/private_hint"
            app:layout_goneMarginTop="8dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/history_tips_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/iv_arrow"
            android:background="@drawable/ttlive_pk_white_trangle"
            android:layout_width="25dp"
            android:layout_height="7dp"
            android:layout_marginRight="30dp"
            app:layout_constraintBottom_toTopOf="@+id/body"
            app:layout_constraintRight_toRightOf="@+id/body"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#000"
            android:gravity="center"
            android:id="@+id/body"
            android:background="@drawable/ttlive_pk_history_record_body"
            android:layout_width="220dp"
            android:layout_height="47dp"
            android:layout_margin="7dp"
            android:layout_marginRight="12dp"
            android:text="可在这里查看PK记录并发表评价"
            android:elevation="20dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
