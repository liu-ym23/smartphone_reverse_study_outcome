<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/ttlive_bg_dialog_mobile_flow"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/content_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16dp"
            android:textColor="#e6ffffff"
            android:id="@+id/ttlive_dialog_flow_des"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ttlive_live_flow_text_des_new"
            android:layout_centerHorizontal="true"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"/>
        <RelativeLayout
            android:id="@+id/ttlive_buy_flow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:layout_below="@+id/ttlive_dialog_flow_des"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="16dp"
                android:textColor="#80ffffff"
                android:id="@+id/ttlive_buy_flow_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_go_to_buy_flow_new"
                android:layout_centerVertical="true"/>
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginLeft="2dp"
                android:src="@drawable/ttlive_ic_flow_arrow_new"
                android:scaleType="centerCrop"
                android:layout_toRightOf="@+id/ttlive_buy_flow_text"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="2dp"
                android:layout_toEndOf="@+id/ttlive_buy_flow_text"/>
        </RelativeLayout>
    </RelativeLayout>
</FrameLayout>
