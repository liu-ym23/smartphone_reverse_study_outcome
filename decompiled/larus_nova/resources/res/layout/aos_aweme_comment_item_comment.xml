<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/aos_comment_bg_layout"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.awemeopen.infra.base.image.AoImageView
        android:layout_gravity="top"
        android:id="@+id/avatar"
        android:clickable="true"
        android:layout_width="@dimen/aos_comment_avatar_size"
        android:layout_height="@dimen/aos_comment_avatar_size"
        android:layout_marginTop="2dp"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/aos_text_tertiary"
        android:ellipsize="end"
        android:id="@+id/title"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintEnd_toStartOf="@+id/style"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="@+id/avatar"
        app:layout_constraintWidth_default="wrap"
        app:layout_goneMarginEnd="10dp"
        app:layout_goneMarginRight="10dp"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/aos_const_text_inverse"
        android:layout_gravity="center_vertical"
        android:id="@+id/style"
        android:background="@drawable/comment_tag_style_author"
        android:paddingLeft="3.5dp"
        android:paddingRight="3.5dp"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:layout_toEndOf="@+id/title"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/title"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <com.bytedance.awemeopen.apps.framework.feed.desc.MentionTextView
        android:textSize="15sp"
        android:textColor="@color/aos_text_primary"
        android:id="@+id/content"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <com.bytedance.awemeopen.apps.framework.feed.follow.util.DuxTextView
        android:textSize="13dp"
        android:textColor="@color/TextReverse4"
        android:id="@+id/comment_fold_tips"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/aweme_comment_comment_is_folded"
        android:drawablePadding="2dp"
        android:drawableStart="@drawable/aweme_comment_exclamation_outline"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/aos_text_quaternary"
        android:id="@+id/time"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/view_stubs"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/aos_text_tertiary"
        android:id="@+id/reply"
        android:paddingLeft="4dp"
        android:paddingTop="1dp"
        android:paddingRight="4dp"
        android:paddingBottom="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="回复"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/time"
        app:layout_constraintTop_toBottomOf="@+id/view_stubs"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/view_stubs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/content">
        <ViewStub
            android:id="@+id/image_view_stub"
            android:layout="@layout/aos_aweme_comment_view_stub_layout_image"
            android:layout_width="100dp"
            android:layout_height="100dp"/>
        <ViewStub
            android:id="@+id/gif_emoji_view_stub"
            android:layout="@layout/aos_aweme_comment_view_stub_layout_gif_emoji"
            android:layout_width="100dp"
            android:layout_height="100dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/digg_bury_container"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:paddingEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/time"/>
</androidx.constraintlayout.widget.ConstraintLayout>
