<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/bg_body"
    android:paddingTop="@dimen/space_kit_len_48"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/header_banner_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_13"
        layout="@layout/list_pin_folder_banner_view"/>
    <net.lucode.hackware.magicindicator.MagicIndicator
        android:id="@+id/home_drive_magicindcator"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_kit_len_40"/>
    <View
        android:id="@+id/divider"
        android:background="@color/line_divider_default"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <com.bytedance.ee.bear.list.homepage.tab.HomeViewPager
        android:id="@+id/home_drive_viewpager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
