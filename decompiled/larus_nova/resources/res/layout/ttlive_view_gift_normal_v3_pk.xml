<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <com.bytedance.android.livesdk.gift.platform.business.normal.view.v2.TrayContainerView
        android:id="@+id/normal_gift_tray_container"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="12dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/normal_gift_bg_view"
            android:layout_width="138dp"
            android:layout_height="36dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/normal_gift_bg_view_temp"
            android:visibility="visible"
            android:layout_width="138dp"
            android:layout_height="36dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.bytedance.android.livesdk.gift.platform.business.normal.view.v2.TrayWaveControllerView
            android:id="@+id/wave_container"
            android:visibility="gone"
            android:layout_width="138dp"
            android:layout_height="36dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/exit_webp_container"
            android:visibility="gone"
            android:layout_width="138dp"
            android:layout_height="36dp"
            android:layout_marginBottom="4dp"
            android:importantForAccessibility="yes"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <ImageView
            android:id="@+id/user_avatar_iv"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="3dp"
            android:src="@drawable/ttlive_img_avatar_empty"
            android:layout_marginStart="3dp"
            app:layout_constraintBottom_toBottomOf="@+id/normal_gift_bg_view"
            app:layout_constraintStart_toStartOf="@+id/normal_gift_bg_view"
            app:layout_constraintTop_toTopOf="@+id/normal_gift_bg_view"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/iv_avatar_border"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:layout_constraintBottom_toBottomOf="@+id/user_avatar_iv"
            app:layout_constraintEnd_toEndOf="@+id/user_avatar_iv"
            app:layout_constraintStart_toStartOf="@+id/user_avatar_iv"
            app:layout_constraintTop_toTopOf="@+id/user_avatar_iv"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/user_avatar_decor_iv"
            android:visibility="gone"
            android:layout_width="44dp"
            android:layout_height="14dp"
            app:layout_constraintBottom_toBottomOf="@+id/normal_gift_bg_view"
            app:layout_constraintStart_toStartOf="@+id/normal_gift_bg_view"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#a3ffffff"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/post_effect_subtitle"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:maxLines="1"
            android:importantForAccessibility="no"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/normal_gift_bg_view"
            app:layout_constraintEnd_toStartOf="@+id/dynamic_gift_icon"
            app:layout_constraintStart_toEndOf="@+id/user_avatar_iv"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/multi_user_avatar_container"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="3dp"
            android:layout_marginStart="3dp"
            app:layout_constraintBottom_toBottomOf="@+id/normal_gift_bg_view"
            app:layout_constraintStart_toStartOf="@+id/normal_gift_bg_view"
            app:layout_constraintTop_toTopOf="@+id/normal_gift_bg_view">
            <ImageView
                android:id="@+id/multi_user_avatar_bottom"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ttlive_img_avatar_empty"
                app:layout_constraintEnd_toEndOf="@+id/multi_user_avatar_container"
                app:layout_constraintTop_toTopOf="@+id/multi_user_avatar_container"/>
            <ImageView
                android:id="@+id/multi_user_avatar_top"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ttlive_img_avatar_empty"
                app:layout_constraintBottom_toBottomOf="@+id/multi_user_avatar_container"
                app:layout_constraintStart_toStartOf="@+id/multi_user_avatar_container"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center_vertical"
            android:id="@+id/user_info_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginBottom="0dp"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/normal_gift_bg_view"
            app:layout_constraintEnd_toStartOf="@+id/dynamic_gift_icon"
            app:layout_constraintStart_toEndOf="@+id/user_avatar_iv"
            app:layout_constraintTop_toTopOf="@+id/normal_gift_bg_view">
            <TextView
                android:textSize="12dp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/user_name_tv"
                android:layout_width="wrap_content"
                android:layout_height="17dp"
                android:maxWidth="55dp"
                android:maxLines="1"
                android:maxEms="4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="10sp"
                android:textColor="#a3ffffff"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/gift_description_tv"
                android:layout_width="0dp"
                android:layout_height="14dp"
                android:layout_marginBottom="1dp"
                android:maxLines="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/user_name_tv"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.bytedance.android.livesdk.gift.platform.business.normal.view.v2.GiftIconMaskView
            android:id="@+id/gift_icon_animation_view"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/normal_gift_bg_view"
            app:layout_constraintEnd_toEndOf="@+id/normal_gift_bg_view"
            app:layout_constraintTop_toTopOf="@+id/normal_gift_bg_view"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/dynamic_gift_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintEnd_toEndOf="@+id/normal_gift_bg_view"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/gift_type_iv"
            android:layout_width="18dp"
            android:layout_height="9dp"
            android:layout_marginLeft="2dp"
            android:layout_marginStart="2dp"
            app:layout_constraintEnd_toEndOf="@+id/normal_gift_bg_view"
            app:layout_constraintTop_toTopOf="@+id/normal_gift_bg_view"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/gift_right_tips_iv"
            android:visibility="gone"
            android:layout_width="200dp"
            android:layout_height="32dp"
            android:layout_marginLeft="33dp"
            android:layout_marginStart="33dp"
            app:layout_constraintBottom_toBottomOf="@+id/gift_icon_animation_view"
            app:layout_constraintStart_toStartOf="@+id/gift_icon_animation_view"
            app:layout_constraintTop_toTopOf="@+id/gift_icon_animation_view"/>
        <View
            android:id="@+id/dummy_view"
            android:layout_width="0.5dp"
            android:layout_height="0.5dp"
            app:layout_constraintStart_toEndOf="@+id/gift_icon_animation_view"
            app:layout_constraintTop_toTopOf="@+id/normal_gift_bg_view"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/group_body"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@+id/dummy_view"
            app:layout_constraintTop_toTopOf="@+id/normal_gift_bg_view">
            <TextView
                android:textSize="14dp"
                android:textColor="#ffffff"
                android:gravity="bottom"
                android:id="@+id/group_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:text="@string/ttlive_gift_count"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
        <View
            android:id="@+id/dummy_view_1"
            android:layout_width="0.5dp"
            android:layout_height="0.5dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="@+id/normal_gift_bg_view"
            app:layout_constraintTop_toTopOf="@+id/normal_gift_bg_view"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:gravity="center"
            android:id="@+id/special_combo_effect"
            android:visibility="visible"
            android:layout_width="88dp"
            android:layout_height="38dp"
            app:layout_constraintBottom_toBottomOf="@+id/normal_gift_bg_view"
            app:layout_constraintStart_toEndOf="@+id/dummy_view_1"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/combo_body"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/normal_gift_bg_view"
            app:layout_constraintStart_toEndOf="@+id/normal_gift_bg_view">
            <TextView
                android:textSize="18dp"
                android:textColor="#ffffff"
                android:gravity="bottom"
                android:id="@+id/combo_count_x"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_gift_count"/>
            <TextView
                android:textSize="24dp"
                android:textColor="#ffffff"
                android:gravity="bottom"
                android:id="@+id/combo_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
    </com.bytedance.android.livesdk.gift.platform.business.normal.view.v2.TrayContainerView>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/enter_anima_container"
        android:visibility="gone"
        android:layout_width="211dp"
        android:layout_height="44dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
