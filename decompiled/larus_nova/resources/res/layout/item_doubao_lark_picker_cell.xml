<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:background="@color/flow_ud_bg_base_3"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <FrameLayout
        android:id="@+id/checkbox_container"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <include
            android:id="@+id/include_doubao_checkbox"
            layout="@layout/doubao_checkbox"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/iv_avatar_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="@dimen/doubao_picker_avatar_size"
        android:layout_height="@dimen/doubao_picker_avatar_size"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.larksuite.component.ui.avatar.v2.LarkAvatarView
            android:id="@+id/iv_avatar"
            android:layout_width="@dimen/doubao_picker_avatar_size"
            android:layout_height="@dimen/doubao_picker_avatar_size"
            app:radius="@dimen/doubao_picker_avatar_radius"/>
        <com.larksuite.component.ui.avatar.v2.LarkAvatarView
            android:layout_gravity="end|bottom"
            android:id="@+id/iv_avatar_mini"
            android:visibility="gone"
            android:layout_width="@dimen/doubao_thread_avatar_badge_size"
            android:layout_height="@dimen/doubao_thread_avatar_badge_size"
            app:radius="8dp"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/text_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/checkbox_container"
        app:layout_constraintStart_toEndOf="@+id/iv_avatar_container"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="16dp">
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/doubao_picker_title_text"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tag_container"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/tag_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_title"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginStart="0dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/divider"
        android:background="@color/larus_neutral_transparent_1"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/text_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
