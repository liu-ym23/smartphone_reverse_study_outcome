<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shopping_homepage_layout_native_video_card_238835825"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.shopping.api.mall.common.homepage.card.common.ECUpdateHeightConstraintLayout
        android:id="@+id/mall_video_card_root_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/video_cover_image"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toTopOf="@+id/bottom_info_view"
            app:layout_constraintDimensionRatio="0.75"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.shopping.api.mall.common.homepage.card.common.ECRoundedCornerImageView
            android:id="@+id/video_view_frame"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/video_cover_image"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/video_cover_image"/>
        <com.bytedance.android.shopping.api.mall.common.homepage.card.common.ECRoundedFrameLayout
            android:id="@+id/video_view_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/video_cover_image"
            app:layout_constraintDimensionRatio="0.75"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/video_cover_image">
            <com.bytedance.android.shopping.api.mall.common.homepage.card.common.ECGradientView
                android:id="@+id/player_mask"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.bytedance.android.shopping.api.mall.common.homepage.card.common.ECRoundedFrameLayout>
        <ImageView
            android:id="@+id/mall_homepage_card_video_mute_view"
            android:paddingLeft="10dp"
            android:paddingTop="10dp"
            android:paddingRight="10dp"
            android:paddingBottom="10dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/shopping_homepage_ic_mute_playback"
            android:importantForAccessibility="no"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/video_layer_play_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/shopping_homepage_video_play"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/cover_bottom_mask"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/video_cover_image"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/video_layer_merchant_image"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginBottom="10dp"
            android:importantForAccessibility="no"
            android:layout_marginStart="10dp"
            app:fadeDuration="300"
            app:layout_constraintBottom_toBottomOf="@+id/video_view_container"
            app:layout_constraintLeft_toLeftOf="parent"
            app:roundAsCircle="false"
            app:roundedCornerRadius="10dp"/>
        <TextView
            android:textSize="14dp"
            android:ellipsize="end"
            android:id="@+id/video_layer_merchant_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:importantForAccessibility="no"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="7dp"
            app:layout_constraintBottom_toBottomOf="@+id/video_layer_merchant_image"
            app:layout_constraintLeft_toRightOf="@+id/video_layer_merchant_image"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/video_layer_merchant_image"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#ffffff"
            android:gravity="center_vertical"
            android:id="@+id/video_layer_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="7dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/video_view_container"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <com.bytedance.android.shopping.mall.homepage.card.common.ProductView
            android:id="@+id/product_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/video_view_container"/>
        <com.bytedance.android.shopping.mall.homepage.card.common.BottomInfoViewForVideo
            android:id="@+id/bottom_info_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="6dp"
            android:layout_marginBottom="8dp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/video_cover_image"/>
        <View
            android:id="@+id/live_header_view_stub"
            android:layout_width="0dp"
            android:layout_height="0dp"/>
        <include
            android:id="@+id/video_watched_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_weight="1"
            layout="@layout/shopping_homepage_card_watched_layout"/>
        <FrameLayout
            android:id="@+id/coin_panel"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="10dp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bottom_info_view"/>
    </com.bytedance.android.shopping.api.mall.common.homepage.card.common.ECUpdateHeightConstraintLayout>
    <FrameLayout
        android:id="@+id/wind_vane_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mall_video_card_root_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
