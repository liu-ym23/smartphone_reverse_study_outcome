<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/permission_root_layout"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.widgets.BaseTitleBar
        android:id="@+id/permission_title_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"/>
    <ScrollView
        android:id="@+id/scroll_view"
        android:background="@color/bg_body"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedance.ee.bear.widgets.universedesign.SpaceEmptyState
                android:id="@+id/no_data_empty_state"
                android:layout_width="352dp"
                android:layout_marginTop="80dp"
                app:ud_empty_imageRes="@drawable/ccm_empty_neutral_no_access"
                app:ud_empty_title="@string/Doc_Permission_OwnerNotAuthorizeCross"
                style="@style/SpaceEmptyStatusStyle"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/perm_background"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/permission_type_choose"
                    android:layout_width="match_parent"
                    android:layout_height="56dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/text_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Doc_Facade_ApplyFor"/>
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_fill_default"
                        android:id="@+id/permission_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Doc_Facade_ReadPermission"
                        android:drawablePadding="6dp"
                        android:drawableEnd="@drawable/perm_down_arrow"
                        android:layout_marginStart="5dp"/>
                </LinearLayout>
                <com.bytedance.ee.bear.widgets.universedesign.SpaceEditText
                    android:textSize="14sp"
                    android:id="@+id/edit_optional"
                    android:paddingLeft="12dp"
                    android:paddingTop="12dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/Doc_Facade_AddRemarks"
                    android:cursorVisible="true"
                    app:ud_backgroundColor="@color/ud_edittext_white_bg"
                    app:ud_strokeColor="@color/ud_edittext_stroke"
                    app:ud_strokeWidth="1dp"
                    style="@style/UDEditText"/>
                <com.larksuite.component.universe_design.button.UDButton
                    android:textSize="17sp"
                    android:textColor="@color/static_white"
                    android:gravity="center"
                    android:id="@+id/send_request"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="18dp"
                    android:text="@string/Doc_Permission_SendRequest"
                    app:ud_backgroundColor="@drawable/perm_apply_button_blue_bg"
                    app:ud_radius="m"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
