<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_vertical"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/dp_16"
    android:layout_marginRight="@dimen/dp_16">
    <com.larksuite.component.blockit.hashtag.widget.SwipeLayout
        android:id="@+id/swipeLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_gravity="right"
            android:id="@+id/behind_view"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foregroundGravity="center"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/container_view"
            android:background="@color/bg_base"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/content_title_view"
                android:background="@drawable/bg_setting_group_item_round_top"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_36"
                android:layout_marginTop="@dimen/dp_16"
                android:paddingStart="@dimen/dp_16">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/list_icon_img"
                    android:layout_width="12sp"
                    android:layout_height="12sp"
                    android:src="@drawable/ud_icon_expand_down_filled"
                    android:tint="@color/icon_n2"
                    android:layout_marginEnd="@dimen/dp_8d5"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold"
                    android:textColor="@color/text_title"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/list_icon_title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold"
                    android:textColor="@color/text_placeholder"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/list_icon_count_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_6"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/content_container_view"
                android:background="@drawable/bg_setting_group_item_rectangle"
                android:visibility="visible"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/dp_70">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_todo_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/ll_todo_content_container"
                        android:paddingRight="@dimen/dp_16"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <RelativeLayout
                            android:id="@+id/complete_checkbox_container"
                            android:layout_width="@dimen/dp_44"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:id="@+id/complete_checkbox"
                                android:layout_width="20sp"
                                android:layout_height="20sp"
                                android:layout_marginLeft="@dimen/dp_14"
                                android:layout_marginTop="15dp"/>
                            <com.airbnb.lottie.LottieAnimationView
                                android:id="@+id/complete_checkbox_lottie"
                                android:visibility="gone"
                                android:layout_width="33sp"
                                android:layout_height="33sp"
                                android:layout_marginLeft="@dimen/dp_9d5"
                                android:layout_marginTop="10dp"
                                app:lottie_autoPlay="false"
                                app:lottie_loop="true"/>
                        </RelativeLayout>
                        <LinearLayout
                            android:layout_gravity="center_vertical"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_12"
                            android:layout_marginBottom="@dimen/dp_12">
                            <LinearLayout
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:id="@+id/title_container"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1">
                                    <com.ss.android.lark.widget.light.LKUILightTextView
                                        android:textSize="@dimen/sp_16"
                                        android:id="@+id/title_rich_text"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:minHeight="@dimen/dp_22"
                                        app:layout_constraintBottom_toBottomOf="parent"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent"/>
                                    <View
                                        android:id="@+id/item_finish_line"
                                        android:background="@color/text_caption"
                                        android:layout_width="0dp"
                                        android:layout_height="@dimen/dp_1"
                                        android:layout_marginTop="@dimen/dp_2"
                                        android:layout_centerVertical="true"
                                        app:layout_constraintBottom_toBottomOf="@+id/title_rich_text"
                                        app:layout_constraintLeft_toLeftOf="@+id/title_rich_text"
                                        app:layout_constraintRight_toRightOf="@+id/title_rich_text"
                                        app:layout_constraintTop_toTopOf="@+id/title_rich_text"/>
                                </androidx.constraintlayout.widget.ConstraintLayout>
                                <com.ss.android.lark.todo.impl.features.common.widget.TaskUDAvatarList
                                    android:id="@+id/task_owners"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:task_ud_avatarList_avatarSize="28sp"
                                    app:task_ud_avatarList_maxCount="1"
                                    app:task_ud_avatarList_overlapSize="4sp"
                                    app:task_ud_avatarList_text_size="14sp"/>
                            </LinearLayout>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@+id/ll_end_time"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_4">
                                <ImageView
                                    android:layout_gravity="center_vertical"
                                    android:id="@+id/img_end_time"
                                    android:layout_width="14sp"
                                    android:layout_height="14sp"
                                    android:src="@drawable/ud_icon_calendar_date_outlined"/>
                                <TextView
                                    android:textSize="@dimen/sp_14"
                                    android:id="@+id/tv_end_time"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/dp_4"
                                    android:singleLine="true"/>
                                <ImageView
                                    android:layout_gravity="center_vertical"
                                    android:id="@+id/todo_reminder_status"
                                    android:layout_width="14sp"
                                    android:layout_height="14sp"
                                    android:src="@drawable/ud_icon_bell_outlined"
                                    android:layout_marginStart="@dimen/dp_8"/>
                                <ImageView
                                    android:layout_gravity="center_vertical"
                                    android:id="@+id/todo_repeat_status"
                                    android:layout_width="14sp"
                                    android:layout_height="14sp"
                                    android:src="@drawable/ud_icon_repeat_outlined"
                                    android:layout_marginStart="@dimen/dp_8"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:id="@+id/ll_message_divider"
                        android:background="@color/line_divider_default"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_05"
                        android:layout_marginLeft="@dimen/dp_44"
                        android:layout_marginRight="@dimen/dp_16"/>
                    <LinearLayout
                        android:id="@+id/ll_message_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/text_placeholder"
                            android:ellipsize="end"
                            android:id="@+id/tv_message_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp_44"
                            android:layout_marginTop="@dimen/dp_8"
                            android:layout_marginRight="@dimen/dp_16"
                            android:layout_marginBottom="@dimen/dp_8"
                            android:maxLines="1"/>
                    </LinearLayout>
                </LinearLayout>
                <View
                    android:id="@+id/divider_todo_item"
                    android:background="@color/line_divider_default"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="@dimen/dp_44"/>
            </LinearLayout>
        </LinearLayout>
    </com.larksuite.component.blockit.hashtag.widget.SwipeLayout>
</LinearLayout>
