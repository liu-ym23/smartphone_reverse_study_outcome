<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="bottom"
    android:layout_gravity="bottom"
    android:background="@color/ud_N300"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center"
        android:background="@color/ud_N300"
        android:padding="@dimen/space_kit_len_8"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.ee.bear.bitable.card.view.cell.number.STNumberKeyboardView
            android:layout_gravity="center"
            android:id="@+id/number_keyboard_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:shadowRadius="0"
            android:keyBackground="@drawable/number_keyboard_btn_center_selector"
            android:keyTextSize="24sp"
            android:keyTextColor="@color/text_title"/>
    </FrameLayout>
</FrameLayout>
