<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/office_doubao_ui_demo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Doubao New UI Component Demo"/>
        <Button
            android:id="@+id/office_doubao_ui_demo_menu_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Show More Menu"/>
        <Button
            android:id="@+id/office_doubao_ui_demo_list_menu_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Show Long-Press Menu"/>
        <Button
            android:id="@+id/office_doubao_ui_demo_plus_menu_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Show Plus Menu"/>
        <Button
            android:id="@+id/office_doubao_ui_demo_upload_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Show Upload Component"/>
    </LinearLayout>
</FrameLayout>
