<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="16dp"
    android:paddingRight="20dp"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ttlive_mid_bottom_item_area_height">
    <TextView
        android:textSize="15sp"
        android:textColor="@color/ttlive_ps_panel_word_75_gray"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_comment_show_video"
        android:layout_weight="1"/>
    <ImageView
        android:background="@drawable/ttlive_ps_panel_arrow"
        android:layout_width="20dp"
        android:layout_height="20dp"/>
</LinearLayout>
