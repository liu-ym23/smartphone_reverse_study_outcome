<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:minHeight="80dp">
    <com.bytedance.android.livesdk.widget.VHeadView
        android:id="@+id/iv_user_head"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="12dp"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:minHeight="48dp"
        android:layout_weight="1">
        <RelativeLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/user_name_layout"
            android:layout_width="match_parent"
            android:layout_height="21dp"
            android:baselineAligned="false">
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_white_90"
                android:ellipsize="end"
                android:id="@+id/tv_user_name"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:layout_toLeftOf="@+id/icon_container"
                android:layout_toStartOf="@+id/icon_container"/>
            <LinearLayout
                android:id="@+id/icon_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true">
                <com.bytedance.android.live.core.widget.HSImageView
                    android:id="@+id/iv_user_level"
                    android:layout_width="28dp"
                    android:layout_height="14dp"
                    android:layout_marginLeft="8dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/fans_club_icon_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:layout_marginLeft="4dp">
                    <TextView
                        android:textSize="8dp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/tv_user_fan_club_name"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"/>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/op_user_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="18dp">
            <TextView
                android:textSize="13dp"
                android:textColor="@color/ttlive_commonui_white_50"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_op_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/ttlive_commonui_white_50"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/ttlive_live_room_manage_op"
                android:maxLines="1"/>
        </LinearLayout>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_commonui_white_50"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_op_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:layout_toLeftOf="@+id/btn_handle"
            android:layout_toRightOf="@+id/iv_user_head"
            android:layout_below="@+id/user_stat_layout"/>
    </LinearLayout>
    <com.bytedance.android.livesdk.chatroom.roommanage.common.RoomManageButton
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/btn_handle"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="16dp"
        android:minWidth="64dp"/>
</LinearLayout>
