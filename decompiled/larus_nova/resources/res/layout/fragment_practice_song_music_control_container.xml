<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.soloktv.view.MusicControlItem
        android:id="@+id/mci_origin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:item_enable_font_scale="true"
        app:layout_constraintBottom_toBottomOf="@+id/pause_resume_btn"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/mci_adjust"
        app:layout_constraintTop_toTopOf="@+id/pause_resume_btn"/>
    <com.bytedance.android.live.soloktv.view.MusicControlItem
        android:id="@+id/mci_adjust"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:item_enable_font_scale="true"
        app:layout_constraintBottom_toBottomOf="@+id/pause_resume_btn"
        app:layout_constraintLeft_toRightOf="@+id/mci_origin"
        app:layout_constraintRight_toLeftOf="@+id/pause_resume_btn"
        app:layout_constraintTop_toTopOf="@+id/pause_resume_btn"/>
    <com.bytedance.android.live.soloktv.view.MusicStartButton
        android:id="@+id/pause_resume_btn"
        android:layout_width="72dp"
        android:layout_height="72dp"
        app:button_enable_font_scale="true"
        app:layout_constraintBottom_toTopOf="@+id/top_music_bar"
        app:layout_constraintLeft_toRightOf="@+id/mci_adjust"
        app:layout_constraintRight_toLeftOf="@+id/mci_repeat"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.soloktv.view.SoloKtvMusicTimeInfoBar
        android:id="@+id/top_music_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:time_info_enable_font_scale="true"/>
    <com.bytedance.android.live.soloktv.view.MusicControlItem
        android:id="@+id/mci_repeat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:item_enable_font_scale="true"
        app:layout_constraintBottom_toBottomOf="@+id/pause_resume_btn"
        app:layout_constraintLeft_toRightOf="@+id/pause_resume_btn"
        app:layout_constraintRight_toLeftOf="@+id/mci_finish"
        app:layout_constraintTop_toTopOf="@+id/pause_resume_btn"/>
    <com.bytedance.android.live.soloktv.view.MusicControlItem
        android:id="@+id/mci_finish"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:item_enable_font_scale="true"
        app:layout_constraintBottom_toBottomOf="@+id/pause_resume_btn"
        app:layout_constraintLeft_toRightOf="@+id/mci_repeat"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/pause_resume_btn"/>
</androidx.constraintlayout.widget.ConstraintLayout>
