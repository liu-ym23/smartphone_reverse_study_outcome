<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/dora_o_bg_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/onboarding_container"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0"
        android:paddingStart="?attr/larus_dp_12"
        android:paddingEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toTopOf="@+id/bottom_controls"
        app:layout_constraintTop_toTopOf="parent">
        <com.obric.oui.header.HeaderInfoView
            android:id="@+id/mode_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/cards_wrapper"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_0"
            android:layout_marginTop="?attr/larus_dp_16"
            android:layout_marginBottom="?attr/larus_dp_16"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.obric.oui.layout.OUILinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/card_phone"
                    android:background="@drawable/dora_o_bg_card"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/larus_dp_0"
                    android:layout_weight="1">
                    <ImageView
                        android:id="@+id/card_phone_icon"
                        android:layout_width="?attr/larus_dp_56"
                        android:layout_height="?attr/larus_dp_56"
                        android:src="@drawable/dora_o_ic_phone_rectangle_horizontal_line"
                        android:importantForAccessibility="no"/>
                    <com.obric.oui.button.OButton
                        android:textSize="?attr/larus_sp_14"
                        android:textColor="@color/oui_basic_text_3"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/top_language_button"
                        android:layout_width="wrap_content"
                        android:layout_height="?attr/larus_dp_38"
                        android:layout_marginTop="?attr/larus_dp_16"
                        android:maxWidth="?attr/larus_dp_200"
                        android:minWidth="?attr/larus_dp_100"
                        android:maxLines="1"
                        android:paddingStart="?attr/larus_dp_12"
                        android:paddingEnd="?attr/larus_dp_12"
                        style="@style/OStyleV2.OButton.S.Trans.Neutral"/>
                </com.obric.oui.layout.OUILinearLayout>
                <com.obric.oui.layout.OUILinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/card_glasses"
                    android:background="@drawable/dora_o_bg_card"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/larus_dp_0"
                    android:layout_marginTop="?attr/larus_dp_8"
                    android:layout_weight="1">
                    <com.obric.oui.button.OButton
                        android:textSize="?attr/larus_sp_14"
                        android:textColor="@color/oui_basic_text_3"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/bottom_language_button"
                        android:layout_width="wrap_content"
                        android:layout_height="?attr/larus_dp_38"
                        android:maxWidth="?attr/larus_dp_200"
                        android:minWidth="?attr/larus_dp_100"
                        android:maxLines="1"
                        android:paddingStart="?attr/larus_dp_12"
                        android:paddingEnd="?attr/larus_dp_12"
                        style="@style/OStyleV2.OButton.S.Trans.Neutral"/>
                    <ImageView
                        android:id="@+id/card_glasses_icon"
                        android:layout_width="?attr/larus_dp_56"
                        android:layout_height="?attr/larus_dp_56"
                        android:layout_marginTop="?attr/larus_dp_16"
                        android:src="@drawable/dora_o_ic_glasses"
                        android:importantForAccessibility="no"/>
                </com.obric.oui.layout.OUILinearLayout>
            </LinearLayout>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/cards_swap_button"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_42"
                android:layout_height="?attr/larus_dp_42"
                android:src="@drawable/dora_o_ic_switch_language_si"
                android:contentDescription="@string/larus_dora_simul_interpret_language_picker_title_cn"/>
        </FrameLayout>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/translate_area"
        android:paddingTop="?attr/larus_dp_96"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toTopOf="@+id/bottom_controls"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/guideline_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5"/>
        <com.obric.oui.layout.OUILinearLayout
            android:orientation="vertical"
            android:id="@+id/top_card"
            android:background="@drawable/dora_o_bg_card"
            android:paddingTop="?attr/larus_dp_16"
            android:paddingBottom="?attr/larus_dp_12"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_0"
            android:layout_marginBottom="?attr/larus_dp_2"
            android:paddingStart="?attr/larus_dp_16"
            android:paddingEnd="?attr/larus_dp_16"
            app:layout_constraintBottom_toTopOf="@+id/guideline_horizontal"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/top_card_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_gravity="start|center_vertical"
                        android:id="@+id/top_card_icon"
                        android:layout_width="?attr/larus_dp_32"
                        android:layout_height="?attr/larus_dp_32"
                        android:src="@drawable/dora_o_ic_phone_rectangle_horizontal_line"
                        android:importantForAccessibility="no"/>
                    <com.obric.oui.button.OButton
                        android:textSize="?attr/larus_sp_14"
                        android:textColor="@color/dora_o_simul_lang_label"
                        android:gravity="center"
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/top_language_label"
                        android:paddingTop="?attr/larus_dp_7"
                        android:paddingBottom="?attr/larus_dp_7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="?attr/larus_dp_0"
                        android:minHeight="?attr/larus_dp_0"
                        android:paddingStart="?attr/larus_dp_12"
                        android:paddingEnd="?attr/larus_dp_12"
                        style="@style/OStyleV2.OButton.S.Trans.Neutral"/>
                </FrameLayout>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="?attr/larus_dp_0"
                    android:layout_weight="1">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/top_subtitles"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="?attr/larus_dp_16"
                        android:overScrollMode="never"/>
                    <TextView
                        android:textSize="?attr/larus_sp_24"
                        android:textStyle="bold"
                        android:textColor="@color/dora_o_simul_listening_blue"
                        android:layout_gravity="start|top"
                        android:id="@+id/listening_hint"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="?attr/larus_dp_12"/>
                </FrameLayout>
            </LinearLayout>
        </com.obric.oui.layout.OUILinearLayout>
        <com.obric.oui.layout.OUILinearLayout
            android:orientation="vertical"
            android:id="@+id/bottom_card"
            android:background="@drawable/dora_o_bg_card"
            android:paddingTop="?attr/larus_dp_16"
            android:paddingBottom="?attr/larus_dp_12"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_0"
            android:layout_marginTop="?attr/larus_dp_2"
            android:paddingStart="?attr/larus_dp_16"
            android:paddingEnd="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/guideline_horizontal">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/bottom_card_icon"
                    android:layout_width="?attr/larus_dp_32"
                    android:layout_height="?attr/larus_dp_32"
                    android:src="@drawable/dora_o_ic_glasses"
                    android:importantForAccessibility="no"/>
                <com.obric.oui.button.OButton
                    android:textSize="?attr/larus_sp_14"
                    android:textColor="@color/dora_o_simul_lang_label"
                    android:gravity="center"
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/bottom_language_label"
                    android:paddingTop="?attr/larus_dp_7"
                    android:paddingBottom="?attr/larus_dp_7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="?attr/larus_dp_0"
                    android:minHeight="?attr/larus_dp_0"
                    android:paddingStart="?attr/larus_dp_12"
                    android:paddingEnd="?attr/larus_dp_12"
                    style="@style/OStyleV2.OButton.S.Trans.Neutral"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_0"
                android:layout_weight="1">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/bottom_subtitles"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="?attr/larus_dp_16"
                    android:overScrollMode="never"/>
                <TextView
                    android:textSize="?attr/larus_sp_24"
                    android:textStyle="bold"
                    android:textColor="@color/dora_o_text_secondary"
                    android:layout_gravity="start|top"
                    android:id="@+id/bottom_listening_hint"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_12"/>
            </FrameLayout>
        </com.obric.oui.layout.OUILinearLayout>
        <com.larus.dora.o.impl.simul.OSimulSliderHandleView
            android:id="@+id/slider_handle"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_20"
            app:layout_constraintBottom_toBottomOf="@+id/guideline_horizontal"
            app:layout_constraintTop_toBottomOf="@+id/guideline_horizontal"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/page_mask"
        android:background="@color/dora_o_bg_page"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.obric.oui.actionbar.v2.OBottomActionBarNormalVertical
        android:id="@+id/bottom_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.obric.oui.button.OButton
            android:gravity="center"
            android:id="@+id/start_button"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_48"
            android:text="@string/larus_dora_g_device_start_trans_cn"
            style="@style/OStyleV2.OButton.L.Standard.Primary"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/translating_controls"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.button.OButton
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/dora_o_text_primary"
                android:gravity="center"
                android:id="@+id/flip_button"
                android:layout_width="wrap_content"
                android:layout_height="?attr/larus_dp_40"
                android:text="@string/larus_dora_g_translate_switchscreen_cn"
                android:drawablePadding="?attr/larus_dp_4"
                android:drawableStart="@drawable/dora_o_ic_phone_rectangle_line"
                android:layout_marginStart="-8dp"
                style="@style/OStyleV2.OButton.M.Trans.Neutral"/>
            <Space
                android:layout_width="?attr/larus_dp_0"
                android:layout_height="?attr/larus_dp_1"
                android:layout_weight="1"/>
            <com.obric.oui.button.OButton
                android:gravity="center"
                android:id="@+id/end_button"
                android:layout_width="?attr/larus_dp_150"
                android:layout_height="?attr/larus_dp_48"
                android:text="@string/larus_dora_recording_mode_end_cn"
                android:layout_marginEnd="-8dp"
                style="@style/OStyleV2.OButton.L.Standard.Red"/>
        </LinearLayout>
    </com.obric.oui.actionbar.v2.OBottomActionBarNormalVertical>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/simul_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</androidx.constraintlayout.widget.ConstraintLayout>
