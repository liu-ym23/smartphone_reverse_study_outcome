<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/edit_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/seekbar"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_kit_len_32"
            android:layout_marginBottom="@dimen/space_kit_len_32"
            android:progressDrawable="@drawable/bitable_cell_progress_edit_seek_bar"
            android:minHeight="@dimen/space_kit_len_10"
            android:thumb="@drawable/bitable_cell_progress_edit_seek_thumb"
            android:layout_marginStart="@dimen/space_kit_len_15"
            android:layout_marginEnd="@dimen/space_kit_len_15"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedance.ee.bear.bitable.card.view.cell.text.BitableTextFieldEditor
                android:id="@+id/progress_edt"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_kit_len_48"
                android:layout_marginBottom="@dimen/space_kit_len_40"
                android:maxLines="1"
                android:singleLine="true"
                android:layout_marginStart="@dimen/space_kit_len_15"
                android:layout_marginEnd="@dimen/space_kit_len_15"
                app:ud_backgroundColor="@color/ud_edittext_white_bg"
                app:ud_editText_clearBtnEnabled="true"
                app:ud_radius="m"
                app:ud_strokeColor="@color/ud_edittext_stroke"
                app:ud_strokeWidth="1dp"
                style="@style/UDEditText.Normal"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/unfocused_progress_tip"
                android:background="@drawable/bitable_cell_progress_edit_unfocus_show"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_kit_len_48"
                android:layout_marginBottom="@dimen/space_kit_len_40"
                android:maxLines="1"
                android:singleLine="true"
                android:layout_marginStart="@dimen/space_kit_len_15"
                android:layout_marginEnd="@dimen/space_kit_len_15"
                style="@style/UDEditText.Normal"/>
        </FrameLayout>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/numberPlaceHolder"
            android:background="@color/ud_N300"
            android:padding="@dimen/space_kit_len_8"
            android:focusable="true"
            android:visibility="invisible"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedance.ee.bear.bitable.card.view.cell.number.STNumberKeyboardView
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:shadowRadius="0"
                android:keyBackground="@drawable/number_keyboard_btn_center_selector"
                android:keyTextSize="24sp"
                android:keyTextColor="@color/text_title"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
