<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/blank_area_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:background="@drawable/ttlive_bg_expand_coupon_enter_room_dialog"
        android:paddingBottom="38dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="17dp"
            android:textColor="#161823"
            android:gravity="center"
            android:id="@+id/tv_coupon_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_coupon_grow_ago"
            android:background="@drawable/ttlive_bg_expand_coupon"
            android:layout_width="80dp"
            android:layout_height="96dp"
            app:layout_constraintBottom_toBottomOf="@+id/cl_coupon_grow_after"
            app:layout_constraintLeft_toLeftOf="@+id/btn_direct_exit_room"
            app:layout_constraintRight_toRightOf="@+id/btn_direct_exit_room">
            <TextView
                android:textSize="11dp"
                android:textColor="@color/ttlive_expand_coupon_threshold_color"
                android:id="@+id/tv_grow_ago_coupon_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:includeFontPadding="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.android.live.ui.GradientTextView
                android:textSize="17dp"
                android:textColor="@color/ttlive_color_FFFFFF"
                android:id="@+id/tv_grow_ago_coupon_prefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="@string/ttlive_expand_coupon_symbol"
                android:includeFontPadding="false"
                app:layout_constraintEnd_toStartOf="@+id/tv_grow_ago_coupon_num"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_grow_ago_coupon_info"/>
            <com.bytedance.android.live.ui.GradientTextView
                android:textSize="32dp"
                android:textColor="@color/ttlive_color_FFFFFF"
                android:id="@+id/tv_grow_ago_coupon_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_grow_ago_coupon_prefix"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_grow_ago_coupon_prefix"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ttlive_expand_coupon_name_color"
                android:id="@+id/tv_grow_ago_coupon_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="11dp"
                android:text="@string/ttlive_base_coupon_name"
                android:includeFontPadding="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_coupon_grow_after"
            android:background="@drawable/ttlive_bg_expand_coupon"
            android:layout_width="90dp"
            android:layout_height="109dp"
            android:layout_marginTop="17dp"
            app:layout_constraintLeft_toLeftOf="@+id/btn_coupon_grow"
            app:layout_constraintRight_toRightOf="@+id/btn_coupon_grow"
            app:layout_constraintTop_toBottomOf="@+id/tv_coupon_title">
            <TextView
                android:textSize="11dp"
                android:textColor="@color/ttlive_expand_coupon_threshold_color"
                android:id="@+id/tv_grow_after_coupon_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:includeFontPadding="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.android.live.ui.GradientTextView
                android:textSize="20dp"
                android:textColor="@color/ttlive_color_FFFFFF"
                android:id="@+id/tv_grow_after_coupon_prefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="@string/ttlive_expand_coupon_symbol"
                android:includeFontPadding="false"
                app:layout_constraintEnd_toStartOf="@+id/tv_grow_after_coupon_num"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_grow_after_coupon_info"/>
            <com.bytedance.android.live.ui.GradientTextView
                android:textSize="32dp"
                android:textColor="@color/ttlive_color_FFFFFF"
                android:id="@+id/tv_grow_after_coupon_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_marginStart="1dp"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_grow_after_coupon_prefix"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_grow_after_coupon_prefix"/>
            <TextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_expand_coupon_name_color"
                android:id="@+id/tv_grow_after_coupon_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="@string/ttlive_expand_coupon_name"
                android:includeFontPadding="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageView
            android:layout_width="34dp"
            android:layout_height="26dp"
            android:src="@drawable/ttlive_expand_coupon_arrow"
            app:layout_constraintBottom_toBottomOf="@+id/cl_coupon_grow_after"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cl_coupon_grow_after"/>
        <Button
            android:textSize="15dp"
            android:textColor="@color/ttlive_color_161823"
            android:id="@+id/btn_direct_exit_room"
            android:background="@drawable/ttlive_bg_coupon_enter_room_direct_obtain"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginTop="23dp"
            android:layout_marginStart="16dp"
            app:layout_constraintEnd_toStartOf="@+id/btn_coupon_grow"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cl_coupon_grow_after"/>
        <Button
            android:textSize="15dp"
            android:textColor="@color/ttlive_color_FFFFFF"
            android:id="@+id/btn_coupon_grow"
            android:background="@drawable/ttlive_bg_coupon_expand"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginTop="23dp"
            android:text="@string/ttlive_do_expand_coupon"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/btn_direct_exit_room"
            app:layout_constraintTop_toBottomOf="@+id/cl_coupon_grow_after"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
