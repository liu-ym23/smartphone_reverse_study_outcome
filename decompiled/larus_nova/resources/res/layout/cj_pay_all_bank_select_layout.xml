<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_main"
    android:background="#00000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="?attr/cj_pay_page_size_14"
        android:textColor="@color/cj_pay_color_red_fe2c55"
        android:gravity="center"
        android:id="@+id/tv_subtitle_voucher"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"/>
    <com.android.ttcjpaysdk.base.ui.widget.CJPayRoundRelativeLayout
        android:id="@+id/bank_card_list_container"
        android:background="?attr/cj_pay_quick_bind_card_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/cj_pay_padding_20"
        android:layout_marginTop="@dimen/cj_pay_padding_32"
        android:layout_marginRight="@dimen/cj_pay_padding_20"
        android:layout_marginBottom="@dimen/cj_pay_padding_2"
        app:radius="@dimen/cj_pay_padding_8">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_bank_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <include
            android:visibility="visible"
            layout="@layout/cj_pay_all_bank_select_index_item_layout"/>
    </com.android.ttcjpaysdk.base.ui.widget.CJPayRoundRelativeLayout>
    <com.android.ttcjpaysdk.bindcard.base.view.CJPayIndexBar
        android:id="@+id/index_bar"
        android:layout_width="@dimen/cj_pay_padding_20"
        android:layout_height="486dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="?attr/cj_pay_page_size_22"
        android:textColor="@color/cj_pay_color_white"
        android:gravity="center"
        android:id="@+id/tv_toast"
        android:background="@drawable/cj_pay_toast_bg"
        android:layout_width="@dimen/cj_pay_padding_56"
        android:layout_height="@dimen/cj_pay_padding_56"
        android:layout_centerInParent="true"/>
</RelativeLayout>
