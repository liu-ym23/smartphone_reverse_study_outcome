<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_container"
    android:background="@color/larus_base_2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larus.common_ui.video.VideoPlayView
        android:id="@+id/item_video"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <ImageView
        android:id="@+id/water_mark_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        app:layout_constraintStart_toStartOf="@+id/item_video"
        app:layout_constraintTop_toTopOf="@+id/item_video"/>
    <ImageView
        android:id="@+id/video_icon"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:layout_marginTop="?attr/larus_dp_8"
        android:src="@drawable/larus_community_ic_video_icon"
        android:layout_marginEnd="?attr/larus_dp_8"
        app:layout_constraintEnd_toEndOf="@+id/item_video"
        app:layout_constraintTop_toTopOf="@+id/item_video"/>
    <FrameLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/icon_do_same_style"
        android:background="@drawable/larus_bg_same_template_button"
        android:paddingTop="?attr/larus_dp_6"
        android:paddingBottom="?attr/larus_dp_6"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_12"
        android:paddingStart="?attr/larus_dp_14"
        android:paddingEnd="?attr/larus_dp_14"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="@+id/item_video"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:textSize="?attr/larus_sp_12"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:id="@+id/do_same_style_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_discoverTab_showcaseScreen_btn_try"/>
    </FrameLayout>
    <com.larus.bmhome.bigimg.download.CommonDownLoadLayout
        android:id="@+id/download_icon"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_28"
        android:layout_height="?attr/larus_dp_28"
        android:layout_marginBottom="?attr/larus_dp_4"
        android:layout_marginEnd="?attr/larus_dp_4"
        app:larus_showText="false"
        app:layout_constraintBottom_toBottomOf="@+id/item_video"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.larus.common_ui.widget.CommonAuthorInfoLayout
        android:id="@+id/layout_author_info"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_video"/>
</androidx.constraintlayout.widget.ConstraintLayout>
