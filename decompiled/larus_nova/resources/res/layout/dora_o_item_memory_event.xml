<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/dora_o_bg_memory_card"
    android:paddingLeft="?attr/larus_dp_20"
    android:paddingTop="?attr/larus_dp_18"
    android:paddingRight="?attr/larus_dp_20"
    android:paddingBottom="?attr/larus_dp_18"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="?attr/larus_dp_12"
    android:layout_marginRight="?attr/larus_dp_12"
    android:layout_marginBottom="?attr/larus_dp_16">
    <TextView
        android:textSize="?attr/larus_sp_16"
        android:textColor="@color/dora_o_text_primary"
        android:id="@+id/memory_event_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="?attr/larus_sp_12"
        android:textColor="@color/dora_o_text_secondary"
        android:id="@+id/memory_event_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"/>
    <TextView
        android:textSize="?attr/larus_sp_12"
        android:textColor="@color/dora_o_text_secondary"
        android:id="@+id/memory_event_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"/>
</LinearLayout>
