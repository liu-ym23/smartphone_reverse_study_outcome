<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ec.store.view.ECAutoScrollHorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ec_store_tag_list_scroll_view"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/scroll_left_padding_view"
            android:background="@color/transparent"
            android:layout_width="0dp"
            android:layout_height="match_parent"/>
        <com.bytedance.android.ec.store.view.ECTagListView
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ec_store_tag_list_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:id="@+id/scroll_right_padding_view"
            android:background="@color/transparent"
            android:layout_width="0dp"
            android:layout_height="match_parent"/>
    </LinearLayout>
</com.bytedance.android.ec.store.view.ECAutoScrollHorizontalScrollView>
