<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/menu_item_container"
    android:background="@drawable/bitable_view_title_drawer_entry_bg"
    android:padding="2dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="@dimen/space_kit_len_32"
    android:layout_marginRight="8dp"
    android:backgroundTint="@color/N900_5">
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/widgetTitleMenuImg"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="8dp"/>
        <com.larksuite.component.universe_design.badge.UDBadgeView
            android:id="@+id/widgetTitleMenuBadgePoint"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="-1dp"
            style="@style/UDBadge.Dot.StrongReminder.Medium"/>
        <com.larksuite.component.universe_design.badge.UDBadgeView
            android:id="@+id/widgetTitleMenuBadgeNumFrame"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginStart="20dp"
            app:ud_badge_text="99"
            app:ud_badge_textMaxLength="2"
            style="@style/UDBadge.Text.Red"/>
    </FrameLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_title"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/widgetTitleMenuText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="180dp"
        android:maxLines="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="8dp"/>
</LinearLayout>
