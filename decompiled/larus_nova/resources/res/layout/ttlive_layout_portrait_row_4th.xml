<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/top_indicator_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="end"
        android:id="@+id/appointment_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="12dp"/>
    <FrameLayout
        android:id="@+id/top_indicator_below_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/anchor_ticket"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginLeft="7dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="7dp"/>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/mic_room_count_down_container"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"/>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/mic_room_backup_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>
        <FrameLayout
            android:layout_gravity="end"
            android:id="@+id/commerce_shopping_shortcut"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"/>
        <FrameLayout
            android:layout_gravity="end"
            android:id="@+id/fl_ecom_right_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"/>
        <FrameLayout
            android:layout_gravity="end"
            android:id="@+id/top_right_row_4th_container"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="yes"
            android:layout_marginEnd="12dp"/>
    </FrameLayout>
</LinearLayout>
