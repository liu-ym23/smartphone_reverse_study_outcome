<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_pay_set_password_repeat_layout"
    android:background="@drawable/cj_pay_bind_card_safe_white_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/repeat_set_pwd_title_layout"
        android:background="@android:color/transparent"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <ImageView
            android:id="@+id/repeat_set_pwd_title_back_view"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:src="@drawable/cj_pay_icon_left_close"
            android:scaleType="centerCrop"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <com.android.ttcjpaysdk.bindcard.base.view.CJPayBindCardTitle
        android:id="@+id/bind_card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:layout_below="@+id/repeat_set_pwd_title_layout"/>
    <com.android.ttcjpaysdk.base.ui.component.input.PwdEditTextNoiseReduction
        android:id="@+id/cj_pay_pwd_view_repeat"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="28dp"
        android:layout_marginRight="20dp"
        android:layout_below="@+id/bind_card_title"
        app:CJPayDotRadius="6dp"
        app:CJPayPwdCount="6"
        app:CJPayPwdEditShapeStyle="CJPayRoundRectangle"
        app:CJPayStrokeColor="@color/cj_pay_color_white_F1F1F2"
        app:CJPayStrokeRadius="4dp"
        app:CJPayStrokeWidth="0dp"/>
    <FrameLayout
        android:id="@+id/cj_pay_set_pwd_btn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="40dp"
        android:layout_marginRight="20dp"
        android:layout_below="@+id/cj_pay_pwd_view_repeat">
        <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
            android:textSize="?attr/cj_pay_page_size_15"
            android:textColor="@color/cj_pay_color_white"
            android:gravity="center"
            android:id="@+id/tv_complete"
            android:background="@drawable/cj_pay_bg_red_btn_opacity_40"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/cj_pay_result_confirm_tip"
            android:includeFontPadding="false"/>
        <ProgressBar
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_pay_iv_loading"
            android:background="@color/cj_pay_color_trans"
            android:visibility="gone"
            android:layout_width="@dimen/cj_pay_padding_20"
            android:layout_height="@dimen/cj_pay_padding_20"
            android:layout_marginTop="@dimen/cj_pay_padding_14"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_white"
            android:indeterminateDuration="500"
            android:indeterminateBehavior="repeat"/>
    </FrameLayout>
</RelativeLayout>
