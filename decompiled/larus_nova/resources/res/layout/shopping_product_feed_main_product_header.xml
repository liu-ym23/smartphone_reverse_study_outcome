<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="202dp"
            android:layout_height="76dp"
            android:src="@drawable/commerce_better_life_can_touch"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/container_new_ui"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.bytedance.android.ec.core.widget.SquareFrameLayout
            android:id="@+id/container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <include
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="120dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/new_style_replay_entrance_layout"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/product_attention_tv"
            android:background="@drawable/ec_commerce_bg_4c292929_radius_2"
            android:visibility="gone"
            android:layout_width="88dp"
            android:layout_height="25dp"
            android:text="@string/commerce_product_in_video"
            android:height="16dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/product_feed_header_image_shadow"
            android:background="@drawable/commerce_bg_product_feed_header_view_shadow"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <FrameLayout
            android:id="@+id/view_flipper_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            android:layout_marginStart="12dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/coupon_urge_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="12dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <include
            android:id="@+id/product_card_tag_root_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginBottom="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            layout="@layout/ec_commerce_product_card_tag_view"/>
        <include
            android:id="@+id/main_product_card_same_product_entrance"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            layout="@layout/ec_commerce_feed_item_same_product_entrance_layout"/>
        <include
            android:id="@+id/product_card_same_product_entrance_new"
            android:visibility="gone"
            android:layout_width="70dp"
            android:layout_height="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            layout="@layout/ec_commerce_feed_item_same_product_entrance_new_layout"/>
        <com.bytedance.android.ec.core.widget.RoundedLinearLayout
            android:gravity="bottom"
            android:id="@+id/new_style_product_attention_ll"
            android:background="@drawable/shopping_feed_buy_and_comment_background"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="234dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15.5dp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="13dp"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:id="@+id/new_product_attention_tv"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:text="@string/commerce_product_in_video_short"
                android:includeFontPadding="false"/>
            <View
                android:layout_gravity="center_vertical"
                android:id="@+id/new_style_divider"
                android:background="@color/white"
                android:layout_width="1dp"
                android:layout_height="10dp"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:alpha="0.34"/>
            <com.bytedance.android.ui.base.widget.viewflipper.ECViewFlipper
                android:id="@+id/new_style_view_fliper"
                android:layout_width="wrap_content"
                android:layout_height="26dp"/>
        </com.bytedance.android.ec.core.widget.RoundedLinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
