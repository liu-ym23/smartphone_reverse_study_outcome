<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/filter_common_root"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:paddingEnd="4dp">
    <com.ss.android.ugc.aweme.search.components.filter.FilterContainerView
        android:id="@+id/item_container_scrollview"
        android:scrollbars="none"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:layout_marginEnd="16dp">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/item_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"/>
    </com.ss.android.ugc.aweme.search.components.filter.FilterContainerView>
    <LinearLayout
        android:layout_gravity="end|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/slide_slip_divider"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="22dp">
        <ImageView
            android:background="@drawable/search_bg_filter_sort_gradient"
            android:layout_width="32dp"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:background="@color/white"
            android:layout_width="16dp"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="end"
                android:background="#1618231f"
                android:layout_width="0.4dp"
                android:layout_height="16dp"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
