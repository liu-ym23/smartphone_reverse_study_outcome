<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:background="@drawable/cj_pay_bg_common_dialog_radius_12"
    android:paddingBottom="13dp"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/face_protocol_image"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="32dp"
        android:src="@drawable/cj_pay_icon_face"
        android:scaleType="centerCrop"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/cj_pay_color_black_161823"
        android:ellipsize="middle"
        android:gravity="center_horizontal"
        android:id="@+id/pwd_lock_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxWidth="240dp"
        android:maxLines="2"
        android:layout_below="@+id/face_protocol_image"
        android:layout_centerHorizontal="true"/>
    <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
        android:textSize="15sp"
        android:textColor="@color/cj_pay_color_white"
        android:gravity="center"
        android:id="@+id/pwd_lock_dialog_btn"
        android:background="@color/cj_pay_color_red_fe2c55"
        android:layout_width="240dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:layout_below="@+id/pwd_lock_dialog_title"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
        android:gravity="center"
        android:id="@+id/pwd_lock_dialog_cancel"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:text="@string/cj_pay_common_dialog_cancel"
        android:layout_below="@+id/pwd_lock_dialog_btn"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
