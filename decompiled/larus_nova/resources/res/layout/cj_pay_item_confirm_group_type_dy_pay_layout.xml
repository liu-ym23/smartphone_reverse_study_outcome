<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/cj_pay_item_douyin_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/cj_pay_douyin_pay_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52sp"
        android:layout_alignParentTop="true">
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/cj_pay_douyin_pay_icon_layout"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="12dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true">
            <ImageView
                android:id="@+id/cj_pay_douyin_pay_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"/>
            <ImageView
                android:id="@+id/cj_pay_douyin_pay_icon_unable_mask"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/cj_pay_bg_payment_icon_unable_style_5"/>
        </FrameLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/cj_pay_dy_method_dy_brand_zone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/cj_pay_douyin_pay_icon_layout"
            android:layout_centerVertical="true">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:id="@+id/cj_pay_douyin_pay_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <LinearLayout
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/cj_pay_dy_method_dy_voucher_zone_backup"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
                android:ellipsize="end"
                android:id="@+id/cj_pay_douyin_pay_sub_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cj_pay_padding_4"
                android:maxLines="2"
                android:singleLine="false"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/cj_pay_dy_method_dy_voucher_zone_default"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="2dp"
            android:layout_toLeftOf="@+id/cj_pay_dy_method_tail_zone"
            android:layout_toRightOf="@+id/cj_pay_dy_method_dy_brand_zone"
            android:layout_centerVertical="true"/>
        <RelativeLayout
            android:gravity="right"
            android:layout_gravity="center"
            android:id="@+id/cj_pay_dy_method_tail_zone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_34"
                android:id="@+id/cj_pay_payment_tips_msg"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"/>
            <com.android.ttcjpaysdk.base.theme.widget.CJPayCircleCheckBox
                android:id="@+id/cj_pay_payment_method_checkbox"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginLeft="6dp"
                android:layout_toRightOf="@+id/cj_pay_payment_tips_msg"/>
        </RelativeLayout>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/cj_pay_item_douyin_subpay_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/cj_pay_douyin_pay_layout">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/cj_pay_item_douyin_subpay_layout"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/cj_pay_item_douyin_subpay_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="52dp"/>
                <TextView
                    android:textSize="10sp"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/cj_pay_douyin_sub_pay_mark_text_bottom"
                    android:background="@drawable/cj_pay_bg_payment_method_recommend_way"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="52dp"
                    android:layout_marginTop="2dp"
                    android:maxWidth="206dp"
                    android:maxLines="1"/>
                <RelativeLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
                        android:gravity="center_vertical"
                        android:id="@+id/cj_pay_item_douyin_subpay_sub_title"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="52dp"/>
                    <ImageView
                        android:id="@+id/cj_pay_item_douyin_subpay_sub_title_icon"
                        android:paddingLeft="20dp"
                        android:paddingTop="0.5dp"
                        android:visibility="gone"
                        android:layout_width="36dp"
                        android:layout_height="17dp"
                        android:layout_marginLeft="-18dp"
                        android:src="@drawable/cj_pay_info_icon"
                        android:layout_toRightOf="@+id/cj_pay_item_douyin_subpay_sub_title"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
            </LinearLayout>
            <TextView
                android:textSize="10sp"
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_douyin_sub_pay_mark_text_right"
                android:background="@drawable/cj_pay_bg_payment_method_recommend_way"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
                android:gravity="right"
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_item_douyin_subpay_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="98dp"
                android:singleLine="true"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_payment_method_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"
                android:src="@drawable/cj_pay_icon_stype_right_arrow_dypay"
                android:scaleType="centerCrop"/>
            <ProgressBar
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_payment_method_loading"
                android:background="@color/cj_pay_color_trans"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginRight="8dp"
                android:indeterminateOnly="true"
                android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_gray"
                android:indeterminateDuration="500"
                android:indeterminateBehavior="repeat"/>
        </LinearLayout>
        <include
            android:id="@+id/cj_pay_item_credit_pay_subpay_layout"
            layout="@layout/cj_pay_item_method_credit_pay_layout"/>
        <include
            android:id="@+id/cj_pay_item_payment_card_subpay_layout"
            layout="@layout/cj_pay_item_method_card_style_layout"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/cj_pay_bg_home_banner_arrow"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="28dp"
        android:src="@drawable/cj_pay_home_banner_bubble_arrow"
        android:layout_above="@+id/cj_pay_home_bannder_layout"
        android:layout_alignParentRight="true"/>
    <LinearLayout
        android:id="@+id/cj_pay_home_bannder_layout"
        android:background="@drawable/cj_pay_bg_home_page_banner"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="8dp"
        android:layout_below="@+id/cj_pay_item_douyin_subpay_container">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/cj_pay_color_red_fe2c55"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/cj_pay_home_bannder_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:maxLines="1"
            android:layout_weight="1"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#fe2c55"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/cj_pay_home_bannder_button"
            android:background="@drawable/cj_pay_bg_douyin_red_btn"
            android:paddingLeft="6dp"
            android:paddingTop="1dp"
            android:paddingRight="6dp"
            android:paddingBottom="1dp"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginRight="8dp"/>
        <FrameLayout
            android:layout_gravity="center"
            android:id="@+id/cj_pay_wx_bankcard_frameLayout"
            android:background="@drawable/cj_pay_bg_douyin_red_btn"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginRight="8dp">
            <TextView
                android:textSize="11sp"
                android:textColor="#fe2c55"
                android:layout_gravity="center"
                android:id="@+id/cj_pay_wx_bankcard_tv"
                android:paddingLeft="6dp"
                android:paddingTop="1dp"
                android:paddingRight="6dp"
                android:paddingBottom="1dp"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/cj_pay_wx_bankcard_loading"
                android:visibility="gone"
                android:layout_width="@dimen/cj_pay_padding_12"
                android:layout_height="@dimen/cj_pay_padding_12"
                android:indeterminateOnly="true"
                android:indeterminateDrawable="@drawable/cj_pay_wx_bankcard_loading_red"
                android:indeterminateDuration="500"
                android:indeterminateBehavior="repeat"/>
        </FrameLayout>
    </LinearLayout>
</RelativeLayout>
