<?xml version="1.0" encoding="utf-8"?>
<com.ss.android.lark.flow.chat.view.MaxWidthConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="12dp"
    android:paddingBottom="17.5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxWidth="400dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <com.larksuite.component.ui.avatar.v2.LarkAvatarView
        android:id="@+id/profile_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:layout_constraintEnd_toStartOf="@+id/profile_user_name"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/flow_ud_neutral_100"
        android:ellipsize="end"
        android:id="@+id/profile_user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_marginStart="6dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/profile_avatar"
        app:layout_constraintStart_toEndOf="@+id/profile_avatar"
        app:layout_constraintTop_toTopOf="@+id/profile_avatar"/>
    <View
        android:id="@+id/profile_divider"
        android:background="@color/flow_ud_neutral_transparent_2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_avatar"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/flow_ud_neutral_70"
        android:id="@+id/profile_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/Lark_Legacy_SendUserCard"
        android:lines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_divider"
        app:layout_constraintVertical_chainStyle="packed"/>
</com.ss.android.lark.flow.chat.view.MaxWidthConstraintLayout>
