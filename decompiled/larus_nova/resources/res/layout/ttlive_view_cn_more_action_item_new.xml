<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/action_area"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/viewCenterAnchor"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerImageView
        android:id="@+id/vIconBg"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="@+id/viewCenterAnchor"
        app:layout_constraintLeft_toLeftOf="@+id/viewCenterAnchor"
        app:layout_constraintRight_toRightOf="@+id/viewCenterAnchor"
        app:layout_constraintTop_toTopOf="@+id/viewCenterAnchor"
        app:ttlive_allRadius="52dp"/>
    <FrameLayout
        android:id="@+id/icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/viewCenterAnchor"
        app:layout_constraintLeft_toLeftOf="@+id/viewCenterAnchor"
        app:layout_constraintRight_toRightOf="@+id/viewCenterAnchor"
        app:layout_constraintTop_toTopOf="@+id/viewCenterAnchor"/>
    <com.bytedance.android.livesdk.chatroom.ui.RedDotView
        android:id="@+id/red_dot"
        android:background="@drawable/ttlive_ic_red_point_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintRight_toRightOf="@+id/icon"
        app:layout_constraintTop_toTopOf="@+id/icon"/>
    <TextView
        android:textSize="7dp"
        android:textColor="@color/ttlive_more_dialog_desc_text"
        android:gravity="center_horizontal"
        android:id="@+id/icon_description"
        android:background="@drawable/ttlive_bg_audience_more_dialog_text_state"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="@+id/icon"
        app:layout_constraintLeft_toLeftOf="@+id/icon"/>
    <TextView
        android:textSize="11dp"
        android:textColor="#7fffffff"
        android:gravity="center"
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:includeFontPadding="false"
        android:layout_below="@+id/icon"
        app:layout_constraintTop_toBottomOf="@+id/viewCenterAnchor"/>
    <com.bytedance.android.livesdk.common.LiveViewStub
        android:id="@+id/icon_switch"
        android:layout_width="13dp"
        android:layout_height="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/icon"
        app:layout_constraintRight_toRightOf="@+id/icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
