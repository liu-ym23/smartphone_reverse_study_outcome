<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/ttlive_bg_vip_emoji_template_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/ttlive_vip_emoji_template_gray"
                android:gravity="center"
                android:id="@+id/cancel_button"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/vip_emoji_template_dialog_cancel"
                android:paddingStart="27dp"
                android:paddingEnd="27dp"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_vip_emoji_template_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vip_emoji_template_dialog_title"
                android:layout_centerInParent="true"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/ttlive_vip_emoji_template_light_red"
                android:gravity="center"
                android:id="@+id/add_button"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/vip_emoji_template_dialog_add"
                android:paddingStart="27dp"
                android:paddingEnd="27dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <View
            android:background="#1f161823"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <TextView
                android:textSize="15dp"
                android:textColor="@color/ttlive_vip_emoji_template_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/vip_emoji_template_dialog_preview"/>
            <ImageView
                android:id="@+id/about_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="19dp"
                android:src="@drawable/ttlive_icon_vip_emoji_template_about"
                android:alpha="0.5"
                android:layout_marginStart="64dp"/>
            <SurfaceView
                android:id="@+id/preview_area"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="53dp"
                android:layout_marginBottom="8dp"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/portrait_layout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">
            <TextView
                android:textSize="15dp"
                android:textColor="@color/ttlive_vip_emoji_template_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vip_emoji_template_dialog_portrait"
                android:layout_centerVertical="true"/>
            <ImageView
                android:id="@+id/arrow"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ttlive_icon_vip_emoji_template_arrow"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ttlive_vip_emoji_template_light_black"
                android:id="@+id/choose_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vip_emoji_template_dialog_not_choose"
                android:layout_toLeftOf="@+id/arrow"
                android:layout_centerVertical="true"/>
            <ImageView
                android:id="@+id/portrait_thumb"
                android:visibility="gone"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_toLeftOf="@+id/arrow"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="122dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">
            <TextView
                android:textSize="15dp"
                android:textColor="@color/ttlive_vip_emoji_template_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/vip_emoji_template_dialog_text"/>
            <EditText
                android:textSize="15dp"
                android:textColorHint="#57161823"
                android:id="@+id/emoji_edit_text"
                android:background="@drawable/ttlive_bg_vip_emoji_template_edit_text"
                android:paddingLeft="12dp"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="52dp"
                android:hint="@string/vip_emoji_template_dialog_text_hint"
                android:singleLine="true"
                android:maxLength="5"
                android:textCursorDrawable="@drawable/ttlive_vip_emoji_template_text_cursor"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#57161823"
                android:id="@+id/text_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="63.5dp"
                android:text="@string/vip_emoji_template_dialog_cur_text_length"
                android:layout_marginEnd="12dp"
                android:layout_alignEnd="@+id/emoji_edit_text"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_alignParentBottom="true">
                <TextView
                    android:textSize="11dp"
                    android:textColor="@color/ttlive_vip_emoji_template_light_black"
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vip_emoji_template_dialog_text_recommend"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/script_list"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:overScrollMode="never"/>
            </LinearLayout>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="6dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">
            <TextView
                android:textSize="15dp"
                android:textColor="@color/ttlive_vip_emoji_template_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/vip_emoji_template_dialog_bubble_color"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/bubble_list"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="48dp"/>
            <ImageView
                android:layout_width="23dp"
                android:layout_height="40dp"
                android:layout_marginTop="52dp"
                android:src="@drawable/ttlive_vip_emoji_template_list_shader"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
    <com.bytedance.android.livesdk.chatroom.ui.DouyinLoadingLayout
        android:id="@+id/effect_loading"
        android:background="@color/ttlive_std_mask_1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
