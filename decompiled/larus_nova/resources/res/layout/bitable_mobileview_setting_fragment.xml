<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="view_setting"
    android:background="@color/bg_float"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.ee.bear.widgets.universedesign.SpaceSettingGroupLayout
            android:id="@+id/layoutSelectContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:dividerBackgroundColor="@color/bg_body_overlay"
            app:hasDivider="true"
            app:itemBackgroundColor="@color/bg_float_overlay"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/mobileViewSettingLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_placeholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:text="@string/Bitable_Mobile_CardMode_CardLayout_Title"/>
            <com.larksuite.component.ui.layout.LKUIRoundLinearLayout
                android:orientation="horizontal"
                android:id="@+id/cardStyleSettingLayout"
                android:background="@color/bg_float_overlay"
                android:paddingLeft="12dp"
                android:paddingTop="16dp"
                android:paddingRight="12dp"
                android:paddingBottom="18dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:rl_radius="10dp">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/rowSelect3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <com.bytedance.ee.bear.bitable.cardview.widget.SkeletonView
                        android:id="@+id/skeleton3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:rowCount="3"
                        style="@style/common_card_skeletonview"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/bitable_viewsetting_row_text_color"
                        android:gravity="center"
                        android:background="@drawable/bitable_view_row_tips_bg"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginTop="10dp"
                        android:text="@string/Bitable_Mobile_CardMode_CardLayout_1Row3Column"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/rowSelect2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:layout_weight="1">
                    <com.bytedance.ee.bear.bitable.cardview.widget.SkeletonView
                        android:id="@+id/skeleton2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:rowCount="2"
                        style="@style/common_card_skeletonview"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/bitable_viewsetting_row_text_color"
                        android:gravity="center"
                        android:background="@drawable/bitable_view_row_tips_bg"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginTop="10dp"
                        android:text="@string/Bitable_Mobile_CardMode_CardLayout_1Row2Column"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/rowSelect1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_weight="1">
                    <com.bytedance.ee.bear.bitable.cardview.widget.SkeletonView
                        android:id="@+id/skeleton1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:rowCount="1"
                        style="@style/common_card_skeletonview"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/bitable_viewsetting_row_text_color"
                        android:gravity="center"
                        android:background="@drawable/bitable_view_row_tips_bg"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginTop="10dp"
                        android:text="@string/Bitable_Mobile_CardMode_CardLayout_1Row1Column"/>
                </LinearLayout>
            </com.larksuite.component.ui.layout.LKUIRoundLinearLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_placeholder"
                android:id="@+id/configTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"/>
            <com.bytedance.ee.bear.widgets.universedesign.SpaceSettingGroupLayout
                android:orientation="vertical"
                android:id="@+id/subTiltleContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:dividerBackgroundColor="@color/bg_body_overlay"
                app:hasDivider="true"
                app:itemBackgroundColor="@color/bitable_panel_view_item_tint_float">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/selectCoverFieldLayout"
                    android:paddingLeft="16dp"
                    android:paddingTop="13dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="13dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/text_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Bitable_Mobile_Configuration_Cover_Title"/>
                    <com.larksuite.component.universe_design.badge.UDBadgeView
                        android:id="@+id/guideBadge"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        style="@style/bitable_dot_badge"/>
                    <View
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/text_caption"
                        android:id="@+id/coverFieldName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        app:srcCompat="@drawable/ud_icon_right_small_ccm_outlined"
                        app:tint="@color/icon_n3"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/titleLayout"
                    android:paddingLeft="16dp"
                    android:paddingTop="13dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="13dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/text_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Bitable_Mobile_CardMode_TitleSettings_Title_Title"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/text_caption"
                        android:id="@+id/titleFieldName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"
                        android:text=""/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        app:srcCompat="@drawable/ud_icon_right_small_ccm_outlined"
                        app:tint="@color/icon_n3"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/summaryLayout"
                    android:paddingLeft="16dp"
                    android:paddingTop="13dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="13dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/text_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Bitable_Mobile_CardMode_TitleSettings_Subtitle_Title"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/text_caption"
                        android:id="@+id/summaryFieldName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"
                        android:text=""/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        app:srcCompat="@drawable/ud_icon_right_small_ccm_outlined"
                        app:tint="@color/icon_n3"/>
                </LinearLayout>
            </com.bytedance.ee.bear.widgets.universedesign.SpaceSettingGroupLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_placeholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:text="@string/Bitable_Mobile_CardMode_FieldsToDisplay_Title"/>
            <com.larksuite.component.ui.layout.LKUIRoundableLayout
                android:id="@+id/selectFieldContainer"
                android:background="@color/bg_float_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:rl_radius="10dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/text_caption"
                    android:id="@+id/emptySelectTv"
                    android:paddingLeft="16dp"
                    android:paddingTop="13dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="13dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/Bitable_Mobile_CardMode_NoFieldsToDisplay_Description"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/selectFieldList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.larksuite.component.ui.layout.LKUIRoundableLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_placeholder"
                android:id="@+id/selectLimitTipsTv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="2dp"
                android:text=""/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_placeholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:text="@string/Bitable_Mobile_CardMode_MoreFields_Title"/>
            <com.larksuite.component.ui.layout.LKUIRoundableLayout
                android:id="@+id/unSelectFieldContainer"
                android:background="@color/bg_float_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:rl_radius="10dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/text_caption"
                    android:id="@+id/emptyUnSelectTv"
                    android:paddingLeft="16dp"
                    android:paddingTop="13dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="13dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/Bitable_Mobile_CardMode_NoAvailableFields_Description"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/unSelectFieldList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.larksuite.component.ui.layout.LKUIRoundableLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_placeholder"
                android:id="@+id/hiddenFieldTv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
