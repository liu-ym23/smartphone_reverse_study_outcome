<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_interact_dialog"
    android:paddingBottom="18dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="center_horizontal"
        android:background="#1a161823"
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"/>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/head_anim"
            android:visibility="gone"
            android:layout_width="115dp"
            android:layout_height="115dp"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/head"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:placeholderImage="@drawable/ttlive_img_avatar_empty"/>
        <View
            android:layout_gravity="bottom|right"
            android:background="@drawable/ttlive_ic_audience_invited_link"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_margin="15dp"/>
    </FrameLayout>
    <TextView
        android:textSize="15dp"
        android:textColor="#161823"
        android:layout_gravity="center_horizontal"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="35dp">
        <TextView
            android:textSize="15dp"
            android:textColor="#161823"
            android:gravity="center"
            android:id="@+id/refuse"
            android:background="@drawable/ttlive_bg_invited_dialog_refuse"
            android:layout_width="157dp"
            android:layout_height="45dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/accept"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/accept"
            android:background="@drawable/ttlive_bg_invited_dialog_accept"
            android:layout_width="157dp"
            android:layout_height="45dp"
            android:text="@string/ttlive_live_interact_accept"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/refuse"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
