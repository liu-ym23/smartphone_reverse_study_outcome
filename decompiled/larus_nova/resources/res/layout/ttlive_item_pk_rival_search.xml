<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@color/ttlive_white"
    android:layout_width="match_parent"
    android:layout_height="92dp">
    <FrameLayout
        android:id="@+id/head_verify_status_view"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginLeft="17dp"
        android:layout_marginTop="13dp"
        android:layout_marginStart="17dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.livesdk.widget.VHeadView
            android:layout_gravity="center"
            android:id="@+id/head_view"
            android:background="@drawable/ttlive_bg_circle_head"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:placeholderImage="@drawable/ttlive_ic_default_head_small"
            app:retryImageScaleType="fitXY"
            app:roundAsCircle="true"/>
        <ImageView
            android:id="@+id/living_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ttlive_ic_pk_rivals_search_living"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="bottom|right"
            android:id="@+id/living_lottie"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="14dp"/>
        <com.bytedance.android.livesdk.widget.VHeadView
            android:layout_gravity="bottom|right"
            android:id="@+id/verify_view"
            android:background="@drawable/ttlive_bg_circle_head"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="3dp"
            android:layout_marginBottom="3dp"
            android:src="@drawable/ttlive_ic_pk_rivals_search_verify"
            android:layout_marginEnd="3dp"
            app:retryImageScaleType="fitXY"
            app:roundAsCircle="true"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="9dp"
        android:layout_marginStart="9dp"
        app:layout_constraintEnd_toStartOf="@+id/invite_container"
        app:layout_constraintStart_toEndOf="@+id/head_verify_status_view"
        app:layout_constraintTop_toTopOf="@+id/head_verify_status_view">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="3dp">
                <TextView
                    android:textSize="15dp"
                    android:textStyle="bold"
                    android:textColor="#404040"
                    android:ellipsize="end"
                    android:id="@+id/tv_nick_name"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:maxLines="1"
                    android:maxEms="5"
                    android:singleLine="true"
                    android:lineSpacingExtra="5dp"/>
                <com.bytedance.android.live.revlink.impl.pk.ui.PkTagsContainerView
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/tags_container"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"/>
            </LinearLayout>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/ttlive_interact_default_text_color"
                android:id="@+id/tv_short_id"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:singleLine="true"
                android:lineSpacingExtra="5dp"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/ttlive_interact_default_text_color"
                android:id="@+id/tv_fans_num"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:singleLine="true"
                android:lineSpacingExtra="5dp"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/invite_container"
        android:layout_width="64dp"
        android:layout_height="28dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="20dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/iv_invite"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:actualImageScaleType="fitXY"
            app:placeholderImage="@drawable/ttlive_bg_live_red_btn"
            app:roundedCornerRadius="@dimen/ttlive_pk_invite_random_btn_radius"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/ttlive_white"
            android:gravity="center"
            android:id="@+id/tv_invite"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/ttlive_live_pk_invite_btn"/>
    </FrameLayout>
    <TextView
        android:textSize="13dp"
        android:textColor="#80161823"
        android:gravity="center"
        android:id="@+id/tv_unaccept_invite"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginRight="22dp"
        android:layout_marginBottom="20dp"
        android:text="@string/ttlive_interact_pk_search_unaccept_pk"
        android:layout_marginEnd="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider"
        android:background="#e0e0e0"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
