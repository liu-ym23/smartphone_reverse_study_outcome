<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="start"
        android:id="@+id/single_view_mode_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:layout_gravity="start"
        android:id="@+id/anchor_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/enlarge_player_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/anchor_player_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/interact_render_container_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/anchor_pause_tips_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.live.ui.ClipImageView
            android:id="@+id/anchor_pause_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.livesdk.common.AnchorPauseTipsView
            android:layout_gravity="center_horizontal"
            android:layout_width="187dp"
            android:layout_height="180dp"
            android:layout_marginTop="140dp"/>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_video_talkroom_guest_window"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="end"
        android:id="@+id/iv_identity"
        android:layout_width="31dp"
        android:layout_height="15dp"
        android:layout_marginLeft="8dp"
        android:layout_marginStart="8dp"
        app:actualImageScaleType="centerInside"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/rv_video_talkroom_guest_window"/>
    <com.bytedance.android.live.liveinteract.chatroom.chatroom.ui.SeatAnimationView
        android:id="@+id/anchor_seat_anim_view"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="30dp"
        app:layout_constraintBottom_toBottomOf="@+id/anchor_container"
        app:layout_constraintEnd_toEndOf="@+id/anchor_container"
        app:layout_constraintStart_toStartOf="@+id/anchor_container"
        app:layout_constraintTop_toTopOf="@+id/anchor_container"
        app:layout_constraintVertical_bias="0.33"/>
</androidx.constraintlayout.widget.ConstraintLayout>
