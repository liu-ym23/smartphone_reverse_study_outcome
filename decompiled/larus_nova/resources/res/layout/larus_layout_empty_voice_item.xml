<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/avatar_view"
        android:background="?attr/larus_bg_recommend_vioce_avatar"
        android:layout_width="?attr/larus_dp_48"
        android:layout_height="?attr/larus_dp_48"
        android:layout_marginTop="?attr/larus_dp_12"
        android:alpha="0.05"
        android:layout_marginStart="?attr/larus_dp_16"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginStart="?attr/larus_dp_12">
        <View
            android:id="@+id/empty_title"
            android:background="?attr/larus_bg_recommend_vioce_text"
            android:layout_width="?attr/larus_dp_100"
            android:layout_height="?attr/larus_dp_16"
            android:alpha="0.05"/>
        <View
            android:id="@+id/empty_des"
            android:background="?attr/larus_bg_recommend_vioce_text"
            android:layout_width="?attr/larus_dp_170"
            android:layout_height="?attr/larus_dp_16"
            android:layout_marginTop="?attr/larus_dp_8"
            android:alpha="0.05"/>
        <View
            android:id="@+id/empty_label"
            android:background="?attr/larus_bg_recommend_vioce_text"
            android:layout_width="?attr/larus_dp_170"
            android:layout_height="?attr/larus_dp_16"
            android:layout_marginTop="?attr/larus_dp_8"
            android:alpha="0.05"/>
        <View
            android:background="?attr/larus_neutral_transparent_2"
            android:layout_width="?attr/larus_dp_314"
            android:layout_height="?attr/larus_dp_0_5"
            android:layout_marginTop="?attr/larus_dp_12"
            android:alpha="0.05"/>
    </LinearLayout>
</LinearLayout>
