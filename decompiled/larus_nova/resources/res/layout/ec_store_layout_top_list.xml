<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/ec_store_top_list_root"
    android:paddingTop="8dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/ec_store_top_list_icon_wrapper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:id="@+id/ec_store_top_list_icon"
            android:layout_width="wrap_content"
            android:layout_height="16sp"
            android:layout_marginStart="2dp"
            app:actualImageScaleType="fitCenter"
            app:layoutMode="width_self_adjust"/>
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:id="@+id/ec_store_top_list_icon_living"
            android:layout_width="wrap_content"
            android:layout_height="16sp"
            android:alpha="0"
            android:layout_marginStart="2dp"
            app:actualImageScaleType="fitCenter"
            app:layoutMode="width_self_adjust"/>
    </FrameLayout>
    <TextView
        android:textSize="12sp"
        android:ellipsize="end"
        android:id="@+id/ec_store_top_list_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:layout_weight="1"
        android:layout_marginStart="8dp"/>
    <ImageView
        android:id="@+id/ec_store_top_list_arrow"
        android:layout_width="12sp"
        android:layout_height="12sp"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        android:src="@drawable/ec_store_shop_list_arrow"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"/>
</LinearLayout>
