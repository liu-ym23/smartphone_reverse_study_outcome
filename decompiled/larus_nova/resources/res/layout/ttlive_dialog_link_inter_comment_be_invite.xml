<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_interact_dialog"
    android:layout_width="match_parent"
    android:layout_height="350dp">
    <TextView
        android:textSize="17dp"
        android:textColor="#161823"
        android:id="@+id/tv_inter_com_main_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/ttlive_inter_comment_be_invite_main_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/comment_intro"
        android:padding="16dp"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:src="@drawable/ttlive_intercom_intro"
        app:layout_constraintBottom_toBottomOf="@+id/tv_inter_com_main_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_inter_com_main_title"/>
    <View
        android:id="@+id/divider"
        android:background="#1a161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_inter_com_main_title"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#80000000"
        android:id="@+id/tv_inter_com_sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ttlive_inter_comment_sub_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/tv_inter_com_third_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_inter_com_sub_title">
        <TextView
            android:textSize="13dp"
            android:textColor="#57000000"
            android:id="@+id/tv_inter_com_third_title_fore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_inter_comment_third_title_fore"/>
        <ImageView
            android:id="@+id/tv_inter_com_third_title_mid"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:src="@drawable/ttlive_inter_com_open_without_bg_icon"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#57000000"
            android:id="@+id/tv_inter_com_third_title_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_inter_comment_third_title_end"/>
    </LinearLayout>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_inter_comment"
        android:layout_width="343dp"
        android:layout_height="92dp"
        android:layout_marginTop="9dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_inter_com_third_title"
        app:placeholderImageScaleType="fitXY"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_reply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_inter_comment">
        <Button
            android:textSize="15dp"
            android:textColor="#161823"
            android:id="@+id/bt_refuse"
            android:background="@drawable/ttlive_bg_inter_comment_be_invite_refuse"
            android:layout_width="168dp"
            android:layout_height="44dp"
            android:text="@string/ttlive_inter_comment_refuse"/>
        <Button
            android:textSize="15dp"
            android:textColor="@color/white"
            android:id="@+id/bt_agree"
            android:background="@drawable/ttlive_bg_pk_cancel"
            android:layout_width="168dp"
            android:layout_height="44dp"
            android:layout_marginLeft="8dp"
            android:text="@string/ttlive_inter_comment_agree"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_inter_comment"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_ban_be_invite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="18dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_reply">
        <RadioButton
            android:id="@+id/ban_be_invite_radio"
            android:background="@drawable/ttlive_bg_newuser_pk_radio"
            android:visibility="visible"
            android:clickable="false"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="1dp"
            android:checked="false"
            android:button="@null"/>
        <TextView
            android:textColor="#80000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="@string/ttlive_inter_comment_ban_be_invite"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
