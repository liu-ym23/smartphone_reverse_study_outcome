<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_op_color_fe2c55"
        android:id="@+id/current_price_prefix"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="券后"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_op_color_fe2c55"
        android:id="@+id/money_type"
        android:paddingLeft="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¥"
        app:layout_constraintBaseline_toBaselineOf="@+id/current_price_prefix"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/current_price_prefix"/>
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_op_color_fe2c55"
        android:id="@+id/current_price_integer"
        android:paddingLeft="1dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="88"
        app:layout_constraintBaseline_toBaselineOf="@+id/current_price_prefix"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/money_type"/>
    <TextView
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_op_color_fe2c55"
        android:id="@+id/current_price_decimal"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=".8"
        app:layout_constraintBaseline_toBaselineOf="@+id/current_price_prefix"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/current_price_integer"/>
    <TextView
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_op_color_fe2c55"
        android:id="@+id/current_price_suffix"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="起"
        app:layout_constraintBaseline_toBaselineOf="@+id/current_price_prefix"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/current_price_decimal"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#59161823"
        android:id="@+id/original_price"
        android:paddingLeft="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¥188.8"
        app:layout_constraintBaseline_toBaselineOf="@+id/current_price_prefix"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/current_price_suffix"/>
</androidx.constraintlayout.widget.ConstraintLayout>
