<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/poi_trade_search_bar_324819514"
    android:background="@drawable/poi_bg_trade_goods_detail_search_bar"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ies.dmt.ui.widget.AutoRTLImageView
        android:id="@+id/iv_search"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="4dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        app:srcCompat="@drawable/nearby_search_poi_bar_icon"/>
    <com.bytedance.dux.text.DuxTextView
        android:textColor="#99161823"
        android:id="@+id/et_search"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/trade_goods_search_default_suggest"
        android:singleLine="true"
        android:layout_toRightOf="@+id/iv_search"
        android:layout_centerVertical="true"
        android:textDirection="ltr"
        android:layout_toEndOf="@+id/iv_search"/>
</RelativeLayout>
