<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lynx_translate_root_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_caption"
        android:id="@+id/lynx_card_translate_feedback_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:text="@string/Lark_Chat_TranslationFeedbackRateButton"
        android:drawablePadding="4.17dp"
        android:drawableEnd="@drawable/ic_svg_pointer2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/lynx_card_translate_more_action"
        android:padding="@dimen/dp_4"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginRight="12dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/lynx_card_translate_feedback_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintTop_toTopOf="@+id/lynx_card_translate_feedback_tv"
        app:layout_goneMarginTop="24dp"
        app:srcCompat="@drawable/ud_icon_more_outlined"
        app:tint="@color/icon_n2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
