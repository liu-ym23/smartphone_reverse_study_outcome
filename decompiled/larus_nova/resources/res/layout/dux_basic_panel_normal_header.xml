<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/grabber"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:background="?attr/duxPanelDragHeaderBg"
            android:layout_width="32dp"
            android:layout_height="4dp"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_view"
        android:layout_width="match_parent"
        android:layout_height="?attr/duxPanelDefaultHeaderHeight"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/grabber">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_back"
            android:background="?attr/duxPanelDefaultHeaderIconBg"
            android:padding="6sp"
            android:visibility="gone"
            android:layout_width="28sp"
            android:layout_height="28sp"
            android:contentDescription="@string/dux_iv_back_desc"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_s_s_arrowleft_outlined_16"
            app:tint="?attr/duxPanelDefaultHeaderIconTint"/>
        <com.bytedance.dux.text.DuxTextView
            android:textColor="?attr/duxPanelDefaultHeaderTitleColor"
            android:gravity="start"
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_close"
            app:layout_constraintStart_toEndOf="@+id/iv_back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginStart="16dp"
            app:textSpec="H3S"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_close"
            android:background="?attr/duxPanelDefaultHeaderIconBg"
            android:padding="6sp"
            android:layout_width="28sp"
            android:layout_height="28sp"
            android:contentDescription="@string/dux_iv_close_desc"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toEndOf="@+id/tv_title"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_s_s_xmark_outlined_16"
            app:tint="?attr/duxPanelDefaultHeaderIconTint"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.dux.divider.DuxDivider
        android:id="@+id/divider"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:importantForAccessibility="no"
        app:dividerStyle="primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
