<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.shopping.widget.PriceView
        android:id="@+id/min_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:extraTextColor="@color/Primary"
        app:extraTextSize="12sp"
        app:priceBold="true"
        app:priceDecimalTextSize="22sp"
        app:priceText="8.8"
        app:priceTextColor="@color/Primary"
        app:priceTextSize="24sp"
        app:spaceSize="2dp"
        app:thinDecimal="true"
        app:yangTextSize="18sp"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/shopping_color_FE496A"
        android:id="@+id/reason"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"/>
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/TextReverse4"
            android:ellipsize="end"
            android:layout_gravity="right"
            android:id="@+id/sales"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:lineSpacingExtra="2dp"/>
    </FrameLayout>
</LinearLayout>
