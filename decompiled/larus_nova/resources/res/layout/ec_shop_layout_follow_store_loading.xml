<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_follow_store_loading_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="2dp">
    <FrameLayout
        android:id="@+id/skylight_loading_wrapper"
        android:layout_width="match_parent"
        android:layout_height="114dp">
        <ImageView
            android:id="@+id/skylight_loading_img"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:src="@drawable/ec_store_follow_skylight_loading_light"
            android:scaleType="fitStart"
            android:layout_marginStart="14dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/content_loading"
        android:background="@drawable/shape_corner_12_content_white"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="72dp">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/content_loading_img"
            android:layout_width="match_parent"
            android:layout_height="1000dp"
            app:placeholderImage="@drawable/ec_store_follow_content_loading"
            app:placeholderImageScaleType="fitStart"
            app:roundedCornerRadius="12dp"/>
    </FrameLayout>
    <com.bytedance.android.ui.ec.widget.loading.ECDuxLoadingAnimationView
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="23dp"/>
</FrameLayout>
