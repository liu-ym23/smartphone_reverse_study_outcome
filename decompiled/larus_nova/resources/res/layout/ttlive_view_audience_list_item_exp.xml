<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="44dp"
    android:layout_marginLeft="2dp"
    android:layout_marginRight="2dp"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp">
    <com.bytedance.android.livesdk.widget.TransparentCircleIconView
        android:layout_gravity="center"
        android:id="@+id/avatar"
        android:layout_width="30dp"
        android:layout_height="30dp"
        app:placeholderImage="@drawable/ttlive_img_avatar_empty"
        app:roundAsCircle="true"/>
    <com.bytedance.android.livesdk.widget.TransparentCircleIconView
        android:layout_gravity="center"
        android:id="@+id/avatar_border"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"/>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/honer_icon"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginBottom="7dp"/>
    <com.bytedance.android.live.uikit.rtl.AutoRTLImageView
        android:layout_gravity="end"
        android:id="@+id/crown"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="2dp"
        android:layout_marginEnd="2dp"/>
    <com.bytedance.android.live.core.widget.FitTextView
        android:textSize="9dp"
        android:textColor="@color/ttlive_white"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/contribution"
        android:background="@drawable/ttlive_bg_audience_ticket_normal"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="12dp"
        android:layout_marginBottom="7dp"
        android:maxWidth="32dp"
        android:minWidth="20dp"
        android:maxLines="1"
        android:lines="1"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"/>
</FrameLayout>
