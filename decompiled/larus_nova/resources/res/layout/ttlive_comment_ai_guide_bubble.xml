<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="12dp"
    android:layout_marginRight="12dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/bubble_main"
        android:background="@drawable/ttlive_comment_ai_guide_bubble_bg"
        android:paddingLeft="5dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="32dp">
        <RelativeLayout
            android:layout_width="24dp"
            android:layout_height="24dp">
            <com.bytedance.android.livesdk.widget.TransparentCircleIconView
                android:id="@+id/bubble_anchor_iv"
                android:background="@drawable/my_live_default_avatar"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerInParent="true"
                app:circleCenterLeftMargin="19.3dp"
                app:circleCenterTopMargin="19.3dp"
                app:circleRadius="5.5dp"
                app:roundAsCircle="true"/>
            <ImageView
                android:background="@drawable/ttlive_comment_bubble_ai_icon"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_alignParentRight="true"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="12dp"
            android:ellipsize="end"
            android:id="@+id/tv_bubble_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:maxLines="1"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:background="@drawable/ttlive_comment_ai_guide_arrow_inner"
            android:layout_width="3.53dp"
            android:layout_height="7dp"
            android:layout_marginLeft="4dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/bubble_below_arror"
        android:background="@drawable/ttlive_comment_ai_guide_arrow"
        android:layout_width="20dp"
        android:layout_height="7dp"/>
</LinearLayout>
