<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ttlive_components_market_anchor_root"
    android:background="@drawable/ttlive_anchor_bg"
    android:focusable="true"
    android:layout_width="wrap_content"
    android:layout_height="22dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/anchor_avatar"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginLeft="2dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_ic_default_head_small"
        app:roundAsCircle="true"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:id="@+id/anchor_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:maxWidth="90dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/anchor_avatar"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/space"
        android:visibility="gone"
        android:layout_width="4dp"
        android:layout_height="1dp"
        app:layout_constraintLeft_toRightOf="@+id/anchor_verify"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/anchor_verify"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginLeft="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/anchor_name"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.common.MinMaxWidthLinearLayout
        android:orientation="horizontal"
        android:id="@+id/new_anchor_name_and_verify_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/anchor_avatar"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.livesdk.common.MarqueeTextView
            android:layout_gravity="center_vertical"
            android:id="@+id/new_anchor_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/new_anchor_verify"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="2dp"/>
    </com.bytedance.android.livesdk.common.MinMaxWidthLinearLayout>
    <View
        android:id="@+id/new_space"
        android:visibility="gone"
        android:layout_width="4dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@+id/new_anchor_name_and_verify_layout"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/follow_layout"
        android:background="@drawable/ttlive_follow_layout_bg"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ttlive_anchor_follow_height"
        android:layout_marginLeft="8dp"
        android:minHeight="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/anchor_verify"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/normal_background"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/ttlive_bg_live_follow_red"
            android:alpha="0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <ImageView
            android:id="@+id/follow_success_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/ttlive_bg_live_follow_transparent"
            android:alpha="0"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <com.bytedance.android.live.core.widget.FitTextView
            android:textSize="11dp"
            android:textStyle="bold"
            android:textColor="#fe2c55"
            android:gravity="center"
            android:id="@+id/follow"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_follow_label"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.live.core.widget.FitTextView
            android:textSize="11dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/follow_success"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_follow_label_success"
            android:alpha="0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/follow_animator"
            android:layout_width="30dp"
            android:layout_height="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ProgressBar
            android:id="@+id/follow_progress"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@android:style/Widget.ProgressBar.Small"/>
        <ImageView
            android:id="@+id/follow_single_plus"
            android:padding="4dp"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ttlive_follow_button_image_white_46"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:gravity="center_vertical"
        android:id="@+id/vs_fans_container"
        android:layout_width="35dp"
        android:layout_height="18dp"
        android:layout_marginLeft="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/follow_layout"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
