<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/collect_title_bar_layout"
    android:background="@color/aos_sd_quaternary"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <View
        android:id="@+id/title_color_ctrl"
        android:background="@color/aos_bg_primary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"/>
    <FrameLayout
        android:id="@+id/title_bar_content_fl"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.awemeopen.apps.framework.base.view.AutoRTLImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/back_btn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/aos_user_collect_back_white"
            android:scaleType="centerCrop"
            android:layout_marginStart="16dp"/>
        <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
            android:textStyle="bold"
            android:textColor="@color/aos_text_primary"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="100dp"
            android:layout_marginRight="100dp"
            android:text="@string/aos_collect_title"
            android:maxLines="1"
            style="@style/font_size_34_sp"/>
        <com.bytedance.awemeopen.infra.base.image.AoImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/title_bar_tips"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/aos_user_collect_title_tips_white"
            android:scaleType="centerCrop"
            android:layout_marginEnd="16dp"/>
    </FrameLayout>
</FrameLayout>
