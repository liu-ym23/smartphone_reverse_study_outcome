<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/container_new_ui"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.bytedance.android.ec.core.widget.SquareFrameLayout
            android:id="@+id/container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <include
            android:visibility="gone"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="120dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/new_style_replay_entrance_layout"/>
        <View
            android:id="@+id/product_feed_header_image_shadow"
            android:background="@drawable/commerce_bg_product_feed_header_view_shadow"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <include
            android:id="@+id/product_card_tag_root_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginBottom="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            layout="@layout/ec_commerce_product_card_tag_view"/>
        <include
            android:id="@+id/guessulike_product_card_same_product_entrance"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            layout="@layout/ec_commerce_feed_item_same_product_entrance_layout"/>
        <include
            android:id="@+id/product_card_same_product_entrance_new"
            android:visibility="gone"
            android:layout_width="70dp"
            android:layout_height="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            layout="@layout/ec_commerce_feed_item_same_product_entrance_new_layout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
