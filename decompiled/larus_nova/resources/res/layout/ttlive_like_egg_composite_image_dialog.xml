<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/composite_image_preview_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/dialog_root"
        android:background="#161823"
        android:layout_width="match_parent"
        android:layout_height="450dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.bytedance.android.livesdk.chatroom.ui.DouyinLoadingLayout
        android:id="@+id/loading_anim_view"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="@+id/dialog_root"
        app:layout_constraintEnd_toEndOf="@+id/dialog_root"
        app:layout_constraintStart_toStartOf="@+id/dialog_root"
        app:layout_constraintTop_toTopOf="@+id/dialog_root"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#bfffffff"
        android:id="@+id/loading_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/ttlive_like_egg_composite_image_loading_tip"
        app:layout_constraintEnd_toEndOf="@+id/dialog_root"
        app:layout_constraintStart_toStartOf="@+id/dialog_root"
        app:layout_constraintTop_toBottomOf="@+id/loading_anim_view"/>
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="start|center_vertical"
        android:id="@+id/dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:minWidth="150dp"
        android:text="@string/ttlive_like_egg_composite_image_dialog_title"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@+id/dialog_root"
        app:layout_constraintTop_toTopOf="@+id/dialog_root"/>
    <ImageView
        android:id="@+id/btn_close"
        android:background="@drawable/ttlive_like_egg_image_picker_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="@+id/dialog_root"
        app:layout_constraintTop_toTopOf="@+id/dialog_root"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/btn_cancel"
        android:background="@drawable/ttlive_like_egg_button_bg_grey"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginBottom="16dp"
        android:text="@string/ttlive_like_egg_composite_cancel"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/dialog_root"
        app:layout_constraintEnd_toStartOf="@+id/btn_confirm"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="@+id/dialog_root"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/btn_confirm"
        android:background="@drawable/ttlive_like_egg_button_bg_magenta"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginBottom="16dp"
        android:text="@string/ttlive_like_egg_composite_confirm"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/dialog_root"
        app:layout_constraintEnd_toEndOf="@+id/dialog_root"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/btn_cancel"/>
    <View
        android:id="@+id/shadow_view"
        android:background="#99000000"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/click_outside"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/dialog_root"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/preview_image"
        android:background="#0fffffff"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="72dp"
        android:layout_marginBottom="108dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/dialog_root"
        app:layout_constraintDimensionRatio="H,1:0.69"
        app:layout_constraintEnd_toEndOf="@+id/dialog_root"
        app:layout_constraintStart_toStartOf="@+id/dialog_root"
        app:layout_constraintTop_toTopOf="@+id/dialog_root"
        app:roundBottomLeft="true"
        app:roundBottomRight="true"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="8dp"/>
    <ImageView
        android:id="@+id/preview_close_button"
        android:background="@drawable/ttlive_ic_like_egg_animation_exit"
        android:visibility="invisible"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/loading_error_container"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/dialog_root"
        app:layout_constraintEnd_toEndOf="@+id/dialog_root"
        app:layout_constraintStart_toStartOf="@+id/dialog_root"
        app:layout_constraintTop_toTopOf="@+id/dialog_root">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="192dp"
            android:layout_height="126dp"
            android:src="@drawable/ttlive_bg_network_error"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#e5ffffff"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_like_egg_network_error"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#80ffffff"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ttlive_like_egg_network_error_tips"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#e5ffffff"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/network_retry"
            android:background="@drawable/ttlive_like_egg_button_bg_grey"
            android:layout_width="192dp"
            android:layout_height="36dp"
            android:layout_marginTop="40dp"
            android:text="@string/ttlive_like_egg_network_error_retry"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
