<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_content"
    android:background="@drawable/larus_bg_dora_widget_diary_4x4"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/diary_data_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <RelativeLayout
            android:id="@+id/diary_beta_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/neutral_50"
                android:id="@+id/diary_beta_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/neutral_50"
                android:id="@+id/glass_state_disconnected"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_dora_widget_not_connected"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
            <LinearLayout
                android:id="@+id/glass_state_connected"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true">
                <RelativeLayout
                    android:id="@+id/glass_info"
                    android:layout_width="56dp"
                    android:layout_height="27dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/icon_dora_widget_glass"
                        android:layout_alignParentTop="true"
                        android:contentDescription="@null"
                        android:layout_alignParentStart="true"/>
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/larus_neutral_100"
                        android:gravity="center"
                        android:id="@+id/glass_power_level_percent"
                        android:layout_width="34dp"
                        android:layout_height="20dp"
                        android:text="@string/larus_dora_widget_power_percent_100"
                        android:includeFontPadding="false"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"/>
                    <RelativeLayout
                        android:layout_width="46dp"
                        android:layout_height="3dp"
                        android:layout_marginBottom="4dp"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentStart="true">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/icon_dora_widget_power_progress_bg"
                            android:contentDescription="@null"/>
                        <ProgressBar
                            android:id="@+id/glass_power_progress_bar_green"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:max="100"
                            android:progress="100"
                            android:progressDrawable="@drawable/icon_dora_widget_power_progress_bar_green"
                            style="?android:attr/progressBarStyleHorizontal"/>
                        <ProgressBar
                            android:id="@+id/glass_power_progress_bar_yellow"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:max="100"
                            android:progress="100"
                            android:progressDrawable="@drawable/icon_dora_widget_power_progress_bar_yellow"
                            style="?android:attr/progressBarStyleHorizontal"/>
                        <ProgressBar
                            android:id="@+id/glass_power_progress_bar_red"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:max="100"
                            android:progress="100"
                            android:progressDrawable="@drawable/icon_dora_widget_power_progress_bar_red"
                            style="?android:attr/progressBarStyleHorizontal"/>
                    </RelativeLayout>
                    <ImageView
                        android:id="@+id/glass_charge_flash"
                        android:visibility="gone"
                        android:layout_width="10dp"
                        android:layout_height="11dp"
                        android:src="@drawable/icon_dora_widget_lightening"
                        android:layout_alignParentBottom="true"
                        android:contentDescription="@null"
                        android:layout_marginStart="18dp"
                        android:layout_alignParentStart="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/glass_box_info"
                    android:layout_width="56dp"
                    android:layout_height="27dp"
                    android:layout_marginStart="16dp">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="20dp"
                        android:src="@drawable/icon_dora_widget_glass_box"
                        android:layout_alignParentTop="true"
                        android:contentDescription="@null"
                        android:layout_alignParentStart="true"/>
                    <TextView
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/larus_neutral_100"
                        android:gravity="center"
                        android:id="@+id/glass_box_power_level_percent"
                        android:layout_width="34dp"
                        android:layout_height="20dp"
                        android:text="@string/larus_dora_widget_power_percent_100"
                        android:includeFontPadding="false"
                        android:layout_alignParentTop="true"
                        android:layout_marginEnd="4dp"
                        android:layout_alignParentEnd="true"/>
                    <RelativeLayout
                        android:layout_width="46dp"
                        android:layout_height="3dp"
                        android:layout_marginBottom="4dp"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentStart="true">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/icon_dora_widget_power_progress_bg"
                            android:contentDescription="@null"/>
                        <ProgressBar
                            android:id="@+id/glass_box_power_progress_bar_green"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:max="100"
                            android:progress="100"
                            android:progressDrawable="@drawable/icon_dora_widget_power_progress_bar_green"
                            style="?android:attr/progressBarStyleHorizontal"/>
                        <ProgressBar
                            android:id="@+id/glass_box_power_progress_bar_yellow"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:max="100"
                            android:progress="100"
                            android:progressDrawable="@drawable/icon_dora_widget_power_progress_bar_yellow"
                            style="?android:attr/progressBarStyleHorizontal"/>
                        <ProgressBar
                            android:id="@+id/glass_box_power_progress_bar_red"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:max="100"
                            android:progress="100"
                            android:progressDrawable="@drawable/icon_dora_widget_power_progress_bar_red"
                            style="?android:attr/progressBarStyleHorizontal"/>
                    </RelativeLayout>
                    <ImageView
                        android:id="@+id/glass_box_charge_flash"
                        android:visibility="gone"
                        android:layout_width="10dp"
                        android:layout_height="11dp"
                        android:src="@drawable/icon_dora_widget_lightening"
                        android:layout_alignParentBottom="true"
                        android:contentDescription="@null"
                        android:layout_marginStart="18dp"
                        android:layout_alignParentStart="true"/>
                </RelativeLayout>
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/diary_beta_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="12dp"
            android:layout_above="@+id/diary_beta_footer"
            android:layout_alignParentTop="true">
            <ImageView
                android:id="@+id/diary_beta_cover"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:scaleType="fitXY"
                android:layout_weight="1"
                android:contentDescription="@null"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/larus_neutral_100"
                android:ellipsize="end"
                android:id="@+id/diary_beta_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:maxLines="1"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/neutral_50"
                android:ellipsize="end"
                android:id="@+id/diary_beta_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:lineSpacingExtra="3dp"/>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
