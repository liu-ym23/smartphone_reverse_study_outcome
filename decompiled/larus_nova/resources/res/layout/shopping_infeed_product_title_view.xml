<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/infeed_product_title_line"
        android:background="@drawable/shopping_bg_infeed_product_title_line"
        android:layout_width="1dp"
        android:layout_height="12dp"
        android:layout_marginRight="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/infeed_product_detail_guide"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/shopping_color_FF3B52"
        android:id="@+id/infeed_product_detail_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="5dp"
        android:text="@string/shopping_infeed_product_detail_guide"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/infeed_product_detail_arrow"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/infeed_product_detail_arrow"
        android:layout_width="8dp"
        android:layout_height="12dp"
        android:layout_marginTop="1dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/shopping_color_000000"
        android:id="@+id/infeed_product_title_tv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="5dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/infeed_product_title_line"/>
    <View
        android:background="@drawable/commerce_bg_product_feed_title_arrow_v2"
        android:layout_width="20dp"
        android:layout_height="0dp"
        android:layout_marginRight="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/infeed_product_title_line"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
