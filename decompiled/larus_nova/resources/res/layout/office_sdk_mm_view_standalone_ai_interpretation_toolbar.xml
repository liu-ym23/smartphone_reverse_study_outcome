<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_caption"
        android:gravity="center"
        android:id="@+id/tvDuration"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_marginTop="10dp"
        android:includeFontPadding="false"
        android:fontFamily="monospace"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/MmAudioWaveBarViewCon"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="4dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDuration">
        <com.ss.android.lark.officesdk.minutes.ui.foundation.widget.wavebar.MmAudioWaveBarView
            android:layout_gravity="center_vertical"
            android:id="@+id/recordWaveBarView"
            android:layout_width="match_parent"
            android:layout_height="32dp"/>
        <View
            android:layout_gravity="start|center_vertical"
            android:id="@+id/gradientLeft"
            android:layout_width="50dp"
            android:layout_height="56dp"/>
        <View
            android:layout_gravity="end|center_vertical"
            android:id="@+id/gradientRight"
            android:layout_width="50dp"
            android:layout_height="56dp"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/toolbarActionContainer"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/MmAudioWaveBarViewCon"
        app:layout_constraintVertical_bias="0">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/recordKeyPointContainer"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/save_action_container"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="44dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/text_caption"
                    android:ellipsize="end"
                    android:id="@+id/save_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/View_AIInterpret_SaveRecord_Switch"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
                <ViewStub
                    android:id="@+id/save_switch_stub"
                    android:inflatedId="@+id/save_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:enabled="false"
            android:id="@+id/ivResumePause"
            android:padding="13dp"
            android:layout_width="78dp"
            android:layout_height="44dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivStop"
            android:padding="13dp"
            android:layout_width="78dp"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"/>
    </LinearLayout>
</merge>
