<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.obric.oui.titlebar.OFloatingTitleBar
            android:id="@+id/title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:oFloatingTitleBar_maskBlurRadius="8"
            app:oFloatingTitleBar_statusBarImmersion="true"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_zone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_104"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="@dimen/dp_78"
                android:layout_height="@dimen/dp_78"
                android:layout_marginTop="@dimen/dp_9"
                android:src="@drawable/obric_guide_doubao_icon"/>
            <TextView
                android:textSize="@dimen/dp_26"
                android:textColor="@color/obric_guide_text_1"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_21"
                android:text="@string/obric_enroll_finger_print"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="@dimen/dp_15"
                android:textColor="@color/obric_guide_text_1"
                android:layout_gravity="center"
                android:id="@+id/finger_print_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_9"
                android:layout_marginBottom="@dimen/dp_26"
                android:text="@string/obric_complete_identity_verification_and_synchronously_unlock_system"/>
            <TextView
                android:textSize="@dimen/dp_15"
                android:textColor="@color/obric_guide_blue_6"
                android:layout_gravity="center"
                android:id="@+id/already_enroll"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_9"
                android:layout_marginBottom="@dimen/dp_26"
                android:text="@string/obric_setting_voice_print_management_recorded"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mid_zone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/foot_zone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_zone"
        app:layout_constraintVertical_bias="0">
        <ImageView
            android:id="@+id/fingerprint_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/foot_zone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mid_zone"
        app:layout_constraintVertical_bias="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_14"
            app:layout_constraintBottom_toTopOf="@+id/finger_print_start"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <com.obric.oui.checkbox.OCheckBoxLayout
                android:id="@+id/checkbox_fingerprint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/dp_15"
                android:textColor="@color/obric_guide_text_1"
                android:gravity="center_vertical"
                android:id="@+id/fingerprint_hint1"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dp_5"
                android:layout_marginBottom="@dimen/dp_8"
                android:text="@string/obric_allow"
                android:layout_marginStart="@dimen/dp_2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/checkbox_fingerprint"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/dp_15"
                android:textColor="@color/obric_guide_blue_6"
                android:gravity="center_vertical"
                android:id="@+id/fingerprint_hint2"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dp_5"
                android:layout_marginBottom="@dimen/dp_8"
                android:text="@string/obric_finger_print_rule"
                android:layout_marginStart="@dimen/dp_4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/fingerprint_hint1"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/obric_guide_text_3"
            android:id="@+id/finger_print_already_hint"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_23"
            android:text="@string/obric_finger_print_already_enroll"
            app:layout_constraintBottom_toTopOf="@+id/next_step"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.obric.oui.button.OButton
            android:gravity="center"
            android:id="@+id/finger_print_start"
            android:layout_width="@dimen/dp_338"
            android:layout_height="@dimen/dp_52"
            android:layout_marginBottom="@dimen/dp_13"
            android:text="@string/obric_right_now"
            app:layout_constraintBottom_toTopOf="@+id/setup_later"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/OStyleV2.OButton.L.Standard.Primary"/>
        <com.obric.oui.button.OButton
            android:gravity="center"
            android:id="@+id/next_step"
            android:visibility="gone"
            android:layout_width="@dimen/dp_338"
            android:layout_height="@dimen/dp_52"
            android:layout_marginBottom="@dimen/dp_91"
            android:text="@string/obric_next_step"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/OStyleV2.OButton.L.Standard.Primary"/>
        <com.obric.oui.button.OButton
            android:textColor="@color/obric_guide_text_1"
            android:gravity="center"
            android:id="@+id/setup_later"
            android:layout_width="@dimen/dp_338"
            android:layout_height="@dimen/dp_52"
            android:layout_marginBottom="@dimen/dp_10"
            android:text="@string/obric_setting_later"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/OStyleV2.OButton.L.Trans.Primary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
