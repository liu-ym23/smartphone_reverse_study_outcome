<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/cj_pay_single_fragment_activity_root_view"
    android:background="@color/cj_pay_color_layer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/cj_pay_outer_authorize_root"
        android:background="@drawable/cj_pay_bg_fragment_container"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/cj_pay_outer_authorize_back"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/cj_pay_icon_titlebar_left_close_noise_reduction"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/cj_pay_color_black_161823"
            android:id="@+id/cj_pay_outer_authorize_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="15dp"
            android:layout_below="@+id/cj_pay_outer_authorize_back"/>
        <RelativeLayout
            android:id="@+id/cj_pay_outer_agreement_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_below="@+id/cj_pay_outer_authorize_title">
            <com.android.ttcjpaysdk.base.theme.widget.CJPayCircleCheckBox
                android:id="@+id/cj_pay_outer_authorize_agreement_checkbox"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="1sp"
                android:layout_marginRight="6dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_60"
                android:id="@+id/cj_pay_outer_authorize_agreement_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/cj_pay_outer_authorize_agreement_checkbox"/>
        </RelativeLayout>
        <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
            android:textSize="16sp"
            android:textColor="@color/cj_pay_color_white"
            android:gravity="center"
            android:id="@+id/cj_pay_outer_authorize_confirm_btn"
            android:background="@color/cj_pay_color_red_fe2c55"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:text="@string/cj_pay_authorize_confirm_button"
            android:layout_below="@+id/cj_pay_outer_agreement_group"/>
        <ProgressBar
            android:id="@+id/cj_pay_outer_authorize_confirm_btn_loading"
            android:background="@color/cj_pay_color_trans"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle"
            android:indeterminateDuration="500"
            android:indeterminateBehavior="repeat"
            android:layout_alignTop="@+id/cj_pay_outer_authorize_confirm_btn"
            android:layout_alignBottom="@+id/cj_pay_outer_authorize_confirm_btn"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</FrameLayout>
