<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_interact_dialog"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="271dp">
    <TextView
        android:textSize="15dp"
        android:textColor="#161823"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/ttlive_team_fight_invite_select_team_panel_title_flexible"/>
    <View
        android:background="#14000000"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="15dp"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center"
        android:id="@+id/avatar_iv"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="20dp"
        app:placeholderImage="@drawable/ttlive_img_avatar_empty"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#161823"
        android:layout_gravity="center_horizontal"
        android:id="@+id/user_name_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="24dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_white"
            android:gravity="center"
            android:id="@+id/red_team_invite_btn"
            android:background="@drawable/ttlive_bg_team_fight_flexible_red_team_invite_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="8dp"
            android:text="@string/ttlive_team_fight_invite_select_red_team"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_white"
            android:gravity="center"
            android:id="@+id/blue_team_invite_btn"
            android:background="@drawable/ttlive_bg_team_fight_flexible_blue_team_invite_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/ttlive_team_fight_invite_select_blue_team"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
