<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_live_record_share_dialog"
    android:layout_width="306dp"
    android:layout_height="541dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="start|top"
        android:id="@+id/image"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="3dp"
        app:actualImageScaleType="focusCrop"/>
    <SurfaceView
        android:layout_gravity="start|top"
        android:id="@+id/video"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="3dp"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="start|bottom"
        android:orientation="horizontal"
        android:id="@+id/anchor_action_container"
        android:background="@color/ttlive_white"
        android:paddingLeft="30dp"
        android:paddingRight="30dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginLeft="3dp"
        android:layout_marginRight="3dp"
        android:layout_marginBottom="3dp"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp">
        <ImageView
            android:layout_gravity="center"
            android:background="@drawable/ttlive_ic_live_record_save"
            android:layout_width="24dp"
            android:layout_height="24dp"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_live_record_share_save"
            android:maxLines="1"
            android:lines="1"/>
    </LinearLayout>
    <HorizontalScrollView
        android:layout_gravity="start|bottom"
        android:id="@+id/audience_action_container"
        android:background="@color/ttlive_white"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginLeft="3dp"
        android:layout_marginRight="3dp"
        android:layout_marginBottom="3dp"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/action_container"
            android:paddingLeft="12dp"
            android:paddingRight="6dp"
            android:layout_width="wrap_content"
            android:layout_height="90dp"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"/>
    </HorizontalScrollView>
    <ImageView
        android:layout_gravity="end|top"
        android:id="@+id/close"
        android:background="@drawable/ttlive_bg_live_record_share_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ttlive_ic_live_record_share_close"
        android:scaleType="fitXY"/>
</FrameLayout>
