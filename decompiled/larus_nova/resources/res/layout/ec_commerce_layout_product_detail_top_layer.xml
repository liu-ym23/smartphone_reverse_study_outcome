<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.shopping.anchorv4.voavhs.headgausee.HeadGaussRecyclerView
        android:orientation="horizontal"
        android:id="@+id/anchor_v4_status_bar_gauss"
        android:background="@color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/anchor_v4_strand_wrapper"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:layout_gravity="top"
        android:id="@+id/anchor_v4_top_nav_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:id="@+id/anchor_v4_playback_container_top"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="70dp"/>
    <FrameLayout
        android:id="@+id/anchor_v4_comment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/anchor_v4_bottom_nav_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.bytedance.android.shopping.anchorv4.widgets.PdpLynxToastLayout
        android:layout_gravity="center"
        android:id="@+id/anchor_v4_pdp_lynx_toast_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
