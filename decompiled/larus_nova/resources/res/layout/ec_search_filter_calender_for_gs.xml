<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/filter_common_root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_marginTop="13dp"
    android:layout_marginBottom="13dp">
    <com.ss.android.ugc.aweme.search.filter.view.good.ECSearchFilterCornerBg
        android:id="@+id/filter_common_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/choose_date_layout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <com.ss.android.ugc.aweme.search.filter.view.ui.NoPaddingTextView
                android:textSize="14sp"
                android:layout_gravity="center"
                android:id="@+id/filter_choose_date_text"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:minHeight="16dp"
                android:maxLines="1"
                android:layout_marginStart="2dp"/>
            <com.bytedance.lighten.loader.SmartImageView
                android:id="@+id/choose_date_icon_right"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="2dp"
                android:scaleType="fitXY"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/current_date_layout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/first_date_layout"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.ss.android.ugc.aweme.search.filter.view.ui.ExcludeFontPaddingTextView
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:id="@+id/first_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
                <com.ss.android.ugc.aweme.search.filter.view.ui.ExcludeFontPaddingTextView
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:id="@+id/first_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/second_date_layout"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.ss.android.ugc.aweme.search.filter.view.ui.ExcludeFontPaddingTextView
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:id="@+id/second_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
                <com.ss.android.ugc.aweme.search.filter.view.ui.ExcludeFontPaddingTextView
                    android:textSize="14dp"
                    android:textStyle="bold"
                    android:id="@+id/second_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <com.bytedance.lighten.loader.SmartImageView
                android:id="@+id/current_date_icon_right"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="2dp"
                android:scaleType="fitXY"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
