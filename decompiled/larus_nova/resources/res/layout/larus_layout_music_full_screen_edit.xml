<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fullscreen"
    android:background="@color/larus_static_black_transparent_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/container_wrapper"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/fullscreen_container"
            android:background="?attr/larus_bg_top_round_base_3"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/close_button"
                android:background="@drawable/larus_bg_music_full_screen_close"
                android:padding="8dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="12dp"
                android:src="@drawable/larus_ic_music_close"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/neutral_100"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/larus_music_write"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <FrameLayout
                android:id="@+id/edit_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                app:layout_constraintBottom_toTopOf="@+id/voice_input_container"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/close_button">
                <ScrollView
                    android:id="@+id/edit_scroll_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_4"
                    android:layout_marginStart="?attr/larus_dp_24"
                    android:layout_marginEnd="?attr/larus_dp_4">
                    <EditText
                        android:textSize="?attr/larus_dp_17"
                        android:gravity="start|top"
                        android:id="@+id/input_edit"
                        android:background="@null"
                        android:paddingBottom="?attr/larus_dp_90"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/larus_music_full_screen_lyrics_hint"
                        android:lineSpacingMultiplier="1.25"
                        android:inputType="textMultiLine"
                        android:layout_marginEnd="?attr/larus_dp_20"
                        style="@style/larus_EditTextStyle"/>
                </ScrollView>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/voice_input_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/edit_container"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/bottom_shadow"
            android:background="?attr/larus_bg_full_screen_edit_shadow"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_64"
            android:alpha="0"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="bottom"
            android:id="@+id/action_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:alpha="0">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_16"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/action_confirm"
                android:background="@drawable/larus_bg_music_full_screen_confirm"
                android:layout_width="?attr/larus_dp_64"
                android:layout_height="?attr/larus_dp_44"
                android:text="@string/larus_music_full_screen_confirm"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/action_ai_gen"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginRight="24dp"
                android:src="@drawable/larus_ic_ai_music"
                app:layout_constraintBottom_toBottomOf="@+id/action_confirm"
                app:layout_constraintEnd_toStartOf="@+id/action_confirm"
                app:layout_constraintTop_toTopOf="@+id/action_confirm"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.larus.common_ui.view.TouchInterceptingView
            android:id="@+id/input_intercept_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</FrameLayout>
