<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/inline_ai_asr_section_background"
    android:paddingTop="10dp"
    android:paddingBottom="36dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/drag_view_wrapper"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.larksuite.component.ui.imageview.LKUIRoundedImageView2
            android:id="@+id/drag_icon"
            android:background="@color/bg_body"
            android:padding="6dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/ud_icon_up_bold_outlined"
            android:tint="@color/icon_n2"
            android:layout_marginStart="16dp"
            app:radius="20dp"/>
        <com.ss.android.lark.inline.ai.asr.subprompt.SubPromptRecyclerView
            android:id="@+id/subprompt_rv"
            android:visibility="gone"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@+id/drag_icon"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_title"
            android:id="@+id/drag_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            app:lineHeight="22dp"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toTopOf="@+id/tips_group"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/drag_view_wrapper"
        app:layout_goneMarginBottom="8dp"/>
    <RelativeLayout
        android:id="@+id/tips_group"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/operates_rv"
        app:layout_constraintEnd_toStartOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content_container">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/tips_icon"
            android:paddingTop="13dp"
            android:paddingBottom="1dp"
            android:layout_width="38dp"
            android:layout_height="30dp"
            android:paddingStart="5dp"
            android:paddingEnd="12dp"
            app:srcCompat="@drawable/ud_icon_info_outlined"
            app:tint="@color/icon_disable"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="12sp"
            android:textColor="@color/text_disabled"
            android:id="@+id/tips_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/LarkCCM_Docs_MyAi_Caution_Description"
            android:layout_marginStart="-8dp"
            android:layout_toEndOf="@+id/tips_icon"
            app:lineHeight="18dp"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/operates_rv"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/input_group"
        app:layout_constraintTop_toBottomOf="@+id/tips_group"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/input_group"
        android:background="@drawable/inline_ai_input_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/operates_rv">
        <FrameLayout
            android:id="@+id/input_icon_wrapper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/input_icon_normal"
                android:padding="1dp"
                android:layout_width="20dp"
                android:layout_height="20dp"
                app:srcCompat="@drawable/ud_icon_myai_colorful"/>
            <com.larksuite.component.ui.imageview.LKUILottieAnimationView
                android:id="@+id/input_icon_thinking"
                android:padding="1dp"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/inline_ai_thinking_anim"
                app:lottie_repeatMode="restart"/>
        </FrameLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="@color/text_caption"
            android:id="@+id/input_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="@string/LarkCCM_Docs_MyAi_Custom_Writing_Placeholder"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/input_right_icon_wrapper"
            app:layout_constraintStart_toEndOf="@+id/input_icon_wrapper"
            app:layout_constraintTop_toTopOf="parent"
            app:lineHeight="22dp"/>
        <FrameLayout
            android:id="@+id/input_right_icon_wrapper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/input_stop_icon"
                android:padding="7dp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:srcCompat="@drawable/ud_icon_stop_outlined"
                app:tint="@color/icon_n3"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
