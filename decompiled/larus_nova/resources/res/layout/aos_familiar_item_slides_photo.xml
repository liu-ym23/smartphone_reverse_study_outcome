<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.awemeopen.infra.base.image.AoImageView
            android:layout_gravity="center"
            android:id="@+id/image_iv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/image_load_fail"
        android:visibility="gone"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/aos_common_feed_image_load_fail"/>
    <com.bytedance.awemeopen.infra.base.anim.lottie.AoAnimationLottieView
        android:layout_gravity="center"
        android:id="@+id/loading_view"
        android:visibility="gone"
        android:layout_width="120dp"
        android:layout_height="120dp"/>
</FrameLayout>
