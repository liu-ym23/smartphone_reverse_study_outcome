<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/anchor_v4_top_tab_area"
    android:background="@color/BGReverse"
    android:layout_width="match_parent"
    android:layout_height="@dimen/commerce_anchor_v3_top_tab_height">
    <com.google.android.material.tabs.TabLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/anchor_v4_top_tab_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/commerce_anchor_v3_top_tab_height"
        app:tabBackground="@color/SDQuaternary"
        app:tabGravity="fill"
        app:tabIndicatorColor="#ff161823"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="2dp"
        app:tabRippleColor="@color/SDQuaternary"
        app:tabSelectedTextColor="#ff161823"
        app:tabTextAppearance="@style/commerce_anchor_v3_tab_style"
        app:tabTextColor="@color/TextReverse3"/>
    <View
        android:layout_gravity="bottom"
        android:background="@color/color_33black"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
</FrameLayout>
