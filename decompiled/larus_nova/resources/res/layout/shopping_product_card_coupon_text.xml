<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:textSize="11dp"
        android:textColor="@color/Primary"
        android:gravity="center"
        android:id="@+id/coupon_prefix"
        android:background="@drawable/ecommerce_coupon_item_left"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:lineSpacingExtra="2dp"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <ImageView
        android:id="@+id/coupon_divider"
        android:layout_width="0.5dp"
        android:layout_height="match_parent"
        android:layout_marginBottom="1dp"
        android:src="@drawable/ecommerce_coupon_divider_v2"
        android:scaleType="fitXY"
        app:layout_constraintRight_toRightOf="@+id/coupon_prefix"/>
    <ImageView
        android:id="@+id/coupon_arrow"
        android:visibility="gone"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:src="@drawable/ec_shop_coupon_arrow"
        android:scaleType="fitXY"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="-2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/coupon_divider"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/Primary"
        android:gravity="center"
        android:id="@+id/coupon_tag"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:lineSpacingExtra="2dp"
        app:layout_constraintLeft_toRightOf="@+id/coupon_arrow"/>
    <View
        android:id="@+id/coupon_stroke"
        android:background="@drawable/ecommerce_coupon_item_border"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintLeft_toLeftOf="@+id/coupon_prefix"
        app:layout_constraintRight_toRightOf="@+id/coupon_tag"/>
</merge>
