<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/blur_iv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:placeholderImage="@drawable/shopping_bg_blur_placeholder"
        app:placeholderImageScaleType="centerCrop"/>
    <View
        android:background="#33000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:layout_gravity="top"
        android:id="@+id/video_container"
        android:layout_width="match_parent"
        android:layout_height="376dp"
        android:layout_marginTop="138dp"/>
    <ImageView
        android:layout_gravity="top"
        android:id="@+id/playing_icon"
        android:layout_width="74dp"
        android:layout_height="18dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="150dp"
        android:src="@drawable/shopping_ic_infeed_live_icon"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:layout_gravity="top"
        android:id="@+id/content_iv"
        android:layout_width="match_parent"
        android:layout_height="376dp"
        android:layout_marginTop="138dp"
        android:scaleType="centerCrop"
        app:actualImageScaleType="centerCrop"
        app:placeholderImage="@drawable/ec_ecommerce_slogan_product_bg"
        app:placeholderImageScaleType="centerCrop"/>
</FrameLayout>
