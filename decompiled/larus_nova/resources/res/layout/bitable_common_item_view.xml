<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.ee.bear.facade.common.widget.RoundFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:id="@+id/item_container"
    android:background="@color/bg_float"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/space_kit_len_48"
    android:paddingStart="@dimen/space_kit_len_16"
    android:backgroundTint="@color/bitable_panel_view_item_tint"
    app:radius="0dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_kit_len_16">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_kit_len_10"
            android:layout_marginBottom="@dimen/space_kit_len_10">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.larksuite.component.universe_design.checkbox.UDCheckBox
                    android:layout_gravity="center_vertical"
                    android:id="@+id/item_select"
                    android:padding="0dp"
                    android:visibility="gone"
                    android:clickable="false"
                    android:layout_width="@dimen/space_kit_len_20"
                    android:layout_height="@dimen/space_kit_len_20"
                    android:checked="true"
                    android:layout_marginEnd="@dimen/space_kit_len_16"/>
                <com.bytedance.ee.bear.bitable.common.widgets.SyncIconImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/left_icon"
                    android:layout_width="@dimen/space_kit_len_20"
                    android:layout_height="@dimen/space_kit_len_20"
                    android:layout_marginRight="@dimen/space_kit_len_12"/>
                <TextView
                    android:textSize="@dimen/space_kit_font_16"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/left_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/space_kit_len_24"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
                <com.bytedance.ee.bear.bitable.card.view.cell.text.BitableSpaceEditText
                    android:textSize="@dimen/space_kit_font_16"
                    android:textColorHint="@color/text_placeholder"
                    android:gravity="center_vertical"
                    android:id="@+id/left_edit_text"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/space_kit_len_24"
                    android:maxWidth="@dimen/space_kit_len_200"
                    android:hint="@string/Bitable_Common_PleaseEnterMobileVer"
                    android:singleLine="true"
                    android:maxLength="50"
                    android:imeOptions="flagNoExtractUi|flagNoFullscreen|actionDone"/>
                <com.bytedance.ee.bear.widgets.universedesign.SimpleTagTextView
                    android:gravity="center_vertical"
                    android:id="@+id/tv_tag"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/left_icon_tag"
                    android:visibility="gone"
                    android:layout_width="@dimen/space_kit_len_12"
                    android:layout_height="@dimen/space_kit_len_12"
                    android:layout_marginStart="8dp"/>
                <TextView
                    android:textSize="@dimen/space_kit_font_14"
                    android:textColor="@color/text_placeholder"
                    android:ellipsize="end"
                    android:id="@+id/desc2"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/space_kit_font_14"
                android:textColor="@color/text_placeholder"
                android:ellipsize="end"
                android:id="@+id/desc"
                android:paddingLeft="@dimen/space_kit_len_32"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <View
            android:id="@+id/wrap_view"
            android:layout_width="wrap_content"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/space_kit_font_14"
            android:textColor="@color/text_placeholder"
            android:ellipsize="end"
            android:id="@+id/right_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/right_icon"
            android:paddingLeft="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="@dimen/space_kit_len_20"
            android:layout_height="@dimen/space_kit_len_24"
            android:layout_marginLeft="8dp"/>
    </LinearLayout>
</com.bytedance.ee.bear.facade.common.widget.RoundFrameLayout>
