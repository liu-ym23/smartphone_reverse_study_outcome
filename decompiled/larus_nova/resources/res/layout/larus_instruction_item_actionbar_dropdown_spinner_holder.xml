<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="?attr/larus_dp_88"
    android:minHeight="?attr/larus_dp_48">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/ic_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginBottom="?attr/larus_dp_12"
        android:layout_marginStart="?attr/larus_dp_16"
        app:failureImage="?attr/larus_base_3_overlay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="?attr/larus_base_3_overlay"
        app:roundedCornerRadius="?attr/larus_dp_4"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_text_show"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginBottom="?attr/larus_dp_16"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ic_item_checked"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/ic_item"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="?attr/larus_dp_12"
        app:layout_goneMarginStart="?attr/larus_dp_16">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="?attr/larus_dp_90">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_dp_16"
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:id="@+id/tv_item_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:textAlignment="viewStart"/>
            <FrameLayout
                android:id="@+id/ic_item_tag"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="?attr/larus_dp_4"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_13"
            android:textColor="?attr/larus_neutral_50"
            android:ellipsize="end"
            android:id="@+id/tv_item_desc"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="?attr/larus_dp_90"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="viewStart"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ic_item_checked"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="?attr/larus_dp_14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/larus_ic_action_bar_dropdown_spinner_check"/>
    <View
        android:id="@+id/item_divider"
        android:background="?attr/larus_neutral_transparent_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
