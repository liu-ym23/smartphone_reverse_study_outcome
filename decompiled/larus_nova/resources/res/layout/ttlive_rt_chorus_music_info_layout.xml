<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/guest_music_info_cl"
        android:layout_width="147dp"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/music_info_bg"
            android:visibility="visible"
            android:layout_width="147dp"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/guest_singing_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginRight="2dp"
            android:src="@drawable/ttlive_rt_chorus_singer_icon"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="@+id/guest_music_name"
            app:layout_constraintRight_toLeftOf="@+id/guest_music_name"
            app:layout_constraintTop_toTopOf="@+id/guest_music_name"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#b3ffffff"
            android:ellipsize="end"
            android:id="@+id/guest_music_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginRight="12dp"
            android:maxLines="1"
            android:maxEms="7"
            android:singleLine="true"
            android:includeFontPadding="false"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#ffffff"
            android:id="@+id/guest_music_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:alpha="0.5"
            app:layout_constraintRight_toRightOf="@+id/guest_music_name"
            app:layout_constraintTop_toBottomOf="@+id/guest_music_name"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/audience_music_info_cl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/audience_singing_left_tail"
            android:layout_width="60dp"
            android:layout_height="8dp"
            android:layout_marginRight="8dp"
            android:src="@drawable/ttlive_rt_chorus_left_sing_tail_icon"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="@+id/audience_singing_icon"
            app:layout_constraintRight_toLeftOf="@+id/audience_singing_icon"
            app:layout_constraintTop_toTopOf="@+id/audience_singing_icon"/>
        <ImageView
            android:id="@+id/audience_singing_icon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ttlive_rt_chorus_singer_icon_light"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="@+id/audience_music_name"
            app:layout_constraintRight_toLeftOf="@+id/audience_music_name"
            app:layout_constraintTop_toTopOf="@+id/audience_music_name"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:id="@+id/audience_music_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:maxLines="1"
            android:singleLine="true"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/audience_singing_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/audience_singing_right_tail"
            android:layout_width="60dp"
            android:layout_height="8dp"
            android:layout_marginLeft="8dp"
            android:src="@drawable/ttlive_rt_chorus_right_sing_tail_icon"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="@+id/audience_music_name"
            app:layout_constraintLeft_toRightOf="@+id/audience_music_name"
            app:layout_constraintTop_toTopOf="@+id/audience_music_name"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#b3ffffff"
            android:id="@+id/audience_music_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/audience_music_name"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/non_sing_cl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/non_sing_left_tail"
            android:layout_width="60dp"
            android:layout_height="8dp"
            android:layout_marginRight="8dp"
            android:src="@drawable/ttlive_rt_chorus_left_sing_tail_icon"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="@+id/non_sing_tv"
            app:layout_constraintRight_toLeftOf="@+id/non_sing_tv"
            app:layout_constraintTop_toTopOf="@+id/non_sing_tv"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:id="@+id/non_sing_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/non_sing_right_tail"
            android:layout_width="60dp"
            android:layout_height="8dp"
            android:layout_marginLeft="8dp"
            android:src="@drawable/ttlive_rt_chorus_right_sing_tail_icon"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="@+id/non_sing_tv"
            app:layout_constraintLeft_toRightOf="@+id/non_sing_tv"
            app:layout_constraintTop_toTopOf="@+id/non_sing_tv"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
