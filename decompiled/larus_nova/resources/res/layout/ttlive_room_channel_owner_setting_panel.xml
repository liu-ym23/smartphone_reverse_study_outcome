<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/owner_setting_panel_container"
    android:background="@color/ttlive_room_channel_member_manage_bg_gray"
    android:layout_width="match_parent"
    android:layout_height="440dp">
    <ScrollView
        android:id="@+id/owner_setting_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/back_iv"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/ttlive_room_channel_panel_leave_arrow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="17dp"
                android:textColor="#161823"
                android:id="@+id/title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_chat_channel_setting_title"
                app:layout_constraintBottom_toBottomOf="@+id/back_iv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/back_iv"/>
            <TextView
                android:id="@+id/relation_sub_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="32dp"
                android:layout_marginTop="27dp"
                android:text="@string/ttlive_chat_channel_setting_sub_title_relation"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/title_tv"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/relation_container"
                android:background="@drawable/ttlive_bg_room_channel_white_radius_8"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/relation_sub_title_tv">
                <FrameLayout
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="57dp">
                    <TextView
                        android:textSize="15dp"
                        android:textColor="#161823"
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ttlive_chat_channel_setting_member_invite"
                        android:includeFontPadding="false"/>
                    <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/member_invite_setting_switch"
                        android:layout_width="43dp"
                        android:layout_height="25dp"
                        app:lsb_background="#33161823"
                        app:lsb_button_color="#ffffff"
                        app:lsb_checked_color="#33e088"
                        app:lsb_effect_duration="50"
                        app:lsb_shadow_radius="0dp"
                        app:lsb_show_indicator="false"
                        app:lsb_uncheck_color="@color/transparent"
                        app:lsb_uncheckbutton_color="#ffffff"/>
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="30dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                app:layout_constraintTop_toBottomOf="@+id/relation_container">
                <TextView
                    android:textSize="15dp"
                    android:textStyle="bold"
                    android:textColor="#161823"
                    android:gravity="center"
                    android:id="@+id/disband_channel"
                    android:background="@drawable/ttlive_chat_channel_setting_dialog_disband_button_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="@string/ttlive_chat_channel_setting_disband"
                    android:layout_weight="1"/>
                <View
                    android:layout_width="8dp"
                    android:layout_height="1dp"/>
                <TextView
                    android:textSize="15dp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/quit_channel"
                    android:background="@drawable/ttlive_chat_channel_setting_dialog_quit_button_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="@string/ttlive_chat_channel_setting_quit"
                    android:layout_weight="1"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</FrameLayout>
