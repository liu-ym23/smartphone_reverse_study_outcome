<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="?attr/larus_dp_72"
    android:layout_height="?attr/larus_dp_96">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/image_template_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:failureImage="@drawable/larus_template_fallback_icon"
        app:placeholderImage="?attr/larus_base_3_overlay"
        app:roundedCornerRadius="?attr/larus_dp_8"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/template_cover_icon"
        android:layout_width="?attr/larus_dp_16"
        android:layout_height="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_8"
        android:src="@drawable/larus_icon_action_bar_template"
        android:scaleType="fitXY"
        android:layout_marginStart="?attr/larus_dp_8"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/image_template_cover_more_container"
        android:background="@drawable/larus_bg_actionbar_img_template_mask"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_55">
        <LinearLayout
            android:layout_gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_10">
            <TextView
                android:textSize="?attr/larus_dp_12"
                android:textColor="@color/larus_static_white"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/image_template_cover_more_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="?attr/larus_dp_70"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/larus_icon_chevron_left_center_fill"
                android:layout_marginStart="?attr/larus_dp_2"/>
        </LinearLayout>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/retry_icon"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        app:srcCompat="?attr/larus_icon_template_arrow_clockwise"/>
</FrameLayout>
