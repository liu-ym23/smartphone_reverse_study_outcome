<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/content"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_marginEnd="4dp">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/consult_layout"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="34dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="12dp">
        <ImageView
            android:id="@+id/consult_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/live_local_life_shelf_bar_consult"/>
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:textSize="11sp"
            android:textColor="#bf161823"
            android:id="@+id/consult_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/live_local_life_shelf_bar_consult"
            android:maxLines="1"
            android:fontFamily="PingFangSC"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/order_layout"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="34dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="12dp">
        <ImageView
            android:id="@+id/order_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/live_local_life_shelf_bar_order"/>
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:textSize="11sp"
            android:textColor="#bf161823"
            android:id="@+id/order_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/live_local_life_shelf_bar_order"
            android:maxLines="1"
            android:fontFamily="PingFangSC"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/vip_layout"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:layout_width="34dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="12dp">
        <ImageView
            android:id="@+id/vip_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/live_local_life_shelf_bar_vip"/>
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:textSize="11sp"
            android:textColor="#bf161823"
            android:id="@+id/vip_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/live_local_life_shelf_bar_vip"
            android:maxLines="1"
            android:fontFamily="PingFangSC"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/more_layout"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="34dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="12dp">
        <ImageView
            android:id="@+id/more_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/live_local_life_shelf_bar_more"/>
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:textSize="11sp"
            android:textColor="#bf161823"
            android:id="@+id/more_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/live_local_life_shelf_bar_more"
            android:maxLines="1"
            android:fontFamily="PingFangSC"/>
    </LinearLayout>
</LinearLayout>
