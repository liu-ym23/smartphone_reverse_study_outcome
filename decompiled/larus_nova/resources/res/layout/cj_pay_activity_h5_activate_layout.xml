<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cj_pay_activity_h5_activate_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/cj_pay_activity_h5_activate_exception_view"
        android:background="@drawable/cj_pay_bg_dy_brand_loading_view"
        android:visibility="gone"
        android:layout_width="136dp"
        android:layout_height="122dp">
        <ImageView
            android:id="@+id/cj_pay_activity_h5_activate_exception_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="24dp"
            android:src="@drawable/cj_pay_toast_error"
            android:scaleType="centerCrop"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/cj_pay_color_white_90"
            android:id="@+id/cj_pay_activity_h5_activate_exception_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:singleLine="true"
            android:layout_below="@+id/cj_pay_activity_h5_activate_exception_icon"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/cj_pay_color_white_60"
            android:id="@+id/cj_pay_activity_h5_activate_exception_recommend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:singleLine="true"
            android:layout_below="@+id/cj_pay_activity_h5_activate_exception_result"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</FrameLayout>
