<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:id="@+id/gamecp_detail_half_head_bg"
        android:background="@drawable/gamecp_game_detail_scaffold_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.gamecp.common.ui.RoundRectLayoutV2
        android:id="@+id/gamecp_detail_half_head_image"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="87dp"
        app:leftTopRound="12dp"
        app:rightTopRound="12dp">
        <com.bytedance.android.gamecp.common.ui.HSImageView
            android:layout_gravity="center"
            android:id="@+id/gamecp_detail_half_head_image_icon"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            app:actualImageScaleType="centerCrop"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/gamecp_detail_half_head_image_icon_frame1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.bytedance.android.gamecp.common.ui.RoundRectLayoutV2>
    <FrameLayout
        android:id="@+id/gamecp_detail_full_head_bg_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/gamecp_detail_full_head_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"/>
        <com.bytedance.android.gamecp.common.ui.RoundRectLayoutV2
            android:id="@+id/gamecp_detail_full_head_image"
            android:layout_width="match_parent"
            android:layout_height="180dp">
            <com.bytedance.android.gamecp.common.ui.HSImageView
                android:layout_gravity="center"
                android:id="@+id/gamecp_detail_full_head_image_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:actualImageScaleType="centerCrop"/>
            <LinearLayout
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:id="@+id/gamecp_detail_full_head_image_icon_frame1"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"/>
                <View
                    android:id="@+id/gamecp_detail_full_head_image_icon_frame2"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"/>
                <View
                    android:id="@+id/gamecp_detail_full_head_image_icon_frame3"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"/>
            </LinearLayout>
        </com.bytedance.android.gamecp.common.ui.RoundRectLayoutV2>
        <View
            android:id="@+id/gamecp_detail_full_head_image_icon_slide_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"/>
    </FrameLayout>
</merge>
