<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/social_conversation_fragment_container"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/social_conversation_fallback_container"
        android:background="@color/larus_base_1"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:paddingBottom="120dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/larus_ic_social_chat_unavailable"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="?attr/larus_neutral_100"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/larus_LarkIM_Feed_ImUnavailable_Empty"
            android:lineSpacingMultiplier="1.5"/>
    </LinearLayout>
</FrameLayout>
