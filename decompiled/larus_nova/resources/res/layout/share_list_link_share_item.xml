<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larksuite.component.universe_design.checkbox.UDCheckBox
        android:id="@+id/share_checkbox"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_5"
        android:layout_marginStart="@dimen/space_kit_len_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ud_checkbox_size="small"
        app:ud_checkbox_type="radio"/>
    <TextView
        android:textSize="@dimen/space_kit_font_16"
        android:textColor="@color/text_title"
        android:id="@+id/share_link_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_16"
        android:layout_marginEnd="@dimen/space_kit_len_16"
        app:layout_constraintBottom_toTopOf="@+id/share_link_item_sub_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/share_checkbox"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginBottom="@dimen/space_kit_len_16"/>
    <TextView
        android:textSize="@dimen/space_kit_font_14"
        android:textColor="@color/ud_N600"
        android:id="@+id/share_link_item_sub_title"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_2"
        android:layout_marginBottom="@dimen/space_kit_len_16"
        android:layout_marginEnd="@dimen/space_kit_len_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/share_link_item_title"
        app:layout_constraintTop_toBottomOf="@+id/share_link_item_title"/>
    <View
        android:id="@+id/share_link_divider"
        android:background="@color/line_divider_default"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/space_kit_len_half"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/share_link_item_title"
        app:layout_constraintTop_toBottomOf="@+id/share_link_item_sub_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
