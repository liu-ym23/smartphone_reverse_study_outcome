<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bdp_shape_round_corner_4dp_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_centerInParent="true">
    <com.bytedance.bdp.serviceapi.defaults.ui.model.OvalImageView
        android:gravity="center"
        android:id="@+id/bdp_iv_top"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bdp_lefttop_x_radius="4dp"
        app:bdp_lefttop_y_radius="4dp"
        app:bdp_righttop_x_radius="4dp"
        app:bdp_righttop_y_radius="4dp"/>
    <TextView
        android:textSize="@dimen/bdp_text_size_16"
        android:textColor="@color/bdp_black_1"
        android:gravity="center"
        android:id="@+id/bdp_tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:maxLines="2"
        android:lineSpacingExtra="5dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <ScrollView
        android:scrollbarThumbHorizontal="@drawable/bdp_scroll_indicator"
        android:scrollbarThumbVertical="@drawable/bdp_scroll_indicator"
        android:id="@+id/bdp_sv_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        android:layout_weight="1">
        <TextView
            android:textSize="@dimen/bdp_text_size_16"
            android:textColor="@color/bdp_80000000"
            android:gravity="center"
            android:id="@+id/bdp_tv_content"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="5dp"/>
    </ScrollView>
    <EditText
        android:textSize="16sp"
        android:ellipsize="end"
        android:id="@+id/bdp_tv_placeholder"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="8dp"
        android:maxLines="2"
        android:inputType="textMultiLine"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <View
            android:background="@color/bdp_black_7"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/bdp_text_size_16"
                android:textColor="@color/modal_cancel_btn_default"
                android:gravity="center"
                android:id="@+id/bdp_tv_cancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <View
                android:id="@+id/bdp_div_2"
                android:background="@color/bdp_black_7"
                android:layout_width="0.5dp"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="@dimen/bdp_text_size_16"
                android:textColor="@color/modal_confirm_btn_default"
                android:gravity="center"
                android:id="@+id/bdp_tv_confirm"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
