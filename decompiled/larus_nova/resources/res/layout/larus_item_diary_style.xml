<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_diary_style_item_container"
    android:paddingLeft="?attr/larus_dp_16"
    android:paddingTop="?attr/larus_dp_12"
    android:paddingRight="?attr/larus_dp_16"
    android:paddingBottom="?attr/larus_dp_12"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/diary_style_icon"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        android:scaleType="centerCrop"
        android:contentDescription="@string/larus_dora_personal_diary_cn"
        android:paddingEnd="?attr/larus_dp_4"
        app:layout_constraintEnd_toStartOf="@+id/diary_style_tag"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_12"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/diary_style_tag"
        android:background="@drawable/larus_bg_diary_style_custom_tag"
        android:paddingLeft="?attr/larus_dp_6"
        android:paddingTop="?attr/larus_dp_3"
        android:paddingRight="?attr/larus_dp_6"
        android:paddingBottom="?attr/larus_dp_3"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_dora_personal_diary_personalized_tag_cn"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/diary_style_name"
        app:layout_constraintStart_toEndOf="@+id/diary_style_icon"
        app:layout_constraintTop_toTopOf="@+id/diary_style_name"
        app:layout_goneMarginStart="0dp"/>
    <ImageView
        android:id="@+id/diary_style_selected_icon"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        android:src="@drawable/larus_ic_selected_diary_style"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/larus_primary_50"/>
    <TextView
        android:textSize="?attr/larus_sp_16"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/diary_style_name"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_24"
        android:maxLines="1"
        android:singleLine="true"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toStartOf="@+id/diary_style_selected_icon"
        app:layout_constraintStart_toEndOf="@+id/diary_style_tag"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_12"
        android:textColor="?attr/larus_neutral_50"
        android:id="@+id/diary_style_prompt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/diary_style_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
