<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="30dp">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/title_start_btn"
        android:layout_width="74dp"
        android:layout_height="24dp"
        android:layout_marginTop="0dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/title_start_effect"
            android:visibility="visible"
            android:layout_width="74dp"
            android:layout_height="24dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/ttlive_white"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_team_fight_start"
            android:includeFontPadding="false"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/title_content"
        android:background="@drawable/ttlive_team_fight_title_layout_bg_default"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="7dp"
        android:minWidth="68dp">
        <com.bytedance.android.live.liveinteract.voicechat.fight.view.FightTitleTextView
            android:textSize="12sp"
            android:textColor="@color/ttlive_white"
            android:gravity="center_vertical"
            android:id="@+id/tv_fight_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:lines="1"
            android:includeFontPadding="false"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_time"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.livesdk.chatroom.view.NoPaddingTextView
            android:textSize="14sp"
            android:textColor="@color/ttlive_white"
            android:gravity="center_vertical"
            android:id="@+id/tv_time"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:includeFontPadding="false"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_fight_title"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
