<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:id="@+id/dlg_root"
    android:background="@drawable/yz_bg_network_allow"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14dp"
        android:textColor="@color/network_allow_dialog_content"
        android:gravity="center"
        android:id="@+id/tv_spannable_str"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="23dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="23dp"
        android:text="@string/network_permission_dialog_message"
        android:maxLines="7"
        android:lineSpacingMultiplier="1.1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="6dp"
        android:layout_below="@+id/tv_spannable_str">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/network_allow_dialog_cancel"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/cancel_btn"
            android:background="@drawable/yz_bg_network_allow_btn"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/cancel_network"
            android:layout_weight="1"/>
        <View
            android:background="#d9d8d9"
            android:layout_width="1dp"
            android:layout_height="30dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/network_allow_dialog_ok"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/ok_btn"
            android:background="@drawable/yz_bg_network_allow_btn"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/allow_network"
            android:layout_weight="1"/>
    </LinearLayout>
</RelativeLayout>
