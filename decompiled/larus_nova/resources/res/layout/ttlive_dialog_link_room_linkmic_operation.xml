<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14dp"
        android:textColor="#80161823"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/hint"
        android:background="@drawable/ttlive_bg_dialog_inroom_user"
        android:paddingLeft="30dp"
        android:paddingRight="30dp"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/ttlive_interact_link_room_fight_linkmic_operation_title"
        android:lines="1"/>
    <View
        android:id="@+id/line_linkmic_operation"
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="0.5px"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/watch_profile"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_interact_link_room_fight_linkmic_operation_watch_profile"/>
    <View
        android:id="@+id/line_watch_profile"
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/set_silence_peer_room"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_interact_link_room_fight_linkmic_operation_silence_peer_room"/>
    <View
        android:background="@color/ttlive_core_hs_s9"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/cancel"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/ttlive_cancel"/>
</LinearLayout>
