<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/larus_applet_debug_version_card_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="19dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/header_container"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/app_icon"
            android:background="@drawable/larus_applet_debug_icon_placeholder_bg"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:roundedCornerRadius="7.5dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/app_text_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp">
            <TextView
                android:textSize="17sp"
                android:textStyle="normal"
                android:textColor="@color/applet_debug_version_primary_text"
                android:ellipsize="end"
                android:id="@+id/app_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/app_status_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp">
                <View
                    android:id="@+id/app_status_dot"
                    android:background="@drawable/larus_applet_debug_version_status_dot_inactive"
                    android:layout_width="6dp"
                    android:layout_height="6dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="normal"
                    android:textColor="@color/applet_debug_version_secondary_text"
                    android:ellipsize="end"
                    android:id="@+id/app_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/expand_button"
            android:padding="4dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/larus_applet_debug_version_arrow_down"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/version_container"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/load_more_versions_button"
            android:background="@drawable/larus_applet_debug_version_load_more_bg"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="12dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/applet_debug_version_load_more_text"
                android:id="@+id/load_more_versions_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/applet_debug_version_load_more_cn"/>
            <ImageView
                android:id="@+id/load_more_versions_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/larus_applet_debug_version_arrow_down_small"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
