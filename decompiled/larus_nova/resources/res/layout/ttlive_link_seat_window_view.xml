<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/surface_view_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/link_seat_recyclerview"
        app:layout_constraintEnd_toEndOf="@+id/link_seat_recyclerview"
        app:layout_constraintStart_toStartOf="@+id/link_seat_recyclerview"
        app:layout_constraintTop_toTopOf="@+id/link_seat_recyclerview"/>
    <FrameLayout
        android:id="@+id/single_input_mode_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <SurfaceView
        android:id="@+id/public_stream_view"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/link_seat_recyclerview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/link_room_guide_line"
        app:layout_constraintTop_toTopOf="@+id/link_seat_recyclerview"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/link_room_guide_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <com.bytedance.android.live.ui.ClipImageView
        android:id="@+id/theme_bg_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.ui.ClipImageView
        android:id="@+id/dynamic_clip_bg_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/theme_bg_placeholder_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/dynamic_bg_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/dynamic_layers_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/interact_render_container_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.live.ui.ClipFrameLayout
        android:id="@+id/fl_first_seat_shadow_container"
        android:background="#01000000"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@+id/link_seat_recyclerview"
        app:layout_constraintTop_toTopOf="@+id/link_seat_recyclerview"/>
    <com.bytedance.android.live.liveinteract.plantform.commonwindow.LinkMicRecyclerView
        android:id="@+id/link_seat_recyclerview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/multi_link_dynamic_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.ui.ClipFrameLayout
        android:id="@+id/fl_first_seat_shadow_float_container"
        android:background="#01000000"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@+id/link_seat_recyclerview"
        app:layout_constraintTop_toTopOf="@+id/link_seat_recyclerview"/>
    <com.bytedance.android.live.liveinteract.plantform.commonwindow.LinkMicRecyclerView
        android:id="@+id/link_seat_anim_recyclerview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/link_seat_recyclerview"
        app:layout_constraintEnd_toEndOf="@+id/link_seat_recyclerview"
        app:layout_constraintStart_toStartOf="@+id/link_seat_recyclerview"
        app:layout_constraintTop_toTopOf="@+id/link_seat_recyclerview"/>
    <FrameLayout
        android:id="@+id/fl_play_mode_view_container_align_recyclerview"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/link_seat_recyclerview"
        app:layout_constraintEnd_toEndOf="@+id/link_seat_recyclerview"
        app:layout_constraintStart_toStartOf="@+id/link_seat_recyclerview"
        app:layout_constraintTop_toTopOf="@+id/link_seat_recyclerview"/>
    <FrameLayout
        android:id="@+id/dynamic_score_bar_container"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        app:layout_constraintBottom_toTopOf="@+id/link_seat_recyclerview"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
