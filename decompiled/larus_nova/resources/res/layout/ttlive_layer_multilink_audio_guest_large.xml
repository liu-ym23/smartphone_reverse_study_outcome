<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/guide_view_left"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toStartOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintHorizontal_weight="9"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/guide_view_right"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="9"
        app:layout_constraintStart_toEndOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ttlive_guest_avatar_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="h,1:1"
        app:layout_constraintEnd_toStartOf="@+id/guide_view_right"
        app:layout_constraintHorizontal_weight="64"
        app:layout_constraintStart_toEndOf="@+id/guide_view_left"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/guide_content_view_left"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/guide_content_view_point"
            app:layout_constraintEnd_toStartOf="@+id/guide_content_view_point"
            app:layout_constraintHorizontal_weight="12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_weight="12"/>
        <View
            android:id="@+id/guide_content_view_right"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="12"
            app:layout_constraintStart_toEndOf="@+id/guide_content_view_point"
            app:layout_constraintTop_toBottomOf="@+id/guide_content_view_point"
            app:layout_constraintVertical_weight="12"/>
        <View
            android:id="@+id/guide_content_view_point"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/guide_content_view_right"
            app:layout_constraintEnd_toStartOf="@+id/guide_content_view_right"
            app:layout_constraintHorizontal_weight="56"
            app:layout_constraintStart_toEndOf="@+id/guide_content_view_left"
            app:layout_constraintTop_toBottomOf="@+id/guide_content_view_left"
            app:layout_constraintVertical_weight="56"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ttlive_guest_avatar"
            android:background="@drawable/ttlive_bg_default_anchor_avatar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/guide_content_view_point"
            app:layout_constraintEnd_toEndOf="@+id/guide_content_view_point"
            app:layout_constraintStart_toStartOf="@+id/guide_content_view_point"
            app:layout_constraintTop_toTopOf="@+id/guide_content_view_point"
            app:placeholderImage="@drawable/ttlive_img_avatar_empty"
            app:roundAsCircle="true"/>
        <com.bytedance.android.livesdk.common.AnchorPauseTipsView
            android:id="@+id/ttlive_leave_view"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/guide_content_view_point"
            app:layout_constraintEnd_toEndOf="@+id/guide_content_view_point"
            app:layout_constraintStart_toStartOf="@+id/guide_content_view_point"
            app:layout_constraintTop_toTopOf="@+id/guide_content_view_point"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ttlive_volume_Anim"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ttlive_avatar_right_top_widget"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:translationX="28dp"
            android:translationY="-28dp"
            app:layout_constraintBottom_toBottomOf="@+id/guide_content_view_point"
            app:layout_constraintEnd_toEndOf="@+id/guide_content_view_point"
            app:layout_constraintStart_toStartOf="@+id/guide_content_view_point"
            app:layout_constraintTop_toTopOf="@+id/guide_content_view_point"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ttlive_guest_name_container"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_guest_avatar_container">
        <View
            android:id="@+id/ttlive_guest_identification"
            android:background="@drawable/ttlive_ic_audio_chat_room_admin"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginRight="4dp"
            android:layout_marginEnd="4dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/ttlive_white"
            android:ellipsize="end"
            android:id="@+id/ttlive_guest_name"
            android:paddingLeft="1dp"
            android:paddingRight="1dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </LinearLayout>
    <com.bytedance.android.live.liveinteract.videotalk.quickinteract.interactView.LinkMicQuickInteractView
        android:id="@+id/ttlive_guest_fans_ticket_count"
        android:paddingLeft="7dp"
        android:paddingRight="7dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_guest_name_container"/>
    <com.bytedance.android.live.liveinteract.videotalk.quickinteract.interactView.ThemedCompetitionQuickInteractView
        android:id="@+id/ttlive_themed_competition_score"
        android:paddingLeft="7dp"
        android:paddingRight="7dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ttlive_guest_name_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
