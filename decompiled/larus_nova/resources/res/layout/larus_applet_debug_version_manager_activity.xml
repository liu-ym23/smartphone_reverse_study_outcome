<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@color/applet_app_debug_version_manager_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/nav_bar"
        android:layout_width="0dp"
        android:layout_height="44dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
            android:layout_gravity="start|center_vertical"
            android:id="@+id/back_button"
            android:background="@android:color/transparent"
            android:padding="12dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/larus_applet_debug_version_arrow_left"
            android:contentDescription="@string/applet_debug_version_back_cn"
            android:layout_marginStart="8dp"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/applet_debug_version_primary_text"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/applet_debug_version_manager_title_cn"
            android:maxLines="1"/>
        <ImageButton
            android:layout_gravity="end|center_vertical"
            android:id="@+id/refresh_button"
            android:background="@android:color/transparent"
            android:padding="12dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/larus_applet_debug_version_refresh"
            android:tint="@color/applet_debug_version_icon_tint"
            android:contentDescription="@string/applet_debug_version_refresh_cn"
            android:layout_marginEnd="8dp"/>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/app_recycler_view"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/list_load_more_progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nav_bar"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/applet_debug_version_secondary_text"
        android:id="@+id/empty_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/applet_debug_version_empty_cn"
        app:layout_constraintBottom_toTopOf="@+id/bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nav_bar"/>
    <ProgressBar
        android:id="@+id/list_load_more_progress"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="36dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/applet_debug_version_brand_blue"
        app:layout_constraintBottom_toTopOf="@+id/bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/bottom_bar"
        android:background="@color/applet_debug_version_bottom_bar_background"
        android:layout_width="0dp"
        android:layout_height="110dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:gravity="center"
            android:layout_gravity="top"
            android:id="@+id/confirm_button"
            android:background="@drawable/larus_applet_debug_version_primary_button_bg"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/applet_debug_version_confirm_modify_cn"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/loading_overlay"
        android:background="@color/applet_debug_version_loading_overlay"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ProgressBar
            android:layout_gravity="center"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/applet_debug_version_brand_blue"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
