<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vs_cache_real_container"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/vs_cache_cover"
        android:background="@drawable/ttlive_bg_vs_cache_cover"
        android:layout_width="120dp"
        android:layout_height="68dp"
        app:actualImageScaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_replay_camera_place_holder"
        app:placeholderImageScaleType="fitXY"
        app:roundedCornerRadius="4dp"/>
    <RelativeLayout
        android:id="@+id/vs_cache_state_container"
        android:layout_width="120dp"
        android:layout_height="68dp"
        app:layout_constraintBottom_toBottomOf="@+id/vs_cache_cover"
        app:layout_constraintEnd_toEndOf="@+id/vs_cache_cover"
        app:layout_constraintStart_toStartOf="@+id/vs_cache_cover"
        app:layout_constraintTop_toTopOf="@+id/vs_cache_cover">
        <ImageView
            android:id="@+id/vs_cache_state_iv"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ttlive_ic_vs_cache_loading"
            android:layout_centerInParent="true"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/vs_cache_play_state_iv"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="11dp"
            android:layout_marginLeft="8dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/ttlive_ic_vs_cache_living"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/white"
        android:id="@+id/vs_cache_text_tag"
        android:background="@drawable/ttlive_bg_vs_cache_tag"
        android:paddingLeft="4dp"
        android:paddingTop="1dp"
        android:paddingRight="4dp"
        android:paddingBottom="1dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="4dp"
        android:text="@string/ttlive_vs_cached"
        app:layout_constraintLeft_toLeftOf="@+id/vs_cache_cover"
        app:layout_constraintTop_toTopOf="@+id/vs_cache_cover"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/vs_cache_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/vs_cache_cover"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/vs_cache_op_ic"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#e6ffffff"
            android:ellipsize="end"
            android:id="@+id/vs_cache_info_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:lines="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/vs_cache_op_ic"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/vs_caching_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.bytedance.android.livesdk.chatroom.replay.cache.ui.customui.CacheProgressBar
            android:id="@+id/vs_cache_progress"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_marginTop="20dp"
            app:layout_constraintLeft_toLeftOf="@+id/vs_cache_info_title"
            app:layout_constraintRight_toRightOf="@+id/vs_cache_info_title"
            app:layout_constraintTop_toBottomOf="@+id/vs_cache_info_title"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_vs_cache_50_white"
            android:id="@+id/vs_cache_progress_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ttlive_replay_cache_speed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/vs_cache_progress"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_vs_cache_50_white"
            android:id="@+id/vs_cache_progress_ratio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintRight_toRightOf="@+id/vs_cache_progress"
            app:layout_constraintTop_toBottomOf="@+id/vs_cache_progress"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/vs_cache_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_vs_cache_50_white"
            android:id="@+id/vs_cache_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/vs_cache_info_title"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_vs_cache_50_white"
            android:id="@+id/vs_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginRight="8dp"
            app:layout_constraintRight_toLeftOf="@+id/vs_cache_op_ic"
            app:layout_constraintTop_toBottomOf="@+id/vs_cache_info_title"/>
        <ImageView
            android:id="@+id/vs_history_phone"
            android:layout_width="8dp"
            android:layout_height="11dp"
            android:layout_marginRight="2dp"
            android:src="@drawable/ttlive_ic_vs_cache_phone"
            app:layout_constraintBottom_toBottomOf="@+id/vs_history"
            app:layout_constraintRight_toLeftOf="@+id/vs_history"
            app:layout_constraintTop_toTopOf="@+id/vs_history"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
