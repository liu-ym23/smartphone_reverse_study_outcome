<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_account_container"
    android:background="@drawable/bg_account_list"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_76"
    android:layout_marginTop="?attr/larus_dp_12">
    <com.larus.bmhome.view.RoundAvatarImageView
        android:id="@+id/item_account_avatar"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_14"
        android:layout_marginBottom="?attr/larus_dp_14"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/item_account_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_10"
        app:layout_constraintBottom_toBottomOf="@+id/item_account_avatar"
        app:layout_constraintStart_toEndOf="@+id/item_account_avatar"
        app:layout_constraintTop_toTopOf="@+id/item_account_avatar"/>
    <TextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="@color/larus_neutral_50"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/item_account_sub_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="@+id/item_account_avatar"
        app:layout_constraintStart_toStartOf="@+id/item_account_title"
        app:layout_constraintTop_toBottomOf="@+id/item_account_title"/>
    <ImageView
        android:id="@+id/item_account_checkbox"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        android:layout_marginEnd="?attr/larus_dp_26"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
