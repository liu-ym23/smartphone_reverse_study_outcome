<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_bot_edit"
    android:paddingBottom="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_16"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/bio_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        android:text="@string/larus_create_bot_settings_bio"
        android:maxLines="1"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="?attr/larus_dp_16"
        android:gravity="start|top"
        android:id="@+id/bio_edit"
        android:background="@null"
        android:scrollbars="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_8"
        android:maxHeight="?attr/larus_dp_100"
        android:minHeight="?attr/larus_dp_52"
        android:hint="@string/larus_create_bot_settings_bio_placeholder"
        android:maxLength="@integer/larus_bot_first_met_edit_prologue_max_length"
        android:inputType="textMultiLine"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bio_title"
        style="@style/larus_EditTextStyle"/>
    <include
        android:id="@+id/bio_skeleton"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_0"
        app:layout_constraintBottom_toBottomOf="@+id/bio_edit"
        app:layout_constraintEnd_toEndOf="@+id/bio_edit"
        app:layout_constraintStart_toStartOf="@+id/bio_edit"
        app:layout_constraintTop_toTopOf="@+id/bio_edit"
        layout="@layout/larus_bot_create_desc_skeleton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
