<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:background="@drawable/ttlive_openplate_bg_landscape_game_more"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/ttlive_open_feature_icon_default"
        app:failureImage="@drawable/ttlive_open_feature_icon_default"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_open_feature_icon_default"
        app:roundedCornerRadius="8dp"/>
    <TextView
        android:textSize="17dp"
        android:textColor="#ffffffff"
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="18dp"
        android:text="翻拍对对碰"
        app:layout_constraintLeft_toRightOf="@+id/icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider_line"
        android:background="#1affffff"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/icon"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/btn_list"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="@+id/icon"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider_line"
        app:spanCount="4"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/exit_button"
        android:background="@drawable/ttlive_bg_more_dialog_exit_btn_landscape"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="23dp"
        android:layout_marginRight="34dp"
        android:text="@string/ttlive_open_platform_mini_game_exit_btn"
        app:layout_constraintLeft_toLeftOf="@+id/icon"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_list"/>
</androidx.constraintlayout.widget.ConstraintLayout>
