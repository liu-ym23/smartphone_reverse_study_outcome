<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/gamecp_bg_room_center_dialog"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:minWidth="280dp">
    <RelativeLayout
        android:id="@+id/top_image_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.android.gamecp.common.ui.LiveRoundImageView
            android:id="@+id/top_image"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            app:ttlive_radius_top_left="2dp"
            app:ttlive_radius_top_right="2dp"/>
        <com.bytedance.android.gamecp.common.ui.HSImageView
            android:id="@+id/top_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:scaleType="centerInside"
            android:layout_alignParentRight="true"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true"
            app:placeholderImage="@drawable/gamecp_ic_hs_room_center_dialog_close"
            app:placeholderImageScaleType="centerCrop"/>
    </RelativeLayout>
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/gamecp_room_center_title"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/room_center_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/gamecp_room_center_content"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/room_center_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="15dp"
        android:lineSpacingExtra="2dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"/>
    <View
        android:id="@+id/live_dialog_divider_1"
        android:layout_marginTop="24dp"
        style="@style/gamecp_live_dialog_divider_horizontal"/>
    <Button
        android:id="@+id/room_center_button"
        android:visibility="gone"
        style="@style/gamecp_live_dialog_button_vertical"/>
    <include
        android:id="@+id/room_center_button_layout"
        layout="@layout/gamecp_dialog_item_room_center_two_btn_layout"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/gamecp_room_center_bottom_tip"
        android:gravity="center"
        android:id="@+id/room_center_bottom_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:drawableLeft="@drawable/gamecp_ic_illegal_warning"
        android:drawablePadding="8dp"
        android:lineSpacingExtra="2dp"
        android:drawableStart="@drawable/gamecp_ic_illegal_warning"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
</LinearLayout>
