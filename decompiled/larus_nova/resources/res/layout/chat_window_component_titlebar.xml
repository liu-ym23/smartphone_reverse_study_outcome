<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/title_content_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/title_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
            <com.ss.android.lark.ui.CommonTitleBar
                android:id="@+id/title_zone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"/>
        </FrameLayout>
        <View
            android:id="@+id/titlebar_divider"
            android:background="@color/line_border_card"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toBottomOf="@+id/title_wrapper"/>
        <FrameLayout
            android:id="@+id/widget_holder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/tab_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_wrapper"/>
        <include
            android:id="@+id/tab_content"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/pin_holder"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/widget_holder"
            layout="@layout/chat_window_component_title_tab_wrapper"/>
        <FrameLayout
            android:id="@+id/pin_holder"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/pin_divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tab_content"/>
        <View
            android:id="@+id/pin_divider"
            android:background="@color/line_divider_default"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="1px"
            app:layout_constraintBottom_toTopOf="@+id/chat_banner_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pin_holder"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/chat_banner_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/chat_my_ai_tool_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pin_divider"/>
        <FrameLayout
            android:orientation="vertical"
            android:id="@+id/chat_my_ai_tool_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/chat_banner_container"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
