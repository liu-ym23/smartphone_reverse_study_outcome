<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/tt_cj_pay_ocr_id_rootview"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.android.ttcjpaysdk.ocr.view.OCRCodeView
        android:id="@+id/tt_cj_pay_ocr_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:CJPayScanBoxLayout="@layout/cj_pay_view_scan_box"/>
    <ImageView
        android:id="@+id/back_view"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:src="@drawable/cj_pay_ocr_back_icon"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/light_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:src="@drawable/cj_pay_ocr_light_icon"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/cj_pay_amount_keyboard_item_normal_bg_color_light"
        android:id="@+id/album_upload_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cj_pay_ocr_album_upload"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#467bfb"
        android:gravity="center"
        android:id="@+id/scan_tips_tv"
        android:background="@drawable/cj_pay_ocr_tips_text_bg"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="178dp"
        android:text="@string/cj_pay_ocr_scan_id_card_front"
        android:includeFontPadding="false"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/ocr_anim_iv"
        android:visibility="invisible"
        android:layout_width="327dp"
        android:layout_height="212dp"
        android:layout_marginTop="218dp"
        android:layout_centerHorizontal="true"/>
    <RelativeLayout
        android:id="@+id/identity_label_layout_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="52dp"
        android:layout_marginTop="251dp"
        android:layout_marginRight="52dp">
        <ImageView
            android:id="@+id/identity_back_label_view"
            android:visibility="gone"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:src="@drawable/cj_pay_ocr_identity_back_label"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:id="@+id/identity_front_label_view"
            android:visibility="gone"
            android:layout_width="111dp"
            android:layout_height="92dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/cj_pay_ocr_identity_front_label"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center_horizontal"
        android:id="@+id/scan_desc_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="442dp"
        android:layout_centerHorizontal="true"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">
        <ImageView
            android:id="@+id/scan_desc_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/cj_pay_icon_pop_left"
            android:layout_centerVertical="true"
            android:translationY="1dp"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/cj_pay_color_white_75"
            android:ellipsize="end"
            android:id="@+id/scan_desc_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cj_pay_ocr_scan_id_card_tips"
            android:maxLines="1"
            android:layout_marginStart="16dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/identity_icon_layout_view"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="488dp">
        <ImageView
            android:id="@+id/identity_front_view"
            android:layout_width="156dp"
            android:layout_height="96dp"
            android:src="@drawable/cj_pay_ocr_identity_front_icon"/>
        <ImageView
            android:id="@+id/identity_back_view"
            android:layout_width="156dp"
            android:layout_height="96dp"
            android:src="@drawable/cj_pay_ocr_identity_back_icon"
            android:layout_marginStart="171dp"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/new_light_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="76dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <ImageView
            android:id="@+id/new_light_image"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/cj_pay_ocr_light_icon_new"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/cj_pay_amount_keyboard_item_normal_bg_color_light"
            android:id="@+id/new_light_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/cj_pay_ocr_light_open"/>
    </LinearLayout>
    <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
        android:id="@+id/bottom_insurance_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_alignParentBottom="true"
        app:theme_type="1"/>
    <com.android.ttcjpaysdk.base.ui.widget.CJPayTextLoadingView
        android:id="@+id/ocr_loading_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
