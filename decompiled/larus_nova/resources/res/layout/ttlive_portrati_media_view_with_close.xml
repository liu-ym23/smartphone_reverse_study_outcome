<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/media_detail_mask"
        android:background="@color/ttlive_media_introduction_mask_background"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/video_controller_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="166dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/media_title_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/media_count_online_container"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/media_count_online_container"
        app:layout_constraintTop_toTopOf="@+id/media_count_online_container"/>
    <FrameLayout
        android:id="@+id/dig_accessibility_container"
        android:layout_width="12dp"
        android:layout_height="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/media_title_container"
        app:layout_constraintLeft_toRightOf="@+id/media_title_container"
        app:layout_constraintTop_toTopOf="@+id/media_title_container"/>
    <FrameLayout
        android:id="@+id/media_count_online_container"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginTop="11dp"
        app:layout_constraintRight_toLeftOf="@+id/media_close_view"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/media_close_view"
        android:padding="4dp"
        android:layout_width="36sp"
        android:layout_height="36sp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ttlive_close_in_top_container"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/media_anchor_container"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="13dp"
        app:layout_constraintLeft_toLeftOf="@+id/media_title_container"
        app:layout_constraintTop_toBottomOf="@+id/media_title_container"/>
    <FrameLayout
        android:id="@+id/media_hourrank_container"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginLeft="12dp"
        app:layout_constraintLeft_toRightOf="@+id/media_anchor_container"
        app:layout_constraintTop_toTopOf="@+id/media_anchor_container"/>
    <FrameLayout
        android:id="@+id/media_more_live_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/media_anchor_container"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/media_anchor_container"/>
    <FrameLayout
        android:id="@+id/media_hotspot_container"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        app:layout_constraintLeft_toRightOf="@+id/media_anchor_container"
        app:layout_constraintTop_toTopOf="@+id/media_anchor_container"/>
    <FrameLayout
        android:id="@+id/media_introduction_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/media_anchor_container"/>
</merge>
