<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ttlive_broadcast_toolbar_audio_interact"
    android:background="@color/transparent"
    android:visibility="gone"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="40dp"
    android:layout_marginLeft="8dp"
    android:layout_marginStart="8dp">
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/opened"
        android:background="@drawable/ttlive_ic_live_interaction_broadcast_opened"
        android:visibility="visible"
        android:layout_width="36dp"
        android:layout_height="36dp"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/waiting"
        android:background="@drawable/ttlive_ic_live_interaction_broadcast_applied"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"/>
    <TextView
        android:textSize="9dp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_gravity="top|right"
        android:id="@+id/number_dot"
        android:background="@drawable/ttlive_number_dot_bg"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginLeft="30dp"
        android:layout_marginBottom="26dp"/>
</FrameLayout>
