<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/larus_complex_task_container"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_34">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/larus_complex_task_pill"
            android:background="@drawable/larus_bg_complex_task_color_capsule"
            android:paddingTop="?attr/larus_dp_4"
            android:paddingBottom="?attr/larus_dp_4"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_34"
            android:paddingStart="?attr/larus_dp_8"
            android:paddingEnd="?attr/larus_dp_8"
            android:layout_marginEnd="?attr/larus_dp_6">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/larus_complex_task_pill_icon"
                android:layout_width="?attr/larus_dp_16"
                android:layout_height="?attr/larus_dp_16"
                android:layout_marginEnd="?attr/larus_dp_4"
                app:roundAsCircle="true"/>
            <TextView
                android:textSize="?attr/larus_dp_17"
                android:textColor="?attr/larus_neutral_50"
                android:ellipsize="end"
                android:id="@+id/larus_complex_task_pill_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="?attr/larus_dp_124"
                android:singleLine="true"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <com.larus.bmhome.chat.layout.widget.ShimmerTextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="?attr/larus_neutral_70"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/larus_complex_task_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_weight="1"/>
        <View
            android:id="@+id/larus_complex_task_arrow"
            android:background="@drawable/larus_ic_tool_header_arrow_right"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_14"
            android:layout_height="?attr/larus_dp_14"
            android:layout_marginStart="?attr/larus_dp_2"/>
    </LinearLayout>
</merge>
