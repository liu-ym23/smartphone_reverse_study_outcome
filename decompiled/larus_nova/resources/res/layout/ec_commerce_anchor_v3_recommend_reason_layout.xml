<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ec_commerce_anchor_v3_recommend_reason_layout_99599698"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/ec_commerce_anchor_v3_recommend_reason_layout_1207825828"
        android:background="@drawable/ec_anchor_v3_icon_recommend_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"/>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/anchor_v3_recommend"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/anchor_v3_ll_recommend_reason_container"
            android:paddingLeft="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/commerce_anchor_v3_recommend_reason_layout_padding"
            android:layout_marginTop="8dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="8dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/commerce_anchor_v3_recommend_reason_layout_padding">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/anchor_v3_sv_recommend_reason_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1.5dp"
                android:layout_marginRight="@dimen/commerce_anchor_v3_recommend_reason_margin"
                android:scaleType="centerCrop"
                android:layout_marginEnd="@dimen/commerce_anchor_v3_recommend_reason_margin"
                app:roundAsCircle="true"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/commerce_color_57161823"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/anchor_v3_sv_recommend_content"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:layout_gravity="center_vertical"
                android:id="@+id/anchor_v3_sv_rank_recommend_reason_icon"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/commerce_anchor_v3_recommend_reason_icon_margin"
                android:scaleType="centerCrop"
                android:layout_marginStart="@dimen/commerce_anchor_v3_recommend_reason_icon_margin"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/anchor_v3_rank_arrow_normal_style"
            android:visibility="gone"
            android:layout_width="9dp"
            android:layout_height="14dp"
            android:layout_marginLeft="1dp"
            android:layout_marginTop="9dp"
            android:layout_marginRight="9dp"
            android:src="@drawable/ic_arrow_down"
            android:layout_alignParentRight="true"
            android:rotation="-90"/>
        <ImageView
            android:id="@+id/anchor_v3_sv_recommend_more_btn"
            android:paddingLeft="4dp"
            android:paddingTop="10dp"
            android:paddingRight="8dp"
            android:paddingBottom="10dp"
            android:visibility="visible"
            android:layout_width="@dimen/commerce_anchor_v3_recommend_more_btn_size"
            android:layout_height="23dp"
            android:src="@drawable/ec_commerce_guess_u_like_more_btn"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/shopping_more"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/anchor_v3_rank"
        android:paddingLeft="1dp"
        android:paddingRight="1dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/commerce_anchor_v3_recommend_reason_layout_padding"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="@dimen/commerce_anchor_v3_recommend_reason_layout_padding"
        android:layout_marginEnd="8dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/anchor_v3_rank_arrow">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/anchor_v3_rank_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1.5dp"
                android:layout_marginRight="@dimen/commerce_anchor_v3_recommend_reason_margin"
                android:scaleType="centerCrop"
                android:layout_marginEnd="@dimen/commerce_anchor_v3_recommend_reason_margin"
                app:roundAsCircle="true"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="11sp"
                android:textColor="@color/commerce_color_FE2C55"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/anchor_v3_rank_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="0dp"
                android:layout_marginTop="1dp"
                android:layout_marginBottom="1dp"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"
                app:autoSizeMaxTextSize="11sp"
                app:autoSizeMinTextSize="9sp"
                app:autoSizeTextType="uniform"/>
            <TextView
                android:textColor="@color/commerce_color_FE2C55"
                android:id="@+id/anchor_v3_rank_No"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="1dp"
                android:layout_marginTop="1dp"
                android:layout_marginBottom="1dp"
                style="@style/font_size_22"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/anchor_v3_rank_arrow"
            android:layout_width="9dp"
            android:layout_height="20dp"
            android:layout_marginLeft="1dp"
            android:src="@drawable/ic_arrow_down"
            android:layout_alignParentRight="true"
            android:rotation="-90"/>
    </RelativeLayout>
</RelativeLayout>
