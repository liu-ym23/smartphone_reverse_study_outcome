<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/landscape_media_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/video_controller_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/media_title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="17dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/media_anchor_container"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginTop="8dp"
        app:layout_constraintLeft_toLeftOf="@+id/media_title_container"
        app:layout_constraintTop_toBottomOf="@+id/media_title_container"/>
    <FrameLayout
        android:id="@+id/media_count_online_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintLeft_toLeftOf="@+id/media_anchor_container"
        app:layout_constraintTop_toBottomOf="@+id/media_anchor_container"/>
    <FrameLayout
        android:id="@+id/media_more_live_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="2dp"
        app:layout_constraintLeft_toRightOf="@+id/media_count_online_container"
        app:layout_constraintTop_toBottomOf="@+id/media_anchor_container"
        app:layout_goneMarginLeft="12dp"/>
</merge>
