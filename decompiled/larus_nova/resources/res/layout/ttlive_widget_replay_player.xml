<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/simple_media_view_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/ttlive_vs_video_player_top_margin"
        app:layout_constraintDimensionRatio="H,16:9"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/video_cover"
        android:background="@color/ttlive_black"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/simple_media_view_container"
        app:layout_constraintDimensionRatio="H,16:9"
        app:layout_constraintLeft_toLeftOf="@+id/simple_media_view_container"
        app:layout_constraintRight_toRightOf="@+id/simple_media_view_container"
        app:layout_constraintTop_toTopOf="@+id/simple_media_view_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
