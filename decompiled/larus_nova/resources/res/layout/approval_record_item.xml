<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@color/bg_float"
    android:paddingRight="@dimen/dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larksuite.component.universe_design.image.UDAvatar
        android:id="@+id/record_item_avatar"
        android:layout_width="@dimen/space_kit_len_36"
        android:layout_height="@dimen/space_kit_len_36"
        android:layout_marginLeft="@dimen/space_kit_len_16"
        android:layout_marginTop="@dimen/space_kit_len_10"
        android:layout_marginBottom="@dimen/space_kit_len_10"
        android:src="@drawable/facade_common_avatar_place_holder"
        android:layout_marginStart="@dimen/space_kit_len_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ud_avatar_borderWidth="0dp"
        app:ud_avatar_size="large"
        style="@style/UDAvatar.Circle"/>
    <TextView
        android:textSize="@dimen/space_kit_len_16"
        android:textColor="@color/text_title"
        android:ellipsize="end"
        android:id="@+id/record_item_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_12"
        android:maxWidth="@dimen/space_kit_len_120"
        android:lines="1"
        android:layout_marginStart="@dimen/dp_12"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/record_item_avatar"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/text_caption"
        android:ellipsize="end"
        android:id="@+id/record_item_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_8"
        android:lines="1"
        android:layout_marginStart="@dimen/dp_8"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/record_item_name"
        app:layout_constraintRight_toLeftOf="@+id/record_item_check_process"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/primary_fill_default"
        android:gravity="right"
        android:id="@+id/record_item_check_process"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/LarkCCM_Workspace_SecLeviI_AdjustRequest_ByWhen_Check_Button"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
