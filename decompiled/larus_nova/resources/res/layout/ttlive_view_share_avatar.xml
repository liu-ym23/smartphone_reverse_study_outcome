<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_33000000_round"
    android:layout_width="38dp"
    android:layout_height="38dp">
    <com.bytedance.android.livesdk.widget.VSShareReverseView
        android:id="@+id/live_share_rci_share_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginTop="6dp"
        android:layout_centerHorizontal="true"
        app:roundAsCircle="true"/>
    <RelativeLayout
        android:padding="2dp"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="18dp">
        <com.bytedance.android.livesdk.widget.CircleImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ttlive_icon_share_toolbar_tag"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</RelativeLayout>
