<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root_view"
        android:background="@color/white"
        android:paddingLeft="1dp"
        android:paddingRight="1dp"
        android:layout_width="112dp"
        android:layout_height="wrap_content">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/ttlive_card_cover"
            android:background="@color/white"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginTop="1dp"
            app:actualImageScaleType="centerCrop"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundedCornerRadius="4dp"
            app:roundingBorderColor="#0d161823"
            app:roundingBorderWidth="1dp"/>
        <FrameLayout
            android:id="@+id/shadow_top"
            android:background="@drawable/ttlive_bg_gray_layer"
            android:layout_width="0dp"
            android:layout_height="20dp"
            app:layout_constraintLeft_toLeftOf="@+id/ttlive_card_cover"
            app:layout_constraintRight_toRightOf="@+id/ttlive_card_cover"
            app:layout_constraintTop_toTopOf="@+id/ttlive_card_cover"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/top_icon"
            android:layout_width="46dp"
            android:layout_height="14dp"
            android:layout_marginTop="3dp"
            android:src="@drawable/ttlive_ic_explain_card_mini_app"
            android:layout_marginStart="3dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="2dp"
            android:src="@drawable/ttlive_ic_miniapp_close"
            android:layout_marginEnd="2dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/ttlive_miniapp_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="98dp"
            android:layout_marginStart="4dp"
            app:actualImageScaleType="centerCrop"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ttlive_card_cover"
            app:roundedCornerRadius="4dp"
            app:roundingBorderColor="#eceded"
            app:roundingBorderWidth="0.5dp"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_douyin_light_TextPrimary"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/ttlive_miniapp_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="4dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@+id/ttlive_miniapp_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/ttlive_miniapp_icon"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/info_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="4dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toTopOf="@+id/ttlive_card_btn"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ttlive_miniapp_icon">
            <TextView
                android:textSize="10sp"
                android:textColor="@color/ttlive_douyin_light_TextPrimary"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:includeFontPadding="false"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/supplement_info_layout"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginTop="2dp">
                <com.bytedance.android.live.openplatform.impl.miniappcommon.explaincard.CardAvatarsLayout
                    android:id="@+id/avatar_layout"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="2dp"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="#fe2c55"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/supplement_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </LinearLayout>
        <com.bytedance.android.live.openplatform.impl.miniappcommon.explaincard.NormalCardBtn
            android:gravity="center"
            android:id="@+id/ttlive_card_btn"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_marginBottom="4dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
