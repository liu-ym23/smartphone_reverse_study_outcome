<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="16dp"
    android:paddingBottom="55dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="103dp">
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/loading_view"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:indeterminateTint="@color/larus_primary_50"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/error_lay"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/live_tutor_ic_refresh"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#999999"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_chat_list_load_failed"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="#7a1a2429"
        android:layout_gravity="center"
        android:id="@+id/end_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_tutor_no_more_content_cn"/>
</FrameLayout>
