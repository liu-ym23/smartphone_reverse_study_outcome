<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="#ffffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/store_v2_iv_image"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="160dp"
        android:src="@drawable/ec_shop_net_error_icon_v2"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/shopping_std_bg_primary_1"
        android:layout_gravity="center_horizontal"
        android:id="@+id/store_v2_tv_hint_head"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="网络异常"/>
    <TextView
        android:textColor="#5c5d65"
        android:layout_gravity="center_horizontal"
        android:id="@+id/store_v2_tv_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="请刷新页面"
        style="@style/font_size_28"/>
    <com.bytedance.android.ui.base.widget.round.RoundFrameLayout
        android:id="@+id/store_v2_tv_refresh_button"
        android:layout_width="165dp"
        android:layout_height="44dp"
        android:layout_marginTop="40dp"
        app:bg_color="#0d000000"
        app:bg_cornerRadius="44dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:layout_gravity="center"
            android:id="@+id/store_v2_tv_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shopping_refresh"/>
    </com.bytedance.android.ui.base.widget.round.RoundFrameLayout>
</LinearLayout>
