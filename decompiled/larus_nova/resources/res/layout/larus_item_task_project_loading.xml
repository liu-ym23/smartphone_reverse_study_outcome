<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_bg_task_skill_item_middle"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_56">
    <View
        android:id="@+id/project_loading_icon"
        android:background="@drawable/larus_bg_gray_round"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:layout_marginStart="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.bmhome.chat.layout.widget.ShimmerLoadingVIew
        android:id="@+id/project_loading_title"
        android:layout_width="?attr/larus_dp_100"
        android:layout_height="?attr/larus_dp_22"
        android:layout_marginStart="?attr/larus_dp_12"
        app:larus_shimmerColor="@color/larus_folder_loading_shimmer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/project_loading_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="?attr/larus_neutral_transparent_2"
        android:layout_width="0dp"
        android:layout_height="?attr/larus_dp_0_5"
        android:layout_marginStart="?attr/larus_dp_48"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
