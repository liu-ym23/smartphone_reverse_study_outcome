<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/combo_count_container"
        android:background="@drawable/ttlive_gift_combo_count_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="21dp"
        android:layout_marginBottom="45dp"
        android:adjustViewBounds="true"
        android:minWidth="33dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:id="@+id/combo_count"
            android:layout_width="wrap_content"
            android:layout_height="15dp"
            android:text="12"
            android:textAlignment="center"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center"
        android:id="@+id/special_combo_iv"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginBottom="45dp"
        android:adjustViewBounds="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
