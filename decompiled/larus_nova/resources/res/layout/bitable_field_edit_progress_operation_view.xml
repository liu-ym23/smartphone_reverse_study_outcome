<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/space_kit_font_14"
        android:textColor="@color/text_placeholder"
        android:id="@+id/format_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_kit_len_2"
        android:text="@string/Bitable_Progress_NumberFormat_Title"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/formatSelectLayout"
        android:background="@drawable/facade_round_around_xl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_2"
        android:layout_marginBottom="@dimen/space_kit_len_16"
        android:minHeight="@dimen/space_kit_len_52"
        android:paddingStart="@dimen/space_kit_len_16"
        android:paddingEnd="@dimen/space_kit_len_16"
        android:backgroundTint="@color/facade_selector_item_float">
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_title"
            android:id="@+id/formatTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_kit_len_12"
            android:layout_marginBottom="@dimen/space_kit_len_12"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_kit_len_16"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/format_select_iv"
            android:layout_width="@dimen/space_kit_len_16"
            android:layout_height="@dimen/space_kit_len_16"
            android:tint="@color/icon_disable"
            app:srcCompat="@drawable/ud_icon_right_outlined"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/space_kit_font_14"
        android:textColor="@color/text_placeholder"
        android:id="@+id/decimal_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_kit_len_2"
        android:text="@string/Bitable_Progress_DecimalPlaces_Title"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/decimalSelectLayout"
        android:background="@drawable/facade_round_around_xl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_2"
        android:layout_marginBottom="@dimen/space_kit_len_16"
        android:minHeight="@dimen/space_kit_len_52"
        android:paddingStart="@dimen/space_kit_len_16"
        android:paddingEnd="@dimen/space_kit_len_16"
        android:backgroundTint="@color/facade_selector_item_float">
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_title"
            android:id="@+id/decimalTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_kit_len_12"
            android:layout_marginBottom="@dimen/space_kit_len_12"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_kit_len_16"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/decimal_format_iv"
            android:layout_width="@dimen/space_kit_len_16"
            android:layout_height="@dimen/space_kit_len_16"
            android:tint="@color/icon_disable"
            app:srcCompat="@drawable/ud_icon_right_outlined"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/space_kit_font_14"
        android:textColor="@color/text_placeholder"
        android:id="@+id/color_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_kit_len_2"
        android:text="@string/Bitable_Progress_ProgressBarColor_Title"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/colorSelectLayout"
        android:background="@drawable/facade_round_around_xl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_2"
        android:layout_marginBottom="@dimen/space_kit_len_16"
        android:minHeight="@dimen/space_kit_len_52"
        android:paddingStart="@dimen/space_kit_len_16"
        android:paddingEnd="@dimen/space_kit_len_16"
        android:backgroundTint="@color/facade_selector_item_float">
        <View
            android:layout_gravity="center"
            android:id="@+id/gradientColorPreview"
            android:visibility="gone"
            android:layout_width="@dimen/space_kit_len_22"
            android:layout_height="@dimen/space_kit_len_22"/>
        <com.bytedance.ee.bear.bitable.fieldedit.view.widgets.GradientOffsetView
            android:layout_gravity="center"
            android:id="@+id/defaultColorPreview"
            android:visibility="gone"
            android:layout_width="@dimen/space_kit_len_22"
            android:layout_height="@dimen/space_kit_len_22"/>
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_title"
            android:id="@+id/colorTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_kit_len_12"
            android:layout_marginBottom="@dimen/space_kit_len_12"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_kit_len_8"
            android:layout_marginEnd="@dimen/space_kit_len_16"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/color_format_iv"
            android:layout_width="@dimen/space_kit_len_16"
            android:layout_height="@dimen/space_kit_len_16"
            android:tint="@color/icon_disable"
            app:srcCompat="@drawable/ud_icon_right_outlined"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/define_range_layout"
        android:background="@drawable/facade_round_around_xl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_2"
        android:layout_marginBottom="@dimen/space_kit_len_12"
        android:minHeight="@dimen/space_kit_len_52"
        android:paddingStart="@dimen/space_kit_len_16"
        android:paddingEnd="@dimen/space_kit_len_16"
        android:backgroundTint="@color/bg_float">
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_title"
            android:id="@+id/define_range_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/Bitable_Progress_CustomProgressBar"
            android:layout_weight="1"/>
        <com.larksuite.component.universe_design.udswitch.UDSwitch
            android:id="@+id/customizedRangeChecker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:layout_marginStart="@dimen/space_kit_len_16"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/rangeContainer"
        android:background="@drawable/facade_round_around_xl"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/space_kit_len_52"
        android:paddingStart="@dimen/space_kit_len_16"
        android:paddingEnd="@dimen/space_kit_len_16"
        android:backgroundTint="@color/bg_float">
        <RelativeLayout
            android:id="@+id/rangeStartContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/space_kit_len_52">
            <TextView
                android:textSize="@dimen/space_kit_font_16"
                android:textColor="@color/text_title"
                android:id="@+id/rangeStartTip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Bitable_Progress_Minimum"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <com.bytedance.ee.bear.bitable.fieldedit.view.widgets.EllipsizeEditText
                android:textSize="@dimen/space_kit_font_16"
                android:textColor="@color/text_title"
                android:gravity="end|center_vertical"
                android:id="@+id/rangeStartEdt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/space_kit_len_20"
                android:layout_toEndOf="@+id/rangeStartTip"
                android:layout_alignParentEnd="true"
                style="@style/UDEditText.Normal"/>
        </RelativeLayout>
        <View
            android:background="@color/line_divider_default"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_kit_len_divider"/>
        <RelativeLayout
            android:gravity="center_vertical"
            android:id="@+id/rangeEndContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/space_kit_len_52">
            <TextView
                android:textSize="@dimen/space_kit_font_16"
                android:textColor="@color/text_title"
                android:id="@+id/rangeEndTip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Bitable_Progress_Maximum"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>
            <com.bytedance.ee.bear.bitable.fieldedit.view.widgets.EllipsizeEditText
                android:textSize="@dimen/space_kit_font_16"
                android:textColor="@color/text_title"
                android:gravity="end|center_vertical"
                android:id="@+id/rangeEndEdt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/space_kit_len_20"
                android:layout_toEndOf="@+id/rangeEndTip"
                android:layout_alignParentEnd="true"
                style="@style/UDEditText.Normal"/>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_kit_len_36">
        <TextView
            android:textSize="@dimen/space_kit_font_12"
            android:textColor="@color/function_danger_fill_default"
            android:id="@+id/rangeErrorTip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_kit_len_4"
            android:text="@string/Bitable_Progress_TagetValueShouldGreaterThanStartValue"/>
    </LinearLayout>
</LinearLayout>
