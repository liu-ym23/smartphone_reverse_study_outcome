<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/ttlive_core_hs_s9"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textColor="#80161823"
        android:gravity="center"
        android:id="@+id/title"
        android:background="@color/ttlive_white"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/ttlive_ktv_avatar_recognition_mode_title"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/item_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0.5dp">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/recognition_photo_container"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0.5dp">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/ttlive_core_hs_d1"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_recognition_photo"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:text="@string/ttlive_ktv_avatar_recognition_photo"/>
            <ImageView
                android:id="@+id/recognition_rule_for_photo"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:layout_marginLeft="4dp"
                android:src="@drawable/ttlive_icon_digit_avatar_rule_icon"
                android:tint="@color/ttlive_core_hs_d1"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/recognition_camera_container"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0.5dp">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/ttlive_core_hs_d1"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_recognition_camera"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:text="@string/ttlive_ktv_avatar_recognition_camera"/>
            <ImageView
                android:id="@+id/recognition_rule_for_camera"
                android:padding="0dp"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:layout_marginLeft="4dp"
                android:src="@drawable/ttlive_icon_digit_avatar_rule_icon"
                android:tint="@color/ttlive_core_hs_d1"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/recognition_default_container"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0.5dp">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/ttlive_core_hs_d1"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_recognition_default"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:text="@string/ttlive_ktv_avatar_recognition_default"/>
            <ImageView
                android:id="@+id/stub_image"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:layout_marginLeft="4dp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/ttlive_core_hs_d1"
        android:gravity="center"
        android:id="@+id/cancel"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="@string/ttlive_cancel"/>
</LinearLayout>
