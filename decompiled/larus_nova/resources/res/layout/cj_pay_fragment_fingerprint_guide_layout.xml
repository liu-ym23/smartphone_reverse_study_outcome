<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/cj_pay_fragment_fingerprint_guide_root_view"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cj_pay_height_470">
    <include
        android:id="@+id/cj_pay_titlebar_root_view"
        layout="@layout/cj_pay_view_titlebar_icon_layout"/>
    <com.android.ttcjpaysdk.base.theme.widget.CJPayFingerPrintIconView
        android:layout_gravity="center"
        android:id="@+id/finger_print_icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/cj_pay_color_black_34"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_guide_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_24"
        android:layout_marginTop="@dimen/cj_pay_padding_16"
        android:layout_marginRight="@dimen/cj_pay_padding_24"
        android:text="@string/cj_pay_fingerprint_open_guide_desc"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/cj_pay_guide_security_tip_layout"
        android:paddingTop="@dimen/cj_pay_padding_6_with_half"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <include
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/cj_pay_guide_btn_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_44"
        android:layout_marginLeft="@dimen/cj_pay_padding_16"
        android:layout_marginRight="@dimen/cj_pay_padding_16"
        android:layout_marginBottom="@dimen/cj_pay_padding_16"
        layout="@layout/cj_pay_common_loading_btn"/>
    <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/cj_pay_padding_16"
        app:theme_type="0"/>
</LinearLayout>
