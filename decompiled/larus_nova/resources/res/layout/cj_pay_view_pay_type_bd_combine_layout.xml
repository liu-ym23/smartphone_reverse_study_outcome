<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/cj_pay_view_pay_type_bd_combine_layout"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginTop="20dp"
    android:layout_marginRight="16dp">
    <RelativeLayout
        android:id="@+id/pay_type_area_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/pay_type_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14dp"
                android:textColor="?attr/cj_pay_text_tertiary"
                android:gravity="center"
                android:id="@+id/tv_pay_type"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cj_pay_pwd_pay_method"
                android:includeFontPadding="false"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/pay_type_click_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_pay_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginRight="4dp"
                    android:scaleType="centerCrop"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="?attr/cj_pay_text_tertiary"
                    android:gravity="center"
                    android:id="@+id/tv_sub_pay_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_arrow"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="?attr/cj_pay_right_arrow"
                    android:scaleType="centerCrop"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="?attr/cj_pay_text_tertiary"
            android:layout_gravity="center"
            android:id="@+id/tv_payment_info"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginRight="16dp"
            android:includeFontPadding="false"
            android:layout_below="@+id/pay_type_layout"
            android:layout_alignParentRight="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/combine_pay_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_below="@+id/pay_type_layout">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/balance_item_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="13dp"
                    android:textColor="?attr/cj_pay_text_tertiary"
                    android:gravity="center"
                    android:id="@+id/combine_balance_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="?attr/cj_pay_text_tertiary"
                    android:gravity="center"
                    android:id="@+id/combine_payment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cj_pay_pay_with_space"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="?attr/cj_pay_text_secondary"
                    android:gravity="center"
                    android:id="@+id/combine_balance_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/bankcard_item_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_below="@+id/balance_item_layout">
                <TextView
                    android:textSize="13dp"
                    android:textColor="?attr/cj_pay_text_tertiary"
                    android:gravity="center"
                    android:id="@+id/combine_card_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/combine_change_arrow"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="?attr/cj_pay_right_arrow"
                    android:scaleType="centerCrop"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="?attr/cj_pay_text_tertiary"
                    android:gravity="center"
                    android:id="@+id/combine_card_payment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cj_pay_pay_with_space"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="?attr/cj_pay_text_secondary"
                    android:gravity="center"
                    android:id="@+id/combine_card_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
