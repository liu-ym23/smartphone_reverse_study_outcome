<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="#35000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.livesdk.ktvimpl.ktvroom.view.DragLinearLayout
        android:orientation="vertical"
        android:id="@+id/interact_element_container"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="150dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/user_info_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.bytedance.android.livesdk.ktvimpl.ktvroom.view.midi.KtvOpusMicLabelAnim
                android:id="@+id/ktv_midi_label_anim"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="30dp"/>
        </FrameLayout>
    </com.bytedance.android.livesdk.ktvimpl.ktvroom.view.DragLinearLayout>
    <FrameLayout
        android:id="@+id/ktv_mv_mask_background"
        android:background="#81000000"
        android:paddingTop="137dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ViewStub
        android:id="@+id/ktv_song_end_feed_back_view"
        android:visibility="gone"
        android:layout="@layout/ttlive_ktv_sing_end_feedback_layout"
        android:layout_width="260dp"
        android:layout_height="141dp"
        android:layout_marginTop="20dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/interact_element_container"
        app:layout_goneMarginTop="200dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
