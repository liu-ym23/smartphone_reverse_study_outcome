<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ttlive_std_text_black_3"
        android:id="@+id/input_view_vertical_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/input_view_vertical_title_ic"
        android:visibility="gone"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginLeft="4dp"
        android:src="@drawable/uicomponent_ic_union"
        app:layout_constraintBottom_toBottomOf="@+id/input_view_vertical_title"
        app:layout_constraintLeft_toRightOf="@+id/input_view_vertical_title"
        app:layout_constraintTop_toTopOf="@+id/input_view_vertical_title"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ttlive_std_text_black_3"
        android:id="@+id/input_view_horizon_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/input_view_container"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_view_vertical_title"/>
    <ImageView
        android:id="@+id/input_view_horizon_title_ic"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="15dp"
        android:layout_height="7dp"
        android:layout_marginLeft="4dp"
        android:src="@drawable/uicomponent_ic_union"
        app:layout_constraintBottom_toBottomOf="@+id/input_view_horizon_title"
        app:layout_constraintLeft_toRightOf="@+id/input_view_horizon_title"
        app:layout_constraintTop_toTopOf="@+id/input_view_horizon_title"/>
    <RelativeLayout
        android:id="@+id/input_view_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@+id/input_view_horizon_title_ic"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_view_vertical_title">
        <FrameLayout
            android:id="@+id/input_view_prefix_cus_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"/>
        <FrameLayout
            android:id="@+id/input_view_post_cus_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/input_view_clear_iv"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/uicomponent_ic_clear"
            android:layout_toLeftOf="@+id/input_view_post_cus_view"
            android:layout_centerVertical="true"/>
        <EditText
            android:id="@+id/input_view_et"
            android:background="@null"
            android:layout_toLeftOf="@+id/input_view_clear_iv"
            android:layout_toRightOf="@+id/input_view_prefix_cus_view"
            style="@style/uicomponent_input_view_single_et"/>
    </RelativeLayout>
    <View
        android:id="@+id/input_view_line"
        android:background="@color/ttlive_std_line_black_3"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="6dp"
        app:layout_constraintLeft_toRightOf="@+id/input_view_horizon_title_ic"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_view_container"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ttlive_std_error"
        android:id="@+id/input_view_hint_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:layout_constraintLeft_toRightOf="@+id/input_view_horizon_title_ic"
        app:layout_constraintTop_toBottomOf="@+id/input_view_container"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_std_text_black_4"
        android:id="@+id/input_view_max_number"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="14/50"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_view_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
