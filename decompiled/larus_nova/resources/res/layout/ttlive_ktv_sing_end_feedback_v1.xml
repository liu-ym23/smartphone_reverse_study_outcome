<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_ktv_preview_songs_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/singer_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="15dp"
        android:layout_marginStart="14dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_ic_default_head_small"
        app:roundAsCircle="true"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#e6ffffff"
        android:ellipsize="end"
        android:id="@+id/singer_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="4dp"
        android:maxWidth="105dp"
        android:maxLines="1"
        android:layout_marginStart="4dp"
        app:layout_constraintLeft_toRightOf="@+id/singer_avatar"
        app:layout_constraintTop_toTopOf="@+id/singer_avatar"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#99ffffff"
        android:ellipsize="end"
        android:id="@+id/singer_sing_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:maxWidth="105dp"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/singer_avatar"
        app:layout_constraintLeft_toLeftOf="@+id/singer_nickname"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#ffffff"
        android:id="@+id/singer_follow_button"
        android:background="@drawable/ttlive_bg_ktv_sing_feedback_follow"
        android:paddingLeft="11dp"
        android:paddingTop="4dp"
        android:paddingRight="11dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="2dp"
        android:text="@string/ttlive_ktv_room_feedback_follow"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/singer_sing_name"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textSize="9dp"
        android:textColor="#99ffffff"
        android:gravity="center"
        android:id="@+id/sing_contribution_jump_link"
        android:background="@drawable/ttlive_bg_ktv_sing_feedback_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:drawableEnd="@drawable/ttlive_ktv_sing_feedback_arrow_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/singer_avatar"/>
    <TextView
        android:textSize="9dp"
        android:textColor="#99ffffff"
        android:gravity="center"
        android:id="@+id/sing_rank_jump_link"
        android:background="@drawable/ttlive_bg_ktv_sing_feedback_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="25dp"
        android:layout_marginBottom="28dp"
        android:text="@string/ttlive_ktv_room_feedback_daily_rank_text"
        android:drawableEnd="@drawable/ttlive_ktv_sing_feedback_arrow_icon"
        android:layout_marginEnd="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <com.bytedance.android.livesdk.widget.GradientTextView
        android:textSize="18dp"
        android:textStyle="italic|bold"
        android:textColor="#ff7b43"
        android:id="@+id/sing_hot_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:drawablePadding="5dp"
        android:drawableStart="@drawable/ttlive_ktv_sing_feedback_hot_icon"
        app:layout_constraintBottom_toTopOf="@+id/sing_contribution_jump_link"
        app:layout_constraintLeft_toLeftOf="@+id/sing_contribution_jump_link"/>
    <com.bytedance.android.livesdk.widget.GradientTextView
        android:textSize="18dp"
        android:textStyle="italic|bold"
        android:textColor="#ff7b43"
        android:id="@+id/singer_rank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:drawablePadding="2dp"
        android:drawableStart="@drawable/ttlive_ktv_sing_feedback_rank_icon"
        app:layout_constraintBottom_toTopOf="@+id/sing_rank_jump_link"
        app:layout_constraintLeft_toLeftOf="@+id/sing_rank_jump_link"/>
</androidx.constraintlayout.widget.ConstraintLayout>
