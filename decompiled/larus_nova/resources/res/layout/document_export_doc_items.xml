<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:id="@+id/document_doc_itme_layout"
    android:layout_width="match_parent"
    android:layout_height="168dp"
    android:paddingStart="28dp"
    android:paddingEnd="28dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/export_item_word"
        android:layout_width="0dp"
        android:layout_height="@dimen/space_kit_len_88"
        android:layout_weight="1">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/export_item_word_icon"
            android:layout_width="@dimen/space_kit_len_48"
            android:layout_height="@dimen/space_kit_len_48"
            android:layout_marginTop="@dimen/dp_4"
            app:srcCompat="@drawable/ud_icon_file_doc_colorful"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:text="@string/Doc_Document_ExportWord"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/export_item_pdf"
        android:layout_width="0dp"
        android:layout_height="@dimen/space_kit_len_88"
        android:layout_weight="1">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/export_item_pdf_icon"
            android:layout_width="@dimen/space_kit_len_48"
            android:layout_height="@dimen/space_kit_len_48"
            android:layout_marginTop="@dimen/dp_4"
            app:srcCompat="@drawable/ud_icon_file_pdf_colorful"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:text="@string/Doc_Document_ExportPDF"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/export_item_image"
        android:layout_width="0dp"
        android:layout_height="@dimen/space_kit_len_88"
        android:layout_weight="1">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/export_item_image_icon"
            android:layout_width="@dimen/space_kit_len_48"
            android:layout_height="@dimen/space_kit_len_48"
            android:layout_marginTop="@dimen/dp_4"
            app:srcCompat="@drawable/ud_icon_file_image_colorful"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:text="@string/Doc_Document_ExportImage"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/export_item_markdown"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/space_kit_len_88"
        android:layout_weight="1">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/export_item_markdown_icon"
            android:layout_width="@dimen/space_kit_len_48"
            android:layout_height="@dimen/space_kit_len_48"
            android:layout_marginTop="@dimen/dp_4"
            app:srcCompat="@drawable/ud_icon_file_md_colorful"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:text="Markdown"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/export_item_txt"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/space_kit_len_88"
        android:layout_weight="1">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/export_item_txt_icon"
            android:layout_width="@dimen/space_kit_len_48"
            android:layout_height="@dimen/space_kit_len_48"
            android:layout_marginTop="@dimen/dp_4"
            app:srcCompat="@drawable/ud_icon_file_text_colorful"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:text="TXT"/>
    </LinearLayout>
</LinearLayout>
