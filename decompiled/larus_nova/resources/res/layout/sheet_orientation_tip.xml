<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/orientation_tip"
    android:background="@drawable/orientation_switcher_bg"
    android:visibility="gone"
    android:layout_width="@dimen/orientation_tip_size"
    android:layout_height="@dimen/orientation_tip_size"
    android:elevation="8dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/ud_icon_landscape_mode_colorful"/>
</FrameLayout>
