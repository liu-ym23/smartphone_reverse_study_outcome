<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/custom_praise_dialog_container"
    android:background="@drawable/larus_bg_custom_praise_dialog"
    android:layout_width="294dp"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/custom_praise_dialog_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:src="@drawable/larus_ic_custom_praise_dialog_close"
        android:layout_marginStart="258dp"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/custom_praise_dialog_avatar"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:contentDescription="@null"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/custom_praise_dialog_main_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/larus_rating_title"
        android:includeFontPadding="false"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/larus_neutral_50"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/custom_praise_dialog_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/larus_rating_subtitle"
        android:includeFontPadding="false"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/custom_praise_dialog_stars"
        android:layout_width="164dp"
        android:layout_height="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/larus_ic_custom_praise_dialog_five_stars"
        android:contentDescription="@null"/>
    <TextView
        android:background="@color/larus_neutral_100"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:alpha="0.1"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="47.5dp">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/larus_neutral_100"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/custom_praise_dialog_complaint_text"
            android:layout_width="147dp"
            android:layout_height="match_parent"
            android:text="@string/larus_rating_feedback"/>
        <TextView
            android:background="@color/larus_neutral_100"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"
            android:alpha="0.1"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/larus_primary_50"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/custom_praise_dialog_praise_text"
            android:layout_width="147dp"
            android:layout_height="match_parent"
            android:text="@string/larus_rating_rating"/>
    </LinearLayout>
</LinearLayout>
