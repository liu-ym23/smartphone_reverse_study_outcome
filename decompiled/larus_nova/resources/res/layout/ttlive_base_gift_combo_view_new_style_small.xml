<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/combo_effect_container"
        android:visibility="invisible"
        android:layout_width="100dp"
        android:layout_height="125dp"
        android:layout_marginBottom="50dp"
        app:layout_constraintBottom_toBottomOf="@+id/combo_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.bytedance.android.livesdk.gift.platform.business.dialog.v2.view.newcombo.GiftComboProgressBar
        android:layout_gravity="center"
        android:id="@+id/combo_progress_bar"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="84dp"
        android:layout_height="84dp"
        app:layout_constraintBottom_toBottomOf="@+id/combo_bg"
        app:layout_constraintEnd_toEndOf="@+id/combo_bg"
        app:layout_constraintStart_toStartOf="@+id/combo_bg"
        app:layout_constraintTop_toTopOf="@+id/combo_bg"/>
    <com.bytedance.android.livesdk.gift.platform.business.dialog.v2.view.newcombo.ComboWaveView
        android:layout_gravity="center"
        android:id="@+id/round_wave_anim_view"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="150dp"
        android:layout_height="150dp"
        app:layout_constraintBottom_toBottomOf="@+id/combo_bg"
        app:layout_constraintEnd_toEndOf="@+id/combo_bg"
        app:layout_constraintStart_toStartOf="@+id/combo_bg"
        app:layout_constraintTop_toTopOf="@+id/combo_bg"/>
    <com.bytedance.android.livesdk.gift.platform.business.dialog.v2.view.newcombo.ComboProgressAnimationViewNew
        android:id="@+id/combo_progress"
        android:background="@color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="120dp"
        android:layout_height="130dp"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/combo_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.bytedance.android.livesdk.gift.platform.business.dialog.v3.view.combo.ComboEffectAnimationView
        android:id="@+id/combo_effect"
        android:layout_width="130dp"
        android:layout_height="130dp"
        app:layout_constraintBottom_toTopOf="@+id/combo_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/combo_bg"/>
    <com.bytedance.android.livesdk.gift.platform.business.dialog.v3.view.combo.ComboIconAnimationView
        android:id="@+id/combo_icon_animation"
        android:layout_width="160dp"
        android:layout_height="160dp"
        app:layout_constraintBottom_toBottomOf="@+id/combo_bg"
        app:layout_constraintEnd_toEndOf="@+id/combo_bg"
        app:layout_constraintStart_toStartOf="@+id/combo_bg"
        app:layout_constraintTop_toTopOf="@+id/combo_bg"/>
    <View
        android:id="@+id/location_view"
        android:layout_width="68dp"
        android:layout_height="68dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/combo_bg"
        android:background="@drawable/ttlive_base_gift_combo_bg_new_style"
        android:layout_width="68dp"
        android:layout_height="68dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/gradient_bg_container"
        android:background="@drawable/ttlive_gift_big_combo_gradient_bg"
        android:visibility="visible"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="@+id/combo_bg"
        app:layout_constraintEnd_toEndOf="@+id/combo_bg"
        app:layout_constraintStart_toStartOf="@+id/combo_bg"
        app:layout_constraintTop_toTopOf="@+id/combo_bg"/>
    <View
        android:id="@+id/combo_title"
        android:background="@drawable/ttlive_base_gift_combo_desc_new_style"
        android:visibility="visible"
        android:layout_width="41dp"
        android:layout_height="18dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="@+id/combo_bg"
        app:layout_constraintStart_toStartOf="@+id/combo_bg"
        app:layout_constraintTop_toTopOf="@+id/combo_bg"/>
    <View
        android:id="@+id/long_combo_title"
        android:background="@drawable/ttlive_gift_long_click_comb_title"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="36dp"
        android:layout_marginTop="15dp"
        app:layout_constraintEnd_toEndOf="@+id/combo_bg"
        app:layout_constraintStart_toStartOf="@+id/combo_bg"
        app:layout_constraintTop_toTopOf="@+id/combo_bg"/>
    <View
        android:id="@+id/count_down_0"
        android:background="@drawable/ttlive_gift_combo_count_down_0"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="@+id/combo_bg"
        app:layout_constraintStart_toStartOf="@+id/combo_bg"
        app:layout_constraintTop_toTopOf="@+id/combo_bg"/>
    <View
        android:id="@+id/count_down_1"
        android:background="@drawable/ttlive_gift_combo_count_down_1"
        android:visibility="gone"
        android:layout_width="9dp"
        android:layout_height="21dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="@+id/combo_bg"
        app:layout_constraintStart_toStartOf="@+id/combo_bg"
        app:layout_constraintTop_toTopOf="@+id/combo_bg"/>
    <View
        android:id="@+id/count_down_2"
        android:background="@drawable/ttlive_gift_combo_count_down_2"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="21dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="@+id/combo_bg"
        app:layout_constraintStart_toStartOf="@+id/combo_bg"
        app:layout_constraintTop_toTopOf="@+id/combo_bg"/>
    <View
        android:id="@+id/count_down_3"
        android:background="@drawable/ttlive_gift_combo_count_down_3"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="21dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="@+id/combo_bg"
        app:layout_constraintStart_toStartOf="@+id/combo_bg"
        app:layout_constraintTop_toTopOf="@+id/combo_bg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
