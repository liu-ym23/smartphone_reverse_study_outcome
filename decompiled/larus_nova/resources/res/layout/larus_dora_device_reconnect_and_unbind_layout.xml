<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/dora_dynamic_overlay"
    android:paddingTop="?attr/larus_dp_24"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="5dp">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/dora_device_disconnect_connect_container"
        android:background="@drawable/larus_item_dora_connect_status"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginRight="?attr/larus_dp_16">
        <ProgressBar
            android:id="@+id/loading_spinner"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:indeterminateDrawable="@drawable/larus_dora_loading"
            android:indeterminateDuration="1000"
            android:layout_marginEnd="?attr/larus_dp_4"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_17"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/dora_device_disconnect_connect_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_dora_device_disconnected_btn_retry_cn"
            android:maxLines="1"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_15"
        android:textColor="@color/larus_neutral_100"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/dora_device_unbind_text"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_6"
        android:layout_marginRight="?attr/larus_dp_16"
        android:text="@string/larus_dora_device_btn_unbind_cn"
        android:maxLines="1"/>
</LinearLayout>
