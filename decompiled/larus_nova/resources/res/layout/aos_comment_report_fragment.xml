<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/aos_feed_bottom_panel_report_dislike_shape"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="50dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:background="@drawable/aos_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"/>
    <RelativeLayout
        android:id="@+id/report_comment"
        android:background="@drawable/aos_feed_bottom_panel_item_round_shape"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="20dp">
        <ImageView
            android:id="@+id/icon_report"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/aos_report_comment_icon"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#fe2c55"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="举报"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/icon_report"/>
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/aos_ic_s_s_arrowforward_outlined_16"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/del_comment"
        android:background="@drawable/aos_feed_bottom_panel_item_round_shape"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="20dp">
        <ImageView
            android:id="@+id/icon_del"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/aos_delete_comment_icon"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#ff161823"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="删除"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/icon_del"/>
    </RelativeLayout>
</LinearLayout>
