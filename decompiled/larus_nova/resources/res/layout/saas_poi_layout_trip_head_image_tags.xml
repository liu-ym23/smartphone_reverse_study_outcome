<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/bottom_tab_container_outer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.dux.image.DuxImageView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/trip_head_image_video_mute_video"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="invisible"
        android:layout_width="28dp"
        android:layout_height="20dp"
        android:layout_marginBottom="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:srcCompat="@drawable/ic_s_s_speakerwavetwo_outlined_20"
        app:tint="@color/white"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottom_tag_container"
        android:layout_width="match_parent"
        android:layout_height="20dp">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/trip_head_image_tags_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/trip_head_image_tags_rv"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"/>
                <com.bytedance.dux.image.DuxImageView
                    android:id="@+id/trip_head_image_tags_icon"
                    android:visibility="gone"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="4dp"
                    app:srcCompat="@drawable/trip_head_image_icon"
                    app:tint="@color/white"/>
                <View
                    android:id="@+id/trip_head_image_tags_divider"
                    android:background="@color/white"
                    android:layout_width="0.5dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="8dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/trip_head_image_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="8dp">
                    <com.bytedance.dux.text.DuxTextView
                        android:textSize="10sp"
                        android:textColor="@color/white"
                        android:id="@+id/trip_head_image_album_text"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/poi_album_text"/>
                    <com.bytedance.dux.text.DuxTextView
                        android:textSize="10sp"
                        android:textColor="@color/white"
                        android:id="@+id/trip_head_image_cur_index"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <com.bytedance.dux.text.DuxTextView
                        android:textSize="10sp"
                        android:textColor="@color/white"
                        android:id="@+id/trip_head_image_total_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <com.bytedance.dux.image.DuxImageView
                        android:id="@+id/trip_head_image_back"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginLeft="2dp"
                        app:srcCompat="@drawable/ic_s_s_arrowforward_outlined_16"
                        app:tint="@color/white"/>
                    <com.bytedance.dux.image.DuxImageView
                        android:id="@+id/content_player_back"
                        android:visibility="gone"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginLeft="2dp"
                        app:srcCompat="@drawable/icon_tags_back_arrowright"
                        app:tint="#ffffffd9"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <View
            android:id="@+id/view_placeholder"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <com.bytedance.dux.image.DuxImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/trip_head_image_video_mute"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="28dp"
            android:layout_height="20dp"
            android:layout_marginStart="12dp"
            app:srcCompat="@drawable/ic_s_s_speakerwavetwo_outlined_20"
            app:tint="@color/white"/>
    </LinearLayout>
</merge>
