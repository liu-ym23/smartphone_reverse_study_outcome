<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_admin_record_anchor_preview"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/white"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_record_preview"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/white"
            android:id="@+id/mAdminRecordAnchorPreviewCancel"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_record_preview_cancel"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:alpha="0.5"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:id="@+id/divider_line"
        android:background="#14ffffff"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="15dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp">
        <com.bytedance.android.livesdk.chatroom.backtrack.LiveVideoPreviewView
            android:id="@+id/mAdminRecordAnchorPreviewVideoView"
            android:layout_width="108dp"
            android:layout_height="192dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/mAdminRecordAnchorPreviewEtParent"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginStart="16dp">
            <TextView
                android:textSize="12dp"
                android:textColor="#88ffffff"
                android:id="@+id/mAdminRecordAnchorPreviewTvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_auto_record_preview_title"/>
            <EditText
                android:textSize="13dp"
                android:textColor="#ccffffff"
                android:gravity="start|top"
                android:id="@+id/edit"
                android:background="@drawable/ttlive_bg_admin_record_edit_text"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp"
                android:layout_weight="1"
                android:inputType="textMultiLine"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp">
        <LinearLayout
            android:gravity="center"
            android:id="@+id/editBtn"
            android:background="@drawable/ttlive_bg_admin_record_btn_gray"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1">
            <ImageView
                android:layout_width="13.5dp"
                android:layout_height="13.5dp"
                android:src="@drawable/ttlive_ic_admin_record_anchor_preview_edit"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="@string/ttlive_auto_record_preview_edit"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/shareBtn"
            android:background="@drawable/ttlive_bg_admin_record_btn_red"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp">
            <ImageView
                android:layout_width="17dp"
                android:layout_height="16dp"
                android:src="@drawable/ttlive_ic_share_fans_group"/> ` 
            <TextView
                android:textSize="15dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="7dp"
                android:text="@string/ttlive_share_fans_group"
                android:layout_marginStart="7dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
