<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="1dp"
    android:layout_width="48dp"
    android:layout_height="48dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center"
        android:id="@+id/guest_bg"
        android:layout_width="48dp"
        android:layout_height="47dp"
        app:placeholderImage="@drawable/ttlive_feed_bg_video_talkroom_empty"/>
    <View
        android:layout_gravity="center"
        android:background="#52000000"
        android:layout_width="48dp"
        android:layout_height="47dp"/>
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="48dp"
        android:layout_height="25dp"
        android:layout_marginTop="8dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/guest_avatar"
            android:layout_width="25dp"
            android:layout_height="25dp"
            app:placeholderImage="@drawable/ttlive_ic_default_head_small"
            app:roundAsCircle="true"/>
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/guest_silence_bg"
            android:background="@drawable/ttlive_feed_bg_interact_gust_silince"
            android:visibility="gone"
            android:layout_width="19dp"
            android:layout_height="7dp"
            android:layout_marginTop="18dp"/>
        <ImageView
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/guest_silence_icon"
            android:visibility="gone"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:src="@drawable/ttlive_ic_small_silence"/>
    </FrameLayout>
    <TextView
        android:textSize="6dp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/guest_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:singleLine="true"
        android:maxLength="8"/>
</FrameLayout>
