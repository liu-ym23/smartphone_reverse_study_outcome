<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/select_frame"
        android:background="@drawable/ttlive_voice_live_theme_select_frame_new"
        android:visibility="invisible"
        android:layout_width="80dp"
        android:layout_height="118dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toTopOf="@+id/theme_name_tv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/add_theme_container"
        android:background="@drawable/ttlive_voice_live_theme_add_bg"
        android:visibility="gone"
        android:layout_width="76dp"
        android:layout_height="114dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/select_frame"
        app:layout_constraintEnd_toEndOf="@+id/select_frame"
        app:layout_constraintStart_toStartOf="@+id/select_frame"
        app:layout_constraintTop_toTopOf="@+id/select_frame">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/add_theme_img"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/ttlive_theme_background"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#4dffffff"
            android:gravity="center"
            android:layout_width="45dp"
            android:layout_height="14dp"
            android:layout_marginTop="4dp"
            android:text="@string/ttlive_live_add_theme_type"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/add_theme_img"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/theme_container"
        android:layout_width="76dp"
        android:layout_height="114dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/select_frame"
        app:layout_constraintEnd_toEndOf="@+id/select_frame"
        app:layout_constraintStart_toStartOf="@+id/select_frame"
        app:layout_constraintTop_toTopOf="@+id/select_frame">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/theme_thumb_iv"
            android:layout_width="72dp"
            android:layout_height="110dp"
            app:actualImageScaleType="centerCrop"
            app:roundedCornerRadius="8dp"/>
        <com.bytedance.android.live.liveinteract.radio.RadioDarkMaskView
            android:layout_gravity="center"
            android:id="@+id/theme_thumb_mask_iv"
            android:visibility="gone"
            android:layout_width="72dp"
            android:layout_height="110dp"
            app:actualImageScaleType="centerCrop"
            app:roundedCornerRadius="8dp"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/video_loading"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/ttlive_audio_theme_loading_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.live.liveinteract.bgComponent.theme.VideoThemeView
            android:layout_gravity="center"
            android:id="@+id/theme_thumb_video"
            android:visibility="gone"
            android:layout_width="72dp"
            android:layout_height="110dp"/>
    </FrameLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="#80ffffff"
        android:gravity="center"
        android:id="@+id/theme_audit_status"
        android:background="#4d000000"
        android:layout_width="0dp"
        android:layout_height="22dp"
        android:text="@string/ttlive_checking"
        app:layout_constraintBottom_toBottomOf="@+id/theme_container"
        app:layout_constraintLeft_toLeftOf="@+id/theme_container"
        app:layout_constraintRight_toRightOf="@+id/theme_container"/>
    <FrameLayout
        android:id="@+id/limit_tag_voice"
        android:background="@drawable/ttlive_bg_select_theme_item_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="2dp"
        app:layout_constraintStart_toStartOf="@+id/theme_container"
        app:layout_constraintTop_toTopOf="@+id/theme_container">
        <TextView
            android:textSize="9sp"
            android:textColor="#ffffff"
            android:layout_gravity="center"
            android:id="@+id/theme_item_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="1dp"
            android:layout_marginRight="4dp"
            android:layout_marginBottom="1dp"
            android:text="@string/ttlive_theme_item_label"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/btn_delete_theme"
        android:visibility="visible"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="7dp"
        android:src="@drawable/ttlive_voice_live_theme_delete_btn"
        android:layout_marginEnd="7dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#80ffffff"
        android:gravity="center"
        android:id="@+id/theme_name_tv"
        android:layout_width="76dp"
        android:layout_height="17dp"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="6dp"
        android:text="@string/ttlive_live_add_theme_widget_title"
        android:alpha="0.5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
