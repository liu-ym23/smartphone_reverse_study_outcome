<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cj_pay_password_component_root_view"
    android:background="@color/cj_pay_color_full_screen_gray"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/cj_pay_view_standard_titlebar_layout"/>
    <TextView
        android:textSize="@dimen/cj_pay_font_size_24"
        android:textStyle="bold"
        android:textColor="@color/cj_pay_color_black_34"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cj_pay_padding_48"
        android:text="@string/cj_pay_verification_real_name"
        android:includeFontPadding="false"
        android:layout_below="@+id/cj_pay_titlebar_layout"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/cj_pay_font_size_13"
        android:textColor="@color/cj_pay_color_gray_153"
        android:gravity="center_horizontal"
        android:id="@+id/tv_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_16"
        android:layout_marginTop="@dimen/cj_pay_padding_20"
        android:layout_marginRight="@dimen/cj_pay_padding_16"
        android:includeFontPadding="false"
        android:layout_below="@+id/tv_title"
        android:layout_centerHorizontal="true"/>
    <RelativeLayout
        android:id="@+id/rl_verification"
        android:background="@color/cj_pay_color_white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_56"
        android:layout_marginTop="@dimen/cj_pay_padding_24"
        android:layout_below="@+id/tv_tips">
        <TextView
            android:textSize="@dimen/cj_pay_font_size_16"
            android:textColor="@color/cj_pay_color_black_34"
            android:id="@+id/tv_verification_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cj_pay_padding_16"
            android:text="@string/cj_pay_verification_id_no_last_six"
            android:layout_centerVertical="true"/>
        <com.android.ttcjpaysdk.thirdparty.view.CJPayPasteAwareEditText
            android:textSize="@dimen/cj_pay_font_size_16"
            android:textColor="@color/cj_pay_color_black_34"
            android:textColorHint="@color/cj_pay_color_gray_202"
            android:id="@+id/et_verification_code"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cj_pay_padding_20"
            android:hint="@string/cj_pay_enter_here"
            android:maxLines="1"
            android:singleLine="true"
            android:maxLength="6"
            android:layout_toRightOf="@+id/tv_verification_code"
            android:layout_centerVertical="true"
            android:textCursorDrawable="@drawable/cj_pay_bg_universal_cursor"/>
        <ImageView
            android:id="@+id/iv_close"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginRight="@dimen/cj_pay_padding_12"
            android:src="@drawable/cj_pay_icon_close"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/cj_pay_font_size_14"
        android:textColor="@color/cj_pay_color_red"
        android:gravity="center_horizontal"
        android:id="@+id/tv_error_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_16"
        android:layout_marginTop="@dimen/cj_pay_padding_24"
        android:layout_marginRight="@dimen/cj_pay_padding_16"
        android:includeFontPadding="false"
        android:layout_below="@+id/rl_verification"
        android:layout_centerHorizontal="true"/>
    <View
        android:id="@+id/cj_pay_keyboard_margin_bottom_view"
        android:background="@color/cj_pay_color_pwd_keyboard_gap_color"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_padding_1"
        android:layout_alignParentBottom="true"/>
    <com.android.ttcjpaysdk.base.ui.widget.CJPayKeyboardView
        android:id="@+id/cj_pay_keyboard_view"
        android:layout_above="@+id/cj_pay_keyboard_margin_bottom_view"
        android:keepScreenOn="true"
        style="@style/CJ_Pay_Keyboard"/>
    <com.android.ttcjpaysdk.base.ui.widget.CJPayTextLoadingView
        android:id="@+id/cj_pay_loading_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
