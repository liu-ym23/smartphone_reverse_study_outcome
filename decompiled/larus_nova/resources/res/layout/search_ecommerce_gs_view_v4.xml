<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gsContainerLayout"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/containerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.ss.android.ugc.aweme.discover.commodity.holder.guidesearch.GSBottomBackGroundView
            android:id="@+id/gs_bottom_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/leftTabMaskView"
            android:background="@drawable/gs_tab_left_mask"
            android:visibility="gone"
            android:layout_width="46dp"
            android:layout_height="35dp"
            android:scaleType="fitXY"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/rightTabMaskView"
            android:background="@drawable/gs_tab_right_mask"
            android:visibility="gone"
            android:layout_width="46dp"
            android:layout_height="35dp"
            android:scaleType="fitXY"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/lineMaskView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/search_commodity_gs_line_mask"
            android:scaleType="fitXY"
            android:layout_marginStart="36dp"
            android:layout_marginEnd="36dp"
            app:layout_constraintEnd_toEndOf="@+id/gs_bottom_background"
            app:layout_constraintStart_toStartOf="@+id/gs_bottom_background"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.ss.android.ugc.aweme.discover.commodity.view.BezierView
            android:id="@+id/bezierView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:curPosition="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tabNumber="4"/>
        <com.bytedance.ies.dmt.ui.widget.tablayout.DmtTabLayout
            android:id="@+id/gsTabLayout"
            android:padding="0dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/jumpLinkView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tabBackground="@null"
            app:tabIndicatorColor="@color/transparent"
            app:tabIndicatorHeight="0dp"
            app:tabPaddingBottom="0dp"
            app:tabPaddingEnd="0dp"
            app:tabPaddingStart="0dp"
            app:tabPaddingTop="0dp"
            app:tabSelectedTextColor="@color/TextPrimary"
            app:tabTextColor="@color/TextTertiary"/>
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:textSize="13sp"
            android:textColor="@color/TextSecondary"
            android:id="@+id/jumpLinkView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableEnd="@drawable/search_gs_jumplink_arrow"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/gsTabLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/gsTabLayout"/>
        <View
            android:id="@+id/tabMaskView"
            android:background="@drawable/search_commodity_gs_tab_mask_bg"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/jumpLinkView"
            app:layout_constraintEnd_toStartOf="@+id/jumpLinkView"
            app:layout_constraintTop_toTopOf="@+id/jumpLinkView"/>
        <com.ss.android.ugc.aweme.discover.commodity.holder.guidesearch.customview.NoneScrollViewPager
            android:id="@+id/gsViewPager"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gsTabLayout"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
