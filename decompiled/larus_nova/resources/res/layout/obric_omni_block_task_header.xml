<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="@dimen/dp_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp_16"
    android:paddingEnd="@dimen/dp_16">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/llHeaderLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_8">
        <TextView
            android:textSize="12sp"
            android:textColor="?attr/larus_neutral_70"
            android:id="@+id/tvHeaderLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/obric_omni_detail_header_user_instruct_hint"
            android:fontFamily="sans-serif"/>
        <ImageView
            android:id="@+id/ivExpand"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/obric_omni_detail_title_show_more"
            android:layout_marginStart="4dp"
            app:tint="?attr/larus_neutral_70"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/flHeaderAttachments"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_8"/>
    <TextView
        android:textSize="@dimen/dp_14"
        android:textColor="?attr/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/tvHeaderTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="4"
        android:lineSpacingExtra="4dp"
        android:fontFamily="sans-serif-medium"/>
    <TextView
        android:textSize="@dimen/dp_14"
        android:textColor="?attr/larus_neutral_50"
        android:ellipsize="end"
        android:id="@+id/tvHeaderDesc"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="4"
        android:lineSpacingExtra="4dp"
        android:fontFamily="sans-serif"/>
    <TextView
        android:textSize="@dimen/dp_14"
        android:textColor="?attr/larus_neutral_100"
        android:ellipsize="end"
        android:id="@+id/tvHeaderAdditionPreview"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="4"
        android:lineSpacingExtra="4dp"
        android:fontFamily="sans-serif-medium"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llHeaderAdditionContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <View
        android:background="?attr/larus_neutral_transparent_2"
        android:layout_width="match_parent"
        android:layout_height="0.6dp"
        android:layout_marginTop="@dimen/dp_20"/>
</LinearLayout>
