<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/applet_action_sheet_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/applet_action_sheet_panel"
        android:background="@drawable/larus_ec_bg_applet_share_sheet"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_18"
        android:elevation="@dimen/dp_16">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/applet_action_sheet_header_container"
            android:paddingTop="@dimen/dp_18"
            android:paddingBottom="@dimen/dp_18"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/applet_action_sheet_title_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/applet_action_sheet_close"
                app:layout_constraintStart_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/ec_applet_action_sheet_title_color"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/applet_action_sheet_title"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:maxLines="1"
                    android:layout_weight="1"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/applet_action_sheet_close"
                android:background="@drawable/larus_ec_bg_applet_action_sheet_close"
                android:layout_width="@dimen/dp_28"
                android:layout_height="@dimen/dp_28"
                android:src="@drawable/ic_applet_close"
                android:scaleType="centerInside"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/ec_applet_action_sheet_close_icon_tint"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/applet_action_sheet_menu_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginBottom="@dimen/dp_20">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/applet_action_sheet_menu_list_row1"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:overScrollMode="never"/>
            <View
                android:id="@+id/applet_action_sheet_header_divider_row2"
                android:background="@color/ec_applet_action_sheet_divider_color"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginBottom="@dimen/dp_16"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/applet_action_sheet_menu_list_row2"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:overScrollMode="never"/>
            <View
                android:id="@+id/applet_action_sheet_header_divider_row3"
                android:background="@color/ec_applet_action_sheet_divider_color"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginBottom="@dimen/dp_16"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/applet_action_sheet_menu_list_row3"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:overScrollMode="never"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
