<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="?attr/larus_dp_16"
    android:paddingTop="?attr/larus_dp_20"
    android:paddingRight="?attr/larus_dp_16"
    android:paddingBottom="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="?attr/larus_neutral_100"
        android:id="@+id/form_msg_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_sp_17"
        android:textColor="?attr/larus_neutral_100"
        android:id="@+id/form_msg_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/form_msg_title"/>
    <View
        android:id="@+id/form_msg_divider"
        android:background="?attr/larus_neutral_transparent_2"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_1"
        android:layout_marginTop="?attr/larus_dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/form_msg_subtitle"/>
    <FrameLayout
        android:id="@+id/form_msg_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/form_msg_divider"/>
</androidx.constraintlayout.widget.ConstraintLayout>
