<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_60"/>
    <com.larus.bmhome.view.item.ItemGroup
        android:id="@+id/group_complex_task_model_settings"
        android:background="@drawable/larus_bg_bot_setting_group"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginStart="@dimen/larus_layout_common_padding"
        android:layout_marginEnd="@dimen/larus_layout_common_padding">
        <com.larus.bmhome.view.item.ItemTextArrow
            android:id="@+id/complex_task_model_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/obric_fragment_complex_task_llm_model_settings_item"
            app:larus_image_height="@dimen/dp_32"
            app:larus_image_src="@drawable/ic_obric_complex_task_model"
            app:larus_image_width="@dimen/dp_32"/>
    </com.larus.bmhome.view.item.ItemGroup>
    <com.larus.bmhome.view.item.ItemGroup
        android:id="@+id/group_complex_mode_settings"
        android:background="@drawable/larus_bg_bot_setting_group"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginStart="@dimen/larus_layout_common_padding"
        android:layout_marginEnd="@dimen/larus_layout_common_padding">
        <com.larus.bmhome.view.item.ItemTextArrow
            android:id="@+id/complex_mode_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/obric_fragment_complex_task_mode_settings_title"
            app:larus_image_height="@dimen/dp_32"
            app:larus_image_src="@drawable/ic_obric_complex_task_mode"
            app:larus_image_width="@dimen/dp_32"/>
    </com.larus.bmhome.view.item.ItemGroup>
    <com.larus.bmhome.view.item.ItemGroup
        android:id="@+id/group_local_deep_search"
        android:background="@drawable/larus_bg_bot_setting_group"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginStart="@dimen/larus_layout_common_padding"
        android:layout_marginEnd="@dimen/larus_layout_common_padding">
        <com.larus.bmhome.view.item.ItemTextToggle
            android:id="@+id/local_deep_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/obric_fragment_complex_task_local_search_settings_item"
            app:larus_image_src="@drawable/ic_obric_complex_local_deep_search"/>
    </com.larus.bmhome.view.item.ItemGroup>
</LinearLayout>
