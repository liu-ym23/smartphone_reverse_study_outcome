<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/root_layout_agreement"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cj_pay_height_470">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_50">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/cj_pay_close_view"
            android:padding="@dimen/cj_pay_padding_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cj_pay_icon_titlebar_left_close"
            android:scaleType="centerCrop"/>
        <TextView
            android:textSize="@dimen/cj_pay_font_size_17"
            android:textColor="@color/cj_pay_color_black_34"
            android:ellipsize="middle"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/cj_pay_middle_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="300dp"
            android:singleLine="true"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/cj_pay_bottom_divider_line"
            android:background="@color/cj_pay_color_gray_232"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_height_half_1"/>
    </FrameLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/container_agreement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
</LinearLayout>
