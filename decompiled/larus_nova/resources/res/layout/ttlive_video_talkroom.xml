<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_talk_room_root"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/single_view_mode_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/rv_video_talkroom_guest_window"
        app:layout_constraintRight_toRightOf="@+id/rv_video_talkroom_guest_window"
        app:layout_constraintTop_toTopOf="@+id/rv_video_talkroom_guest_window"/>
    <View
        android:id="@+id/talk_room_top_bg"
        android:background="@drawable/ttlive_bg_video_camera_top"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/rv_video_talkroom_guest_window"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.ui.ClipImageView
        android:id="@+id/video_talk_room_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:fadeDuration="0"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.ui.ClipImageView
        android:id="@+id/animate_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:fadeDuration="0"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/rv_video_talkroom_guest_window"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/rv_video_talkroom_guest_window"
        app:layout_constraintTop_toTopOf="@+id/rv_video_talkroom_guest_window">
        <FrameLayout
            android:id="@+id/anchor_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/enlarge_player_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/anchor_player_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/interact_render_container_bottom"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/anchor_pause_tips_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.android.live.ui.ClipImageView
                android:id="@+id/anchor_pause_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.bytedance.android.livesdk.common.AnchorPauseTipsView
                android:layout_gravity="center_horizontal"
                android:layout_width="187dp"
                android:layout_height="180dp"
                android:layout_marginTop="140dp"/>
        </FrameLayout>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="end"
            android:id="@+id/iv_identity"
            android:layout_width="31dp"
            android:layout_height="15dp"
            app:actualImageScaleType="centerInside"/>
        <com.bytedance.android.live.liveinteract.view.PositionNameTv
            android:textSize="10dp"
            android:textColor="@color/white"
            android:layout_gravity="end"
            android:id="@+id/tv_position_name"
            android:padding="2dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginRight="4dp"
            android:maxLength="4"
            android:layout_marginEnd="4dp"/>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_video_talkroom_guest_window"
        android:background="@drawable/ttlive_video_camera_recycle_bg"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <com.bytedance.android.live.liveinteract.chatroom.chatroom.ui.SeatAnimationView
        android:id="@+id/anchor_seat_anim_view"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="@+id/container"
        app:layout_constraintEnd_toEndOf="@+id/container"
        app:layout_constraintStart_toStartOf="@+id/container"
        app:layout_constraintTop_toTopOf="@+id/container"
        app:layout_constraintVertical_bias="0.33"/>
</androidx.constraintlayout.widget.ConstraintLayout>
