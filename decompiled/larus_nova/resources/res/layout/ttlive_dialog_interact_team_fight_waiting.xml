<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_dialog_inroom_user"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginRight="16dp"
        android:layout_marginEnd="16dp">
        <TextView
            android:textSize="14dp"
            android:textColor="#7f161823"
            android:id="@+id/cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_anchor_link_window_cancel_apply"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/anchor_avatar"
            android:layout_width="56dp"
            android:layout_height="56dp"/>
        <ImageView
            android:id="@+id/apply_loading_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            android:src="@drawable/ttlive_team_fight_apply_red_team_loading_icon"/>
        <ImageView
            android:id="@+id/team_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ttlive_team_fight_waiting_red_team_icon"/>
    </LinearLayout>
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:layout_gravity="center_horizontal"
        android:id="@+id/has_apply_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ttlive_interact_audience_has_apply"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#57161823"
        android:layout_gravity="center_horizontal"
        android:id="@+id/waiting_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"/>
</LinearLayout>
