<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ec_color_black_161823"
            android:ellipsize="end"
            android:id="@+id/tv_label"
            android:layout_width="68dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_right_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ec_flash_arrow_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ec_color_black_161823"
            android:textColorHint="@color/ec_color_34_161823"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_content"
            android:paddingLeft="12dp"
            android:paddingRight="18dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:paddingEnd="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintLeft_toRightOf="@+id/tv_label"
            app:layout_constraintRight_toLeftOf="@+id/layout_content_info"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.ec.core.widget.ECAutoScaleLayout
            android:id="@+id/layout_content_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/tv_content"
            app:layout_constraintRight_toLeftOf="@+id/iv_right_arrow"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="15dp"
                android:textColor="@color/ec_color_34_161823"
                android:id="@+id/tv_content_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </com.bytedance.android.ec.core.widget.ECAutoScaleLayout>
        <View
            android:id="@+id/view_error_line"
            android:background="@color/ec_color_12_161823"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="64dp"
            android:layout_marginBottom="0.5dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
