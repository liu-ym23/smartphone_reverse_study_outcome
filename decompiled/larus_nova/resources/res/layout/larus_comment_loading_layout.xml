<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="?attr/larus_dp_8"
    android:paddingBottom="?attr/larus_dp_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="?attr/larus_dp_16"
    android:paddingEnd="?attr/larus_dp_16">
    <View
        android:id="@+id/avatar"
        android:background="@drawable/larus_bg_gray_round"
        android:layout_width="?attr/larus_dp_36"
        android:layout_height="?attr/larus_dp_36"
        android:layout_marginTop="?attr/larus_dp_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/text_lay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:background="@drawable/larus_bg_gray_radius_4"
            android:layout_width="?attr/larus_dp_80"
            android:layout_height="?attr/larus_dp_16"
            android:layout_marginTop="?attr/larus_dp_4"/>
        <View
            android:background="@drawable/larus_bg_gray_radius_4"
            android:layout_width="?attr/larus_dp_240"
            android:layout_height="?attr/larus_dp_16"
            android:layout_marginTop="?attr/larus_dp_4"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
