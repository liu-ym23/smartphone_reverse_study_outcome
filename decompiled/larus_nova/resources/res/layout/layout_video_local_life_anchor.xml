<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/poi_location_out_container"
    android:background="@drawable/aos_bg_shopping_card"
    android:padding="6dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_weight="1">
    <com.bytedance.awemeopen.infra.base.image.AoImageView
        android:id="@+id/iv_location_special"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:scaleType="centerCrop"
        android:layout_marginEnd="6dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/poi_location_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/poi_first_line_text_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                    android:textSize="14sp"
                    android:textColor="@color/aos_const_text_inverse2"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/poi_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:fontFamily="sans-serif-medium"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/divider_type"
                    android:layout_width="1dp"
                    android:layout_height="8sp"
                    android:src="@color/aos_const_text_inverse4"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"/>
                <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                    android:textSize="14sp"
                    android:textColor="@color/aos_const_text_inverse2"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/location_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/divider_top"
                    android:layout_width="1dp"
                    android:layout_height="8sp"
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:src="@color/aos_uikit_const_ic_inverse3"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"/>
                <com.bytedance.awemeopen.infra.base.image.AoImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/service_icon"
                    android:layout_width="12sp"
                    android:layout_height="12sp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="2dp"/>
                <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                    android:textSize="11sp"
                    android:textColor="@color/aos_uikit_const_ic_inverse3"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/type_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="1dp"/>
                <com.bytedance.awemeopen.infra.base.image.AoImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_right_arrow"
                    android:visibility="gone"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/legacy_ic_right_guide_arrow"
                    android:layout_marginStart="3dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/poi_info_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"/>
    </LinearLayout>
    <com.bytedance.awemeopen.apps.framework.feed.follow.util.DuxTextView
        android:textSize="13sp"
        android:textColor="@color/aos_white"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/poi_feed_anchor_opt_button"
        android:background="@drawable/poi_feed_anchor_opt_button_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"/>
</LinearLayout>
