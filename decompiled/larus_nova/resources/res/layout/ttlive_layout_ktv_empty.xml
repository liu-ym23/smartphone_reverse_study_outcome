<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/place_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.3">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/empty_cover"
            android:layout_width="240dp"
            android:layout_height="160dp"
            android:src="@drawable/ttlive_empty_content_dark"/>
        <TextView
            android:textSize="17dp"
            android:textColor="#e6ffffff"
            android:layout_gravity="center_horizontal"
            android:id="@+id/empty_hint_phase1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ttlive_ktv_room_selected_list_empty_hint_phase1"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#80ffffff"
            android:layout_gravity="center_horizontal"
            android:id="@+id/empty_hint_phase2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ttlive_ktv_room_selected_list_empty_hint_phase2"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/go_select_music"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/ttlive_search_result_highlight_color"
                android:id="@+id/go_select_music_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_ktv_empty_go_choose"/>
            <View
                android:id="@+id/go_select_music_icon"
                android:background="@drawable/ttlive_ic_ktv_go"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginLeft="6dp"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
