<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/insufficient_bank_images_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="4dp"
        android:layout_marginEnd="4dp">
        <com.android.ttcjpaysdk.thirdparty.view.CJPayRoundCornerImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@color/cj_pay_color_white"
            app:CJPayRoundCornerImageCornerRadius="18dp"/>
        <com.android.ttcjpaysdk.thirdparty.view.CJPayRoundCornerImageView
            android:id="@+id/insufficient_bank_image1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="1dp"
            android:layout_marginTop="1dp"
            android:layout_marginStart="1dp"
            app:CJPayRoundCornerImageCornerRadius="18dp"/>
        <com.android.ttcjpaysdk.thirdparty.view.CJPayRoundCornerImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="14dp"
            android:src="@color/cj_pay_color_white"
            android:layout_marginStart="14dp"
            app:CJPayRoundCornerImageCornerRadius="18dp"/>
        <com.android.ttcjpaysdk.thirdparty.view.CJPayRoundCornerImageView
            android:id="@+id/insufficient_bank_image2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="1dp"
            android:layout_marginStart="15dp"
            app:CJPayRoundCornerImageCornerRadius="18dp"/>
        <com.android.ttcjpaysdk.thirdparty.view.CJPayRoundCornerImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="28dp"
            android:src="@color/cj_pay_color_white"
            android:layout_marginStart="28dp"
            app:CJPayRoundCornerImageCornerRadius="18dp"/>
        <com.android.ttcjpaysdk.thirdparty.view.CJPayRoundCornerImageView
            android:id="@+id/insufficient_bank_image3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="29dp"
            android:layout_marginTop="1dp"
            android:layout_marginStart="29dp"
            app:CJPayRoundCornerImageCornerRadius="18dp"/>
    </FrameLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/cj_pay_color_black_161823"
        android:id="@+id/insufficient_text_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/cj_pay_color_orange_1"
        android:id="@+id/insufficient_text_voucher"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
