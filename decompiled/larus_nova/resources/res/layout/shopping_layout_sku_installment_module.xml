<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/commerce_sku_installment_root_view"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/shopping_std_text_black_1"
            android:id="@+id/tv_sku_installment_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/shopping_std_text_black_4"
            android:id="@+id/tv_sku_installment_desc"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"/>
    </LinearLayout>
    <com.bytedance.android.ec.common.impl.common.ECHorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_sku_installment_info_container"
            android:layout_width="match_parent"
            android:layout_height="64dp"/>
    </com.bytedance.android.ec.common.impl.common.ECHorizontalScrollView>
</LinearLayout>
