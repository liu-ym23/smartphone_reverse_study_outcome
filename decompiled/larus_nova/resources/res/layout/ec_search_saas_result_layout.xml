<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_result_container"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <FrameLayout
        android:id="@+id/search_result_list_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/top_mask_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/search_list_background_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:id="@+id/top_mask_without_gradient"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"/>
                <View
                    android:id="@+id/list_top_mask"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/ambient_result_header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/ambient_result_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.ss.android.ugc.aweme.search.common.view.DoubleBallSwipeRefreshLayout
            android:enabled="false"
            android:id="@+id/pull_refresh_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.ss.android.ugc.aweme.search.common.views.ECNestedCoordinatorLayout
                android:id="@+id/search_coordinator_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.ss.android.ugc.aweme.discover.commodity.view.NestedAppbarLayout
                    android:id="@+id/search_app_bar_layout"
                    android:fadingEdge="none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:elevation="0dp"
                    app:layout_behavior="com.ss.android.ugc.aweme.discover.commodity.view.NestedAppbarLayout$Behavior"
                    app:liftOnScroll="true">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_scrollFlags="scroll">
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/collapsed_top_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <FrameLayout
                                android:id="@+id/misspellContainerView"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>
                            <FrameLayout
                                android:id="@+id/guideSearchContainerView"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </FrameLayout>
                </com.ss.android.ugc.aweme.discover.commodity.view.NestedAppbarLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior">
                    <com.ss.android.ugc.aweme.search.filter.ECSearchGoodFilterLeftView
                        android:id="@+id/search_ec_column_list_container"
                        android:visibility="gone"
                        android:layout_width="56dp"
                        android:layout_height="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.ss.android.ugc.aweme.search.common.list.ESSaasCommonList
                        android:id="@+id/ec_search_common_list"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/search_ec_column_list_container"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <FrameLayout
                    android:orientation="vertical"
                    android:id="@+id/sticky_view_group"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:id="@+id/search_result_header_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <View
                        android:id="@+id/sticky_header_container_top_padding"
                        android:background="#ffffff"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"/>
                </FrameLayout>
            </com.ss.android.ugc.aweme.search.common.views.ECNestedCoordinatorLayout>
        </com.ss.android.ugc.aweme.search.common.view.DoubleBallSwipeRefreshLayout>
        <com.ss.android.ugc.aweme.search.filter.ECSearchFilterBoard
            android:id="@+id/filter_board_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
        <com.ss.android.ugc.aweme.search.filter.view.ui.DmtTextLoadingLayout
            android:layout_gravity="center"
            android:id="@+id/search_result_loading"
            android:visibility="invisible"
            android:layout_width="55dp"
            android:layout_height="55dp"/>
        <ViewStub
            android:id="@+id/search_ec_common_result_empty_stub"
            android:layout="@layout/saas_ec_search_network_error_layout"
            android:inflatedId="@+id/ec_search_net_error_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ViewStub
            android:id="@+id/search_ec_common_result_no_stub"
            android:layout="@layout/saas_ec_search_common_no_result_layout"
            android:inflatedId="@+id/search_ec_common_result_no"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ViewStub
            android:id="@+id/search_ec_common_result_empty_full_stub"
            android:layout="@layout/saas_ec_search_empty_full_view_layout"
            android:inflatedId="@+id/search_ec_common_result_empty_full"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</FrameLayout>
