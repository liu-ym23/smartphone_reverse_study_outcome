<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.shopping.anchorv3.activities.view.ActivityBarBackgroundLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="58dp">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/common_girdle_bg_pic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="fitXY"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/common_girdle_name_pic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:layout_alignParentLeft="true"
        android:layout_marginStart="12dp"
        android:layout_alignParentStart="true"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/common_girdle_slogan_pic"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="12dp"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:gravity="right"
        android:orientation="horizontal"
        android:id="@+id/ll_sec_kill_time"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="12dp"
        android:layout_alignParentEnd="true">
        <TextView
            android:textSize="13dp"
            android:textColor="@color/BGReverse"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:text="@string/ec_inner_flow_countdown_prefix"
            android:includeFontPadding="false"
            android:layout_marginEnd="4dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/days_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <TextView
                android:textSize="13dp"
                android:textColor="@color/BGReverse"
                android:gravity="center"
                android:id="@+id/tv_days"
                android:background="@drawable/ec_inflow_bg_activity_count_down"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:minWidth="18dp"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/BGReverse"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:text="@string/ec_inner_flow_countdown_day"
                android:includeFontPadding="false"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"/>
        </LinearLayout>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/BGReverse"
            android:gravity="center"
            android:id="@+id/tv_hours"
            android:background="@drawable/ec_inflow_bg_activity_count_down"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/BGReverse"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:layout_marginBottom="1dp"
            android:text="@string/ec_inner_flow_colon"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/BGReverse"
            android:gravity="center"
            android:id="@+id/tv_min"
            android:background="@drawable/ec_inflow_bg_activity_count_down"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/BGReverse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:layout_marginBottom="1dp"
            android:text="@string/ec_inner_flow_colon"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/BGReverse"
            android:gravity="center"
            android:id="@+id/tv_sec"
            android:background="@drawable/ec_inflow_bg_activity_count_down"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/commerce_color_E5FFFFFF"
        android:gravity="right"
        android:id="@+id/common_girdle_slogan_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:layout_alignParentRight="true"
        android:lineSpacingExtra="3dp"
        android:layout_marginEnd="12dp"
        android:layout_alignParentEnd="true"/>
</com.bytedance.android.shopping.anchorv3.activities.view.ActivityBarBackgroundLayout>
