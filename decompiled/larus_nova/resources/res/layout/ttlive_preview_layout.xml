<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.livesdk.widget.LiveSwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/follow_view_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"/>
            <com.bytedance.android.livesdk.widget.SafeInterceptTouchLayout
                android:id="@+id/container"
                android:background="@color/liveuikit_black"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:keepScreenOn="true">
                <SurfaceView
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="0dp"/>
                <com.bytedance.android.livesdk.widget.SaaSVerticalViewPager
                    android:id="@+id/viewpager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.bytedance.android.livesdk.widget.SafeInterceptTouchLayout>
        </FrameLayout>
    </com.bytedance.android.livesdk.widget.LiveSwipeRefreshLayout>
    <TextView
        android:textColor="@color/ttlive_white"
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_follow_user_count"
        android:background="@drawable/ttlive_bg_follow_user_count_in_preview"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="35dp"
        android:drawableRight="@drawable/ttlive_feed_ic_down_arror_in_preview"
        android:drawablePadding="2dp"/>
</merge>
