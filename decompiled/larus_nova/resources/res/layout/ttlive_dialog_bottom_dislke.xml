<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/bottom_container"
        android:background="@drawable/ttlive_dislike_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/ll_dislike"
            android:layout_width="match_parent"
            android:layout_height="56dp">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginLeft="16dp"
                android:src="@drawable/ttlive_dislike"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#161823"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="@string/ttlive_dislike"/>
        </LinearLayout>
        <View
            android:background="#0d161823"
            android:layout_width="match_parent"
            android:layout_height="8dp"/>
        <Button
            android:textSize="15sp"
            android:textColor="#161823"
            android:gravity="center"
            android:id="@+id/btn_cancel"
            android:background="#ffffff"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/ttlive_cancel"/>
    </LinearLayout>
</FrameLayout>
