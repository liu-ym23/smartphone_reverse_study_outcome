<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/last_read_hint_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.5"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/last_read_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/ConstTextInverse"
            android:gravity="center"
            android:id="@+id/last_read_tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/follow_feed_last_read_content_reinforce"
            style="@style/font_size_34"/>
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/last_read_back_layout"
            android:background="@drawable/follow_feed_bg_follow_feed_last_read_hint"
            android:layout_width="158dp"
            android:layout_height="44dp"
            android:layout_marginBottom="65dp">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/last_read_back_left"
                    android:visibility="gone"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/follow_feed_ic_last_read_back_left"/>
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/TextReverse"
                    android:id="@+id/last_read_back_des"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:text="@string/follow_feed_to_recommend_reinforce"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    style="@style/font_size_30"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/last_read_back_right"
                    android:visibility="visible"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/follow_feed_bg_last_view_arrow"/>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/video_view_guide"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/common_feed_commom_feed_bottom_double_arrow_up"
                android:layout_marginEnd="3dp"/>
            <TextView
                android:textColor="#ffffff"
                android:id="@+id/dtv_slide_guide_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_feed_tab_land_guide_bottom_desc"
                android:alpha="0.5"
                style="@style/font_size_24"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
