<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/music_cover"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_bg_ktv_stub"
        app:placeholderImageScaleType="fitXY"
        app:roundedCornerRadius="4dp"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/music_duration"
        android:background="@drawable/ttlive_bg_music_duration"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/music_cover"
        app:layout_constraintLeft_toLeftOf="@+id/music_cover"
        app:layout_constraintRight_toRightOf="@+id/music_cover"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/music_audition"
        android:background="@color/ttlive_ktv_music_audition_bg"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginRight="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/ttlive_ic_music_audition_playing"
        app:placeholderImageScaleType="centerInside"
        app:roundedCornerRadius="4dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/music_info_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:divider="@color/transparent"
        android:showDividers="middle"
        android:dividerPadding="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/music_cover"
        app:layout_constraintLeft_toRightOf="@+id/music_cover"
        app:layout_constraintTop_toTopOf="@+id/music_cover">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/first_line_info_cl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#cdffffff"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/music_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="105dp"
                android:singleLine="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="11dp"
                android:textColor="#f40a7e"
                android:gravity="center"
                android:id="@+id/challenge_result_tv"
                android:background="@drawable/ttlive_bg_ktv_challenge_sung_success"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginLeft="4dp"
                android:drawableLeft="@drawable/ttlive_ktv_challenge_result_left_drawable"
                android:drawablePadding="1dp"
                app:layout_constraintBottom_toBottomOf="@+id/music_name"
                app:layout_constraintLeft_toRightOf="@+id/music_name"
                app:layout_constraintTop_toTopOf="@+id/music_name"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/music_score_container"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/music_name"
                app:layout_constraintStart_toEndOf="@+id/music_name"
                app:layout_constraintTop_toTopOf="@+id/music_name">
                <TextView
                    android:textSize="10sp"
                    android:textColor="#161823"
                    android:gravity="center"
                    android:id="@+id/music_score"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/second_line_info_cl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/user_avatar"
                android:layout_width="18dp"
                android:layout_height="18dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImage="@drawable/ttlive_img_avatar_empty"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#80ffffff"
                android:ellipsize="end"
                android:id="@+id/user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:maxWidth="91dp"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_marginStart="6dp"
                app:layout_constraintBottom_toBottomOf="@+id/user_avatar"
                app:layout_constraintStart_toEndOf="@+id/user_avatar"
                app:layout_constraintTop_toTopOf="@+id/user_avatar"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/third_line_info_cl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/rt_chorus_info_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/ttlive_ktv_real_time_chorus_info_content"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
