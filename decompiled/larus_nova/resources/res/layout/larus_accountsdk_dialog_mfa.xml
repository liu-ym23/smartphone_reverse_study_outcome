<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/account_saas_bg_round_full"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18dp"
        android:textColor="@color/account_saas_neutral_100"
        android:gravity="center"
        android:id="@+id/mfa_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="12dp"
        android:fontFamily="sans-serif-medium"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/account_saas_neutral_70"
        android:gravity="center"
        android:id="@+id/mfa_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="20dp"
        android:lineSpacingExtra="2dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/mfa_stage_device_info"
        android:background="@drawable/account_saas_bg_mfa_info"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15dp"
                android:textColor="@color/account_saas_neutral_70"
                android:id="@+id/mfa_location_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_accountsdk_account_mfa_devassist_loc_cn"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/account_saas_neutral_100"
                android:gravity="end"
                android:id="@+id/mfa_location_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <TextView
                android:textSize="15dp"
                android:textColor="@color/account_saas_neutral_70"
                android:id="@+id/mfa_device_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_accountsdk_account_mfa_devassist_dev_cn"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/account_saas_neutral_100"
                android:gravity="end"
                android:id="@+id/mfa_device_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/mfa_stage_code"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp">
        <TextView
            android:textSize="24dp"
            android:textColor="@color/account_saas_neutral_100"
            android:gravity="center"
            android:id="@+id/mfa_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"/>
    </FrameLayout>
    <View
        android:background="@drawable/account_saas_item_divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="24dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/mfa_button_row_confirm"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/account_saas_neutral_100"
            android:gravity="center"
            android:id="@+id/mfa_button_disallow"
            android:background="@drawable/account_saas_bg_leftdown_selector"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/larus_accountsdk_account_mfa_devassist_deny_cn"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"/>
        <View
            android:background="@drawable/account_saas_item_divider"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/account_saas_primary_50"
            android:gravity="center"
            android:id="@+id/mfa_button_allow"
            android:background="@drawable/account_saas_bg_rightdown_selector"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/larus_accountsdk_account_mfa_devassist_allow_cn"
            android:layout_weight="1"
            android:fontFamily="sans-serif"/>
    </LinearLayout>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/account_saas_primary_50"
        android:gravity="center"
        android:id="@+id/mfa_button_done"
        android:background="@drawable/account_saas_bg_down_selector"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/larus_accountsdk_account_mfa_devassist_done_cn"
        android:fontFamily="sans-serif-medium"/>
</LinearLayout>
