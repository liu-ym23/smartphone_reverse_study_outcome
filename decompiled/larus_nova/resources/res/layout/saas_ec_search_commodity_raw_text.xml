<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/text_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/divider"
            android:background="@color/LinePrimary"
            android:layout_width="0dp"
            android:layout_height="0.5dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:textSize="14sp"
            android:textColor="@color/TextTertiary"
            android:id="@+id/raw_text"
            android:paddingTop="28dp"
            android:paddingBottom="28dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="@color/TextPrimary"
            android:id="@+id/bold_title"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginStart="16dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/filter_panel"
            android:paddingTop="0dp"
            android:paddingBottom="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/raw_text"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/new_ui_style_text_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <View
            android:id="@+id/recommend_left_line"
            android:background="@color/LinePrimary"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"
            android:layout_toStartOf="@+id/recommend_text"/>
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:textSize="14sp"
            android:textColor="@color/TextQuaternary"
            android:id="@+id/recommend_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="16dp"
            android:layout_centerInParent="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/recommend_right_line"
            android:background="@color/LinePrimary"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            android:layout_toEndOf="@+id/recommend_text"/>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/left_text_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:textSize="14sp"
            android:textColor="@color/TextTertiary"
            android:id="@+id/left_text"
            android:paddingLeft="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/less_result_and_recommend"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/left_line"
            android:background="@drawable/less_result_left_line"
            android:layout_width="32dp"
            android:layout_height="1dp"/>
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:textSize="14sp"
            android:textColor="@color/TextTertiary"
            android:id="@+id/less_recommend_text"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"/>
        <View
            android:id="@+id/right_line"
            android:background="@drawable/less_result_right_line"
            android:layout_width="32dp"
            android:layout_height="1dp"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/photo_search_section_title"
        android:background="#f5f6f9"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="start"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/title_content_area"
            android:background="@drawable/photo_search_section_title_bg"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.lighten.loader.SmartImageView
                android:layout_gravity="center"
                android:id="@+id/filter_find_similar_icon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="fitXY"
                android:layout_marginStart="12dp"/>
            <com.ss.android.ugc.aweme.search.filter.view.ui.NoPaddingTextView
                android:textSize="18sp"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/filter_find_similar_icon_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
