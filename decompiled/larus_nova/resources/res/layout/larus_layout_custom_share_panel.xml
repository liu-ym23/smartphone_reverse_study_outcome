<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="?attr/larus_dp_8"
    android:layout_marginRight="?attr/larus_dp_8">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/btn_delete"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingRight="?attr/larus_dp_16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:background="@drawable/larus_button_bg"
            android:padding="?attr/larus_dp_20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/larus_gallery_icon_delete"
            android:scaleType="center"/>
        <TextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="@color/larus_neutral_70"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_8"
            android:text="@string/larus_del_button"/>
    </LinearLayout>
    <View
        android:background="@color/neutral_transparent_1"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="?attr/larus_dp_5"
        android:layout_marginRight="?attr/larus_dp_5"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/btn_share"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingRight="?attr/larus_dp_16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:background="@drawable/larus_share_button_bg"
            android:padding="?attr/larus_dp_20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/larus_gallery_icon_share"
            android:scaleType="center"/>
        <TextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="@color/larus_neutral_70"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_8"
            android:text="@string/larus_dora_album_share_cn"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/btn_feedback"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingRight="?attr/larus_dp_16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:background="@drawable/larus_share_button_bg"
            android:padding="?attr/larus_dp_20"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/larus_gallery_icon_feedback"
            android:scaleType="center"/>
        <TextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="@color/larus_neutral_70"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_8"
            android:text="@string/larus_dora_album_feedback_cn"/>
    </LinearLayout>
</LinearLayout>
