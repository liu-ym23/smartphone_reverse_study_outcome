<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/cj_pay_card_insufficient_tip_layout"
    android:background="@color/cj_pay_color_red_opacity_10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/cj_pay_font_size_12"
        android:textColor="@color/cj_pay_color_red"
        android:gravity="left"
        android:id="@+id/cj_pay_card_insufficient_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_16"
        android:layout_marginTop="@dimen/cj_pay_padding_10"
        android:layout_marginRight="@dimen/cj_pay_padding_16"
        android:layout_marginBottom="@dimen/cj_pay_padding_10"
        android:maxLines="2"/>
</LinearLayout>
