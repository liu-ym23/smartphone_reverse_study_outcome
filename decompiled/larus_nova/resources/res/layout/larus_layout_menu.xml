<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/larus_bg_conversation_menu"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/fl_menu_refresh"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingRight="?attr/larus_dp_16"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_250"
        android:layout_height="?attr/larus_dp_56">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_16"
            android:textColor="?attr/larus_neutral_100"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/tv_menu_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_chat_list_rec_change"
            android:fontFamily="sans-serif-medium"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/iv_menu_refresh"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:src="@drawable/larus_ic_cvs_regegerate"
            app:tint="?attr/larus_neutral_100"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_menu_pinned"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingRight="?attr/larus_dp_16"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_250"
        android:layout_height="?attr/larus_dp_56">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_16"
            android:textColor="?attr/larus_neutral_100"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/tv_menu_pinned"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_pin_chat"
            android:fontFamily="sans-serif-medium"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/iv_menu_pinned"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:src="?attr/larus_ic_conversation_pin"
            app:tint="?attr/larus_neutral_100"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_menu_hide"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingRight="?attr/larus_dp_16"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_250"
        android:layout_height="?attr/larus_dp_56">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_16"
            android:textColor="?attr/larus_neutral_100"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/tv_menu_hide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_aiDoc_chatList_hide"
            android:fontFamily="sans-serif-medium"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/iv_menu_hide"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:src="?attr/larus_ic_conversation_hide"
            app:tint="?attr/larus_neutral_100"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_menu_edit_name"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingRight="?attr/larus_dp_16"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_250"
        android:layout_height="?attr/larus_dp_56">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_16"
            android:textColor="?attr/larus_neutral_100"
            android:layout_gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_chat_list_long_press_edit_chat_name"
            android:fontFamily="sans-serif-medium"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|center_vertical"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:src="?attr/larus_ic_rename"
            app:tint="?attr/larus_neutral_100"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_menu_share_message"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingRight="?attr/larus_dp_16"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_250"
        android:layout_height="?attr/larus_dp_56">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_16"
            android:textColor="?attr/larus_neutral_100"
            android:layout_gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_share_chat_long_press_msg"
            android:fontFamily="sans-serif-medium"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|center_vertical"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:src="?attr/larus_ic_screen_menu_share"
            app:tint="?attr/larus_neutral_100"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_menu_remove"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingRight="?attr/larus_dp_16"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_250"
        android:layout_height="?attr/larus_dp_56">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_16"
            android:textColor="@color/larus_danger_50"
            android:layout_gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_chat_list_long_press_remove_chat"
            android:fontFamily="sans-serif-medium"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|center_vertical"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:src="@drawable/larus_ic_screen_menu_delete"/>
    </FrameLayout>
</merge>
