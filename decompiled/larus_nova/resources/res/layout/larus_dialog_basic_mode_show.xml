<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="?attr/larus_bg_round_full"
    android:paddingTop="?attr/larus_dp_24"
    android:paddingBottom="?attr/larus_dp_15"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="?attr/larus_dp_18"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/larus_preinstall_basic_mode_title"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_20"
        android:layout_marginEnd="?attr/larus_dp_20"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.larus.common_ui.widget.UrlSpanTextView
        android:textSize="?attr/larus_dp_15"
        android:textColor="?attr/larus_neutral_50"
        android:id="@+id/dialog_message"
        android:paddingBottom="?attr/larus_dp_15"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_300"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginBottom="?attr/larus_dp_5"
        android:text="@string/larus_preinstall_basic_mode_msg"
        android:layout_marginStart="?attr/larus_dp_20"
        android:layout_marginEnd="?attr/larus_dp_20"
        app:larus_linkColor="?attr/larus_primary_50"
        app:larus_linkUnderLine="false"
        app:layout_constraintTop_toBottomOf="@+id/dialog_title"/>
    <RelativeLayout
        android:id="@+id/agree"
        android:background="?attr/larus_bg_blue_radius_4_selector"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginStart="?attr/larus_dp_20"
        android:layout_marginEnd="?attr/larus_dp_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_message">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="@color/larus_static_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_preinstall_basic_mode_agree"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_14"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/agree">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_50"
            android:id="@+id/exit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_preinstall_basic_mode_disagree"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_50"
            android:id="@+id/enter_basic_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_preinstall_basic_mode_enter"
            android:layout_marginStart="?attr/larus_dp_33"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
