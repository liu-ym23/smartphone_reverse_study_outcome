<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.ee.bear.bitable.common.widgets.SwipeMenuLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/card"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/card_loading"
            android:paddingRight="32dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.larksuite.component.ui.imageview.LKUIRoundedImageView2
                android:background="@color/N900_5"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:oval="true"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp">
                <com.bytedance.ee.bear.bitable.infoarch.nativeview.common.uikit.cell.CommonLoadingView
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bitable_native_view_loading_bg"
                    android:layout_width="160dp"
                    android:layout_height="14dp"/>
                <com.bytedance.ee.bear.bitable.infoarch.nativeview.common.uikit.cell.CommonLoadingView
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bitable_native_view_loading_bg"
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_marginTop="10dp"/>
                <com.bytedance.ee.bear.bitable.infoarch.nativeview.common.uikit.cell.CommonLoadingView
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bitable_native_view_loading_bg"
                    android:layout_width="50dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/card_content"
            android:paddingRight="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.larksuite.component.ui.imageview.LKUIRoundedImageView2
                android:id="@+id/avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:oval="true"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textColor="@color/text_title"
                        android:ellipsize="end"
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="20dp"/>
                    <com.larksuite.component.ui.imageview.LKUIRoundedImageView2
                        android:layout_gravity="right"
                        android:id="@+id/unread_icon"
                        android:background="@color/function_danger_content_default"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginTop="8dp"
                        app:oval="true"/>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/card_wrapper"
                    android:paddingRight="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/text_placeholder"
                        android:id="@+id/time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/card_menu"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/mark_bt"
            android:background="@color/colorful_wathet"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="105dp"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/mark_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:tint="@color/static_white"
                app:srcCompat="@drawable/ud_icon_ellipse_outlined"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/static_white"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:id="@+id/mark_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/Bitable_FeedCenter_MarkAsUnread_Tooltip"
                android:maxLines="2"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/delete_bt"
            android:background="@color/function_danger_content_default"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="105dp"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:tint="@color/static_white"
                app:srcCompat="@drawable/ud_icon_delete_trash_outlined"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/static_white"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/Bitable_FeedCenter_Delete_Button"
                android:maxLines="2"/>
        </LinearLayout>
    </LinearLayout>
</com.bytedance.ee.bear.bitable.common.widgets.SwipeMenuLayout>
