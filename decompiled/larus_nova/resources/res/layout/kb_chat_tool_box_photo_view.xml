<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_layout"
    android:background="@color/bg_base"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.lark.widget.photopickernew.storage.PhotoPartialStoragePermissionNotice
        android:id="@+id/partial_permission_notice"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/left_tool_container"
                android:background="@color/imtoken_message_bg_album"
                android:layout_width="58dp"
                android:layout_height="match_parent">
                <View
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/camera_btn"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:tint="@color/pp_white_icon_selector"
                    app:srcCompat="@drawable/ud_icon_camera_outlined"/>
                <View
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/btn_photo_album"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/kb_ic_keyboard_picture"/>
                <View
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.ss.android.lark.widget.recyclerview.CommonRecyclerView
                    android:orientation="horizontal"
                    android:id="@+id/recyclerview_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <FrameLayout
                    android:gravity="center"
                    android:id="@+id/no_permission_layout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/default_photo_permission_denied_layout"
                        android:paddingTop="40dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/text_placeholder"
                            android:gravity="center"
                            android:id="@+id/tv_photo_permission_denied"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="10dp"
                            android:text="@string/Lark_Legacy_PhotoPermissionDeniedLint"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/function_info_fill_default"
                            android:gravity="center"
                            android:id="@+id/btn_photo_permission_denied"
                            android:background="@color/lkui_transparent"
                            android:padding="15dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Lark_Legacy_OpenPhotoPermission"/>
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>
        <include
            android:layout_gravity="bottom"
            android:id="@+id/layout_photo_insert_message_new"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/photo_picker_insert_to_input_bar"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/chat_menu_post"
        android:background="@color/bg_body"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/layout_original_photo"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0">
            <com.larksuite.component.universe_design.checkbox.UDCheckBox
                android:id="@+id/cb_original_photo"
                android:paddingLeft="12dp"
                android:paddingTop="0dp"
                android:paddingRight="12dp"
                android:paddingBottom="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:minHeight="28dp"
                app:ud_checkbox_type="check_box"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/photo_picker_view_check_box"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/original_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="-5dp"
                android:minHeight="28dp"
                android:text="@string/Lark_Legacy_OriginPic"
                android:maxLines="12"
                android:layout_toRightOf="@+id/cb_original_photo"/>
        </RelativeLayout>
        <View
            android:id="@+id/original_preview_space"
            android:layout_width="8dp"
            android:layout_height="1dp"/>
        <FrameLayout
            android:id="@+id/preview_container"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/btn_photo_preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="100dp"
                android:minHeight="28dp"
                android:maxLines="12"
                android:textAllCaps="false"/>
        </FrameLayout>
        <View
            android:id="@+id/preview_action_space"
            android:layout_width="8dp"
            android:layout_height="1dp"/>
        <FrameLayout
            android:id="@+id/layout_photo_insert_message"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0">
            <com.larksuite.component.universe_design.button.UDButton
                android:textSize="14dp"
                android:textColor="@color/photo_picker_insert_message_text_color"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:id="@+id/btn_photo_insert_message"
                android:layout_marginRight="16dp"
                android:minWidth="64dp"
                android:text="@string/Lark_IM_Attach_InsertIntoMessage_Button"
                android:maxLines="10"
                android:textAllCaps="false"
                app:ud_backgroundColor="@color/N900_5"
                style="@style/UDButton.Small.Primary"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/layout_photo_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0">
            <com.larksuite.component.universe_design.button.UDButton
                android:textSize="14dp"
                android:textColor="@color/static_white"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:id="@+id/btn_photo_send"
                android:layout_marginRight="16dp"
                android:minWidth="64dp"
                android:text="@string/Lark_Legacy_PickerSend"
                android:maxLines="10"
                android:textAllCaps="false"
                app:ud_backgroundColor="@color/ud_button_blue_bg"
                style="@style/UDButton.Small.Primary"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
