<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/action_area"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:clipChildren="false"
        android:layout_width="70dp"
        android:layout_height="76dp"
        android:layout_centerHorizontal="true">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/ttlive_open_feature_icon_default"
            android:scaleType="fitXY"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundedCornerRadius="8dp"/>
        <TextView
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:id="@+id/doing_area"
            android:background="@drawable/ttlive_open_feature_doing_shape"
            android:visibility="gone"
            android:layout_width="35dp"
            android:layout_height="14dp"
            android:text="@string/ttlive_open_platform_feature_panel_ongoing_tip"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="@+id/icon"
            app:layout_constraintTop_toTopOf="@+id/icon"/>
        <TextView
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center_horizontal"
            android:id="@+id/bind_self_mount_area"
            android:background="@drawable/ttlive_open_feature_doing_shape"
            android:visibility="gone"
            android:layout_width="35dp"
            android:layout_height="14dp"
            android:text="@string/ttlive_open_platform_bind_self_mount"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="@+id/icon"
            app:layout_constraintTop_toTopOf="@+id/icon"/>
        <ImageView
            android:id="@+id/red_dot"
            android:background="@drawable/ttlive_ic_red_dot"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toRightOf="@+id/icon"
            app:layout_constraintTop_toTopOf="@+id/icon"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#161823"
            android:id="@+id/count_tv"
            android:background="@drawable/ttlive_bg_yellow_count_dot"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="47dp"
            android:layout_marginTop="4dp"
            android:maxWidth="33dp"
            android:text="@string/ttlive_open_platform_feature_panel_corner_tip"
            android:layout_marginStart="47dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#b3ffffff"
            android:gravity="center_horizontal"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:maxLines="1"
            android:textAlignment="center"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/icon"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
