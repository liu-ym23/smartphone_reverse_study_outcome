<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:paddingBottom="16dp"
    android:minWidth="350dp"
    style="@style/MessageCard">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/merge_forward_top_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/reply_in_thread_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:tint="@color/ud_T600"
            android:layout_marginStart="12dp"
            app:srcCompat="@drawable/ud_icon_thread_chat_outlined"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/udtoken_message_card_text_turquoise"
            android:ellipsize="end"
            android:id="@+id/merge_forward_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:layout_marginBottom="12dp"
            android:maxLines="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/merge_forward_content_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:weightSum="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/merge_forward_title">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_title"
            android:ellipsize="end"
            android:id="@+id/merge_forward_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:layout_weight="1"
            android:lineSpacingMultiplier="1.2"/>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.larksuite.component.ui.imageview.LKUIRoundedImageView2
                android:id="@+id/merge_forward_image"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginLeft="16dp"
                android:scaleType="centerCrop"
                app:border_color="@color/ud_N900_15"
                app:border_width="0.5dp"
                app:radius="4dp"/>
            <com.ss.android.lark.widget.mark.MarkView
                android:layout_gravity="end|bottom"
                android:id="@+id/tv_image_tag"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:layout_marginEnd="6dp"
                app:text="@string/Lark_IM_GIF_Tag"/>
        </FrameLayout>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:background="@color/line_divider_default"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="12dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp">
        <com.larksuite.component.ui.imageview.LKUIRoundedImageView2
            android:id="@+id/merge_forward_from_iv"
            android:visibility="visible"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="5dp"
            app:oval="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_caption"
            android:ellipsize="end"
            android:id="@+id/merge_forward_from"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginEnd="12dp"
            app:layout_goneMarginLeft="0dp"/>
    </LinearLayout>
</LinearLayout>
