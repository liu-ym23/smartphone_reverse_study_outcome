<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/back_iv"
                android:padding="16dp"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="2dp"
                app:srcCompat="@drawable/ud_icon_left_outlined"
                app:tint="@color/ud_N800"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/chart_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_centerVertical="true"
                android:layout_marginStart="56dp"
                android:layout_marginEnd="56dp"/>
        </RelativeLayout>
        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/base_info_layout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textColor="@color/text_caption"
                android:id="@+id/from_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Bitable_HomeDashboard_From_Text"
                android:layout_marginEnd="8dp"/>
            <com.larksuite.component.ui.avatar.v2.LarkAvatarView
                android:id="@+id/base_logo"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textColor="@color/text_title"
                android:ellipsize="end"
                android:id="@+id/base_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="128dp"
                android:maxLines="1"
                android:layout_marginEnd="6dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/udtoken_tag_text_s_blue"
                android:id="@+id/template_tag"
                android:background="@drawable/bitable_home_fullscreen_template_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Bitable_HomeDashboard_Template_Tag"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_marginEnd="6dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/more_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                app:srcCompat="@drawable/ud_icon_right_outlined"
                app:tint="@color/ud_N500"/>
        </LinearLayout>
    </LinearLayout>
    <com.larksuite.component.universe_design.shadow.UDShadowLayout
        android:id="@+id/screen_orientation_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ud_shadow_radius="24dp"
        style="@style/UDShadow.S4">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/screen_orientation_tip_icon"
            android:background="@drawable/bitable_homepage_chart_fullscreen_rotation_bg_round"
            android:padding="12dp"
            android:layout_width="@dimen/orientation_tip_size"
            android:layout_height="@dimen/orientation_tip_size"
            android:layout_marginTop="38dp"
            android:layout_marginBottom="38dp"
            android:tint="@color/ud_N800"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:srcCompat="@drawable/ud_icon_landscape_mode_colorful"/>
    </com.larksuite.component.universe_design.shadow.UDShadowLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
