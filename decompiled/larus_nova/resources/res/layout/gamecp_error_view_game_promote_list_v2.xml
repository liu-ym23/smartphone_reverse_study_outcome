<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="100dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_game_promote_common_error_image"
        android:layout_width="180dp"
        android:layout_height="120dp"
        android:src="@drawable/gamecp_feed_drawer_no_network"
        android:scaleType="fitCenter"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/gamecp_douyin_light_TextTertiary"
        android:id="@+id/tv_game_promote_common_error_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/ttlive_game_promote_list_error_tip"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_game_promote_list_retry"
        android:background="@drawable/gamecp_game_promote_list_dialog_retry_btn"
        android:layout_width="169dp"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:text="@string/ttlive_promote_list_download_error"/>
</LinearLayout>
