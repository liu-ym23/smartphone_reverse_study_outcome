<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="52dp">
    <ImageView
        android:id="@+id/feed_title_left_right"
        android:background="@drawable/ttlive_ic_titlebar_back"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_core_open_d2_64"
        android:gravity="center_vertical"
        android:id="@+id/feed_title"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="16dp"
        android:text="@string/ttlive_feed_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ttlive_core_open_d2_65"
        android:gravity="center_vertical"
        android:id="@+id/feed_title_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:text="@string/ttlive_feed_title_tag"
        app:layout_constraintBottom_toBottomOf="@+id/feed_title"
        app:layout_constraintLeft_toRightOf="@+id/feed_title"
        app:layout_constraintTop_toTopOf="@+id/feed_title"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/feed_title_right_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="23dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="@color/ttlive_feed_open_d2_70"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_feed_title_more_live"/>
        <View
            android:layout_gravity="center_vertical"
            android:background="@drawable/ttlive_feed_ic_right_arrow"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginLeft="4dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
