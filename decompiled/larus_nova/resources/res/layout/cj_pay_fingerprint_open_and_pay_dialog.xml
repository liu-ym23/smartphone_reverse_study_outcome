<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:id="@+id/finger_dialog_layout"
    android:background="@drawable/cj_pay_bg_common_dialog_radius_16"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="@dimen/cj_pay_padding_12"
        android:layout_marginTop="@dimen/cj_pay_padding_12"
        android:src="?attr/cj_pay_icon_titlebar_left_close_noise_reduction"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?attr/cj_pay_text_secondary"
        android:gravity="center"
        android:id="@+id/tv_top_right_btn"
        android:paddingRight="16dp"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="@dimen/cj_pay_padding_16"
        android:text="@string/cj_pay_input_password"
        android:layout_alignParentRight="true"/>
    <ImageView
        android:id="@+id/iv_fingerprint_icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="32dp"
        android:src="@drawable/cj_pay_icon_fingerprint_blue"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="17sp"
        android:textColor="?attr/cj_pay_text_primary"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="20dp"
        android:includeFontPadding="false"
        android:layout_below="@+id/iv_fingerprint_icon"/>
    <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
        android:textSize="15sp"
        android:textColor="@color/cj_pay_color_white"
        android:gravity="center"
        android:id="@+id/btn_confirm"
        android:background="@color/cj_pay_color_red_fe2c55"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_margin="20dp"
        android:layout_below="@+id/tv_tips"/>
</RelativeLayout>
