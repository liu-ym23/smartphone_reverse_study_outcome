<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cell_title_content"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.bytedance.ee.bear.bitable.card.view.cell.title.TitleTextView
        android:textAppearance="@style/UDText.Body2"
        android:textSize="@dimen/space_kit_font_14"
        android:textColor="@color/text_caption"
        android:gravity="center_vertical"
        android:id="@+id/cell_title_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.2"
        app:layout_constrainedWidth="true"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="@+id/single_line_temp"
        app:layout_constraintLeft_toRightOf="@+id/cell_title_icon"
        app:layout_constraintRight_toLeftOf="@+id/cell_title_right_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/UDText.Body2"
        android:textSize="@dimen/space_kit_font_14"
        android:textColor="@color/text_caption"
        android:gravity="center_vertical"
        android:id="@+id/single_line_temp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginStart="@dimen/space_kit_len_22"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.ee.bear.bitable.common.widgets.SyncIconImageView
        android:id="@+id/cell_title_icon"
        android:layout_width="@dimen/space_kit_len_16"
        android:layout_height="@dimen/space_kit_len_16"
        android:tint="@color/icon_n2"
        app:layout_constraintBottom_toBottomOf="@+id/single_line_temp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/single_line_temp"
        app:srcCompat="@drawable/ud_icon_maybe_outlined"/>
    <FrameLayout
        android:id="@+id/cell_title_right_container"
        android:paddingLeft="16dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cell_title_name">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/cell_title_add_icon"
            android:background="@drawable/facade_round_around_s"
            android:padding="4dp"
            android:layout_width="28dp"
            android:layout_height="24dp"
            android:tint="@color/icon_n3"
            android:backgroundTint="@color/bg_body_overlay"
            app:srcCompat="@drawable/ud_icon_add_middle_outlined"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
