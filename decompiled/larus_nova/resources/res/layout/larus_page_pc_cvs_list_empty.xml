<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?attr/larus_dp_10"
        android:paddingEnd="?attr/larus_dp_10">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_icon"
            android:layout_width="?attr/larus_dp_96"
            android:layout_height="?attr/larus_dp_96"
            android:src="@drawable/larus_ic_doubao_pc_empty"/>
        <TextView
            android:textSize="?attr/larus_dp_22"
            android:textStyle="bold"
            android:textColor="?attr/larus_neutral_100"
            android:id="@+id/tv_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_24"/>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/tv_empty_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_8"/>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="7"/>
    <TextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="?attr/larus_neutral_50"
        android:gravity="center"
        android:id="@+id/tv_empty_bottom_desc"
        android:padding="?attr/larus_dp_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_20"
        android:text="@string/larus_mb_desktopHistory_chatEmpty"/>
</merge>
