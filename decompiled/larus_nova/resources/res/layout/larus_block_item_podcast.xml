<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/podcast_root"
        android:background="?attr/larus_bg_block_item_podcast"
        android:padding="?attr/larus_dp_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/podcast_cover"
            android:layout_width="?attr/larus_dp_56"
            android:layout_height="?attr/larus_dp_56"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="@drawable/bg_podcast_avatar_placeholder"
            app:roundedCornerRadius="?attr/larus_dp_6"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="?attr/larus_dp_12"
            android:layout_marginEnd="?attr/larus_dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/podcast_button"
            app:layout_constraintStart_toEndOf="@+id/podcast_cover"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="?attr/larus_dp_16"
                android:textStyle="bold"
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:id="@+id/podcast_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textSize="?attr/larus_dp_12"
                android:textColor="?attr/larus_neutral_50"
                android:ellipsize="end"
                android:id="@+id/podcast_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/podcast_button"
            android:background="?attr/larus_bg_block_item_podcast_button"
            android:layout_width="?attr/larus_dp_81"
            android:layout_height="?attr/larus_dp_36"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/podcast_play"
                android:background="@drawable/larus_ic_block_item_podcast_play"
                android:layout_width="?attr/larus_dp_14"
                android:layout_height="?attr/larus_dp_14"
                android:layout_centerVertical="true"
                android:layout_marginStart="?attr/larus_dp_12"/>
            <ProgressBar
                android:id="@+id/podcast_play_progress"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_14"
                android:layout_height="?attr/larus_dp_14"
                android:layout_centerVertical="true"
                android:layout_marginStart="?attr/larus_dp_12"
                android:indeterminateTint="@color/larus_static_white"/>
            <TextView
                android:textSize="?attr/larus_dp_13"
                android:textStyle="bold"
                android:textColor="@color/larus_static_white"
                android:id="@+id/podcast_btn_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_aiPodcast_play_cn"
                android:layout_centerVertical="true"
                android:layout_marginStart="?attr/larus_dp_4"
                android:layout_toEndOf="@+id/podcast_play"/>
        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
