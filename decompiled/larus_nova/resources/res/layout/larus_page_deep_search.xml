<?xml version="1.0" encoding="utf-8"?>
<com.larus.bmhome.view.ChatConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/deep_search_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/deep_search_title_container"
        android:background="?attr/larus_white_black"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_44"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/deep_search_page_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="?attr/larus_dp_8"
            android:layout_alignParentStart="true"
            app:srcCompat="?attr/larus_icon_back"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/deep_search_page_fav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="?attr/larus_dp_4"
            android:layout_toStartOf="@+id/deep_search_page_share"
            app:srcCompat="?attr/larus_icon_fav"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/deep_search_page_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="?attr/larus_dp_12"
            android:layout_alignParentEnd="true"
            app:srcCompat="?attr/larus_icon_share"/>
    </RelativeLayout>
    <LinearLayout
        android:id="@+id/deep_search_retry_bg"
        android:background="?attr/larus_white_black"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_0"
        android:layout_marginTop="?attr/larus_dp_16"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/deep_search_title_container"
        app:layout_constraintVertical_weight="1">
        <ImageView
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:layout_marginTop="?attr/larus_dp_3"
            android:src="@drawable/larus_warning_circle"
            android:layout_marginStart="?attr/larus_dp_16"/>
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="?attr/larus_neutral_50"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_26"
            android:text="@string/larus_search_deepsearch_tryagain"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/message_list_parent_parent"
        android:background="?attr/larus_white_black"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_0"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/deep_search_title_container"
        app:layout_constraintVertical_weight="1">
        <ViewStub
            android:id="@+id/message_list_parent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
    </FrameLayout>
</com.larus.bmhome.view.ChatConstraintLayout>
