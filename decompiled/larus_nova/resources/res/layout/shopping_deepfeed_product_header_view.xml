<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.shopping.widget.banner.PrimeHorizontalRecyclerView
        android:id="@+id/infeed_product_header_view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/cover_bottom_mask"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_marginBottom="40dp"/>
    <com.bytedance.android.shopping.deepfeed.ui.view.AdapterScreenImageView
        android:layout_gravity="right"
        android:id="@+id/iv_mute"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="100dp"
        android:layout_marginRight="12dp"
        android:src="@drawable/shopping_ic_deep_feed_product_mute"
        app:customMarginRight="12dp"/>
    <com.bytedance.android.shopping.deepfeed.ui.view.AdapterScreenImageView
        android:layout_gravity="right"
        android:id="@+id/iv_unmute"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="100dp"
        android:layout_marginRight="12dp"
        android:src="@drawable/shopping_ic_deep_feed_product_unmute"
        app:customMarginRight="12dp"/>
    <TextView
        android:textSize="9dp"
        android:textColor="@color/ConstLineInverse"
        android:layout_gravity="bottom|right"
        android:id="@+id/tv_ad_tag"
        android:background="@drawable/anchor_v3_guess_u_like_deep_feed_bg"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="91dp"
        android:text="@string/guess_u_like_advertisement"/>
</merge>
