<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_root"
    android:layout_width="60dp"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/icon_area"
        android:focusable="true"
        android:clickable="true"
        android:longClickable="true"
        android:layout_width="54dp"
        android:layout_height="54dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/red_point"
            android:background="@drawable/ttlive_ic_yellow_dot"
            android:visibility="gone"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_margin="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/iv_long_press_mantel"
            android:background="@drawable/ttlive_effect_bg_soundeffect_mantel"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/bg_select"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ttlive_effect_border_sound_item"/>
        <ImageView
            android:id="@+id/iv_download_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/ttlive_effect_ic_soundeffect_download"/>
        <com.bytedance.android.live.effect.soundeffect.HollowCircleProgressView
            android:id="@+id/loading"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:max="100"
            android:progress="45"
            android:layout_centerInParent="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:ttlive_effect_background_color="#99ffffff"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/ttlive_std_text_2"
        android:gravity="center"
        android:id="@+id/tv_sound_effect_title"
        android:layout_width="match_parent"
        android:layout_height="15dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@+id/icon_area"/>
</androidx.constraintlayout.widget.ConstraintLayout>
