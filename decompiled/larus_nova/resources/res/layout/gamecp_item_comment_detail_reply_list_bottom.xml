<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <View
        android:id="@+id/view_comment_detail_reply_list_line"
        android:background="@color/gamecp_game_57161823"
        android:layout_width="20dp"
        android:layout_height="1dp"
        android:layout_marginStart="60dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_comment_detail_reply_list_load_more"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_comment_detail_reply_list_load_more"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/gamecp_game_57161823"
        android:id="@+id/tv_comment_detail_reply_list_load_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_anchor_game_promote_detail_exceed_limit_dialog_setting"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/view_comment_detail_reply_list_line"/>
    <ImageView
        android:id="@+id/iv_comment_detail_reply_list_load_more"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:src="@drawable/gamecp_ic_comment_detail_reply_list_more"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_comment_detail_reply_list_load_more"
        app:layout_constraintStart_toEndOf="@+id/tv_comment_detail_reply_list_load_more"
        app:layout_constraintTop_toTopOf="@+id/tv_comment_detail_reply_list_load_more"/>
    <com.bytedance.android.gamecp.common.ui.DouyinBallLoadingAnimationView
        android:id="@+id/iv_comment_detail_reply_list_loading"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="60dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
