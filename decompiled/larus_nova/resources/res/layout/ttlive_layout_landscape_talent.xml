<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="6dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="6dp">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/talent_avatar_border"
                android:background="@drawable/ttlive_bg_vs_talent_avatar_border"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="center"
                android:id="@+id/talent_avatar"
                android:layout_width="24dp"
                android:layout_height="24dp"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="end|bottom"
                android:id="@+id/talent_verify_icon"
                android:layout_width="10dp"
                android:layout_height="10dp"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:paddingRight="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="6dp">
            <com.bytedance.android.livesdk.interactivity.barrage.view.StrokeColorTextView
                android:textSize="16dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_danmaku_text"
                android:paddingRight="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="16dp"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:shadowColor="#14000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:paddingEnd="4dp"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/icon"
                android:visibility="gone"
                android:layout_width="12dp"
                android:layout_height="12dp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
