<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/tabkit_tab_bar_item_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        app:fadeDuration="100"
        app:layout_constraintBottom_toTopOf="@+id/tabkit_tab_bar_item_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.bytedance.android.shopping.store.tabkit.view.RedDotView
        android:id="@+id/tabkit_tab_bar_item_red_dot"
        android:background="@drawable/ec_tabkit_red_number_dot"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-3.5dp"
        android:layout_marginRight="-3.5dp"
        app:layout_constraintBottom_toTopOf="@+id/tabkit_tab_bar_item_icon"
        app:layout_constraintLeft_toRightOf="@+id/tabkit_tab_bar_item_icon"
        app:layout_constraintRight_toRightOf="@+id/tabkit_tab_bar_item_icon"
        app:layout_constraintTop_toTopOf="@+id/tabkit_tab_bar_item_icon"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/ec_store_tab_item_bubble_guideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.5"/>
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/tabkit_tab_bar_item_red_bubble"
        android:visibility="gone"
        android:layout_width="20sp"
        android:layout_height="16sp"
        app:layoutMode="self_adjust_3X"
        app:layout_constraintBottom_toTopOf="@+id/tabkit_tab_bar_item_icon"
        app:layout_constraintLeft_toRightOf="@+id/ec_store_tab_item_bubble_guideline"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#fffdfc"
        android:id="@+id/tabkit_tab_bar_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
