<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/poi_img"
        android:layout_width="6.3dp"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="8dp"
        android:textColor="@color/ttlive_core_hs_w1_transparent_70"
        android:layout_gravity="center_vertical"
        android:id="@+id/poi_txt"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginLeft="2.8dp"
        android:lines="1"
        android:singleLine="true"
        android:layout_toRightOf="@+id/poi_img"
        android:layout_marginStart="2.8dp"
        android:layout_toEndOf="@+id/poi_img"/>
</RelativeLayout>
