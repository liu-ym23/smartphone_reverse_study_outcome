<?xml version="1.0" encoding="utf-8"?>
<com.ss.android.lark.chat.message.menu.v2.DragPanelLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/emoji_panel_container"
    android:background="@drawable/bg_message_action_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="0dp"
    android:layout_marginRight="0dp"
    android:layout_marginBottom="0dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_horizontal_bar_message_panel"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"/>
        <FrameLayout
            android:id="@+id/all_emoji_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
</com.ss.android.lark.chat.message.menu.v2.DragPanelLayout>
