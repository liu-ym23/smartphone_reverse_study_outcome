<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/game_skeleton_container"
    android:background="@drawable/gamecp_detail_skeleton_bg_gray_layer_no_radius"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/game_skeleton_title_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/game_skeleton_title_bar_close"
            android:visibility="visible"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/gamecp_game_detail_title_close_ic_v2"
            android:scaleType="centerCrop"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/game_skeleton_nav"
        android:background="@drawable/gamecp_detail_skeleton_bg_nav_gary_layer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="112dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/game_skeleton_game_info"
            android:background="@drawable/gamecp_detail_skeleton_bg_white_all_radius_12dp"
            android:paddingLeft="18dp"
            android:paddingTop="14dp"
            android:paddingRight="18dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:id="@+id/game_skeleton_tab"
                android:background="@drawable/gamecp_deatil_skeleton_bg_gray_all_radius_8dp"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/game_skeleton_pic1"
                android:background="@drawable/gamecp_deatil_skeleton_bg_gray_all_radius_8dp"
                android:layout_width="270dp"
                android:layout_height="150dp"
                android:layout_marginTop="14dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/game_skeleton_tab"/>
            <View
                android:id="@+id/game_skeleton_pic2"
                android:background="@drawable/gamecp_deatil_skeleton_bg_gray_all_radius_8dp"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/game_skeleton_pic1"
                app:layout_constraintTop_toBottomOf="@+id/game_skeleton_tab"/>
            <View
                android:id="@+id/game_skeleton_info1"
                android:background="@drawable/gamecp_deatil_skeleton_bg_gray_all_radius_8dp"
                android:layout_width="match_parent"
                android:layout_height="39dp"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/game_skeleton_pic1"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/game_skeleton_game_welfare"
            android:background="@drawable/gamecp_detail_skeleton_bg_white_all_radius_12dp"
            android:paddingLeft="18dp"
            android:paddingTop="16dp"
            android:paddingRight="18dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/game_skeleton_game_info">
            <View
                android:id="@+id/game_skeleton_welfare1"
                android:background="@drawable/gamecp_deatil_skeleton_bg_gray_all_radius_8dp"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/game_skeleton_welfare2"
                android:background="@drawable/gamecp_deatil_skeleton_bg_gray_all_radius_8dp"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/game_skeleton_welfare1"/>
            <View
                android:id="@+id/game_skeleton_welfare3"
                android:background="@drawable/gamecp_deatil_skeleton_bg_gray_all_radius_8dp"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/game_skeleton_welfare2"/>
            <View
                android:id="@+id/game_skeleton_welfare4"
                android:background="@drawable/gamecp_deatil_skeleton_bg_gray_all_radius_8dp"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/game_skeleton_welfare3"/>
            <View
                android:id="@+id/game_skeleton_welfare5"
                android:background="@drawable/gamecp_deatil_skeleton_bg_gray_all_radius_8dp"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/game_skeleton_welfare4"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
