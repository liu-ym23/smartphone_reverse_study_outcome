<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/flag_experience_score_view_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="13dp"
        android:typeface="sans"
        android:textStyle="bold"
        android:textColor="#b47d55"
        android:id="@+id/flag_experience_score_view_score_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:includeFontPadding="false"/>
    <ImageView
        android:id="@+id/flag_experience_score_view_fen_icon"
        android:layout_width="11dp"
        android:layout_height="11dp"
        android:layout_marginLeft="1dp"
        android:src="@drawable/ec_store_flag_ship_experience_score_fen_icon"/>
</LinearLayout>
