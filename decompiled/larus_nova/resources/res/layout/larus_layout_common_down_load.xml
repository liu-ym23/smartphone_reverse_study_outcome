<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/download_inner_image_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/larus_ic_download_white_filled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/download_inner_text"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/download_inner_loading"
        android:visibility="invisible"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/larus_ic_common_download_loading_animated"
        android:indeterminateDuration="2000"
        app:layout_constraintBottom_toBottomOf="@+id/download_inner_image_view"
        app:layout_constraintEnd_toEndOf="@+id/download_inner_image_view"
        app:layout_constraintStart_toStartOf="@+id/download_inner_image_view"
        app:layout_constraintTop_toTopOf="@+id/download_inner_image_view"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_sp_16"
        android:textColor="@color/larus_static_white"
        android:ellipsize="end"
        android:id="@+id/download_inner_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_creationPreview_btn_save"
        android:maxLines="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="?attr/larus_dp_4"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/download_inner_image_view"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
