<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/supreme_wrapper"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:id="@+id/supreme_first_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="80dp"
        android:layout_marginStart="80dp">
        <com.bytedance.android.livesdk.interactivity.barrage.view.StrokeColorTextView
            android:id="@+id/supreme_attach_1_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"/>
        <com.bytedance.android.livesdk.interactivity.barrage.view.StrokeColorTextView
            android:id="@+id/supreme_attach_1_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_marginStart="24dp"/>
        <com.bytedance.android.livesdk.interactivity.barrage.view.StrokeColorTextView
            android:id="@+id/supreme_attach_1_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_marginStart="24dp"/>
        <com.bytedance.android.livesdk.interactivity.barrage.view.StrokeColorTextView
            android:id="@+id/supreme_attach_1_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_marginStart="24dp"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/main_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:paddingStart="130dp">
        <com.bytedance.android.livesdk.interactivity.barrage.view.StrokeColorTextView
            android:id="@+id/supreme_attach_2_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"/>
        <com.bytedance.android.livesdk.interactivity.barrage.view.StrokeColorTextView
            android:id="@+id/supreme_attach_2_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_marginStart="24dp"/>
        <com.bytedance.android.livesdk.interactivity.barrage.view.StrokeColorTextView
            android:id="@+id/supreme_attach_2_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_marginStart="24dp"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/supreme_third_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="50dp"
        android:layout_marginStart="50dp">
        <com.bytedance.android.livesdk.interactivity.barrage.view.StrokeColorTextView
            android:id="@+id/supreme_attach_3_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"/>
        <com.bytedance.android.livesdk.interactivity.barrage.view.StrokeColorTextView
            android:id="@+id/supreme_attach_3_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_marginStart="24dp"/>
        <com.bytedance.android.livesdk.interactivity.barrage.view.StrokeColorTextView
            android:id="@+id/supreme_attach_3_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_marginStart="24dp"/>
        <com.bytedance.android.livesdk.interactivity.barrage.view.StrokeColorTextView
            android:id="@+id/supreme_attach_3_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_marginStart="24dp"/>
    </LinearLayout>
</LinearLayout>
