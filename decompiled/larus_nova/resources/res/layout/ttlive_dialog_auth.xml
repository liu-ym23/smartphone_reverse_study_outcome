<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:background="@drawable/ttlive_bg_auth_pane"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="325dp">
    <ImageView
        android:id="@+id/iv_apply"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ttlive_ic_apply_verify"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_close"
        android:paddingLeft="3.25dp"
        android:paddingTop="1.25dp"
        android:paddingRight="3.25dp"
        android:paddingBottom="1.25dp"
        android:layout_width="16dp"
        android:layout_height="12dp"
        android:src="@drawable/ttlive_ic_auth_close"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_name_tick"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="13dp"
        android:src="@drawable/ttlive_ic_auth_tick"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_apply"/>
    <ImageView
        android:id="@+id/iv_id_tick"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="13dp"
        android:src="@drawable/ttlive_ic_auth_tick"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_name_tick"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_wallet_light_main_text"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:text="@string/ttlive_hezhongyibao"
        app:layout_constraintBottom_toBottomOf="@+id/iv_apply"
        app:layout_constraintLeft_toRightOf="@+id/iv_apply"
        app:layout_constraintTop_toTopOf="@+id/iv_apply"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_wallet_light_main_text"
        android:id="@+id/tv_apply"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15.5dp"
        android:text="@string/ttlive_apply_verify_info"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_divider"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ttlive_wallet_auth_name"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:text="@string/ttlive_account_verify"
        app:layout_constraintBottom_toBottomOf="@+id/iv_name_tick"
        app:layout_constraintLeft_toRightOf="@+id/iv_name_tick"
        app:layout_constraintTop_toTopOf="@+id/iv_name_tick"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ttlive_wallet_auth_name"
        android:id="@+id/tv_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:text="@string/ttlive_id"
        app:layout_constraintBottom_toBottomOf="@+id/iv_id_tick"
        app:layout_constraintLeft_toRightOf="@+id/iv_name_tick"
        app:layout_constraintTop_toTopOf="@+id/iv_id_tick"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ttlive_wallet_auth_name"
        android:id="@+id/tv_agree"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_id"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_agreement"
        android:background="@drawable/ttlive_bg_verify_auth_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:text="@string/ttlive_caijing_auth_agree"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_agree"/>
    <ProgressBar
        android:theme="@style/progressBarWhite"
        android:id="@+id/pb"
        android:visibility="gone"
        android:layout_width="18dp"
        android:layout_height="18dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_agreement"
        app:layout_constraintLeft_toLeftOf="@+id/tv_agreement"
        app:layout_constraintRight_toRightOf="@+id/tv_agreement"
        app:layout_constraintTop_toTopOf="@+id/tv_agreement"/>
    <View
        android:id="@+id/v_divider"
        android:background="@color/ttlive_wallet_auth_divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_apply"/>
</androidx.constraintlayout.widget.ConstraintLayout>
