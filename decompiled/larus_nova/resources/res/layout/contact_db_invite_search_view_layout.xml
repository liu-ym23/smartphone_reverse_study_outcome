<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ipsRootCl"
    android:background="@color/flow_ud_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:paddingLeft="12dp"
        android:paddingTop="6dp"
        android:paddingRight="12dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.larksuite.component.ui.layout.LKUIRoundLinearLayout
            android:gravity="center_vertical"
            android:id="@+id/ipsSearchLl"
            android:background="@color/flow_ud_bg_base_3_overlay"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            app:rl_radius="16dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="14dp"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="14dp"
                app:srcCompat="@drawable/contact_db_icon_search"
                app:tint="@color/flow_ud_neutral_50"/>
            <com.suite.lark.emm.design.edittext.SCEditText
                android:textSize="17sp"
                android:textColor="@color/flow_ud_neutral_100"
                android:textColorHint="@color/flow_ud_neutral_50"
                android:id="@+id/ipsSearchEt"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:singleLine="true"
                android:layout_weight="1"
                android:inputType="text"
                android:imeOptions="actionSearch"/>
            <ImageView
                android:id="@+id/ipsSearchClearIv"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                app:srcCompat="@drawable/ud_icon_close_filled"
                app:tint="@color/flow_ud_neutral_50"/>
        </com.larksuite.component.ui.layout.LKUIRoundLinearLayout>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/flow_ud_neutral_100"
            android:layout_gravity="center_vertical"
            android:id="@+id/ipsCancelTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LarkIM_Common_Cancel_Button"
            android:layout_marginStart="14dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/ipsContentFl"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ipsResultRv"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
        <include
            android:id="@+id/ipsSearchActionLayout"
            android:visibility="gone"
            layout="@layout/contact_db_invite_search_action_item_layout"/>
        <include
            android:id="@+id/ipsEmptyLayout"
            android:visibility="gone"
            layout="@layout/contact_db_invite_search_empty_layout"/>
        <include
            android:id="@+id/ipsLoadingLayout"
            android:visibility="gone"
            layout="@layout/contact_db_invite_search_loading_layout"/>
    </FrameLayout>
</LinearLayout>
