<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="80dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ocr_bottom_item1_layout"
        android:layout_width="60dp"
        android:layout_height="80dp">
        <ImageView
            android:id="@+id/ocr_bottom_item1_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:tint="@color/ocr_tint_color"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/ocr_bottom_txt_color"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/ocr_bottom_item1_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxLines="2"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ocr_bottom_item2_layout"
        android:layout_width="60dp"
        android:layout_height="80dp">
        <ImageView
            android:id="@+id/ocr_bottom_item2_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:tint="@color/ocr_tint_color"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/ocr_bottom_txt_color"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/ocr_bottom_item2_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxLines="2"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ocr_bottom_item3_layout"
        android:layout_width="60dp"
        android:layout_height="80dp">
        <ImageView
            android:id="@+id/ocr_bottom_item3_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:tint="@color/ocr_tint_color"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/ocr_bottom_txt_color"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/ocr_bottom_item3_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxLines="2"/>
    </LinearLayout>
</LinearLayout>
