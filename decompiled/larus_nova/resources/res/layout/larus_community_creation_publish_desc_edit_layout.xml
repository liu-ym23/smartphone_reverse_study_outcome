<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="?attr/larus_dp_16"
        android:gravity="start|top"
        android:id="@+id/desc_edit"
        android:background="@color/larus_base_2"
        android:paddingTop="?attr/larus_dp_16"
        android:paddingBottom="?attr/larus_dp_35"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_114"
        android:hint="@string/larus_image_publish_text_placeholder_desc"
        android:inputType="textMultiLine"
        android:paddingStart="?attr/larus_dp_16"
        android:paddingEnd="?attr/larus_dp_16"
        style="@style/larus_EditTextStyle"/>
    <TextView
        android:textSize="?attr/larus_dp_15"
        android:textColor="@color/larus_neutral_30"
        android:layout_gravity="end|bottom"
        android:id="@+id/counter_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_16"/>
</merge>
