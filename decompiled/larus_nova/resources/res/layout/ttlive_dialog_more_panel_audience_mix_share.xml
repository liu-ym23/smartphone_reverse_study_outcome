<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/more_mix_share_panel_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerLinearlayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/panel_container"
        android:background="@drawable/ttlive_bg_broadcast_more_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ttlive_leftTopRadius="10dp"
        app:ttlive_rightTopRadius="10dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/im_share_layer"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/panel_container"
        app:layout_constraintLeft_toLeftOf="@+id/panel_container"
        app:layout_constraintRight_toRightOf="@+id/panel_container"
        app:layout_constraintTop_toTopOf="@+id/panel_container">
        <FrameLayout
            android:id="@+id/im_share_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:id="@+id/im_share_container_bottom_mask"
            android:background="#4d161823"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
