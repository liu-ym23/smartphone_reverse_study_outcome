<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/cj_pay_color_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/transparent_split_line"
        android:background="@color/cj_pay_color_gray_248"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/cj_pay_color_gray_161823_opacity_50"
        android:id="@+id/transparent_split_line_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"/>
</LinearLayout>
