<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="horizontal"
    android:id="@+id/hot_msg_container"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="30dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/hot_msg_text_layout"
        android:background="@drawable/ttlive_bg_hot_msg_gather"
        android:paddingLeft="8dp"
        android:paddingTop="3dp"
        android:paddingRight="8dp"
        android:paddingBottom="3dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="26dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/hot_msg_combo_body"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap">
        <TextView
            android:textSize="14dp"
            android:textColor="#99ffffff"
            android:id="@+id/hot_msg_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/hot_msg_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:maxEms="8"
            android:singleLine="true"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/hot_msg_combo_body"
        android:visibility="visible"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:translationY="-3dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toRightOf="@+id/hot_msg_text_layout"
        app:layout_constraintRight_toRightOf="parent">
        <TextView
            android:textSize="16dp"
            android:textColor="#ffffff"
            android:id="@+id/hot_msg_combo_count_x"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="x"/>
        <com.bytedance.android.livesdk.widget.MaxWidthTextView
            android:textSize="24dp"
            android:textColor="#ffffff"
            android:id="@+id/hot_msg_combo_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="1"
            android:includeFontPadding="false"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
