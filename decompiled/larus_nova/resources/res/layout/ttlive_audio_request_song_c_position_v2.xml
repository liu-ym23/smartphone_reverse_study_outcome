<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="top|center_horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/guide_view_left"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toStartOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintHorizontal_weight="9"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/guide_view_right"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="9"
        app:layout_constraintStart_toEndOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ttlive_guest_avatar_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="h,1:1"
        app:layout_constraintEnd_toStartOf="@+id/guide_view_right"
        app:layout_constraintHorizontal_weight="64"
        app:layout_constraintStart_toEndOf="@+id/guide_view_left"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/guide_content_view_left"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/guide_content_view_point"
            app:layout_constraintEnd_toStartOf="@+id/guide_content_view_point"
            app:layout_constraintHorizontal_weight="12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_weight="12"/>
        <View
            android:id="@+id/guide_content_view_right"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="12"
            app:layout_constraintStart_toEndOf="@+id/guide_content_view_point"
            app:layout_constraintTop_toBottomOf="@+id/guide_content_view_point"
            app:layout_constraintVertical_weight="12"/>
        <View
            android:id="@+id/guide_content_view_point"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/guide_content_view_right"
            app:layout_constraintEnd_toStartOf="@+id/guide_content_view_right"
            app:layout_constraintHorizontal_weight="56"
            app:layout_constraintStart_toEndOf="@+id/guide_content_view_left"
            app:layout_constraintTop_toBottomOf="@+id/guide_content_view_left"
            app:layout_constraintVertical_weight="56"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ttlive_guest_avatar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/guide_content_view_point"
            app:layout_constraintEnd_toEndOf="@+id/guide_content_view_point"
            app:layout_constraintStart_toStartOf="@+id/guide_content_view_point"
            app:layout_constraintTop_toTopOf="@+id/guide_content_view_point"/>
        <include
            android:layout_gravity="center"
            android:id="@+id/interact_song_gold_microphone_container"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            app:layout_constraintBottom_toBottomOf="@+id/ttlive_guest_avatar"
            app:layout_constraintLeft_toLeftOf="@+id/ttlive_guest_avatar_container"
            app:layout_constraintRight_toRightOf="@+id/ttlive_guest_avatar_container"
            layout="@layout/ttlive_video_request_song_label_layout"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/request_song_mic_icon_anim_view"
            android:visibility="visible"
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:layout_constraintBottom_toBottomOf="@+id/interact_song_gold_microphone_container"
            app:layout_constraintStart_toStartOf="@+id/interact_song_gold_microphone_container"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/request_song_micseat_anim_view_container"
        android:visibility="visible"
        android:clipChildren="false"
        android:layout_width="@dimen/ttlive_voice_chat_guest_seat_avatar_size"
        android:layout_height="@dimen/ttlive_voice_chat_guest_seat_avatar_size"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintLeft_toLeftOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintRight_toRightOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintTop_toTopOf="@+id/ttlive_guest_avatar_container">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/request_song_micseat_anim_view"
            android:visibility="visible"
            android:layout_width="@dimen/ttlive_voice_chat_guest_seat_effect_size"
            android:layout_height="@dimen/ttlive_voice_chat_guest_seat_effect_size"/>
    </FrameLayout>
    <com.bytedance.android.live.liveinteract.view.MicSeatSponsorView
        android:id="@+id/ll_mic_seat_sponsor_anim"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
