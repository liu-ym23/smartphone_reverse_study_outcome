<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/lkui_transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/modify_avatar_popupwindow_round8_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/text_title"
            android:gravity="center"
            android:id="@+id/take_picture_tv"
            android:background="@drawable/modify_avatar_item_bg_selector_top"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/Lark_Legacy_UploadImageTakePhoto"/>
        <View
            android:background="@color/line_divider_default"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/text_title"
            android:gravity="center"
            android:id="@+id/select_from_gallery_tv"
            android:background="@drawable/modify_avatar_item_bg_selector_normal"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/Lark_Legacy_ChooseFromPhotolibrary"/>
        <View
            android:background="@color/line_divider_default"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/text_title"
            android:gravity="center"
            android:id="@+id/tv_last_avatar"
            android:background="@drawable/modify_avatar_item_bg_selector_normal"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/Lark_ProfilePhoto_ViewPrevious_Button"/>
        <View
            android:id="@+id/line_last_avatar"
            android:background="@color/line_divider_default"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/text_title"
            android:gravity="center"
            android:id="@+id/tv_restore_avatar"
            android:background="@drawable/modify_avatar_item_bg_selector_normal"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/Lark_Profile_UseDefaultProfilePhoto"/>
        <View
            android:id="@+id/line_restore"
            android:background="@color/line_divider_default"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/text_title"
            android:gravity="center"
            android:id="@+id/tv_save"
            android:background="@drawable/modify_avatar_item_bg_selector_normal"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/Lark_Profile_SaveImage"/>
        <View
            android:id="@+id/line_save"
            android:background="@color/line_divider_default"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/text_title"
            android:gravity="center"
            android:id="@+id/cancel_tv"
            android:background="@drawable/modify_avatar_item_bg_selector_bottom"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/Lark_Legacy_ModifyAvatarCancel"/>
    </LinearLayout>
</FrameLayout>
