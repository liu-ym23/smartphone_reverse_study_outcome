<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ttlive_white"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
        android:id="@+id/preload_progress_icon_double_ball"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/ttlive_pk_userlist_refresh_progress_anim"
        android:indeterminateBehavior="repeat"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"/>
    <ProgressBar
        android:id="@+id/preload_progress_icon_normal"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="10dp"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/ttlive_pk_userlist_refresh_progress_anim"
        android:indeterminateBehavior="repeat"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/tv_empty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/empty_image_view"
            android:layout_width="192dp"
            android:layout_height="128dp"
            app:placeholderImage="@drawable/ttlive_empty_content_light"
            app:placeholderImageScaleType="fitXY"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#80161823"
            android:id="@+id/empty_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/ttlive_interact_no_link_record"/>
    </LinearLayout>
    <com.bytedance.android.live.revlink.impl.pk.ui.PkItemExposeRecyclerView
        android:id="@+id/recycler_view"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_filter_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <GridLayout
            android:id="@+id/ll_filter_options"
            android:background="@color/white"
            android:paddingLeft="16dp"
            android:paddingTop="12dp"
            android:paddingRight="16dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:columnCount="3">
            <TextView
                android:textSize="13dp"
                android:textColor="#fe2c55"
                android:gravity="center"
                android:layout_gravity="fill_horizontal"
                android:background="@drawable/ttlive_bg_pk_record_filter_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_interact_pk_record_filter_all"
                android:layout_columnSpan="1"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#161823"
                android:gravity="center"
                android:layout_gravity="fill_horizontal"
                android:background="@drawable/ttlive_bg_pk_record_filter_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:text="@string/ttlive_interact_pk_record_filter_online"
                android:layout_columnSpan="1"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#161823"
                android:gravity="center"
                android:layout_gravity="fill_horizontal"
                android:background="@drawable/ttlive_bg_pk_record_filter_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_interact_pk_record_filter_follow"
                android:layout_columnSpan="1"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#161823"
                android:gravity="center"
                android:layout_gravity="fill_horizontal"
                android:background="@drawable/ttlive_bg_pk_record_filter_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ttlive_interact_link_record_filter_random"
                android:layout_columnSpan="1"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#161823"
                android:gravity="center"
                android:layout_gravity="fill_horizontal"
                android:background="@drawable/ttlive_bg_pk_record_filter_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="8dp"
                android:text="@string/ttlive_interact_pk_record_filter_recommend"
                android:layout_columnSpan="1"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#161823"
                android:gravity="center"
                android:layout_gravity="fill_horizontal"
                android:background="@drawable/ttlive_bg_pk_record_filter_item"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ttlive_interact_link_record_filter_near"
                android:layout_columnSpan="1"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"/>
        </GridLayout>
        <View
            android:id="@+id/ban_outside"
            android:background="@color/black"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/ttlive_label_close"
            android:alpha="0.5"/>
    </LinearLayout>
</RelativeLayout>
