<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/ec_commerce_layout_author_reputation_2098291867"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_click_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="11dp"
            android:textColor="@color/color_80161823"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"/>
        <TextView
            android:textColor="@color/color_80161823"
            android:id="@+id/tv_no_score"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="@string/commerce_store_no_score"
            android:layout_marginStart="4dp"
            style="@style/font_size_20"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="italic|bold"
            android:textColor="@color/shopping_std_brand"
            android:gravity="bottom"
            android:id="@+id/tv_score_new"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/ll_stars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginBottom="2dp"
            android:layout_marginStart="4dp"/>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/color_80161823"
            android:gravity="bottom"
            android:id="@+id/tv_score"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="5.0"
            android:lineSpacingExtra="2dp"
            android:layout_marginStart="4dp"/>
        <TextView
            android:textSize="11dp"
            android:id="@+id/tv_level"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:lineSpacingExtra="2dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:layout_marginStart="4dp"/>
        <View
            android:id="@+id/arrow_right"
            android:background="@drawable/commerce_ic_reputation_gray_arrow_right"
            android:visibility="gone"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginLeft="4dp"
            android:layout_marginStart="4dp"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/divider_line_precent"
            android:background="@color/shopping_std_line_black_2"
            android:visibility="gone"
            android:layout_width="0.5dp"
            android:layout_height="9dp"
            android:layout_marginLeft="5dp"
            android:layout_marginBottom="4dp"
            android:layout_marginStart="5dp"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/shopping_std_text_black_3"
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/tv_sale_precent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginBottom="1dp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <View
        android:id="@+id/divider_line_sale"
        android:background="@color/color_33black"
        android:visibility="gone"
        android:layout_width="0.5dp"
        android:layout_height="10dp"
        android:layout_marginLeft="12dp"
        android:layout_marginStart="12dp"/>
    <TextView
        android:textColor="@color/color_80161823"
        android:id="@+id/tv_sales"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginStart="12dp"
        style="@style/font_size_22"/>
</LinearLayout>
