<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/ec_commerce_comment_item_appreciate_layout_2067961971"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/comment_appreciate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/comment_appreciate_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:src="@drawable/commerce_comment_appreciate_unchecked_icon"
            android:layout_marginEnd="5dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#80161823"
            android:ellipsize="end"
            android:id="@+id/appreciate_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/comment_not_appreciate"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginStart="16dp">
        <ImageView
            android:id="@+id/comment_not_appreciate_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:src="@drawable/commerce_comment_unchecked_untrust"
            android:layout_marginEnd="5dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#80161823"
            android:ellipsize="end"
            android:id="@+id/not_appreciate_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/commerce_anchor_v3_comment_unbelievable"/>
    </LinearLayout>
</LinearLayout>
