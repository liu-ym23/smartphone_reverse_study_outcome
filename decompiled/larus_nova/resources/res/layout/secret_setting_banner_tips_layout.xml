<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/secret_banner_container"
    android:background="@color/primary_fill_solid_01"
    android:paddingTop="12dp"
    android:paddingRight="11dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/secret_tips_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/secret_icon"
            android:background="@drawable/ud_icon_safe_filled"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="2.5dp"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_8"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/text_title"
            android:id="@+id/secret_banner_txt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/LarkCCM_Workspace_Security_SecurityStrategyReq_mob"
            android:layout_weight="1"/>
        <LinearLayout
            android:gravity="right"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/primary_pri_500"
                android:gravity="center"
                android:id="@+id/land_secret_set"
                android:background="@drawable/doc_template_tag_bg"
                android:paddingTop="@dimen/dp_4"
                android:paddingBottom="@dimen/dp_4"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/LarkCCM_Workspace_Security_Button_SelectSecureLevel_mob"
                android:paddingStart="@dimen/dp_8"
                android:paddingEnd="@dimen/dp_8"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginEnd="@dimen/dp_16"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/primary_fill_default"
                android:gravity="center"
                android:id="@+id/land_confirm_button"
                android:paddingTop="@dimen/dp_4"
                android:paddingBottom="@dimen/dp_4"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/LarkCCM_Workspace_AutoSecLevil_Recommend_Confirm"
                android:paddingStart="@dimen/dp_8"
                android:paddingEnd="@dimen/dp_8"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginEnd="@dimen/dp_16"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/primary_pri_500"
                android:gravity="center"
                android:id="@+id/land_see_detail"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/LarkCCM_Workspace_Security_Learnmore_mob"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/close_icon"
            android:paddingRight="1dp"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="@dimen/dp_8"
            android:layout_marginTop="2.5dp"
            android:layout_marginRight="@dimen/dp_8"
            android:tint="@color/ud_N800"
            app:layout_constraintLeft_toRightOf="@+id/risk_banner_txt"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ud_icon_close_outlined"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/click_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_below="@+id/secret_tips_layout"
        android:layout_marginStart="21dp">
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/primary_fill_default"
            android:gravity="center"
            android:id="@+id/secret_set"
            android:background="@drawable/doc_template_tag_bg"
            android:paddingTop="@dimen/dp_4"
            android:paddingBottom="@dimen/dp_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LarkCCM_Workspace_Security_Button_SelectSecureLevel_mob"
            android:paddingStart="@dimen/dp_8"
            android:paddingEnd="@dimen/dp_8"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/primary_fill_default"
            android:gravity="center"
            android:id="@+id/confirm_button"
            android:paddingTop="@dimen/dp_4"
            android:paddingBottom="@dimen/dp_4"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LarkCCM_Workspace_AutoSecLevil_Recommend_Confirm"
            android:paddingStart="@dimen/dp_8"
            android:paddingEnd="@dimen/dp_8"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/primary_fill_default"
            android:gravity="center"
            android:id="@+id/see_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/LarkCCM_Workspace_Security_Learnmore_mob"/>
    </LinearLayout>
</RelativeLayout>
