<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="166dp"
    android:layout_height="wrap_content">
    <com.bytedance.android.gamecp.common.ui.HSImageView
        android:id="@+id/hsiv_assess_image"
        android:layout_width="166dp"
        android:layout_height="92dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:placeholderImage="@drawable/shape_bg_08161823_conrner_4"
        app:roundedCornerRadius="4dp"/>
    <ImageView
        android:layout_width="166dp"
        android:layout_height="92dp"
        android:src="@drawable/gamecp_mask_game_assess_video"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:roundedCornerRadius="4dp"/>
    <com.bytedance.android.gamecp.common.ui.HSImageView
        android:id="@+id/hsiv_assess_avatar"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/hsiv_assess_image"
        app:layout_constraintStart_toStartOf="@+id/hsiv_assess_image"
        app:placeholderImage="@drawable/gamecp_game_promote_comment_default_avatar_bg"
        app:roundAsCircle="true"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="#bfffffff"
        android:ellipsize="end"
        android:id="@+id/tv_promoter_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/hsiv_assess_avatar"
        app:layout_constraintEnd_toStartOf="@+id/iv_like"
        app:layout_constraintStart_toEndOf="@+id/hsiv_assess_avatar"
        app:layout_constraintTop_toTopOf="@+id/hsiv_assess_avatar"/>
    <ImageView
        android:id="@+id/iv_like"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/gamecp_ic_game_promote_assess_like"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_like_count"
        app:layout_constraintEnd_toStartOf="@+id/tv_like_count"
        app:layout_constraintTop_toTopOf="@+id/tv_like_count"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#bfffffff"
        android:id="@+id/tv_like_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/hsiv_assess_image"
        app:layout_constraintEnd_toEndOf="@+id/hsiv_assess_image"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#161823"
        android:ellipsize="end"
        android:id="@+id/tv_assess_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:lines="2"
        app:layout_constraintTop_toBottomOf="@+id/hsiv_assess_image"/>
</androidx.constraintlayout.widget.ConstraintLayout>
