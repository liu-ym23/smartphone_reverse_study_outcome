<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ec_anchorv3_product_format_item_border"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/anchor_v3_brand_logo"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:roundedCornerRadius="16dp"
            app:roundingBorderColor="@color/shopping_color_F3F3F4"
            app:roundingBorderWidth="0.5dp"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/commerce_color_161823"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/anchor_v3_tv_product_format_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/anchor_v3_ll_qualification"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/anchor_v3_qualification_context"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/anchor_v3_brand_certificate"
                android:layout_width="14dp"
                android:layout_height="14dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/shopping_color_3EAEFF"
                android:layout_gravity="center_vertical"
                android:id="@+id/anchor_v3_brand_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/commerce_pay_color_gray_161823_opacity_45"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/anchor_v3_go_to_qualification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/commerce_anchor_v3_go_to_qualification"
            android:maxLines="1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="1dp"
            app:srcCompat="@drawable/commerce_anchor_v3_go_to_arrow"/>
    </LinearLayout>
</LinearLayout>
