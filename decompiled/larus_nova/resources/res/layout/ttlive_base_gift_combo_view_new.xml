<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.livesdk.gift.platform.business.dialog.v3.view.combo.ComboProgressAnimationView
        android:id="@+id/combo_progress"
        android:background="@color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="120dp"
        android:layout_height="130dp"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/combo_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.bytedance.android.livesdk.gift.platform.business.dialog.v3.view.combo.RoundWaveAnimationView
        android:id="@+id/combo_round_wave"
        android:layout_width="130dp"
        android:layout_height="130dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.gift.platform.business.dialog.v3.view.combo.ComboEffectAnimationView
        android:id="@+id/combo_effect"
        android:layout_width="130dp"
        android:layout_height="130dp"
        app:layout_constraintBottom_toTopOf="@+id/combo_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/combo_bg"/>
    <com.bytedance.android.livesdk.gift.platform.business.dialog.v3.view.combo.ComboIconAnimationView
        android:id="@+id/combo_icon_animation"
        android:layout_width="160dp"
        android:layout_height="160dp"
        app:layout_constraintBottom_toBottomOf="@+id/combo_bg"
        app:layout_constraintEnd_toEndOf="@+id/combo_bg"
        app:layout_constraintStart_toStartOf="@+id/combo_bg"
        app:layout_constraintTop_toTopOf="@+id/combo_bg"/>
    <View
        android:id="@+id/combo_bg"
        android:background="@drawable/ttlive_base_gift_combo_bg_new"
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#b3ffffff"
        android:id="@+id/combo_title_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ttlive_gift_long_click_title"
        app:layout_constraintEnd_toEndOf="@+id/combo_bg"
        app:layout_constraintStart_toStartOf="@+id/combo_bg"
        app:layout_constraintTop_toTopOf="@+id/combo_bg"/>
    <View
        android:id="@+id/combo_title_2"
        android:background="@drawable/ttlive_base_gift_combo_title_new2"
        android:layout_width="48dp"
        android:layout_height="24dp"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@+id/combo_bg"
        app:layout_constraintStart_toStartOf="@+id/combo_bg"
        app:layout_constraintTop_toBottomOf="@+id/combo_title_1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
