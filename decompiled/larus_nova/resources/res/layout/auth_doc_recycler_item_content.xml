<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_content"
    android:background="@drawable/auth_item_bg_selector"
    android:layout_width="match_parent"
    android:layout_height="68dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/item_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ud_icon_file_round_doc_colorful"
        android:layout_marginStart="16dp"
        app:civ_radius="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/item_name"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/ud_text_color"
        android:id="@+id/item_name"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:text="This is title"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/item_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_placeholder"
        android:ellipsize="end"
        android:id="@+id/creator_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Author:d"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="@+id/item_name"
        app:layout_constraintTop_toBottomOf="@+id/item_name"/>
    <TextView
        android:textColor="@color/text_caption"
        android:gravity="center"
        android:id="@+id/auth_dep_tx"
        android:background="@color/bg_body"
        android:layout_width="88dp"
        android:layout_height="match_parent"
        android:text="@string/CreationMobile_Docs_EmbeddedFiles_AccessDetails_Granted"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
