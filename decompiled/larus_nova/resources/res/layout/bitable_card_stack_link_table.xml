<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.bitable.infoarch.titlebar.BitableBaseTitleBar
        android:gravity="center_vertical"
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintTop_toTopOf="parent"
        app:widget_widgets_tb_background="@color/transparent"
        app:widget_widgets_tb_divider_visible="false"/>
    <com.bytedance.ee.bear.bitable.infoarch.toolbar.BitableToolbarContainer
        android:id="@+id/toolbarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.bytedance.ee.bear.bitable.infoarch.nativeview.BitableNativeViewContainer
        android:id="@+id/nativeViewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <View
        android:id="@+id/divider"
        android:background="@color/ud_divider_color"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/addRecordContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:tint="@color/icon_n1"
            app:srcCompat="@drawable/ud_icon_add_middle_outlined"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Bitable_LinkField_AddRecord_Button"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
</LinearLayout>
