<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_interact_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginTop="20dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/avatar_iv"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:placeholderImage="@drawable/ttlive_img_avatar_empty"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/iv_interact_status_tips"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:actualImageScaleType="fitXY"/>
        <View
            android:background="@drawable/ttlive_icon_interact_status_circle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp">
        <View
            android:background="#1a161823"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#161823"
            android:id="@+id/tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:text="@string/ttlive_chatroom_distribute_tips"
            android:layout_marginStart="16dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_link_distribute_more"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tips"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tips">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/ttlive_room_notice_dialog_disable_textcolor"
                android:id="@+id/tv_link_distribute_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_live_link_distribute_state_close"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_link_distribute_state"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/link_distribute_setting_more"
                android:layout_marginEnd="12dp"/>
        </LinearLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="#80161823"
            android:ellipsize="end"
            android:id="@+id/tv_tips"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="@string/ttlive_chatroom_distribute_tips_to_setting"
            android:maxLines="2"
            android:singleLine="false"
            app:layout_constraintBottom_toTopOf="@+id/bottom_divider"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tips"/>
        <Switch
            android:layout_gravity="end|center_vertical"
            android:id="@+id/switch_distribute_to_friend"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="16dp"
            android:checked="true"
            android:textOn=""
            android:textOff=""
            android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
            android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
            android:layout_marginEnd="16dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginRight="16dp"/>
        <View
            android:id="@+id/bottom_divider"
            android:background="#1a161823"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <Button
        android:textSize="15sp"
        android:textColor="@color/ttlive_white"
        android:id="@+id/tv_i_know"
        android:background="@drawable/ttlive_bg_common_comfirm"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="35dp"
        android:text="@string/ttlive_chatroom_distribute_tips_i_know"
        style="?android:attr/borderlessButtonStyle"/>
</LinearLayout>
