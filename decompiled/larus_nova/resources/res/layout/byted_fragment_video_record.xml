<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/id_preview_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <android.opengl.GLSurfaceView
            android:id="@+id/id_gl_sv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
    </FrameLayout>
    <View
        android:background="@color/byted_transparent_gray_80"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <include layout="@layout/byted_titlebar"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#99ffffff"
        android:gravity="center"
        android:id="@+id/tv_hint_top"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginBottom="12dp"
        android:text="@string/byted_read_text"
        android:layout_above="@+id/ll_scroll_read"
        android:layout_centerHorizontal="true"
        app:layout_constraintBottom_toTopOf="@+id/ll_scroll_read"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar"
        app:layout_constraintVertical_chainStyle="packed"/>
    <ScrollView
        android:id="@+id/ll_scroll_read"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@+id/rect_inside_bg_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_hint_top">
        <com.ss.android.bytedcert.view.ScrollTextView
            android:textSize="15sp"
            android:textColor="@color/byted_white"
            android:id="@+id/tv_scroll_read"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.1"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintBottom_toTopOf="@+id/rect_inside_bg_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </ScrollView>
    <com.ss.android.bytedcert.view.RectInsideBgView
        android:gravity="center_horizontal"
        android:id="@+id/rect_inside_bg_view"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_hint_bottom"
        app:layout_constraintDimensionRatio="h,255:320"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_scroll_read"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.73"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#99ffffff"
        android:gravity="center"
        android:id="@+id/tv_hint_bottom"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="20dp"
        android:text="@string/byted_video_hint_bottom"
        android:layout_centerHorizontal="true"
        app:layout_constraintBottom_toTopOf="@+id/bt_start_record"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rect_inside_bg_view"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#e5ffffff"
        android:gravity="center"
        android:id="@+id/tv_prompt"
        android:background="@drawable/byted_bg_gray_r16dp_top"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="2dp"
        android:layout_centerInParent="true"
        app:layout_constraintEnd_toEndOf="@+id/rect_inside_bg_view"
        app:layout_constraintStart_toStartOf="@+id/rect_inside_bg_view"
        app:layout_constraintTop_toTopOf="@+id/rect_inside_bg_view"
        app:layout_constraintWidth_percent="0.71"/>
    <TextView
        android:textSize="120sp"
        android:textColor="@color/byted_white"
        android:id="@+id/tv_count_down"
        android:background="@color/byted_transparent"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="3"
        android:layout_centerInParent="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Button
        android:textSize="15sp"
        android:textColor="@color/byted_white"
        android:id="@+id/bt_start_record"
        android:background="@drawable/byted_red_button_selector"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="20dp"
        android:text="@string/byted_start_record"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
