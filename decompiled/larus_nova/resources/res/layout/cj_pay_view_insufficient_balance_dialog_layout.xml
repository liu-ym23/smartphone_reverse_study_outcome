<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/cj_pay_bg_common_dialog_radius_8"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/insufficient_image"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/cj_pay_cry_face_icon"
        android:layout_centerHorizontal="true"/>
    <ImageView
        android:id="@+id/insufficient_close_image"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginLeft="244dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/cj_pay_icon_left_close"/>
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/cj_pay_color_black_161823"
        android:ellipsize="middle"
        android:gravity="center_horizontal"
        android:id="@+id/insufficient_text"
        android:layout_width="190dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:maxWidth="190dp"
        android:text="@string/cj_pay_insufficient_balance"
        android:maxLines="2"
        android:layout_below="@+id/insufficient_image"
        android:layout_centerHorizontal="true"/>
    <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/cj_pay_color_white"
        android:gravity="center"
        android:id="@+id/insufficient_choose_other_method_btn"
        android:background="@color/cj_pay_color_red_fe2c55"
        android:layout_width="240dp"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:text="@string/cj_pay_change_payment_method"
        android:layout_below="@+id/insufficient_text"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
