<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/larus_chat_common_shadow_bg"
    android:paddingTop="?attr/larus_dp_12"
    android:paddingBottom="?attr/larus_dp_10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="?attr/larus_dp_10"
    android:paddingEnd="?attr/larus_dp_10">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/larus_bg_office_task_device_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingTop="?attr/larus_dp_16"
            android:paddingBottom="?attr/larus_dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/larus_dp_96"
            android:paddingStart="?attr/larus_dp_16"
            android:paddingEnd="?attr/larus_dp_16">
            <TextView
                android:textSize="?attr/larus_dp_17"
                android:textColor="?attr/larus_neutral_100"
                android:id="@+id/office_task_device_switch_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:lineSpacingExtra="?attr/larus_dp_4"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="?attr/larus_dp_12"
                app:layout_constraintEnd_toStartOf="@+id/office_task_device_switch_close"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/office_task_device_switch_close"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="?attr/larus_dp_6"
                android:layout_width="?attr/larus_dp_28"
                android:layout_height="?attr/larus_dp_28"
                android:contentDescription="@string/larus_accessibility_icon_close"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="?attr/larus_ic_close_dialog"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:background="?attr/larus_neutral_transparent_2"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_0_5"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/office_task_device_switch_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    </LinearLayout>
</FrameLayout>
