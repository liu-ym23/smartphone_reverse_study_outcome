<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="?attr/larus_bg_suggested_action"
    android:paddingLeft="16dp"
    android:paddingTop="9dp"
    android:paddingRight="16dp"
    android:paddingBottom="9dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <View
        android:id="@+id/suggested_action_loading_dot1"
        android:background="@drawable/larus_bg_suggested_action_loading_dot"
        android:layout_width="6dp"
        android:layout_height="6dp"/>
    <View
        android:id="@+id/suggested_action_loading_dot2"
        android:background="@drawable/larus_bg_suggested_action_loading_dot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"/>
    <View
        android:id="@+id/suggested_action_loading_dot3"
        android:background="@drawable/larus_bg_suggested_action_loading_dot"
        android:layout_width="6dp"
        android:layout_height="6dp"/>
</LinearLayout>
