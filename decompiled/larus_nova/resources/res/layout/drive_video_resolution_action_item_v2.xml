<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/drive_video_resolution_action_item_rectangle_v2"
    android:layout_width="match_parent"
    android:layout_height="@dimen/space_kit_len_56">
    <TextView
        android:textSize="@dimen/space_kit_font_17"
        android:textColor="@color/text_title"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/ud_dialog_content_item_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/drive_video_resolution_action_check"
        android:visibility="gone"
        android:layout_width="@dimen/space_kit_len_18"
        android:layout_height="@dimen/space_kit_len_18"
        android:tint="@color/text_title"
        android:layout_marginEnd="@dimen/space_kit_len_8"
        app:layout_constraintBottom_toBottomOf="@+id/ud_dialog_content_item_tv"
        app:layout_constraintEnd_toStartOf="@+id/ud_dialog_content_item_tv"
        app:layout_constraintTop_toTopOf="@+id/ud_dialog_content_item_tv"
        app:srcCompat="@drawable/drive_video_checkmark"/>
</androidx.constraintlayout.widget.ConstraintLayout>
