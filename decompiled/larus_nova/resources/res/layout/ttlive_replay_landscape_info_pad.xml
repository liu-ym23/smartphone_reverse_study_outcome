<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:maxWidth="520dp">
        <ImageView
            android:id="@+id/vs_episode_back_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ttlive_vs_left_check_icon"
            android:scaleType="center"/>
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/vs_episode_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:singleLine="true"
            android:shadowColor="@color/ttlive_black_80"
            android:shadowRadius="5"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
    <View
        android:id="@+id/vs_episode_back_click"
        android:layout_width="90dp"
        android:layout_height="wrap_content"/>
</FrameLayout>
