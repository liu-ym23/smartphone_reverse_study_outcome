<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_interact_dialog"
    android:layout_width="match_parent"
    android:layout_height="395dp">
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:text="@string/ttlive_interact_audience_setting_title_new"/>
    <View
        android:background="#1a161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <View
        android:background="#14161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/payment_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/black"
            android:id="@+id/tv_payment_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:text="@string/ttlive_interact_audience_payment"
            android:layout_marginStart="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/payment_guide_dot"
            android:background="@drawable/ttlive_interact_audience_setting_guide_dot"
            android:visibility="gone"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="1dp"
            app:layout_constraintStart_toEndOf="@+id/tv_payment_text"
            app:layout_constraintTop_toTopOf="@+id/tv_payment_text"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/payment_option"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="14dp"
                android:textColor="#80161823"
                android:layout_gravity="end|center_vertical"
                android:id="@+id/payment_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_label_close"
                android:layout_marginEnd="2dp"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginRight="16dp"
                android:src="@drawable/ttlive_interact_ic_pk_time_setting_arrow"
                android:layout_marginEnd="16dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/no_apply"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/black"
            android:layout_gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:text="@string/ttlive_interact_video_talk_no_apply"
            android:layout_marginStart="20dp"/>
        <Switch
            android:layout_gravity="end|center_vertical"
            android:id="@+id/switch_need_verify"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginRight="16dp"
            android:checked="true"
            android:textOn=""
            android:textOff=""
            android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
            android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
            android:layout_marginEnd="16dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/no_fans"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/black"
            android:layout_gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:text="@string/ttlive_interact_video_talk_no_fans"
            android:layout_marginStart="20dp"/>
        <Switch
            android:layout_gravity="end|center_vertical"
            android:id="@+id/switch_only_accept_follower"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginRight="16dp"
            android:checked="true"
            android:textOn=""
            android:textOff=""
            android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
            android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
            android:layout_marginEnd="16dp"/>
    </FrameLayout>
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/allow_send_gift"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/black"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/allow_send_gift_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:text="@string/ttlive_interact_video_talk_allow_send_gift"
            android:layout_marginStart="20dp"/>
        <ImageView
            android:id="@+id/allow_send_gift_rule_img"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:src="@drawable/ttlive_guest_send_gift_rule"
            android:layout_toRightOf="@+id/allow_send_gift_tv"
            android:layout_marginStart="4dp"
            android:layout_toEndOf="@+id/allow_send_gift_tv"/>
        <Switch
            android:id="@+id/switch_send_gift"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginRight="16dp"
            android:checked="true"
            android:textOn=""
            android:textOff=""
            android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
            android:layout_alignParentRight="true"
            android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/no_invite"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/black"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:text="@string/ttlive_interact_audience_setting_only_invite"
            android:layout_marginStart="20dp"/>
        <Switch
            android:layout_gravity="end|center_vertical"
            android:id="@+id/switch_need_invite"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginRight="16dp"
            android:checked="true"
            android:textOn=""
            android:textOff=""
            android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
            android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
            android:layout_marginEnd="16dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/support_admin_operate_v2"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/black"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/admin_operation_text_v2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:text="@string/ttlive_interact_support_admin_operate"
            android:layout_marginStart="20dp"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginRight="16dp"
            android:src="@drawable/ttlive_interact_ic_pk_time_setting_arrow"
            android:layout_marginEnd="16dp"/>
    </FrameLayout>
</LinearLayout>
