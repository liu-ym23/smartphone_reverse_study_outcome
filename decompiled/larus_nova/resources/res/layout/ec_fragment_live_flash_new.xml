<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.livecommerce.view.ECAutoHideKeyboardLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ec_shape_promotion_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.ui.ec.widget.titlebar.ECTitleBar
            android:id="@+id/ec_flash_title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ec_page_title_height"
            app:leftIconRes="@drawable/ec_dux_ic_s_s_xmark_outlined"
            app:rightText="@string/ec_live_flash_explain"
            app:rightTextColor="@color/shopping_color_A6161823"
            app:rightTextSize="15dp"
            app:showLeftIcon="true"
            app:showRightText="true"
            app:title="@string/ec_live_add_flash_promotion"/>
        <FrameLayout
            android:id="@+id/layout_create_flash"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:layout_alignParentBottom="true">
            <com.bytedance.android.ui.ec.widget.button.ECButton
                android:id="@+id/btn_create_flash"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="7dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="12dp"
                android:text="@string/ec_live_flash_button"
                app:always_clickable="true"
                app:bg_cornerRadius="100dp"
                style="@style/ECButton.Rectangle.Primary.Large"/>
        </FrameLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_flash_list"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/layout_create_flash"
            android:layout_below="@+id/ec_flash_title"/>
        <View
            android:background="@color/ec_color_08_161823"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginBottom="0.5dp"
            android:layout_alignBottom="@+id/rv_flash_list"/>
    </RelativeLayout>
</com.bytedance.android.livesdk.livecommerce.view.ECAutoHideKeyboardLayout>
