<?xml version="1.0" encoding="utf-8"?>
<com.larus.common_ui.widget.roundlayout.RoundRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:rv_backgroundColor="@color/larus_base_2_overlay"
    app:rv_cornerRadius="@dimen/dp_16">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/title_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_40">
        <ImageView
            android:gravity="center"
            android:id="@+id/app_icon"
            android:background="@drawable/obric_bg_round_4"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:scaleType="fitCenter"
            android:layout_marginStart="@dimen/dp_16"/>
        <TextView
            android:textSize="@dimen/dp_12"
            android:textColor="@color/neutral_50"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/app_name"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/dp_6"/>
    </LinearLayout>
    <View
        android:id="@+id/divider"
        android:background="@color/neutral_transparent_1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0_5"
        android:layout_below="@+id/title_container"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_container"
        android:paddingLeft="@dimen/dp_16"
        android:paddingTop="@dimen/dp_12"
        android:paddingRight="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/divider">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/avatar"
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:layout_marginTop="@dimen/dp_4"
            app:actualImageScaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundAsCircle="true"/>
        <TextView
            android:textSize="@dimen/dp_16"
            android:textColor="@color/neutral_100"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="@+id/avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/avatar"
            app:layout_constraintTop_toTopOf="@+id/avatar"/>
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/neutral_70"
            android:ellipsize="end"
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:maxLines="3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/avatar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginRight="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_16"
        android:layout_below="@+id/content_container">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/oui_basic_text_1"
            android:gravity="center"
            android:id="@+id/btn_send"
            android:background="@drawable/obric_card_btn_lark_action_bg"
            android:paddingTop="@dimen/dp_11"
            android:paddingBottom="@dimen/dp_11"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/obric_msg_send"
            android:fontFamily="sans-serif"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/neutral_70"
            android:gravity="center"
            android:id="@+id/tv_status"
            android:background="@drawable/obric_card_item_lark_status_bg"
            android:paddingTop="@dimen/dp_10"
            android:paddingBottom="@dimen/dp_10"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.5"
            android:fontFamily="sans-serif"/>
    </FrameLayout>
    <Space
        android:id="@+id/bottom_padding"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_16"
        android:layout_below="@+id/content_container"/>
</com.larus.common_ui.widget.roundlayout.RoundRelativeLayout>
