<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/auto_location_container"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/auto_location_state_getting"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/space_kit_len_22">
            <com.bytedance.ee.bear.bitable.card.view.cell.location.view.LoadingView
                android:id="@+id/auto_location_state_getting_icon"
                android:layout_width="@dimen/space_kit_len_18"
                android:layout_height="@dimen/space_kit_len_18"
                android:layout_marginEnd="@dimen/space_kit_len_4"
                app:centerRadius="4.5dp"
                app:loadingColor="@color/primary_fill_default"
                app:strokeWidth="1.5dp"/>
            <TextView
                android:textSize="@dimen/space_kit_font_16"
                android:textColor="@color/text_title"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Bitable_Field_GettingLocation"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:gravity="top"
        android:orientation="horizontal"
        android:id="@+id/location_des_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.bytedance.ee.bear.bitable.card.view.cell.text.BitableAtEditText
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_title"
            android:layout_gravity="center"
            android:id="@+id/location_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
</FrameLayout>
