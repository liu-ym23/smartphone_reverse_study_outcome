<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <FrameLayout
        android:id="@+id/audio_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:tabGravity="fill"
            app:tabIndicator="@drawable/ttlive_apply_top_tab_indicator"
            app:tabIndicatorColor="@color/ttlive_black"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="2dp"
            app:tabSelectedTextColor="@color/ttlive_black"
            app:tabTextAppearance="@style/InteractTextStyle"
            app:tabTextColor="#4c000000"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="right"
            android:orientation="horizontal"
            android:id="@+id/anchor_operation_container"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingEnd="8dp">
            <ImageView
                android:id="@+id/img_search"
                android:padding="4dp"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginRight="12dp"
                android:src="@drawable/ttlive_search_icon"
                android:layout_marginEnd="12dp"/>
            <FrameLayout
                android:id="@+id/legacy_set_button"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginRight="12dp"
                android:layout_marginEnd="12dp">
                <View
                    android:layout_gravity="center"
                    android:background="@drawable/ttlive_icon_apply_setting"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <View
                    android:layout_gravity="end|top"
                    android:id="@+id/setting_guide_dot"
                    android:background="@drawable/ttlive_interact_audience_setting_guide_dot"
                    android:visibility="gone"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginRight="2dp"
                    android:layout_marginEnd="2dp"/>
            </FrameLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/set"
                android:background="@drawable/ttlive_bg_text_color"
                android:padding="6dp"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginRight="12dp"
                android:layout_marginEnd="12dp">
                <ImageView
                    android:id="@+id/top_bar_setting_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginRight="4dp"
                    android:src="@drawable/ttlive_icon_new_live_settings"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toLeftOf="@+id/holder"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#cc161823"
                    android:gravity="end"
                    android:id="@+id/holder"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#cc161823"
                    android:gravity="end"
                    android:id="@+id/top_bar_setting_text1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:alpha="0"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/top_bar_setting_icon"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#cc161823"
                    android:gravity="end"
                    android:id="@+id/top_bar_setting_text2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:alpha="0"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/top_bar_setting_icon"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:layout_gravity="center"
                android:id="@+id/close"
                android:background="@drawable/ttlive_icon_apply_close"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginRight="12dp"
                android:layout_marginEnd="12dp"/>
            <View
                android:id="@+id/set_line"
                android:background="#161823"
                android:visibility="gone"
                android:layout_width="1px"
                android:layout_height="11dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#88000000"
                android:gravity="center"
                android:id="@+id/edit"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/ttlive_interact_edit_position"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:id="@+id/admin_operation_container"
            android:layout_width="wrap_content"
            android:layout_height="56dp">
            <FrameLayout
                android:id="@+id/admin_set_button"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginRight="12dp"
                android:layout_marginEnd="12dp">
                <View
                    android:layout_gravity="center"
                    android:background="@drawable/ttlive_icon_apply_setting"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <View
                    android:layout_gravity="end|top"
                    android:id="@+id/admin_setting_guide_dot"
                    android:background="@drawable/ttlive_interact_audience_setting_guide_dot"
                    android:visibility="gone"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginRight="2dp"
                    android:layout_marginEnd="2dp"/>
            </FrameLayout>
            <ImageView
                android:id="@+id/img_search_admin"
                android:padding="5dp"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginRight="10dp"
                android:src="@drawable/ttlive_search_icon"
                android:layout_marginEnd="10dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#88000000"
                android:gravity="center"
                android:id="@+id/admin_operation"
                android:paddingRight="16dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/ttlive_video_talk_room_audio_apply"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#88000000"
                android:gravity="center"
                android:layout_gravity="end"
                android:id="@+id/not_anchor_update_position"
                android:paddingRight="16dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/ttlive_interact_update_position"
                android:paddingEnd="16dp"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
