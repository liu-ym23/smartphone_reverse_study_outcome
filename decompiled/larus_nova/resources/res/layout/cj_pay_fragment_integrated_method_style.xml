<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/cj_pay_payment_method_root_view"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cj_pay_height_470">
    <include layout="@layout/cj_pay_view_integrated_titlebar_layout"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.android.ttcjpaysdk.base.ui.widget.ExtendRecyclerView
            android:id="@+id/cj_pay_payment_method_recycler_view"
            android:background="@color/cj_pay_color_trans"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
        <com.android.ttcjpaysdk.base.ui.widget.CJPayTextLoadingView
            android:id="@+id/cj_pay_loading_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
