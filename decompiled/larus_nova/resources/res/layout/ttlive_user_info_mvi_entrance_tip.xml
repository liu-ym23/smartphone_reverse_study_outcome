<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="right"
    android:id="@+id/content_view"
    android:background="@drawable/ttlive_user_info_tip_background"
    android:layout_width="120dp"
    android:layout_height="36dp">
    <TextView
        android:textSize="9dp"
        android:textColor="@color/ttlive_live_fans_club_join_incentives_tip_color"
        android:id="@+id/text_line1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.8"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toTopOf="@+id/text_line2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_live_fans_club_join_incentives_coin_color"
        android:id="@+id/text_line2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/text_line1"
        app:layout_constraintStart_toStartOf="@+id/text_line1"
        app:layout_constraintTop_toBottomOf="@+id/text_line1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
