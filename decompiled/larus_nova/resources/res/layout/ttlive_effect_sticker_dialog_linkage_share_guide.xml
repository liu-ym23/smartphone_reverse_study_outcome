<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/linkage_share_guide_panel_beyond_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/cl_linkage_share_guide_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/cl_linkage_share_guide_panel"
        android:background="@drawable/ttlive_effect_bg_linkage_share_sticker_guide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linkage_share_guide_panel_beyond_view">
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:text="共享特效功能说明"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#80161823"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="24dp"
            android:text="功能开启时，你使用中的特效，会在连线对象的「特效面板」显示“在用”标签，方便多人连线时对方使用同款特效。对方开启时，特效在用状态也会显示到你的面板。"
            android:lineSpacingMultiplier="1.2"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp">
            <ImageView
                android:id="@+id/iv_linkage_share_guide_1"
                android:layout_width="84dp"
                android:layout_height="94dp"
                app:layout_constraintEnd_toStartOf="@+id/iv_linkage_share_guide_2"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/iv_linkage_share_guide_2"
                android:layout_width="60dp"
                android:layout_height="30dp"
                android:layout_marginLeft="19dp"
                android:layout_marginRight="19dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_linkage_share_guide_1"
                app:layout_constraintEnd_toStartOf="@+id/iv_linkage_share_guide_3"
                app:layout_constraintStart_toEndOf="@+id/iv_linkage_share_guide_1"
                app:layout_constraintTop_toTopOf="@+id/iv_linkage_share_guide_1"/>
            <ImageView
                android:id="@+id/iv_linkage_share_guide_3"
                android:layout_width="84dp"
                android:layout_height="94dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_linkage_share_guide_1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_linkage_share_guide_2"
                app:layout_constraintTop_toTopOf="@+id/iv_linkage_share_guide_1"/>
            <TextView
                android:textSize="11dp"
                android:textColor="#80161823"
                android:gravity="center_horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="我使用的特效"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/iv_linkage_share_guide_1"
                app:layout_constraintStart_toStartOf="@+id/iv_linkage_share_guide_1"
                app:layout_constraintTop_toBottomOf="@+id/iv_linkage_share_guide_1"/>
            <TextView
                android:textSize="11dp"
                android:textColor="#80161823"
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="连线对象面板显示在用状态"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/iv_linkage_share_guide_3"
                app:layout_constraintStart_toStartOf="@+id/iv_linkage_share_guide_3"
                app:layout_constraintTop_toBottomOf="@+id/iv_linkage_share_guide_3"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/btn_switch_linkage_share_status"
            android:background="@drawable/ttlive_effect_bg_linkage_share_guide_switch_button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="36dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="36dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
