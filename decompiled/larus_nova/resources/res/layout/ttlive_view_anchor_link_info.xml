<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="20dp">
    <RelativeLayout
        android:id="@+id/rl_anchor_link_info"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <com.bytedance.android.livesdk.widget.VHeadView
            android:id="@+id/iv_anchor_link_info_3"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="-2dp"
            android:layout_toRightOf="@+id/iv_anchor_link_info_2"
            android:layout_centerVertical="true"
            app:placeholderImage="@drawable/ttlive_ic_default_head_small"
            app:retryImageScaleType="fitXY"
            app:roundAsCircle="true"/>
        <View
            android:background="@drawable/ttlive_bg_anchor_link_linked_user_gap"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="-2dp"
            android:layout_toLeftOf="@+id/iv_anchor_link_info_3"
            android:layout_centerVertical="true"/>
        <com.bytedance.android.livesdk.widget.VHeadView
            android:id="@+id/iv_anchor_link_info_2"
            android:visibility="gone"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="-2dp"
            android:layout_toRightOf="@+id/iv_anchor_link_info_1"
            android:layout_centerVertical="true"
            app:placeholderImage="@drawable/ttlive_ic_default_head_small"
            app:retryImageScaleType="fitXY"
            app:roundAsCircle="true"/>
        <View
            android:background="@drawable/ttlive_bg_anchor_link_linked_user_gap"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="-2dp"
            android:layout_toLeftOf="@+id/iv_anchor_link_info_2"
            android:layout_centerVertical="true"/>
        <com.bytedance.android.livesdk.widget.VHeadView
            android:id="@+id/iv_anchor_link_info_1"
            android:background="@drawable/ttlive_bg_anchor_link_linked_user_gap"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_centerVertical="true"
            app:placeholderImage="@drawable/ttlive_ic_default_head_small"
            app:retryImageScaleType="fitXY"
            app:roundAsCircle="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/ttlive_interact_default_text_color"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_anchor_link_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"/>
</merge>
