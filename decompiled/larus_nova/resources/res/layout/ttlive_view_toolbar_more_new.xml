<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="38dp"
    android:layout_height="38dp"
    android:layout_marginLeft="8dp"
    android:layout_marginStart="8dp">
    <com.facebook.drawee.view.SimpleDraweeView xmlns:fresco="http://schemas.android.com/apk/res-auto"
        android:id="@+id/more_toolbar_icon_animation"
        android:visibility="gone"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:scaleType="center"
        fresco:actualImageScaleType="center"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/more_toolbar_icon"
        android:background="@drawable/ttlive_ic_more_new"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/more_replace_view"
        android:background="@drawable/ttlive_selector_share_toolbar_38"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.livesdk.chatroom.ui.RedDotView
        android:id="@+id/view_red_dot"
        android:background="@drawable/ttlive_ic_filter_red_point"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="2dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="2dp"
        android:layout_alignParentEnd="true"/>
    <ImageView
        android:id="@+id/view_entrance_mark"
        android:background="@drawable/ttlive_more_icon_corner_mark"
        android:visibility="invisible"
        android:clipChildren="false"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="-6dp"
        android:layout_marginRight="-6dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="-6dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
