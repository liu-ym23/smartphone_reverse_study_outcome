<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.live.liveinteract.voicechat.wm.RoundRectLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:leftTopRound="18dp"
    app:rightTopRound="18dp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/iv_des"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="w,1:2"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="14dp"
            android:textColor="#bf161823"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:text="@string/ttlive_audio_hamlet_guide_dialog_title"
            android:maxLines="1"
            android:lines="1"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#bf161823"
            android:gravity="center"
            android:id="@+id/des"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="20dp"
            android:text="@string/ttlive_audio_hamlet_guide_dialog_des"
            android:maxLines="1"
            android:lines="1"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/comfirm"
            android:background="@drawable/ttlive_bg_hamlet_avatar_guide_confirm"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_margin="16dp"
            android:text="我知道了"/>
    </LinearLayout>
</com.bytedance.android.live.liveinteract.voicechat.wm.RoundRectLayout>
