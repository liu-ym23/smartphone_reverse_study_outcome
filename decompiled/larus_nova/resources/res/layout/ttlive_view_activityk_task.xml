<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/red_envelope_content"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/bg_activityk_preview"
        android:background="@drawable/ttlive_activityk_preview"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="36dp"/>
    <FrameLayout
        android:id="@+id/activityk_content"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="6dp">
        <RelativeLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/layout_activityk_count_down"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/bg_red_envelope_banner"
                android:background="@drawable/ttlive_view_activityk_count_donw"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="8sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/tv_activityk_count_down"
                android:background="@drawable/ttlive_bg_activityk_count_down"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="10dp"
                android:includeFontPadding="false"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/layout_activityk_go"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="@drawable/ttlive_activityk_rush"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="8dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:background="@drawable/ttlive_bg_activityk_count_down"
                android:layout_width="32dp"
                android:layout_height="10dp"
                android:text="@string/ttlive_activity_go"
                android:includeFontPadding="false"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </FrameLayout>
</FrameLayout>
