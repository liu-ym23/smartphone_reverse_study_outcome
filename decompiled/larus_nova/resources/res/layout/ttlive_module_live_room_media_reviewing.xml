<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trial_broadcast_whole"
    android:background="@drawable/ttlive_bg_live_media_reviewing"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:layout_marginLeft="12dp"
    android:paddingStart="12dp"
    android:paddingEnd="20dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp">
    <ImageView
        android:id="@+id/live_media_review_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ttlive_media_reviewing"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/white"
        android:id="@+id/live_media_review_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:text="@string/ttlive_media_reviewing"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/live_media_review_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#b3ffffff"
        android:ellipsize="marquee"
        android:id="@+id/live_media_review_sub_title"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/ttlive_media_review_take_time"
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/live_media_review_icon"/>
    <Button
        android:textSize="13dp"
        android:textColor="@color/white"
        android:id="@+id/live_media_reviewing_start_live"
        android:background="@drawable/ttlive_bg_live_media_reviewing_start_live"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginTop="21dp"
        android:layout_marginBottom="21dp"
        android:text="@string/ttlive_media_review_start_live"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
