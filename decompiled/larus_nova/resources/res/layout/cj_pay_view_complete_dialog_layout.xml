<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/cj_pay_payment_complete_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/cj_pay_view_payment_complete_dialog_root_view"
            android:background="@drawable/cj_pay_bg_common_dialog"
            android:layout_width="@dimen/cj_pay_height_280"
            android:layout_height="@dimen/cj_pay_height_64">
            <ProgressBar
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_dialog_loading_view"
                android:background="@color/cj_pay_color_trans"
                android:layout_width="@dimen/cj_pay_height_24"
                android:layout_height="@dimen/cj_pay_height_24"
                android:layout_marginLeft="@dimen/cj_pay_padding_31"
                android:indeterminateOnly="true"
                android:indeterminateDrawable="@drawable/cj_pay_bg_loading_circle"
                android:indeterminateDuration="500"
                android:indeterminateBehavior="repeat"/>
            <TextView
                android:textSize="@dimen/cj_pay_font_size_17"
                android:textColor="@color/cj_pay_color_black_34"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/cj_pay_padding_8"
                android:text="@string/cj_pay_bdpay_wait_result_in_querying"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
