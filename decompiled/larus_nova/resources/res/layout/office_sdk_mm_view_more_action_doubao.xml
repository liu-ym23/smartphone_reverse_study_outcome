<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="@dimen/office_sdk_mm_half_screen_dialog_padding_bottom_doubao"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.ss.android.lark.officesdk.minutes.ui.foundation.widget.titlebar.MmTitleBarView2
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tbv2_sub_title_text="@string/LarkCCM_DoubaoVC_AudioTranscribe_Desc"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mmFeedbackLayout"
        android:layout_width="80dp"
        android:layout_height="100dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="8dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/feedbackIcon"
            android:padding="10dp"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:tint="@color/flow_ud_neutral_70"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/office_sdk_mm_ic_feedback_doubao"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/flow_ud_neutral_100"
            android:id="@+id/feedbackText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/LarkCCM_DoubaoVC_IssueFeedback_Button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/feedbackIcon"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
