<?xml version="1.0" encoding="utf-8"?>
<com.larus.bmhome.chat.layout.widget.RelativeLayoutWithLastMotion xmlns:android="http://schemas.android.com/apk/res/android" xmlns:fresco="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/larus_video_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/cover_image_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.larus.bmhome.view.OSurfaceView
            android:id="@+id/video_surface"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/cover_image"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            fresco:actualImageScaleType="centerCrop"
            fresco:roundBottomLeft="true"
            fresco:roundBottomRight="true"
            fresco:roundTopLeft="true"
            fresco:roundTopRight="true"
            fresco:roundedCornerRadius="?attr/larus_dp_18"/>
        <ImageView
            android:id="@+id/play_image"
            android:layout_width="?attr/larus_dp_40"
            android:layout_height="?attr/larus_dp_40"
            android:src="@drawable/larus_tiktok_video_play"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/quietly_play_image"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_24"
        android:layout_height="?attr/larus_dp_24"
        android:layout_marginBottom="?attr/larus_dp_12"
        android:src="@drawable/larus_quietly_play_img"
        android:layout_alignBottom="@+id/cover_image_container"
        android:layout_marginStart="?attr/larus_dp_12"/>
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/title_view"
        android:background="?attr/larus_video_title_bg"
        android:paddingTop="?attr/larus_dp_12"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_44"
        android:paddingStart="?attr/larus_dp_12"
        android:paddingEnd="?attr/larus_dp_12">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/app_from_icon"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:scaleType="fitXY"
            android:layout_marginStart="?attr/larus_dp_4"
            fresco:backgroundImage="@drawable/larus_icon_tiktok_img"/>
        <TextView
            android:textSize="?attr/larus_dp_13"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:layout_gravity="center_vertical"
            android:id="@+id/video_source_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/larus_attach_video_use_oin"
            android:layout_marginStart="?attr/larus_dp_6"
            android:layout_toEndOf="@+id/app_from_icon"/>
        <ImageView
            android:id="@+id/more_app"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_16"
            android:layout_height="?attr/larus_dp_16"
            android:src="@drawable/larus_more_info_img"
            android:layout_marginStart="?attr/larus_dp_6"
            android:layout_toEndOf="@+id/video_source_title"/>
    </RelativeLayout>
</com.larus.bmhome.chat.layout.widget.RelativeLayoutWithLastMotion>
