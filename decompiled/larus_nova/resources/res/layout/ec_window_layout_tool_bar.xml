<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.window.shop.widget.ToolBarView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/window_tool_bar"
    android:tag="ec_window_tool_bar"
    android:background="@color/commerce_color_FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="36dp">
    <com.bytedance.android.window.shop.widget.SortBarView
        android:id="@+id/window_sort_bar"
        android:tag="anchor_window_sort_bar"
        android:paddingLeft="4dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/window_layout_control_area"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintRight_toRightOf="parent">
        <View
            android:id="@+id/window_layout_control_split_line"
            android:background="@color/ec_shop_1a161823"
            android:layout_width="0.5dp"
            android:layout_height="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/window_type_filter_area"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="9dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/window_layout_control_split_line"
            app:layout_constraintRight_toLeftOf="@+id/window_layout_control_icon"
            app:layout_constraintTop_toTopOf="parent">
            <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
                android:id="@+id/window_filter_type_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                app:placeholderImage="@drawable/ec_window_arrow_not_selected"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/ec_shop_80161823"
                android:id="@+id/window_filter_type_name"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginLeft="2dp"
                android:layout_marginTop="1dp"/>
        </LinearLayout>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/window_layout_control_icon"
            android:tag="anchor_window_switch_layout_type"
            android:paddingLeft="10.5dp"
            android:paddingTop="11dp"
            android:paddingRight="10.5dp"
            android:paddingBottom="10dp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="@drawable/ec_window_double_column_layout_ic"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.bytedance.android.window.shop.widget.ToolBarView>
