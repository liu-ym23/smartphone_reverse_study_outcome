<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.shopping.anchorv4.widgets.TopRoundFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/anchor_v4_list_container"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/anchor_v4_drag_container_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/anchor_v4_playback_container_bottom"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="70dp"/>
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:layout_gravity="bottom|right"
        android:id="@+id/back_to_top_btn"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="127dp"
        android:layout_marginEnd="13dp"
        app:actualImageScaleType="fitXY"
        app:placeholderImage="@drawable/commerce_anchor_v4_back_to_top_btn"
        app:placeholderImageScaleType="fitXY"/>
    <com.bytedance.android.shopping.anchorv4.voavhs.base.components.LongContentLabelComponentView
        android:layout_gravity="bottom|right"
        android:id="@+id/shop_float_entry"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="332dp"/>
    <FrameLayout
        android:layout_gravity="bottom|right"
        android:id="@+id/questionnaire_entrance"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="112dp"/>
    <FrameLayout
        android:id="@+id/anchor_v4_frame_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/anchor_v4_frame_ll"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.android.shopping.anchorv4.voavhs.head.base.LengthenedCompatDraweeView
                android:id="@+id/anchor_v4_frame_image"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:fadeDuration="0"/>
            <com.bytedance.android.shopping.anchorv4.widgets.WireFrameViewV2
                android:id="@+id/anchor_v4_frame_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
        <ViewStub
            android:id="@+id/anchor_v4_error_view_stub"
            android:visibility="gone"
            android:layout="@layout/ec_common_layout_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ViewStub
            android:id="@+id/anchor_v4_error_view_stub_v2"
            android:visibility="gone"
            android:layout="@layout/ec_pdp_network_error_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ImageView
            android:id="@+id/anchor_v4_frame_close"
            android:padding="5dp"
            android:visibility="gone"
            android:layout_width="@dimen/commerce_anchor_v3_top_tab_height"
            android:layout_height="@dimen/commerce_anchor_v3_top_tab_height"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="36dp"
            android:src="@drawable/ec_commerce_anchor_v4_back_arrow_shadow"
            android:contentDescription="@string/shopping_return"
            android:layout_marginStart="8dp"/>
        <FrameLayout
            android:id="@+id/anchor_v4_frame_close_applet"
            android:visibility="gone"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="30dp"/>
    </FrameLayout>
</com.bytedance.android.shopping.anchorv4.widgets.TopRoundFrameLayout>
