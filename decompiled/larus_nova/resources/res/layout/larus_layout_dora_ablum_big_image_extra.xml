<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/big_image_extra_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_44">
        <ImageView
            android:id="@+id/back"
            android:layout_width="?attr/larus_dp_38"
            android:layout_height="?attr/larus_dp_38"
            android:src="@drawable/larus_bg_big_close_page"
            android:contentDescription="@string/larus_accessibility_icon_close"
            android:layout_marginStart="?attr/larus_dp_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/image_item_poi_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="?attr/larus_sp_15"
                android:textColor="@color/larus_static_white"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/image_item_poi"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="?attr/larus_sp_12"
                android:textColor="@color/larus_static_white"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/image_item_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|top"
            android:id="@+id/more"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/larus_common_slide_more"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:layout_gravity="start|bottom"
        android:id="@+id/like"
        android:background="@drawable/larus_bg_big_image_icon"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_38"
        android:layout_height="?attr/larus_dp_38"
        android:layout_marginBottom="?attr/larus_dp_46"
        android:src="@drawable/larus_ic_like_white"
        android:layout_marginStart="?attr/larus_dp_16"/>
    <ImageView
        android:layout_gravity="start|bottom"
        android:id="@+id/dislike"
        android:background="@drawable/larus_bg_big_image_icon"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_38"
        android:layout_height="?attr/larus_dp_38"
        android:layout_marginBottom="?attr/larus_dp_46"
        android:src="@drawable/larus_ic_dislike_white"
        android:layout_marginStart="?attr/larus_dp_68"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="start|bottom"
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_12">
        <LinearLayout
            android:id="@+id/iv_container"
            android:paddingTop="?attr/larus_dp_14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:id="@+id/iv_ai_beautify"
                android:background="@drawable/larus_bg_big_image_icon"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_44"
                android:src="@drawable/larus_ic_ai_beautify_white"
                android:layout_marginEnd="?attr/larus_dp_8"/>
            <com.larus.bmhome.bigimg.download.CommonDownLoadLayout
                android:id="@+id/download_layout"
                android:background="@drawable/larus_bg_big_image_icon"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_44"
                android:contentDescription="@string/larus_accessibility_save"
                android:layout_marginEnd="?attr/larus_dp_8"
                app:larus_showText="false"/>
            <ImageView
                android:id="@+id/share"
                android:background="@drawable/larus_bg_big_image_icon"
                android:layout_width="?attr/larus_dp_44"
                android:layout_height="?attr/larus_dp_44"
                android:src="@drawable/larus_ic_share_white_filled"
                android:scaleType="center"
                android:contentDescription="@string/larus_accessibility_icon_share"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
