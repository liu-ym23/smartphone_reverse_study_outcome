<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="78dp">
    <com.bytedance.android.live.ktv.common.view.LiveOnlineAvatarView
        android:id="@+id/ktv_group_user_avatar"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="13dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="13dp"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#161823"
        android:ellipsize="end"
        android:id="@+id/ktv_group_user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lines="1"
        android:maxEms="12"
        android:layout_toRightOf="@+id/ktv_group_user_avatar"
        android:layout_alignTop="@+id/ktv_group_user_avatar"
        android:layout_toEndOf="@+id/ktv_group_user_avatar"/>
    <TextView
        android:textSize="13dp"
        android:textColor="#70161823"
        android:ellipsize="end"
        android:id="@+id/ktv_group_user_descrip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lines="1"
        android:maxEms="12"
        android:layout_below="@+id/ktv_group_user_name"
        android:layout_alignLeft="@+id/ktv_group_user_name"
        android:layout_alignStart="@+id/ktv_group_user_name"/>
</RelativeLayout>
