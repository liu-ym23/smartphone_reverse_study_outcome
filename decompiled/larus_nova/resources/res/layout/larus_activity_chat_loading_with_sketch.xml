<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            android:layout_marginTop="?attr/larus_dp_8"
            android:src="@drawable/larus_ic_left_back"
            android:layout_marginStart="?attr/larus_dp_8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/larus_neutral_100"/>
        <com.larus.common_ui.widget.CircleSimpleDraweeView
            android:id="@+id/loading_sketch_title_avatar"
            android:layout_width="?attr/larus_dp_36"
            android:layout_height="?attr/larus_dp_36"
            android:layout_marginStart="?attr/larus_dp_4"
            app:layout_constraintBottom_toBottomOf="@+id/btn_close"
            app:layout_constraintStart_toEndOf="@+id/btn_close"
            app:layout_constraintTop_toTopOf="@+id/btn_close"
            app:placeholderImage="@color/larus_base_2_overlay"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/loading_sketch_title"
            android:layout_width="?attr/larus_dp_72"
            android:layout_height="?attr/larus_dp_22"
            android:layout_marginStart="?attr/larus_dp_8"
            app:layout_constraintBottom_toBottomOf="@+id/btn_close"
            app:layout_constraintStart_toEndOf="@+id/loading_sketch_title_avatar"
            app:layout_constraintTop_toTopOf="@+id/btn_close"
            app:placeholderImage="@color/larus_base_2_overlay"
            app:roundedCornerRadius="?attr/larus_dp_4"/>
        <com.larus.common_ui.widget.CircleSimpleDraweeView
            android:id="@+id/loading_sketch_title_action_1"
            android:layout_width="?attr/larus_dp_26"
            android:layout_height="?attr/larus_dp_26"
            android:layout_marginEnd="?attr/larus_dp_17"
            app:layout_constraintBottom_toBottomOf="@+id/btn_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btn_close"
            app:placeholderImage="@color/larus_base_2_overlay"/>
        <com.larus.common_ui.widget.CircleSimpleDraweeView
            android:id="@+id/loading_sketch_title_action_2"
            android:layout_width="?attr/larus_dp_26"
            android:layout_height="?attr/larus_dp_26"
            android:layout_marginEnd="?attr/larus_dp_17"
            app:layout_constraintBottom_toBottomOf="@+id/btn_close"
            app:layout_constraintEnd_toStartOf="@+id/loading_sketch_title_action_1"
            app:layout_constraintTop_toTopOf="@+id/btn_close"
            app:placeholderImage="@color/larus_base_2_overlay"/>
        <com.larus.common_ui.widget.CircleSimpleDraweeView
            android:id="@+id/loading_sketch_title_action_3"
            android:layout_width="?attr/larus_dp_26"
            android:layout_height="?attr/larus_dp_26"
            android:layout_marginEnd="?attr/larus_dp_17"
            app:layout_constraintBottom_toBottomOf="@+id/btn_close"
            app:layout_constraintEnd_toStartOf="@+id/loading_sketch_title_action_2"
            app:layout_constraintTop_toTopOf="@+id/btn_close"
            app:placeholderImage="@color/larus_base_2_overlay"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/loading_list_sketch"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.larus.common_ui.widget.CircleSimpleDraweeView
            android:id="@+id/loading_sketch_bot_avatar"
            android:layout_width="?attr/larus_dp_160"
            android:layout_height="?attr/larus_dp_160"
            android:layout_marginTop="?attr/larus_dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="@color/larus_base_2_overlay"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/loading_sketch_normal_bubble"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_76"
            android:layout_marginLeft="?attr/larus_dp_12"
            android:layout_marginTop="?attr/larus_dp_12"
            android:layout_marginRight="?attr/larus_dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/loading_sketch_bot_avatar"
            app:placeholderImage="@color/larus_base_2_overlay"
            app:roundedCornerRadius="?attr/larus_dp_16"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_normal_bot_sketch"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:constraint_referenced_ids="loading_sketch_bot_avatar,loading_sketch_normal_bubble"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/loading_sketch_input_area"
        android:background="@drawable/larus_shadow"
        android:paddingLeft="?attr/larus_dp_12"
        android:paddingTop="?attr/larus_dp_12"
        android:paddingRight="?attr/larus_dp_12"
        android:paddingBottom="?attr/larus_dp_12"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_76">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/input_area"
            android:background="@drawable/larus_bg_input_normal"
            android:paddingLeft="?attr/larus_dp_12"
            android:paddingRight="?attr/larus_dp_12"
            android:duplicateParentState="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.larus.common_ui.widget.CircleSimpleDraweeView
                android:id="@+id/loading_sketch_input_call_icon"
                android:layout_width="?attr/larus_dp_26"
                android:layout_height="?attr/larus_dp_26"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImage="@color/larus_base_4_overlay"/>
            <com.facebook.drawee.view.SimpleDraweeView
                android:id="@+id/loading_sketch_input_content"
                android:layout_width="?attr/larus_dp_72"
                android:layout_height="?attr/larus_dp_22"
                android:layout_marginStart="?attr/larus_dp_12"
                app:layout_constraintBottom_toBottomOf="@+id/loading_sketch_input_call_icon"
                app:layout_constraintStart_toEndOf="@+id/loading_sketch_input_call_icon"
                app:layout_constraintTop_toTopOf="@+id/loading_sketch_input_call_icon"
                app:placeholderImage="@color/larus_base_4_overlay"
                app:roundedCornerRadius="?attr/larus_dp_4"/>
            <com.larus.common_ui.widget.CircleSimpleDraweeView
                android:id="@+id/loading_sketch_input_keyboard_icon"
                android:layout_width="?attr/larus_dp_26"
                android:layout_height="?attr/larus_dp_26"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:placeholderImage="@color/larus_base_4_overlay"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</LinearLayout>
