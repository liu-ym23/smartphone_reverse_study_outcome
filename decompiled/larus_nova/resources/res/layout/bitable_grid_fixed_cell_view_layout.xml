<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/cell_wrapper"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="16dp">
    <com.bytedance.ee.bear.bitable.infoarch.nativeview.grid.record.leftcontent.GridCheckBoxUI
        android:id="@+id/check_box"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"/>
    <com.bytedance.ee.bear.bitable.infoarch.nativeview.grid.record.leftcontent.GridCountNumberUI
        android:id="@+id/count_number"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"/>
    <com.bytedance.ee.bear.bitable.infoarch.nativeview.common.uikit.cell.CommonCellView
        android:id="@+id/cell_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <com.bytedance.ee.bear.bitable.infoarch.nativeview.grid.record.hierarchy.HierarchyCounterView
        android:id="@+id/hierarchy_counter"
        android:padding="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"/>
    <com.bytedance.ee.bear.bitable.infoarch.nativeview.grid.record.hierarchy.HierarchyTintView
        android:id="@+id/hierarchy_tint"
        android:padding="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"/>
    <com.bytedance.ee.bear.bitable.infoarch.nativeview.common.uikit.CommentView
        android:id="@+id/comment"
        android:visibility="gone"
        android:layout_width="30dp"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/divider"
        android:background="@color/line_divider_default"
        android:layout_width="@dimen/bitable_native_view_divider_size"
        android:layout_height="match_parent"
        android:layout_marginLeft="4dp"/>
    <View
        android:id="@+id/fixed_shadow"
        android:background="@drawable/bitable_shadow_bg"
        android:visibility="gone"
        android:layout_width="4dp"
        android:layout_height="match_parent"/>
</LinearLayout>
