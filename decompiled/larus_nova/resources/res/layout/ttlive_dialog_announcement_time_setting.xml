<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mAnnouncementTimeSettingDialogContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/title_group"
        android:layout_width="match_parent"
        android:layout_height="51.5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.core.widget.LiveTextView
            android:textSize="15dp"
            android:textColor="#e6ffffff"
            android:layout_gravity="center_vertical"
            android:id="@+id/mTvAnnouncementTimeSettingDialogCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:text="@string/ttlive_cancel"
            android:layout_marginStart="16dp"/>
        <com.bytedance.android.live.core.widget.LiveTextView
            android:textSize="15dp"
            android:textColor="#b3ffffff"
            android:layout_gravity="center"
            android:id="@+id/mTvAnnouncementTimeSettingDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="预告开播时间"/>
        <com.bytedance.android.live.core.widget.LiveTextView
            android:textSize="15dp"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/mTvAnnouncementTimeSettingDialogSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:text="@string/ttlive_core_save"
            android:layout_marginEnd="16dp"/>
    </FrameLayout>
    <View
        android:id="@+id/mAnnouncementTimeSettingDialogDivider"
        android:background="#14ffffff"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_group"/>
    <FrameLayout
        android:id="@+id/time_select_widget_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mAnnouncementTimeSettingDialogDivider"/>
    <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
        android:id="@+id/douyin_loading"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
