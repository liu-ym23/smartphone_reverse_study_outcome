<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:background="#161823"
    android:layout_width="match_parent"
    android:layout_height="@dimen/annie_title_bar_height">
    <View
        android:id="@+id/back"
        android:background="@drawable/annie_bg_back_ab"
        android:visibility="gone"
        android:layout_width="@dimen/annie_container_icon_size"
        android:layout_height="@dimen/annie_container_icon_size"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/close"
        android:background="@drawable/annie_titlebar_close_dark"
        android:visibility="gone"
        android:layout_width="@dimen/annie_container_icon_size"
        android:layout_height="@dimen/annie_container_icon_size"
        android:layout_marginStart="@dimen/annie_container_icon_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="17dp"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:maxEms="12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/btn_share"
        android:background="@drawable/annie_web_btn_share"
        android:visibility="gone"
        android:layout_width="@dimen/annie_container_icon_size"
        android:layout_height="@dimen/annie_container_icon_size"
        android:layout_marginEnd="@dimen/annie_container_icon_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
