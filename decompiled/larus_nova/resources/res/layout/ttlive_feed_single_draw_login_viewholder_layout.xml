<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="13dp"
        android:textColor="#ff77787f"
        android:id="@+id/single_draw_login_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/ttlive_feed_single_not_login"
        app:layout_constraintBottom_toTopOf="@+id/single_draw_login_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textStyle="bold"
        android:textColor="#e5ffffff"
        android:gravity="center"
        android:id="@+id/single_draw_login_button"
        android:background="@drawable/ttlive_bg_single_drawer_login_button"
        android:layout_width="68dp"
        android:layout_height="24dp"
        android:layout_marginTop="20dp"
        android:text="@string/ttlive_feed_single_login"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
