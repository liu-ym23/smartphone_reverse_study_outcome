<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:background="#10121c"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="4"/>
    <ImageView
        android:id="@+id/fail_background"
        android:layout_width="172dp"
        android:layout_height="128dp"
        android:src="@drawable/annie_web_fail_bg_dark"/>
    <TextView
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#e6ffffff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/annie_network_error"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#80ffffff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/annie_retry_after_check_notwork"/>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="3"/>
    <Button
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/annie_white"
        android:id="@+id/web_retry"
        android:background="@drawable/annie_bg_retry_btn"
        android:layout_width="172dp"
        android:layout_height="32dp"
        android:text="@string/annie_retry"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/annie_white"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/fail_close"
        android:layout_width="100dp"
        android:layout_height="44dp"
        android:text="@string/annie_button_close"/>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="3"/>
</LinearLayout>
