<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bot.impl.feature.edit.feature.bgimage.aigen.img2img.widget.MyClickablePassThroughView
        android:id="@+id/crop_fragment_container"
        android:background="@color/larus_base_2"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginRight="?attr/larus_dp_16"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/center_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="?attr/larus_dp_16"
        android:layout_marginEnd="?attr/larus_dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/crop_fragment_container"
        app:layout_constraintEnd_toEndOf="@+id/crop_fragment_container"
        app:layout_constraintStart_toStartOf="@+id/crop_fragment_container"
        app:layout_constraintTop_toTopOf="@+id/crop_fragment_container">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/plus"
            android:layout_width="?attr/larus_dp_32"
            android:layout_height="?attr/larus_dp_32"
            android:src="@drawable/larus_ugc_bot_add_photo_fill"/>
        <ProgressBar
            android:layout_gravity="center_horizontal"
            android:id="@+id/uploading"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:layout_marginBottom="?attr/larus_dp_4"
            android:indeterminate="true"
            android:indeterminateDuration="750"
            android:indeterminateTint="@color/larus_neutral_30"/>
        <TextView
            android:textSize="?attr/larus_sp_16"
            android:textStyle="bold"
            android:textColor="@color/larus_primary_50"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_12"
            android:text="@string/larus_ref_image_btn"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/delete_btn"
        android:background="@drawable/larus_bg_delete_btn_overlay"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_36"
        android:layout_height="?attr/larus_dp_36"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintEnd_toEndOf="@+id/crop_fragment_container"
        app:layout_constraintTop_toTopOf="@+id/crop_fragment_container">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="?attr/larus_dp_20"
            android:layout_height="?attr/larus_dp_20"
            android:src="@drawable/larus_trash_fill"/>
    </FrameLayout>
    <TextView
        android:textSize="?attr/larus_sp_14"
        android:textColor="@color/larus_neutral_50"
        android:gravity="center"
        android:id="@+id/illustration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        android:text="@string/larus_enhance_image_tip"
        app:layout_constraintTop_toBottomOf="@+id/crop_fragment_container"/>
</merge>
