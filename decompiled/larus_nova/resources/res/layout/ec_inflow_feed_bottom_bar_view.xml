<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/tiny_product_card_bottom_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.shopping.feed.widget.ProductFeedAbilityBarView
        android:id="@+id/bottom_bar_ability_bar"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginRight="20dp"/>
    <com.bytedance.android.ui.base.widget.round.RoundLinearLayout
        android:id="@+id/bottom_button_container"
        android:layout_width="188dp"
        android:layout_height="match_parent"
        app:bg_cornerRadius="8dp">
        <FrameLayout
            android:id="@+id/bottom_button_left"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/bottom_button_right"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </com.bytedance.android.ui.base.widget.round.RoundLinearLayout>
</LinearLayout>
