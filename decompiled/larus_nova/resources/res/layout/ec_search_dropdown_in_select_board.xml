<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/dropdown_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/TextPrimary"
            android:id="@+id/dropdown_title_text"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/dropdown_title_expand"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <com.bytedance.ies.dmt.ui.widget.DmtTextView
                android:textSize="12sp"
                android:textColor="@color/TextSecondary"
                android:id="@+id/dropdown_title_expand_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search_filter_board_expand_text"
                android:layout_marginEnd="3dp"/>
            <ImageView
                android:id="@+id/dropdown_title_expand_icon"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:contentDescription="@string/search_filter_board_expand_text"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/dropdown_content"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
