<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <View
        android:id="@+id/primary_hint"
        android:background="@drawable/ttlive_ic_vs_hdr_resolution"
        android:layout_width="76dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toTopOf="@+id/secondary_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <View
        android:gravity="center"
        android:id="@+id/limited_time_icon"
        android:background="@drawable/ttlive_bg_vs_hdr_limited_time_tip"
        android:layout_width="24dp"
        android:layout_height="12dp"
        app:layout_constraintLeft_toRightOf="@+id/primary_hint"
        app:layout_constraintStart_toEndOf="@+id/primary_hint"
        app:layout_constraintTop_toTopOf="@+id/primary_hint"/>
    <TextView
        android:textSize="10dp"
        android:textColor="#80ffffff"
        android:id="@+id/secondary_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="@string/ttlive_vs_hdr_secondary_hint"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/primary_hint"/>
</androidx.constraintlayout.widget.ConstraintLayout>
