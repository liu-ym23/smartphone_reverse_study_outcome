<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/paid_live_tip_temp_root"
    android:background="@drawable/ttlive_bg_paid_temp_player_tip"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:layout_width="wrap_content"
    android:layout_height="29dp">
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_std_text_1"
        android:gravity="center"
        android:id="@+id/paid_live_tip_temp_timing"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_std_text_1"
        android:gravity="center"
        android:id="@+id/paid_live_tip_temp_split"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:text="·"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/paid_live_tip_temp_timing"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/paid_live_tip_temp_open_panel"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/paid_live_tip_temp_split"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="12dp"
            android:textStyle="bold"
            android:textColor="#ffdd99"
            android:gravity="center"
            android:id="@+id/paid_live_tip_temp_open_panel_text"
            android:layout_width="wrap_content"
            android:layout_height="17dp"/>
        <ImageView
            android:layout_gravity="center"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ttlive_vs_ic_paid_to_buy"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
