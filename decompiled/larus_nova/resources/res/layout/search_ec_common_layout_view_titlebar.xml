<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/edit_view_root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginTop="1dp">
    <ImageView
        android:id="@+id/search_ec_common_title_back"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ec_search_titlebar_back_black"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/search_ec_common_title_right"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/ec_search_color_161823"
            android:gravity="center"
            android:id="@+id/search_ec_common_title_search"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/ec_search_saas"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
        <FrameLayout
            android:id="@+id/search_ec_common_title_extra"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:id="@+id/saas_ec_search_top_bar_order"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/saas_ec_search_top_bar_order"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/search_ec_common_title_edit_bg_range_dim"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/search_ec_common_title_right"
        app:layout_constraintStart_toEndOf="@+id/search_ec_common_title_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="16dp"
        app:layout_goneMarginStart="16dp">
        <View
            android:id="@+id/oval_dim_1"
            android:background="@drawable/ec_search_edit_bg_oval_dim_1"
            android:layout_width="79dp"
            android:layout_height="32dp"
            android:layout_marginTop="4dp"
            android:layout_marginStart="2dp"/>
        <View
            android:id="@+id/oval_dim_2"
            android:background="@drawable/ec_search_edit_bg_oval_dim_2"
            android:layout_width="87dp"
            android:layout_height="21dp"/>
        <View
            android:id="@+id/oval_dim_3"
            android:background="@drawable/ec_search_edit_bg_oval_dim_3"
            android:layout_width="133dp"
            android:layout_height="10dp"
            android:layout_marginEnd="34dp"
            android:layout_alignParentEnd="true"/>
        <View
            android:id="@+id/oval_dim_4"
            android:background="@drawable/ec_search_edit_bg_oval_dim_4"
            android:layout_width="87dp"
            android:layout_height="10dp"
            android:layout_marginEnd="34dp"
            android:layout_alignParentEnd="true"/>
        <View
            android:id="@+id/oval_dim_5"
            android:background="@drawable/ec_search_edit_bg_oval_dim_5"
            android:layout_width="141dp"
            android:layout_height="10dp"
            android:layout_marginTop="26dp"
            android:layout_marginEnd="-4dp"
            android:layout_alignParentEnd="true"/>
        <View
            android:id="@+id/oval_dim_6"
            android:background="@drawable/ec_search_edit_bg_oval_dim_6"
            android:layout_width="82dp"
            android:layout_height="10dp"
            android:layout_marginTop="26dp"
            android:layout_marginEnd="70dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <com.ss.android.ugc.aweme.search.common.view.ConeGradientView
        android:id="@+id/search_ec_common_title_edit_bg_border"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/search_ec_common_title_right"
        app:layout_constraintStart_toEndOf="@+id/search_ec_common_title_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="16dp"
        app:layout_goneMarginStart="16dp"/>
    <View
        android:id="@+id/search_ec_common_title_edit_bg"
        android:background="@drawable/search_title_edit_bg_shape"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/search_ec_common_title_right"
        app:layout_constraintStart_toEndOf="@+id/search_ec_common_title_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="16dp"
        app:layout_goneMarginStart="16dp"/>
    <ImageView
        android:id="@+id/search_ec_common_half_screen_close"
        android:visibility="gone"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ec_search_saas_close_icon"
        android:scaleType="fitXY"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/search_ec_common_title_edit_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/search_ec_common_title_edit_bg"/>
    <ImageView
        android:id="@+id/search_ec_common_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ec_search_searchbar_search_light"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/search_ec_common_title_edit_bg"
        app:layout_constraintStart_toStartOf="@+id/search_ec_common_title_edit_bg"
        app:layout_constraintTop_toTopOf="@+id/search_ec_common_title_edit_bg"/>
    <ImageView
        android:id="@+id/search_ec_common_close"
        android:visibility="invisible"
        android:layout_width="40dp"
        android:layout_height="0dp"
        android:src="@drawable/ec_search_ic_searchbar_clear_white"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="@+id/search_ec_common_title_edit_bg"
        app:layout_constraintEnd_toEndOf="@+id/search_ec_common_title_edit_bg"
        app:layout_constraintTop_toTopOf="@+id/search_ec_common_title_edit_bg"/>
    <ImageView
        android:id="@+id/search_ec_common_scan"
        android:visibility="visible"
        android:layout_width="24dp"
        android:layout_height="0dp"
        android:src="@drawable/ec_search_saas_search_photo_icon"
        android:scaleType="center"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/search_ec_common_title_edit_bg"
        app:layout_constraintEnd_toEndOf="@+id/search_ec_common_title_edit_bg"
        app:layout_constraintTop_toTopOf="@+id/search_ec_common_title_edit_bg"/>
    <com.bytedance.ies.dmt.ui.widget.DmtEditText
        android:textColor="@color/ec_search_color_161823"
        android:textColorHint="@color/ec_search_color_99161823"
        android:gravity="start|center_vertical"
        android:id="@+id/search_ec_common_input"
        android:background="@color/ec_search_saas_transparent"
        android:padding="0dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_centerVertical="true"
        android:inputType="textNoSuggestions"
        android:imeOptions="actionSearch"
        android:textCursorDrawable="@drawable/ec_search_saas_cursor"
        android:textDirection="ltr"
        android:textAlignment="viewStart"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/search_ec_common_title_edit_bg"
        app:layout_constraintEnd_toEndOf="@+id/search_ec_common_title_edit_bg"
        app:layout_constraintStart_toEndOf="@+id/search_ec_common_icon"
        app:layout_constraintTop_toTopOf="@+id/search_ec_common_title_edit_bg"
        style="@style/font_size_30_sp"/>
    <View
        android:id="@+id/focusView"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="@+id/search_ec_common_input"
        app:layout_constraintTop_toTopOf="@+id/search_ec_common_input"/>
</androidx.constraintlayout.widget.ConstraintLayout>
