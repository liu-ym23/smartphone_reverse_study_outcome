<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/photos_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/item_gesture_fl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/photos_card_display_module"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/photos_flow_card_photos_player_area"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/photos_card_extras_module"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/aos_photos_camera_strong"/>
            <FrameLayout
                android:id="@+id/multi_camera_anchor_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.bytedance.awemeopen.apps.framework.feed.desc.MentionTextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/aos_text_primary"
                android:id="@+id/tv_title"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="5dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
            <com.bytedance.awemeopen.apps.framework.feed.desc.MentionTextView
                android:textSize="15sp"
                android:textColor="@color/aos_text_primary_E6"
                android:id="@+id/tv_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="5.25sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="8dp">
                <com.bytedance.awemeopen.apps.framework.feed.desc.MentionTextView
                    android:textSize="12sp"
                    android:textColor="@color/aos_full_page_publish_info"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/risk_warning_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp">
                    <com.bytedance.awemeopen.infra.base.image.AoImageView
                        android:id="@+id/risk_warning_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"/>
                    <com.bytedance.awemeopen.apps.framework.feed.desc.MentionTextView
                        android:textSize="12sp"
                        android:textColor="@color/aos_full_page_publish_info"
                        android:id="@+id/risk_warning_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:layout_marginStart="2dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <com.bytedance.awemeopen.apps.framework.base.view.DiggLayout
        android:id="@+id/item_digg_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
