<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cj_pay_integrated_combine_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cj_pay_bg_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="470dp"
        android:layout_alignParentBottom="true">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="44sp">
                    <TextView
                        android:textSize="28sp"
                        android:textColor="#161823"
                        android:gravity="center"
                        android:id="@+id/cj_pay_unit"
                        android:layout_width="14sp"
                        android:layout_height="31sp"
                        android:layout_marginBottom="-2dp"
                        android:text="@string/cj_pay_currency_unit"/>
                    <TextView
                        android:textSize="36sp"
                        android:textColor="#161823"
                        android:gravity="center"
                        android:id="@+id/pay_order_value_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="4dp"
                        android:letterSpacing="-0.05"/>
                </LinearLayout>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#80161823"
                    android:gravity="center"
                    android:id="@+id/pay_name_txt"
                    android:layout_width="match_parent"
                    android:layout_height="18sp"/>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="18sp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginRight="16dp">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#bf161823"
                        android:id="@+id/combine_header_line_1_left_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/cj_pay_counter_small_change_pay"
                        android:layout_alignParentLeft="true"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#161823"
                        android:id="@+id/change_pay_value_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentRight="true"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="18sp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginRight="16dp">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#ff6f28"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/cj_pay_counter_bank_card_pay"
                        android:layout_alignParentLeft="true"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#ff7a38"
                        android:id="@+id/bank_card_pay_value_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentRight="true"/>
                </RelativeLayout>
                <View
                    android:id="@+id/combine_pay_divider"
                    android:background="#1f161823"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="16dp"/>
                <TextView
                    android:textSize="13sp"
                    android:gravity="center_vertical"
                    android:id="@+id/bank_card_tips_txt"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="42sp"/>
            </LinearLayout>
            <include
                android:id="@+id/cj_pay_titlebar_root_view"
                layout="@layout/cj_pay_view_titlebar_noise_reduction_layout"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/bank_card_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/combine_pay_btn_container"
                android:overScrollMode="never"/>
            <RelativeLayout
                android:id="@+id/combine_pay_btn_container"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="16dp"
                android:layout_alignParentBottom="true">
                <com.android.ttcjpaysdk.base.theme.widget.CJPayCustomButton
                    android:textSize="15sp"
                    android:textColor="@color/cj_pay_color_white"
                    android:gravity="center"
                    android:id="@+id/combine_pay_btn"
                    android:background="@drawable/cj_pay_base_bg_red_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cj_pay_custom_button_height_44"
                    android:text="@string/cj_pay_change_and_bank_pay"/>
                <ProgressBar
                    android:id="@+id/combine_pay_btn_loading"
                    android:background="@color/cj_pay_color_trans"
                    android:visibility="gone"
                    android:layout_width="@dimen/cj_pay_padding_20"
                    android:layout_height="@dimen/cj_pay_padding_20"
                    android:indeterminateOnly="true"
                    android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_white"
                    android:indeterminateDuration="500"
                    android:indeterminateBehavior="repeat"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
        </RelativeLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/cj_pay_loading_outer_layout"
        android:background="@color/cj_pay_color_white"
        android:paddingTop="100dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:layout_alignParentBottom="true">
        <ProgressBar
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_pay_loading_view"
            android:background="@color/cj_pay_color_trans"
            android:layout_width="@dimen/cj_pay_height_60"
            android:layout_height="@dimen/cj_pay_height_60"
            android:indeterminateOnly="true"
            android:indeterminateDrawable="@drawable/cj_pay_bg_loading_circle"
            android:indeterminateDuration="500"
            android:indeterminateBehavior="repeat"/>
    </FrameLayout>
</RelativeLayout>
