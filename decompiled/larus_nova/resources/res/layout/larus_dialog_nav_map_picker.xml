<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/larus_applet_picker_bottom_sheet_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/larus_neutral_50"
        android:gravity="center"
        android:id="@+id/title"
        android:paddingTop="20dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="使用地图应用打开"/>
    <View
        android:background="@color/larus_neutral_transparent_2"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/items_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <View
        android:background="@color/larus_bg_base_9"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/larus_picker_cancel_text"
        android:gravity="center"
        android:id="@+id/cancel"
        android:background="?attr/selectableItemBackground"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="取消"/>
</LinearLayout>
