<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/dv_promo_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layoutMode="height_self_adjust"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/fl_head_image"
        android:layout_width="match_parent"
        android:layout_height="278dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="top|right"
            android:id="@+id/iv_promo_bg"
            android:layout_width="182dp"
            android:layout_height="134dp"
            android:layout_marginTop="46dp"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:layout_gravity="right"
            android:id="@+id/dv_promo_logo"
            android:layout_width="128dp"
            android:layout_height="93dp"
            android:layout_marginTop="72dp"
            android:layout_marginRight="27dp"
            app:actualImageScaleType="centerCrop"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_toolbar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:src="@drawable/shopping_inflow_feed_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:id="@+id/toolbar_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_cart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="16dp"
            android:src="@drawable/shopping_inflow_feed_cart"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.shopping.inflow.promo.widget.NestedExpandLayout
        android:id="@+id/nested_expand_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_toolbar">
        <FrameLayout
            android:id="@+id/fl_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_feed_card"
            android:background="@drawable/shopping_bg_feed_store_card_round_white"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
    </com.bytedance.android.shopping.inflow.promo.widget.NestedExpandLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
