<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.ee.bear.bitable.card.view.cell.CellEditDragView
        android:layout_gravity="bottom"
        android:id="@+id/dragView"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:maxHeightPercent="0.95"
        app:midHeightPercent="0.6"
        app:panel_background_color="@color/bg_float"
        app:panel_enable_drag="true"
        app:panel_menu_type="text"
        app:panel_right_text="@string/Doc_Doc_SearchDone"
        app:panel_right_text_color="@color/primary_fill_default"
        app:panel_show_divider="false"
        app:panel_show_drag_handler="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_select_user_title"
            android:background="@color/bg_float"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/rl_search_user"
                android:background="@drawable/facade_round_around_m"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_kit_len_36"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/space_kit_len_16"
                android:layout_marginEnd="@dimen/space_kit_len_16"
                android:layout_alignParentStart="true"
                android:backgroundTint="@color/bg_filler">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_search_user_icon"
                    android:layout_width="@dimen/space_kit_len_18"
                    android:layout_height="@dimen/space_kit_len_18"
                    android:layout_margin="@dimen/space_kit_len_8"
                    android:src="@drawable/ud_icon_search_outlined"
                    android:tint="@color/icon_n3"/>
                <com.suite.lark.emm.design.edittext.SCEditText
                    android:textSize="@dimen/space_kit_font_15"
                    android:textColor="@color/text_title"
                    android:textColorHint="@color/text_placeholder"
                    android:gravity="center_vertical"
                    android:id="@+id/et_search_user"
                    android:background="@null"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/space_kit_len_5"
                    android:layout_marginBottom="@dimen/space_kit_len_5"
                    android:hint="@string/Doc_Facade_Search"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:imeOptions="flagNoExtractUi|flagNoFullscreen|actionSearch"
                    android:layout_marginEnd="@dimen/space_kit_len_8"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_search_clear_icon"
                    android:layout_width="@dimen/space_kit_len_20"
                    android:layout_height="@dimen/space_kit_len_20"
                    android:layout_margin="@dimen/space_kit_len_6"
                    android:src="@drawable/ud_icon_close_filled"
                    android:tint="@color/icon_n3"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/create_group_wrapper"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_kit_len_8">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/create_group"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_kit_len_46">
                    <TextView
                        android:textSize="@dimen/space_kit_font_16"
                        android:textColor="@color/primary_pri_500"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/space_kit_len_20"
                        android:text="@string/Bitable_GroupChat_NewGroup_Button"
                        android:layout_weight="1"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/space_kit_len_12"
                        android:layout_height="@dimen/space_kit_len_12"
                        android:layout_marginRight="@dimen/space_kit_len_16"
                        android:tint="@color/primary_pri_500"
                        app:srcCompat="@drawable/ud_icon_right_bold_outlined"/>
                </LinearLayout>
                <View
                    android:background="@color/bg_float_base"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_kit_len_8"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_selected_users"
                android:paddingTop="@dimen/space_kit_len_16"
                android:visibility="visible"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_checkbox_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_kit_len_38"
                android:layout_marginTop="@dimen/space_kit_len_8"
                android:layout_marginBottom="@dimen/space_kit_len_8">
                <com.larksuite.component.universe_design.checkbox.UDCheckBox
                    android:id="@+id/cb_notify_checkbox"
                    android:paddingLeft="@dimen/space_kit_len_16"
                    android:paddingTop="@dimen/space_kit_len_9"
                    android:paddingRight="@dimen/space_kit_len_8"
                    android:paddingBottom="@dimen/space_kit_len_9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/text_title"
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Bitable_Reminder_NotifWillBeSent"/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/dp_14"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_hint_text"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="@dimen/space_kit_len_16"
                android:layout_marginBottom="@dimen/space_kit_len_16"
                android:text="@string/Bitable_Reminder_NoNotifWillBeSentInForm"/>
            <View
                android:id="@+id/rv_search_result_divider"
                android:background="@color/line_divider_default"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ud_divider_size"/>
            <TextView
                android:textSize="@dimen/space_kit_font_14"
                android:textColor="@color/text_caption"
                android:gravity="bottom"
                android:id="@+id/list_name"
                android:paddingBottom="@dimen/space_kit_len_4"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/space_kit_len_32"
                android:layout_marginLeft="@dimen/space_kit_len_16"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_search_result_users"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <FrameLayout
                android:id="@+id/fl_search_loading"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.bytedance.ee.bear.facade.common.widget.BearLottieView
                    android:layout_gravity="center"
                    android:id="@+id/blv_search_user_loading"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/loading_anim"
                    style="@style/BearLottieView"/>
            </FrameLayout>
            <com.bytedance.ee.bear.widgets.universedesign.SpaceEmptyState
                android:id="@+id/empty_state"
                android:paddingTop="@dimen/space_kit_len_16"
                android:paddingBottom="@dimen/space_kit_len_16"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:ud_empty_desc="@string/Bitable_PeopleField_NothingFound_Description"
                app:ud_empty_imageRes="@drawable/ccm_empty_neutral_no_content"
                style="@style/SpaceEmptyStatusStyle"/>
            <com.bytedance.ee.bear.document.widget.KeyboardPlaceholderView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.bytedance.ee.bear.bitable.card.view.cell.CellEditDragView>
</FrameLayout>
