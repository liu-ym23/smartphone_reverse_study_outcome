<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ec_commerce_anchor_v4_head_video_layout_1327145926"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/player_block_blur_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:layout_gravity="center"
            android:id="@+id/player_block_blur_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.shopping.anchorv4.voavhs.blur.RealtimeBlurView
            android:id="@+id/player_block_blur_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:realtimeBlurRadius="30dp"
            app:realtimeOverlayColor="@android:color/transparent"/>
        <View
            android:id="@+id/player_block_blur_mask"
            android:background="#66ffffff"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <include layout="@layout/ec_commerce_anchor_v3_video_host_layout"/>
    <com.bytedance.android.shopping.anchorv4.voavhs.head.view.AnchorV4CommentVideoEntryLayout
        android:layout_gravity="end|bottom"
        android:id="@+id/comment_video_entry_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="60dp"
        android:layout_marginEnd="12dp"/>
</FrameLayout>
