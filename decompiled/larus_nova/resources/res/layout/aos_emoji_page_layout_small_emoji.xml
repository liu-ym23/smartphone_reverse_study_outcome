<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/aos_common_emoji_bg_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"/>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/send_delete_btn_container"
        android:background="@drawable/aos_emoji_delete_mask_v1"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="160dp"
        android:layout_height="109dp"
        android:layout_alignParentBottom="true"
        android:paddingStart="0dp"
        android:paddingEnd="8dp"
        android:layout_alignParentEnd="true">
        <View
            android:id="@+id/click_barrier"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/send_btn"/>
        <View
            android:id="@+id/delete_btn_chat_full_bg"
            android:background="@drawable/aos_emoji_small_send_btn_bg_chat_full_bg"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/delete_btn"
            app:layout_constraintEnd_toEndOf="@+id/delete_btn"
            app:layout_constraintStart_toStartOf="@+id/delete_btn"
            app:layout_constraintTop_toTopOf="@+id/delete_btn"/>
        <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
            android:id="@+id/delete_btn"
            android:background="@drawable/aos_emoji_delete_icon"
            android:visibility="gone"
            android:layout_width="71dp"
            android:layout_height="36dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/send_btn_chat_full_bg"
            android:background="@drawable/aos_emoji_small_send_btn_bg_chat_full_bg"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/send_btn"
            app:layout_constraintEnd_toEndOf="@+id/send_btn"
            app:layout_constraintStart_toStartOf="@+id/send_btn"
            app:layout_constraintTop_toTopOf="@+id/send_btn"/>
        <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
            android:textSize="14sp"
            android:textColor="@color/aos_bg_reverse"
            android:gravity="center"
            android:id="@+id/send_btn"
            android:background="@drawable/emoji_small_send_btn_bg"
            android:visibility="gone"
            android:layout_width="71dp"
            android:layout_height="36dp"
            android:text="发送"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ViewStub
        android:id="@+id/empty_load_view_stub"
        android:layout="@layout/aos_emoji_layout_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
