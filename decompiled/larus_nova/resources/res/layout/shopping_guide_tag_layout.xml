<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/guide_dot_top"
        android:background="@drawable/shopping_guide_tag_dot"
        android:visibility="gone"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintEnd_toEndOf="@+id/guide_info"
        app:layout_constraintStart_toStartOf="@+id/guide_info"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/guide_dot_start"
        android:background="@drawable/shopping_guide_tag_dot"
        android:visibility="gone"
        android:layout_width="6dp"
        android:layout_height="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/guide_info"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guide_info"/>
    <com.bytedance.android.ec.core.widget.RoundedLinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/guide_info"
        android:background="@drawable/shopping_guide_tag_background"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintStart_toEndOf="@+id/guide_dot_start"
        app:layout_constraintTop_toBottomOf="@+id/guide_dot_top">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/guide_icon"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="12dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp">
            <TextView
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:id="@+id/guide_title"
                android:layout_width="wrap_content"
                android:layout_height="17dp"
                style="@style/font_size_24"/>
            <TextView
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:id="@+id/guide_sub_title"
                android:layout_width="wrap_content"
                android:layout_height="17dp"
                style="@style/font_size_24"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/guide_jump_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:src="@drawable/shopping_guide_tag_jump_icon"/>
    </com.bytedance.android.ec.core.widget.RoundedLinearLayout>
    <View
        android:id="@+id/guide_dot_end"
        android:background="@drawable/shopping_guide_tag_dot"
        android:visibility="gone"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginLeft="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/guide_info"
        app:layout_constraintStart_toEndOf="@+id/guide_info"
        app:layout_constraintTop_toTopOf="@+id/guide_info"/>
    <View
        android:id="@+id/guide_dot_bottom"
        android:background="@drawable/shopping_guide_tag_dot"
        android:visibility="gone"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="@+id/guide_info"
        app:layout_constraintStart_toStartOf="@+id/guide_info"
        app:layout_constraintTop_toBottomOf="@+id/guide_info"/>
</androidx.constraintlayout.widget.ConstraintLayout>
