<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/ec_bg_flash_promotion_dialog"
        android:paddingBottom="12dp"
        android:layout_width="240dp"
        android:layout_height="wrap_content">
        <com.bytedance.android.ec.core.widget.ECNetImageView
            android:id="@+id/iv_promotion_img"
            android:layout_width="240dp"
            android:layout_height="240dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.ec.core.widget.ECNetImageView
            android:id="@+id/iv_flash_img"
            android:layout_width="32dp"
            android:layout_height="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@android:color/transparent"
            android:id="@+id/tv_promotion_badge"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="9dp"
            android:layout_marginRight="12dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_promotion_img"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/ec_color_black_text"
            android:ellipsize="end"
            android:id="@+id/tv_promotion_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="9dp"
            android:layout_marginRight="12dp"
            android:maxLines="2"
            android:lineSpacingExtra="4dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_promotion_badge"
            app:layout_goneMarginTop="9dp"/>
        <com.bytedance.android.livesdk.livecommerce.view.ECPriceView
            android:id="@+id/ecpv_promotion_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="6dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_promotion_title"
            app:priceBold="true"
            app:priceTextColor="@color/ec_color_promotion_price"
            app:priceTextSize="24dp"
            app:thinDecimal="true"
            app:yangTextSize="16dp"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ec_color_black_text_invalid"
            android:id="@+id/tv_promotion_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/ecpv_promotion_price"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ecpv_promotion_price"/>
        <TextView
            android:textSize="17dp"
            android:textColor="@color/ec_color_white"
            android:gravity="center"
            android:id="@+id/tv_go_buy"
            android:background="@drawable/ec_bg_button_big"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="12dp"
            android:text="@string/ec_rush_to_buy"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ecpv_promotion_price"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/iv_close"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/ec_close_falsh_dialog"/>
</LinearLayout>
