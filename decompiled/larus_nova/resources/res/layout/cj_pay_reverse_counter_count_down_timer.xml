<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:id="@+id/count_down_minutes"
        android:background="@drawable/cj_pay_count_down_digits_background"
        android:paddingLeft="3dp"
        android:paddingTop="1.5dp"
        android:paddingRight="3dp"
        android:paddingBottom="1.5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00"
        android:textAlignment="textEnd"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ff161823"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:text=":"/>
    <TextView
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:id="@+id/count_down_second"
        android:background="@drawable/cj_pay_count_down_digits_background"
        android:paddingLeft="3dp"
        android:paddingTop="1.5dp"
        android:paddingRight="3dp"
        android:paddingBottom="1.5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00"
        android:textAlignment="textEnd"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ff161823"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:text=":"/>
    <TextView
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:id="@+id/count_down_mills"
        android:background="@drawable/cj_pay_count_down_digits_background"
        android:paddingLeft="3dp"
        android:paddingTop="1.5dp"
        android:paddingRight="3dp"
        android:paddingBottom="1.5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00"
        android:textAlignment="textEnd"/>
</LinearLayout>
