<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="1080px"
    android:layout_height="1980px">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/bg_cover"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_0"
        app:layout_constraintDimensionRatio="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bg_cover_mask"
        android:layout_width="?attr/larus_dp_0"
        android:layout_height="?attr/larus_dp_0"
        app:layout_constraintBottom_toBottomOf="@+id/bg_cover"
        app:layout_constraintEnd_toEndOf="@+id/bg_cover"
        app:layout_constraintStart_toStartOf="@+id/bg_cover"
        app:layout_constraintTop_toTopOf="@+id/bg_cover"/>
    <View
        android:id="@+id/bg_default"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/detail_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/cover"
            android:layout_width="216px"
            android:layout_height="216px"
            android:layout_marginStart="108px"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="@drawable/larus_bg_music_save_cover_default"
            app:roundedCornerRadius="?attr/larus_dp_8"/>
        <TextView
            android:textSize="?attr/larus_sp_20"
            android:textStyle="bold"
            android:textColor="@color/larus_static_white"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30px"
            android:layout_marginStart="48px"
            app:layout_constraintStart_toEndOf="@+id/cover"
            app:layout_constraintTop_toTopOf="@+id/cover"/>
        <TextView
            android:textSize="?attr/larus_sp_13"
            android:textColor="@color/static_white_transparent_4"
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12px"
            app:layout_constraintStart_toStartOf="@+id/title"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <TextView
            android:textSize="?attr/larus_sp_20"
            android:textColor="@color/static_white_transparent_5"
            android:id="@+id/lyrics"
            android:fadingEdgeLength="60px"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="108px"
            android:layout_marginTop="72px"
            android:layout_marginRight="108px"
            android:layout_marginBottom="39px"
            android:maxHeight="1140px"
            android:requiresFadingEdge="vertical"
            app:layout_constraintBottom_toTopOf="@+id/icon_music"
            app:layout_constraintStart_toStartOf="@+id/cover"
            app:layout_constraintTop_toBottomOf="@+id/cover"
            app:layout_constraintVertical_bias="0"/>
        <ImageView
            android:id="@+id/icon_music"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="108px"
            android:alpha="0.7"
            android:layout_marginStart="90px"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/larus_ic_music_gen_water"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
