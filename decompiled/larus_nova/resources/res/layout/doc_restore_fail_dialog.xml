<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/facade_round_top_xxl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/bg_body">
    <com.bytedance.ee.bear.widgets.BaseTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="parent"
        app:widget_widgets_tb_back_icon="@drawable/ud_icon_close_small_outlined"
        app:widget_widgets_tb_background="@color/color_transparent"
        app:widget_widgets_tb_divider_visible="false"
        app:widget_widgets_tb_title="@string/LarkCCM_Workspace_Deleted_RestoreFailed_Title"/>
    <View
        android:id="@+id/divide"
        android:background="@color/line_divider_default"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ud_divider_size"
        app:layout_constraintBottom_toTopOf="@+id/description"
        app:layout_constraintTop_toBottomOf="@+id/titleBar"/>
    <TextView
        android:textSize="@dimen/space_kit_font_16"
        android:textColor="@color/text_title"
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_16"
        android:layout_marginBottom="@dimen/space_kit_len_16"
        android:text="@string/LarkCCM_Workspace_Deleted_Restore2SpaceFailed_Description"
        android:layout_marginStart="@dimen/space_kit_len_16"
        android:layout_marginEnd="@dimen/space_kit_len_16"
        app:layout_constraintBottom_toTopOf="@+id/divider2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divide"/>
    <View
        android:id="@+id/divider2"
        android:background="@color/line_divider_default"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ud_divider_size"
        app:layout_constraintBottom_toTopOf="@+id/confirm"
        app:layout_constraintTop_toBottomOf="@+id/description"/>
    <com.larksuite.component.universe_design.button.UDButton
        android:textSize="16sp"
        android:textColor="@color/static_white"
        android:id="@+id/confirm"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="20dp"
        android:text="@string/Doc_Facade_Confirm"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider2"
        app:ud_backgroundColor="@color/primary_fill_default"
        app:ud_radius="m"
        style="@style/UDButton.Small.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
