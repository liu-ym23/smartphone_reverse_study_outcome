<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/vs_progress_high_light_pop_main"
        android:background="@drawable/ttlive_bg_match_highlight_pop"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.livesdk.chatroom.ui.LiveRoundDraweeImageView
            android:id="@+id/vs_progress_high_light_pop_img"
            android:layout_width="75dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/vs_progress_high_light_pop_title"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:ttlive_radius="2dp"/>
        <ImageView
            android:id="@+id/vs_pop_hot_label"
            android:visibility="gone"
            android:layout_width="29dp"
            android:layout_height="15dp"
            android:src="@drawable/ttlive_ic_vs_hot_label"
            app:layout_constraintLeft_toLeftOf="@+id/vs_progress_high_light_pop_img"
            app:layout_constraintTop_toTopOf="@+id/vs_progress_high_light_pop_img"/>
        <TextView
            android:textSize="13dp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_std_text_white_1"
            android:ellipsize="end"
            android:id="@+id/vs_progress_high_light_pop_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxWidth="140dp"
            android:maxLines="2"
            android:lineSpacingExtra="4dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/match_high_light_pop_share"
            app:layout_constraintStart_toEndOf="@+id/vs_progress_high_light_pop_img"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_default="wrap"
            app:layout_goneMarginEnd="8dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/match_high_light_pop_share"
            android:background="@drawable/ttlive_bg_match_high_light_share"
            android:visibility="gone"
            android:layout_width="65dp"
            android:layout_height="26dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ttlive_std_text_white_1"
                android:gravity="center"
                android:layout_width="27dp"
                android:layout_height="0dp"
                android:text="@string/ttlive_share"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/match_high_light_pop_share_img"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/match_high_light_pop_share_img"
                android:layout_width="12dp"
                android:layout_height="10dp"
                android:layout_marginStart="12dp"
                app:actualImageResource="@drawable/ttlive_item_match_high_light_share"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/vs_progress_high_light_pop_arrow"
        android:background="@drawable/ttlive_match_high_light_pop_arrow"
        android:layout_width="13dp"
        android:layout_height="6dp"
        android:layout_marginLeft="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vs_progress_high_light_pop_main"/>
</androidx.constraintlayout.widget.ConstraintLayout>
