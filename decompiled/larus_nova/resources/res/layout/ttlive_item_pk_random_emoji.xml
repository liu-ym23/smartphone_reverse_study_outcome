<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/random_bg"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:importantForAccessibility="no"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/random_title"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="24dp"
        android:text="@string/ttlive_live_pk_random_view_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#161823"
        android:id="@+id/random_subtitle"
        android:focusable="false"
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="false"
        app:layout_constraintLeft_toLeftOf="@+id/random_title"
        app:layout_constraintTop_toBottomOf="@+id/random_title"/> /&gt; 
    <TextView
        android:textSize="12dp"
        android:textColor="#161823"
        android:id="@+id/random_match_text"
        android:focusable="false"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="false"
        app:layout_constraintLeft_toRightOf="@+id/random_subtitle"
        app:layout_constraintTop_toBottomOf="@+id/random_title"/>
    <ImageView
        android:id="@+id/random_icon"
        android:focusable="false"
        android:layout_width="35dp"
        android:layout_height="22dp"
        android:layout_marginRight="12dp"
        android:src="@drawable/ttlive_new_random_pk_icon"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/random_guest_anim"
        app:layout_constraintRight_toLeftOf="@+id/random_guest_anim"
        app:layout_constraintTop_toTopOf="@+id/random_guest_anim"/>
    <com.bytedance.android.livesdk.chatroom.ui.LiveRoundDraweeImageView
        android:id="@+id/random_avatar"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginRight="12dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/random_guest_anim"
        app:layout_constraintRight_toLeftOf="@+id/random_icon"
        app:layout_constraintTop_toTopOf="@+id/random_guest_anim"
        app:roundAsCircle="true"
        app:roundingBorderColor="@color/white"
        app:roundingBorderWidth="1dp"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/random_guest_anim"
        android:layout_width="42dp"
        android:layout_height="26dp"
        android:layout_marginTop="31dp"
        android:layout_marginRight="12dp"
        android:importantForAccessibility="no"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:orientation="horizontal"
        android:id="@+id/btn_area"
        android:background="@drawable/ttlive_bg_live_random_area"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#fe2c55"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/btn_start_brawl"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/ttlive_interact_pk_dialog_brawl_button_hint"
        app:layout_constraintBottom_toBottomOf="@+id/btn_area"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toLeftOf="@+id/btn_area"
        app:layout_constraintRight_toLeftOf="@+id/btn_start"
        app:layout_constraintTop_toTopOf="@+id/btn_area"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/btn_start"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/ttlive_interact_pk_dialog_random_button_hint"
        app:layout_constraintBottom_toBottomOf="@+id/btn_area"
        app:layout_constraintHorizontal_weight="3"
        app:layout_constraintLeft_toRightOf="@+id/btn_start_brawl"
        app:layout_constraintRight_toRightOf="@+id/btn_area"
        app:layout_constraintTop_toTopOf="@+id/btn_area"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/random_anim"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/btn_start_brawl"
        app:layout_constraintRight_toRightOf="@+id/btn_area"/>
</merge>
