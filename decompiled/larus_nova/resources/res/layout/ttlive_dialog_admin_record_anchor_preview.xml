<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_admin_record_anchor_preview"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/white"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="录屏预览"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/white"
            android:id="@+id/mAdminRecordAnchorPreviewCancel"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="取消"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:alpha="0.5"/>
    </RelativeLayout>
    <View
        android:id="@+id/divider_line"
        android:background="#24ffffff"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="15dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp">
        <com.bytedance.android.livesdk.chatroom.backtrack.LiveVideoPreviewView
            android:id="@+id/mAdminRecordAnchorPreviewVideoView"
            android:layout_width="108dp"
            android:layout_height="192dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/mAdminRecordAnchorPreviewEtParent"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp">
            <TextView
                android:textSize="12dp"
                android:textColor="#88ffffff"
                android:id="@+id/mAdminRecordAnchorPreviewTvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="管理员为你录制了一段精彩片段"/>
            <EditText
                android:textSize="13dp"
                android:textColor="#ccffffff"
                android:gravity="top|left"
                android:id="@+id/mAdminRecordAnchorPreviewEt"
                android:background="@drawable/ttlive_bg_admin_record_edit_text"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:hint="请输入描述"
                android:layout_weight="1"
                android:inputType="textMultiLine"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#88ffffff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="点击发布，该视频将视同您本人上传，请完整预览视频后发布。"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp">
        <LinearLayout
            android:gravity="center"
            android:id="@+id/mAdminRecordAnchorPreviewLlEtContent"
            android:background="@drawable/ttlive_bg_admin_record_btn_gray"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ttlive_ic_admin_record_anchor_preview_edit"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="编辑文案"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/mAdminRecordAnchorPreviewLlPost"
            android:background="@drawable/ttlive_bg_admin_record_btn_red"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="10dp"
            android:layout_weight="1">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ttlive_ic_admin_record_anchor_preview_publish"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="发布"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
