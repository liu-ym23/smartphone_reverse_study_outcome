<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_dialog_inroom_user"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/apply_old"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:id="@+id/open_video"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="20dp"
                android:layout_height="12dp"
                android:src="@drawable/ttlive_ic_interact_video"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/ttlive_black"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="55dp"
                android:text="@string/ttlive_interact_audience_video_open"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <View
            android:id="@+id/divider"
            android:background="#14000000"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:id="@+id/open_audio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="18dp"
                android:layout_height="16dp"
                android:src="@drawable/ttlive_ic_interact_audio"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/ttlive_black"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="55dp"
                android:layout_marginLeft="4dp"
                android:text="@string/ttlive_interact_audience_audio_open"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:id="@+id/apply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_black"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="55dp"
            android:layout_marginLeft="4dp"
            android:text="@string/ttlive_interact_apply_link"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/disconnect_cantainer"
        android:layout_width="match_parent"
        android:layout_height="55dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_black"
            android:gravity="center"
            android:id="@+id/disconnect"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:text="@string/ttlive_live_interact_disconnect"
            android:layout_weight="1"/>
        <View
            android:background="#14000000"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/camera_container"
        android:layout_width="match_parent"
        android:layout_height="55dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_black"
            android:gravity="center"
            android:id="@+id/camera"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:text="@string/ttlive_interact_open_camera"
            android:layout_weight="1"/>
        <View
            android:background="#14000000"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/radio_effect_decoration_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="55dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_black"
            android:gravity="center"
            android:id="@+id/radio_effect_change"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/ttlive_live_radio_effect"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <TextView
            android:textSize="9dp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:gravity="center_horizontal"
            android:id="@+id/limit_text"
            android:background="@drawable/ttlive_bg_time_limit"
            android:visibility="visible"
            android:layout_width="26dp"
            android:layout_height="14dp"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="10dp"
            android:text="@string/time_limit"
            android:layout_marginStart="5dp"
            app:layout_constraintLeft_toRightOf="@+id/radio_effect_change"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:layout_gravity="bottom"
            android:background="#14000000"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_black"
        android:gravity="center"
        android:id="@+id/tv_setting"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="@string/ttlive_interact_audience_guest_setting"/>
    <View
        android:background="#f1f1f2"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_black"
        android:gravity="center"
        android:id="@+id/cancel"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="@string/ttlive_cancel"/>
</LinearLayout>
