<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/coupon_discount_info_area_bg"
        android:layout_width="80dp"
        android:layout_height="40dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:background="@drawable/ec_window_item_left_origin_bg"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginRight="-1dp"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/coupon_discount_separator_bg"
        android:background="@drawable/ec_window_item_middle_full_span_origin_bg"
        android:layout_width="22dp"
        android:layout_height="40dp"
        app:layout_constraintLeft_toRightOf="@+id/coupon_discount_info_area_bg"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/coupon_discount_detail_bg"
        android:layout_width="0dp"
        android:layout_height="40dp"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/coupon_discount_separator_bg"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:background="@drawable/ec_window_item_right_origin_bg"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="-1dp"/>
    </FrameLayout>
    <ImageView
        android:layout_width="42dp"
        android:layout_height="34dp"
        android:layout_marginRight="52dp"
        android:src="@drawable/ec_window_item_coupon_douyin_logo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:background="@drawable/ec_window_item_middle_full_span_dots_bg"
        android:layout_width="22dp"
        android:layout_height="40dp"
        app:layout_constraintLeft_toRightOf="@+id/coupon_discount_info_area_bg"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/coupon_discount_separator_bg"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/ec_window_item_coupon_full_span_discount"/>
    <include
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/coupon_discount_separator_bg"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/ec_window_item_coupon_full_span_coupon_notice"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ec_window_common_red"
        android:gravity="center"
        android:id="@+id/coupon_discount_navigation_notice"
        android:background="@drawable/ec_window_item_coupon_notice_watch_bg"
        android:paddingLeft="8dp"
        android:paddingTop="4dp"
        android:paddingRight="8dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="14dp"
        android:minWidth="52dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
