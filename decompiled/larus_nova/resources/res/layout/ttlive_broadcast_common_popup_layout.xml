<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/popup_arrow_view_right_top"
        android:background="@drawable/ttlive_preview_toolbar_arrow"
        android:visibility="gone"
        android:layout_width="10dp"
        android:layout_height="5dp"
        android:layout_marginRight="20dp"
        android:rotation="180"
        app:layout_constraintBottom_toTopOf="@+id/content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/popup_arrow_view_left_top"
        android:background="@drawable/ttlive_preview_toolbar_arrow"
        android:visibility="gone"
        android:layout_width="10dp"
        android:layout_height="5dp"
        android:rotation="180"
        android:layout_marginStart="20dp"
        app:layout_constraintBottom_toTopOf="@+id/content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/popup_arrow_view_left"
        android:background="@drawable/ttlive_preview_toolbar_arrow"
        android:visibility="invisible"
        android:layout_width="10dp"
        android:layout_height="5dp"
        android:layout_marginLeft="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content"/>
    <View
        android:id="@+id/popup_arrow_view_center_bottom"
        android:background="@drawable/ttlive_preview_toolbar_arrow"
        android:visibility="invisible"
        android:layout_width="10dp"
        android:layout_height="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content"/>
    <View
        android:id="@+id/popup_arrow_view_center_top"
        android:background="@drawable/ttlive_preview_toolbar_arrow"
        android:visibility="gone"
        android:layout_width="10dp"
        android:layout_height="5dp"
        android:rotation="180"
        app:layout_constraintBottom_toTopOf="@+id/content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/content"
        android:background="@drawable/ttlive_bg_preview_toolbar_popup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/popup_arrow_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/popup_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            app:roundedCornerRadius="4dp"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/white"
            android:gravity="start|center_vertical"
            android:id="@+id/popup_content_textview"
            android:paddingLeft="11dp"
            android:paddingTop="11dp"
            android:paddingRight="11dp"
            android:paddingBottom="11dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="210dp"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"/>
        <ImageView
            android:gravity="center_vertical"
            android:id="@+id/popup_triangle"
            android:visibility="gone"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginRight="6dp"
            android:src="@drawable/ttlive_preview_toolbar_triangle"/>
    </LinearLayout>
    <View
        android:id="@+id/popup_arrow_view"
        android:background="@drawable/ttlive_preview_toolbar_arrow"
        android:visibility="gone"
        android:layout_width="10dp"
        android:layout_height="5dp"
        android:layout_marginRight="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content"/>
</androidx.constraintlayout.widget.ConstraintLayout>
