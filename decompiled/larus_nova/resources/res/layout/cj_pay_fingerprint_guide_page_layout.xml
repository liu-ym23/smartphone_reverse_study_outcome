<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/cj_pay_password_root_view"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="470dp">
    <ImageView
        android:id="@+id/cj_pay_verify_pwd_background_image"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/cj_pay_titlebar_root_view"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/cj_pay_view_titlebar_noise_reduction_layout"/>
    <TextView
        android:textSize="15dp"
        android:textColor="?attr/cj_pay_text_primary"
        android:id="@+id/cj_pay_merchant_name_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_titlebar_root_view"/>
    <include
        android:id="@+id/cj_pay_view_verify_amount_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_merchant_name_text"
        layout="@layout/cj_pay_view_verify_amount_layout"/>
    <include
        android:id="@+id/cj_pay_view_verify_discount_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_view_verify_amount_layout"
        layout="@layout/cj_pay_view_verify_discount_layout"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/pay_type_helper_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/cj_pay_view_verify_discount_layout">
        <View
            android:id="@+id/pay_type_helper_layout_divider_line"
            android:background="?attr/cj_pay_border_divider_grey_color"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"/>
        <include
            android:id="@+id/cj_pay_view_pay_type_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            layout="@layout/cj_pay_view_pay_type_bd_combine_layout"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/cj_pay_bd_counter_fingerprint_type_layout"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_custom_button_height_44"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_alignWithParentIfMissing="true">
            <com.android.ttcjpaysdk.base.ui.widget.LoadingButton
                android:textSize="15dp"
                android:textColor="@color/cj_pay_color_white"
                android:gravity="center"
                android:id="@+id/confirm_button"
                android:background="@drawable/cj_pay_bg_red_btn_radius_8"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cj_pay_custom_button_height_44"
                android:includeFontPadding="false"/>
            <ProgressBar
                android:id="@+id/cj_pay_confirm_button_loading"
                android:background="@color/cj_pay_color_trans"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminateOnly="true"
                android:indeterminateDrawable="@drawable/cj_pay_bg_loading_small_circle_white"
                android:indeterminateDuration="500"
                android:indeterminateBehavior="repeat"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
