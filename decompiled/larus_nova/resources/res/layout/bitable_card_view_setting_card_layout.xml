<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/bg_float"
    android:layout_width="match_parent"
    android:layout_height="84dp">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/bitable_card_view_setting_card_layout_top_bg"
        android:paddingLeft="19dp"
        android:paddingTop="16dp"
        android:paddingRight="14dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp">
        <View
            android:id="@+id/cover"
            android:background="@drawable/bitable_card_view_setting_card_layout_cover"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_marginRight="6dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginRight="5dp">
                <View
                    android:id="@+id/line1"
                    android:background="@drawable/bitable_card_view_setting_line_graph_blue_deep"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
                <View
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/colSelect1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:layout_weight="1">
                    <View
                        android:background="@drawable/bitable_card_view_setting_line_graph_blue_light"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"/>
                    <View
                        android:background="@drawable/bitable_card_view_setting_line_graph_blue_light"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="3dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/col_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:layout_weight="1">
                    <View
                        android:background="@drawable/bitable_card_view_setting_line_graph_blue_light"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"/>
                    <View
                        android:background="@drawable/bitable_card_view_setting_line_graph_blue_light"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="3dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/col_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:layout_weight="1">
                    <View
                        android:background="@drawable/bitable_card_view_setting_line_graph_blue_light"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"/>
                    <View
                        android:background="@drawable/bitable_card_view_setting_line_graph_blue_light"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="3dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/col_4"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:layout_weight="1">
                    <View
                        android:background="@drawable/bitable_card_view_setting_line_graph_blue_light"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"/>
                    <View
                        android:background="@drawable/bitable_card_view_setting_line_graph_blue_light"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="3dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/col_5"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:layout_weight="1">
                    <View
                        android:background="@drawable/bitable_card_view_setting_line_graph_blue_light"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"/>
                    <View
                        android:background="@drawable/bitable_card_view_setting_line_graph_blue_light"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="3dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/col_6"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:layout_weight="1">
                    <View
                        android:background="@drawable/bitable_card_view_setting_line_graph_blue_light"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"/>
                    <View
                        android:background="@drawable/bitable_card_view_setting_line_graph_blue_light"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="3dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="30dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/bitable_card_view_setting_text_color"
            android:layout_gravity="center"
            android:id="@+id/col_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</LinearLayout>
