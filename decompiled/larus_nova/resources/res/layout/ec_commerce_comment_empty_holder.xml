<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:background="@drawable/commerce_bg_comment_header_with_sort_button"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:id="@+id/empty_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/no_comment_iv"
            android:layout_width="136dp"
            android:layout_height="112dp"
            android:src="@drawable/commerce_comment_no_useful_comment"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/meaningless_layout"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="6dp">
            <TextView
                android:textSize="14sp"
                android:textColor="#99161823"
                android:layout_gravity="center_vertical"
                android:id="@+id/meaningless_comment_tv"
                android:layout_width="wrap_content"
                android:layout_height="21dp"
                android:text="@string/ec_meaningless_comment_notice"
                android:layout_weight="400"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/ec_right_arrow"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ec_comment_icon_meanless_right_arrow"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
