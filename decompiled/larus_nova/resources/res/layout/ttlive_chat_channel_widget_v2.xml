<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.livesdk.interactivity.chatchannel.v2.view.ChannelTrayListViewV2
        android:id="@+id/channel_avatar_view"
        android:layout_width="wrap_content"
        android:layout_height="38dp"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/room_channel_invalid_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <com.bytedance.android.livesdk.chatroom.ui.NoMoreSpaceTextView
            android:textSize="12dp"
            android:textColor="@color/ttlive_room_channel_invalid_hint"
            android:layout_gravity="center_vertical"
            android:id="@+id/room_channel_invalid_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/room_channel_valid_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp"
        android:layout_below="@+id/channel_avatar_view">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/room_channel_message_view"
            android:fadingEdgeLength="24dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:requiresFadingEdge="vertical"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/room_channel_message_hint_layout"
            android:background="@drawable/ttlive_bg_room_channel_msg_list_hint"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_alignParentBottom="true">
            <com.bytedance.android.livesdk.chatroom.ui.NoMoreSpaceTextView
                android:textSize="13dp"
                android:textColor="@color/ttlive_room_channel_msg_list_count_color"
                android:layout_gravity="center_vertical"
                android:id="@+id/room_channel_message_hint_text"
                android:paddingRight="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:paddingEnd="6dp"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/room_channel_guide_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="-12dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:layout_below="@+id/channel_avatar_view">
        <com.bytedance.android.livesdk.interactivity.chatchannel.view.ChatChannelBlurView
            android:id="@+id/blur_view_group"
            android:paddingTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/room_channel_guide_tv">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/encrypt_message_view"
                android:paddingLeft="12dp"
                android:fadingEdgeLength="12dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="12dp"
                android:layout_above="@+id/room_channel_guide_tv"
                android:requiresFadingEdge="vertical"/>
            <ImageView
                android:layout_gravity="bottom"
                android:id="@+id/mock_blur_view"
                android:background="@drawable/ttlive_chat_channel_encrypt_view"
                android:visibility="gone"
                android:layout_width="231dp"
                android:layout_height="160dp"/>
        </com.bytedance.android.livesdk.interactivity.chatchannel.view.ChatChannelBlurView>
        <com.bytedance.android.livesdk.chatroom.ui.NoMoreSpaceTextView
            android:textSize="14dp"
            android:textColor="@color/ttlive_hs_s38"
            android:layout_gravity="center_vertical"
            android:id="@+id/room_channel_guide_tv"
            android:background="@drawable/ttlive_bg_message_item_v2"
            android:paddingLeft="8dp"
            android:paddingTop="3dp"
            android:paddingRight="8dp"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:text="主播设置了粉丝团/群/会员频道，加入粉丝团可看到频道消息"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</RelativeLayout>
