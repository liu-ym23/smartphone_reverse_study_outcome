<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/content_view"
    android:background="@drawable/ttlive_bg_live_profile_header_drak"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_white_70"
            android:layout_gravity="center"
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_setting"/>
        <View
            android:layout_gravity="bottom"
            android:background="#1affffff"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
    </FrameLayout>
    <com.bytedance.android.livesdk.widget.MaxHeightScrollView
        android:id="@+id/scroll_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:maxHeight="432dp">
        <include layout="@layout/ttlive_dialog_live_profile_setting_drak"/>
    </com.bytedance.android.livesdk.widget.MaxHeightScrollView>
</LinearLayout>
