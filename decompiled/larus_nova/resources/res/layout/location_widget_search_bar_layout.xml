<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_body"
    android:paddingLeft="15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="11dp"
        android:src="@drawable/ud_icon_search_outline_outlined"
        android:layout_centerVertical="true"
        app:tint="@color/icon_n2"/>
    <com.suite.lark.emm.design.edittext.SCEditText
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_title"
        android:textColorHint="@color/text_placeholder"
        android:id="@+id/etSearchBar"
        android:background="@null"
        android:paddingTop="15dp"
        android:paddingRight="56dp"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/Lark_Legacy_Search"
        android:maxLines="1"
        android:layout_toRightOf="@+id/icon"
        android:inputType="text"/>
    <ImageView
        android:id="@+id/clearBtn"
        android:paddingLeft="19dp"
        android:paddingTop="14dp"
        android:paddingRight="19dp"
        android:paddingBottom="14dp"
        android:visibility="invisible"
        android:layout_width="56dp"
        android:layout_height="46dp"
        android:src="@drawable/ud_icon_close_filled"
        android:scaleType="centerInside"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        app:tint="@color/icon_n3"/>
</RelativeLayout>
