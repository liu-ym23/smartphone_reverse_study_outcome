<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="view_setting"
    android:background="@color/bg_float_base"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_placeholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Bitable_CardView_RecordDisplay_Text"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="146dp"
            android:layout_marginTop="8dp">
            <com.bytedance.ee.bear.bitable.uikit.setting.card.CardType
                android:id="@+id/card_type"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <com.bytedance.ee.bear.bitable.uikit.setting.card.GridType
                android:id="@+id/grid_type"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="4dp"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/mobileViewSettingLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_placeholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/Bitable_Mobile_CardMode_CardLayout_Title"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginTop="8dp">
                <com.bytedance.ee.bear.bitable.uikit.setting.card.CardLayout
                    android:id="@+id/colSelect1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
                <View
                    android:layout_width="4dp"
                    android:layout_height="wrap_content"/>
                <com.bytedance.ee.bear.bitable.uikit.setting.card.CardLayout
                    android:id="@+id/colSelect2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
                <View
                    android:layout_width="4dp"
                    android:layout_height="wrap_content"/>
                <com.bytedance.ee.bear.bitable.uikit.setting.card.CardLayout
                    android:id="@+id/colSelect3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_placeholder"
                android:id="@+id/coverTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/Bitable_Mobile_Configuration_Cover_Title"/>
            <com.larksuite.component.ignition.widget.setting_group.SettingGroupLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:hasDivider="false"
                app:itemBackgroundColor="@color/bitable_panel_view_item_tint_float_v2">
                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/text_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="22dp"
                            android:text="@string/Bitable_CardView_DisplayCover_Switch"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/text_placeholder"
                            android:layout_width="wrap_content"
                            android:layout_height="22dp"
                            android:layout_marginTop="2dp"
                            android:text="@string/Bitable_CardView_AttachmentFieldAsCover_Desc"/>
                    </LinearLayout>
                    <FrameLayout
                        android:layout_gravity="center"
                        android:id="@+id/cover_switcher_wrapper"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent">
                        <com.larksuite.component.universe_design.udswitch.UDSwitch
                            android:gravity="center"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/cover_switcher"
                            android:paddingRight="16dp"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"/>
                    </FrameLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/selectCoverFieldLayout"
                    android:paddingLeft="16dp"
                    android:paddingTop="13dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="21dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/text_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Bitable_Mobile_Configuration_Cover_Title"/>
                    <View
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/text_caption"
                        android:ellipsize="end"
                        android:id="@+id/coverFieldName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:layout_marginRight="8dp"
                        android:maxLines="1"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        app:srcCompat="@drawable/ud_icon_right_small_ccm_outlined"
                        app:tint="@color/icon_n3"/>
                </LinearLayout>
            </com.larksuite.component.ignition.widget.setting_group.SettingGroupLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_placeholder"
                android:id="@+id/configTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/Bitable_Mobile_CardMode_TitleSettings_Title"/>
            <com.bytedance.ee.bear.widgets.universedesign.SpaceSettingGroupLayout
                android:orientation="vertical"
                android:id="@+id/subTiltleContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:hasDivider="false"
                app:itemBackgroundColor="@color/bitable_panel_view_item_tint_float_v2">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/titleLayout"
                    android:paddingLeft="16dp"
                    android:paddingTop="21dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="13dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/text_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Bitable_Mobile_CardMode_TitleSettings_Title_Title"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/text_caption"
                        android:id="@+id/titleFieldName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"
                        android:text=""/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        app:srcCompat="@drawable/ud_icon_right_small_ccm_outlined"
                        app:tint="@color/icon_n3"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/summaryLayout"
                    android:paddingLeft="16dp"
                    android:paddingTop="13dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="21dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/text_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Bitable_Mobile_CardMode_TitleSettings_Subtitle_Title"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/text_caption"
                        android:id="@+id/summaryFieldName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"
                        android:text=""/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        app:srcCompat="@drawable/ud_icon_right_small_ccm_outlined"
                        app:tint="@color/icon_n3"/>
                </LinearLayout>
            </com.bytedance.ee.bear.widgets.universedesign.SpaceSettingGroupLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_placeholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/Bitable_Mobile_CardMode_FieldsToDisplay_Title"/>
            <com.larksuite.component.ui.layout.LKUIRoundableLayout
                android:id="@+id/selectFieldContainer"
                android:background="@color/bg_float"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:rl_radius="10dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/text_caption"
                    android:id="@+id/emptySelectTv"
                    android:paddingLeft="16dp"
                    android:paddingTop="13dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="13dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/Bitable_Mobile_CardMode_NoFieldsToDisplay_Description"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/selectFieldList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.larksuite.component.ui.layout.LKUIRoundableLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_placeholder"
                android:id="@+id/selectLimitTipsTv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_placeholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/Bitable_Mobile_CardMode_MoreFields_Title"/>
            <com.larksuite.component.ui.layout.LKUIRoundableLayout
                android:id="@+id/unSelectFieldContainer"
                android:background="@color/bg_float"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:rl_radius="10dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/text_caption"
                    android:id="@+id/emptyUnSelectTv"
                    android:paddingLeft="16dp"
                    android:paddingTop="13dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="13dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/Bitable_Mobile_CardMode_NoAvailableFields_Description"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/unSelectFieldList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.larksuite.component.ui.layout.LKUIRoundableLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_placeholder"
                android:id="@+id/hiddenFieldTv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
