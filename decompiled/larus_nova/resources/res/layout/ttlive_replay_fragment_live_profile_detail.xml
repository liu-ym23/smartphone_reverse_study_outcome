<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/ttlive_white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginLeft="32dp"
        android:layout_marginTop="@dimen/ttlive_replay_profile_name_margin_top"
        android:layout_marginRight="32dp"
        android:minHeight="29dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp">
        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/ttlive_replay_profile_name"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/new_verify_icon_except_media_room"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginLeft="4dp"
            android:layout_marginStart="4dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/gender_iv"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginLeft="4dp"
            android:layout_marginStart="4dp"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/verify_icon"
            android:visibility="gone"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginLeft="4dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/user_feature_label_list_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginStart="2dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/certification_layout"
        android:background="@drawable/ttlive_replay_bg_old_profile_gray_bg"
        android:paddingRight="7dp"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="6dp">
        <ImageView
            android:id="@+id/ttlive_profile_certification_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="6dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#b3161823"
            android:gravity="center_vertical"
            android:id="@+id/ttlive_profile_certification_text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="4dp"/>
        <ImageView
            android:id="@+id/ttlive_profile_certification_arrow"
            android:layout_width="4dp"
            android:layout_height="8dp"
            android:layout_marginLeft="5dp"
            android:src="@drawable/ttlive_replay_profile_certification_arrow_white"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/info_layout"
        android:paddingTop="@dimen/ttlive_replay_profile_info_padding_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="10dp"
            android:textColor="#333333"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/gender_text"
            android:background="@drawable/ttlive_replay_bg_user_card_gender_text"
            android:visibility="gone"
            android:layout_width="36dp"
            android:layout_height="22dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/location_and_account_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:minHeight="16dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">
            <ImageView
                android:id="@+id/location_iv"
                android:padding="1dp"
                android:layout_width="@dimen/ttlive_replay_profile_localiton_width"
                android:layout_height="@dimen/ttlive_replay_profile_localiton_height"
                android:src="@drawable/ttlive_replay_ic_profile_location"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ttlive_core_hs_g4"
                android:gravity="center_vertical"
                android:id="@+id/location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/location_iv"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/location_arrow"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ttlive_replay_ic_location_arrow"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/location"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/location_divider"
                android:background="@color/ttlive_core_hs_s9"
                android:layout_width="1dp"
                android:layout_height="8dp"
                android:layout_marginLeft="8dp"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/location_arrow"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ttlive_core_hs_g4"
                android:gravity="center_vertical"
                android:id="@+id/follower_v1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/location_divider"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/follower_divider"
                android:background="@color/ttlive_core_hs_s9"
                android:layout_width="1dp"
                android:layout_height="8dp"
                android:layout_marginLeft="8dp"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/follower_v1"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ttlive_core_hs_g4"
                android:gravity="center_vertical"
                android:id="@+id/following_v1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/follower_divider"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/following_divider"
                android:background="@color/ttlive_core_hs_s9"
                android:layout_width="1dp"
                android:layout_height="8dp"
                android:layout_marginLeft="8dp"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/following_v1"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ttlive_core_hs_g4"
                android:gravity="center_vertical"
                android:id="@+id/hotsoon_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/following_divider"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ttlive_white"
                android:gravity="center_vertical"
                android:id="@+id/special_id"
                android:background="@drawable/ttlive_replay_bg_special_code"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/following_divider"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/slide_view"
                android:background="@drawable/ttlive_replay_ic_slide"
                android:visibility="gone"
                android:layout_width="14dp"
                android:layout_height="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/special_id"
                app:layout_constraintTop_toTopOf="@+id/special_id"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ttlive_core_hs_g4"
        android:gravity="center"
        android:id="@+id/media_verify"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#999999"
        android:gravity="center"
        android:id="@+id/weibo_nickname"
        android:paddingTop="6dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/ttlive_core_hs_g3"
        android:gravity="center_horizontal"
        android:id="@+id/signature"
        android:paddingLeft="32dp"
        android:paddingTop="@dimen/ttlive_replay_profile_signature_padding_top"
        android:paddingRight="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3dp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"/>
    <include
        android:id="@+id/ttlive_profile_total_info"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/ttlive_replay_profile_total_info"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/ttlive_replay_profile_action_container_margin_top"/>
    <include
        android:id="@+id/action_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ttlive_replay_profile_action_container_height"
        layout="@layout/ttlive_replay_view_live_profile_action"/>
</LinearLayout>
