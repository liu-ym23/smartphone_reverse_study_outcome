<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/bg_border"
        android:background="@drawable/ttlive_bg_broadcast_more_action"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_white"
        android:id="@+id/title"
        android:padding="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_video_talk_integration_link_setting"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/fl_integration_enable"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_white"
            android:layout_gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:text="@string/ttlive_video_talk_integration_allow_audience_link"
            android:layout_marginStart="20dp"/>
        <Switch
            android:layout_gravity="end|center_vertical"
            android:id="@+id/switch_integration_enable"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginRight="16dp"
            android:checked="true"
            android:textOn=""
            android:textOff=""
            android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
            android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
            android:layout_marginEnd="16dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_switch_only_join_through_invitation"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintTop_toBottomOf="@+id/fl_integration_enable">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_white"
            android:layout_gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:text="@string/ttlive_video_talk_integration_only_by_invate"
            android:layout_marginStart="20dp"/>
        <Switch
            android:layout_gravity="end|center_vertical"
            android:id="@+id/switch_only_join_through_invitation"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginRight="16dp"
            android:checked="true"
            android:textOn=""
            android:textOff=""
            android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
            android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
            android:layout_marginEnd="16dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_only_accept_follower_apply"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintTop_toBottomOf="@+id/fl_switch_only_join_through_invitation">
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_white"
            android:layout_gravity="start|center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:text="@string/ttlive_video_talk_integration_only_fans_can_apply"
            android:layout_marginStart="20dp"/>
        <Switch
            android:layout_gravity="end|center_vertical"
            android:id="@+id/switch_only_accept_follower_apply"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginRight="16dp"
            android:checked="true"
            android:textOn=""
            android:textOff=""
            android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
            android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
            android:layout_marginEnd="16dp"/>
    </FrameLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="20dp"
        app:layout_constraintTop_toBottomOf="@+id/fl_only_accept_follower_apply"/>
</androidx.constraintlayout.widget.ConstraintLayout>
