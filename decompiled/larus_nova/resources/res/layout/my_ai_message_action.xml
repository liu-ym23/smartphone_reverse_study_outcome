<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/button_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:alignItems="baseline"
        app:dividerDrawable="@drawable/my_ai_message_button_divider"
        app:flexDirection="row"
        app:flexWrap="wrap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:showDividerHorizontal="middle"
        app:showDividerVertical="middle"/>
    <com.ss.android.lark.myai.view.MyAIShareActionView
        android:id="@+id/share"
        android:background="@drawable/my_ai_message_action_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/regenerate2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_container"
        app:layout_goneMarginTop="@dimen/my_ai_message_action_gone_margin_top"/>
    <View
        android:id="@+id/regenerate2"
        android:background="@drawable/my_ai_message_action_bg"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="39dp"
        android:layout_height="24dp"
        android:layout_marginTop="@dimen/my_ai_message_action_margin_top"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/share_space"
        app:layout_constraintStart_toEndOf="@+id/share"
        app:layout_constraintTop_toBottomOf="@+id/button_container"
        app:layout_goneMarginTop="@dimen/my_ai_message_action_gone_margin_top"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/regenerate2_icon"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:scaleType="fitXY"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/regenerate2"
        app:layout_constraintStart_toStartOf="@+id/regenerate2"
        app:layout_constraintTop_toTopOf="@+id/regenerate2"
        app:srcCompat="@drawable/ud_icon_reset_outlined"
        app:tint="@color/icon_n2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/regenerate2_arrow"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:scaleType="fitXY"
        android:layout_marginStart="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/regenerate2"
        app:layout_constraintStart_toEndOf="@+id/regenerate2_icon"
        app:layout_constraintTop_toTopOf="@+id/regenerate2"
        app:srcCompat="@drawable/ud_icon_down_small_ccm_outlined"
        app:tint="@color/icon_n2"/>
    <androidx.legacy.widget.Space
        android:id="@+id/share_space"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/copy"
        app:layout_constraintStart_toEndOf="@+id/regenerate2"
        app:layout_constraintTop_toBottomOf="@+id/button_container"
        app:layout_constraintWidth_min="1px"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/copy"
        android:background="@drawable/my_ai_message_action_bg"
        android:padding="@dimen/my_ai_message_action_icon_padding"
        android:layout_width="@dimen/my_ai_message_action_icon_size"
        android:layout_height="@dimen/my_ai_message_action_icon_size"
        android:layout_marginTop="3dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/export_doc"
        app:layout_constraintStart_toEndOf="@+id/share_space"
        app:layout_constraintTop_toBottomOf="@+id/button_container"
        app:layout_goneMarginTop="@dimen/my_ai_message_action_gone_margin_top"
        app:srcCompat="@drawable/ud_icon_copy_outlined"
        app:tint="@color/icon_n2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/export_doc"
        android:background="@drawable/my_ai_message_action_bg"
        android:padding="@dimen/my_ai_message_action_icon_padding"
        android:layout_width="@dimen/my_ai_message_action_icon_size"
        android:layout_height="@dimen/my_ai_message_action_icon_size"
        android:layout_marginTop="3dp"
        android:scaleType="fitXY"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/like"
        app:layout_constraintStart_toEndOf="@+id/copy"
        app:layout_constraintTop_toBottomOf="@+id/button_container"
        app:layout_goneMarginTop="@dimen/my_ai_message_action_gone_margin_top"
        app:srcCompat="@drawable/ud_icon_file_link_docx_outlined"
        app:tint="@color/icon_n2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/like"
        android:background="@drawable/my_ai_message_action_bg"
        android:padding="@dimen/my_ai_message_action_icon_padding"
        android:layout_width="@dimen/my_ai_message_action_icon_size"
        android:layout_height="@dimen/my_ai_message_action_icon_size"
        android:layout_marginTop="@dimen/my_ai_message_action_margin_top"
        android:scaleType="fitXY"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/dislike"
        app:layout_constraintStart_toEndOf="@+id/export_doc"
        app:layout_constraintTop_toBottomOf="@+id/button_container"
        app:layout_goneMarginTop="@dimen/my_ai_message_action_gone_margin_top"
        app:srcCompat="@drawable/my_ai_action_like"
        app:tint="@color/my_ai_action_like_tint"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/dislike"
        android:background="@drawable/my_ai_message_action_bg"
        android:padding="@dimen/my_ai_message_action_icon_padding"
        android:layout_width="@dimen/my_ai_message_action_icon_size"
        android:layout_height="@dimen/my_ai_message_action_icon_size"
        android:layout_marginTop="@dimen/my_ai_message_action_margin_top"
        android:scaleType="fitXY"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/regenerate"
        app:layout_constraintStart_toEndOf="@+id/like"
        app:layout_constraintTop_toBottomOf="@+id/button_container"
        app:layout_goneMarginTop="@dimen/my_ai_message_action_gone_margin_top"
        app:srcCompat="@drawable/my_ai_action_dislike"
        app:tint="@color/icon_n2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/regenerate"
        android:background="@drawable/my_ai_message_action_bg"
        android:padding="@dimen/my_ai_message_action_icon_padding"
        android:layout_width="@dimen/my_ai_message_action_icon_size"
        android:layout_height="@dimen/my_ai_message_action_icon_size"
        android:layout_marginTop="@dimen/my_ai_message_action_margin_top"
        android:scaleType="fitXY"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/dislike"
        app:layout_constraintTop_toBottomOf="@+id/button_container"
        app:layout_goneMarginTop="@dimen/my_ai_message_action_gone_margin_top"/>
</androidx.constraintlayout.widget.ConstraintLayout>
