<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content_view"
    android:paddingTop="@dimen/ttlive_solo_ktv_content_pading"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/top_region"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="73dp"
        app:layout_constraintTop_toBottomOf="@+id/st_topbar"/>
    <View
        android:id="@+id/mask_top"
        android:background="@drawable/ttlive_solo_ktv_practice_vertical_page_mask"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/mask_bottom"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/mask_bottom"
        android:background="#80000000"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <FrameLayout
        android:id="@+id/content_region"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_region"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_region"
        app:layout_constraintVertical_weight="1">
        <com.bytedance.android.live.soloktv.view.LyricSeekLine
            android:layout_gravity="center_vertical"
            android:id="@+id/lyr_seek_line"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="24dp"/>
        <TextView
            android:textSize="20dp"
            android:textColor="#e8ffffff"
            android:layout_gravity="center_horizontal"
            android:id="@+id/lyric_empty_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/ttlive_ktv_component_no_lyric_hint_text"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/bottom_region"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="21dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#ffffff"
        android:gravity="center_vertical"
        android:id="@+id/mci_skip_prelude"
        android:background="@drawable/ttlive_solo_ktv_skip_prelude_bg"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="25dp"
        android:layout_marginBottom="7dp"
        android:text="@string/ttlive_solo_ktv_skip_prelude_txt"
        app:layout_constraintBottom_toTopOf="@+id/bottom_region"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <com.bytedance.android.live.soloktv.view.SoloKtvTopBar
        android:id="@+id/st_topbar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintTop_toTopOf="parent"
        app:rightMenuType="fragmentSing"/>
    <TextView
        android:textSize="17sp"
        android:textColor="#e1ffffff"
        android:id="@+id/top_music_name"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:shadowColor="@color/black"
        android:shadowDx="2"
        android:shadowDy="3"
        android:shadowRadius="3"
        android:marqueeRepeatLimit="marquee_forever"
        app:layout_constraintBottom_toBottomOf="@+id/st_topbar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/st_topbar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
