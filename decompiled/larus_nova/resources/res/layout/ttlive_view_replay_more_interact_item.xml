<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/action_area"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:minHeight="74dp">
    <FrameLayout
        android:id="@+id/icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="fitXY"
        android:layout_centerHorizontal="true"/>
    <com.bytedance.android.livesdk.chatroom.ui.RedDotView
        android:id="@+id/red_dot"
        android:background="@drawable/ttlive_ic_red_point_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/icon"
        android:layout_alignRight="@+id/icon"/>
    <TextView
        android:textSize="7dp"
        android:textColor="@color/ttlive_more_dialog_desc_text"
        android:gravity="center_horizontal"
        android:id="@+id/icon_description"
        android:background="@drawable/ttlive_bg_audience_more_dialog_text_state"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_alignLeft="@+id/icon"
        android:layout_alignBottom="@+id/icon"
        android:textAlignment="center"
        android:layout_alignStart="@+id/icon"/>
    <TextView
        android:textSize="11dp"
        android:textColor="#80161823"
        android:gravity="center"
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
    <com.bytedance.android.livesdk.common.LiveViewStub
        android:id="@+id/icon_switch"
        android:layout_width="13dp"
        android:layout_height="8dp"
        android:layout_alignRight="@+id/icon"
        android:layout_alignBottom="@+id/icon"
        android:layout_alignEnd="@+id/icon"/>
</RelativeLayout>
