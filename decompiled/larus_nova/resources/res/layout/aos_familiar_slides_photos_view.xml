<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_view"
    android:background="@color/aos_const_bg_inverse"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.awemeopen.apps.framework.feed.pages.recommend.photo.ui.SlidesPhotosViewPager
        android:id="@+id/photos_viewpager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/aos_feed_bottom_linear_gradient"
        android:background="@drawable/aos_feed_bottom_linear_gradient"
        android:layout_width="match_parent"
        android:layout_height="314dp"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/progress_bar_mask"
        android:background="@drawable/aos_familiar_progress_bar_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="24dp"/>
    <com.bytedance.awemeopen.apps.framework.feed.pages.recommend.photo.ui.StyleEdgeTransparentView2
        android:layout_gravity="bottom"
        android:id="@+id/progress_bar_edge_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="2dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <com.bytedance.awemeopen.apps.framework.feed.pages.recommend.photo.ui.progress.StoryListProgressBar
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:id="@+id/progress_bar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="22dp"/>
    </com.bytedance.awemeopen.apps.framework.feed.pages.recommend.photo.ui.StyleEdgeTransparentView2>
</FrameLayout>
