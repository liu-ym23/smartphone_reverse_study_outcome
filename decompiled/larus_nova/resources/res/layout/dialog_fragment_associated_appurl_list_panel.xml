<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.widgets.panel.CommonActionPanelLayout
        android:id="@+id/associated_url_list_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:panel_custom_left_icon="@drawable/ud_icon_close_small_outlined"
        app:panel_enable_drag="false">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/associated_url_list"
            android:background="@color/bg_body"
            android:paddingBottom="@dimen/space_kit_len_16"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.bytedance.ee.bear.widgets.panel.CommonActionPanelLayout>
</FrameLayout>
