<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/space_kit_len_52">
    <com.bytedance.ee.bear.bitable.common.widgets.SyncIconImageView
        android:id="@+id/leftIconIV"
        android:visibility="gone"
        android:layout_width="@dimen/space_kit_len_20"
        android:layout_height="@dimen/space_kit_len_20"
        android:tint="@color/bitable_selector_item_icon_color"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/space_kit_len_12"
        android:layout_alignParentStart="true"/>
    <FrameLayout
        android:id="@+id/rightContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true">
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_placeholder"
            android:ellipsize="end"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/rightDescTV"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_marginEnd="@dimen/space_kit_len_44"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="end|center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.larksuite.component.universe_design.badge.UDBadgeView
                android:id="@+id/guideBadge"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/space_kit_len_16"
                android:layout_marginEnd="@dimen/space_kit_len_12"
                app:ud_badge_text="@string/Bitable_Common_NewStatus"
                style="@style/UDBadge.Text"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/rightIconIv"
                android:visibility="gone"
                android:layout_width="@dimen/space_kit_len_16"
                android:layout_height="@dimen/space_kit_len_16"
                android:tint="@color/icon_n3"
                android:layout_marginEnd="@dimen/space_kit_len_16"/>
        </LinearLayout>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/space_kit_font_16"
        android:textColor="@color/bitable_selector_item_text_color"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/titleTV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/space_kit_len_16"
        android:layout_toStartOf="@+id/rightContainer"
        android:layout_toEndOf="@+id/leftIconIV"/>
</merge>
