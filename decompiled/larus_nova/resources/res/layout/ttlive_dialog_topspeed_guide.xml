<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/root_topspeed_guide"
    android:background="@drawable/ttlive_bg_top_speed_guide"
    android:layout_width="match_parent"
    android:layout_height="280dp">
    <ImageView
        android:id="@+id/icon_topspeed_close"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:src="@drawable/icon_top_speed_guide_close"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
    <ImageView
        android:id="@+id/icon_topspeed_guide"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="30dp"
        android:src="@drawable/icon_top_speed_guide"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:id="@+id/title_topspeed_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="极速性能模式"
        android:layout_below="@+id/icon_topspeed_guide"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#bf161823"
        android:gravity="center"
        android:id="@+id/desc_topspeed_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:layout_below="@+id/title_topspeed_guide"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/open_switch"
        android:background="@drawable/ttlive_top_speed_guide_bg"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:text="立即开启"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
