<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab"
        android:layout_width="170dp"
        android:layout_height="match_parent"
        app:tabBackground="@color/ttlive_white"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/ttlive_black"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="2dp"
        app:tabSelectedTextColor="@color/ttlive_black"
        app:tabTextAppearance="@style/InteractTextStyle"
        app:tabTextColor="#4c000000"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="right"
        android:orientation="horizontal"
        android:id="@+id/anchor_operation_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14dp"
                android:textColor="#88000000"
                android:gravity="center"
                android:id="@+id/set"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/ttlive_setting"/>
            <View
                android:layout_gravity="end|top"
                android:id="@+id/setting_guide_dot"
                android:background="@drawable/ttlive_interact_audience_setting_guide_dot"
                android:visibility="gone"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="2dp"/>
        </FrameLayout>
        <View
            android:background="#40161823"
            android:layout_width="1dp"
            android:layout_height="11dp"/>
        <TextView
            android:textSize="14dp"
            android:textColor="#88000000"
            android:gravity="center"
            android:id="@+id/close"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="8dp"
            android:text="@string/ttlive_interact_close_link"/>
    </LinearLayout>
    <TextView
        android:textSize="14dp"
        android:textColor="#88000000"
        android:gravity="center"
        android:layout_gravity="end"
        android:id="@+id/admin_operation"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/ttlive_video_talk_room_audio_apply"/>
</FrameLayout>
