<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="76dp">
    <TextView
        android:textSize="13dp"
        android:textStyle="bold"
        android:textColor="@color/shopping_color_231616"
        android:id="@+id/tv_live_rec"
        android:layout_width="14dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:text="@string/shopping_live_rec"
        android:includeFontPadding="false"
        android:lineSpacingExtra="1dp"
        android:lineSpacingMultiplier="0.8"/>
    <com.bytedance.android.shopping.widget.banner.PrimeHorizontalRecyclerView
        android:id="@+id/rv_live_avatar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:overScrollMode="never"/>
</LinearLayout>
