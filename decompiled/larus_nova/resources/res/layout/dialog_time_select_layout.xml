<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/dialog_white_corner_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.ss.android.lark.ui.CommonTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tb_back_icon="@drawable/ud_icon_close_small_outlined"
        app:tb_background="@color/transparent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/time_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="68dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/start_time_ll"
            android:background="@drawable/start_time_btn_pressed_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingEnd="0dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/static_white"
                android:id="@+id/start_time_label_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/Lark_Search_SearchStartingTimeFilter"/>
            <TextView
                android:textSize="17sp"
                android:textColor="@color/static_white"
                android:id="@+id/start_time_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/end_time_ll"
            android:background="@drawable/end_time_btn_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="24dp"
            android:paddingEnd="0dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_placeholder"
                android:id="@+id/end_time_label_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/Lark_Search_SearchEndingTimeFilter"/>
            <TextView
                android:textSize="17sp"
                android:textColor="@color/text_title"
                android:id="@+id/end_time_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/time_controller_bg"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/time_ll"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/year_month_select_cl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        app:layout_constraintBottom_toBottomOf="@+id/time_controller_bg"
        app:layout_constraintStart_toStartOf="@+id/time_controller_bg"
        app:layout_constraintTop_toTopOf="@+id/time_controller_bg">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/back_to_days_mode"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ud_icon_left_outlined"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_title"
            android:gravity="center"
            android:id="@+id/current_month_label_tv"
            android:background="@drawable/bg_search_text"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/back_to_days_mode"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginStart="5dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/last_month_btn_iv"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/time_controller_bg"
        app:layout_constraintStart_toEndOf="@+id/year_month_select_cl"
        app:layout_constraintTop_toTopOf="@+id/time_controller_bg"
        app:srcCompat="@drawable/ud_icon_left_outlined"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/next_month_btn_iv"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/time_controller_bg"
        app:layout_constraintStart_toEndOf="@+id/last_month_btn_iv"
        app:layout_constraintTop_toTopOf="@+id/time_controller_bg"
        app:srcCompat="@drawable/ud_icon_right_outlined"/>
    <RelativeLayout
        android:id="@+id/time_select_no_limit_rl"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginEnd="22dp"
        app:layout_constraintBottom_toBottomOf="@+id/time_controller_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/next_month_btn_iv"
        app:layout_constraintTop_toTopOf="@+id/time_controller_bg">
        <com.larksuite.component.ui.button.LKUICheckBox
            android:id="@+id/time_select_no_limit_cb"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:checked="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_title"
            android:id="@+id/time_select_no_limit_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Lark_Search_AnyTime"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@+id/time_select_no_limit_cb"/>
    </RelativeLayout>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/days_mode_group"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="last_month_btn_iv,next_month_btn_iv,days_picker"/>
    <com.ss.android.lark.widget.timepicker.monthview.MonthViewContainer
        android:id="@+id/days_picker"
        android:layout_width="match_parent"
        android:layout_height="253dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/time_controller_bg"/>
    <com.ss.android.lark.widget.timepicker.YearMonthPicker
        android:id="@+id/year_month_picker"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="253dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/time_controller_bg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
