<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/larus_base_2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minWidth="400dp"
    android:layout_centerInParent="true">
    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/chameleonv1_ud_icon_left_outlined"
        android:tint="@color/larus_neutral_70"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"/>
    <androidx.appcompat.widget.AppCompatSeekBar
        android:id="@+id/seekbar_font_size"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxHeight="4dp"
        android:indeterminate="false"
        android:progressDrawable="@drawable/larus_seekbar_rounded_style"
        android:thumb="@drawable/larus_icon_switch_thumb"
        android:layout_centerVertical="true"
        android:paddingStart="@dimen/dp_14"
        android:paddingEnd="12dp"
        android:layout_toStartOf="@+id/tv_font_size_value"
        android:layout_toEndOf="@+id/iv_back"/>
    <TextView
        android:textSize="@dimen/dp_17"
        android:textColor="@color/larus_neutral_100"
        android:gravity="end|center_vertical"
        android:id="@+id/tv_font_size_value"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:minWidth="?attr/larus_dp_70"
        android:layout_centerVertical="true"
        android:fontFamily="sans-serif-medium"
        android:layout_marginEnd="20dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
