<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ec_comment_gallery_expandable_textview_layout_863889438"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ec_comment_gallery_expandable_textview_layout_1211544290"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15sp"
            android:ellipsize="end"
            android:id="@+id/ec_tv_expand_text_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="12dp"
            android:gravity="center"
            android:layout_gravity="end|bottom"
            android:id="@+id/ec_collapsed_text_status_btn"
            android:background="@drawable/ec_bg_expand_textview_btn_shape"
            android:paddingLeft="5dp"
            android:paddingTop="1.5dp"
            android:paddingRight="5dp"
            android:paddingBottom="1.5dp"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"/>
    </LinearLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/commerce_color_FFFFFF"
        android:gravity="center"
        android:layout_gravity="end|bottom"
        android:id="@+id/ec_expand_text_status_btn"
        android:background="@drawable/ec_bg_expand_textview_btn_shape"
        android:paddingLeft="5dp"
        android:paddingTop="1.5dp"
        android:paddingRight="5dp"
        android:paddingBottom="1.5dp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
