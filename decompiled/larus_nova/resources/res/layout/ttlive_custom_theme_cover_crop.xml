<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:background="@color/ttlive_std_bg_primary_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.livesdk.widget.crop.SwitchModeFrameLayout
        android:id="@+id/crop_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="parent">
        <com.bytedance.android.livesdk.widget.crop.PinchImageView
            android:id="@+id/crop_pinch_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.live.liveinteract.bgComponent.theme.VideoThemeView
            android:id="@+id/ttlive_crop_video"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.livesdk.widget.crop.PreviewBoxViewV2
            android:id="@+id/ttlive_iv_cover_window"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.bytedance.android.livesdk.widget.crop.SwitchModeFrameLayout>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_std_text_white_1"
        android:gravity="center_vertical"
        android:id="@+id/tv_cancel"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginBottom="34dp"
        android:text="@string/ttlive_confirm_not_close"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_std_text_white_1"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginBottom="27dp"
        android:text="@string/ttlive_custom_theme_crop_area"
        android:alpha="0.5"
        app:layout_constraintBottom_toTopOf="@+id/tv_confirm"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_std_text_white_1"
        android:gravity="center_vertical"
        android:id="@+id/tv_confirm"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginBottom="34dp"
        android:text="@string/ttlive_confirm_close"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
