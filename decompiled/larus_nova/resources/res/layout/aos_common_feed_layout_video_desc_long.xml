<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/desc_container_fl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp">
    <FrameLayout
        android:id="@+id/description_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp">
        <com.bytedance.awemeopen.apps.framework.feed.desc.ScrollMentionTextView
            android:textSize="@dimen/aos_feed_desc_text_size"
            android:textColor="@color/aos_const_text_inverse2"
            android:ellipsize="end"
            android:gravity="start"
            android:layout_gravity="center_vertical"
            android:id="@+id/desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="4"
            android:includeFontPadding="false"
            android:shadowColor="@color/aos_sd_tertiary"
            android:shadowDy="1"
            android:shadowRadius="1"
            android:lineSpacingExtra="3dp"
            android:textAlignment="viewStart"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="end|bottom"
        android:id="@+id/container_toggle"
        android:paddingTop="4dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView
            android:textSize="@dimen/aos_feed_desc_text_size"
            android:textStyle="bold"
            android:textColor="@color/aos_const_text_inverse2"
            android:gravity="bottom|center_horizontal"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/tv_toggle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="27dp"
            android:minWidth="36dp"
            android:minHeight="19dp"
            android:text="展开"/>
    </FrameLayout>
</FrameLayout>
