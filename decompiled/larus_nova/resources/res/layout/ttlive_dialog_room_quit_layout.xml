<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/dialog_room_quit_layout"
    android:background="@drawable/ttlive_bg_room_quit_dialog"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/top_image_container"
        android:layout_width="wrap_content"
        android:layout_height="130dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="5dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="0dp"
            android:layout_alignParentLeft="true"
            android:layout_marginStart="0dp">
            <ImageView
                android:layout_gravity="center"
                android:background="@drawable/ttlive_bg_room_quit_img"
                android:layout_width="130dp"
                android:layout_height="130dp"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="center"
                android:id="@+id/image_left"
                android:layout_width="90dp"
                android:layout_height="90dp"
                app:placeholderImage="@drawable/ttlive_img_avatar_empty"
                app:roundAsCircle="true"
                app:roundingBorderColor="@color/white"
                app:roundingBorderWidth="0.5dp"/>
        </FrameLayout>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="70dp"
            android:layout_alignParentLeft="true"
            android:layout_marginStart="70dp">
            <ImageView
                android:layout_gravity="center"
                android:background="@drawable/ttlive_bg_room_quit_img"
                android:layout_width="130dp"
                android:layout_height="130dp"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="center"
                android:id="@+id/image_middle"
                android:layout_width="89dp"
                android:layout_height="89dp"
                app:placeholderImage="@drawable/ttlive_img_avatar_empty"
                app:roundAsCircle="true"
                app:roundingBorderColor="@color/white"
                app:roundingBorderWidth="0.5dp"/>
        </FrameLayout>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="140dp"
            android:layout_alignParentLeft="true"
            android:layout_marginStart="140dp">
            <ImageView
                android:layout_gravity="center"
                android:background="@drawable/ttlive_bg_room_quit_img"
                android:layout_width="130dp"
                android:layout_height="130dp"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="center"
                android:id="@+id/image_right"
                android:layout_width="90dp"
                android:layout_height="90dp"
                app:placeholderImage="@drawable/ttlive_img_avatar_empty"
                app:roundAsCircle="true"
                app:roundingBorderColor="@color/white"
                app:roundingBorderWidth="0.5dp"/>
        </FrameLayout>
    </RelativeLayout>
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_room_quit_title"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/room_quit_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/ttlive_live_guide_feed_recommend_more_anchor"/>
    <View
        android:id="@+id/live_dialog_divider_1"
        android:layout_marginTop="24dp"
        style="@style/ttlive_live_dialog_divider_horizontal"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/room_quit_button_layout"
        android:layout_width="match_parent"
        android:layout_height="47dp">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_dialog_room_quit_close"
            android:gravity="center"
            android:id="@+id/room_quit_button_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/ttlive_live_play_close"
            android:maxLines="1"
            android:lines="1"
            android:layout_weight="1"/>
        <View
            android:id="@+id/live_dialog_divider_2"
            android:background="@color/ttlive_ppx_c5"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/room_quit_button_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/ttlive_live_play_close_find_more_anchor"
            android:maxLines="1"
            android:lines="1"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
