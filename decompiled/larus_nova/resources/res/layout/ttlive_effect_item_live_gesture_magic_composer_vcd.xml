<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:focusable="true"
    android:layout_width="68dp"
    android:layout_height="56dp"
    android:importantForAccessibility="yes">
    <ImageView
        android:id="@+id/image"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginLeft="2dp"
        android:src="@drawable/ttlive_effect_ic_gesture_yeah"
        android:layout_alignParentLeft="true"
        android:layout_centerInParent="true"
        android:layout_marginStart="2dp"
        android:layout_alignParentStart="true"/>
    <View
        android:id="@+id/background"
        android:background="@drawable/ttlive_effect_bg_dialog_gesture_select"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentLeft="true"
        android:layout_centerInParent="true"
        android:layout_alignParentStart="true"/>
    <View
        android:id="@+id/red_point"
        android:background="@drawable/ttlive_effect_core_bg_red_point"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_alignTop="@+id/image"
        android:layout_alignRight="@+id/image"
        android:layout_alignEnd="@+id/image"/>
    <ImageView
        android:id="@+id/download_icon"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="@drawable/ttlive_effect_ic_sticker_download_new_style"
        android:scaleType="fitXY"
        android:layout_alignRight="@+id/image"
        android:layout_alignBottom="@+id/image"
        android:layout_alignEnd="@+id/image"/>
    <ProgressBar
        android:id="@+id/loading"
        android:visibility="gone"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_alignRight="@+id/image"
        android:layout_alignBottom="@+id/image"
        android:layout_alignEnd="@+id/image"
        style="@android:style/Widget.ProgressBar.Small"/>
</RelativeLayout>
