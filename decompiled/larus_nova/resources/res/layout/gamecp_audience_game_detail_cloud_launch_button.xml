<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cloud_game_launch_btn_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/cloud_game_launch_btn"
        android:background="@drawable/shape_bg_14fe2c55_corner_8"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedance.android.gamecp.common.ui.HSImageView
                android:id="@+id/cloud_launch_btn_icon"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="2dp"
                app:actualImageScaleType="centerCrop"
                app:failureImage="@drawable/gamecp_cloud_launch_btn_icon"
                app:failureImageScaleType="centerCrop"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/gamecp_game_FE2C55"
                android:ellipsize="end"
                android:id="@+id/cloud_launch_btn_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gamecp_mini_game_instant_play"
                android:singleLine="true"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/cloud_launch_btn_sub_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="13dp"
            android:layout_marginTop="-1dp">
            <com.bytedance.android.gamecp.common.ui.HSImageView
                android:id="@+id/cloud_launch_btn_sub_icon"
                android:layout_width="10.5dp"
                android:layout_height="13dp"
                android:layout_marginBottom="2dp"
                android:layout_marginEnd="1dp"
                app:actualImageScaleType="centerCrop"
                app:failureImage="@drawable/gamecp_cloud_launch_btn_icon"
                app:failureImageScaleType="centerCrop"/>
            <TextView
                android:textSize="9dp"
                android:textColor="@color/gamecp_game_FE2C55"
                android:ellipsize="end"
                android:id="@+id/cloud_launch_btn_sub_txt"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/gamecp_anchor_team_building"
                android:singleLine="true"
                android:paddingEnd="1dp"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/cloud_game_play_with_download_btn"
        android:background="@drawable/shape_bg_14fe2c55_corner_8"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <LinearLayout
            android:layout_gravity="center"
            android:id="@+id/ll_default_play_with_download"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/cloud_play_with_download_btn_icon"
                android:visibility="visible"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/gamecp_ic_flash_red"
                android:layout_marginEnd="2dp"/>
            <TextView
                android:textSize="15dp"
                android:textColor="@color/gamecp_game_FE2C55"
                android:ellipsize="end"
                android:id="@+id/cloud_play_with_download_btn_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gamecp_play_with_download"
                android:singleLine="true"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center"
            android:id="@+id/ll_play_the_same_game"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15dp"
                android:textColor="@color/gamecp_game_FE2C55"
                android:ellipsize="end"
                android:id="@+id/tv_play_the_same_game"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gamecp_play_the_same_game2"
                android:singleLine="true"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
