<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:id="@+id/action_item"
    android:background="?attr/larus_bg_sug_bar"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/action_multi_selected_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="?attr/larus_primary_50"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_action_selected_item_text"
            android:layout_width="wrap_content"
            android:layout_height="?attr/larus_dp_22"
            android:maxWidth="?attr/larus_dp_100"
            android:maxLines="1"
            android:drawablePadding="?attr/larus_dp_6"
            android:layout_marginStart="?attr/larus_dp_10"
            app:drawableStartCompat="?attr/larus_chat_action_bar"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/tv_action_selected_item_icon"
            android:layout_width="?attr/larus_dp_22"
            android:layout_height="?attr/larus_dp_22"
            android:layout_marginStart="?attr/larus_dp_10"
            app:srcCompat="?attr/larus_ic_regenerate"/>
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_action_selected_divider"
            android:background="?attr/larus_primary_transparent_3"
            android:layout_width="0.5dp"
            android:layout_height="?attr/larus_dp_16"
            android:layout_marginStart="?attr/larus_dp_10"/>
        <FrameLayout
            android:id="@+id/iv_action_selected_end_button_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_action_selected_end_button"
                android:padding="?attr/larus_dp_7"
                android:layout_width="?attr/larus_dp_36"
                android:layout_height="?attr/larus_dp_36"
                app:srcCompat="?attr/larus_icon_regenerate_arrow_down"/>
        </FrameLayout>
    </LinearLayout>
</merge>
