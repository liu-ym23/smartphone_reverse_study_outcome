<?xml version="1.0" encoding="utf-8"?>
<com.larus.common_ui.widget.roundlayout.RoundLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="?attr/larus_dp_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:rv_backgroundColor="?attr/larus_base_2"
    app:rv_cornerRadius_TL="?attr/larus_dp_16"
    app:rv_cornerRadius_TR="?attr/larus_dp_16">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_66">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="end"
            android:id="@+id/share_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_24"
            android:layout_marginEnd="?attr/larus_dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/share_close"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/share_close"
            android:padding="?attr/larus_dp_8"
            android:layout_width="?attr/larus_dp_44"
            android:layout_height="?attr/larus_dp_44"
            android:contentDescription="@android:string/cancel"
            android:layout_marginEnd="?attr/larus_dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="?attr/larus_ic_close_dialog_btn"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:background="?attr/larus_neutral_transparent_1"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_1"/>
    <FrameLayout
        android:id="@+id/share_panel_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/larus_dp_120">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/share_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</com.larus.common_ui.widget.roundlayout.RoundLinearLayout>
