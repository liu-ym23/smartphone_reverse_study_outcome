<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/office_bottom_photo_select_container"
    android:background="@drawable/larus_office_sdk_slides_image_insert_dialog_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/office_bottom_title_and_menu_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:layout_gravity="center_horizontal"
            android:background="@drawable/larus_office_sdk_slides_image_insert_top_indicator_bg"
            android:layout_width="?attr/larus_dp_36"
            android:layout_height="?attr/larus_dp_4"
            android:layout_marginTop="?attr/larus_dp_6"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/office_bottom_menu_container"
            android:paddingLeft="?attr/larus_dp_12"
            android:paddingTop="?attr/larus_dp_8"
            android:paddingRight="?attr/larus_dp_12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_6">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/doc_bottom_menu_item_camera"
                android:background="@drawable/larus_office_sdk_slides_image_insert_grid_item_bg"
                android:paddingTop="?attr/larus_dp_13"
                android:paddingBottom="?attr/larus_dp_13"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/layout_menu_item_icon_camera"
                    android:layout_width="?attr/larus_dp_40"
                    android:layout_height="?attr/larus_dp_40"
                    android:src="@drawable/larus_office_sdk_slides_image_insert_camera_icon"
                    android:scaleType="centerInside"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_dp_13"
                    android:textColor="@color/larus_neutral_70"
                    android:gravity="center_vertical"
                    android:id="@+id/layout_menu_item_name"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="?attr/larus_dp_17"
                    android:text="@string/larus_camera"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/doc_bottom_menu_item_photo"
                android:background="@drawable/larus_office_sdk_slides_image_insert_grid_item_bg"
                android:paddingTop="?attr/larus_dp_13"
                android:paddingBottom="?attr/larus_dp_13"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="?attr/larus_dp_8">
                <ImageView
                    android:layout_width="?attr/larus_dp_40"
                    android:layout_height="?attr/larus_dp_40"
                    android:src="@drawable/larus_office_sdk_slides_image_insert_album_icon"
                    android:scaleType="centerInside"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_dp_13"
                    android:textColor="@color/larus_neutral_70"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="?attr/larus_dp_17"
                    android:text="@string/larus_photos"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
