<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/debug_container"
    android:background="@color/commonui_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="54dp">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_channel_debug_title"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <View
        android:background="#cccccc"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_channel_debug_title_enter_from_merge"/>
        <EditText
            android:textSize="14dp"
            android:textColor="@color/black"
            android:layout_gravity=""
            android:id="@+id/channel_test_enter_from_merge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_channel_debug_title_enter_method"/>
        <EditText
            android:textSize="14dp"
            android:textColor="@color/black"
            android:id="@+id/channel_test_enter_method"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <RadioGroup
        android:id="@+id/channel_type_choice_btn"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_channel_debug_type"/>
        <com.bytedance.android.uicomponent.compoundbutton.TranslucentRadioButton
            android:textColor="@color/black"
            android:id="@+id/inner_flow_btn"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:checked="true"
            android:text="@string/ttlive_channel_debug_inner_flow_type"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            style="@style/ttlive_standard_radio_button_style"/>
        <com.bytedance.android.uicomponent.compoundbutton.TranslucentRadioButton
            android:textColor="@color/black"
            android:id="@+id/outer_flow_btn"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/ttlive_channel_debug_outer_flow_type"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            style="@style/ttlive_standard_radio_button_style"/>
        <com.bytedance.android.uicomponent.compoundbutton.TranslucentRadioButton
            android:textColor="@color/black"
            android:id="@+id/drawer_flow_btn"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/ttlive_channel_debug_drawer_flow_type"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            style="@style/ttlive_standard_radio_button_style"/>
    </RadioGroup>
    <com.bytedance.android.uicomponent.button.UIButton
        android:id="@+id/preview_url_btn"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:layout_width="match_parent"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="8dp"
        android:text="@string/ttlive_channel_debug_preview_url_btn"
        style="@style/uicomponent_button_style_primary_l"/>
    <TextView
        android:textColor="@color/black"
        android:id="@+id/preview_url_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="8dp"/>
    <com.bytedance.android.uicomponent.button.UIButton
        android:layout_gravity="bottom"
        android:id="@+id/preview_feed_btn"
        android:layout_width="match_parent"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="8dp"
        android:text="@string/ttlive_channel_debug_preview_feed_btn"
        style="@style/uicomponent_button_style_primary_l"/>
</LinearLayout>
