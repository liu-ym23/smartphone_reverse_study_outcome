<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/autonumberRuleOptContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/facade_round_around_xl"
        android:padding="@dimen/space_kit_len_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_kit_len_2"
        android:layout_marginBottom="@dimen/space_kit_len_14"
        android:minHeight="@dimen/space_kit_len_52"
        android:backgroundTint="@color/bg_float">
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Bitable_Field_AutoIdPreviewMobileVer"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_title"
            android:id="@+id/autonumberPreviewTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/space_kit_len_16"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/space_kit_font_14"
        android:textColor="@color/text_placeholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_kit_len_4"
        android:text="@string/Bitable_Field_AddAutoIdRuleMobileVer"/>
    <com.larksuite.component.ui.layout.LKUIRoundableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_kit_len_16"
        app:rl_radius="@dimen/space_radius_xl">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ruleListRV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.larksuite.component.ui.layout.LKUIRoundableLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/addNewRuleContainer"
        android:background="@drawable/facade_round_around_xl"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_kit_len_48"
        android:layout_marginBottom="@dimen/space_kit_len_16"
        android:paddingStart="@dimen/space_kit_len_16"
        android:paddingEnd="@dimen/space_kit_len_16"
        android:backgroundTint="@color/facade_selector_item_float">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/addNewRuleIcon"
            android:layout_width="@dimen/space_kit_len_20"
            android:layout_height="@dimen/space_kit_len_20"
            android:tint="@color/bitable_field_edit_highlight_tint"
            app:srcCompat="@drawable/ud_icon_add_outlined"/>
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/bitable_field_edit_highlight_tint"
            android:ellipsize="end"
            android:id="@+id/addNewRuleTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Bitable_Field_AddAutoIdRuleMobileVer"
            android:singleLine="true"
            android:layout_marginStart="@dimen/space_kit_len_12"/>
    </LinearLayout>
</LinearLayout>
