<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_body"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larksuite.component.universe_design.tab.UDTabLayout
        android:id="@+id/ud_tab"
        android:background="@color/bg_body"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:ud_tab_bottomDividerEnabled="true"
        app:ud_tab_gravity="start"
        app:ud_tab_indicatorFullWidth="false"
        app:ud_tab_layoutPaddingStart="6dp"
        app:ud_tab_minWidth="0dp"
        app:ud_tab_mode="auto"
        app:ud_tab_tabMargin="12dp">
        <com.larksuite.component.universe_design.tab.UDTabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Bitable_FeedCenter_All_Tab"/>
        <com.larksuite.component.universe_design.tab.UDTabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Bitable_FeedCenter_Unread_Tab"/>
        <com.larksuite.component.universe_design.tab.UDTabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Bitable_FeedCenter_Mentioned_Tab"/>
    </com.larksuite.component.universe_design.tab.UDTabLayout>
    <com.bytedance.ee.bear.bitable.uikit.empty.EmptyView
        android:id="@+id/empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="68dp"
        android:layout_marginRight="68dp"/>
    <com.scwang.smartrefresh.layout.SmartRefreshLayout
        android:id="@+id/refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:srlEnableLoadMore="true"
        app:srlEnableOverScrollBounce="false"
        app:srlEnableOverScrollDrag="false"
        app:srlEnablePreviewInEditMode="true"
        app:srlEnableRefresh="false">
        <com.bytedance.ee.bear.bitable.msgcenter.view.BitableMsgCenterList
            android:id="@+id/msg_center_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
    </com.scwang.smartrefresh.layout.SmartRefreshLayout>
</LinearLayout>
