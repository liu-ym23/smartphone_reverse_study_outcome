<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/input_and_reply_zone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottom_container">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_reply"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/divider_reply"
                android:background="@color/line_border_card"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/layout_replay_content"
                android:background="@color/bg_body"
                android:layout_width="match_parent"
                android:layout_height="44dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btn_close_reply"
                    android:paddingLeft="15dp"
                    android:paddingRight="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:srcCompat="@drawable/reply_close"/>
                <View
                    android:id="@+id/divider_vertical"
                    android:background="@color/line_border_card"
                    android:layout_width="0.5dp"
                    android:layout_height="14dp"/>
                <com.ss.android.lark.widget.EllipsizedEmojiconTextView
                    android:textSize="14sp"
                    android:textColor="@color/text_placeholder"
                    android:textColorHint="@color/text_placeholder"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_root_msg"
                    android:paddingLeft="10dp"
                    android:paddingRight="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/Lark_Legacy_Reply"
                    android:maxLines="1"/>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/input_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:id="@+id/normal_message_et_layout"
                android:background="@color/bg_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:id="@+id/normal_separator"
                    android:background="@color/line_border_card"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/et_container"
                    android:background="@color/bg_body"
                    android:paddingLeft="16dp"
                    android:paddingTop="11dp"
                    android:paddingRight="7dp"
                    android:paddingBottom="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <include
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:layout_weight="1"
                        layout="@layout/kb_input_normal_editor_content2"/>
                    <FrameLayout
                        android:id="@+id/post_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/combined_btn"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_width="@dimen/keyboard_icon_desktop"
                            android:layout_height="@dimen/keyboard_icon_desktop"
                            android:tint="@color/kb_icon_color_selector"
                            android:layout_marginEnd="8dp"
                            app:srcCompat="@drawable/ud_icon_richtext_outlined"/>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_gravity="top|right"
                            android:id="@+id/post_draft_dot"
                            android:visibility="gone"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            app:srcCompat="@drawable/kb_post_draft_dot"/>
                    </FrameLayout>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/img_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:layout_marginBottom="@dimen/dp_8"
                    android:layout_marginStart="@dimen/dp_16"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/images_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:layout_marginBottom="@dimen/dp_8"
                    android:layout_marginStart="@dimen/dp_16"/>
            </LinearLayout>
        </FrameLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/function_danger_500"
            android:id="@+id/tv_error_hint"
            android:background="@color/bg_body"
            android:paddingTop="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
    <com.ss.android.lark.widget.slidingup.SlidingUpPanelLayout
        android:gravity="bottom"
        android:id="@+id/top_drawer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_container"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true">
        <View
            android:id="@+id/content"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.ss.android.lark.widget.slidingup.SlidingUpPanelLayout>
</RelativeLayout>
