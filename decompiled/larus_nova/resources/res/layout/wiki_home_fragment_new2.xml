<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.scwang.smartrefresh.layout.SmartRefreshLayout
        android:id="@+id/list_refresh_layout"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:srlEnableLoadMore="false"
        app:srlEnableOverScrollBounce="false"
        app:srlEnableOverScrollDrag="false"
        app:srlEnablePreviewInEditMode="true"
        app:srlEnableRefresh="true">
        <com.bytedance.ee.bear.facade.common.widget.recyclerview.CircleRefreshHeader
            android:id="@+id/list_refresh_header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/list_home_title_bar_height_min"/>
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/list_home_coordinator_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/list_sub_menu_layout"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_behavior="com.bytedance.ee.bear.list.homepage.FlingBehavior">
                <com.google.android.material.appbar.CollapsingToolbarLayout
                    android:id="@+id/list_collapsing_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/wiki_title_bar_height_min"
                    app:layout_scrollFlags="enterAlwaysCollapsed|enterAlways|scroll">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.bytedance.ee.bear.facade.common.widget.recyclerview.CircleRefreshHeader
                            android:id="@+id/list_appbar_refresh_header"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/list_home_title_bar_height_min"/>
                        <com.bytedance.ee.bear.facade.common.widget.NoNetworkView
                            android:id="@+id/no_net_container"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <FrameLayout
                            android:id="@+id/list_notification_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <com.bytedance.ee.bear.wikiv2.home2.WikiHomeTopSpaceView
                            android:id="@+id/homeTopSpaceView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </com.google.android.material.appbar.CollapsingToolbarLayout>
                <com.bytedance.ee.bear.list.homepage.title.HomeSubTitleView
                    android:id="@+id/home_sub_title_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:title="@string/Doc_Wiki_Home_RecentTitle"/>
            </com.google.android.material.appbar.AppBarLayout>
            <com.bytedance.ee.bear.wikiv2.home2.WikiHomeRecentSpaceView
                android:id="@+id/homeRecentSpaceView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="com.bytedance.ee.bear.list.homepage.KeepWithinParentBoundsScrollingBehavior"/>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </com.scwang.smartrefresh.layout.SmartRefreshLayout>
    <com.bytedance.ee.bear.widgets.button.CommonCreateButton
        android:layout_gravity="end|bottom"
        android:id="@+id/homeCreateBtn"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</FrameLayout>
