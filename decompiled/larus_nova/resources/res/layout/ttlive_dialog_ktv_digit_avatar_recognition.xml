<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/digit_avatar_recognition_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/recognitionResultLayout"
        android:background="@drawable/ttlive_bg_dialog_ktv_sing_mode_setting_dialog"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/previewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/avatarImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/followFaceBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:layout_constraintBottom_toTopOf="@+id/reRecognitionBtn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <View
                android:background="@drawable/ttlive_ktv_sing_mode_fttlive_ktv_sing_mode_follow_face_selector"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginRight="6dp"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:textSize="13dp"
                android:textColor="#fff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_ktv_avatar_follow_face"/>
        </LinearLayout>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/ttlive_ktv_avatar_re_recognition_text_color"
            android:gravity="center"
            android:id="@+id/reRecognitionBtn"
            android:background="@drawable/ttlive_bg_ktv_avatar_re_recognition_btn"
            android:layout_width="166dp"
            android:layout_height="44dp"
            android:layout_marginBottom="18dp"
            android:text="@string/ttlive_ktv_avatar_recognition_redo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/okBtn"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="15dp"
            android:textColor="#fff"
            android:gravity="center"
            android:id="@+id/okBtn"
            android:background="@drawable/ttlive_bg_ktv_avatar_btn_common_red"
            android:layout_width="166dp"
            android:layout_height="44dp"
            android:text="@string/ttlive_ok"
            app:layout_constraintBottom_toBottomOf="@+id/reRecognitionBtn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toEndOf="@+id/reRecognitionBtn"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/recognitionLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/photoPreviewImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/openPhotoBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/ttlive_ktv_sing_mode_photo_icon"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toStartOf="@+id/openCameraBtn"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/openCameraBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/ttlive_ktv_sing_mode_camera_icon"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/loadingLayout"
        android:background="@drawable/ttlive_bg_dialog_ktv_sing_mode_setting_dialog"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_gravity="center"
            android:layout_width="50dp"
            android:layout_height="50dp">
            <com.bytedance.android.livesdk.chatroom.ui.LiveDoubleColorBallAnimationView
                android:layout_gravity="center"
                android:id="@+id/douyinLoadingView"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="30dp"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/hotsoonLoadingView"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ttlive_ic_category_loading"/>
        </FrameLayout>
        <TextView
            android:textSize="12dp"
            android:textColor="#fff"
            android:id="@+id/loadingTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_ktv_avatar_resource_loading"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/userAgreementLayout"
        android:background="@drawable/ttlive_bg_dialog_ktv_sing_mode_setting_dialog"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/agreementBackView"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/ttlive_ic_btn_back_white"
            android:scaleType="fitXY"
            android:layout_marginStart="16dp"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/agreementIcon"
                android:layout_width="303dp"
                android:layout_height="205dp"
                android:scaleType="fitXY"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/agreementTitleViewContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="17dp"
                    android:textColor="#e6ffffff"
                    android:id="@+id/agreementTitleView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"/>
                <ImageView
                    android:id="@+id/digitAvatarRecognitionRule"
                    android:layout_width="23dp"
                    android:layout_height="23dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/ttlive_icon_digit_avatar_rule_icon"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <TextView
                android:textSize="15dp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/agreementOkBtn"
                android:background="#19ffffff"
                android:layout_width="230dp"
                android:layout_height="44dp"
                android:layout_marginTop="48dp"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
