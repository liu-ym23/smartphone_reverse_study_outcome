<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="88dp">
    <View
        android:id="@+id/select_bg"
        android:background="@drawable/ttlive_bg_camera_selected_gradient"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout
        android:id="@+id/v_cover"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ttlive_allRadius="6dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/cover"
            android:layout_width="120dp"
            android:layout_height="68dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="@drawable/ttlive_camera_place_holder"
            app:placeholderImageScaleType="focusCrop"
            app:roundedCornerRadius="6dp"/>
        <FrameLayout
            android:id="@+id/playing_container"
            android:background="@drawable/ttlive_bg_matchroom_camera_playing"
            android:layout_width="120dp"
            android:layout_height="68dp"
            app:layout_constraintBottom_toBottomOf="@+id/cover"
            app:layout_constraintLeft_toLeftOf="@+id/cover"
            app:layout_constraintRight_toRightOf="@+id/cover"
            app:layout_constraintTop_toTopOf="@+id/cover">
            <com.airbnb.lottie.LottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/living_view"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:scaleType="centerCrop"
                app:lottie_autoPlay="false"
                app:lottie_loop="true"/>
        </FrameLayout>
        <TextView
            android:textSize="11dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="start|top"
            android:id="@+id/paid_tips"
            android:background="@drawable/ttlive_vs_camera_paid_tips"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:layout_width="wrap_content"
            android:layout_height="15dp"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginStart="6dp"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="start|top"
            android:id="@+id/vr_icon"
            android:background="@drawable/ttlive_multi_vr_icon"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="17dp"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp"/>
    </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="10dp"
        android:singleLine="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toRightOf="@+id/v_cover"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/area_buy_ticket"
        android:layout_width="68dp"
        android:layout_height="match_parent"
        android:layout_marginRight="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#e5ffffff"
        android:gravity="center"
        android:id="@+id/btn_buy_ticket"
        android:background="@drawable/ttlive_bg_camera_paid_buy_button"
        android:layout_width="68dp"
        android:layout_height="24dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="16dp"
        android:textAlignment="center"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
