<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="34dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="48dp"
    android:paddingEnd="48dp">
    <ImageView
        android:id="@+id/action_close"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:src="@drawable/ttlive_format_voice_chat_close_icon"
        app:layout_constraintBottom_toBottomOf="@+id/action_container"
        app:layout_constraintEnd_toStartOf="@+id/action_container"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/action_container"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_container"
        android:layout_width="wrap_content"
        android:layout_height="66dp"
        app:layout_constraintEnd_toStartOf="@+id/action_mute"
        app:layout_constraintStart_toEndOf="@+id/action_close"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="15sp"
            android:textColor="#99ffffff"
            android:id="@+id/action_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ttlive_format_voice_chat_connecting"
            app:fontFamily="PingFang SC"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/action_interrupt_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/action_interrupt_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/ttlive_format_voice_chat_action_intercept_drawable"
                app:layout_constraintBottom_toTopOf="@+id/action_interrupt_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="spread_inside"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#99ffffff"
                android:id="@+id/action_interrupt_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_format_voice_chat_interrupt"
                app:fontFamily="PingFang SC"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/action_interrupt_icon"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/action_listening_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/action_listening_icon"
                android:layout_width="38dp"
                android:layout_height="20dp"
                android:layout_marginTop="10dp"
                app:layout_constraintBottom_toTopOf="@+id/action_listening_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="spread_inside"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#99ffffff"
                android:id="@+id/action_listening_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_format_voice_chat_listening"
                app:fontFamily="PingFang SC"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/action_listening_icon"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/action_waiting_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/action_waiting_icon"
                android:layout_width="38dp"
                android:layout_height="10dp"
                android:layout_marginTop="15dp"
                android:src="@drawable/ttlive_format_voice_chat_waiting"
                app:layout_constraintBottom_toTopOf="@+id/action_waiting_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="spread_inside"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#99ffffff"
                android:id="@+id/action_waiting_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_format_voice_chat_waiting"
                app:fontFamily="PingFang SC"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/action_waiting_icon"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/action_mute"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:src="@drawable/ttlive_format_voice_chat_mute_icon"
        app:layout_constraintBottom_toBottomOf="@+id/action_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/action_container"
        app:layout_constraintTop_toTopOf="@+id/action_container"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#57ffffff"
        android:id="@+id/action_tip"
        android:layout_width="wrap_content"
        android:layout_height="21dp"
        android:layout_marginTop="34dp"
        android:text="@string/ttlive_format_voice_chat_action_tip"
        app:fontFamily="PingFang SC"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
