<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.common_ui.widget.roundlayout.RoundConstraintLayout
        android:layout_gravity="bottom"
        android:paddingLeft="?attr/larus_dp_20"
        android:paddingTop="?attr/larus_dp_20"
        android:paddingRight="?attr/larus_dp_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:rv_backgroundColor="@color/larus_base_2"
        app:rv_cornerRadius_TL="?attr/larus_dp_20"
        app:rv_cornerRadius_TR="?attr/larus_dp_20">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="?attr/larus_dp_16"
            android:paddingRight="?attr/larus_dp_16"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/neutral_100"
                android:gravity="center"
                android:id="@+id/dora_g_env_observe_timer_dialog_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_12"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_14"
                android:textColor="@color/larus_neutral_70"
                android:gravity="center"
                android:id="@+id/dora_g_env_observe_timer_dialog_tips"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_6"
                android:layout_marginBottom="?attr/larus_dp_6"
                android:text="@string/larus_dora_g_3k_overheat_stop_cn"
                android:textAlignment="center"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/time_layout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="?attr/larus_dp_18"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_8"
                android:layout_marginBottom="?attr/larus_dp_16">
                <com.larus.dora.impl.view.DoraTextView
                    android:textSize="?attr/larus_sp_16"
                    android:textColor="@color/larus_dora_env_observe_btn_text_color"
                    android:gravity="center"
                    android:id="@+id/dora_g_env_observe_timer_dialog_cancel"
                    android:background="@null"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxHeight="?attr/larus_dp_56"
                    android:minHeight="?attr/larus_dp_56"
                    android:text="@string/larus_dora_dialog_btn_cancel_cn"
                    android:layout_weight="1"/>
                <com.larus.dora.impl.view.DoraTextView
                    android:textSize="?attr/larus_sp_16"
                    android:textColor="@color/larus_static_white"
                    android:gravity="center"
                    android:id="@+id/dora_g_env_observe_timer_dialog_confirm"
                    android:background="@null"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxHeight="?attr/larus_dp_56"
                    android:minHeight="?attr/larus_dp_56"
                    android:text="@string/larus_dora_dialog_btn_confirm_cn"
                    android:layout_weight="1"
                    android:layout_marginStart="?attr/larus_dp_12"/>
            </LinearLayout>
        </LinearLayout>
    </com.larus.common_ui.widget.roundlayout.RoundConstraintLayout>
</FrameLayout>
