<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#66000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/center_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.48">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/progress_time"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="7dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="24dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="end|center_vertical"
                android:id="@+id/tv_cur_time"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginRight="6dp"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:textSize="17sp"
                android:textColor="@color/white"
                android:id="@+id/time_middle_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_vs_thumb_process_time_middle_line"
                android:alpha="0.5"/>
            <TextView
                android:textSize="18dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/tv_total_time"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:layout_marginLeft="4dp"
                android:alpha="0.5"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/hot_label"
            android:layout_width="29dp"
            android:layout_height="15dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="2dp"
            android:src="@drawable/ttlive_replay_ic_hot_label"
            android:layout_marginEnd="2dp"
            app:layout_constraintEnd_toStartOf="@+id/thumb_title"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="@+id/progress_time"
            app:layout_constraintTop_toBottomOf="@+id/progress_time"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/ttlive_std_text_white_1"
            android:gravity="center"
            android:id="@+id/thumb_title"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            app:layout_constraintEnd_toEndOf="@+id/progress_time"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/hot_label"
            app:layout_constraintTop_toBottomOf="@+id/progress_time"/>
        <com.bytedance.android.livesdk.chatroom.replay.player.seekbar.ReplaySeekBar
            android:id="@+id/portrait_thumb_process"
            android:layout_width="180dp"
            android:layout_height="26dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/progress_time"
            app:ttlive_background_progress_color="#4dffffff"
            app:ttlive_progress_height="2dp"
            app:ttlive_round_point_style="true"
            app:ttlive_secondary_progress_color="@color/transparent"
            app:ttlive_thumb_radius_on_dragging="1dp"
            app:ttlive_track_color="#ffffffff"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
