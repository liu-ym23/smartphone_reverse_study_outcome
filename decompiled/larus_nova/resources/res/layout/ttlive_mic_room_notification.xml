<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="22dp">
    <View
        android:id="@+id/background"
        android:background="@drawable/ttlive_bg_round_item"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_icon"
        app:layout_constraintLeft_toLeftOf="@+id/iv_icon"
        app:layout_constraintRight_toRightOf="@+id/tv_content"
        app:layout_constraintTop_toTopOf="@+id/iv_icon"/>
    <ImageView
        android:id="@+id/iv_icon"
        android:padding="4dp"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ttlive_mic_room_official_logo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ttlive_mic_room_highlight"
        android:gravity="center"
        android:id="@+id/tv_content"
        android:paddingRight="9dp"
        android:layout_width="104dp"
        android:layout_height="20dp"
        android:text="@string/ttlive_mic_room_living"
        android:maxLines="1"
        android:drawableRight="@drawable/ttlive_mic_room_triangle"
        android:layout_centerVertical="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/iv_icon"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
