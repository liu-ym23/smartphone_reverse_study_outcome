<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/ec_tabkit_nav_bar_close"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
            android:layout_gravity="center"
            android:id="@+id/ec_brand_mall_nav_bar_close_iv"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ec_store_brand_mall_nav_back"
            android:contentDescription="@string/ec_tabkit_nav_back_description"/>
    </FrameLayout>
    <com.bytedance.android.shopping.store.tabkit.view.RightItemView
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ec_tabkit_nav_bar_right_container"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginRight="11dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
