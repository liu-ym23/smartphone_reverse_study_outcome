<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_view"
    android:padding="2dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/right_icon_iv"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        app:srcCompat="@drawable/ud_icon_active_speaker_view_outlined"/>
    <com.larksuite.component.universe_design.badge.UDBadgeView
        android:layout_gravity="top"
        android:id="@+id/right_badge_view"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-2dp"
        android:layout_marginStart="14dp"
        style="@style/UDBadge.Dot.StrongReminder.Medium"/>
</FrameLayout>
