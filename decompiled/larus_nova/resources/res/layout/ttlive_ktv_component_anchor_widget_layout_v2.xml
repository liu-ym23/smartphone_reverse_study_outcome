<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constraintHorizontal_chainStyle="packed">
    <com.bytedance.android.livesdk.ktvimpl.ktvroom.view.midi.KtvComponentMidiView
        android:id="@+id/ktv_component_midi_view"
        android:visibility="gone"
        android:layout_width="265dp"
        android:layout_height="@dimen/ttlive_ktv_component_new_midi_height"
        android:layout_marginEnd="@dimen/ttlive_ktv_component_midi_end_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.ktvimpl.ktvroom.challenge.ui.KtvComponentChallengeProgressView
        android:id="@+id/ktv_component_challenge_progress_view"
        android:visibility="gone"
        android:layout_width="169dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/ktv_component_operate_panel_container"
        android:visibility="gone"
        android:layout_width="183dp"
        android:layout_height="28dp"
        android:layout_marginRight="15dp"
        android:layout_marginEnd="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/ktv_float_ball_placeholder"
        app:layout_constraintRight_toRightOf="@+id/ktv_float_ball_placeholder"
        app:layout_constraintTop_toTopOf="@+id/ktv_float_ball_placeholder"/>
    <include layout="@layout/ttlive_ktv_component_lyric_contain_layout"/>
    <include layout="@layout/ttlive_ktv_prepare_sing_info_container_layout"/>
    <include layout="@layout/ttlive_ktv_component_float_ball_ktv_layout"/>
    <View
        android:id="@+id/ktv_float_ball_placeholder"
        android:layout_width="@dimen/ttlive_ktv_float_ball_view_size"
        android:layout_height="@dimen/ttlive_ktv_float_ball_view_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ktv_component_midi_view"/>
    <com.bytedance.android.live.ktv.common.midi.KtvMidiView
        android:id="@+id/midi_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/ktv_float_ball_placeholder"/>
    <com.bytedance.android.live.ktv.common.midi.KtvHitAnimationView
        android:id="@+id/hit_animation"
        android:layout_width="68dp"
        android:layout_height="100dp"
        app:layout_constraintBottom_toBottomOf="@+id/midi_view"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/each_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="35dp"
        android:layout_marginTop="48dp"
        android:scaleX="2"
        android:scaleY="2"
        android:layout_marginStart="35dp"
        app:layout_constraintRight_toRightOf="@+id/hit_animation"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
