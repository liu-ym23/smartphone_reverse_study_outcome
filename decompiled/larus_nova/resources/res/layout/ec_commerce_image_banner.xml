<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_image_container"
    android:background="@color/white"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="fitCenter"
        app:placeholderImage="@drawable/ec_ecommerce_slogan_product_bg"
        app:placeholderImageScaleType="centerCrop"/>
    <com.bytedance.android.shopping.widget.RemoteRoundImageView
        android:id="@+id/atmosphere_image"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
</FrameLayout>
