<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_room_center_dialog"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:minWidth="280dp">
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="#404040"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/room_center_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#808080"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/room_center_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="15dp"
        android:lineSpacingExtra="2dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"/>
    <View
        android:id="@+id/live_dialog_divider_1"
        android:layout_marginTop="24dp"
        style="@style/ttlive_live_dialog_divider_horizontal"/>
    <Button
        android:id="@+id/room_center_button"
        android:visibility="gone"
        style="@style/ttlive_live_dialog_button_vertical"/>
    <include
        android:id="@+id/room_center_button_layout"
        layout="@layout/ttlive_dialog_item_room_center_two_btn_layout"/>
</LinearLayout>
