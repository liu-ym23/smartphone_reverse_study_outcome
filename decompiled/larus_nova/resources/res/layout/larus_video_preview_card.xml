<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/cover_container"
        android:layout_width="?attr/larus_dp_300"
        android:layout_height="?attr/larus_dp_400"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/cover_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:failureImage="?attr/larus_base_2_overlay"
            app:placeholderImage="?attr/larus_base_2_overlay"
            app:roundedCornerRadius="?attr/larus_dp_8"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/video_download"
        android:background="@drawable/larus_bg_gray_btn_radius_8"
        android:layout_width="?attr/larus_dp_30"
        android:layout_height="?attr/larus_dp_30"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:src="@drawable/larus_ic_download_white_shadow"
        android:layout_marginStart="?attr/larus_dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/dp_12"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/video_extend"
        android:background="@drawable/larus_bg_gray_btn_radius_8"
        android:paddingLeft="@dimen/dp_10"
        android:paddingRight="@dimen/dp_10"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_30"
        android:layout_marginBottom="@dimen/dp_8"
        android:text="@string/larus_extendVideo_label_btn_extend"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ProgressBar
        android:id="@+id/video_download_loading"
        android:background="@drawable/larus_bg_gray_btn_radius_8"
        android:padding="?attr/larus_dp_8"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/larus_ic_common_download_loading_animated"
        android:indeterminateDuration="2000"
        app:layout_constraintBottom_toBottomOf="@+id/video_download"
        app:layout_constraintEnd_toEndOf="@+id/video_download"
        app:layout_constraintStart_toStartOf="@+id/video_download"
        app:layout_constraintTop_toTopOf="@+id/video_download"/>
    <ImageView
        android:id="@+id/play_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_12"
        android:src="@drawable/larus_action_button_icon"
        android:layout_marginEnd="?attr/larus_dp_12"
        app:layout_constraintEnd_toEndOf="@+id/cover_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="?attr/larus_neutral_70"
        android:gravity="center_vertical"
        android:id="@+id/regenerate_btn"
        android:background="?attr/larus_bg_prompt_vertical"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="?attr/larus_dp_38"
        android:layout_marginTop="?attr/larus_dp_12"
        android:layout_marginBottom="?attr/larus_dp_12"
        android:text="@string/larus_generate_again"
        android:drawablePadding="?attr/larus_dp_4"
        android:paddingStart="?attr/larus_dp_12"
        android:paddingEnd="?attr/larus_dp_12"
        app:drawableEndCompat="?attr/larus_arow_right"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cover_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
