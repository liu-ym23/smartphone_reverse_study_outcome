<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/gift_empty_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/gift_panel_view"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/gift_panel_view"
        android:background="@drawable/ttlive_bg_gift_new_panel"
        android:layout_width="match_parent"
        android:layout_height="383dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:roundTopLeft="true"
        app:roundTopRight="true"
        app:roundedCornerRadius="8dp"/>
    <FrameLayout
        android:id="@+id/top_view_container"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="300dp"
        app:layout_constraintBottom_toTopOf="@+id/gift_panel_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.legacy.widget.Space
        android:id="@+id/space"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="@+id/top_operation_parent"/>
    <FrameLayout
        android:id="@+id/forbiden_notice"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        app:layout_constraintBottom_toTopOf="@+id/space"/>
    <FrameLayout
        android:id="@+id/search_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/gift_panel_view"
        app:layout_constraintEnd_toEndOf="@+id/gift_panel_view"
        app:layout_constraintStart_toStartOf="@+id/gift_panel_view"
        app:layout_constraintTop_toTopOf="@+id/gift_panel_view"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_operation_parent"
        android:clipChildren="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ttlive_gift_top_operation_container_height"
        app:layout_constraintEnd_toEndOf="@+id/gift_panel_view"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/gift_panel_view"
        app:layout_constraintTop_toTopOf="@+id/gift_panel_view">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <FrameLayout
                android:id="@+id/top_operation_container"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/top_exchange_area_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:translationZ="-3dp"
        app:layout_constraintBottom_toTopOf="@+id/gift_panel_view"
        app:layout_constraintEnd_toEndOf="@+id/gift_panel_view"
        app:layout_constraintStart_toStartOf="@+id/gift_panel_view"/>
    <FrameLayout
        android:id="@+id/expand_view"
        android:layout_width="0dp"
        android:layout_height="@dimen/ttlive_gift_bottom_bar_container_height"
        app:layout_constraintEnd_toStartOf="@+id/recharge_container"
        app:layout_constraintStart_toStartOf="@+id/gift_panel_view"
        app:layout_constraintTop_toBottomOf="@+id/top_operation_parent"/>
    <FrameLayout
        android:id="@+id/gift_list_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/gift_panel_view"
        app:layout_constraintLeft_toLeftOf="@+id/gift_panel_view"
        app:layout_constraintRight_toRightOf="@+id/gift_panel_view"
        app:layout_constraintTop_toBottomOf="@+id/tab_container"/>
    <FrameLayout
        android:id="@+id/user_info_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/ttlive_gift_bottom_bar_container_height"
        app:layout_constraintBottom_toTopOf="@+id/tab_container"
        app:layout_constraintEnd_toEndOf="@+id/gift_panel_view"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/gift_panel_view"/>
    <FrameLayout
        android:id="@+id/topic_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        app:layout_constraintStart_toStartOf="@+id/gift_panel_view"
        app:layout_constraintTop_toBottomOf="@+id/tab_container"/>
    <FrameLayout
        android:id="@+id/recharge_container"
        android:layout_width="0dp"
        android:layout_height="@dimen/ttlive_gift_bottom_bar_container_height"
        app:layout_constraintEnd_toEndOf="@+id/gift_panel_view"
        app:layout_constraintTop_toTopOf="@+id/tab_container"/>
    <FrameLayout
        android:id="@+id/first_charge_tip_container"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginBottom="42dp"
        app:layout_constraintBottom_toBottomOf="@+id/tab_container"
        app:layout_constraintEnd_toEndOf="@+id/gift_panel_view"
        app:layout_constraintStart_toStartOf="@+id/gift_panel_view"/>
    <FrameLayout
        android:id="@+id/gift_combo_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/dynamic_panel_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/gift_list_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/dynamic_panel_old_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/tab_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/detail_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/tab_container"
        app:layout_constraintEnd_toEndOf="@+id/gift_panel_view"
        app:layout_constraintTop_toTopOf="@+id/gift_panel_view"/>
    <FrameLayout
        android:id="@+id/tab_container"
        android:layout_width="0dp"
        android:layout_height="@dimen/ttlive_gift_bottom_bar_container_height"
        app:layout_constraintEnd_toStartOf="@+id/recharge_container"
        app:layout_constraintStart_toStartOf="@+id/gift_panel_view"
        app:layout_constraintTop_toBottomOf="@+id/top_operation_parent"/>
    <FrameLayout
        android:id="@+id/select_receiver_container"
        android:visibility="visible"
        android:layout_width="191dp"
        android:layout_height="34dp"
        app:layout_constraintBottom_toTopOf="@+id/gift_panel_view"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/group_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ttlive_gift_top_operation_container_height"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toTopOf="@+id/tab_container"
        app:layout_constraintEnd_toEndOf="@+id/gift_panel_view"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/gift_panel_view"/>
    <FrameLayout
        android:id="@+id/group_container_parent"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="59dp"
        app:layout_constraintEnd_toEndOf="@+id/gift_panel_view"
        app:layout_constraintStart_toStartOf="@+id/gift_panel_view"
        app:layout_constraintTop_toTopOf="@+id/gift_panel_view"/>
    <com.bytedance.android.livesdk.gift.platform.business.dialog.v3.mviview.GestureCheckView
        android:id="@+id/search_gesture_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="428dp"
        app:layout_constraintBottom_toBottomOf="@+id/gift_panel_view"
        app:layout_constraintEnd_toEndOf="@+id/gift_panel_view"
        app:layout_constraintStart_toStartOf="@+id/gift_panel_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
