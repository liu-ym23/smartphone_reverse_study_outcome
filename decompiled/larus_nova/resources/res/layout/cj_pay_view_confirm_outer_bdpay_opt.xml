<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_pay_payment_confirm_root_view"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/cj_pay_inner_root"
        android:background="@color/cj_pay_color_white"
        android:paddingTop="44dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="99dp">
        <ImageView
            android:id="@+id/cj_pay_iv_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/cj_pay_titlebar_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cj_pay_height_44">
                <ImageView
                    android:id="@+id/cj_pay_back_view"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginLeft="@dimen/cj_pay_font_size_16"
                    android:src="@drawable/cj_pay_ic_titlebar_close_onlight"
                    android:scaleType="centerCrop"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:alpha="0.75"/>
            </RelativeLayout>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/cj_pay_order_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/cj_pay_padding_24"
                android:layout_marginTop="20dp"
                android:layout_marginRight="@dimen/cj_pay_padding_24"
                android:singleLine="true"
                android:includeFontPadding="false"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cj_pay_total_value_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <TextView
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:id="@+id/cj_pay_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cj_pay_currency_unit"
                    app:layout_constraintBaseline_toBaselineOf="@+id/cj_pay_total_value"
                    app:layout_constraintEnd_toStartOf="@+id/cj_pay_total_value"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"/>
                <com.android.ttcjpaysdk.base.ui.widget.ScrollAnimTextView
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:id="@+id/cj_pay_total_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/cj_pay_padding_2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/cj_pay_unit"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/cj_pay_color_gray_161823_opacity_40"
                    android:ellipsize="end"
                    android:id="@+id/tv_origin_price"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBaseline_toBaselineOf="@+id/cj_pay_total_value"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toEndOf="@+id/cj_pay_total_value"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cj_pay_padding_5">
                <ImageView
                    android:id="@+id/iv_icon_discount"
                    android:visibility="gone"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginRight="4dp"
                    android:src="@drawable/cj_pay_icon_discount"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/cj_pay_color_red_fe2c55"
                    android:ellipsize="end"
                    android:id="@+id/cj_pay_discount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:drawableRight="@drawable/cj_pay_ic_voucher_label_more"/>
            </LinearLayout>
            <Space
                android:layout_width="wrap_content"
                android:layout_height="24dp"/>
            <FrameLayout
                android:id="@+id/cj_payment_addi_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:id="@+id/fl_payment_method"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <com.android.ttcjpaysdk.base.ui.widget.LoadingButton
                android:id="@+id/cj_pay_confirm"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cj_pay_height_44"
                android:layout_marginLeft="@dimen/cj_pay_padding_16"
                android:layout_marginTop="24dp"
                android:layout_marginRight="@dimen/cj_pay_padding_16"
                android:layout_marginBottom="16dp"/>
            <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
                android:id="@+id/bottom_insurance_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_alignParentBottom="true"
                app:theme_type="0"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
