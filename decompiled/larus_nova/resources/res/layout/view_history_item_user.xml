<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="65dp">
    <com.larksuite.component.universe_design.image.UDAvatar
        android:id="@+id/read_record_item_avatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="17dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/UDAvatar.Circle"/>
    <com.bytedance.ee.bear.widgets.tagview.SpaceTagTitleView
        android:id="@+id/read_record_item_name_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="10dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/read_record_item_group"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toRightOf="@+id/read_record_item_avatar"
        app:layout_constraintRight_toLeftOf="@+id/read_record_item_time"
        app:layout_constraintTop_toTopOf="@+id/read_record_item_avatar"
        app:titleColor="@color/ud_N900"
        app:titleSize="@dimen/space_kit_font_16"/>
    <TextView
        android:textSize="@dimen/space_kit_font_14"
        android:textColor="@color/ud_N500"
        android:ellipsize="end"
        android:id="@+id/read_record_item_group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text=""
        android:singleLine="true"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/read_record_item_avatar"
        app:layout_constraintLeft_toRightOf="@+id/read_record_item_avatar"
        app:layout_constraintRight_toLeftOf="@+id/read_record_item_time"
        app:layout_constraintTop_toBottomOf="@+id/read_record_item_name_title"/>
    <TextView
        android:textSize="@dimen/space_kit_font_14"
        android:textColor="@color/ud_N900"
        android:id="@+id/read_record_item_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="23dp"
        android:text="11月29日"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider"
        android:background="@color/line_divider_default"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        app:layout_constraintLeft_toLeftOf="@+id/read_record_item_name_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
