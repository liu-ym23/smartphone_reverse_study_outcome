<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="@color/ud_divider_color"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <com.larksuite.component.universe_design.notice.UDNotice
        android:id="@+id/notice"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="43dp"
        app:ud_notice_backgroundColor="@color/function_warning_fill_solid_02"
        app:ud_notice_icon="@drawable/ud_icon_warning_colorful"
        app:ud_notice_iconColorful="true"
        app:ud_notice_text="@string/Bitable_Flow_RecordCard_FlowEnd_Tooltip"
        app:ud_notice_textBtn="@string/Bitable_Flow_RecordCard_RestoreStep_Button"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/space_kit_len_10"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_kit_len_30"
        android:layout_marginLeft="@dimen/bitable_cell_itemview_horizon_margin"
        android:layout_marginTop="@dimen/space_kit_len_10"
        android:layout_marginRight="@dimen/bitable_cell_itemview_horizon_margin">
        <com.bytedance.ee.bear.bitable.common.widgets.common.RingView
            android:layout_width="@dimen/space_kit_len_8"
            android:layout_height="@dimen/space_kit_len_8"
            app:innerColor="@color/ud_N350"
            app:outerColor="@color/ud_N500"/>
        <TextView
            android:textSize="@dimen/space_kit_font_12"
            android:textColor="@color/text_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Bitable_Flow_RecordCard_NotStarted_Text"
            android:layout_marginStart="@dimen/dp_4"/>
        <com.bytedance.ee.bear.bitable.common.widgets.common.RingView
            android:layout_width="@dimen/space_kit_len_8"
            android:layout_height="@dimen/space_kit_len_8"
            android:layout_marginStart="@dimen/space_kit_len_14"
            app:innerColor="@color/ud_O200"
            app:outerColor="@color/ud_O350"/>
        <TextView
            android:textSize="@dimen/space_kit_font_12"
            android:textColor="@color/text_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Bitable_Flow_RecordCard_InProgress_Text"
            android:layout_marginStart="@dimen/dp_4"/>
        <com.bytedance.ee.bear.bitable.common.widgets.common.RingView
            android:layout_width="@dimen/space_kit_len_8"
            android:layout_height="@dimen/space_kit_len_8"
            android:layout_marginStart="@dimen/space_kit_len_14"
            app:innerColor="@color/ud_G350"
            app:outerColor="@color/ud_G500"/>
        <TextView
            android:textSize="@dimen/space_kit_font_12"
            android:textColor="@color/text_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Bitable_Flow_RecordCard_Done_Text"
            android:layout_marginStart="@dimen/dp_4"/>
        <androidx.legacy.widget.Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/stepMoreIcon"
            android:padding="6dp"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:tint="@color/icon_n1"
            app:srcCompat="@drawable/ud_icon_more_outlined"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/stepRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="96dp"/>
    <View
        android:background="@color/ud_divider_color"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginLeft="@dimen/bitable_cell_itemview_horizon_margin"
        android:layout_marginRight="@dimen/bitable_cell_itemview_horizon_margin">
        <com.bytedance.ee.bear.bitable.common.widgets.common.RingView
            android:id="@+id/currentStepRingView"
            android:layout_width="@dimen/dp_10"
            android:layout_height="@dimen/dp_10"
            android:layout_marginStart="@dimen/space_kit_len_3"/>
        <TextView
            android:textSize="@dimen/space_kit_font_16"
            android:textColor="@color/text_title"
            android:ellipsize="end"
            android:id="@+id/currentNameTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_kit_len_10"/>
        <com.larksuite.component.universe_design.button.UDButton
            android:textColor="@color/static_white"
            android:id="@+id/currentButton"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_28"
            android:text="@string/Bitable_Flow_RecordCard_CompleteStep_Button"
            android:layout_marginStart="@dimen/space_kit_len_4"
            app:ud_backgroundColor="@color/ud_button_blue_bg"
            style="@style/UDButton.Small.Primary"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/currentStateIcon"
            android:layout_width="@dimen/space_kit_len_16"
            android:layout_height="@dimen/space_kit_len_16"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ud_icon_time_outlined"/>
        <TextView
            android:textSize="@dimen/space_kit_font_14"
            android:id="@+id/currentStateTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Bitable_Flow_RecordCard_InProgress_Text"
            android:layout_marginStart="@dimen/space_kit_len_6"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/currentStateAction"
            android:padding="@dimen/space_kit_len_4"
            android:layout_width="@dimen/space_kit_len_24"
            android:layout_height="@dimen/space_kit_len_24"
            android:tint="@color/icon_n1"
            android:layout_marginStart="@dimen/space_kit_len_16"
            app:srcCompat="@drawable/ud_icon_down_outlined"/>
    </LinearLayout>
    <View
        android:background="@color/ud_divider_color"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginLeft="@dimen/bitable_cell_itemview_horizon_margin"
        android:layout_marginRight="@dimen/bitable_cell_itemview_horizon_margin"/>
</LinearLayout>
