<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wiki_tree_root_view"
    android:background="@color/bg_body"
    android:paddingLeft="@dimen/wiki_tree_padding"
    android:paddingRight="@dimen/wiki_tree_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/container"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.ee.bear.wikiv2.wikitreev2.scroll.WikiHorizontalScrollView
            android:scrollbarSize="@dimen/dp_3"
            android:scrollbarThumbHorizontal="@drawable/wiki_seekbar_thumb"
            android:scrollbarStyle="insideOverlay"
            android:id="@+id/wiki_tree_scroll_view"
            android:scrollbars="horizontal"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">
            <com.bytedance.ee.bear.wikiv2.common.widget.InterceptableRecyclerView
                android:id="@+id/recycler_view"
                android:paddingBottom="@dimen/space_kit_len_60"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
        </com.bytedance.ee.bear.wikiv2.wikitreev2.scroll.WikiHorizontalScrollView>
        <com.oubowu.stickyitemdecoration.StickyHeadContainer
            android:id="@+id/sticky_head_container"
            android:background="@color/bg_body"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.bytedance.ee.bear.wikiv2.wikitreev2.widget.view.WikItemHomePageView
                    android:id="@+id/sticky_home_page"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"/>
                <com.bytedance.ee.bear.wikiv2.wikitreev2.widget.view.WikItemRootView
                    android:id="@+id/sticky_head"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"/>
            </LinearLayout>
        </com.oubowu.stickyitemdecoration.StickyHeadContainer>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
