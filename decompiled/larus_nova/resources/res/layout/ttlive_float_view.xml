<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.floatview.DragRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/float_drag_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/float_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/flaot_edge"
            android:background="@drawable/ttlive_float_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout
            android:id="@+id/float_content_root_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="1dp"
            app:ttlive_allRadius="8dp">
            <FrameLayout
                android:id="@+id/float_playing_view_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <RelativeLayout
                    android:id="@+id/float_video_view_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <FrameLayout
                    android:id="@+id/float_biz_interact_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <com.bytedance.android.live.core.widget.HSImageView
                    android:id="@+id/float_background_view"
                    android:background="@drawable/ttlive_ic_live_default_bg"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"/>
                <View
                    android:id="@+id/float_background_view_shade"
                    android:background="#0d000000"
                    android:focusable="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/ttlive_float_back_live"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/float_audio_link_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <FrameLayout
                        android:layout_gravity="center_horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp">
                        <com.bytedance.android.livesdk.widget.VHeadView
                            android:id="@+id/float_anchor_head"
                            android:background="@drawable/ttlive_bg_circle_head"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:scaleType="fitXY"/>
                        <FrameLayout
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/float_radio_effect_container"
                            android:layout_width="48dp"
                            android:layout_height="48dp">
                            <ImageView
                                android:layout_gravity="center_horizontal"
                                android:id="@+id/float_radio_effect_bg"
                                android:background="@drawable/ttlive_float_radio_effect_bg"
                                android:visibility="visible"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>
                            <com.bytedance.android.live.core.widget.HSImageView
                                android:layout_gravity="bottom|center_horizontal"
                                android:id="@+id/float_radio_effect"
                                android:visibility="visible"
                                android:layout_width="20dp"
                                android:layout_height="12dp"
                                android:layout_marginBottom="2dp"/>
                        </FrameLayout>
                    </FrameLayout>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/white"
                        android:ellipsize="end"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/float_anchor_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="1"
                        android:maxLength="6"
                        android:alpha="0.9"/>
                </LinearLayout>
                <com.bytedance.android.livesdk.chatroom.ui.AudioWaveView
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:id="@+id/float_audio_wave_view"
                    android:layout_width="62dp"
                    android:layout_height="26dp"
                    android:layout_marginTop="40dp"
                    app:wave_animator_time="600"
                    app:wave_end_color="@color/white"
                    app:wave_max_height="62dp"
                    app:wave_min_height="10dp"
                    app:wave_start_color="@color/white"/>
                <View
                    android:layout_gravity="end|bottom"
                    android:id="@+id/float_mute"
                    android:background="@drawable/ttlive_float_mute_selector"
                    android:visibility="visible"
                    android:layout_width="24dp"
                    android:layout_height="24dp"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/float_feed_view_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <RelativeLayout
                android:id="@+id/float_end_view_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/white"
                    android:id="@+id/float_end_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="70dp"
                    android:text="@string/ttlive_float_end"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="11dp"
                    android:textColor="@color/white"
                    android:id="@+id/float_end_count_down"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_below="@+id/float_end_tv"
                    android:layout_centerHorizontal="true"
                    android:alpha="0.7"/>
                <TextView
                    android:textSize="11dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/float_end_back"
                    android:background="@drawable/ttlive_float_back_bg"
                    android:layout_width="93dp"
                    android:layout_height="28dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/ttlive_float_back"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <View
                android:layout_gravity="end|top"
                android:id="@+id/float_close"
                android:background="@drawable/ttlive_ic_float_close"
                android:visibility="visible"
                android:layout_width="24dp"
                android:layout_height="24dp"/>
        </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout>
    </FrameLayout>
</com.bytedance.android.livesdk.floatview.DragRelativeLayout>
