<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.shopping.collect.custom_view.CollectRootContainerConstraintLayout
        android:id="@+id/collect_content_container"
        android:background="#f5f6f9"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/collect_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/gradient_view"
            android:background="@drawable/gradient_background"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            app:layout_constraintTop_toBottomOf="@+id/collect_header"/>
        <com.bytedance.android.shopping.collect.custom_view.CollectGoodsLinkedScrollView
            android:id="@+id/collect_list_nest_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/collect_footer"
            app:layout_constraintTop_toBottomOf="@+id/collect_header"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/collect_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/collect_sort_panel"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/collect_header"/>
    </com.bytedance.android.shopping.collect.custom_view.CollectRootContainerConstraintLayout>
    <View
        android:id="@+id/default_loading_view_without_header"
        android:background="@drawable/ec_collect_default_loading_without_header_light"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/default_loading_view_with_header"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="17dp"
            android:textColor="#161823"
            android:gravity="center"
            android:id="@+id/collect_title_bar"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="商品收藏"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/default_loading_view"
            android:background="@drawable/ec_collect_default_loading_without_header_light"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/collect_title_bar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/collect_double_ball_loading_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.ui.ec.widget.loading.ECDuxLoadingAnimationView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <FrameLayout
        android:orientation="vertical"
        android:id="@+id/collect_error_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/ec_common_layout_error"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
