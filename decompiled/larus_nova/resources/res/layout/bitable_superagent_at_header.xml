<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/bitable_superagent_at_header_back"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:tint="@color/icon_n2"
        android:contentDescription="@null"
        android:layout_marginEnd="4dp"
        app:srcCompat="@drawable/ud_icon_left_small_ccm_outlined"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_caption"
        android:id="@+id/bitable_superagent_at_header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/bitable_superagent_at_header_more"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Bitable_AISidebar_More_Button_Mob"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:tint="@color/icon_n2"
            android:contentDescription="@null"
            android:layout_marginStart="2dp"
            app:srcCompat="@drawable/ud_icon_right_small_ccm_outlined"/>
    </LinearLayout>
</LinearLayout>
