<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/shopping_homepage_mall_btm_dialog_bg"
    android:layout_width="281dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/shopping_home_color_FF3344"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:text="@string/mall_btm_local_test_title"/>
    <View
        android:background="@color/shopping_color_1F161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/shopping_home_color_BF161823"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="20dp"
        android:text="@string/mall_btm_local_test_content"/>
    <View
        android:background="@color/shopping_color_1F161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/shopping_home_color_161823"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/mall_btm_dialog_confirm_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/mall_btm_local_test_btn_confirm"
            android:singleLine="false"
            android:layout_weight="1"
            android:lineSpacingExtra="2dp"/>
        <View
            android:background="@color/shopping_color_1F161823"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/shopping_home_color_161823"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/mall_btm_dialog_oncall_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/mall_btm_local_test_btn_oncall"
            android:singleLine="false"
            android:layout_weight="1"
            android:lineSpacingExtra="2dp"/>
    </LinearLayout>
</LinearLayout>
