<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/ttlive_effect_bg_pick_color_dialog_input"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="280dp"
        android:layout_height="144dp">
        <TextView
            android:textSize="17sp"
            android:textColor="#161823"
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="24dp"
            android:text="编辑该预设名称"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#bf161823"
            android:id="@+id/title_text_tip"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="8dp"
            android:text="最多支持输入4个字"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_text"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:background="@drawable/ttlive_effect_preset_bg_common_edit_text"
            android:layout_width="240dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_text_tip">
            <EditText
                android:textSize="14sp"
                android:textColor="#161823"
                android:layout_gravity="center_vertical"
                android:id="@+id/et_input"
                android:background="@null"
                android:layout_width="200dp"
                android:layout_height="20dp"
                android:cursorVisible="true"
                android:inputType="text"
                android:textCursorDrawable="@drawable/ttlive_effect_dialog_common_input_cursor_black"
                android:layout_marginStart="8dp"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_clear_text"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_preset_clear_rename_text"
                android:scaleType="fitXY"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="8dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:background="#1f161823"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="280dp"
        android:layout_height="48dp">
        <Button
            android:textSize="15sp"
            android:textColor="#bf161823"
            android:layout_gravity="center"
            android:id="@+id/cancel_button"
            android:background="@drawable/ttlive_effect_preset_bg_common_cancel_btn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="取消"
            android:layout_weight="1"/>
        <View
            android:background="#1f161823"
            android:layout_width="1dp"
            android:layout_height="match_parent"/>
        <Button
            android:textSize="15sp"
            android:textColor="#161823"
            android:id="@+id/confirm_button"
            android:background="@drawable/ttlive_effect_preset_bg_common_confirm_btn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="确定"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
