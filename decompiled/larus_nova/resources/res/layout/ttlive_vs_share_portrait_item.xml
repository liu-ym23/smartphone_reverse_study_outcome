<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/ttlive_vs_match_share_portrait_bg"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <FrameLayout
                android:id="@+id/ttlive_vs_match_share_portrait_container"
                android:layout_width="match_parent"
                android:layout_height="217dp"
                android:layout_marginBottom="15dp"
                android:layout_alignParentBottom="true"/>
            <TextView
                android:textSize="15dp"
                android:textColor="#e6ffffff"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/ttlive_vs_match_share_portrait_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="60dp"
                android:layout_marginRight="60dp"
                android:layout_marginBottom="20dp"
                android:maxLines="3"
                android:layout_above="@+id/ttlive_vs_match_share_portrait_container"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerConstraintLayout
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/ttlive_vs_match_share_btn"
                android:background="#1affffff"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginBottom="8dp"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:ttlive_allRadius="4dp">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/ttlive_vs_match_share_btn_icon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/ttlive_vs_ic_match_share"
                    android:scaleType="fitCenter"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@+id/ttlive_vs_match_share_btn_text"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/white"
                    android:id="@+id/ttlive_vs_match_share_btn_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="@string/ttlive_vs_share_portrait_item_confirm_button"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/ttlive_vs_match_share_btn_icon"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerConstraintLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
