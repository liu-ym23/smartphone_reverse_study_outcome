<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/tt_cj_pay_ocr_id_rootview"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.android.ttcjpaysdk.ocr.view.OCRCodeView
        android:id="@+id/tt_cj_pay_ocr_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:CJPayScanBoxLayout="@layout/cj_pay_view_scan_box"/>
    <ImageView
        android:id="@+id/back_view"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:src="@drawable/cj_pay_ocr_back_icon"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/light_view"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:src="@drawable/cj_pay_ocr_light_icon"
        android:layout_alignParentEnd="true"/>
    <RelativeLayout
        android:id="@+id/identity_label_layout_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="52dp"
        android:layout_marginTop="218dp"
        android:layout_marginRight="52dp">
        <ImageView
            android:id="@+id/identity_back_label_view"
            android:visibility="gone"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:src="@drawable/cj_pay_ocr_identity_back_label"
            android:layout_alignParentLeft="true"/>
        <ImageView
            android:id="@+id/identity_front_label_view"
            android:visibility="gone"
            android:layout_width="88dp"
            android:layout_height="100dp"
            android:src="@drawable/cj_pay_ocr_identity_front_label"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/identity_icon_layout_view"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="476dp">
        <ImageView
            android:id="@+id/identity_front_view"
            android:layout_width="156dp"
            android:layout_height="96dp"
            android:src="@drawable/cj_pay_ocr_identity_front_icon"/>
        <ImageView
            android:id="@+id/identity_back_view"
            android:layout_width="156dp"
            android:layout_height="96dp"
            android:src="@drawable/cj_pay_ocr_identity_back_icon"
            android:layout_marginStart="171dp"/>
    </RelativeLayout>
    <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
        android:id="@+id/bottom_insurance_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_alignParentBottom="true"
        app:theme_type="1"/>
    <com.android.ttcjpaysdk.base.ui.widget.CJPayTextLoadingView
        android:id="@+id/ocr_loading_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
