<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="14sp"
        android:textColor="#000"
        android:gravity="center"
        android:background="#40161823"
        android:padding="3dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/annie_debug_url_tool_title"/>
    <View
        android:background="#80000000"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:stretchColumns="2">
        <TableRow>
            <TextView
                android:textSize="14sp"
                android:textColor="#000"
                android:gravity="center"
                android:background="#40161823"
                android:padding="3dp"
                android:visibility="visible"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:text="@string/annie_debug_url_tool_schema"/>
            <View
                android:background="#80000000"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#000"
                android:gravity="start|center_vertical"
                android:id="@+id/annie_debug_url_dialog_scheme"
                android:padding="3dp"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/annie_debug_url_tool_schema"/>
        </TableRow>
        <View
            android:background="#80000000"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TableRow>
            <TextView
                android:textSize="14sp"
                android:textColor="#000"
                android:gravity="center"
                android:background="#40161823"
                android:padding="3dp"
                android:visibility="visible"
                android:layout_width="35dp"
                android:layout_height="match_parent"
                android:text="@string/annie_debug_url_tool_path"/>
            <View
                android:background="#80000000"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#000"
                android:gravity="start|center_vertical"
                android:id="@+id/annie_debug_url_dialog_path"
                android:padding="3dp"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/annie_debug_url_tool_schema"/>
        </TableRow>
        <View
            android:background="#80000000"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TableRow>
            <TextView
                android:textSize="14sp"
                android:textColor="#000"
                android:gravity="center"
                android:background="#40161823"
                android:padding="3dp"
                android:visibility="visible"
                android:layout_width="35dp"
                android:layout_height="match_parent"
                android:text="@string/annie_debug_url_tool_params"/>
            <View
                android:background="#80000000"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>
            <com.bytedance.android.annie.debug.ui.MaxHeightRecyclerView
                android:id="@+id/annie_debug_url_dialog_params"
                android:padding="3dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:maxHeight="480dp"/>
        </TableRow>
        <View
            android:background="#80000000"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
    </TableLayout>
</LinearLayout>
