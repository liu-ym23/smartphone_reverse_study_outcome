<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="end"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/inflow_feed_float_go_to_mall"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="39dp"
        android:src="@drawable/ec_inflow_float_to_mall"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageView
        android:id="@+id/inflow_feed_float_cart"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:src="@drawable/commerce_inflow_feed_float_cart"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toTopOf="@+id/inflow_feed_float_back_top"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ImageView
        android:id="@+id/inflow_feed_float_back_top"
        android:visibility="invisible"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:src="@drawable/commerce_inflow_feed_float_back_top"
        android:contentDescription="@string/shopping_back_to_top"
        android:layout_marginEnd="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
