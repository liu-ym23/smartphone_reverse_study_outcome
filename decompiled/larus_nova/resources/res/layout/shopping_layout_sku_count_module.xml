<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shopping_layout_sku_count_module_235765903"
    android:layout_width="match_parent"
    android:layout_height="60dp">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/shopping_std_text_black_1"
        android:id="@+id/tv_sku_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/shopping_sheet_buy_num"
        android:includeFontPadding="false"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/shopping_std_text_black_4"
        android:id="@+id/tv_sku_user_limit"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:includeFontPadding="false"
        android:layout_toRightOf="@+id/tv_sku_number"
        android:layout_centerVertical="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true">
        <ImageView
            android:id="@+id/iv_sku_select_minus"
            android:padding="4dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/shopping_ic_sku_panel_minus"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/shopping_std_text_black_1"
            android:gravity="center"
            android:id="@+id/tv_sku_select_count"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minWidth="32dp"
            android:singleLine="true"/>
        <ImageView
            android:id="@+id/iv_sku_select_plus"
            android:padding="4dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/shopping_ic_sku_panel_plus"/>
    </LinearLayout>
</RelativeLayout>
