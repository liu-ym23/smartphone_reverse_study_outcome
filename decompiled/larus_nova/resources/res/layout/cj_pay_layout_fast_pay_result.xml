<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/cj_pay_fast_pay_result"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/cj_pay_height_470">
    <include
        android:id="@+id/cj_pay_titlebar_root_view"
        layout="@layout/cj_pay_view_titlebar_layout"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/cj_pay_status_layout"
            android:paddingTop="100dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/cj_pay_status_icon_layout"
                android:layout_width="@dimen/cj_pay_height_60"
                android:layout_height="@dimen/cj_pay_height_60">
                <ImageView
                    android:id="@+id/cj_pay_status_icon"
                    android:layout_width="@dimen/cj_pay_height_60"
                    android:layout_height="@dimen/cj_pay_height_60"
                    android:scaleType="centerCrop"/>
            </FrameLayout>
            <LinearLayout
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/cj_pay_padding_40"
                android:layout_marginTop="12dp"
                android:layout_marginRight="@dimen/cj_pay_padding_40">
                <TextView
                    android:textSize="@dimen/cj_pay_font_size_20"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:gravity="center"
                    android:id="@+id/cj_pay_status_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="@dimen/cj_pay_font_size_22"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:id="@+id/cj_pay_total_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/cj_pay_padding_6"
                    android:text="@string/cj_pay_currency_unit"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="@dimen/cj_pay_font_size_22"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:id="@+id/cj_pay_total_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp">
                <TextView
                    android:textSize="@dimen/cj_pay_font_size_14"
                    android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/cj_pay_pay_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="@dimen/cj_pay_font_size_14"
                    android:textColor="@color/cj_pay_color_yellow_ff7a38"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/cj_pay_discount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </LinearLayout>
        <include layout="@layout/cj_pay_view_fastpay_loading_layout"/>
        <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
            android:layout_gravity="bottom"
            android:id="@+id/insurance_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:theme_type="0"/>
    </FrameLayout>
</LinearLayout>
