<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/audio_record_popup_view_bg"
    android:background="@color/bg_body_overlay"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/UDText.Body2"
        android:id="@+id/audio_record_popup_view_duration_text"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/UDText.Body2"
        android:textColor="@color/ud_R500"
        android:id="@+id/audio_record_popup_view_hint_text_cancel"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:text="@string/Lark_IM_Audio_ReleaseToCancel_Text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/audio_record_popup_view_duration_text"/>
    <com.ss.android.lark.keyboard.plugin.tool.voice.audio2.widget.AudioWaveformWidget
        android:id="@+id/audio_record_popup_view_waveform"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/audio_record_popup_view_duration_text"/>
    <com.ss.android.lark.keyboard.plugin.tool.voice.audio2.widget.AudioLottieTrashButton
        android:id="@+id/audio_record_popup_view_trash_button"
        android:padding="12dp"
        android:layout_width="70dp"
        android:layout_height="70dp"
        app:layout_constraintBottom_toTopOf="@+id/audio_record_popup_view_hint_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/audio_record_popup_view_hint_text_cancel"
        app:layout_constraintVertical_bias="0.8"
        app:lottie_rawRes="@raw/audio_plugin_delete_button_trash_anim"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textAppearance="@style/UDText.Body2"
        android:id="@+id/audio_record_popup_view_hint_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="46dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/audio_record_popup_view_waveform"/>
    <com.larksuite.component.universe_design.button.UDButton
        android:id="@+id/audio_record_popup_view_main_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="28dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toBottomOf="@+id/audio_record_popup_view_hint_text"
        app:ud_backgroundColor="@color/function_info_content_pressed"
        style="@style/UDButton.Big.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
