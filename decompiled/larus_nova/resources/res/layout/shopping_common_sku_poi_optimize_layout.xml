<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/common_sku_shop_info_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/common_sku_poi_info_layout"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/shopping_color_161823"
            android:id="@+id/common_sku_tv_shop_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shopping_sku_poi_shop_title"
            style="@style/font_size_28"/>
        <LinearLayout
            android:gravity="right"
            android:orientation="vertical"
            android:id="@+id/common_sku_shop_info_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp">
            <TextView
                android:textColor="@color/ec_color_99161823"
                android:ellipsize="end"
                android:id="@+id/common_sku_tv_shop_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                style="@style/font_size_28"/>
            <TextView
                android:textColor="@color/ec_color_99161823"
                android:ellipsize="end"
                android:id="@+id/common_sku_tv_shop_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                style="@style/font_size_28"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/common_sku_tv_select_shop"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginLeft="7dp"
            android:src="@drawable/shopping_ic_arrow_right_gray"
            android:scaleType="centerCrop"
            android:layout_marginStart="7dp"/>
    </LinearLayout>
    <View
        android:id="@+id/common_sku_poi_divider"
        android:background="@color/ec_color_1f_161823"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_below="@+id/common_sku_poi_info_layout"/>
</RelativeLayout>
