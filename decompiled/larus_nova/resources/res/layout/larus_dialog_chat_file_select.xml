<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/chat_overlay_bg"
        android:background="@color/larus_static_black"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chat_file_select_panel"
        android:background="@drawable/larus_bg_chat_file_select_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/larus_dp_56">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/chat_file_close"
                    android:padding="?attr/larus_dp_10"
                    android:layout_width="?attr/larus_dp_44"
                    android:layout_height="?attr/larus_dp_44"
                    android:src="?attr/larus_ic_close"
                    android:layout_marginStart="?attr/larus_dp_8"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_sp_17"
                    android:textStyle="bold"
                    android:textColor="?attr/larus_neutral_100"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/chat_file_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="?attr/larus_dp_16"
                android:layout_marginTop="?attr/larus_dp_8"
                android:layout_marginRight="?attr/larus_dp_16"
                android:layout_marginBottom="?attr/larus_dp_12">
                <com.larus.common_ui.widget.roundlayout.RoundFrameLayout
                    android:id="@+id/chat_action_open_drive"
                    android:layout_width="0dp"
                    android:layout_height="?attr/larus_dp_84"
                    android:layout_weight="1"
                    app:rv_backgroundColor="?attr/larus_base_3_overlay"
                    app:rv_backgroundPressColor="?attr/larus_neutral_transparent_2"
                    app:rv_cornerRadius="?attr/larus_dp_16">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="?attr/larus_dp_40"
                            android:layout_height="?attr/larus_dp_40"
                            app:srcCompat="@drawable/larus_ic_chat_file_drive"
                            app:tint="?attr/larus_neutral_100"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="?attr/larus_sp_13"
                            android:textColor="?attr/larus_neutral_70"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="?attr/larus_dp_4"
                            android:text="@string/larus_chat_addFile_drive"/>
                    </LinearLayout>
                </com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
                <Space
                    android:layout_width="?attr/larus_dp_8"
                    android:layout_height="wrap_content"/>
                <com.larus.common_ui.widget.roundlayout.RoundFrameLayout
                    android:id="@+id/chat_action_upload_local"
                    android:layout_width="0dp"
                    android:layout_height="?attr/larus_dp_84"
                    android:layout_weight="1"
                    app:rv_backgroundColor="?attr/larus_base_3_overlay"
                    app:rv_backgroundPressColor="?attr/larus_neutral_transparent_2"
                    app:rv_cornerRadius="?attr/larus_dp_16">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="?attr/larus_dp_40"
                            android:layout_height="?attr/larus_dp_40"
                            app:srcCompat="@drawable/larus_ic_chat_file_upload"
                            app:tint="?attr/larus_neutral_100"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="?attr/larus_sp_13"
                            android:textColor="?attr/larus_neutral_70"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="?attr/larus_dp_4"
                            android:text="@string/larus_chat_addFile_local"/>
                    </LinearLayout>
                </com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="?attr/larus_sp_13"
                android:textColor="?attr/larus_neutral_50"
                android:id="@+id/chat_recent_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="?attr/larus_dp_16"
                android:layout_marginTop="?attr/larus_dp_12"
                android:layout_marginRight="?attr/larus_dp_16"
                android:layout_marginBottom="?attr/larus_dp_8"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chat_recent_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:overScrollMode="never"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/chat_recent_empty_container"
                android:paddingBottom="?attr/larus_dp_82"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="?attr/larus_dp_40"
                    android:layout_height="?attr/larus_dp_40"
                    app:srcCompat="@drawable/larus_ic_drive_empty"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="?attr/larus_sp_17"
                    android:textColor="?attr/larus_neutral_50"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_20"
                    android:text="@string/larus_chat_upload_recent_files_empty_desc"/>
            </LinearLayout>
            <com.larus.common_ui.widget.ChatFileSelectorView
                android:id="@+id/chat_file_selector_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <ProgressBar
            android:id="@+id/chat_recent_loading"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:indeterminate="true"
            android:indeterminateTint="@color/larus_neutral_70"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
