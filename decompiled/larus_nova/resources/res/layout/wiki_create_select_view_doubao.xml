<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:background="@drawable/wiki_create_select_doubao_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="52dp">
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text_title"
            android:gravity="center"
            android:layout_gravity="top|center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="18dp"
            android:text="@string/LarkCCM_NewCM_CreateNew_Button"
            android:fontFamily="sans-serif-medium"/>
        <FrameLayout
            android:layout_gravity="end|top"
            android:id="@+id/doubao_close"
            android:layout_width="@dimen/space_kit_len_40"
            android:layout_height="@dimen/space_kit_len_40"
            android:layout_marginTop="@dimen/space_kit_len_8"
            android:layout_marginEnd="@dimen/space_kit_len_8">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:layout_width="@dimen/space_kit_len_24"
                android:layout_height="@dimen/space_kit_len_24"
                android:tint="@color/wiki_create_close_selector"
                app:srcCompat="@drawable/wiki_create_close_circle_shape"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:clickable="false"
                android:layout_width="@dimen/space_kit_len_14"
                android:layout_height="@dimen/space_kit_len_14"
                android:scaleType="fitCenter"
                android:tint="@color/icon_n1"
                app:srcCompat="@drawable/ud_icon_close_bold_outlined"/>
        </FrameLayout>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/select_recycler"
        android:paddingTop="8dp"
        android:paddingBottom="20dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="34dp"/>
</LinearLayout>
