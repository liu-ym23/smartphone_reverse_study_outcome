<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/shopping_bg_inner_flow_comment_item"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ec_ll_comment_group"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="7dp"
            android:layout_alignParentRight="true">
            <View
                android:layout_gravity="center_vertical"
                android:background="@color/commerce_color_57161823"
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="6dp"
                android:layout_marginBottom="6dp"/>
            <TextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="@color/commerce_color_BF161823"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/ec_tv_hot_comment_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="100dp"
                android:maxLines="1"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="6dp"
                android:layout_height="13dp"
                android:layout_margin="2dp"
                android:src="@drawable/ec_shop_inner_flow_ic_comment_more"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ec_rv_comment_banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toLeftOf="@+id/ec_ll_comment_group"/>
    </RelativeLayout>
    <Button
        android:id="@+id/ec_bt_go_to_comment_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"/>
</FrameLayout>
