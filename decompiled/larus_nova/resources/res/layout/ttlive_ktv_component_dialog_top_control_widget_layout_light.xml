<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_ktv_component_top_control_bar_bg_light"
    android:layout_width="match_parent"
    android:layout_height="52dp">
    <ImageView
        android:id="@+id/function_pause_start"
        android:background="@drawable/ttlive_ktv_component_top_bar_pause_ic"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/function_turn_next"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/function_turn_next"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/function_turn_next"
        android:background="@drawable/ttlive_ktv_component_top_bar_turn_ic"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/function_adjust"
        app:layout_constraintLeft_toRightOf="@+id/function_pause_start"
        app:layout_constraintRight_toLeftOf="@+id/function_adjust"
        app:layout_constraintStart_toEndOf="@+id/function_pause_start"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/function_adjust"
        android:background="@drawable/ttlive_ktv_component_top_bar_adjust_ic"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/function_origin"
        app:layout_constraintLeft_toRightOf="@+id/function_turn_next"
        app:layout_constraintRight_toLeftOf="@+id/function_origin"
        app:layout_constraintStart_toEndOf="@+id/function_turn_next"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/function_origin"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/function_score_and_challenge_container"
        app:layout_constraintLeft_toRightOf="@+id/function_adjust"
        app:layout_constraintRight_toLeftOf="@+id/function_score_and_challenge_container"
        app:layout_constraintStart_toEndOf="@+id/function_adjust"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/function_score_and_challenge_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/function_origin"
        app:layout_constraintRight_toLeftOf="@+id/function_exist_component"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/function_score"
            android:background="@drawable/ttlive_ktv_score_opened"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/function_challenge"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ttlive_ktv_challenge_closed_btn"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/ktv_challenge_dot_view"
            android:background="@drawable/ttlive_ic_setting_dot"
            android:visibility="gone"
            android:layout_width="6dp"
            android:layout_height="6dp"
            app:layout_constraintRight_toRightOf="@+id/function_challenge"
            app:layout_constraintTop_toTopOf="@+id/function_challenge"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="16dp"
        android:textColor="#e6ffffff"
        android:id="@+id/function_exist_component"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ttlive_ktv_component_exist"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/function_score_and_challenge_container"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toEndOf="@+id/function_score_and_challenge_container"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
