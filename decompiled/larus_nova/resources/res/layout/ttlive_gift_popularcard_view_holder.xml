<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_view"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/gift_image"
            android:layout_width="@dimen/ttlive_gift_panel_icon_size"
            android:layout_height="@dimen/ttlive_gift_panel_icon_size"
            android:layout_marginTop="15dp"
            android:scaleType="fitXY"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#ccffffff"
            android:id="@+id/prop_count"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginRight="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.bytedance.android.livesdk.gift.platform.business.dialog.v2.view.GiftCountDownTextView
            android:textSize="9dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/gift_operation"
            android:background="@drawable/ttlive_base_gift_operation_bg"
            android:visibility="gone"
            android:layout_width="58dp"
            android:layout_height="12dp"
            android:maxLines="1"
            app:layout_constraintBottom_toTopOf="@+id/gift_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#ccffffff"
            android:gravity="center"
            android:id="@+id/gift_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gift_image"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/diamond_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gift_name">
            <TextView
                android:textSize="9dp"
                android:textColor="@color/ttlive_base_gift_panel_diamond"
                android:gravity="top|center_horizontal"
                android:id="@+id/diamond"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.bytedance.android.livesdk.gift.platform.business.dialog.v2.view.LiveSendGiftAnimationView
        android:id="@+id/send_gift_animation_view"
        android:visibility="gone"
        android:layout_width="88dp"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
