<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/wiki_item_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.ee.bear.wikiv2.wikitreev2.widget.view.SwipeMenuLayout
        android:id="@+id/swipe_menu_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:layout_gravity="end|center_vertical"
                android:id="@+id/add_location"
                android:visibility="invisible"
                android:layout_width="@dimen/space_kit_len_20"
                android:layout_height="@dimen/space_kit_len_20"
                android:layout_marginEnd="@dimen/space_kit_len_20"/>
            <com.bytedance.ee.bear.wikiv2.wikitreev2.widget.view.WikiItemViewContainer
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/container"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/content"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/dp_4">
                    <FrameLayout
                        android:id="@+id/icon_container"
                        android:visibility="gone"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp">
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/icon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            app:srcCompat="@drawable/ud_icon_file_doc_colorful"/>
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/shortcut"
                            android:visibility="gone"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            app:srcCompat="@drawable/ud_icon_wiki_shortcutarrow_colorful"/>
                    </FrameLayout>
                    <TextView
                        android:textSize="14dp"
                        android:textStyle="normal"
                        android:textColor="@color/text_title"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:singleLine="true"
                        android:paddingStart="2dp"/>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/header"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="-2dp">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/indicator"
                        android:padding="6dp"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/ud_icon_right_bold_outlined"/>
                    <com.bytedance.ee.bear.facade.common.widget.BearLottieView
                        android:layout_gravity="end|center_vertical"
                        android:id="@+id/loading"
                        android:padding="5dp"
                        android:visibility="visible"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:lottie_autoPlay="true"
                        app:lottie_fileName="1252_loading.json"
                        app:lottie_loop="true"/>
                </FrameLayout>
            </com.bytedance.ee.bear.wikiv2.wikitreev2.widget.view.WikiItemViewContainer>
            <com.bytedance.ee.bear.wikiv2.wikitreev2.widget.view.WikiItemBackgroundView
                android:layout_gravity="center_vertical"
                android:id="@+id/background"
                android:layout_width="0dp"
                android:layout_height="match_parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/add"
                android:visibility="gone"
                android:layout_width="@dimen/space_kit_len_20"
                android:layout_height="@dimen/space_kit_len_20"
                android:tint="@color/icon_n2"
                android:layout_marginStart="@dimen/space_kit_len_8"
                android:layout_marginEnd="@dimen/space_kit_len_8"
                app:srcCompat="@drawable/ud_icon_add_outlined"/>
        </FrameLayout>
        <include
            android:id="@+id/item_menu"
            layout="@layout/wiki_tree_item_menu_v2"/>
    </com.bytedance.ee.bear.wikiv2.wikitreev2.widget.view.SwipeMenuLayout>
</FrameLayout>
