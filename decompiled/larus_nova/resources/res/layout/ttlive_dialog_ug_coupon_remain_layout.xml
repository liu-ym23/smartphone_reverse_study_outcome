<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@drawable/ttlive_bg_ug_coupo_remain"
        android:layout_width="280dp"
        android:layout_height="367dp">
        <FrameLayout
            android:id="@+id/ttlive_ug_coupon_remain_close"
            android:background="@drawable/ttlive_ug_coupon_dialog_close_bg"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:layout_alignParentRight="true"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/ttlive_ug_coupon_remain_icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="#181823"
            android:id="@+id/ttlive_ug_coupon_remain_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="108dp"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#99161823"
            android:layout_gravity="center_horizontal"
            android:id="@+id/ttlive_ug_coupon_remain_desc"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ttlive_ug_coupon_remain_content"
            android:layout_below="@+id/ttlive_ug_coupon_remain_title"
            android:layout_centerHorizontal="true"/>
        <RelativeLayout
            android:id="@+id/ttlive_ug_coupon_remain_coupon_container"
            android:background="@drawable/ttlive_ug_coupon_bg"
            android:layout_width="match_parent"
            android:layout_height="116dp"
            android:layout_below="@+id/ttlive_ug_coupon_remain_desc">
            <RelativeLayout
                android:gravity="center_horizontal"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="12dp">
                <TextView
                    android:textSize="14dp"
                    android:textColor="#fe2c55"
                    android:id="@+id/ttlive_ug_coupon_remain_coupon_prefix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ttlive_ug_coupon_remain_coupon_prefix"
                    android:layout_alignBaseline="@+id/ttlive_ug_coupon_remain_coupon_value"/>
                <TextView
                    android:textSize="24dp"
                    android:textColor="#fe2c55"
                    android:id="@+id/ttlive_ug_coupon_remain_coupon_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="-3dp"
                    android:layout_toRightOf="@+id/ttlive_ug_coupon_remain_coupon_prefix"
                    android:layout_centerVertical="true"/>
            </RelativeLayout>
            <TextView
                android:textSize="12dp"
                android:textColor="#99161823"
                android:id="@+id/ttlive_ug_coupon_remain_coupon_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="120dp"
                android:layout_marginTop="29dp"
                android:text="@string/ttlive_ug_coupon_remain_coupon_desc"/>
            <TextView
                android:textSize="12dp"
                android:textColor="#99161823"
                android:id="@+id/ttlive_ug_coupon_remain_coupon_expired"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="120dp"
                android:layout_marginTop="6dp"
                android:text="@string/ttlive_ug_coupon_remain_coupon_threshold"
                android:layout_below="@+id/ttlive_ug_coupon_remain_coupon_desc"/>
        </RelativeLayout>
        <com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout
            android:id="@+id/ttlive_ug_coupon_remain_confirm"
            android:background="#fe2c55"
            android:layout_width="240dp"
            android:layout_height="44dp"
            android:layout_marginBottom="12dp"
            android:layout_above="@+id/ttlive_ug_coupon_remain_refuse"
            android:layout_centerHorizontal="true"
            app:ttlive_allRadius="8dp">
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_ug_coupon_remain_confirm"/>
        </com.bytedance.android.livesdk.widget.roundcorner.RoundCornerFrameLayout>
        <TextView
            android:textSize="15dp"
            android:textColor="#99161823"
            android:id="@+id/ttlive_ug_coupon_remain_refuse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/ttlive_ug_coupon_remain_refuse"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</FrameLayout>
