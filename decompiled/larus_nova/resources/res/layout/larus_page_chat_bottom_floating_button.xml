<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:alpha="0">
    <com.larus.bmhome.view.FastScrollButton
        android:id="@+id/fast_button"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_80"
        android:layout_height="?attr/larus_dp_80"
        android:alpha="0"/>
    <com.larus.bmhome.chat.component.bottom.floating.button.BottomFloatingButton
        android:id="@+id/bottom_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/fast_back_button"
        android:background="@drawable/larus_fast_button_bg_shadow"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_80"
        android:layout_height="?attr/larus_dp_80">
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/fast_back_button_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="?attr/larus_dp_46"
                android:layout_height="?attr/larus_dp_46"
                android:src="@drawable/larus_ic_back_top_button"/>
            <TextView
                android:textSize="?attr/larus_dp_14"
                android:textStyle="bold"
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:id="@+id/tv_back_to_chat"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/larus_feed_tag_viewMessage"
                android:maxLines="1"
                android:layout_weight="1"
                android:alpha="1"
                android:layout_marginStart="-11dp"
                android:layout_marginEnd="?attr/larus_dp_18"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
