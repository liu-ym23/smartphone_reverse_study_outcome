<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#f8f8f8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="26dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/commerce_store_search_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/commerce_store_search_title_back"
            android:padding="5dp"
            android:layout_width="34sp"
            android:layout_height="34sp"
            android:layout_marginLeft="11dp"
            android:src="@drawable/shopping_ic_store_v2_back_black"
            android:layout_marginStart="11dp"/>
        <RelativeLayout
            android:id="@+id/commerce_store_search_bar"
            android:background="@drawable/shape_bg_white_corner36"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="16dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/shopping_color_161823"
                android:gravity="center"
                android:id="@+id/commerce_store_search_title_go"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/commerce_search"
                android:layout_centerVertical="true"
                android:lineSpacingExtra="2dp"
                android:layout_marginEnd="12dp"
                android:layout_alignParentEnd="true"/>
            <ImageView
                android:id="@+id/commerce_store_search_icon"
                android:background="@drawable/shopping_ic_store_compat_search_icon_grey"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginLeft="12dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_alignParentStart="true"/>
            <ImageView
                android:id="@+id/commerce_store_search_close"
                android:background="@drawable/ecommerce_store_ic_search_close"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/commerce_store_search_camera"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/commerce_store_search_camera"/>
            <ImageView
                android:id="@+id/commerce_store_search_camera"
                android:padding="8dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/search_camera_img"
                android:layout_toLeftOf="@+id/commerce_store_search_divider"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/commerce_store_search_divider"/>
            <View
                android:id="@+id/commerce_store_search_divider"
                android:background="@color/commerce_color_33161823"
                android:visibility="gone"
                android:layout_width="0.5dp"
                android:layout_height="16dp"
                android:layout_marginRight="8dp"
                android:layout_toLeftOf="@+id/commerce_store_search_title_go"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@+id/commerce_store_search_title_go"/>
            <EditText
                android:textSize="14sp"
                android:textColor="@color/commerce_text_reverse"
                android:textColorHint="@color/shopping_std_text_modal_6"
                android:gravity="start|center_vertical"
                android:id="@+id/commerce_store_search_input"
                android:background="@color/transparent"
                android:padding="0dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"
                android:layout_centerVertical="true"
                android:lineSpacingExtra="2dp"
                android:inputType="textNoSuggestions"
                android:imeOptions="actionSearch"
                android:textCursorDrawable="@drawable/commerce_ic_cursor"
                android:textDirection="ltr"
                android:textAlignment="viewStart"
                android:layout_marginStart="4.5dp"
                android:layout_marginEnd="4.5dp"
                android:layout_toStartOf="@+id/commerce_store_search_close"
                android:layout_toEndOf="@+id/commerce_store_search_icon"/>
        </RelativeLayout>
        <FrameLayout
            android:id="@+id/ec_store_fold_close_btn"
            android:visibility="gone"
            android:layout_width="24sp"
            android:layout_height="24sp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="12dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/shopping_ic_store_sheet_close_black"/>
        </FrameLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/search_middle_page_container"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.android.ec.store.search.history.HistoryBanner
                android:id="@+id/commerce_store_search_history_banner"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:layout_marginBottom="18dp"/>
            <com.bytedance.android.ec.store.search.history.HistoryView
                android:id="@+id/commerce_store_search_history_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <FrameLayout
                android:id="@+id/ec_store_search_hot_view_fl"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/search_sug_list"
            android:background="@color/white"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
