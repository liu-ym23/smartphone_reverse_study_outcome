<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/container"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.ee.bear.widgets.BaseTitleBar
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:widget_widgets_tb_background="@color/bg_body"
        app:widget_widgets_tb_divider_visible="false"
        app:widget_widgets_tb_title="@string/Bitable_Workspace_Activities_Tab"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/errLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.ee.bear.widgets.universedesign.SpaceEmptyState
            android:id="@+id/errState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="34dp"
            app:ud_empty_desc="@string/Bitable_Workspace_UnableToLoadData_Description"
            app:ud_empty_imageRes="@drawable/ccm_empty_negative_load_failed"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/tab_empty_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="19dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/empty_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:srcCompat="@drawable/ccm_empty_positive_activity_action_1"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/ud_N900"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Bitable_Workspace_Mobile_NoRecentActivity_Title"
                android:maxLines="1"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_caption"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/empty_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/Bitable_Workspace_Mobile_NoRecentActivity_Desc"
                android:maxLines="3"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
