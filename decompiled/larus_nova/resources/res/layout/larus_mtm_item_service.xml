<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/mtm_service_item_fold_stack_bg"
        android:background="@drawable/larus_mtm_card_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_64"
        android:layout_marginLeft="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginRight="?attr/larus_dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mtm_service_item"
        android:background="@drawable/larus_mtm_card_bg_with_press"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_56">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/mtm_service_icon"
            android:layout_width="?attr/larus_dp_32"
            android:layout_height="?attr/larus_dp_32"
            android:layout_marginStart="?attr/larus_dp_14"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundedCornerRadius="?attr/larus_dp_8"
            app:roundingBorderColor="?attr/larus_neutral_transparent_1"
            app:roundingBorderWidth="?attr/larus_dp_0_5"/>
        <TextView
            android:textSize="?attr/larus_dp_16"
            android:textStyle="bold"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="end"
            android:id="@+id/mtm_service_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="?attr/larus_dp_10"
            android:layout_marginEnd="?attr/larus_dp_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/mtm_service_close"
            app:layout_constraintStart_toEndOf="@+id/mtm_service_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginEnd="?attr/larus_dp_16"/>
        <ImageView
            android:id="@+id/mtm_service_close"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_24"
            android:layout_height="?attr/larus_dp_24"
            android:src="@drawable/larus_mtm_ic_close"
            android:layout_marginEnd="?attr/larus_dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
