<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_48">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/search_back"
        android:paddingTop="?attr/larus_dp_2"
        android:paddingBottom="?attr/larus_dp_2"
        android:visibility="gone"
        android:layout_width="?attr/larus_dp_52"
        android:layout_height="?attr/larus_dp_44"
        android:contentDescription="@string/larus_accessibility_icon_back"
        android:paddingStart="?attr/larus_dp_8"
        app:srcCompat="?attr/larus_ic_left_back"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/search_input_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="1"
        android:paddingStart="?attr/larus_dp_14"
        android:layout_toStartOf="@+id/search_cancel"
        android:layout_toEndOf="@+id/search_back"
        android:transitionName="search_input_root">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/search_icon"
            android:layout_width="?attr/larus_dp_18"
            android:layout_height="?attr/larus_dp_18"
            android:importantForAccessibility="no"
            app:srcCompat="?attr/larus_icon_search"/>
        <EditText
            android:textSize="?attr/larus_dp_17"
            android:gravity="start|center_vertical"
            android:id="@+id/search_input"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="@string/larus_inapp_search_bot_placeholder"
            android:layout_weight="1"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:textDirection="locale"
            android:textAlignment="viewStart"
            android:layoutDirection="locale"
            android:layout_marginStart="?attr/larus_dp_8"
            android:layout_marginEnd="?attr/larus_dp_14"
            style="@style/larus_EditTextStyle"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/search_clear"
            android:padding="?attr/larus_dp_14"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_48"
            android:layout_height="?attr/larus_dp_48"
            android:contentDescription="@string/larus_accessibility_search_clearText"
            android:layout_marginStart="?attr/larus_dp_m_12"
            app:srcCompat="?attr/larus_icon_clear_dark"/>
    </LinearLayout>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center_vertical"
        android:id="@+id/search_cancel"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/larus_edit_bot_cancel"
        android:includeFontPadding="false"
        android:layout_marginStart="?attr/larus_dp_12"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
