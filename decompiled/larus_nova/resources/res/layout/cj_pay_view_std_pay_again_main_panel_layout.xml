<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/rl_main_panel_root_view"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="470dp">
    <FrameLayout
        android:id="@+id/main_panel_titlebar_root_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_106">
        <ImageView
            android:layout_gravity="left"
            android:id="@+id/cj_pay_main_panel_back_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cj_pay_font_size_16"
            android:layout_marginTop="@dimen/cj_pay_font_size_16"
            android:src="@drawable/cj_pay_icon_titlebar_left_arrow_noise_reduction"
            android:scaleType="centerCrop"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/cj_pay_main_panel_middle_top_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp">
            <com.android.ttcjpaysdk.base.ui.CJPayMiddleTitleText
                android:textSize="20sp"
                android:textColor="?attr/cj_pay_text_primary"
                android:ellipsize="middle"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_main_panel_middle_title"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="300dp"
                android:singleLine="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/pay_again_error_tip_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="28px"
            android:layout_marginTop="64dp"
            android:layout_marginRight="28px">
            <TextView
                android:textSize="13sp"
                android:textColor="?attr/cj_pay_text_tertiary"
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_mian_panel_error_pay_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="2dp"
                android:text=""/>
            <TextView
                android:textSize="13sp"
                android:textColor="?attr/cj_pay_text_tertiary"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/cj_pay_mian_panel_error_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text=""
                android:maxLines="1"
                android:layout_weight="1"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/cj_pay_text_link_color_pressable"
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_main_panel_error_detail_text"
                android:paddingLeft="6dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cj_pay_payment_failed_tip"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/cj_pay_main_panel_error_detail"
                android:visibility="gone"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginLeft="2dp"
                android:src="@drawable/cj_pay_icon_pay_again_detail"
                android:scaleType="fitXY"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/cj_pay_new_style_component"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="22dp">
            <com.android.ttcjpaysdk.base.ui.component.money.CJMoney
                android:textSize="36dp"
                android:textColor="?attr/cj_pay_text_primary"
                android:layout_gravity="center_horizontal"
                android:id="@+id/cj_pay_new_style_money_component"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <include
                android:layout_gravity="center_horizontal"
                android:id="@+id/cj_pay_new_style_discount_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                layout="@layout/cj_pay_view_verify_discount_layout"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/cj_pay_pay_again_display_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cj_pay_padding_27"
            android:layout_marginBottom="@dimen/cj_pay_padding_19">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/cj_pay_pay_again_display_icon"
                android:layout_width="@dimen/cj_pay_height_50"
                android:layout_height="@dimen/cj_pay_height_50"/>
            <TextView
                android:textSize="@dimen/cj_pay_font_size_16"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/cj_pay_pay_again_display_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cj_pay_padding_6"/>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_method_list_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/fl_bottom_area"
        android:layout_below="@+id/main_panel_titlebar_root_view">
        <com.android.ttcjpaysdk.base.ui.anim.CJBoundScrollView
            android:id="@+id/sv_method_list"
            android:scrollbars="none"
            android:clipToPadding="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:fillViewport="true"
            android:overScrollMode="always">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cj_pay_bg_card_container"
                android:descendantFocusability="blocksDescendants"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/cj_pay_method_content_holder"
                    android:descendantFocusability="blocksDescendants"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/ll_expand_area"
                    android:background="?attr/cj_pay_bg_card"
                    android:paddingTop="8dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="?attr/cj_pay_text_tertiary"
                        android:id="@+id/tv_expand_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/iv_expand_arrow"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="?attr/cj_pay_icon_arrow_down"/>
                </LinearLayout>
            </LinearLayout>
        </com.android.ttcjpaysdk.base.ui.anim.CJBoundScrollView>
        <include
            android:id="@+id/layout_pay_again_combine_area"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="12dp"
            layout="@layout/cj_pay_view_pay_again_main_combine_area_layout"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/fl_bottom_area"
        android:background="?attr/cj_pay_bg_primary_grey"
        android:paddingTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_alignParentBottom="true">
        <com.android.ttcjpaysdk.base.ui.component.agreement.CJPayAgreementView
            android:id="@+id/bottom_agreement_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>
        <FrameLayout
            android:id="@+id/confirm_button_view_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/confirm_btn_upper_layout"
                android:background="@drawable/confirm_upper_bubble_layout_bg"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="40dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="?attr/cj_pay_text_marketing_orange"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/confirm_btn_upper_bubble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"/>
            </FrameLayout>
            <include
                android:id="@+id/layout_confirm"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                layout="@layout/cj_pay_view_new_insufficient_btn_layout"/>
        </FrameLayout>
    </LinearLayout>
    <View
        android:id="@+id/cj_pay_empty_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/main_panel_titlebar_root_view"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/main_panel_titlebar_root_view"
        layout="@layout/cj_pay_view_half_screen_loading_layout"/>
    <com.android.ttcjpaysdk.base.ui.widget.CJPayTextLoadingView
        android:id="@+id/cj_pay_insufficient_loading_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/main_panel_titlebar_only_title_contianer"
        android:background="@drawable/cj_pay_bg_pay_again_title_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_50">
        <com.android.ttcjpaysdk.base.ui.CJPayMiddleTitleText
            android:textSize="17sp"
            android:textColor="?attr/cj_pay_text_primary"
            android:ellipsize="middle"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/main_panel_titlebar_only_title"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="300dp"
            android:singleLine="true"/>
    </FrameLayout>
    <include
        android:id="@+id/cj_pay_security_panel_loading_container"
        android:layout_width="match_parent"
        android:layout_height="470dp"
        android:layout_marginTop="@dimen/cj_pay_height_50"
        layout="@layout/cj_pay_view_security_panel_loading_container"/>
</RelativeLayout>
