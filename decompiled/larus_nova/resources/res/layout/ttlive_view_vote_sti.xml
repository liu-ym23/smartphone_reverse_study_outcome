<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="36dp"
    android:layout_height="36dp">
    <View
        android:id="@+id/left_bar"
        android:background="@drawable/ttlive_bg_vote_sti_left"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:transformPivotY="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/vote_bar_divider"/>
    <View
        android:id="@+id/right_bar"
        android:background="@drawable/ttlive_bg_vote_sti_right"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:transformPivotY="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/vote_bar_divider"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/left_win_anim_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <View
        android:id="@+id/left_shine"
        android:background="@drawable/ttlive_bg_vote_sti_shine"
        android:layout_width="0dp"
        android:layout_height="15dp"
        app:layout_constraintLeft_toLeftOf="@+id/left_bar"
        app:layout_constraintRight_toRightOf="@+id/left_bar"
        app:layout_constraintTop_toTopOf="@+id/vote_win_anim_guide"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_left_particle"
        android:layout_width="0dp"
        android:layout_height="5dp"
        android:translationX="3.5dp"
        app:layout_constraintLeft_toLeftOf="@+id/left_bar"
        app:layout_constraintRight_toRightOf="@+id/left_bar"
        app:layout_constraintTop_toTopOf="@+id/vote_win_anim_guide"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/right_win_anim_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <View
        android:id="@+id/right_shine"
        android:background="@drawable/ttlive_bg_vote_sti_shine"
        android:layout_width="0dp"
        android:layout_height="15dp"
        app:layout_constraintLeft_toLeftOf="@+id/right_bar"
        app:layout_constraintRight_toRightOf="@+id/right_bar"
        app:layout_constraintTop_toTopOf="@+id/vote_win_anim_guide"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_right_particle"
        android:layout_width="0dp"
        android:layout_height="5dp"
        android:translationX="-3.5dp"
        app:layout_constraintLeft_toLeftOf="@+id/right_bar"
        app:layout_constraintRight_toRightOf="@+id/right_bar"
        app:layout_constraintTop_toTopOf="@+id/vote_win_anim_guide"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/icon_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="10dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_vote_result_1"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:shadowColor="@color/ttlive_vote_shadow"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2"
        app:layout_constraintBottom_toBottomOf="@+id/vote_text_guide"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/vote_text_guide"/>
    <TextView
        android:textSize="10dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_vote_result_2"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:shadowColor="@color/ttlive_vote_shadow"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2"
        app:layout_constraintBottom_toBottomOf="@+id/vote_text_guide"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/vote_text_guide"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/vote_text_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="13dp"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_count_down"
        android:layout_width="14dp"
        android:layout_height="27dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/vote_bar_divider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/vote_win_anim_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
