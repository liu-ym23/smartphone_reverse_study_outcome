<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.ss.android.lark.ui.CommonTitleBar
        android:id="@+id/titlebar_file_detail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/image_file_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="100dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titlebar_file_detail"
        app:srcCompat="@drawable/icon_file_default"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/text_title"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/text_file_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="45dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="45dp"
        android:maxLines="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image_file_icon"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_placeholder"
        android:id="@+id/text_file_size"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toStartOf="@+id/text_file_speed"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/text_file_name"
        app:layout_constraintTop_toBottomOf="@+id/text_file_name"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_placeholder"
        android:id="@+id/text_file_speed"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/text_file_size"
        app:layout_constraintEnd_toEndOf="@+id/text_file_name"
        app:layout_constraintStart_toEndOf="@+id/text_file_size"
        app:layout_constraintTop_toTopOf="@+id/text_file_size"/>
    <ImageView
        android:id="@+id/decrypt_loading"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_file_size"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/primary_fill_default"
        android:layout_gravity="center_horizontal"
        android:id="@+id/decrypt_tips"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="30dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_file_size"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btn_file_progress_close"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:paddingStart="6dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/progressbar"
        app:layout_constraintTop_toBottomOf="@+id/text_file_size"
        app:srcCompat="@drawable/ud_icon_error_colorful"/>
    <ProgressBar
        android:id="@+id/progressbar"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:progress="0"
        android:secondaryProgress="0"
        android:progressDrawable="@drawable/progress_bar_file_detail"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_file_progress_close"
        app:layout_constraintEnd_toStartOf="@+id/btn_file_progress_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_file_progress_close"
        style="?android:attr/progressBarStyleHorizontal"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/primary_fill_default"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tips_tv"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="@+id/progressbar"
        app:layout_constraintStart_toStartOf="@+id/progressbar"
        app:layout_constraintTop_toTopOf="@+id/progressbar"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/layout_file_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="btn_file_progress_close,progressbar,tips_tv"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/static_white"
        android:gravity="center"
        android:id="@+id/btn_file_download"
        android:background="@drawable/file_download_function_btn_normal_bg_selector"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="82.5dp"
        android:layout_marginRight="82.5dp"
        android:layout_marginBottom="82.5dp"
        android:text="@string/Lark_Legacy_Download"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
