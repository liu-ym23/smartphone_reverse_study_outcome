<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/annie_sjb_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <ImageView
        android:id="@+id/fail_background"
        android:layout_width="240dp"
        android:layout_height="200dp"
        android:src="@drawable/annie_web_fail_bg_sjb"/>
    <TextView
        android:textSize="13sp"
        android:textColor="#bebebe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/annie_retry_after_check_notwork_sjb"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/annie_white"
        android:id="@+id/web_retry"
        android:background="@drawable/annie_bg_retry_btn_sjb_selector"
        android:layout_width="220dp"
        android:layout_height="40dp"
        android:layout_marginTop="18dp"
        android:text="@string/annie_retry_sjb"/>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
