<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/layout_rittag"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="14dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/layout_rittag_head"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="2dp"
        android:layout_marginEnd="2dp"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/ec_color_FE2C55"
        android:ellipsize="end"
        android:id="@+id/tv_rittag1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"/>
    <View
        android:layout_gravity="center_vertical"
        android:id="@+id/view_rittag_divider"
        android:background="@drawable/ec_bg_card_rittag_divider"
        android:visibility="gone"
        android:layout_width="0.5dp"
        android:layout_height="8dp"
        android:layout_marginLeft="3.5dp"
        android:layout_marginRight="3.5dp"/>
    <TextView
        android:textSize="10dp"
        android:textColor="@color/ec_color_FE2C55"
        android:ellipsize="end"
        android:id="@+id/tv_rittag2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"/>
</LinearLayout>
