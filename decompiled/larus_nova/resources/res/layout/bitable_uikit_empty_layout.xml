<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/error_wrapper"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="300dp">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/start_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.2"/>
    <com.larksuite.component.universe_design.emptystate.UDEmptyState
        android:layout_gravity="center"
        android:id="@+id/empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/start_line"
        app:ud_empty_imageSize="100dp"
        style="@style/UDEmptyState"/>
    <ViewStub
        android:layout_gravity="center"
        android:id="@+id/empty_view_loading_stub"
        android:visibility="gone"
        android:layout="@layout/bitable_uikit_loading_stub_layout"
        android:layout_width="130dp"
        android:layout_height="130dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/start_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>
