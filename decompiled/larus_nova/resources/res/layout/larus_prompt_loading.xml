<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/loading_container_wcb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/loading_1"
            android:layout_width="250dp"
            android:layout_height="37dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="?attr/larus_prompt_loading_long"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/loading_2"
            android:layout_width="200dp"
            android:layout_height="37dp"
            android:layout_marginTop="?attr/larus_dp_10"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/loading_1"
            app:srcCompat="?attr/larus_prompt_loading_short"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/loading_3"
            android:layout_width="200dp"
            android:layout_height="37dp"
            android:layout_marginTop="?attr/larus_dp_10"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/loading_2"
            app:srcCompat="?attr/larus_prompt_loading_short"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/loading_4"
            android:layout_width="200dp"
            android:layout_height="37dp"
            android:layout_marginTop="?attr/larus_dp_10"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/loading_3"
            app:srcCompat="?attr/larus_prompt_loading_short"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/loading_container_first_met"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/loading_first_1"
            android:layout_width="262dp"
            android:layout_height="37dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="?attr/larus_prompt_loading_first_met_1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/loading_first_2"
            android:layout_width="200dp"
            android:layout_height="37dp"
            android:layout_marginLeft="?attr/larus_dp_10"
            app:layout_constraintStart_toEndOf="@+id/loading_first_1"
            app:layout_constraintTop_toTopOf="@+id/loading_first_1"
            app:srcCompat="?attr/larus_prompt_loading_first_met_2"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/loading_first_3"
            android:layout_width="200dp"
            android:layout_height="37dp"
            android:layout_marginTop="?attr/larus_dp_10"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/loading_first_1"
            app:srcCompat="?attr/larus_prompt_loading_first_met_2"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/loading_first_4"
            android:layout_width="200dp"
            android:layout_height="37dp"
            android:layout_marginLeft="?attr/larus_dp_10"
            app:layout_constraintStart_toEndOf="@+id/loading_first_3"
            app:layout_constraintTop_toTopOf="@+id/loading_first_3"
            app:srcCompat="?attr/larus_prompt_loading_first_met_2"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/loading_first_5"
            android:layout_width="200dp"
            android:layout_height="37dp"
            android:layout_marginTop="?attr/larus_dp_10"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/loading_first_3"
            app:srcCompat="?attr/larus_prompt_loading_first_met_2"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/loading_first_6"
            android:layout_width="200dp"
            android:layout_height="37dp"
            android:layout_marginLeft="?attr/larus_dp_10"
            app:layout_constraintStart_toEndOf="@+id/loading_first_5"
            app:layout_constraintTop_toTopOf="@+id/loading_first_5"
            app:srcCompat="?attr/larus_prompt_loading_first_met_2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
