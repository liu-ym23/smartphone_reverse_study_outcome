<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/annie_x_title_bar"
    android:background="@color/bullet_color_161823"
    android:layout_width="match_parent"
    android:layout_height="@dimen/title_bar_height"
    android:minHeight="@dimen/title_bar_height">
    <LinearLayout
        android:layout_gravity="start|center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginStart="6dp">
        <com.bytedance.ies.bullet.ui.common.view.AutoRTLImageView
            android:id="@+id/annie_x_title_btn_back"
            android:padding="10dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_title_bar_back_normal"/>
        <com.bytedance.ies.bullet.ui.common.view.AutoRTLImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/annie_x_title_btn_close"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_title_bar_close_normal"/>
    </LinearLayout>
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/bullet_color_f0f0f0"
        android:ellipsize="end"
        android:layout_gravity="center"
        android:id="@+id/annie_x_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:maxEms="9"/>
    <LinearLayout
        android:layout_gravity="end|center_vertical"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginStart="6dp">
        <com.bytedance.ies.bullet.ui.common.view.AutoRTLImageView
            android:id="@+id/annie_x_title_btn_share"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/bullet_ic_title_bar_share_normal"/>
        <com.bytedance.ies.bullet.ui.common.view.AutoRTLImageView
            android:id="@+id/annie_x_title_btn_report"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/bullet_ic_title_bar_report_normal"/>
        <com.bytedance.ies.bullet.ui.common.view.AutoRTLImageView
            android:id="@+id/annie_x_title_btn_more"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/bullet_ic_title_bar_more_normal"/>
    </LinearLayout>
</FrameLayout>
