<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/user_info_cl"
    android:paddingTop="100dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/aos_uikit_t_primary_dark"
        android:ellipsize="end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/aos_collect_title"
        android:singleLine="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/collect_header_linear_layout"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp">
        <com.bytedance.awemeopen.infra.base.image.AoImageView
            android:layout_gravity="center"
            android:id="@+id/header_image"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                android:textSize="14sp"
                android:textColor="@color/aos_uikit_t_secondary_dark"
                android:ellipsize="end"
                android:id="@+id/user_name_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_marginStart="4dp"/>
            <com.bytedance.awemeopen.apps.framework.base.view.refresh.DmtTextView
                android:textSize="12sp"
                android:textColor="@color/aos_uikit_t_primary_dark"
                android:gravity="center"
                android:background="@drawable/aos_douyin_verify_bg"
                android:layout_width="56dp"
                android:layout_height="20dp"
                android:text="@string/aos_douyin_verify"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
