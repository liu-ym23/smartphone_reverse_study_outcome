<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/shopping_layout_sku_chart_entry_layout_1290618314"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Space
        android:id="@+id/shopping_layout_sku_chart_entry_layout_1174778988"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/chart_helper_entry"
        android:background="@drawable/shopping_sku_group_title_entry_bg"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="21dp">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/ic_chart_entry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:scaleType="centerCrop"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/shopping_std_brand"
            android:id="@+id/tv_chart_entry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shopping_tv_chart_entry"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_chart_arrow_chart_helper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:src="@drawable/shopping_ic_sku_chart_helper"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
</LinearLayout>
