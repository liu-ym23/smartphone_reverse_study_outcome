<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/fragment_container"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="400dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/guide_content"
        android:layout_width="match_parent"
        android:layout_height="213dp"
        android:layout_marginBottom="23dp"/>
    <TextView
        android:textSize="17dp"
        android:textColor="@color/black"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13dp"
        android:text="唱歌可以展示个人作品啦"/>
    <TextView
        android:textSize="15dp"
        android:textColor="#6f6f71"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="找到MV按钮，选择你喜欢的作品吧"/>
    <LinearLayout
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.android.live.ktv.common.view.CommomKtvButton
            android:layout_gravity="center_horizontal"
            android:id="@+id/cancel"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginRight="8dp"
            android:text="知道了"
            android:layout_weight="1"/>
        <com.bytedance.android.live.ktv.common.view.CommomKtvButton
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_try"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:text="去试试"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
