<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/drive_upload_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_kit_len_12">
    <com.bytedance.ee.bear.widgets.universedesign.SpaceShadowLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        app:ud_shadow_color="@color/ud_shadow_s1"
        app:ud_shadow_radius="@dimen/space_kit_len_10"
        style="@style/UDShadow.S2">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/drive_upload_container"
            android:background="@drawable/facade_round_10_stroke_1"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/space_kit_font_16"
            android:layout_marginEnd="@dimen/space_kit_len_16">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/upload_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="@dimen/space_kit_len_12"
                android:layout_marginBottom="@dimen/space_kit_len_12"
                android:tint="@color/primary_fill_default"
                android:layout_marginStart="@dimen/space_kit_len_12"
                android:layout_marginEnd="@dimen/space_kit_len_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ud_icon_driveload_outlined"/>
            <TextView
                android:textSize="@dimen/font_size_17"
                android:textStyle="bold"
                android:textColor="@color/text_title"
                android:id="@+id/upload_title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="@dimen/space_kit_len_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/upload_icon"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.bytedance.ee.bear.widgets.universedesign.SpaceShadowLayout>
</LinearLayout>
