<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/ttlive_effect_beauty_common_list_item_padding"
    android:layout_width="@dimen/ttlive_effect_beauty_common_list_item_width"
    android:layout_height="@dimen/ttlive_effect_beauty_common_list_item_height">
    <View
        android:id="@+id/border"
        android:background="@drawable/ttlive_effect_bg_live_filter_red"
        android:layout_width="@dimen/ttlive_effect_beauty_common_item_selected_size"
        android:layout_height="@dimen/ttlive_effect_beauty_common_item_selected_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_bg"
        android:layout_width="@dimen/ttlive_effect_beauty_common_item_icon_width"
        android:layout_height="@dimen/ttlive_effect_beauty_common_item_icon_height"
        app:layout_constraintBottom_toBottomOf="@+id/border"
        app:layout_constraintEnd_toEndOf="@+id/border"
        app:layout_constraintStart_toStartOf="@+id/border"
        app:layout_constraintTop_toTopOf="@+id/border"
        app:roundAsCircle="true"/>
    <ImageView
        android:id="@+id/iv_loading"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_margin="16dp"
        android:src="@drawable/ttlive_live_img_loading"
        app:layout_constraintBottom_toBottomOf="@+id/border"
        app:layout_constraintEnd_toEndOf="@+id/border"
        app:layout_constraintStart_toStartOf="@+id/border"
        app:layout_constraintTop_toTopOf="@+id/border"/>
    <View
        android:id="@+id/item_filter_dot"
        android:background="@drawable/ttlive_effect_ic_filter_red_point"
        android:visibility="gone"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="@+id/border"
        app:layout_constraintTop_toTopOf="@+id/border"/>
    <TextView
        android:textSize="12dp"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:id="@+id/tv_name"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lines="1"
        android:layout_below="@+id/icon_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/border"/>
</androidx.constraintlayout.widget.ConstraintLayout>
