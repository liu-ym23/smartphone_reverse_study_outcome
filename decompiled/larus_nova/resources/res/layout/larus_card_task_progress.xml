<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larus.common_ui.venus.ShapeConstraintLayout
        android:id="@+id/progress_card_layout"
        android:paddingLeft="?attr/larus_dp_16"
        android:paddingTop="?attr/larus_dp_14"
        android:paddingRight="?attr/larus_dp_16"
        android:paddingBottom="?attr/larus_dp_16"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:larus_sc_cornerRadius="8dp"
        app:larus_sc_fillColor="?attr/larus_base_1">
        <View
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="?attr/larus_dp_17"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_70"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_4"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintBottom_toTopOf="@+id/progress_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/title"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <com.larus.bmhome.chat.layout.widget.ShimmerProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_10"
            android:layout_marginTop="?attr/larus_dp_10"
            android:max="100"
            android:progressDrawable="?attr/larus_deep_research_progress_bar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/subtitle"
            style="@android:style/Widget.ProgressBar.Horizontal"/>
    </com.larus.common_ui.venus.ShapeConstraintLayout>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textColor="?attr/larus_neutral_70"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/finish_desc"
        android:paddingTop="?attr/larus_dp_2"
        android:paddingBottom="?attr/larus_dp_2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:drawableRight="?attr/larus_ic_arrow_right_grey"
        android:drawablePadding="?attr/larus_dp_4"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/button_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:layout_marginTop="@dimen/dp_12"
        android:baselineAligned="false">
        <LinearLayout
            android:gravity="center"
            android:id="@+id/left_button_layout"
            android:background="@drawable/larus_bg_base_1_radius_8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="?attr/larus_dp_6">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/left_button_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/larus_icon_task_card_quote"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:textSize="@dimen/dp_16"
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/left_button_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/right_button_layout"
            android:background="@drawable/larus_bg_base_1_radius_8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="?attr/larus_dp_6">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/right_button_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/larus_icon_task_card_arrow_line"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:textSize="@dimen/dp_16"
                android:textColor="?attr/larus_neutral_100"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/right_button_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
