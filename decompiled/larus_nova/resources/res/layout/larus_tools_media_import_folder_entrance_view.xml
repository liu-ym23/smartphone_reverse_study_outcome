<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_gravity="center"
    android:id="@+id/change_album_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerInParent="true">
    <com.ss.android.ugc.tools.view.style.StyleTextView
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_folder_entrance"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginRight="4dp"
        android:maxWidth="150dp"
        android:text="@string/larus_album_all_photos_btn"
        android:maxLines="1"
        android:layout_marginEnd="4dp"
        app:ts_enable_text_color="false"
        app:ts_font_type="medium"
        style="@style/tools_font_size_34"/>
    <ImageView
        android:id="@+id/iv_entrance_arrow"
        android:layout_width="20dp"
        android:layout_height="match_parent"
        android:src="@drawable/larus_tools_media_import_folder_arrow_icon"
        android:scaleType="center"/>
</LinearLayout>
