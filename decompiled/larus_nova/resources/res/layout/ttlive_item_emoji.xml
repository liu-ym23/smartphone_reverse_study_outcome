<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="56dp"
    android:layout_height="@dimen/ttlive_interact_emoji_item_height">
    <com.bytedance.android.live.core.widget.HSImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/emoji_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        app:failureImage="@drawable/ttlive_icon_default_emoji"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/emoji_lock_icon"
        android:layout_width="12dp"
        android:layout_height="15dp"
        android:src="@drawable/ttlive_icon_interact_emoji_locked"/>
    <TextView
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:gravity="center_horizontal"
        android:id="@+id/interact_emoji_tip"
        android:background="@drawable/interact_emoji_tip"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="28dp"
        android:layout_marginTop="1dp"
        android:layout_marginRight="-28dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="-28dp"/>
    <TextView
        android:textSize="8sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/random_emoji_tip"
        android:background="@drawable/random_emoji_bottom_tip"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="12dp"/>
    <TextView
        android:textSize="8sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/tv_interact_emoji_bottom_tip"
        android:background="@drawable/interact_emoji_bottom_tip"
        android:paddingLeft="5dp"
        android:paddingRight="5dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="12dp"/>
</FrameLayout>
