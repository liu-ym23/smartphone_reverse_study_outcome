<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/larus_bg_phone_login_lark_auth_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/larus_phone_login_account_discovery_lark_auth_title"
        android:fontFamily="sans-serif-medium"/>
    <TextView
        android:textSize="15sp"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="24dp"
        android:lineSpacingExtra="2dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="?attr/larus_static_white"
        android:gravity="center"
        android:id="@+id/open_lark"
        android:background="@drawable/larus_bg_phone_login_lark_auth_primary_button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="16dp"
        android:text="@string/larus_phone_login_account_discovery_lark_auth_open"
        android:fontFamily="sans-serif-medium"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="17sp"
        android:textColor="?attr/larus_neutral_70"
        android:gravity="center"
        android:id="@+id/cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/larus_phone_login_account_discovery_lark_auth_cancel"
        android:fontFamily="sans-serif"/>
</LinearLayout>
