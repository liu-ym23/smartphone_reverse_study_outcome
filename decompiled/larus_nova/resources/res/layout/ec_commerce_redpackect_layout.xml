<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="180dp"
    android:layout_height="90dp">
    <FrameLayout
        android:id="@+id/redPacketNormal"
        android:layout_width="wrap_content"
        android:layout_height="76dp"
        android:layout_marginLeft="10dp"
        android:elevation="1dp">
        <LinearLayout
            android:layout_gravity="top"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <FrameLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/redPacketBackground"
                android:background="@drawable/commerce_red_packet_background"
                android:layout_width="42dp"
                android:layout_height="48dp">
                <com.bytedance.android.ec.core.widget.PriceView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/redPacketAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:extraTextColor="@color/shopping_color_FE496A"
                    app:extraTextSize="11dp"
                    app:priceDecimalTextSize="13dp"
                    app:priceText="8.8"
                    app:priceTextColor="@color/shopping_color_FE496A"
                    app:priceTextSize="18dp"
                    app:spaceSize="2dp"
                    app:thinDecimal="true"
                    app:yangTextSize="13dp"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-10dp">
                <TextView
                    android:textSize="11dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/redPacketBottomTextViewSmall"
                    android:background="@drawable/ec_redpacket_bottom_background_small"
                    android:layout_width="57dp"
                    android:layout_height="20dp"
                    android:text="待使用"/>
                <FrameLayout
                    android:id="@+id/redPacketBottomViewBig"
                    android:background="@drawable/commerce_red_packet_countdown_background"
                    android:visibility="gone"
                    android:layout_width="57dp"
                    android:layout_height="32dp">
                    <TextView
                        android:textSize="11dp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/redPacketBottomTextViewBig"
                        android:layout_width="57dp"
                        android:layout_height="20dp"
                        android:text="待使用"/>
                    <TextView
                        android:textSize="10dp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:layout_gravity="bottom"
                        android:id="@+id/redPacketBottomCountdown"
                        android:layout_width="57dp"
                        android:layout_height="18dp"
                        android:text="00:00:00"/>
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="top"
        android:id="@+id/redPacketCloseButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="55dp"
        android:elevation="2dp">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/commerce_close_button"/>
    </FrameLayout>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/ec_inflow_full_price_color"
        android:gravity="center"
        android:id="@+id/redPacketCountDown"
        android:background="@drawable/ec_countdown_pink_bg"
        android:layout_width="109dp"
        android:layout_height="36dp"
        android:layout_marginLeft="55dp"
        android:layout_marginTop="12dp"
        android:elevation="0dp"/>
    <ImageView
        android:id="@+id/redPacketCollapsed"
        android:visibility="gone"
        android:layout_width="26dp"
        android:layout_height="95dp"
        android:src="@drawable/commerce_red_packet_collapsed"/>
</FrameLayout>
