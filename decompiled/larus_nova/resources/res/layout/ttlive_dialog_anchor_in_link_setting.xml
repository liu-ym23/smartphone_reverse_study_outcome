<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/outside"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/ttlive_label_close"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:background="@drawable/ttlive_bg_feedback_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="298dp">
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/title_container"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/setting_back"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginLeft="12dp"
                android:src="@drawable/ttlive_ic_pk_back"/>
            <TextView
                android:textSize="15dp"
                android:textStyle="bold"
                android:textColor="@color/ttlive_std_text_black_1"
                android:layout_gravity="center"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_anchor_interact_link_setting"/>
        </FrameLayout>
        <View
            android:id="@+id/divider"
            android:background="#14161823"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title_container"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/divider">
            <FrameLayout
                android:id="@+id/group_pk_time"
                android:background="@color/ttlive_white"
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <TextView
                    android:textSize="15dp"
                    android:textColor="#161823"
                    android:layout_gravity="start|center_vertical"
                    android:focusable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:text="@string/ttlive_anchor_interact_pk_duration_setting"
                    android:layout_marginStart="16dp"/>
                <ImageView
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/iv_time_arrow"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginRight="8dp"
                    android:src="@drawable/ttlive_ic_pk_time_setting_arrow"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:textSize="15dp"
                    android:textColor="#161823"
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/tv_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="30dp"
                    android:hint="120s"
                    android:layout_marginEnd="30dp"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/fl_allow_enlarge"
                android:background="@color/ttlive_white"
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <TextView
                    android:textSize="15dp"
                    android:textColor="#161823"
                    android:layout_gravity="start|center_vertical"
                    android:focusable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:text="@string/ttlive_anchor_interact_link_allow_enlarge"
                    android:layout_marginStart="16dp"/>
                <Switch
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/switch_allow_enlarge"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginRight="16dp"
                    android:checked="false"
                    android:textOn=""
                    android:textOff=""
                    android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
                    android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
                    android:layout_marginEnd="16dp"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/fl_pk_egg_container"
                android:background="@color/ttlive_white"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <LinearLayout
                    android:layout_gravity="start|center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginStart="16dp">
                    <TextView
                        android:textSize="15dp"
                        android:textColor="#161823"
                        android:focusable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ttlive_anchor_interact_pk_egg_setting"/>
                    <ImageView
                        android:layout_gravity="start|center_vertical"
                        android:id="@+id/iv_pk_egg_rule_icon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginLeft="5dp"
                        android:src="@drawable/ttlive_ic_pk_egg_rule"
                        android:layout_marginStart="5dp"/>
                </LinearLayout>
                <Switch
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/switch_pk_egg"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginRight="16dp"
                    android:checked="false"
                    android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
                    android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
                    android:layout_marginEnd="16dp"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/fl_allow_auto_start_prop_card"
                android:background="@color/ttlive_white"
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <TextView
                    android:textSize="15dp"
                    android:textColor="#161823"
                    android:layout_gravity="start|center_vertical"
                    android:focusable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:text="@string/ttlive_anchor_interact_pk_allow_auto_start_prop_card"
                    android:layout_marginStart="16dp"/>
                <Switch
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/switch_allow_auto_start_prop_card"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginRight="16dp"
                    android:checked="false"
                    android:textOn=""
                    android:textOff=""
                    android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
                    android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
                    android:layout_marginEnd="16dp"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/fl_allow_auto_start_steal_dragon"
                android:background="@color/ttlive_white"
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <TextView
                    android:textSize="15dp"
                    android:textColor="#161823"
                    android:layout_gravity="start|center_vertical"
                    android:focusable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:text="@string/ttlive_anchor_interact_pk_allow_auto_start_steal_dragon"
                    android:layout_marginStart="16dp"/>
                <Switch
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/switch_allow_auto_start_steal_dragon"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginRight="16dp"
                    android:checked="false"
                    android:textOn=""
                    android:textOff=""
                    android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
                    android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
                    android:layout_marginEnd="16dp"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/allow_others_send_invite_container"
                android:layout_width="match_parent"
                android:layout_height="52dp">
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_std_text_black_1"
                    android:layout_gravity="start|center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:text="@string/ttlive_multi_link_allow_other_send_invite_desc"
                    android:layout_marginStart="16dp"/>
                <FrameLayout
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/switch_allow_others_send_invite_container"
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginEnd="16dp">
                    <Switch
                        android:id="@+id/switch_allow_others_send_invite"
                        android:layout_width="wrap_content"
                        android:layout_height="25dp"
                        android:checked="true"
                        android:textOn=""
                        android:textOff=""
                        android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
                        android:track="@drawable/ttlive_selector_interact_dialog_switch_track"/>
                </FrameLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/allow_others_send_apply_container"
                android:layout_width="match_parent"
                android:layout_height="52dp">
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_std_text_black_1"
                    android:layout_gravity="start|center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:text="@string/ttlive_multi_link_allow_other_send_apply_desc"
                    android:layout_marginStart="16dp"/>
                <FrameLayout
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/switch_allow_others_send_apply_container"
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginEnd="16dp">
                    <Switch
                        android:id="@+id/switch_allow_others_send_apply"
                        android:layout_width="wrap_content"
                        android:layout_height="25dp"
                        android:checked="true"
                        android:textOn=""
                        android:textOff=""
                        android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
                        android:track="@drawable/ttlive_selector_interact_dialog_switch_track"/>
                </FrameLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/show_ext_score_switch_container"
                android:layout_width="match_parent"
                android:layout_height="52dp">
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_std_text_black_1"
                    android:layout_gravity="start|center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:text="@string/ttlive_anchor_link_setting_show_ext_score_when_two_link"
                    android:layout_marginStart="16dp"/>
                <FrameLayout
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/switch_show_ext_score_when_two_link_container"
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginEnd="16dp">
                    <Switch
                        android:id="@+id/switch_show_ext_score_when_two_link"
                        android:layout_width="wrap_content"
                        android:layout_height="25dp"
                        android:checked="true"
                        android:textOn=""
                        android:textOff=""
                        android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
                        android:track="@drawable/ttlive_selector_interact_dialog_switch_track"/>
                </FrameLayout>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/clear_ext_score_setting_layout"
                android:layout_width="match_parent"
                android:layout_height="52dp">
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/ttlive_std_text_black_1"
                    android:layout_gravity="start|center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:text="@string/ttlive_anchor_link_setting_clear_ext_score_when_two_link"
                    android:layout_marginStart="16dp"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="@color/ttlive_std_text_black_1"
                    android:gravity="center"
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/btn_clear_ext_score_setting"
                    android:background="@drawable/ttlive_bg_anchor_link_setting_clear_score_btn"
                    android:layout_width="64dp"
                    android:layout_height="28dp"
                    android:layout_marginRight="16dp"
                    android:text="@string/ttlive_anchor_link_setting_clear_ext_score"
                    android:layout_marginEnd="16dp"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/fl_ai_assistant_cellular_enhancement"
                android:background="@color/ttlive_white"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <TextView
                    android:textSize="15dp"
                    android:textColor="#161823"
                    android:layout_gravity="start|center_vertical"
                    android:focusable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:text="@string/ttlive_anchor_interact_ai_assistant_cellular_enhancement"
                    android:layout_marginStart="16dp"/>
                <Switch
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/switch_allow_ai_assistant_cellular_enhancement"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginRight="16dp"
                    android:checked="false"
                    android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
                    android:track="@drawable/ttlive_selector_interact_dialog_switch_track"
                    android:layout_marginEnd="16dp"/>
            </FrameLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
