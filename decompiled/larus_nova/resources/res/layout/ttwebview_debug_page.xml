<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#f5f5f5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="基本信息(长按复制)"/>
            <View
                android:background="#e0e0e0"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <TextView
                android:textColor="#666666"
                android:id="@+id/version_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="TTWebView 0620010001"
                android:textIsSelectable="true"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@android:color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="开关配置"/>
            <View
                android:background="#e0e0e0"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <Button
                android:textColor="#333333"
                android:gravity="center"
                android:id="@+id/show_switch_values"
                android:background="?android:attr/selectableItemBackground"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="查看所有开关值 (支持搜索)"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@android:color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="内核管理"/>
            <View
                android:background="#e0e0e0"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <Button
                android:textColor="#333333"
                android:gravity="center"
                android:id="@+id/pull_ttwebview"
                android:background="?android:attr/selectableItemBackground"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="强制拉取内核（线上内核）"/>
            <View
                android:background="#e0e0e0"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <Button
                android:textColor="#333333"
                android:gravity="center"
                android:id="@+id/pull_debug_core"
                android:background="?android:attr/selectableItemBackground"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="强制拉取 Debug 内核"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="日志信息"/>
            <View
                android:background="#e0e0e0"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <TextView
                android:textColor="#666666"
                android:id="@+id/log_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textIsSelectable="true"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@android:color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="设置选项"/>
            <View
                android:background="#e0e0e0"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <Switch
                android:textColor="#333333"
                android:id="@+id/use_ttwebview"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="开启 TTWebView"/>
            <View
                android:background="#e0e0e0"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <Switch
                android:textColor="#333333"
                android:id="@+id/use_boe"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="接入 BOE 测试环境 (重启后生效)"/>
            <View
                android:background="#e0e0e0"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <Switch
                android:textColor="#333333"
                android:id="@+id/enable_netlog"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="启用 NetLog (重启后生效)"/>
            <View
                android:background="#e0e0e0"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <Switch
                android:textColor="#333333"
                android:id="@+id/should_override_setting_origin"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="覆盖默认 setting 域名"/>
            <View
                android:background="#e0e0e0"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <Switch
                android:textColor="#333333"
                android:id="@+id/debug_scc"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="记录 SCC 云查信息"/>
        </LinearLayout>
        <Button
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:id="@+id/reboot"
            android:background="#ff5252"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="重启应用"/>
    </LinearLayout>
</ScrollView>
