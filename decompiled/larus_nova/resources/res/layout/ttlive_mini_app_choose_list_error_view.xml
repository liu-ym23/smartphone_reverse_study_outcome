<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="428dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/center_error_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/error_image"
            android:layout_width="160dp"
            android:layout_height="106dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#99161823"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/error_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ttlive_mini_app_choose_search_no_relevant_result"/>
    </LinearLayout>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#161823"
        android:gravity="center"
        android:id="@+id/error_btn"
        android:background="@drawable/ttlive_mini_app_choose_list_error_view_button_bg"
        android:layout_width="230dp"
        android:layout_height="44dp"
        android:layout_marginTop="80dp"
        android:text="@string/ttlive_mini_app_choose_list_refresh"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/center_error_area"/>
</androidx.constraintlayout.widget.ConstraintLayout>
