<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/cj_standard_pay_payment_confirm_root_view"
    android:background="@drawable/cj_pay_bg_fragment_container_blackable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="4dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/cj_standard_pay_payment_confirm_content_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/cj_standard_pay_bottom_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread_inside">
        <include
            android:id="@+id/cj_standard_pay_titlebar_root_view"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            layout="@layout/cj_pay_view_titlebar_noise_reduction_layout"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/cj_pay_color_black_161823"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_standard_pay_order_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/cj_pay_padding_24"
            android:layout_marginRight="@dimen/cj_pay_padding_24"
            android:singleLine="true"
            android:includeFontPadding="false"/>
        <include
            android:id="@+id/cj_standard_amount_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cj_pay_padding_8"
            layout="@layout/cj_pay_amount_view_layout"/>
        <include
            android:id="@+id/cj_pay_view_verify_discount_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/cj_pay_view_verify_discount_layout"/>
        <com.android.ttcjpaysdk.thirdparty.verify.view.marketing.CJMarketingCountdownView
            android:id="@+id/cj_pay_marketing_countdown_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:id="@+id/pay_type_helper_layout_divider_line"
            android:background="?attr/cj_pay_border_divider_grey_color"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="20dp"
            app:layout_goneMarginTop="24dp"/>
        <include
            android:id="@+id/cj_pay_view_pay_type_combine_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="20dp"
            app:layout_constraintTop_toBottomOf="@+id/pay_type_helper_layout_divider_line"
            app:layout_goneMarginTop="16dp"
            layout="@layout/cj_pay_view_pay_type_combine_layout"/>
        <com.android.ttcjpaysdk.thirdparty.verify.view.RecommendView
            android:id="@+id/cj_standard_pay_pay_type_recommend"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="20dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/cj_standard_pay_bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintTop_toBottomOf="@+id/cj_standard_pay_payment_confirm_content_layout">
        <FrameLayout
            android:id="@+id/standard_pay_pre_verify_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:id="@+id/cj_standard_pay_keyboard_place_view"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
    </LinearLayout>
    <include
        android:id="@+id/cj_pay_security_panel_loading_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cj_standard_pay_payment_confirm_content_layout"
        layout="@layout/cj_pay_view_security_panel_loading_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
