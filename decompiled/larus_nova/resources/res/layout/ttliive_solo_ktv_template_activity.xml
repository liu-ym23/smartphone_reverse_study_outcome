<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_content"
    android:background="#0d0e19"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextureView
        android:id="@+id/audio_timeline_textureview"
        android:layout_width="1px"
        android:layout_height="1px"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.soloktv.view.SoloKtvTopBar
        android:id="@+id/st_topbar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="44dp"
        app:layout_constraintTop_toTopOf="parent"
        app:rightMenuType="finish"/>
    <FrameLayout
        android:id="@+id/template_container"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/mv_select_container"
        app:layout_constraintTop_toBottomOf="@+id/st_topbar">
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/gallery"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/mv_select_container"
        android:background="#161822"
        android:layout_width="match_parent"
        android:layout_height="243dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="15dp">
            <TextView
                android:textSize="16sp"
                android:gravity="center"
                android:id="@+id/tv_mv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/ttlive_solo_ktv_bg"
                android:layout_weight="1"/>
            <TextView
                android:textSize="16sp"
                android:gravity="center"
                android:id="@+id/tv_adjust"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/ttlive_solo_ktv_adjust"
                android:layout_weight="1"/>
        </LinearLayout>
        <View
            android:background="#22242d"
            android:layout_width="match_parent"
            android:layout_height="0.2dp"
            android:alpha="0.4"/>
        <FrameLayout
            android:id="@+id/control_area"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
