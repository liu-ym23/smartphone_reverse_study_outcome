<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="60dp">
    <Space
        android:id="@+id/ttlive_space"
        android:layout_width="12dp"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/debug_indicator_container"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="0dp"
        android:layout_marginStart="0dp"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.widget.opt.MeasureOptFrameLayout
        android:id="@+id/short_term_indicator_container"
        android:layout_width="0dp"
        android:layout_height="@dimen/ttlive_short_term_indicator_height"
        app:layout_constraintEnd_toStartOf="@+id/task_indicator_container"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/ttlive_space"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/first_show_hint"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="4dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintLeft_toLeftOf="@+id/short_term_indicator_container"
        app:layout_constraintTop_toBottomOf="@+id/short_term_indicator_container"/>
    <FrameLayout
        android:id="@+id/task_indicator_container"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginStart="4dp"
        app:layout_constraintEnd_toStartOf="@+id/activity_and_predictor_container"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/short_term_indicator_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/activity_and_predictor_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginStart="4dp"
        app:layout_constraintEnd_toStartOf="@+id/ttlive_space2"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/task_indicator_container"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/activity_indicator_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginStart="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ttlive_space2"
            app:layout_constraintStart_toEndOf="@+id/task_indicator_container"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/predictor_entrance_container"
            android:visibility="gone"
            android:layout_width="@dimen/ttlive_multi_top_right_banner_width"
            android:layout_height="@dimen/ttlive_room_top_right_banner_height"
            android:layout_marginLeft="4dp"
            android:layout_marginStart="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ttlive_space2"
            app:layout_constraintStart_toEndOf="@+id/task_indicator_container"
            app:layout_constraintTop_toTopOf="parent"/>
    </FrameLayout>
    <Space
        android:id="@+id/ttlive_space2"
        android:layout_width="@dimen/ttlive_live_room_indicator_space_right"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
