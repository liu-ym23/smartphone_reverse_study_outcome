<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/guide_view_left"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toStartOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintHorizontal_weight="4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/guide_view_right"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="4"
        app:layout_constraintStart_toEndOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/ttlive_guest_avatar_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="h,1:1"
        app:layout_constraintEnd_toStartOf="@+id/guide_view_right"
        app:layout_constraintHorizontal_weight="44"
        app:layout_constraintStart_toEndOf="@+id/guide_view_left"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.live.liveinteract.chatroom.chatroom.ui.SeatAnimationView
        android:id="@+id/seat_anim_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintEnd_toEndOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintStart_toStartOf="@+id/ttlive_guest_avatar_container"
        app:layout_constraintTop_toTopOf="@+id/ttlive_guest_avatar_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
