<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/obric_env_observe_layout"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="?attr/larus_dp_12"
        android:paddingTop="?attr/larus_dp_104"
        android:paddingRight="?attr/larus_dp_12"
        android:paddingBottom="?attr/larus_dp_32"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/obric_env_observe_icon"
            android:layout_width="?attr/larus_dp_72"
            android:layout_height="?attr/larus_dp_72"
            android:contentDescription="@string/onboarding_diary_title"
            app:roundedCornerRadius="?attr/larus_dp_20"/>
        <com.larus.dora.impl.view.DoraTextViewWithAnim
            android:textSize="?attr/larus_sp_24"
            android:textStyle="bold"
            android:textColor="@color/oui_basic_text_1"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_20"
            android:text="@string/larus_dora_onboarding_glasses_memory_title_cn"
            android:includeFontPadding="false"/>
        <com.larus.dora.impl.view.DoraTextViewWithAnim
            android:textSize="?attr/larus_sp_14"
            android:textColor="@color/oui_basic_text_3"
            android:gravity="start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="?attr/larus_dp_20"
            android:layout_marginTop="?attr/larus_dp_8"
            android:layout_marginRight="?attr/larus_dp_20"
            android:text="@string/larus_dora_onboarding_glasses_memory_desc_cn"
            android:includeFontPadding="false"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/obric_onboarding_diary_service_card_bg"
            android:padding="?attr/larus_dp_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_40">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingLeft="?attr/larus_dp_12"
                android:paddingRight="?attr/larus_dp_12"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_60">
                <com.larus.dora.impl.view.DoraTextViewWithAnim
                    android:textSize="?attr/larus_sp_16"
                    android:textColor="@color/oui_basic_text_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_onboarding_glasses_memory_life_diary_cn"
                    android:includeFontPadding="false"/>
                <com.larus.dora.impl.view.DoraTextViewWithAnim
                    android:textSize="?attr/larus_sp_12"
                    android:textColor="@color/oui_basic_text_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_2"
                    android:text="@string/onboarding_diary_life_diary_desc"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingLeft="?attr/larus_dp_12"
                android:paddingRight="?attr/larus_dp_12"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_60">
                <com.larus.dora.impl.view.DoraTextViewWithAnim
                    android:textSize="?attr/larus_sp_16"
                    android:textColor="@color/oui_basic_text_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_onboarding_glasses_memory_meeting_notes_cn"
                    android:includeFontPadding="false"/>
                <com.larus.dora.impl.view.DoraTextViewWithAnim
                    android:textSize="?attr/larus_sp_12"
                    android:textColor="@color/oui_basic_text_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_2"
                    android:text="@string/onboarding_diary_meeting_notes_desc"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingLeft="?attr/larus_dp_12"
                android:paddingRight="?attr/larus_dp_12"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_60">
                <com.larus.dora.impl.view.DoraTextViewWithAnim
                    android:textSize="?attr/larus_sp_16"
                    android:textColor="@color/oui_basic_text_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_onboarding_glasses_memory_food_notes_cn"
                    android:includeFontPadding="false"/>
                <com.larus.dora.impl.view.DoraTextViewWithAnim
                    android:textSize="?attr/larus_sp_12"
                    android:textColor="@color/oui_basic_text_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_2"
                    android:text="@string/onboarding_diary_food_notes_desc"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingLeft="?attr/larus_dp_12"
                android:paddingRight="?attr/larus_dp_12"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_60">
                <com.larus.dora.impl.view.DoraTextViewWithAnim
                    android:textSize="?attr/larus_sp_16"
                    android:textColor="@color/oui_basic_text_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_onboarding_glasses_memory_highlights_cn"
                    android:includeFontPadding="false"/>
                <com.larus.dora.impl.view.DoraTextViewWithAnim
                    android:textSize="?attr/larus_sp_12"
                    android:textColor="@color/oui_basic_text_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="?attr/larus_dp_2"
                    android:text="@string/onboarding_diary_highlights_desc"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_0"
            android:layout_weight="1"/>
        <com.obric.oui.button.OButton
            android:gravity="center"
            android:id="@+id/obric_env_observe_agree_button"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_52"
            android:layout_marginLeft="?attr/larus_dp_12"
            android:layout_marginTop="?attr/larus_dp_12"
            android:layout_marginRight="?attr/larus_dp_12"
            android:text="@string/larus_dora_onboarding_glasses_memory_open_button_cn"
            style="@style/OStyleV2.OButton.L.Standard.Primary"/>
        <com.larus.dora.impl.view.DoraTextViewWithAnim
            android:textSize="?attr/larus_sp_16"
            android:textColor="@color/oui_basic_text_3"
            android:gravity="center"
            android:id="@+id/obric_env_observe_later_button"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_44"
            android:layout_marginLeft="?attr/larus_dp_12"
            android:layout_marginTop="?attr/larus_dp_8"
            android:layout_marginRight="?attr/larus_dp_12"
            android:text="@string/larus_dora_onboarding_glasses_memory_later_button_cn"
            android:includeFontPadding="false"/>
    </LinearLayout>
</ScrollView>
