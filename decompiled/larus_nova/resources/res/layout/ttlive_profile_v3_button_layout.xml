<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="horizontal"
    android:id="@+id/new_profile_button_root"
    android:background="@drawable/ttlive_bg_profile_anchor_followed"
    android:layout_width="match_parent"
    android:layout_height="36dp">
    <ImageView
        android:gravity="center"
        android:id="@+id/new_profile_button_left"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_new_profile_black"
        android:gravity="center"
        android:id="@+id/new_profile_button_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"/>
    <ImageView
        android:gravity="center"
        android:id="@+id/new_profile_button_right"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"/>
</LinearLayout>
