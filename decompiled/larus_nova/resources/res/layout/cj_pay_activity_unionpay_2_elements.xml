<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cj_unionpay_2_elements_layout"
    android:background="#f5f5f5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/base_title_layout"
        layout="@layout/cj_pay_base_logger_titlebar_layout"/>
    <RelativeLayout
        android:id="@+id/view_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="44dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_container"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/cj_pay_padding_16"
                android:layout_marginTop="@dimen/cj_pay_padding_16"
                android:layout_marginRight="@dimen/cj_pay_padding_16"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true">
                <com.android.ttcjpaysdk.base.ui.widget.CJPayBoldTextView
                    android:textSize="22dp"
                    android:textStyle="bold"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:id="@+id/tv_title_front"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cj_pay_union_sync_card_title_front"
                    android:includeFontPadding="false"/>
                <ImageView
                    android:id="@+id/iv_title_icon"
                    android:layout_width="@dimen/cj_pay_padding_22"
                    android:layout_height="@dimen/cj_pay_padding_22"
                    android:layout_marginLeft="@dimen/cj_pay_padding_4"
                    android:layout_marginRight="@dimen/cj_pay_padding_4"/>
                <com.android.ttcjpaysdk.base.ui.widget.CJPayBoldTextView
                    android:textSize="22dp"
                    android:textStyle="bold"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:ellipsize="middle"
                    android:id="@+id/tv_title_back"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="云闪付银行卡"
                    android:maxLines="1"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/ll_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/cj_pay_padding_16"
                android:layout_marginTop="@dimen/cj_pay_padding_4"
                android:layout_marginRight="@dimen/cj_pay_padding_16"
                android:layout_below="@+id/ll_title">
                <ImageView
                    android:id="@+id/iv_safe_icon"
                    android:layout_width="@dimen/cj_pay_padding_16"
                    android:layout_height="@dimen/cj_pay_padding_16"
                    android:layout_marginRight="@dimen/cj_pay_padding_4"
                    android:src="@drawable/cj_pay_icon_safe_shield_blue"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
                    android:id="@+id/tv_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cj_pay_bank_card_million_insurance_title"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/cj_pay_new_select_card_type_bg"
                android:paddingLeft="@dimen/cj_pay_padding_16"
                android:paddingRight="@dimen/cj_pay_padding_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cj_pay_padding_24"
                android:layout_below="@+id/ll_subtitle"
                android:layout_centerHorizontal="true">
                <com.android.ttcjpaysdk.base.ui.widget.CJPayBoldTextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/cj_pay_color_black_161823"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cj_pay_padding_17"
                    android:text="@string/cj_pay_union_bind_card_tips"
                    android:includeFontPadding="false"/>
                <RelativeLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/ll_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cj_pay_padding_12">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/cj_pay_color_black_161823"
                        android:gravity="center_vertical"
                        android:id="@+id/name_tips"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/cj_pay_height_24"
                        android:layout_marginTop="@dimen/cj_pay_padding_18"
                        android:layout_marginBottom="@dimen/cj_pay_padding_18"
                        android:text="@string/cj_pay_add_new_bank_card_input_name_label"
                        android:includeFontPadding="false"
                        android:layout_alignParentLeft="true"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_name_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="88dp"
                        android:layout_marginTop="@dimen/cj_pay_padding_18"
                        android:layout_marginRight="@dimen/cj_pay_padding_2"
                        android:layout_marginBottom="@dimen/cj_pay_padding_18"
                        android:layout_toLeftOf="@+id/iv_ocr">
                        <com.android.ttcjpaysdk.bindcard.base.view.CJPayEditText
                            android:textSize="16sp"
                            android:textColor="#161823"
                            android:textColorHint="#57161823"
                            android:gravity="center_vertical"
                            android:id="@+id/name_edit_text"
                            android:background="@null"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/cj_pay_padding_24"
                            android:hint="@string/cj_pay_name_input_hint"
                            android:textCursorDrawable="@drawable/cj_pay_bg_universal_cursor"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/cj_pay_color_red_fe3824"
                            android:id="@+id/name_error_tips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/iv_ocr"
                        android:layout_width="@dimen/cj_pay_padding_24"
                        android:layout_height="@dimen/cj_pay_padding_24"
                        android:layout_marginTop="@dimen/cj_pay_padding_18"
                        android:layout_marginRight="@dimen/cj_pay_padding_2"
                        android:layout_marginBottom="@dimen/cj_pay_padding_18"
                        android:src="@drawable/cj_pay_icon_ocr"
                        android:layout_alignParentRight="true"/>
                </RelativeLayout>
                <View
                    android:background="@color/cj_pay_color_gray_161823_opacity_12"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cj_pay_height_half_1"/>
                <RelativeLayout
                    android:gravity="center_vertical"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/ll_id_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/cj_pay_color_black_161823"
                        android:gravity="center_vertical"
                        android:id="@+id/id_tips"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/cj_pay_padding_24"
                        android:layout_marginTop="@dimen/cj_pay_padding_18"
                        android:layout_marginBottom="@dimen/cj_pay_padding_18"
                        android:text="@string/cj_pay_two_elements_auth_id_num"
                        android:includeFontPadding="false"
                        android:layout_alignParentLeft="true"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_id_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="88dp"
                        android:layout_marginTop="@dimen/cj_pay_padding_18"
                        android:layout_marginRight="@dimen/cj_pay_padding_2"
                        android:layout_marginBottom="@dimen/cj_pay_padding_18">
                        <com.android.ttcjpaysdk.bindcard.base.view.CJPayEditText
                            android:textSize="16sp"
                            android:textColor="#161823"
                            android:textColorHint="#57161823"
                            android:gravity="center_vertical"
                            android:id="@+id/id_edit_text"
                            android:background="@null"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/cj_pay_padding_24"
                            android:hint="@string/cj_pay_id_card_input_hint"
                            android:singleLine="true"
                            android:textCursorDrawable="@drawable/cj_pay_bg_universal_cursor"
                            app:keyboard="pay"
                            app:keyboardShowDone="true"
                            app:keyboardShowX="true"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/cj_pay_color_red_fe3824"
                            android:id="@+id/id_error_tips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </RelativeLayout>
                <View
                    android:background="@color/cj_pay_color_gray_161823_opacity_12"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cj_pay_height_half_1"/>
                <com.android.ttcjpaysdk.bindcard.base.view.CJPayAgreementView
                    android:orientation="horizontal"
                    android:id="@+id/cj_pay_agreement_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cj_pay_padding_36"/>
                <com.android.ttcjpaysdk.base.ui.widget.LoadingButton
                    android:gravity="center"
                    android:id="@+id/verify_two_element_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cj_pay_custom_button_height_44"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="@dimen/cj_pay_padding_20"
                    app:btnText="@string/cj_pay_agree_and_continue"
                    app:btnTextColor="@color/cj_pay_color_white"
                    app:btnTextSize="15sp"
                    app:loadingHeight="20dp"
                    app:loadingWidth="20dp"/>
            </LinearLayout>
        </LinearLayout>
        <com.android.ttcjpaysdk.base.ui.widget.InsuranceTipsView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/cj_pay_padding_12"
            android:layout_alignParentBottom="true"
            app:theme_type="0"/>
    </RelativeLayout>
    <View
        android:id="@+id/view_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
