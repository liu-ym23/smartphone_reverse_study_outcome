<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="52dp">
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/anchor_info_container"
        android:background="@drawable/ttlive_bg_user_layout"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="10dp">
        <FrameLayout
            android:layout_gravity="center_vertical"
            android:id="@+id/avatar_container"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true">
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/digg_avatar_animation_container"
                android:layout_width="60dp"
                android:layout_height="60dp"/>
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/digg_thank_container"
                android:paddingLeft="36dp"
                android:paddingRight="8dp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:paddingStart="36dp"
                android:paddingEnd="8dp"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:layout_gravity="center"
                android:id="@+id/head"
                android:background="@drawable/ttlive_bg_circle_head"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="fitXY"/>
            <ImageView
                android:layout_gravity="end|bottom"
                android:id="@+id/user_verify_label"
                android:visibility="gone"
                android:layout_width="@dimen/ttlive_user_verify_label_size"
                android:layout_height="@dimen/ttlive_user_verify_label_size"
                android:layout_marginRight="-4dp"
                android:layout_marginBottom="-4dp"
                android:layout_marginEnd="-4dp"/>
            <TextView
                android:textSize="8dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/user_no_beauty_label"
                android:background="@drawable/ttlive_bg_user_no_beauty_label"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="12dp"
                android:layout_marginBottom="2dp"
                android:text="@string/ttlive_no_beauty_label"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/name_layout"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/ttlive_user_info_inside_spacing"
            android:layout_marginRight="@dimen/ttlive_user_info_inside_spacing"
            android:layout_toRightOf="@+id/avatar_container"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/ttlive_user_info_inside_spacing"
            android:layout_marginEnd="@dimen/ttlive_user_info_inside_spacing"
            android:layout_toEndOf="@+id/avatar_container">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/ttlive_white"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <TextView
                android:textSize="8dp"
                android:textColor="@color/ttlive_core_hs_w1_transparent_70"
                android:gravity="center"
                android:id="@+id/ticket_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="1dp"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:importantForAccessibility="no"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/ttlive_hs_w2"
                android:gravity="center"
                android:id="@+id/fans_number"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="1dp"
                android:singleLine="true"
                android:includeFontPadding="false"/>
            <FrameLayout
                android:layout_gravity="start|center_vertical"
                android:id="@+id/fl_room_cert"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/entrance_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_toRightOf="@+id/name_layout"
            android:layout_toEndOf="@+id/name_layout"/>
        <View
            android:id="@+id/action_layout_margin"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_toRightOf="@+id/action_layout"
            android:importantForAccessibility="no"
            android:layout_toEndOf="@+id/action_layout"/>
    </RelativeLayout>
    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginLeft="2dp"
        android:layout_marginStart="2dp">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center"
            android:id="@+id/iv_ceremony_border"
            android:layout_width="38dp"
            android:layout_height="38dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/digg_heart_animation_container"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="-7.35dp"
        android:layout_marginStart="12dp"/>
</RelativeLayout>
