<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@null"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/task_list_member_role_dialog_bg_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/close_icon"
                android:paddingLeft="@dimen/dp_16"
                android:paddingRight="@dimen/dp_16"
                android:layout_width="24sp"
                android:layout_height="24sp"
                android:tint="@color/icon_n1"
                app:srcCompat="@drawable/ud_icon_close_small_outlined"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/dp_56">
                <TextView
                    android:textSize="@dimen/sp_17"
                    android:textStyle="bold"
                    android:textColor="@color/text_title"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/option_dialog_title"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:maxLines="1"
                    android:singleLine="true"/>
            </LinearLayout>
        </LinearLayout>
        <com.ss.android.lark.todo.impl.features.detail.widget.MaxHeightRecyclerView
            android:id="@+id/rv_option"
            android:paddingBottom="@dimen/dp_16"
            android:visibility="visible"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.larksuite.component.universe_design.emptystate.UDEmptyState
            android:id="@+id/empty_view_option"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:layout_marginBottom="76dp"
            app:ud_empty_imageRes="@drawable/illustration_empty_neutral_no_content"
            app:ud_empty_title="@string/Todo_CustomField_NoOptions_Text"
            style="@style/UDEmptyState"/>
    </LinearLayout>
</LinearLayout>
