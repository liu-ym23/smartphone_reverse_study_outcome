<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/preview_original_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/> + 
    <FrameLayout
        android:layout_gravity="end|bottom"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20.5dp"
        android:layout_marginEnd="14dp">
        <ImageView
            android:layout_gravity="center"
            android:background="@drawable/ttlive_paid_ticket_qr_code_background"
            android:layout_width="68.5dp"
            android:layout_height="68.5dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/preview_qr_code_container"
            android:layout_width="64.5dp"
            android:layout_height="64.5dp"/>
    </FrameLayout>
</FrameLayout>
