<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.livesdk.chatroom.view.BlurImageView
        android:id="@+id/mIvPayPerformWatchEndBlurStream"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:failureImage="@color/black"
        app:ttlive_blur_radius="50dp"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/mIvPayPerformWatchEndBlurStream2"
        android:background="#b3000000"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:failureImage="@color/black"/>
    <FrameLayout
        android:id="@+id/mFlPaidLiveWatchEndTipContainer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/mLlPaidLiveWatchEndTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18dp"
                android:textColor="@color/white"
                android:id="@+id/mTvPayPerformWatchEndTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_live_paid_live_temp_watch_end"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/mTvPayPerformWatchEndDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/ttlive_live_paid_live_buy_ticket_tip"
                android:alpha="0.5"/>
            <TextView
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/mBtPaidLiveGoBuyTicket"
                android:background="@drawable/ttlive_bg_pay_perform_buy_ticket"
                android:layout_width="130dp"
                android:layout_height="32dp"
                android:layout_marginTop="16dp"
                android:text="@string/ttlive_live_paid_live_go_buy_ticket"/>
        </LinearLayout>
    </FrameLayout>
</merge>
