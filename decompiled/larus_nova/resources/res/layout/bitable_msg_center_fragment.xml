<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="14dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/back_icon"
            android:padding="2dp"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:tint="@color/icon_n1"
            app:srcCompat="@drawable/ud_icon_left_outlined"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text_title"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:text="@string/Bitable_FeedCenter_CurrentDocumentNotice_Title"
            android:maxLines="1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/more_icon"
            android:padding="2dp"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:tint="@color/icon_n1"
            app:srcCompat="@drawable/ud_icon_more_outlined"/>
    </FrameLayout>
    <com.bytedance.ee.bear.bitable.msgcenter.view.BitableMsgCenterContainer
        android:id="@+id/msg_center_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
