<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="2dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.ss.android.lark.flow.chat.message.block.audio.FlowAudioPlayBar
        android:id="@+id/audio_play_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="97dp"
        app:layout_constraintEnd_toEndOf="@+id/audio_text_end_barrier"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.ss.android.lark.widget.light.LKUILightTextView
        android:id="@+id/audio_text"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/audio_play_bar"
        app:layout_constraintWidth_default="wrap"/>
    <com.ss.android.lark.flow.chat.message.block.audio.FlowAudioLoadingDotsView
        android:id="@+id/audio_loading_dots"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/audio_play_bar"/>
    <View
        android:id="@+id/audio_min_width_guide"
        android:visibility="invisible"
        android:layout_width="97dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/audio_play_bar"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/audio_text_end_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="true"
        app:barrierDirection="end"
        app:constraint_referenced_ids="audio_text,audio_loading_dots,audio_min_width_guide"/>
</androidx.constraintlayout.widget.ConstraintLayout>
