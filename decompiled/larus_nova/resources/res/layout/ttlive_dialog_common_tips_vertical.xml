<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_ban_tips_notice_dialog"
    android:layout_width="280dp"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/live_dialog_image_block"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="40dp"/>
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/live_dialog_image"
        android:background="@color/ttlive_white"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="50dp"
        android:layout_marginRight="50dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"/>
    <View
        android:id="@+id/live_dialog_top_block"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="24dp"/>
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/ttlive_room_notice_dialog_main_textcolor"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/live_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:includeFontPadding="false"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <View
        android:id="@+id/live_dialog_title_message_block"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/ttlive_room_notice_dialog_minor_textcolor"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/live_dialog_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:textAlignment="center"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <View
        android:id="@+id/live_dialog_bottom_block"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="16dp"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/tips_enter_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/ttlive_room_notice_dialog_details_color"
            android:layout_gravity="center"
            android:id="@+id/tips_enter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="使用要求"/>
        <ImageView
            android:id="@+id/tips_enter_icon"
            android:layout_width="7dp"
            android:layout_height="11dp"
            android:layout_marginLeft="3dp"
            android:src="@drawable/ttlive_banned_tips_enter_icon_blue"
            android:layout_marginStart="3dp"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/live_dialog_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/live_dialog_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/live_dialog_divider_1"
            style="@style/ttlive_live_dialog_divider_horizontal"/>
        <Button
            android:textSize="15sp"
            android:textStyle="bold"
            android:id="@+id/live_dialog_btn_1"
            style="@style/ttlive_live_dialog_button_vertical"/>
        <View
            android:id="@+id/live_dialog_divider_2"
            style="@style/ttlive_live_dialog_divider_horizontal"/>
        <Button
            android:id="@+id/live_dialog_btn_2"
            style="@style/ttlive_live_dialog_button_vertical"/>
        <View
            android:id="@+id/live_dialog_divider_3"
            style="@style/ttlive_live_dialog_divider_horizontal"/>
        <Button
            android:id="@+id/live_dialog_btn_3"
            style="@style/ttlive_live_dialog_button_vertical"/>
    </LinearLayout>
</LinearLayout>
