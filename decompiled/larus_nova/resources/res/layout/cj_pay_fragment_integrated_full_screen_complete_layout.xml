<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/cj_pay_payment_complete_root_view"
    android:background="@color/cj_pay_color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/cj_pay_titlebar_root_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_44">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/cj_pay_back_view"
            android:layout_width="@dimen/cj_pay_height_24"
            android:layout_height="@dimen/cj_pay_height_24"
            android:layout_marginLeft="@dimen/cj_pay_padding_9"
            android:src="@drawable/cj_pay_icon_titlebar_left_arrow"
            android:scaleType="centerCrop"/>
        <TextView
            android:textSize="@dimen/cj_pay_font_size_17"
            android:textColor="@color/cj_pay_color_black_34"
            android:layout_gravity="center"
            android:id="@+id/cj_pay_middle_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:layout_gravity="center"
            android:id="@+id/cj_pay_status_button_shadow"
            android:visibility="visible"
            android:layout_width="@dimen/cj_pay_height_30"
            android:layout_height="@dimen/cj_pay_height_24"/>
        <TextView
            android:textSize="@dimen/cj_pay_font_size_15"
            android:textColor="@color/cj_pay_color_blue"
            android:layout_gravity="center"
            android:id="@+id/cj_pay_status_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/cj_pay_padding_15"/>
    </FrameLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/cj_pay_status_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/cj_pay_status_icon_layout"
                android:layout_width="@dimen/cj_pay_height_68"
                android:layout_height="@dimen/cj_pay_height_68"
                android:layout_marginTop="@dimen/cj_pay_padding_30">
                <ImageView
                    android:id="@+id/cj_pay_status_icon"
                    android:layout_width="@dimen/cj_pay_height_68"
                    android:layout_height="@dimen/cj_pay_height_68"
                    android:scaleType="centerCrop"/>
            </FrameLayout>
            <TextView
                android:textSize="@dimen/cj_pay_font_size_14"
                android:textColor="@color/cj_pay_color_black_34"
                android:layout_gravity="center_horizontal"
                android:id="@+id/cj_pay_status_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cj_pay_padding_16"
                android:includeFontPadding="false"/>
            <RelativeLayout
                android:id="@+id/cj_pay_total_value_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cj_pay_padding_10">
                <TextView
                    android:textSize="@dimen/cj_pay_font_size_42"
                    android:textColor="@color/cj_pay_color_black_34"
                    android:id="@+id/cj_pay_total_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/cj_pay_padding_5"
                    android:includeFontPadding="false"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:textSize="@dimen/cj_pay_font_size_22"
                    android:textColor="@color/cj_pay_color_black_34"
                    android:id="@+id/cj_pay_total_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/cj_pay_padding_5"
                    android:layout_marginBottom="@dimen/cj_pay_padding_11"
                    android:text="@string/cj_pay_currency_unit"
                    android:layout_toLeftOf="@+id/cj_pay_total_value"
                    android:layout_alignBottom="@+id/cj_pay_total_value"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/cj_pay_total_original_value_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/cj_pay_font_size_12"
                    android:textColor="@color/cj_pay_color_black_34"
                    android:id="@+id/cj_pay_total_original_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"/>
                <View
                    android:background="@color/cj_pay_color_black_34"
                    android:layout_width="10dp"
                    android:layout_height="@dimen/cj_pay_padding_1"
                    android:layout_marginLeft="@dimen/cj_pay_padding_1"
                    android:layout_marginTop="@dimen/cj_pay_padding_8"
                    android:layout_marginRight="@dimen/cj_pay_padding_1"
                    android:layout_alignLeft="@+id/cj_pay_total_original_value"
                    android:layout_alignTop="@+id/cj_pay_total_original_value"
                    android:layout_alignRight="@+id/cj_pay_total_original_value"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cj_pay_coupon_and_payment_content_layout"
                android:paddingTop="@dimen/cj_pay_padding_10"
                android:paddingBottom="@dimen/cj_pay_padding_10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cj_pay_padding_30"/>
            <FrameLayout
                android:id="@+id/cj_pay_recommend_focus_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cj_pay_height_80">
                <View
                    android:background="@color/cj_pay_color_gray_232"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cj_pay_height_half_1"
                    android:layout_marginLeft="@dimen/cj_pay_padding_15"
                    android:layout_marginRight="@dimen/cj_pay_padding_15"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/cj_pay_recommend_focus_icon"
                    android:layout_width="@dimen/cj_pay_height_48"
                    android:layout_height="@dimen/cj_pay_height_48"
                    android:layout_marginLeft="@dimen/cj_pay_padding_15"
                    android:scaleType="centerCrop"/>
                <TextView
                    android:textSize="@dimen/cj_pay_font_size_16"
                    android:textColor="@color/cj_pay_color_black_34"
                    android:id="@+id/cj_pay_recommend_focus_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/cj_pay_padding_78"
                    android:layout_marginTop="@dimen/cj_pay_padding_19"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="@dimen/cj_pay_font_size_12"
                    android:textColor="@color/cj_pay_color_gray_80"
                    android:id="@+id/cj_pay_recommend_focus_sub_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/cj_pay_padding_78"
                    android:layout_marginTop="@dimen/cj_pay_padding_41"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="@dimen/cj_pay_font_size_14"
                    android:textColor="@color/cj_pay_color_white"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/cj_pay_recommend_focus_btn"
                    android:background="@drawable/cj_pay_base_bg_red_btn"
                    android:layout_width="@dimen/cj_pay_height_72"
                    android:layout_height="@dimen/cj_pay_height_28"
                    android:layout_marginRight="@dimen/cj_pay_padding_15"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/cj_pay_bottom_banner_tip_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:background="@color/cj_pay_color_gray_232"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cj_pay_height_half_1"
                    android:layout_marginLeft="@dimen/cj_pay_padding_15"
                    android:layout_marginRight="@dimen/cj_pay_padding_15"/>
                <TextView
                    android:textSize="@dimen/cj_pay_font_size_12"
                    android:textColor="@color/cj_pay_color_gray_153"
                    android:ellipsize="middle"
                    android:gravity="left"
                    android:id="@+id/cj_pay_bottom_banner_tip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/cj_pay_padding_15"
                    android:layout_marginTop="@dimen/cj_pay_padding_12"
                    android:layout_marginRight="@dimen/cj_pay_padding_15"
                    android:layout_marginBottom="@dimen/cj_pay_padding_12"
                    android:singleLine="true"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <View
                android:background="@color/cj_pay_color_gray_248"
                android:layout_width="match_parent"
                android:layout_height="@dimen/cj_pay_padding_6"/>
            <View
                android:background="@color/cj_pay_color_gray_248"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        </LinearLayout>
        <include layout="@layout/cj_pay_view_integrated_half_screen_loading_layout"/>
    </FrameLayout>
</LinearLayout>
