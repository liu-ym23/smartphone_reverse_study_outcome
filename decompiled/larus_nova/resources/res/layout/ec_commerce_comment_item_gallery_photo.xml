<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ec_commerce_comment_item_gallery_photo_1761761880"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.ui.ec.widget.photodraweeview.transition.TransitionPhotoDraweeView
        android:id="@+id/photo_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="83dp"/>
    <com.bytedance.android.ec.core.widget.ECStatusView
        android:layout_gravity="center"
        android:id="@+id/ec_status_view"
        android:layout_width="36dp"
        android:layout_height="36dp"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/ec_new_place_holder_view"
        android:background="@drawable/commerce_bg_comment_gallery_content_new"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="371dp"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/ec_old_place_holder_view"
        android:background="@color/black"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="66dp"/>
</FrameLayout>
