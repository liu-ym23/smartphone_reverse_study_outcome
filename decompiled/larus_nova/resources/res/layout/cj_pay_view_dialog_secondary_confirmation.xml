<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cj_pay_payment_dialog_secondary_confirmation"
    android:visibility="gone"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/cj_pay_integrated_bg_dialog"
        android:layout_width="@dimen/cj_pay_height_319"
        android:layout_height="307dp"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/iv_secondary_confirm_close"
            android:padding="13dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/cj_pay_icon_titlebar_left_close"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/cj_pay_bottom_divider_line"
            android:background="@color/cj_pay_color_gray_232"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_height_half_1"/>
        <TextView
            android:textSize="20dp"
            android:textColor="@color/cj_pay_color_black_34"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/cj_pay_dialog_secondary_confirmation_title"
            android:includeFontPadding="false"
            style="@style/CJPayShadowTextStyle"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/cj_pay_color_gray_80"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/cj_pay_dialog_secondary_confirmation_desc"
            android:includeFontPadding="false"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp">
            <TextView
                android:textSize="17dp"
                android:textColor="@color/cj_pay_color_gray_153"
                android:gravity="center"
                android:id="@+id/tv_cancel"
                android:background="@drawable/cj_pay_integrated_bg_black_stroke_btn_radis_5"
                android:layout_width="120dp"
                android:layout_height="44dp"
                android:text="@string/cj_pay_common_dialog_cancel"/>
            <TextView
                android:textSize="17dp"
                android:textColor="@color/cj_pay_color_white"
                android:gravity="center"
                android:id="@+id/tv_continue"
                android:background="@drawable/cj_pay_integrated_bg_red_btn_radis_5"
                android:layout_width="120dp"
                android:layout_height="44dp"
                android:layout_marginLeft="12dp"
                android:text="@string/cj_pay_retry"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
