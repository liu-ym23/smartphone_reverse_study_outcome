<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ScrollView
        android:id="@+id/scroll_view"
        android:paddingTop="?attr/larus_dp_8"
        android:paddingBottom="?attr/larus_dp_8"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="?attr/larus_dp_12"
        android:paddingEnd="?attr/larus_dp_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/scroll_view_linear_layout"
            android:paddingBottom="?attr/larus_dp_56"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.larus.common_ui.widget.roundlayout.RoundFrameLayout
                android:id="@+id/feedback_spinner"
                android:paddingLeft="?attr/larus_dp_16"
                android:paddingTop="?attr/larus_dp_12"
                android:paddingRight="?attr/larus_dp_16"
                android:paddingBottom="?attr/larus_dp_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_12"
                app:rv_backgroundColor="@color/base_2_overlay"
                app:rv_cornerRadius="?attr/larus_dp_16">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <com.larus.dora.impl.view.DoraTextView
                            android:textSize="?attr/larus_dp_17"
                            android:textColor="@color/neutral_100"
                            android:id="@+id/tv_drop_down_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/larus_dora_g_feedback_type_cn"/>
                        <com.larus.dora.impl.view.DoraTextView
                            android:textSize="?attr/larus_dp_14"
                            android:textColor="@color/danger_50"
                            android:layout_gravity="start"
                            android:paddingLeft="?attr/larus_dp_4"
                            android:paddingTop="?attr/larus_dp_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="*"/>
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/iv_arrow"
                        android:layout_width="?attr/larus_dp_16"
                        android:layout_height="?attr/larus_dp_16"
                        android:src="@drawable/larus_ic_arrow_down"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"/>
                    <com.larus.dora.impl.view.DoraTextView
                        android:textSize="?attr/larus_dp_15"
                        android:textColor="@color/neutral_50"
                        android:ellipsize="end"
                        android:id="@+id/spinner_selected_feedback_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="?attr/larus_dp_8"
                        android:layout_marginRight="?attr/larus_dp_8"
                        android:text="@string/larus_dora_g_feedback_type_please_choose_cn"
                        android:maxLines="1"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@+id/iv_arrow"/>
                </RelativeLayout>
            </com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16">
                <com.larus.dora.impl.view.DoraTextView
                    android:textSize="?attr/larus_dp_17"
                    android:textColor="@color/neutral_100"
                    android:paddingLeft="?attr/larus_dp_16"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_g_feedback_description_cn"/>
                <com.larus.dora.impl.view.DoraTextView
                    android:textSize="?attr/larus_dp_14"
                    android:textColor="@color/danger_50"
                    android:layout_gravity="start"
                    android:paddingLeft="?attr/larus_dp_4"
                    android:paddingTop="?attr/larus_dp_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="*"/>
            </LinearLayout>
            <com.larus.common_ui.widget.roundlayout.RoundFrameLayout
                android:id="@+id/input_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_12"
                app:rv_backgroundColor="@color/base_2_overlay"
                app:rv_cornerRadius="?attr/larus_dp_12">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.larus.common_ui.widget.NestedScrollEditText
                        android:textSize="?attr/larus_dp_17"
                        android:textColor="@color/neutral_100"
                        android:textColorHint="@color/neutral_50"
                        android:gravity="start|top"
                        android:id="@+id/etFeedbackContent"
                        android:background="@null"
                        android:scrollbars="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="?attr/larus_dp_160"
                        android:layout_marginLeft="?attr/larus_dp_16"
                        android:layout_marginTop="?attr/larus_dp_12"
                        android:layout_marginRight="?attr/larus_dp_16"
                        android:layout_marginBottom="?attr/larus_dp_12"
                        android:hint="@string/larus_dora_g_feedback_input_placeholder_cn"
                        android:overScrollMode="always"
                        android:textCursorDrawable="@drawable/larus_cursor_shape"/>
                    <LinearLayout
                        android:layout_gravity="end|bottom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="?attr/larus_dp_10"
                        android:layout_marginEnd="?attr/larus_dp_16">
                        <com.larus.dora.impl.view.DoraTextView
                            android:textSize="?attr/larus_dp_12"
                            android:textColor="@color/neutral_50"
                            android:id="@+id/tv_char_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"/>
                        <com.larus.dora.impl.view.DoraTextView
                            android:textSize="?attr/larus_dp_12"
                            android:textColor="@color/neutral_50"
                            android:id="@+id/tv_max_char_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="/300"/>
                    </LinearLayout>
                </LinearLayout>
            </com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
            <com.larus.common_ui.widget.MaxWidthRecyclerView
                android:orientation="horizontal"
                android:id="@+id/rv_images"
                android:layout_width="wrap_content"
                android:layout_height="?attr/larus_dp_80"
                android:layout_marginTop="?attr/larus_dp_16"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/feedback_consent_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16">
                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/cb_feedback_consent"
                    android:background="@drawable/larus_dora_feedback_consent_selector"
                    android:padding="0dp"
                    android:layout_width="?attr/larus_dp_16"
                    android:layout_height="?attr/larus_dp_16"
                    android:button="@null"/>
                <com.larus.dora.impl.view.DoraTextView
                    android:textSize="?attr/larus_dp_12"
                    android:textColor="@color/neutral_50"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_feedback_consent"
                    android:layout_width="0dp"
                    android:layout_height="?attr/larus_dp_18"
                    android:layout_weight="1"
                    android:layout_marginStart="?attr/larus_dp_4"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/tv_conversation_link"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16">
                <com.larus.dora.impl.view.DoraTextView
                    android:textSize="?attr/larus_dp_17"
                    android:textColor="@color/neutral_100"
                    android:paddingLeft="?attr/larus_dp_16"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_dora_g_feedback_chat_link_cn"/>
                <com.larus.dora.impl.view.DoraTextView
                    android:textSize="?attr/larus_dp_14"
                    android:textColor="@color/danger_50"
                    android:layout_gravity="start"
                    android:paddingLeft="?attr/larus_dp_4"
                    android:paddingTop="?attr/larus_dp_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="*"/>
            </LinearLayout>
            <com.larus.common_ui.widget.roundlayout.RoundFrameLayout
                android:id="@+id/dora_conversation_link"
                android:paddingLeft="?attr/larus_dp_12"
                android:paddingTop="?attr/larus_dp_12"
                android:paddingRight="?attr/larus_dp_12"
                android:paddingBottom="?attr/larus_dp_12"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_12"
                app:rv_backgroundColor="@color/base_2_overlay"
                app:rv_cornerRadius="?attr/larus_dp_12">
                <com.larus.common_ui.widget.NestedScrollEditText
                    android:textSize="?attr/larus_dp_17"
                    android:textColor="@color/neutral_100"
                    android:textColorHint="@color/neutral_50"
                    android:gravity="start|center_vertical"
                    android:id="@+id/cb_upload_conversation"
                    android:background="@null"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/larus_dora_g_feedback_chat_link_placeholer_cn"
                    android:maxLines="1"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:maxLength="300"
                    android:overScrollMode="never"
                    android:textCursorDrawable="@drawable/larus_cursor_shape"/>
            </com.larus.common_ui.widget.roundlayout.RoundFrameLayout>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_dp_14"
                android:textColor="@color/primary_50"
                android:id="@+id/tv_how_conversation_link"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="?attr/larus_dp_16"
                android:layout_marginTop="?attr/larus_dp_8"
                android:text="@string/larus_dora_g_feedback_chat_link_guide_cn"/>
            <com.larus.dora.impl.view.DoraTextView
                android:textSize="?attr/larus_sp_17"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/btnSubmit"
                android:background="@drawable/larus_bg_item_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_16"
                android:minHeight="?attr/larus_dp_56"
                android:text="@string/larus_dora_g_feedback_submit_btn_cn"
                android:maxLines="2"
                android:backgroundTint="@color/primary_transparent_4"/>
            <View
                android:id="@+id/scroll_padding"
                android:background="@color/base_1"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_500"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
