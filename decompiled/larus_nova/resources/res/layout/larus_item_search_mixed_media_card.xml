<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.larus.common_ui.venus.ShapeConstraintLayout
        android:id="@+id/shadow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:larus_sc_cornerRadius="?attr/larus_dp_8"
        app:larus_sc_fillColor="#00000000"
        app:larus_sc_shadow_color="?attr/larus_base_4_overlay_50"/>
    <com.larus.common_ui.venus.ShapeConstraintLayout
        android:id="@+id/shape_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:larus_sc_cornerRadius="?attr/larus_dp_8"
        app:larus_sc_fillColor="?attr/larus_base_2"
        app:larus_sc_strokeColor="?attr/larus_base_2_overlay"
        app:larus_sc_strokeWidth="1px">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/cover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:actualImageScaleType="centerCrop"
            app:failureImage="?attr/larus_base_3_overlay"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:placeholderImage="@color/neutral_transparent_1"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_dp_14"
            android:textColor="?attr/larus_neutral_100"
            android:ellipsize="end"
            android:gravity="start|top"
            android:id="@+id/title"
            android:paddingLeft="?attr/larus_dp_8"
            android:paddingRight="?attr/larus_dp_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_8"
            android:maxLines="2"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cover"/>
        <ImageView
            android:id="@+id/player_icon"
            android:layout_width="?attr/larus_dp_19"
            android:layout_height="?attr/larus_dp_20"
            android:layout_marginTop="?attr/larus_dp_8"
            android:src="@drawable/larus_ic_aweme_player"
            android:layout_marginEnd="?attr/larus_dp_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <include
            android:id="@+id/author_info_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"
            layout="@layout/larus_card_aweme_author_info"/>
    </com.larus.common_ui.venus.ShapeConstraintLayout>
</merge>
