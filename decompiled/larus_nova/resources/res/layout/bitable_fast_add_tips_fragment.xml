<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_body"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="left"
        android:id="@+id/quitView"
        android:paddingLeft="14dp"
        android:paddingTop="3dp"
        android:paddingRight="14dp"
        android:paddingBottom="3dp"
        android:layout_width="52dp"
        android:layout_height="30dp"
        android:tint="@color/icon_n1"
        app:srcCompat="@drawable/ud_icon_left_outlined"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/fastAddFgCloseTipsView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ccm_platform_empty_positive_upgrading_1"/>
        <TextView
            android:textSize="14sp"
            android:id="@+id/fastAddFgCloseTipsTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/Bitable_QuickAdd_FunctionOnItsWay_Desc"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/fastAddNoAccessTipsView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:srcCompat="@drawable/ccm_empty_neutral_no_access"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_caption"
            android:id="@+id/fastAddNoAccessTipsTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/Bitable_QuickAdd_NoRecordAccess_Desc"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/primary_on_primary_fill"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/gotoTableView1"
            android:background="@drawable/bg_action_btn"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="176dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/Bitable_ShareSingleRecord_ViewTable_Button"
            android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/fastAddSubmitTimeoutTipsView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:srcCompat="@drawable/ccm_ccm_empty_positive_storage_limit"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_caption"
            android:id="@+id/fastAddSubmitTimeoutTipsTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/Bitable_QuickAdd_SubmitTrafficCongestion_Desc"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/primary_on_primary_fill"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/continueFastAddView2"
            android:background="@drawable/bg_action_btn"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="176dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/Bitable_QuickAdd_NewRecord_Option"
            android:maxLines="1"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/primary_content_default"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/gotoTableView2"
            android:background="@drawable/fast_add_continue_add_selector"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="176dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/Bitable_ShareSingleRecord_ViewTable_Button"
            android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/fastAddNoReadAccessTipsView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:srcCompat="@drawable/ccm_empty_positive_complete"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_caption"
            android:id="@+id/fastAddNoReadAccessTipsTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/Bitable_QuickAdd_SubmittedCannotAccess_Toast"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/primary_on_primary_fill"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/continueFastAddView3"
            android:background="@drawable/bg_action_btn"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="176dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/Bitable_QuickAdd_NewRecord_Option"
            android:maxLines="1"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/primary_content_default"
            android:gravity="center"
            android:id="@+id/gotoTableView3"
            android:background="@drawable/fast_add_continue_add_selector"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="176dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/Bitable_ShareSingleRecord_ViewTable_Button"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/fastAddRetryTipsView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:srcCompat="@drawable/ccm_empty_negative_load_failed"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_caption"
            android:id="@+id/fastAddRetryTipsTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/Bitable_ShareSingleRecord_FailedToLoadData_Desc"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/primary_on_primary_fill"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/retryView"
            android:background="@drawable/bg_action_btn"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="176dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/Bitable_Common_ButtonRetry"
            android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/tableNotExistTipsView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:srcCompat="@drawable/ccm_empty_neutral_no_content"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_caption"
            android:id="@+id/tableNotExistTipsTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/Bitable_QuickAdd_TableDeleted_Toast"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/noShareTokenAfterFastAddTipsView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:srcCompat="@drawable/ccm_empty_positive_complete"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_caption"
            android:id="@+id/noShareTokenAfterFastAddTipsTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/Bitable_QuickAdd_SubmittedNoRedirect_Desc"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/primary_on_primary_fill"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/continueFastAddView4"
            android:background="@drawable/bg_action_btn"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="176dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/Bitable_QuickAdd_NewRecord_Option"
            android:maxLines="1"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/primary_content_default"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/gotoTableView4"
            android:background="@drawable/fast_add_continue_add_selector"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="176dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/Bitable_ShareSingleRecord_ViewTable_Button"
            android:maxLines="1"/>
    </LinearLayout>
</FrameLayout>
