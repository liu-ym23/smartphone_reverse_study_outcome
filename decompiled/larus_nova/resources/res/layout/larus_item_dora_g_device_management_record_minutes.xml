<?xml version="1.0" encoding="utf-8"?>
<com.larus.common_ui.widget.roundlayout.RoundRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="?attr/larus_dp_16"
    android:layout_width="match_parent"
    android:layout_height="?attr/larus_dp_154"
    android:layout_marginTop="?attr/larus_dp_12"
    android:layout_marginStart="?attr/larus_dp_16"
    android:layout_marginEnd="?attr/larus_dp_4"
    app:rv_backgroundColor="@color/larus_base_2"
    app:rv_cornerRadius="?attr/larus_dp_16">
    <ImageView
        android:id="@+id/icon_recording"
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:src="@drawable/larus_dora_icon_recording"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="?attr/larus_dp_16"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/larus_dora_g_device_record_audio_cn"
        android:layout_marginStart="?attr/larus_dp_6"
        android:layout_toEndOf="@+id/icon_recording"/>
    <ImageView
        android:layout_width="?attr/larus_dp_20"
        android:layout_height="?attr/larus_dp_20"
        android:src="@drawable/larus_ic_arrow"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="?attr/larus_dp_12"
        android:textColor="@color/larus_neutral_50"
        android:id="@+id/tv_recording_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        android:text="@string/larus_dora_g_device_voice_wakeup_tip_cn"
        android:layout_below="@+id/icon_recording"/>
    <TextView
        android:textSize="?attr/larus_dp_13"
        android:textColor="@color/larus_neutral_70"
        android:id="@+id/tv_recording_time"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_16"
        android:text="00:00:00"
        android:layout_below="@+id/icon_recording"
        android:layout_centerHorizontal="true"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottie_recording"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_16"
        android:layout_marginTop="?attr/larus_dp_6"
        android:scaleType="centerCrop"
        android:layout_below="@+id/tv_recording_time"
        android:layout_centerHorizontal="true"
        app:lottie_loop="true"/>
    <com.larus.common_ui.widget.roundlayout.RoundTextView
        android:textSize="?attr/larus_dp_14"
        android:textStyle="bold"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/btn_start_record"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_36"
        android:text="@string/larus_dora_g_device_start_record_cn"
        android:layout_alignParentBottom="true"
        app:rv_backgroundColor="@color/larus_base_3_overlay"
        app:rv_cornerRadius="?attr/larus_dp_8"/>
</com.larus.common_ui.widget.roundlayout.RoundRelativeLayout>
