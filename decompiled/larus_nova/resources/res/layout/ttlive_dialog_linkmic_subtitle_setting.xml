<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ttlive_bg_subtitle_setting_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="15dp"
        android:textColor="#161823"
        android:id="@+id/subtitle_setting_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/ttlive_linkmic_subtitle_setting"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/subtitle_show_container"
        android:background="@drawable/ttlive_bg_subtitle_setting_container"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        app:layout_constraintEnd_toEndOf="@+id/setting_root_container"
        app:layout_constraintStart_toStartOf="@+id/setting_root_container"
        app:layout_constraintTop_toBottomOf="@+id/subtitle_setting_tv">
        <TextView
            android:textSize="14dp"
            android:textColor="#e6000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:text="@string/ttlive_linkmic_subtitle_show"
            android:layout_marginStart="15dp"
            app:layout_constraintBottom_toBottomOf="@+id/subtitle_show_container"
            app:layout_constraintStart_toStartOf="@+id/subtitle_show_container"
            app:layout_constraintTop_toTopOf="@+id/subtitle_show_container"/>
        <com.bytedance.android.livesdk.chatroom.ui.LiveSwitchButton
            android:id="@+id/subtitle_setting_switch"
            android:layout_width="43dp"
            android:layout_height="25dp"
            android:layout_marginRight="15dp"
            android:layout_marginEnd="15dp"
            app:layout_constraintBottom_toBottomOf="@+id/subtitle_show_container"
            app:layout_constraintEnd_toEndOf="@+id/subtitle_show_container"
            app:layout_constraintTop_toTopOf="@+id/subtitle_show_container"
            app:lsb_background="@color/ttlive_prelive_setting_switch_dark_fill"
            app:lsb_button_color="#ffffff"
            app:lsb_checked_color="@color/ttlive_preview_setting_switch_check_color"
            app:lsb_effect_duration="50"
            app:lsb_shadow_radius="0dp"
            app:lsb_show_indicator="false"
            app:lsb_uncheck_color="#f3f3f4"
            app:lsb_uncheckbutton_color="#d9ffffff"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/setting_root_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitle_show_container">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/subtitle_setting_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/subtitle_style_long_bg"
                android:layout_width="167dp"
                android:layout_height="91dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/subtitle_style_long_rb_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:layout_constraintBottom_toBottomOf="@+id/subtitle_style_long_bg"
                app:layout_constraintEnd_toEndOf="@+id/subtitle_style_long_bg"
                app:layout_constraintStart_toStartOf="@+id/subtitle_style_long_bg">
                <androidx.appcompat.widget.AppCompatRadioButton
                    android:theme="@style/ttlive_uncheck_radio_button"
                    android:textColor="#161823"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/subtitle_style_long_rb"
                    android:background="@drawable/ttlive_ic_auto_open_radio"
                    android:clickable="false"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:checked="true"
                    android:button="@null"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#161823"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="@string/ttlive_linkmic_subtitle_long_style"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/subtitle_style_short_bg"
                android:layout_width="167dp"
                android:layout_height="91dp"
                android:layout_marginLeft="8dp"
                android:layout_marginStart="8dp"
                app:layout_constraintStart_toEndOf="@+id/subtitle_style_long_bg"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/subtitle_style_short_rb_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:layout_constraintBottom_toBottomOf="@+id/subtitle_style_short_bg"
                app:layout_constraintEnd_toEndOf="@+id/subtitle_style_short_bg"
                app:layout_constraintStart_toStartOf="@+id/subtitle_style_short_bg">
                <androidx.appcompat.widget.AppCompatRadioButton
                    android:theme="@style/ttlive_uncheck_radio_button"
                    android:textColor="#161823"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/subtitle_style_short_rb"
                    android:background="@drawable/ttlive_ic_auto_open_radio"
                    android:clickable="false"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:checked="false"
                    android:button="@null"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#161823"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="@string/ttlive_linkmic_subtitle_short_style"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/subtitle_type_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/subtitle_type_room_bg"
                android:background="@drawable/ttlive_interact_shape_linkmic_subtitle_room_type"
                android:layout_width="167dp"
                android:layout_height="112dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/subtitle_type_room_icon"
                android:layout_width="143dp"
                android:layout_height="34dp"
                android:layout_marginTop="15dp"
                app:layout_constraintEnd_toEndOf="@+id/subtitle_type_room_bg"
                app:layout_constraintStart_toStartOf="@+id/subtitle_type_room_bg"
                app:layout_constraintTop_toTopOf="@+id/subtitle_type_room_bg"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/subtitle_type_room_rb_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:layout_constraintBottom_toBottomOf="@+id/subtitle_type_room_bg"
                app:layout_constraintEnd_toEndOf="@+id/subtitle_type_room_bg"
                app:layout_constraintStart_toStartOf="@+id/subtitle_type_room_bg">
                <androidx.appcompat.widget.AppCompatRadioButton
                    android:theme="@style/ttlive_uncheck_radio_button"
                    android:textColor="#161823"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/subtitle_type_room_rb"
                    android:background="@drawable/ttlive_ic_auto_open_radio"
                    android:clickable="false"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:checked="true"
                    android:button="@null"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#161823"
                    android:id="@+id/subtitle_type_room_rb_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="@string/ttlive_linkmic_subtitle_room_type"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/subtitle_type_enlarged_bg"
                android:background="@drawable/ttlive_interact_shape_linkmic_subtitle_enlarged_type"
                android:layout_width="167dp"
                android:layout_height="112dp"
                android:layout_marginLeft="8dp"
                android:layout_marginStart="8dp"
                app:layout_constraintStart_toEndOf="@+id/subtitle_type_room_bg"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/subtitle_type_enlarged_icon"
                android:layout_width="120dp"
                android:layout_height="34dp"
                android:layout_marginTop="15dp"
                app:layout_constraintEnd_toEndOf="@+id/subtitle_type_enlarged_bg"
                app:layout_constraintStart_toStartOf="@+id/subtitle_type_enlarged_bg"
                app:layout_constraintTop_toTopOf="@+id/subtitle_type_enlarged_bg"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/subtitle_type_enlarged_rb_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:layout_constraintBottom_toBottomOf="@+id/subtitle_type_enlarged_bg"
                app:layout_constraintEnd_toEndOf="@+id/subtitle_type_enlarged_bg"
                app:layout_constraintStart_toStartOf="@+id/subtitle_type_enlarged_bg">
                <androidx.appcompat.widget.AppCompatRadioButton
                    android:theme="@style/ttlive_uncheck_radio_button"
                    android:textColor="#161823"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/subtitle_type_enlarged_rb"
                    android:background="@drawable/ttlive_ic_auto_open_radio"
                    android:clickable="false"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:checked="false"
                    android:button="@null"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="#161823"
                    android:id="@+id/subtitle_type_enlarged_rb_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:text="@string/ttlive_linkmic_subtitle_enlarged_type"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/stub"
            android:visibility="gone"
            android:layout_width="334dp"
            android:layout_height="1dp"/>
    </LinearLayout>
    <View
        android:layout_width="0dp"
        android:layout_height="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/setting_root_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
