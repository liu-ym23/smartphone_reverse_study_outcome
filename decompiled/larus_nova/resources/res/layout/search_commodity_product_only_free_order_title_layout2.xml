<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_commodity_product_only_free_order_title_container2"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/countdown_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:textSize="12dp"
            android:textColor="@color/white"
            android:id="@+id/countdown_prefix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="距结束还剩"/>
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:id="@+id/hhcard"
            android:layout_width="17dp"
            android:layout_height="14dp"
            android:layout_marginLeft="4dp"
            app:cardCornerRadius="2dp"
            app:cardElevation="0dp">
            <com.bytedance.ies.dmt.ui.widget.DmtTextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/countdown_text_hh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-1dp"
                android:text="00"/>
        </androidx.cardview.widget.CardView>
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:textSize="11dp"
            android:textStyle="bold"
            android:textColor="#ccffffff"
            android:layout_gravity="center_vertical"
            android:id="@+id/countdown_text_split1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="-1.5dp"
            android:text="@string/search_commodity_coupon_hh_divider"/>
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:id="@+id/mmcard"
            android:layout_width="17dp"
            android:layout_height="14dp"
            android:layout_marginLeft="4dp"
            app:cardBackgroundColor="#ffc0cb"
            app:cardCornerRadius="2dp"
            app:cardElevation="0dp">
            <com.bytedance.ies.dmt.ui.widget.DmtTextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/countdown_text_mm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-1dp"
                android:text="00"/>
        </androidx.cardview.widget.CardView>
        <com.bytedance.ies.dmt.ui.widget.DmtTextView
            android:textSize="11dp"
            android:textStyle="bold"
            android:textColor="#ccffffff"
            android:layout_gravity="center_vertical"
            android:id="@+id/countdown_text_split2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="-1.5dp"
            android:text="@string/search_commodity_coupon_hh_divider"/>
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:id="@+id/sscard"
            android:layout_width="17dp"
            android:layout_height="14dp"
            android:layout_marginLeft="4dp"
            app:cardBackgroundColor="#ffc0cb"
            app:cardCornerRadius="2dp"
            app:cardElevation="0dp">
            <com.bytedance.ies.dmt.ui.widget.DmtTextView
                android:textSize="12dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/countdown_text_ss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-1dp"
                android:text="00"/>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <com.bytedance.ies.dmt.ui.widget.DmtTextView
        android:textSize="11dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/free_order_expires"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
