<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btn_back"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:layout_marginTop="?attr/larus_dp_8"
        android:layout_marginBottom="?attr/larus_dp_8"
        android:layout_marginStart="?attr/larus_dp_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/larus_ic_left_back"
        app:tint="?attr/larus_neutral_100"/>
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/fileIcon"
        android:layout_width="?attr/larus_dp_60"
        android:layout_height="?attr/larus_dp_60"
        android:layout_marginBottom="?attr/larus_dp_20"
        app:layout_constraintBottom_toTopOf="@+id/fileName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.35"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="?attr/larus_dp_17"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:gravity="center"
        android:id="@+id/fileName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/btnDownload"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fileIcon"/>
    <com.larus.common_ui.widget.roundlayout.RoundTextView
        android:textSize="?attr/larus_dp_14"
        android:textColor="@color/larus_static_white"
        android:gravity="center"
        android:id="@+id/btnDownload"
        android:layout_width="?attr/larus_dp_240"
        android:layout_height="?attr/larus_dp_40"
        android:layout_marginBottom="?attr/larus_dp_136"
        android:text="@string/larus_LarkCCM_DoubaoSheets_Download_Button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:rv_backgroundColor="?attr/larus_primary_50"
        app:rv_cornerRadius="?attr/larus_dp_8"/>
</androidx.constraintlayout.widget.ConstraintLayout>
