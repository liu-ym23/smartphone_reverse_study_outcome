<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/ivClose"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/ttlive_bg_white_radius_20"
        android:paddingBottom="44dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <ImageView
            android:id="@+id/close_btn"
            android:visibility="gone"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/ttlive_one_key_auth_dialog_close_icon"
            android:contentDescription="@string/ttlive_a11y_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/avatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:src="@drawable/ttlive_img_auth_avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bind_avatar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ttlive_float_icon"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toStartOf="@+id/bind_icon"/>
            <ImageView
                android:id="@+id/bind_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ttlive_auth_bind_avatar_icon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/host_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ttlive_img_auth_avatar"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toEndOf="@+id/bind_icon"
                app:roundedCornerRadius="8dp"
                app:roundingBorderColor="#1f161823"
                app:roundingBorderWidth="0.5dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#161823"
            android:id="@+id/tvAuthTitle"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="108dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#57161823"
            android:gravity="center"
            android:id="@+id/tvAuthContent"
            android:focusable="true"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvAuthTitle"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/llProtoContainer"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginTop="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvAuthContent">
            <ImageView
                android:id="@+id/security_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ttlive_security_icon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="13sp"
                android:textColor="#80161823"
                android:id="@+id/auth_tip"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_new_auth_dialog_security_tip"
                android:layout_marginStart="4dp"
                app:layout_constraintStart_toEndOf="@+id/security_icon"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <Button
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/uicomponent_live_button_primary_text_color"
            android:id="@+id/btnConfirm"
            android:background="@drawable/uicomponent_bg_button_primary_8"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/llProtoContainer"
            app:layout_goneMarginTop="36dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_std_brand"
            android:id="@+id/btnDouyinAuth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/ttlive_new_auth_login_by_dy_v2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnConfirm"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
