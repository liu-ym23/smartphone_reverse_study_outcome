<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ViewStub
        android:id="@+id/lucky_cp_left_viewstub"
        android:layout="@layout/lucky_common_pendant_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:id="@+id/lucky_common_pendant_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/lucky_common_pendant_icon"
            android:layout_width="70dp"
            android:layout_height="48dp"
            android:layout_marginBottom="-13dp"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/lucky_common_pendant_close_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/luckydog_common_pendant_close_icon"
            android:layout_marginStart="57dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/lucky_common_pendant_content_layout"
            android:background="@drawable/lucky_common_pendant_bg"
            android:layout_width="73dp"
            android:layout_height="37dp"
            android:layout_below="@+id/lucky_common_pendant_icon"
            android:layout_centerHorizontal="true">
            <TextView
                android:textSize="12dp"
                android:textColor="@color/luckydog_white"
                android:gravity="center"
                android:id="@+id/lucky_common_pendant_content"
                android:layout_width="65dp"
                android:layout_height="wrap_content"/>
            <ProgressBar
                android:id="@+id/lucky_common_pendant_progressbar"
                android:layout_width="60dp"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progressDrawable="@drawable/lucky_common_pendant_progressbar_bg"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
        </LinearLayout>
    </RelativeLayout>
    <ViewStub
        android:id="@+id/lucky_cp_right_viewstub"
        android:layout="@layout/lucky_common_pendant_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
