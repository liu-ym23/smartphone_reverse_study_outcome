<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/larus_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="?attr/larus_dp_44"
        android:layout_height="?attr/larus_dp_44"
        android:src="@drawable/larus_ic_left_back"
        android:layout_marginStart="?attr/larus_dp_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/apply_container"
        android:paddingLeft="?attr/larus_dp_19"
        android:paddingRight="?attr/larus_dp_19"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_back"
        app:layout_constraintVertical_bias="0.33">
        <ImageView
            android:id="@+id/iv_no_permission"
            android:layout_width="?attr/larus_dp_40"
            android:layout_height="?attr/larus_dp_40"
            android:layout_margin="?attr/larus_dp_18"
            android:src="@drawable/larus_office_no_permission_lock"/>
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textStyle="bold"
            android:textColor="@color/neutral_100"
            android:id="@+id/tv_no_permission_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_24"
            android:text="@string/larus_mobile_docPermission_noAccess"/>
        <TextView
            android:textSize="?attr/larus_sp_17"
            android:textColor="@color/neutral_100"
            android:gravity="start"
            android:id="@+id/tv_no_permission_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_16"
            android:text="@string/larus_mobile_docPermission_currentAccount_applyTo"/>
        <LinearLayout
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_permission_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_12">
            <TextView
                android:textSize="?attr/larus_sp_17"
                android:textColor="@color/neutral_100"
                android:id="@+id/tv_permission_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_mobile_docPermission_applyAction"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_permission_selector"
                android:paddingTop="?attr/larus_dp_4"
                android:paddingBottom="?attr/larus_dp_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="?attr/larus_sp_17"
                    android:textColor="@color/larus_primary_60"
                    android:id="@+id/tv_permission_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_mobile_docPermission_readPerm"
                    android:layout_marginStart="?attr/larus_dp_8"/>
                <ImageView
                    android:id="@+id/iv_arrow"
                    android:layout_width="?attr/larus_dp_10"
                    android:layout_height="?attr/larus_dp_10"
                    android:src="@drawable/larus_ic_arrow_down"
                    android:contentDescription="@null"
                    android:layout_marginStart="?attr/larus_dp_4"
                    app:tint="@color/larus_primary_60"/>
            </LinearLayout>
        </LinearLayout>
        <EditText
            android:textSize="?attr/larus_sp_16"
            android:textColor="@color/neutral_100"
            android:textColorHint="@color/neutral_50"
            android:gravity="start|top"
            android:id="@+id/et_remark"
            android:background="@drawable/larus_bg_input_selector"
            android:paddingLeft="?attr/larus_dp_16"
            android:paddingTop="?attr/larus_dp_12"
            android:paddingRight="?attr/larus_dp_16"
            android:paddingBottom="?attr/larus_dp_12"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/larus_dp_48"
            android:hint="@string/larus_mobile_docPermission_addRemark_optional"
            android:maxLines="3"
            android:overScrollMode="ifContentScrolls"
            android:textIsSelectable="true"
            style="@style/larus_EditTextStyle"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/btn_request_permission"
            android:background="@drawable/larus_bg_button_register_flow"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="?attr/larus_dp_48"
            android:layout_marginTop="?attr/larus_dp_24"
            android:layout_marginBottom="?attr/larus_dp_32">
            <ProgressBar
                android:id="@+id/pb_loading"
                android:visibility="gone"
                android:layout_width="?attr/larus_dp_20"
                android:layout_height="?attr/larus_dp_20"
                android:indeterminateTint="@android:color/white"/>
            <TextView
                android:textSize="?attr/larus_sp_16"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:id="@+id/tv_btn_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_mobile_docPermission_applyBtn"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
