<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/flow_ud_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/external_contact_content_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.ss.android.lark.widget.ptr.LKUIPtrClassicFrameLayout
            android:id="@+id/external_contact_ptr_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:lkui_ptr_duration_to_close_either="500"
            app:lkui_ptr_keep_header_when_refresh="true"
            app:lkui_ptr_mode="loadMore"
            app:lkui_ptr_pull_to_fresh="false"
            app:lkui_ptr_ratio_of_header_height_to_refresh="0.5"
            app:lkui_ptr_resistance="1.7">
            <com.ss.android.lark.widget.recyclerview.CommonRecyclerView
                android:id="@+id/external_contact_rv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.ss.android.lark.widget.ptr.LKUIPtrClassicFrameLayout>
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/external_contact_state_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.ss.android.lark.contact.customized.common.view.ContactOfficeEmptyStateView
                android:id="@+id/external_contact_state_view"
                android:background="@color/flow_ud_bg_base_1"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/external_contact_loading_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/index_bar_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_alignParentEnd="true">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/static_white"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/index_bar_tip"
            android:background="@drawable/contact_index_bar_tip"
            android:paddingBottom="1dp"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:translationY="20dp"
            android:layout_marginEnd="28dp"/>
        <ImageView
            android:layout_gravity="end|top"
            android:id="@+id/index_bar_search"
            android:visibility="invisible"
            android:layout_width="12dp"
            android:layout_height="12dp"
            app:srcCompat="@drawable/contact_db_icon_search"
            app:tint="@color/flow_ud_neutral_50"/>
        <com.ss.android.lark.contact.base.common_ui.IndexBar
            android:layout_gravity="end|center_vertical"
            android:id="@+id/index_bar"
            android:layout_width="14dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="20dp"
            android:layout_marginEnd="12dp"
            app:bold="true"
            app:focusLetterColor="@color/flow_ud_neutral_100"
            app:letterColor="@color/flow_ud_neutral_50"
            app:letterSize="10sp"
            app:letterSpacingExtra="1.1"/>
    </FrameLayout>
</RelativeLayout>
