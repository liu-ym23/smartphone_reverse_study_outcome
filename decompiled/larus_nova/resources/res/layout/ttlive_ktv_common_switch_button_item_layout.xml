<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="13dp"
        android:textColor="#000000"
        android:id="@+id/btn_list_item_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="5dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/btn_list_item_divider"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/btn_list_item_switch_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_list_item_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_list_item_title">
        <Switch
            android:id="@+id/btn_list_item_switch"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="25dp"
            android:textOn=""
            android:textOff=""
            android:thumb="@drawable/ttlive_shape_interact_dialog_switch_thumb"
            android:track="@drawable/ttlive_selector_interact_dialog_switch_track"/>
    </FrameLayout>
    <View
        android:id="@+id/btn_list_item_divider"
        android:background="#33000000"
        android:visibility="gone"
        android:layout_width="0.5dp"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_list_item_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_list_item_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
