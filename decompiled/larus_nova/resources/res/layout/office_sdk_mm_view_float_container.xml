<?xml version="1.0" encoding="utf-8"?>
<com.larksuite.component.universe_design.shadow.UDShadowLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/float_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:ud_shadow_color="@color/ud_shadow_s5"
    style="@style/UDShadow.S4.Down">
    <FrameLayout
        android:id="@+id/mm_float_root_view"
        android:layout_width="78dp"
        android:layout_height="96dp">
        <FrameLayout
            android:id="@+id/mm_float_content_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/mm_side_hide_view_container"
            android:background="@drawable/office_sdk_mm_bg_float_side_hide"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:layout_gravity="start"
                android:id="@+id/mm_side_hide_left_arrow_view"
                android:visibility="invisible"
                android:layout_width="24dp"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:id="@+id/mm_side_hide_left_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ud_icon_vc_toolbar_left_filled"
                    app:tint="@color/ud_N900_50"/>
            </FrameLayout>
            <FrameLayout
                android:layout_gravity="end"
                android:id="@+id/mm_side_hide_right_arrow_view"
                android:visibility="invisible"
                android:layout_width="24dp"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:id="@+id/mm_side_hide_right_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ud_icon_vc_toolbar_right_filled"
                    app:tint="@color/ud_N900_50"/>
            </FrameLayout>
        </FrameLayout>
    </FrameLayout>
</com.larksuite.component.universe_design.shadow.UDShadowLayout>
