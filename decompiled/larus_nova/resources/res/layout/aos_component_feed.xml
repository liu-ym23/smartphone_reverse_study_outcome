<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <com.bytedance.awemeopen.apps.framework.base.view.refresh.FeedSwipeRefreshLayout
        android:id="@+id/feed_content_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true">
        <com.bytedance.awemeopen.apps.framework.base.view.refresh.LoadMoreFrameLayout
            android:id="@+id/feed_content_load_more"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedance.awemeopen.apps.framework.base.view.verticalviewPager.VerticalViewPager
                android:orientation="vertical"
                android:id="@+id/feed_content_viewpager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.bytedance.awemeopen.apps.framework.base.view.refresh.LoadMoreFrameLayout>
    </com.bytedance.awemeopen.apps.framework.base.view.refresh.FeedSwipeRefreshLayout>
</merge>
