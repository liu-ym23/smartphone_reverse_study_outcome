<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:layout_marginLeft="12dp"
    android:layout_marginRight="12dp">
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/coupon_view_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/coupon_price_layout"
        android:layout_width="76dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="28dp"
            android:textStyle="bold"
            android:textColor="@color/ec_pay_color_red_fe2c55"
            android:gravity="center"
            android:id="@+id/coupon_view_price"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="11dp"
            android:textStyle="bold"
            android:textColor="#fffe496a"
            android:id="@+id/coupon_view_price_suffix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ec_coupon_yuan"
            android:lineSpacingExtra="2sp"
            android:translationY="-0.8sp"
            android:layout_marginStart="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/coupon_view_price"/>
    </LinearLayout>
    <TextView
        android:textSize="11dp"
        android:textColor="#fffe496a"
        android:gravity="center"
        android:layout_width="76dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="7dp"
        android:text="@string/ec_coupon_no_restriction"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/coupon_price_layout"/>
    <TextView
        android:textSize="13dp"
        android:textStyle="bold"
        android:textColor="@color/ec_pay_color_red_fe2c55"
        android:id="@+id/coupon_view_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="110dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/ec_inflow_coupon_view_sub_desc_8A8B91"
        android:id="@+id/coupon_view_sub_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginStart="110dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/coupon_view_desc"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/coupon_view_button"
        android:background="@color/ec_pay_color_red_fe2c55"
        android:layout_width="60dp"
        android:layout_height="24dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
