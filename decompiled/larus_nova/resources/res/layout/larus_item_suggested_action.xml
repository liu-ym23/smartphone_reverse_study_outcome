<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="?attr/larus_bg_suggested_action"
    android:paddingTop="9dp"
    android:paddingBottom="9dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="10dp">
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?attr/larus_neutral_100"
        android:id="@+id/suggested_action_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/suggested_action_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="2dp"
        app:srcCompat="?attr/larus_ic_suggested_action_arrow"/>
</LinearLayout>
