<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/larus_bg_action_bar_instruction_image_widget_item"
    android:layout_width="?attr/larus_dp_72"
    android:layout_height="?attr/larus_dp_96">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/image_template_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:actualImageScaleType="centerCrop"
        app:placeholderImage="?attr/larus_neutral_transparent_1"
        app:roundedCornerRadius="?attr/larus_dp_8"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:background="@drawable/larus_uaigc_actionbar_img_mask_bg"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_53">
        <TextView
            android:textSize="?attr/larus_dp_12"
            android:textColor="@color/larus_static_white"
            android:ellipsize="end"
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/tv_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_10"
            android:maxWidth="?attr/larus_dp_72"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="end|top"
        android:id="@+id/icon_img_selected_check"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/larus_dp_2"
        android:layout_marginEnd="?attr/larus_dp_2"
        app:srcCompat="?attr/larus_icon_img_component_check"/>
</FrameLayout>
