<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container_view"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minWidth="20dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_container_view"
        android:clipChildren="false"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:minWidth="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/flash_shadow_mask"
            android:background="@drawable/ttlive_link_guest_send_gift_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/interact_static_bg"
            android:background="@drawable/ttlive_quick_interact_fg"
            android:layout_width="0dp"
            android:layout_height="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/interact_animation_bg"
            android:background="@drawable/ttlive_link_guest_send_gift_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0"
            app:layout_constraintBottom_toBottomOf="@+id/interact_static_bg"
            app:layout_constraintEnd_toEndOf="@+id/interact_static_bg"
            app:layout_constraintStart_toStartOf="@+id/interact_static_bg"
            app:layout_constraintTop_toTopOf="@+id/interact_static_bg"/>
        <com.bytedance.android.live.liveinteract.videotalk.quickinteract.interactView.ProgressImageView
            android:id="@+id/star_wish_progress"
            android:visibility="gone"
            android:layout_width="50dp"
            android:layout_height="14dp"
            app:layout_constraintBottom_toBottomOf="@+id/interact_static_bg"
            app:layout_constraintEnd_toEndOf="@+id/interact_static_bg"
            app:layout_constraintStart_toStartOf="@+id/interact_static_bg"
            app:layout_constraintTop_toTopOf="@+id/interact_static_bg"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/interact_icon_container"
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="2dp"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/interact_static_bg"
            app:layout_constraintEnd_toStartOf="@+id/interact_switcher_container"
            app:layout_constraintStart_toStartOf="@+id/interact_static_bg"
            app:layout_constraintTop_toTopOf="@+id/interact_static_bg">
            <FrameLayout
                android:id="@+id/interact_icon_parent"
                android:clipChildren="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginStart="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/interact_icon_container"
                app:layout_constraintStart_toStartOf="@+id/interact_icon_container"
                app:layout_constraintTop_toTopOf="@+id/interact_icon_container">
                <com.bytedance.android.live.core.widget.HSImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/interact_icon"
                    android:visibility="visible"
                    android:layout_width="@dimen/ttlive_interact_icon_size"
                    android:layout_height="@dimen/ttlive_interact_icon_size"
                    android:scaleType="fitCenter"
                    app:actualImageScaleType="fitCenter"
                    app:placeholderImageScaleType="fitCenter"/>
            </FrameLayout>
            <com.bytedance.android.live.core.widget.HSImageView
                android:id="@+id/interact_avatar"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/interact_icon_container"
                app:layout_constraintStart_toStartOf="@+id/interact_icon_container"
                app:layout_constraintTop_toTopOf="@+id/interact_icon_container"
                app:roundAsCircle="true"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:id="@+id/interact_switcher_container"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginRight="4dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/interact_static_bg"
            app:layout_constraintEnd_toEndOf="@+id/interact_static_bg"
            app:layout_constraintStart_toEndOf="@+id/interact_icon_container"
            app:layout_constraintTop_toTopOf="@+id/interact_static_bg">
            <ViewSwitcher
                android:id="@+id/interact_switcher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextSwitcher
                    android:layout_gravity="center_vertical"
                    android:id="@+id/score_switcher"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp">
                    <TextView
                        android:textSize="9sp"
                        android:textColor="#ffffff"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/thanks_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"/>
                    <TextView
                        android:textSize="9sp"
                        android:textColor="#ffffff"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/score_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"/>
                </TextSwitcher>
                <TextView
                    android:textSize="9dp"
                    android:textColor="#ffffff"
                    android:id="@+id/interact_content"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:alpha="0.9"/>
            </ViewSwitcher>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/extra_container_view"
        android:visibility="gone"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/main_container_view"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
