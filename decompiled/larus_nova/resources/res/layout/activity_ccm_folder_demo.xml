<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ccm_folder_demo_root"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ccm_folder_demo_btn_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/ccm_folder_demo_btn_recent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="拉取最近"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_loadmore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="最近-加载更多"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_children"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="拉取子列表"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_delete_one"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="删除单个"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_delete_multi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="删除多选"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_move"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="移动操作"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_rename_folder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="触发文件夹重命名"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_rename_file"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="触发文件重命名"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_query_perm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="查询文档权限"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_query_folder_perm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="查询文件夹权限"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_request_password_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_fetch_doc_permission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_update_folder_link_share"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="修改文件夹权限"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_update_doc_link_share"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="修改文档权限"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_create_folder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="创建文件夹"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_create_object"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="创建文档(Object)"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_download_cover"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="拉取缩略图"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_load_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="加载文档icon"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_show_local_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="显示本地图片"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_show_asset_office"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Office容器显示Asset图片"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_show_asset_gif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Office容器显示Asset GIF"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_show_asset_heif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Office容器显示Asset HEIF"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_show_asset_png"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Office容器显示Asset PNG"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_show_asset_big_jpg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Office容器显示Asset 大图JPG"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_file_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="请求file/info"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_preview_get"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="请求preview/get"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_transcode_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="请求转码信息(file/info → preview/get)"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_cancel_transcode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="取消转码请求"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_image_preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="图片file/info请求"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_delete_wiki"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="删除Wiki(轮询)"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_download_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="获取DownloadAll URL"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_drive_file_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DriveFileInfoLoader"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_drive_image_preview_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DriveImagePreviewUrl"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_delete_recent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="移除最近访问"
                android:layout_marginStart="12dp"/>
            <Button
                android:id="@+id/ccm_folder_demo_btn_delete_mixed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="混合批量删除"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
    </HorizontalScrollView>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="16dp"
        android:fillViewport="true">
        <TextView
            android:textSize="14sp"
            android:textColor="#222222"
            android:id="@+id/ccm_folder_demo_log"
            android:background="#eeeeee"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="always"/>
    </ScrollView>
    <ImageView
        android:id="@+id/ccm_folder_demo_cover"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="16dp"
        android:scaleType="centerCrop"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ccm_folder_demo_icon_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <ImageView
            android:id="@+id/ccm_folder_demo_icon_1"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerInside"
            android:layout_marginEnd="12dp"/>
        <ImageView
            android:id="@+id/ccm_folder_demo_icon_2"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerInside"
            android:layout_marginEnd="12dp"/>
        <ImageView
            android:id="@+id/ccm_folder_demo_icon_3"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerInside"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/ccm_folder_demo_photo_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"/>
</LinearLayout>
