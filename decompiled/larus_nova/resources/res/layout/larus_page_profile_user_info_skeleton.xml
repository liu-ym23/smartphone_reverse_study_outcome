<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/larus_base_1"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/profile_info_skeleton_avatar"
        android:background="@drawable/larus_bg_black_6_round"
        android:layout_width="?attr/larus_dp_160"
        android:layout_height="?attr/larus_dp_160"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/profile_info_skeleton_nickname"
        android:background="@drawable/larus_bg_black_6_rounded_rectangle"
        android:layout_width="?attr/larus_dp_160"
        android:layout_height="?attr/larus_dp_20"
        android:layout_marginTop="?attr/larus_dp_16"
        app:layout_constraintEnd_toEndOf="@+id/profile_info_skeleton_avatar"
        app:layout_constraintStart_toStartOf="@+id/profile_info_skeleton_avatar"
        app:layout_constraintTop_toBottomOf="@+id/profile_info_skeleton_avatar"/>
    <View
        android:id="@+id/profile_info_skeleton_username"
        android:background="@drawable/larus_bg_black_6_rounded_rectangle"
        android:layout_width="?attr/larus_dp_160"
        android:layout_height="?attr/larus_dp_20"
        android:layout_marginTop="?attr/larus_dp_8"
        app:layout_constraintEnd_toEndOf="@+id/profile_info_skeleton_avatar"
        app:layout_constraintStart_toStartOf="@+id/profile_info_skeleton_avatar"
        app:layout_constraintTop_toBottomOf="@+id/profile_info_skeleton_nickname"/>
    <View
        android:id="@+id/profile_info_skeleton_bots_info"
        android:background="@drawable/larus_bg_black_6_rounded_rectangle"
        android:layout_width="?attr/larus_dp_100"
        android:layout_height="?attr/larus_dp_20"
        android:layout_marginTop="?attr/larus_dp_8"
        app:layout_constraintEnd_toEndOf="@+id/profile_info_skeleton_avatar"
        app:layout_constraintStart_toStartOf="@+id/profile_info_skeleton_avatar"
        app:layout_constraintTop_toBottomOf="@+id/profile_info_skeleton_username"/>
</androidx.constraintlayout.widget.ConstraintLayout>
