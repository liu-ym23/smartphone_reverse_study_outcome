<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.ec.window.base.widget.ECWindowRoundedLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/shopping_std_bg_primary_white"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:rounded_radius="6dp">
    <com.bytedance.android.ec.window.base.widget.ECWindowRoundedLinearLayout
        android:orientation="horizontal"
        android:id="@+id/store_product_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.android.ec.core.widget.RoundedRelativeLayout
            android:id="@+id/store_product_card_image_above"
            android:layout_width="146dp"
            android:layout_height="146dp">
            <com.bytedance.android.ec.core.widget.AspectRatioFrameLayout
                android:id="@+id/store_product_card_image_wrapper"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/store_product_card_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:placeholderImage="@color/ec_shop_product_placeholder_color"
                    app:roundedCornerRadius="@dimen/ec_window_card_radius"/>
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/window_product_card_image_mask"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:placeholderImage="@color/shopping_std_bg_black_1"
                    app:roundedCornerRadius="@dimen/ec_window_card_radius"/>
                <FrameLayout
                    android:id="@+id/ec_shop_tag_wrapper"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.bytedance.android.ec.core.widget.AspectRatioFrameLayout>
        </com.bytedance.android.ec.core.widget.RoundedRelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="8dp"
            android:paddingEnd="0dp">
            <com.bytedance.android.ec.window.base.widget.WindowBreakWordTextView
                android:textSize="14dp"
                android:textColor="@color/shopping_std_text_black_1"
                android:ellipsize="end"
                android:id="@+id/store_product_card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/ec_window_sub_text_color"
                android:ellipsize="end"
                android:layout_gravity="center"
                android:id="@+id/store_product_card_recommend_info"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:singleLine="true"/>
            <FrameLayout
                android:id="@+id/window_product_card_recommend_area"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="bottom"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toTopOf="@+id/ec_window_product_bottom_ext_area_barrier"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="1"
                    app:layout_constraintVertical_chainStyle="packed"
                    layout="@layout/ec_window_product_card_info_price"/>
                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/ec_window_product_bottom_ext_area_barrier"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:barrierDirection="top"
                    app:constraint_referenced_ids="ec_window_product_bottom_ext_area_wrapper,store_product_card_extra_info_area,store_product_card_source_wrapper"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"/>
                <include
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:layout_constraintBottom_toTopOf="@+id/store_product_card_source_wrapper"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/store_product_card_price_wrapper"
                    app:layout_constraintVertical_bias="1"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:layout_goneMarginTop="0dp"
                    layout="@layout/ec_window_product_card_info_taglist"/>
                <include
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/store_product_card_extra_info_area"
                    app:layout_constraintVertical_bias="1"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:layout_goneMarginTop="0dp"
                    layout="@layout/ec_window_product_card_source_info"/>
                <FrameLayout
                    android:id="@+id/ec_window_product_bottom_ext_area_wrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintVertical_bias="1"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:layout_goneMarginTop="0dp">
                    <com.bytedance.android.ec.window.base.view.ECWindowTagListView
                        android:gravity="center_vertical"
                        android:layout_gravity="bottom"
                        android:id="@+id/ec_window_product_bottom_ext_area"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"/>
                    <FrameLayout
                        android:id="@+id/ec_window_product_bottom_dynamic_content_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </com.bytedance.android.ec.window.base.widget.ECWindowRoundedLinearLayout>
    <FrameLayout
        android:id="@+id/ec_window_lynx_extension_group"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</com.bytedance.android.ec.window.base.widget.ECWindowRoundedLinearLayout>
