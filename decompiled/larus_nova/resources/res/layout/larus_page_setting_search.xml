<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/larus_page_setting_search_1080810426"
    android:background="@color/larus_base_1_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larus.bmhome.view.NovaTitleBarEx
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="?attr/larus_dp_60"/>
    <com.larus.common_ui.view.ChatSettingScrollView
        android:id="@+id/scroll_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/larus_dp_8"
        android:paddingStart="@dimen/larus_layout_common_padding"
        android:paddingEnd="@dimen/larus_layout_common_padding">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/prefer_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/prefer_show_card_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_search_on_answer_actions"/>
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/prefer_sug_all"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_search_on_all_input_sug"/>
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/prefer_sug_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_search_on_fullscreen_webview"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/search_engine_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_24">
                <com.larus.bmhome.view.item.ItemTextSelector
                    android:id="@+id/engine_toutiao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_use_oia_search"/>
                <com.larus.bmhome.view.item.ItemTextSelector
                    android:id="@+id/engine_douyin"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_setting_engine_douyin"/>
                <com.larus.bmhome.view.item.ItemTextSelector
                    android:id="@+id/engine_google"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_use_google_search"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/prefer_group1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_24">
                <com.larus.bmhome.view.item.ItemTextToggle
                    android:id="@+id/prefer_highlight_go_webview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_encyclopedia_entity_words"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <com.larus.bmhome.view.item.ItemGroup
                android:id="@+id/highlight_engine_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/larus_dp_24">
                <com.larus.bmhome.view.item.ItemTextSelector
                    android:id="@+id/highlight_engine_toutiao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_oia_entity_words"/>
                <com.larus.bmhome.view.item.ItemTextSelector
                    android:id="@+id/highlight_engine_google"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/larus_google_entity_words"/>
            </com.larus.bmhome.view.item.ItemGroup>
            <View
                android:layout_width="match_parent"
                android:layout_height="?attr/larus_dp_50"/>
        </LinearLayout>
    </com.larus.common_ui.view.ChatSettingScrollView>
</LinearLayout>
