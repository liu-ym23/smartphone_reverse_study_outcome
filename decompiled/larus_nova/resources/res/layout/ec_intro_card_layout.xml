<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.livesdk.livecommerce.intro.card.widget.bg.ECStrokedWaveDraweeView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layoutMode="height_self_adjust"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/parent_bottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_end="0dp"/>
    <com.bytedance.android.livesdk.livecommerce.intro.card.widget.IntroCardImageComponent
        android:id="@+id/iv_promotion"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/parent_bottom"
        app:layout_constraintEnd_toStartOf="@+id/tv_title"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.bytedance.android.livesdk.livecommerce.intro.card.widget.IntroCardTitleComponent
        android:textSize="14dp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginEnd="2dp"
        app:layout_constraintEnd_toStartOf="@+id/iv_close"
        app:layout_constraintStart_toEndOf="@+id/iv_promotion"
        app:layout_constraintTop_toTopOf="@+id/iv_promotion"
        app:layout_constraintVertical_bias="0"/>
    <com.bytedance.android.livesdk.livecommerce.intro.card.widget.IntroCardCarouselComponent
        android:id="@+id/area_carousel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/widget_button"
        app:layout_constraintEnd_toEndOf="@+id/iv_close"
        app:layout_constraintStart_toStartOf="@+id/tv_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <com.bytedance.android.livesdk.livecommerce.intro.card.widget.IntroCardPriceComponent
        android:gravity="bottom"
        android:layout_gravity="bottom"
        android:id="@+id/widget_price"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:importantForAccessibility="noHideDescendants"
        android:paddingEnd="6dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/iv_promotion"
        app:layout_constraintEnd_toStartOf="@+id/widget_button"
        app:layout_constraintStart_toStartOf="@+id/tv_title"
        app:layout_constraintVertical_bias="1"/>
    <com.bytedance.android.livesdk.livecommerce.intro.card.widget.IntroCardButtonComponent
        android:id="@+id/widget_button"
        android:layout_width="80dp"
        android:layout_height="30dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_promotion"
        app:layout_constraintEnd_toEndOf="@+id/iv_close"
        app:layout_constraintVertical_bias="1"/>
    <com.bytedance.android.ui.ec.widget.ecdraweeview.ECDraweeView
        android:id="@+id/iv_close"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="8dp"
        app:actualImageScaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_promotion"/>
    <com.bytedance.android.livesdk.livecommerce.intro.card.widget.IntroCardAtmosphereComponent
        android:id="@+id/widget_atmosphere"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
