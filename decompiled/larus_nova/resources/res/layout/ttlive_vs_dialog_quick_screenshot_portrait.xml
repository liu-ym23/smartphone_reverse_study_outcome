<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ttlive_vs_dialog_content"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:background="@drawable/ttlive_vs_portrait_quick_shot_mask_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1px"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/ttlive_vs_quick_screenshot_img"
            android:layout_width="90dp"
            android:layout_height="50dp"
            android:scaleType="fitXY"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/btn_share"
            android:background="@drawable/ttlive_quick_shot_portrait_share_btn"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginTop="6dp"
            style="@style/uicomponent_button_style_primary_l">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginRight="2dp"
                android:src="@drawable/ttlive_ic_quick_portrait_shot_share"
                android:scaleType="fitCenter"/>
            <TextView
                android:textSize="8dp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ttlive_long_press_share"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
