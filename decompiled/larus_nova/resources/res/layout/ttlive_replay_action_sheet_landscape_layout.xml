<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vs_action_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/vs_action_sheet_empty_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/vs_action_sheet_container"
        android:layout_width="250dp"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true">
        <View
            android:id="@+id/vs_action_sheet_padding_top"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:minHeight="60dp"
            android:layout_weight="1"/>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/vs_action_sheet_list"
            android:layout_width="250dp"
            android:layout_height="wrap_content"/>
        <View
            android:id="@+id/vs_action_sheet_padding_bottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:minHeight="60dp"
            android:layout_weight="1"/>
    </LinearLayout>
</RelativeLayout>
