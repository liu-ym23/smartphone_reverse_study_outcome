<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/dy_verify_dialog_bg"
    android:layout_width="@dimen/cj_pay_height_280"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/dialog_info_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/cj_pay_padding_20"
        android:layout_marginTop="@dimen/cj_pay_padding_24"
        android:layout_marginRight="@dimen/cj_pay_padding_20"
        android:layout_marginBottom="@dimen/cj_pay_padding_20">
        <FrameLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/dialog_icon"
            android:visibility="gone"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginBottom="16dp"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/cj_pay_color_black_161823"
            android:gravity="center"
            android:id="@+id/dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.android.ttcjpaysdk.verify.view.customView.CJMaxHeightScrollView
            android:id="@+id/dialog_content_scrollview"
            android:scrollbars="none"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cj_pay_padding_8"
            app:maxHeight="120dp">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/dialog_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="14"/>
        </com.android.ttcjpaysdk.verify.view.customView.CJMaxHeightScrollView>
    </LinearLayout>
    <View
        android:id="@+id/dialog_horizontal_divider"
        android:background="@color/cj_pay_color_gray_161823_opacity_12"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_half_1"
        android:layout_below="@+id/dialog_info_layout"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/dialog_btn_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_48"
        android:layout_below="@+id/dialog_horizontal_divider">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/cj_pay_color_gray_161823_opacity_75"
            android:gravity="center"
            android:id="@+id/left_btn_tv"
            android:layout_width="139dp"
            android:layout_height="@dimen/cj_pay_height_48"
            android:maxLines="1"/>
        <View
            android:id="@+id/dialog_vertical_divider"
            android:background="@color/cj_pay_color_gray_161823_opacity_12"
            android:layout_width="@dimen/cj_pay_height_half_1"
            android:layout_height="@dimen/cj_pay_height_48"/>
        <RelativeLayout
            android:gravity="center_horizontal"
            android:id="@+id/right_btn_layout"
            android:layout_width="139dp"
            android:layout_height="match_parent">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/cj_pay_color_black_161823"
                android:id="@+id/right_btn_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/cj_pay_color_gray_161823_opacity_34"
                android:id="@+id/count_down_tv"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:maxLines="1"
                android:layout_toRightOf="@+id/right_btn_tv"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/cj_pay_color_black_161823"
            android:gravity="center"
            android:id="@+id/single_btn_tv"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cj_pay_height_48"
            android:maxLines="1"/>
    </LinearLayout>
</RelativeLayout>
