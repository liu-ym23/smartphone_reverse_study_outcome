<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/larus_base_2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/music_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.larus.bmhome.chat.plugin.image4.view.ImageViewWithLastMotion
            android:id="@+id/item_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            app:actualImageScaleType="centerCrop"
            app:failureImage="@color/larus_neutral_50"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"
            app:placeholderImage="@color/larus_neutral_transparent_1"/>
        <View
            android:id="@+id/shadow_layer_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/item_image"
            app:layout_constraintEnd_toEndOf="@+id/item_image"
            app:layout_constraintStart_toStartOf="@+id/item_image"
            app:layout_constraintTop_toTopOf="@+id/item_image"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="?attr/larus_sp_16"
            android:textColor="@color/static_white"
            android:ellipsize="end"
            android:layout_gravity="start|top"
            android:id="@+id/music_title_text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginTop="?attr/larus_dp_50"
            android:maxLines="3"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="?attr/larus_dp_12"
            android:layout_marginEnd="?attr/larus_dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="?attr/larus_sp_14"
            android:textColor="@color/static_white_transparent_4"
            android:ellipsize="end"
            android:layout_gravity="start|top"
            android:id="@+id/music_genre_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/larus_dp_4"
            android:maxLines="1"
            android:layout_marginStart="?attr/larus_dp_12"
            android:layout_marginEnd="?attr/larus_dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/music_title_text"/>
        <View
            android:id="@+id/viewSpacer"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="?attr/larus_dp_50"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrierBottom"/>
        <FrameLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/icon_do_same_style"
            android:background="@drawable/larus_bg_same_template_button"
            android:paddingTop="?attr/larus_dp_6"
            android:paddingBottom="?attr/larus_dp_6"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="?attr/larus_dp_12"
            android:paddingStart="?attr/larus_dp_14"
            android:paddingEnd="?attr/larus_dp_14"
            android:layout_marginEnd="?attr/larus_dp_12"
            app:layout_constraintBottom_toBottomOf="@+id/item_image"
            app:layout_constraintEnd_toEndOf="parent">
            <TextView
                android:textSize="?attr/larus_sp_12"
                android:textStyle="bold"
                android:textColor="@color/static_white"
                android:id="@+id/do_same_style_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/larus_discoverTab_showcaseScreen_btn_try"/>
        </FrameLayout>
        <com.larus.bmhome.bigimg.download.CommonDownLoadLayout
            android:id="@+id/download_icon"
            android:visibility="gone"
            android:layout_width="?attr/larus_dp_28"
            android:layout_height="?attr/larus_dp_28"
            android:layout_marginBottom="?attr/larus_dp_4"
            android:layout_marginEnd="?attr/larus_dp_4"
            app:larus_showText="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.larus.common_ui.widget.CommonAuthorInfoLayout
        android:id="@+id/layout_author_info"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/music_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
