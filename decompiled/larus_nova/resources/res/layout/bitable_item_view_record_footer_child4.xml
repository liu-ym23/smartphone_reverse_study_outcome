<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="end|bottom"
        android:orientation="vertical"
        android:id="@+id/switch_card_view"
        android:background="@color/bg_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@color/line_divider_default"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/bottomInnerContainer"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="horizontal"
                android:id="@+id/commentLayout"
                android:background="@drawable/bitable_record_comment_input_bg"
                android:paddingLeft="12dp"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_placeholder"
                    android:ellipsize="end"
                    android:id="@+id/inputHolderTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:lines="1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@+id/commentCount"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/text_caption"
                    android:gravity="center_vertical"
                    android:id="@+id/commentCount"
                    android:paddingLeft="12dp"
                    android:paddingRight="18dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:drawableLeft="@drawable/ud_icon_add_comment_outlined"
                    android:drawablePadding="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_caption"
                android:gravity="center_vertical"
                android:id="@+id/commentCountAlone"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:drawableLeft="@drawable/ud_icon_add_comment_outlined"
                android:drawablePadding="4dp"/>
            <FrameLayout
                android:id="@+id/more_button"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_36"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:tint="@color/icon_n1"
                    app:srcCompat="@drawable/ud_icon_more_outlined"/>
            </FrameLayout>
            <com.bytedance.ee.bear.bitable.itemview.cell.cellview.ButtonCell
                android:id="@+id/sub_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:layout_weight="1"/>
            <com.bytedance.ee.bear.bitable.itemview.cell.cellview.ButtonCell
                android:id="@+id/main_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</merge>
