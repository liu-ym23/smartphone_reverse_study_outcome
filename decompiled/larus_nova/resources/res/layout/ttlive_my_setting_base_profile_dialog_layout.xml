<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/ttlive_bg_custom_dialog"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/my_setting_dialog_titlebar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/ttlive_ppx_c2"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/my_setting_dialog_title"
            android:paddingLeft="27dp"
            android:paddingRight="27dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/my_setting_dialog_content"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="20dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/ttlive_ppx_c15"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/my_setting_dialog_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="正文"/>
    </FrameLayout>
    <View
        android:background="@color/ttlive_ppx_c5"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="46dp">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/ttlive_ppx_c2"
            android:gravity="center"
            android:id="@+id/my_setting_dialog_tx_negative"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/ttlive_cancel"
            android:layout_weight="1"/>
        <View
            android:id="@+id/uikit_dialog_option_divider"
            android:background="@color/ttlive_ppx_c5"
            android:layout_width="0.5dp"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/ttlive_ppx_c1"
            android:gravity="center"
            android:id="@+id/my_setting_dialog_tx_positive"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/ttlive_confirm"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
