<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:layout_gravity="bottom"
    android:id="@+id/pinch_bottom_bar"
    android:background="@color/ConstBGInverse"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="56dp">
    <FrameLayout
        android:id="@+id/fl_close"
        android:background="@drawable/aos_slides_bg_pinch_view_icon"
        android:layout_width="60dp"
        android:layout_height="44dp">
        <com.bytedance.awemeopen.infra.base.image.AoImageView
            android:layout_gravity="center"
            android:id="@+id/iv_close_btn"
            android:padding="11dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/familiar_pinch_close_btn"/>
    </FrameLayout>
</RelativeLayout>
