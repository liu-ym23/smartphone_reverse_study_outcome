<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/cj_pay_bg_common_dialog"
    android:layout_width="@dimen/cj_pay_height_270"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/cj_pay_common_dialog_title_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="17sp"
            android:textColor="?attr/cj_pay_text_primary"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_pay_common_dialog_title_view"
            android:paddingLeft="@dimen/cj_pay_padding_24"
            android:paddingRight="@dimen/cj_pay_padding_24"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="@dimen/cj_pay_padding_3"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/cj_pay_text_secondary"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/cj_pay_common_dialog_content_view"
            android:paddingLeft="@dimen/cj_pay_padding_24"
            android:paddingRight="@dimen/cj_pay_padding_24"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="22dp"
            android:lineSpacingMultiplier="0"/>
    </LinearLayout>
    <View
        android:id="@+id/cj_pay_common_dialog_divider"
        android:background="?attr/cj_pay_border_divider_grey_color"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="24dp"
        android:layout_below="@+id/cj_pay_common_dialog_title_layout"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/cj_pay_common_dialog_divider">
        <TextView
            android:textSize="15sp"
            android:textColor="?attr/cj_pay_text_secondary"
            android:gravity="center"
            android:id="@+id/cj_pay_common_dialog_cancel_btn_view"
            android:layout_width="140dp"
            android:layout_height="48dp"
            android:text="@string/cj_pay_common_dialog_cancel"
            android:layout_weight="1"/>
        <View
            android:id="@+id/cj_pay_common_dialog_vertical_divider"
            android:background="@color/cj_pay_color_gray_161823_opacity_12"
            android:layout_width="0.5dp"
            android:layout_height="48dp"
            android:layout_toRightOf="@+id/cj_pay_common_dialog_cancel_btn_view"
            android:layout_below="@+id/cj_pay_common_dialog_divider"/>
        <TextView
            android:textSize="15sp"
            android:textColor="?attr/cj_pay_text_primary"
            android:gravity="center"
            android:id="@+id/cj_pay_common_dialog_confirm_btn_view"
            android:layout_width="140dp"
            android:layout_height="48dp"
            android:text="@string/cj_pay_common_dialog_confirm"
            android:singleLine="true"
            android:layout_weight="1"
            android:layout_toRightOf="@+id/cj_pay_common_dialog_cancel_btn_view"
            android:layout_below="@+id/cj_pay_common_dialog_divider"/>
    </LinearLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/cj_pay_color_black_161823"
        android:gravity="center"
        android:id="@+id/cj_pay_common_dialog_single_btn_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/cj_pay_height_44"
        android:text="@string/cj_pay_i_know"
        android:layout_below="@+id/cj_pay_common_dialog_divider"/>
</RelativeLayout>
