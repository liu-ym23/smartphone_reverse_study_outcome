<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="false">
    <FrameLayout
        android:layout_gravity="center"
        android:clipChildren="false"
        android:layout_width="38dp"
        android:layout_height="38dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.bytedance.android.gamecp.common.ui.HSImageView
            android:layout_gravity="center"
            android:id="@+id/sdv_small_card_animation"
            android:visibility="invisible"
            android:layout_width="130dp"
            android:layout_height="130dp"/>
        <View
            android:id="@+id/iv_bg"
            android:background="@drawable/ttlive_bg_round_btn"
            android:layout_width="38dp"
            android:layout_height="38dp"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_static"
            android:visibility="visible"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ttlive_ic_game_promote_new"
            android:scaleType="fitXY"
            android:contentDescription="@string/gamecp_game_promote_audience_name"
            app:actualImageScaleType="fitXY"/>
        <com.bytedance.android.gamecp.common.ui.HSImageView
            android:layout_gravity="center"
            android:id="@+id/sdv_gamepad_animation"
            android:layout_width="65dp"
            android:layout_height="65dp"/>
        <com.bytedance.android.gamecp.common.ui.HSImageView
            android:layout_gravity="center"
            android:id="@+id/iv_icon"
            android:visibility="invisible"
            android:layout_width="34dp"
            android:layout_height="34dp"/>
        <com.bytedance.android.gamecp.common.ui.CircleProgressView
            android:layout_gravity="center"
            android:id="@+id/iv_progress"
            android:visibility="invisible"
            android:layout_width="39dp"
            android:layout_height="39dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
