<?xml version="1.0" encoding="utf-8"?>
<com.larus.common_ui.venus.ShapeLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:larus_sc_cornerPosition="topRight|topLeft"
    app:larus_sc_cornerRadius="24dp"
    app:larus_sc_fillColor="@color/larus_static_white">
    <RelativeLayout
        android:id="@+id/first_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">
        <TextView
            android:textSize="20dp"
            android:textColor="#1a2429"
            android:id="@+id/tv_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RTC Debug Panel"/>
        <ImageView
            android:id="@+id/tv_cancel"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/larus_ic_close"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:paddingTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <TextView
                    android:textColor="#1a2429"
                    android:id="@+id/ws_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IM长连信息"/>
                <TextView
                    android:textColor="#1a2429"
                    android:id="@+id/im_wscahnnel_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/ws_title"/>
                <TextView
                    android:textColor="#1a2429"
                    android:id="@+id/env_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/im_wscahnnel_info"/>
                <com.larus.common_ui.venus.ShapeButton
                    android:textColor="#1a2429"
                    android:id="@+id/share_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="分享到飞书"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <TextView
                android:textSize="25dp"
                android:textColor="#1a2429"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="基本信息"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#1a2429"
                android:id="@+id/base_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.larus.common_ui.venus.ShapeButton
                android:textColor="#1a2429"
                android:id="@+id/copy_base_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="复制卡片信息"/>
            <TextView
                android:textSize="25dp"
                android:textColor="#1a2429"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="录音文件"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#1a2429"
                android:id="@+id/text_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.larus.common_ui.venus.ShapeButton
                android:textColor="#1a2429"
                android:id="@+id/copy_text_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="分享到飞书"/>
            <TextView
                android:textSize="25dp"
                android:textColor="#1a2429"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="RTC引擎日志"/>
            <com.larus.common_ui.venus.ShapeButton
                android:textColor="#1a2429"
                android:id="@+id/rtc_engine_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="分享到飞书"/>
            <TextView
                android:textSize="14dp"
                android:textColor="#1a2429"
                android:id="@+id/ext_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <com.larus.common_ui.venus.ShapeButton
                android:textColor="#1a2429"
                android:id="@+id/copy_ext_info"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="复制EXT信息"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</com.larus.common_ui.venus.ShapeLinearLayout>
