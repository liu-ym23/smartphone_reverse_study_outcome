<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_chat_message_attachment_item"
    android:layout_width="match_parent"
    android:layout_height="63dp"
    android:minWidth="288dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="11dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <ImageView
            android:id="@+id/attachment_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_title"
                android:ellipsize="middle"
                android:gravity="center_vertical"
                android:id="@+id/attachment_name"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:singleLine="true"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/text_placeholder"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/attachment_size"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </LinearLayout>
    <ProgressBar
        android:layout_gravity="bottom"
        android:id="@+id/attachment_upload_progress"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/file_message_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"/>
</FrameLayout>
