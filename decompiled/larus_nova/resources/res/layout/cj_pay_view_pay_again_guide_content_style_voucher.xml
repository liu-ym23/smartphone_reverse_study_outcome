<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/cj_pay_bg_pay_again_red_content"
    android:layout_width="match_parent"
    android:layout_height="100dp">
    <TextView
        android:textSize="11dp"
        android:textColor="@color/cj_pay_color_white"
        android:gravity="center"
        android:layout_gravity="top|right"
        android:id="@+id/voucher_tag"
        android:background="@drawable/cj_pay_bg_pay_again_voucher_tag"
        android:layout_width="64dp"
        android:layout_height="18dp"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/cj_pay_color_black_161823"
        android:ellipsize="middle"
        android:layout_gravity="center_horizontal"
        android:id="@+id/recommend_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:maxLines="1"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/cj_pay_color_red_fe2c55"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/voucher_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="55dp"/>
</FrameLayout>
