<?xml version="1.0" encoding="utf-8"?>
<com.larus.business.markdown.impl.markwon.core.spans.codeblock.replacementspan.ui.MaxHeightLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/markdown_impl_markdown_code_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/markdownCodeHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_2"
        android:layout_marginBottom="@dimen/dp_2"
        android:layout_marginStart="@dimen/dp_14"
        android:layout_marginEnd="@dimen/dp_14">
        <TextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/neutral_70"
            android:id="@+id/markdownCodeLanguage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/markdownCodePreviewButton"
            android:padding="@dimen/dp_7"
            android:visibility="gone"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:src="@drawable/markdown_impl_preview_button_large"
            android:layout_marginEnd="@dimen/dp_4"/>
        <ImageView
            android:id="@+id/markdownCodeCopyButton"
            android:padding="@dimen/dp_7"
            android:visibility="gone"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:src="@drawable/markdown_impl_copy_button"
            android:layout_marginEnd="@dimen/dp_4"/>
        <ImageView
            android:id="@+id/markdownCodeFullscreenButton"
            android:padding="@dimen/dp_7"
            android:visibility="gone"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:src="@drawable/markdown_impl_fullscreen_button_large"/>
    </LinearLayout>
    <View
        android:background="@color/base_2_overlay"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"/>
    <FrameLayout
        android:id="@+id/markdownCodeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/dp_15"
            android:textColor="@color/neutral_50"
            android:gravity="center_horizontal"
            android:layout_gravity="bottom"
            android:id="@+id/markdownCodeFoldDesc"
            android:background="@drawable/markdown_impl_markdown_code_mask_bg"
            android:paddingTop="@dimen/dp_42"
            android:paddingBottom="@dimen/dp_10"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</com.larus.business.markdown.impl.markwon.core.spans.codeblock.replacementspan.ui.MaxHeightLinearLayout>
