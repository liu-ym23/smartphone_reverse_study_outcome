<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="56dp"
    android:layout_height="56dp">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/one"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:placeholderImageScaleType="fitXY"/>
    <FrameLayout
        android:id="@+id/two"
        android:visibility="invisible"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/two_other"
            android:layout_width="36dp"
            android:layout_height="36dp"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/two_my"
            android:background="@drawable/ttlive_bg_live_white_round_21"
            android:padding="3dp"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="-3dp"
            android:layout_marginStart="-3dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/three"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/three_more"
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:placeholderImage="@drawable/ttlive_interact_ic_interact_waiting_more"
            app:placeholderImageScaleType="fitXY"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="bottom"
            android:id="@+id/three_other"
            android:background="@drawable/ttlive_bg_live_white_round_18"
            android:padding="2dp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginBottom="-2dp"
            android:layout_marginStart="-2dp"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/three_my"
            android:background="@drawable/ttlive_bg_live_white_round_18"
            android:padding="2dp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="-2dp"/>
    </FrameLayout>
</FrameLayout>
