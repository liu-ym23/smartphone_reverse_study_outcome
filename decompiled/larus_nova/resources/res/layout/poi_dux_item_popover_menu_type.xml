<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.dux.popover.menu.PopoverMenuLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="52dp">
    <View
        android:id="@+id/top_divider"
        android:background="@color/LinePrimary"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/item_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <com.bytedance.lighten.loader.SmartImageView
            android:id="@+id/iv_popover_action"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="8dp"
            android:layout_marginEnd="8dp"
            app:tint="@color/TextPrimary"/>
        <com.bytedance.dux.text.DuxTextView
            android:textSize="15sp"
            android:textColor="@color/TextPrimary"
            android:ellipsize="end"
            android:id="@+id/tv_popover_action"
            android:padding="0dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
</com.bytedance.dux.popover.menu.PopoverMenuLinearLayout>
