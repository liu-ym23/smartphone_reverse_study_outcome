<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/mTvAnnouncementEntryDialogContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="15dp"
        android:textColor="@color/ttlive_white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/mTvAnnouncementEntryDialogTitle"
        android:padding="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="设置"/>
    <View
        android:id="@+id/mAnnouncementEntryDialogDividerLine"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <FrameLayout
        android:id="@+id/mFlAnnouncementEntryDialogEntryWidget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
