<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:id="@+id/cj_pay_voucher_half_page_root"
    android:background="@drawable/cj_pay_bg_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="470dp"
    android:layout_alignParentBottom="true"
    android:layout_centerHorizontal="true">
    <ImageView
        android:layout_gravity="left"
        android:id="@+id/cj_pay_back_view"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/cj_pay_icon_titlebar_left_round_close"/>
    <ImageView
        android:id="@+id/title_image"
        android:layout_width="184dp"
        android:layout_height="25dp"
        android:layout_marginTop="34dp"
        android:src="@drawable/cj_pay_native_v2_reverse_counter_title"
        android:layout_centerHorizontal="true"/>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="28dp"
        android:layout_above="@+id/cj_pay_bottom_layout"
        android:layout_below="@+id/title_image"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/voucher_item_root_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"/>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/cj_pay_bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="20dp"
        android:layout_alignParentBottom="true">
        <com.android.ttcjpaysdk.bdpay.counter.outer.sign.view.CJSignAgreementView
            android:id="@+id/cj_pay_sign_agreement_view_above"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <com.android.ttcjpaysdk.base.ui.component.btn.CJButton
                android:id="@+id/cj_pay_cancel_button"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginRight="8dp"
                android:layout_weight="1"
                app:CJButtonType="tertiary"/>
            <com.android.ttcjpaysdk.base.ui.component.btn.CJButton
                android:id="@+id/cj_pay_confirm_button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                app:CJButtonType="primary"/>
        </LinearLayout>
        <com.android.ttcjpaysdk.bdpay.counter.outer.sign.view.CJSignAgreementView
            android:id="@+id/cj_pay_sign_agreement_view_below"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
    </LinearLayout>
</RelativeLayout>
