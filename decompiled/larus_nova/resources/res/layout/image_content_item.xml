<?xml version="1.0" encoding="utf-8"?>
<com.larksuite.component.ui.layout.LKUIRoundableLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/round_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:rl_border_color="@color/line_border_card"
    app:rl_border_width="1dp"
    app:rl_radius="10dp">
    <com.ss.android.lark.chatbase.view.ChatImageGroup
        android:id="@+id/image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.ss.android.lark.chat.chatwindow.chat.message.cell.image.DelayDisplayFrameLayout
        android:id="@+id/shadow"
        android:background="@color/lkblack_alpha_30"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12dp"
            android:textColor="@color/static_black"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/progress"
            android:background="@drawable/ic_image_progress_bg"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="0%"/>
    </com.ss.android.lark.chat.chatwindow.chat.message.cell.image.DelayDisplayFrameLayout>
</com.larksuite.component.ui.layout.LKUIRoundableLayout>
