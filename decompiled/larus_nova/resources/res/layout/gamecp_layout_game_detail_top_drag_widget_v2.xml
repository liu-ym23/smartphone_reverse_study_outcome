<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/drag_content_ly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="96dp">
        <com.bytedance.android.gamecp.common.ui.RoundRectLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:leftTopRound="12dp"
            app:rightTopRound="12dp">
            <View
                android:id="@+id/v_game_detail_video_top_bg"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:alpha="0"/>
        </com.bytedance.android.gamecp.common.ui.RoundRectLayout>
        <View
            android:layout_gravity="center"
            android:id="@+id/v_game_detail_video_top_drag_icon"
            android:background="@drawable/gamecp_shape_game_detail_video_drag_icon_v2"
            android:layout_width="32dp"
            android:layout_height="4dp"/>
    </FrameLayout>
</FrameLayout>
