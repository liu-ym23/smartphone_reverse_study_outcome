<?xml version="1.0" encoding="utf-8"?>
<com.bytedance.android.livesdk.announcement.SquareFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_cover"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.live.core.widget.HSImageView
        android:id="@+id/iv_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <CheckBox
        android:layout_gravity="right"
        android:id="@+id/checkbox_video"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:button="@drawable/ttlive_bg_red_envelope_check_box_pic"/>
</com.bytedance.android.livesdk.announcement.SquareFrameLayout>
