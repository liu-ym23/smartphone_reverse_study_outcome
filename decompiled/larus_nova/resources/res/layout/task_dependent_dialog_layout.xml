<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:id="@+id/menuContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/bg_base"
        app:cardCornerRadius="12sp"
        app:cardElevation="@dimen/dp_0">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/bg_base"
            android:layout_width="match_parent"
            android:layout_height="400dp">
            <RelativeLayout
                android:id="@+id/dependent_title_bar"
                android:background="@color/bg_base"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/img_title_close"
                    android:background="@color/bg_base"
                    android:layout_width="24sp"
                    android:layout_height="24sp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"
                    android:layout_alignParentStart="true"
                    app:srcCompat="@drawable/ud_icon_close_small_outlined"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/primary_fill_default"
                    android:id="@+id/tv_title_add"
                    android:background="@color/bg_base"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Todo_Tasks_BlockedBy_Add_Button"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="16dp"
                    android:layout_alignParentEnd="true"/>
                <TextView
                    android:textSize="17sp"
                    android:textColor="@color/text_title"
                    android:id="@+id/tv_title_text"
                    android:background="@color/bg_base"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
            <View
                android:background="@color/line_divider_default"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/dependenet_task_lists"
                android:background="@color/bg_base"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
