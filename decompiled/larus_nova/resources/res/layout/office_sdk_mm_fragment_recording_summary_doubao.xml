<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mmSummaryFragmentContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/markdownContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/markdownScrollView"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:visibility="invisible"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/markdownLayout"
                android:paddingTop="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.ss.android.lark.officesdk.minutes.ui.foundation.widget.textselection.MmSelectableSummaryTextView
                    android:textSize="16sp"
                    android:textColor="@color/flow_ud_neutral_100"
                    android:id="@+id/markDownText"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="8dp"/>
                <com.ss.android.lark.officesdk.minutes.ui.foundation.widget.MmSummaryLoadingTextView
                    android:id="@+id/markdownLoadingView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="3dp"
                    app:loadingText="@string/LarkCCM_DoubaoVC_Summary_Toast"
                    app:loadingTextColor="@color/flow_ud_neutral_70"
                    app:loadingTextSize="14sp"
                    app:sweepViewWidth="40dp"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <com.larksuite.component.universe_design.shadow.UDShadowLayout
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/backToBottomLayout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:ud_shadow_radius="@dimen/dp_16"
            style="@style/UDShadow.S2.Down">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/backToBottomView"
                android:padding="10dp"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:tint="@color/flow_ud_neutral_100"
                app:srcCompat="@drawable/office_sdk_mm_ic_arrow_down_doubao"/>
        </com.larksuite.component.universe_design.shadow.UDShadowLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/markdownEmptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.ss.android.lark.officesdk.minutes.ui.foundation.widget.MmLottieView
                android:id="@+id/emptyLoadingLottieView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/flow_ud_neutral_70"
                android:id="@+id/emptyLoadingTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/View_G_Record_GeneratingSum_Empty"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fishboneContainerLayout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/fishboneWebContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.ss.android.lark.officesdk.minutes.ui.foundation.widget.LineHeightTextView
            android:id="@+id/aiGcTip"
            android:layout_width="0dp"
            android:layout_height="0dp"/>
    </FrameLayout>
    <com.larksuite.component.universe_design.shadow.UDShadowLayout
        android:layout_gravity="end|bottom"
        android:id="@+id/summarySwitchContainerLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginEnd="8dp"
        style="@style/UDShadow.S2">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/summarySwitchLayout"
            android:padding="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/switchToFishboneBtn"
                android:padding="8dp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:srcCompat="@drawable/office_sdk_mm_ic_fish_bone_doubao"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/switchToMarkdownBtn"
                android:padding="8dp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="2dp"
                app:srcCompat="@drawable/office_sdk_mm_ic_markdown_doubao"/>
        </LinearLayout>
    </com.larksuite.component.universe_design.shadow.UDShadowLayout>
</FrameLayout>
