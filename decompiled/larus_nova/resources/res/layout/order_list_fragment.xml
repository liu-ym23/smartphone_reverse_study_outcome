<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedance.android.shopping.orderlist.list.container.OrderListFoldAdaptedFrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/order_list_head_bg_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/order_list_head_container"
                    android:clipChildren="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/order_list_ll_header"
                        android:clipChildren="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <View
                        android:id="@+id/order_list_view_head_make_up"
                        android:background="@color/order_list_F5F6F9"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:elevation="10dp"
                        android:outlineProvider="none"
                        app:layout_constraintBottom_toBottomOf="@+id/order_list_ll_header"
                        app:layout_constraintTop_toBottomOf="@+id/order_list_view_head_bar"/>
                    <com.bytedance.android.shopping.orderlist.common.widgets.state.OrderCommonHeadBarView
                        android:id="@+id/order_list_view_head_bar"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:elevation="10dp"
                        android:outlineProvider="none"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <Space
                    android:id="@+id/order_list_guide_line"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginBottom="0dp"
                    app:layout_constraintBottom_toBottomOf="@+id/order_list_head_container"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                <FrameLayout
                    android:id="@+id/order_list_fl_body_container"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:translationZ="-1px"
                    app:layout_constraintBottom_toTopOf="@+id/order_list_ll_footer"
                    app:layout_constraintTop_toBottomOf="@+id/order_list_guide_line">
                    <com.bytedance.android.shopping.orderlist.list.widget.horizontalpull.PageHorizontalPullLayout
                        android:id="@+id/order_list_pull_layout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:max_offset_left="300dp"
                        app:max_offset_right="300dp">
                        <com.bytedance.android.shopping.orderlist.common.widgets.state.OrderCommonShopSkeletonLoadingView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:layout_type="edge_left"/>
                        <com.bytedance.android.shopping.orderlist.common.widgets.state.OrderCommonShopSkeletonLoadingView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:layout_type="edge_right"/>
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:layout_type="content">
                            <com.bytedance.android.shopping.orderlist.list.widget.headrefresh.OrderListHeadRefreshLayout
                                android:id="@+id/order_list_head_refresh_layout"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">
                                <com.bytedance.android.shopping.orderlist.common.widgets.state.OrderCommonRefreshSloganView
                                    android:layout_width="match_parent"
                                    android:layout_height="60dp"
                                    android:minHeight="28dp"/>
                                <com.bytedance.android.shopping.orderlist.list.widget.linkedlist.OrderListLinkedScrollView
                                    android:id="@+id/order_list_linked_scroll_view"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"/>
                            </com.bytedance.android.shopping.orderlist.list.widget.headrefresh.OrderListHeadRefreshLayout>
                            <LinearLayout
                                android:orientation="vertical"
                                android:id="@+id/order_list_sticky_container"
                                android:visibility="gone"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>
                        </FrameLayout>
                    </com.bytedance.android.shopping.orderlist.list.widget.horizontalpull.PageHorizontalPullLayout>
                </FrameLayout>
                <com.bytedance.android.shopping.orderlist.common.widgets.state.OrderCommonShopSkeletonLoadingView
                    android:id="@+id/order_list_view_shop_skeleton_loading"
                    android:background="@color/order_list_F5F6F9"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:elevation="10dp"
                    android:outlineProvider="none"
                    app:layout_constraintBottom_toTopOf="@+id/order_list_ll_footer"
                    app:layout_constraintTop_toTopOf="@+id/order_list_fl_body_container"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/order_list_bottom_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="parent"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/order_list_ll_footer"
                    android:clipChildren="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/order_list_fl_body_container"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/order_list_mask_layer"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.bytedance.android.shopping.orderlist.common.widgets.state.OrderCommonMaskView
                    android:id="@+id/order_list_view_mask"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="@+id/order_list_ll_footer"
                    app:layout_constraintTop_toTopOf="@+id/order_list_fl_body_container"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.bytedance.android.shopping.orderlist.common.widgets.state.OrderCommonBallLoadingView
                android:id="@+id/order_list_view_ball_loading"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <View
                android:layout_gravity="end|bottom"
                android:id="@+id/order_list_btn_back_to_top"
                android:background="@drawable/commerce_anchor_v4_back_to_top_btn"
                android:visibility="gone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginBottom="127dp"
                android:layout_marginEnd="13dp"/>
            <TextView
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="end|center_vertical"
                android:id="@+id/debug_btn_native"
                android:background="@color/order_list_FE496A"
                android:padding="4dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Native"
                android:alpha="0.8"/>
        </FrameLayout>
    </com.bytedance.android.shopping.orderlist.list.container.OrderListFoldAdaptedFrameLayout>
</FrameLayout>
