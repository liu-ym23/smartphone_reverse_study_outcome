<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_gravity="center_vertical"
    android:background="@color/bg_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.larksuite.component.universe_design.image.UDAvatar
        android:layout_gravity="center"
        android:id="@+id/avatarView"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/facade_common_avatar_place_holder"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ud_avatar_size="large"
        style="@style/UDAvatar.Circle"/>
    <TextView
        android:textSize="17sp"
        android:textColor="@color/text_title"
        android:ellipsize="end"
        android:id="@+id/chatTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_marginStart="74dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/chatDesp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/avatarView"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_caption"
        android:ellipsize="end"
        android:id="@+id/chatDesp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/Doc_Facade_NoGroupDesc"
        android:singleLine="true"
        android:alpha="0.75"
        android:layout_marginStart="74dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/avatarView"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chatTitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
