<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/gamecp_bg_props_coupon_list_item_unselected"
    android:layout_width="match_parent"
    android:layout_height="114dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp">
    <TextView
        android:textSize="20dp"
        android:textColor="@color/gamecp_game_FE2C55"
        android:id="@+id/tv_coupon_list_item_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/ttlive_game_promote_prop_price_unit"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="28dp"
        android:textColor="@color/gamecp_game_FE2C55"
        android:id="@+id/tv_coupon_list_item_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_coupon_list_item_unit"
        app:layout_constraintStart_toEndOf="@+id/tv_coupon_list_item_unit"/>
    <TextView
        android:textSize="11dp"
        android:textColor="@color/gamecp_game_FE2C55"
        android:id="@+id/tv_coupon_list_item_price_limit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_coupon_list_item_unit"
        app:layout_constraintStart_toEndOf="@+id/tv_coupon_list_item_price"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/gamecp_game_737373"
        android:id="@+id/tv_coupon_list_item_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="3dp"
        app:layout_constraintStart_toStartOf="@+id/tv_coupon_list_item_unit"
        app:layout_constraintTop_toBottomOf="@+id/tv_coupon_list_item_unit"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/gamecp_game_737373"
        android:id="@+id/tv_coupon_list_item_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="3dp"
        app:layout_constraintStart_toStartOf="@+id/tv_coupon_list_item_unit"
        app:layout_constraintTop_toBottomOf="@+id/tv_coupon_list_item_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
