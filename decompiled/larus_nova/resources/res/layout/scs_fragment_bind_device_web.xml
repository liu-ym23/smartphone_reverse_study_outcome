<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="@style/UDText.Title0"
        android:textColor="@color/text_title"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/Lark_Conditions_DeviceInfo"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="33dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/UDText.Body2"
        android:textColor="@color/text_caption"
        android:id="@+id/tv_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:text="@string/Lark_Conditions_BecauseCompany"
        android:layout_marginStart="17dp"
        android:layout_marginEnd="33dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <TextView
        android:textAppearance="@style/UDText.Body2"
        android:textColor="@color/text_caption"
        android:id="@+id/tv_desc2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/Lark_Conditions_BrandDevicing"
        android:layout_marginStart="17dp"
        android:layout_marginEnd="33dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_desc"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintTop_toBottomOf="@+id/tv_desc2">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/scs_grey_dot"/>
        <TextView
            android:textAppearance="@style/UDText.Headline"
            android:textColor="@color/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Lark_Conditions_BelongsDevice"
            android:layout_marginStart="@dimen/dp_12"/>
    </LinearLayout>
    <TextView
        android:textAppearance="@style/UDText.Body2"
        android:textColor="@color/text_caption"
        android:id="@+id/tv_sub_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_2"
        android:text="@string/Lark_Conditions_CompanyAndPersonal"
        android:layout_marginStart="34dp"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintTop_toBottomOf="@+id/ll_subtitle"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_subtitle2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintTop_toBottomOf="@+id/tv_sub_desc">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/scs_grey_dot"/>
        <TextView
            android:textAppearance="@style/UDText.Headline"
            android:textColor="@color/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Lark_Conditions_StatusOfDevice"
            android:layout_marginStart="@dimen/dp_12"/>
    </LinearLayout>
    <TextView
        android:textAppearance="@style/UDText.Body2"
        android:textColor="@color/text_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_2"
        android:text="@string/Lark_Conditions_UntrustedNot"
        android:layout_marginStart="34dp"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintTop_toBottomOf="@+id/ll_subtitle2"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_16"
        app:layout_constraintBottom_toTopOf="@+id/btn_authorize">
        <com.larksuite.component.universe_design.checkbox.UDCheckBox
            android:id="@+id/check_box_policy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv_policy"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/Lark_Conditions_IAgree"/>
    </LinearLayout>
    <com.larksuite.component.universe_design.button.UDButton
        android:textAppearance="@style/UDText.Title4"
        android:textColor="@color/static_white"
        android:id="@+id/btn_authorize"
        android:clickable="true"
        android:layout_marginBottom="@dimen/dp_16"
        android:text="@string/Lark_Conditions_ButtAuthorize"
        app:layout_constraintBottom_toTopOf="@+id/btn_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:ud_backgroundColor="@color/ud_button_blue_bg"
        style="@style/UDButton.Big.Column"/>
    <com.larksuite.component.universe_design.button.UDButton
        android:textAppearance="@style/UDText.Title4"
        android:textColor="@color/text_title"
        android:id="@+id/btn_cancel"
        android:clickable="true"
        android:layout_marginBottom="43dp"
        android:text="@string/Lark_Conditions_ButUnauthorize"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:ud_backgroundColor="@color/ud_button_white_grey_bg"
        app:ud_strokeColor="@color/line_border_component"
        app:ud_strokeWidth="1dp"
        style="@style/UDButton.Big.Column"/>
</androidx.constraintlayout.widget.ConstraintLayout>
