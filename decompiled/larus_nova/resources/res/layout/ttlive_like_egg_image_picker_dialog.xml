<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/dialog_root"
        android:background="#161823"
        android:layout_width="match_parent"
        android:layout_height="480dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <View
        android:id="@+id/click_outside"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/dialog_root"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="14dp"
        android:src="@drawable/ttlive_like_egg_image_picker_close"
        android:scaleType="fitXY"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="@+id/dialog_root"
        app:layout_constraintTop_toTopOf="@+id/dialog_root"/>
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#e6ffffff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/ttlive_like_egg_image_picker_album_desc"
        android:lineSpacingExtra="2dp"
        app:layout_constraintEnd_toEndOf="@+id/dialog_root"
        app:layout_constraintStart_toStartOf="@+id/dialog_root"
        app:layout_constraintTop_toTopOf="@+id/dialog_root"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/image_recycler_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="52dp"
        app:layout_constraintBottom_toBottomOf="@+id/dialog_root"
        app:layout_constraintEnd_toEndOf="@+id/dialog_root"
        app:layout_constraintStart_toStartOf="@+id/dialog_root"
        app:layout_constraintTop_toTopOf="@+id/dialog_root"/>
</androidx.constraintlayout.widget.ConstraintLayout>
