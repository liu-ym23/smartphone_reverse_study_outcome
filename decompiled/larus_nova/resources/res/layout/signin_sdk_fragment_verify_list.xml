<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_container"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.ss.android.lark.flow.passport.ui.widget.verifycode.VerifyCodeEditText
        android:id="@+id/vr_code_edit"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"/>
    <com.ss.android.lark.flow.passport.ui.widget.password.PasswordEditText
        android:id="@+id/etPasspord"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/signin_sdk_input_height"
        android:layout_marginTop="24dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_reset_pwd"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <TextView
            android:textColor="@color/text_placeholder"
            android:id="@+id/tv_reset_pwd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textColor="@color/primary_fill_default"
            android:id="@+id/tv_reset_pwd_clicked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView
        android:textStyle="normal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_next_btn"
        android:visibility="gone"
        android:layout_marginTop="16dp"
        style="@style/SignInWidget.Button.Primary"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/primary_fill_default"
            android:id="@+id/tv_countdown"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_recover"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <TextView
                android:textColor="@color/text_placeholder"
                android:id="@+id/tv_recover"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textColor="@color/primary_fill_default"
                android:id="@+id/tv_recover_click"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/primary_fill_default"
            android:id="@+id/tv_switch_code"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:singleLine="true"/>
    </LinearLayout>
</LinearLayout>
