<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="366dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/ttlive_bg_interact_game_feedback_dialog"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="17dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/ttlive_report_plugin"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#57ffffff"
            android:ellipsize="end"
            android:id="@+id/tv_title_reason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ttlive_open_platorm_reason"
            android:singleLine="true"
            app:layout_constraintTop_toBottomOf="@+id/title"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#ccffffff"
            android:ellipsize="end"
            android:id="@+id/tv_reason"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:singleLine="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/tv_choice"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_reason"/>
        <TextView
            android:textSize="13dp"
            android:textColor="#face15"
            android:ellipsize="end"
            android:id="@+id/tv_choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ttlive_open_platorm_rechoice"
            android:singleLine="true"
            android:paddingStart="2dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_reason"/>
        <TextView
            android:textSize="10dp"
            android:textColor="#57ffffff"
            android:id="@+id/tv_title_report"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ttlive_open_platform_report_desc"
            app:layout_constraintTop_toBottomOf="@+id/tv_reason"/>
        <EditText
            android:textSize="12dp"
            android:textColor="#fff"
            android:textColorHint="#57ffffff"
            android:gravity="start"
            android:id="@+id/et_desc"
            android:background="@drawable/ttlive_bg_report_input"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="6dp"
            android:hint="@string/ttlive_open_platform_report_hint"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_report"/>
        <com.bytedance.android.live.core.widget.HSImageView
            android:id="@+id/iv_photo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="12dp"
            android:scaleType="center"
            app:actualImageScaleType="centerCrop"
            app:layout_constraintTop_toBottomOf="@+id/et_desc"
            app:placeholderImage="@drawable/ttlive_image_select"
            app:placeholderImageScaleType="centerCrop"
            app:roundedCornerRadius="4dp"/>
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ttlive_report_close"
            app:layout_constraintRight_toRightOf="@+id/iv_photo"
            app:layout_constraintTop_toTopOf="@+id/iv_photo"/>
        <Button
            android:textColor="#fff"
            android:id="@+id/btn_submit"
            android:background="@drawable/tttlive_bg_submit"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            android:text="@string/ttlive_open_platform_submit"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_photo"/>
        <View
            android:background="@drawable/ttlive_bg_decorate"
            android:layout_width="134dp"
            android:layout_height="5dp"
            android:layout_marginTop="20dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_submit"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
