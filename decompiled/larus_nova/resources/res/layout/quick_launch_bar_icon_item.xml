<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1">
    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="@dimen/quick_launch_bar_item_icon_size"
        android:layout_height="@dimen/quick_launch_bar_item_icon_size"
        android:layout_marginTop="@dimen/quick_launch_bar_item_icon_top"
        android:scaleType="fitCenter"
        android:layout_centerHorizontal="true"/>
    <com.larksuite.component.universe_design.badge.UDBadgeView
        android:id="@+id/badgeDotView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-1dp"
        android:layout_alignTop="@+id/ivIcon"
        android:layout_marginEnd="-1dp"
        android:layout_alignEnd="@+id/ivIcon"
        style="@style/UDBadge.Dot.StrongReminder.Small"/>
    <com.larksuite.component.universe_design.badge.UDBadgeView
        android:id="@+id/badgeTextView"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="10dp"
        android:layout_alignStart="@+id/ivIcon"
        style="@style/UDBadge.Text.Red"/>
    <TextView
        android:textSize="@dimen/quick_launch_bar_item_name_size"
        android:textColor="@color/quick_launch_bar_item_name"
        android:ellipsize="none"
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/quick_launch_bar_item_name_top"
        android:singleLine="true"
        android:layout_below="@+id/ivIcon"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
