<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedance.android.shopping.feed.view.InflowNoPaddingTextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/commerce_color_161823"
        android:gravity="left"
        android:id="@+id/product_flow_card_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="20dp"
        android:maxLines="1"
        android:layout_weight="1"
        android:lineSpacingExtra="3sp"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:layout_marginStart="6dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/product_flow_card_title_arrow"
            android:background="@drawable/ec_inflow_card_title_arrow"
            android:layout_width="6dp"
            android:layout_height="12dp"
            android:scaleType="fitCenter"/>
    </LinearLayout>
</LinearLayout>
