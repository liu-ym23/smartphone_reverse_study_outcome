<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/page_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/first_screen_loading_view"
        android:background="@drawable/sku_buy_loading_bg"
        android:visibility="gone"
        android:layout_width="64dp"
        android:layout_height="56dp">
        <com.bytedance.android.ui.ec.widget.loading.ECDuxLoadingAnimationView
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/panel_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedance.kmp.ec.yata.view.render.controller.common.YataPerfLinearLayout
            android:orientation="vertical"
            android:id="@+id/sku_buynow_top_strand"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/main_container"/>
        <FrameLayout
            android:id="@+id/header_stub"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            app:layout_constraintTop_toTopOf="@+id/main_container"/>
        <com.bytedance.android.ui.base.widget.round.RoundLinearLayout
            android:orientation="vertical"
            android:id="@+id/main_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:bg_cornerRadius_TL="20dp"
            app:bg_cornerRadius_TR="20dp"
            app:layout_constraintBottom_toBottomOf="parent">
            <com.bytedance.android.ui.base.widget.round.RoundConstraintLayout
                android:id="@+id/container_first"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.bytedance.android.ui.base.widget.round.RoundView
                    android:id="@+id/container_first_mask"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    app:bg_colorOrientation="t2b"
                    app:bg_endColor="#00ffffff"
                    app:bg_startColor="#ffffffff"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.bytedance.android.shopping.buynow.container.BuyNowRecyclerView
                    android:id="@+id/body_container"
                    android:background="@color/buynow_F5F5F5"
                    android:clipToPadding="false"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toTopOf="@+id/footer_container"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/header_layout"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/footer_container"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                <com.bytedance.kmp.ec.yata.view.render.controller.common.YataPerfLinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ceiling_container"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/body_container"/>
                <com.bytedance.kmp.ec.yata.view.render.controller.common.YataPerfLinearLayout
                    android:orientation="vertical"
                    android:id="@+id/elevator_guide_container"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:layout_constraintBottom_toTopOf="@+id/footer_container"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/header_layout"
                    android:background="#fff5f6f9"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent">
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/header_container"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.bytedance.kmp.ec.yata.view.render.controller.common.YataPerfLinearLayout
                        android:orientation="vertical"
                        android:id="@+id/header_ceiling_container"
                        android:visibility="gone"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.bytedance.kmp.ec.yata.view.render.controller.common.YataPerfLinearLayout
                        android:orientation="vertical"
                        android:id="@+id/header_address_container"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintBottom_toBottomOf="@+id/header_container"
                        app:layout_constraintEnd_toEndOf="@+id/header_container"
                        app:layout_constraintStart_toStartOf="@+id/header_container"
                        app:layout_constraintTop_toTopOf="@+id/header_container"/>
                    <FrameLayout
                        android:id="@+id/navigation_bar"
                        android:visibility="gone"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <FrameLayout
                            android:layout_gravity="start|bottom"
                            android:id="@+id/navigation_bar_back_container"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:id="@+id/navigation_bar_back"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginLeft="16dp"
                                android:layout_marginBottom="10dp"
                                android:src="@drawable/buynow_back"
                                android:layout_marginStart="16dp"/>
                        </FrameLayout>
                        <TextView
                            android:textSize="18sp"
                            android:textColor="@color/buynow_161823"
                            android:gravity="center"
                            android:layout_gravity="bottom|center_horizontal"
                            android:id="@+id/navigation_bar_page_title"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:text="@string/buynow_confirm_order"/>
                        <FrameLayout
                            android:layout_gravity="end|bottom"
                            android:id="@+id/navigation_bar_right_container"
                            android:visibility="gone"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="8dp"
                            android:layout_marginEnd="8dp"/>
                    </FrameLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.bytedance.android.ui.base.widget.round.RoundConstraintLayout>
        </com.bytedance.android.ui.base.widget.round.RoundLinearLayout>
        <FrameLayout
            android:id="@+id/popup_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <com.bytedance.kmp.ec.yata.view.render.controller.common.YataPerfLinearLayout
            android:orientation="vertical"
            android:id="@+id/dialog_root_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="@+id/main_container"/>
        <com.bytedance.kmp.ec.yata.view.render.controller.common.YataPerfLinearLayout
            android:orientation="vertical"
            android:id="@+id/mask_layer_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="@+id/main_container"/>
        <com.bytedance.android.shopping.buynow.widgets.BuyNowTouchMaskView
            android:layout_gravity="center"
            android:id="@+id/mask_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toTopOf="@+id/main_container"/>
        <com.bytedance.android.shopping.buynow.widgets.BuyNowErrorView
            android:id="@+id/error_retry_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header_stub"/>
        <com.bytedance.android.shopping.buynow.widgets.BuyNowLoadingView
            android:layout_gravity="center"
            android:id="@+id/loading_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:bg_cornerRadius_TL="20dp"
            app:bg_cornerRadius_TR="20dp"
            app:layout_constraintBottom_toTopOf="@+id/footer_loading_holder"
            app:layout_constraintTop_toBottomOf="@+id/header_stub"/>
        <ImageView
            android:id="@+id/error_close_icon"
            android:visibility="gone"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/buynow_error_close_btn"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/main_container"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/footer_loading_holder"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            app:actualImageResource="@drawable/buynow_loading_footer_holder"
            app:actualImageScaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/ultimate_footer_loading_holder"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            app:actualImageResource="@drawable/sku_buy_loading_bottom_view"
            app:actualImageScaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tech_tag"
            android:background="@color/buynow_FE496A"
            android:padding="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Native"
            android:alpha="0.3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/debug_btn_select_sku"
            android:background="#0095ff"
            android:padding="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选第一个SKU"
            android:alpha="0.3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tech_tag"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
