<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape>
                    <size
                        android:height="20dp"
                        android:width="20dp"/>
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <size
                        android:height="18dp"
                        android:width="18dp"/>
                    <stroke
                        android:width="2dp"
                        android:color="@color/shopping_std_brand"/>
                </shape>
            </item>
            <item
                android:left="4dp"
                android:top="4dp"
                android:right="4dp"
                android:bottom="4dp">
                <shape android:shape="oval">
                    <size
                        android:height="12dp"
                        android:width="12dp"/>
                    <solid android:color="@color/shopping_std_brand"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <size
                        android:height="20dp"
                        android:width="20dp"/>
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <size
                        android:height="18.5dp"
                        android:width="18.5dp"/>
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/ec_color_black_161823_30"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
