<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/applet_debug_version_selected_background"/>
            <stroke
                android:width="1dp"
                android:color="@color/applet_debug_version_selected_stroke"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/applet_debug_version_item_background"/>
            <stroke
                android:width="0.5dp"
                android:color="@color/applet_debug_version_item_stroke"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
</selector>
