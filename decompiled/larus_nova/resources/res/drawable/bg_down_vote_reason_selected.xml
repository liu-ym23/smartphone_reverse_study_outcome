<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="100dp"/>
            <solid android:color="@color/udtoken_btn_se_bg_pri_pressed"/>
            <stroke
                android:width="1dp"
                android:color="@color/primary_content_default"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp"/>
            <solid android:color="@color/primary_fill_solid_01"/>
            <stroke
                android:width="1dp"
                android:color="@color/primary_content_default"/>
        </shape>
    </item>
</selector>
