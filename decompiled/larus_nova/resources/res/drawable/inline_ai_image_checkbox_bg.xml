<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="oval">
            <solid android:color="@color/colorful_blue"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/color_transparent_30_percent_black"/>
            <stroke
                android:width="1.5dp"
                android:color="@color/static_white"/>
        </shape>
    </item>
</selector>
