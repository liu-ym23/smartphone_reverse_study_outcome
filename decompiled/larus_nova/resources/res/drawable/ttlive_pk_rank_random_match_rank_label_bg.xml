<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#000000"/>
            <corners
                android:topLeftRadius="8dp"
                android:bottomRightRadius="8dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#425b66c8"
                android:endColor="#220a42"
                android:angle="126"
                android:type="linear"
                android:centerColor="#e3544074"/>
            <corners
                android:topLeftRadius="8dp"
                android:bottomRightRadius="8dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#00000000"
                android:endColor="#e61e1a38"
                android:angle="156"
                android:type="linear"/>
            <corners
                android:topLeftRadius="8dp"
                android:bottomRightRadius="8dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="0.5px"
                android:color="#a5c4ff"/>
            <corners
                android:topLeftRadius="8dp"
                android:bottomRightRadius="8dp"/>
        </shape>
    </item>
</layer-list>
