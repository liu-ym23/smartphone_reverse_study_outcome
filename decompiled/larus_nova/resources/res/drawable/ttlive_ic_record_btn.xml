<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <size
                android:height="60dp"
                android:width="60dp"/>
            <corners android:radius="30dp"/>
            <stroke
                android:width="4dp"
                android:color="#fff"/>
        </shape>
    </item>
    <item android:gravity="center">
        <shape>
            <size
                android:height="32dp"
                android:width="32dp"/>
            <corners android:radius="30dp"/>
            <solid android:color="#fe2c55"/>
        </shape>
    </item>
</layer-list>
