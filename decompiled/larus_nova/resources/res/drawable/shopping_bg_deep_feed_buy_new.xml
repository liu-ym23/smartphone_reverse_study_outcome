<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topRightRadius="17dp"
                android:bottomRightRadius="17dp"/>
            <gradient
                android:startColor="#ff005c"
                android:endColor="#ff005c"
                android:angle="0"
                android:type="linear"/>
        </shape>
    </item>
    <item
        android:left="0dp"
        android:right="45dp">
        <shape android:shape="rectangle">
            <corners
                android:topRightRadius="17dp"
                android:bottomRightRadius="17dp"/>
            <gradient
                android:startColor="#ff9624"
                android:endColor="@android:color/transparent"
                android:angle="315"
                android:type="linear"/>
        </shape>
    </item>
</layer-list>
