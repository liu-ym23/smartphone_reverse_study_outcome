<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/larus_primary_transparent_3"/>
            <corners android:radius="?attr/larus_dp_12"/>
            <padding
                android:left="?attr/larus_dp_12"
                android:top="?attr/larus_dp_7"
                android:right="?attr/larus_dp_12"
                android:bottom="?attr/larus_dp_7"/>
        </shape>
    </item>
    <item android:state_selected="false">
        <shape>
            <stroke
                android:width="?attr/larus_dp_0_5"
                android:color="@color/larus_neutral_transparent_2"/>
            <corners android:radius="?attr/larus_dp_12"/>
            <padding
                android:left="?attr/larus_dp_12"
                android:top="?attr/larus_dp_7"
                android:right="?attr/larus_dp_12"
                android:bottom="?attr/larus_dp_7"/>
        </shape>
    </item>
</selector>
