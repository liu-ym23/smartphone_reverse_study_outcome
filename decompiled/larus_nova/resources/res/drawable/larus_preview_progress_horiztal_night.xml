<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="?attr/larus_dp_4"/>
            <solid android:color="@color/larus_neutral_transparent_1_night"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners
                    android:topLeftRadius="?attr/larus_dp_4"
                    android:bottomLeftRadius="?attr/larus_dp_4"/>
                <solid android:color="@color/larus_neutral_50_night"/>
            </shape>
        </clip>
    </item>
</layer-list>
