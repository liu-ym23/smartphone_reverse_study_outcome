<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#3dffffff"/>
                    <corners android:radius="64dp"/>
                    <gradient
                        android:startColor="#3dff5d8b"
                        android:endColor="#3dffa64d"
                        android:angle="0"
                        android:type="linear"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <corners android:radius="64dp"/>
                    <gradient
                        android:startColor="#1eff5d8b"
                        android:endColor="#1effa64d"
                        android:angle="0"
                        android:type="linear"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
