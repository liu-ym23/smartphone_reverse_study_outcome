<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners
                android:bottomLeftRadius="@dimen/space_radius_xl"
                android:bottomRightRadius="@dimen/space_radius_xl"/>
            <solid android:color="@color/primary_pri_200"/>
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="0dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners
                android:bottomLeftRadius="@dimen/space_radius_xl"
                android:bottomRightRadius="@dimen/space_radius_xl"/>
            <solid android:color="@color/primary_pri_100"/>
        </shape>
    </item>
</layer-list>
