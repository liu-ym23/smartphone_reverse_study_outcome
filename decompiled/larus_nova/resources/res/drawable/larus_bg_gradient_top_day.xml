<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/larus_base_1_overlay_day"/>
        </shape>
    </item>
    <item android:gravity="start">
        <shape android:shape="rectangle">
            <size android:height="120dp"/>
            <gradient
                android:startColor="@color/larus_base_1_day"
                android:endColor="@color/larus_base_1_overlay_day"
                android:angle="270"
                android:type="linear"/>
        </shape>
    </item>
    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <size android:height="60dp"/>
            <gradient
                android:startColor="@color/larus_base_1_overlay_day"
                android:endColor="@color/larus_base_1_day"
                android:angle="270"
                android:type="linear"/>
        </shape>
    </item>
</layer-list>
