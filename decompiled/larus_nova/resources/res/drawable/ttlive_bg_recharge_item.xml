<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="6dp"/>
            <gradient
                android:startColor="#ff003c"
                android:endColor="#ff5e05"
                android:angle="180"/>
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="6dp"/>
            <stroke
                android:width="1dp"
                android:color="@color/ttlive_core_hs_follow"/>
        </shape>
    </item>
</selector>
