<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="5dp"
        android:right="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/larus_base_1_overlay"/>
        </shape>
    </item>
    <item
        android:gravity="top"
        android:left="5dp"
        android:right="5dp">
        <shape android:shape="rectangle">
            <size android:height="10dp"/>
            <gradient
                android:startColor="@color/larus_base_1"
                android:endColor="@color/larus_base_1_overlay"
                android:angle="270"
                android:type="linear"/>
        </shape>
    </item>
    <item
        android:gravity="bottom"
        android:left="5dp"
        android:right="5dp">
        <shape android:shape="rectangle">
            <size android:height="10dp"/>
            <gradient
                android:startColor="@color/larus_base_1"
                android:endColor="@color/larus_base_1_overlay"
                android:angle="90"
                android:type="linear"/>
        </shape>
    </item>
</layer-list>
