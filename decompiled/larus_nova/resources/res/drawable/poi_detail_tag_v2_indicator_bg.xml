<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <item
        android:gravity="center"
        android:bottom="8dp">
        <shape>
            <size
                android:height="4dp"
                android:width="20dp"/>
            <corners android:radius="2dp"/>
            <gradient
                android:startColor="#ffff4689"
                android:endColor="#fffe2c55"
                android:angle="0"
                android:type="linear"
                android:gradientRadius="2dp"/>
        </shape>
    </item>
</layer-list>
