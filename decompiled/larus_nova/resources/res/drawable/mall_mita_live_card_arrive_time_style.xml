<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#4dffffff"/>
            <stroke
                android:width="0.5dp"
                android:color="#1fffffff"/>
            <corners android:radius="3dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#66ffadcf"
                android:endColor="#00000000"
                android:angle="45"
                android:centerColor="#00fff2f4"/>
            <corners android:radius="3dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#80fff4b2"
                android:endColor="#00fffad9"
                android:angle="135"
                android:centerColor="#00fffad9"/>
            <corners android:radius="3dp"/>
        </shape>
    </item>
</layer-list>
