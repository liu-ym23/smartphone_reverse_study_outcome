<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="@color/larus_static_black_transparent_1"/>
            <size android:height="?attr/larus_dp_4"/>
            <corners android:radius="?attr/larus_dp_1"/>
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <solid android:color="#b2ffffff"/>
                <size android:height="?attr/larus_dp_4"/>
                <corners android:radius="?attr/larus_dp_1"/>
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <solid android:color="@color/larus_static_white"/>
                <size android:height="?attr/larus_dp_4"/>
                <corners android:radius="?attr/larus_dp_1"/>
            </shape>
        </clip>
    </item>
</layer-list>
