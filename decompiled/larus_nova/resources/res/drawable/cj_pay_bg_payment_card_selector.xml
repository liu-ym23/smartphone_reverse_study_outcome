<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="4dp"/>
            <solid android:color="@color/cj_pay_color_red_fe2c55_opacity_6"/>
            <stroke
                android:width="0.5dp"
                android:color="@color/cj_pay_color_red_fe2c55_opacity_34"/>
        </shape>
    </item>
    <item android:state_selected="false">
        <shape android:shape="rectangle">
            <corners android:radius="4dp"/>
            <solid android:color="@color/cj_pay_color_gray_161823_opacity_3"/>
        </shape>
    </item>
</selector>
