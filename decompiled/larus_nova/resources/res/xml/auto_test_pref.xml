<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="auto test">
        <CheckBoxPreference
            android:title="自动化测试"
            android:key="test_switch"
            android:defaultValue="false"
            android:summaryOn="开启"
            android:summaryOff="关闭"/>
        <MultiSelectListPreference
            android:entries="@array/doc_types"
            android:title="白名单"
            android:key="doc_types"
            android:summary="自动化测试文档类型"
            android:entryValues="@array/doc_types"/>
        <EditTextPreference
            android:title="点击输入测试文件夹目录token"
            android:key="folder_token"
            android:summary="目录token"
            android:dialogTitle="请输入测试文件夹目录token"/>
        <PreferenceScreen
            android:title="主动清理内存"
            android:key="memory_gc"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="wiki auto test">
        <CheckBoxPreference
            android:title="wiki自动化测试"
            android:key="wiki_test_switch"
            android:defaultValue="false"
            android:summaryOn="开启"
            android:summaryOff="关闭"/>
    </PreferenceCategory>
</PreferenceScreen>
