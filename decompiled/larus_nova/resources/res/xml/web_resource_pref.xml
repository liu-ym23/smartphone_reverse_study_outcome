<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <Preference
        android:title="离线资源版本号"
        android:key="scm_info"/>
    <CheckBoxPreference
        android:title="自动下载完整包"
        android:key="offline_auto_download_full_res"
        android:defaultValue="true"
        android:summaryOn="开启"
        android:summaryOff="关闭"/>
    <CheckBoxPreference
        android:title="使用离线 sourceMap 包"
        android:key="enable_debug_res"
        android:defaultValue="false"
        android:summaryOn="开启"
        android:summaryOff="关闭"/>
    <CheckBoxPreference
        android:title="禁用指定资源包"
        android:key="offline_disable_specific_res"
        android:defaultValue="false"
        android:summaryOn="开启"
        android:summaryOff="关闭"/>
    <EditTextPreference
        android:title="指定离线资源版本号（默认自动下载）"
        android:key="offline_res_version"
        android:summary="无离线资源版本号"
        android:dialogTitle="请输入离线资源版本号"/>
    <CheckBoxPreference
        android:title="离线资源包开启SourceMap"
        android:key="offline_res_enable_source_map"
        android:defaultValue="false"
        android:summaryOn="开启"
        android:summaryOff="关闭"/>
    <CheckBoxPreference
        android:title="禁用前端代理"
        android:key="disable_ip_proxy"
        android:defaultValue="false"
        android:summaryOn="开启"
        android:summaryOff="关闭"/>
    <EditTextPreference
        android:hint=":3001"
        android:title="前端网络代理(ip:port)"
        android:key="ip_proxy"
        android:dialogTitle="输入前端代理(ip:port)"/>
    <CheckBoxPreference
        android:title="代理模式复用模版"
        android:key="firstRenderNotAccelerate"
        android:defaultValue="false"
        android:summaryOn="开启"
        android:summaryOff="关闭"/>
    <CheckBoxPreference
        android:title="使用单WebView"
        android:key="singleWebView"
        android:defaultValue="false"
        android:summaryOn="开启"
        android:summaryOff="关闭"/>
    <EditTextPreference
        android:hint="单位：ms"
        android:title="设置文档超时时间"
        android:key="documentOpenTimeout"
        android:dialogTitle="设置文档超时时间(删除恢复默认)"
        android:inputType="number"/>
    <CheckBoxPreference
        android:title="使用TTwebview"
        android:key="ttwebview_enable"
        android:defaultValue="true"
        android:summaryOn="开启"
        android:summaryOff="关闭"/>
    <CheckBoxPreference
        android:title="使用TTwebview-M62内核版本"
        android:key="ttwebview_m62_enable"
        android:defaultValue="false"
        android:summaryOn="开启"
        android:summaryOff="关闭"/>
    <PreferenceScreen
        android:title="获取文档缓存数据大小"
        android:key="get_doc_cache_size"/>
    <PreferenceScreen
        android:title="清除文档缓存数据"
        android:key="clean_doc_cache"/>
    <CheckBoxPreference
        android:title="离线数据加密"
        android:key="offline_encrypt"
        android:defaultValue="true"
        android:summaryOn="开启"
        android:summaryOff="关闭"/>
    <CheckBoxPreference
        android:title="禁用文档预加载"
        android:key="disable_preload_document"
        android:defaultValue="false"
        android:summaryOn="开启"
        android:summaryOff="关闭"/>
    <CheckBoxPreference
        android:title="开启文档缓存命中提示"
        android:key="show_cache_toast"
        android:defaultValue="false"
        android:summaryOn="开启"
        android:summaryOff="关闭"/>
    <CheckBoxPreference
        android:title="开启文档缓存大小提示"
        android:key="show_doc_size_toast"
        android:defaultValue="false"
        android:summaryOn="开启"
        android:summaryOff="关闭"/>
    <EditTextPreference
        android:title="自定义roadster"
        android:key="roaster_zip_link"
        android:summary=""
        android:dialogTitle="请输入roaster压缩包链接"/>
    <PreferenceScreen
        android:title="清理roadster"
        android:key="clear_roaster"/>
    <CheckBoxPreference
        android:title="roadster debug开关"
        android:key="ai_roadster_debug"
        android:defaultValue="false"
        android:summaryOn="开启"
        android:summaryOff="关闭"/>
    <PreferenceScreen
        android:title="模拟存储错误"
        android:key="set_data_error"/>
    <PreferenceScreen
        android:title="开启WebView Debug"
        android:key="debug_on"/>
    <CheckBoxPreference
        android:title="开启同层渲染"
        android:key="drive_same_render_emed_on"
        android:defaultValue="true"
        android:summaryOn="开启（无法保证一定开启同层渲染）"
        android:summaryOff="关闭"/>
</PreferenceScreen>
