{
    "type": "View",
     "style": {
        "width": "stretch",
         "height": "auto",
         ":padding": "['0', '0', data.custom.padding_bottom, '0']",
         "bg_color": "#ffffff",
         "flex_direction": "column"
    },
     "elements": [{
        "type": "View",
         "style": {
            "width": "stretch",
             "height": "0.5",
             "bg_color": "#1F161823"
        }
    },
     {
        "type": "View",
         "style": {
            "width": "stretch",
             "height": "64",
             "padding": ["10",
