                    },
                     "elements": [{
                        "attr": {
                            ":text": "data.cut_info",
                             "aria_hidden": true
                        },
                         "type": "Text",
                         "style": {
                            "margin": ["0",
                             "4",
                             "0",
                             "0"],
                             "font_size": 14,
                             "font_color": "#FF3B52"
                        }
                    },
                     {
                        "attr": {
                            "role": "button",
                             "aria_label": "明细"
                        },
                         "type": "View",
                         "style": {
                            "align_items": "center"
                        },
                         "elements": [{
                            "attr": {
                                "text": "明细"
                            },
                             "type": "Text",
                             "style": {
                                "font_size": 14,
                                 "font_color": "#FF3B52"
                            }
                        },
                         {
                            "attr": {
                                "src": "https://p9-piu.byteimg.com/tos-cn-i-8jisjyls3a/8b21683232d6481c8a6365b4863c5b01~tplv-8jisjyls3a-3:0:0:q75.png",
                                 "_experimental_base64_src": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAACQAAAAkCAMAAADW3miqAAAAGFBMVEVHcEz/OlH/OlL/OFD/QFD/O1H/O1L/O1Jbkjo2AAAACHRSTlMAYOIiEM2f/85p830AAABdSURBVDiN7crLDsAgCERRFNH//+M+aGMrIyTdNfGuJplDtPoU11pCk1uTQB0mUmp8dZqUXKWGyFO38VQ3c/U0M/U2WI0GKWusQsYoaAbF2KjiaxfJ0OwqCz5Wf2kD1CMDGeB+QecAAAAASUVORK5CYII="
                            },
                             "type": "Image",
                             "style": {
                                "width": "12",
                                 "height": "12",
                                 "margin": ["0",
                                 "0",
                                 "0",
                                 "2"]
                            }
                        }]
                    }]
                }],
                 "click_action": {
                    "type": "openDiscountPanel"
                }
            },
             {
                "attr": {
                    "role": "button",
                     "text": "删除",
                     "aria_label": "删除"
                },
                 "type": "Text",
                 "style": {
                    "width": "100",
                     "bg_img": "https://p26-piu.byteimg.com/tos-cn-i-8jisjyls3a/1e7cf9a7f485402b963682b04f5e2d54~tplv-8jisjyls3a-3:0:0:q75.png",
                     "height": "44",
                     "margin": ["0",
                     "0",
                     "0",
                     "8"],
                     "radius": ["8"],
                     ":display": "option(data.is_managed, 'flex', 'none')",
                     "font_size": 15,
                     "font_color": "#ffffff",
                     "align_items": "center",
                     "font_weight": 500,
                     "justify_content": "center"
                },
                 "click_action": {
                    "type": "compactDelete"
                }
            },
             {
                "attr": {
                    "role": "button",
                     ":text": "data.order_button.text",
                     ":aria_label": "data.order_button.text"
                },
                 "type": "Text",
                 "style": {
                    "width": "100",
                     "bg_img": "https://p26-piu.byteimg.com/tos-cn-i-8jisjyls3a/1e7cf9a7f485402b963682b04f5e2d54~tplv-8jisjyls3a-3:0:0:q75.png",
                     "height": "44",
                     "margin": ["0",
                     "0",
                     "0",
                     "8"],
                     "radius": ["8"],
                     ":display": "option(data.is_managed, 'none', 'flex')",
                     "font_size": 15,
                     "font_color": "#ffffff",
                     "align_items": "center",
                     "font_weight": 500,
                     "justify_content": "center"
                },
                 "click_action": {
                    "type": "buyRender"
                }
            }]
        }]
    }]
}