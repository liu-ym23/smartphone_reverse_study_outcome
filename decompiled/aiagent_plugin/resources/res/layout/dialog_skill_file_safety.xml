<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.layout.OUILinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <com.obric.oui.layout.OUILinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/skill_file_safety_skip_row"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="32dp">
        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp">
            <com.obric.oui.checkbox.OCheckBox
                android:layout_gravity="center"
                android:id="@+id/skill_file_safety_skip_checkbox"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:contentDescription="@string/obric_skill_file_safety_skip"/>
        </FrameLayout>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_basic_text_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/obric_skill_file_safety_skip"
            android:layout_marginStart="2dp"
            style="@style/Button_1_Regular"/>
    </com.obric.oui.layout.OUILinearLayout>
</com.obric.oui.layout.OUILinearLayout>
