<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OCTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/oui_title_bar_height"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:oui_title_text="@string/app_name_localised"
        app:oui_useBackIcon="false"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/oui_title_bar_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp">
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/tv_build"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Label_S"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_4"
                android:id="@+id/tv_pacific_notice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pacific_user_notice"
                android:lineBreakStyle="loose"
                android:lineBreakWordStyle="none"
                style="@style/Label_S"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/TextReverse2"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="模型选择"
                android:layout_marginStart="12dp"
                style="@style/Label_M"/>
            <com.obric.oui.dropdown.ODropdownTrigger
                android:id="@+id/drp_model_selection"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                style="@style/ODropdownTrigger.Default.Default"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/TextReverse2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="运行环境"
                android:layout_marginStart="12dp"
                style="@style/Label_M"/>
            <com.obric.oui.dropdown.ODropdownTrigger
                android:id="@+id/drp_environment"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                style="@style/ODropdownTrigger.Default.Default"/>
            <com.obric.oui.forms.OInputView
                android:gravity="top"
                android:id="@+id/txt_ppe_env"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="PPE 环境"
                android:cursorVisible="true"
                android:inputType="text"
                app:oui_inputHeight="40dp"
                app:oui_inputLabel="PPE 环境"
                app:oui_inputMode="text"
                app:oui_inputSingleLine="false"
                app:oui_showLabel="false"
                app:oui_showLabelIcon="false"/>
            <com.obric.oui.button.OButton
                android:id="@+id/btn_confirm_ppe_env"
                android:layout_width="wrap_content"
                android:layout_marginTop="6dp"
                android:text="确认 PPE 环境"
                style="@style/OButton.M2.Standard.Primary_Light"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/TextReverse2"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="输入自定义任务"
                android:layout_marginStart="12dp"
                style="@style/Label_M"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">
                <com.obric.oui.forms.OInputView
                    android:gravity="top"
                    android:id="@+id/tv_vlm_task"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:text="打开高德地图导航到大钟寺中坤广场。"
                    android:hint="输入任务明细"
                    android:cursorVisible="true"
                    android:maxLines="8"
                    android:layout_weight="8"
                    android:inputType="textMultiLine"
                    app:oui_inputHeight="160dp"
                    app:oui_inputLabel="任务详情"
                    app:oui_inputMode="text"
                    app:oui_inputSingleLine="false"
                    app:oui_showLabel="false"
                    app:oui_showLabelIcon="false"/>
                <com.obric.oui.button.OButton
                    android:id="@+id/btn_start"
                    android:layout_width="0dp"
                    android:text="开始"
                    android:layout_weight="2"
                    android:layout_marginStart="8dp"
                    style="@style/OButton.M1.Standard.Primary"/>
            </LinearLayout>
            <com.obric.oui.button.OButton
                android:id="@+id/btn_stop"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_marginTop="20dp"
                android:text="停止正在执行的任务"
                style="@style/OButton.M2.Standard.Red_Light"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/TextNegativeSecondary"
                android:id="@+id/tv_early_term_reason"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                style="@style/Label_M"/>
            <com.obric.oui.button.OButton
                android:id="@+id/btn_share_to_gallery"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_marginTop="20dp"
                android:text="保存最近 1 条执行记录到相册"
                style="@style/OButton.M2.Standard.Primary_Light"/>
            <com.obric.oui.button.OButton
                android:id="@+id/btn_share_to_notes"
                android:layout_width="wrap_content"
                android:layout_marginTop="20dp"
                android:text="保存最近 1 条执行记录到便签"
                style="@style/OButton.M2.Standard.Primary_Light"/>
            <com.obric.oui.button.OButton
                android:id="@+id/btn_dump"
                android:layout_width="wrap_content"
                android:layout_marginTop="20dp"
                android:text="导出最近 1 条执行日志（用于调试）"
                style="@style/OButton.M2.Standard.Primary_Light"/>
            <com.obric.oui.button.OButton
                android:id="@+id/btn_hook_toggle"
                android:layout_width="wrap_content"
                android:layout_marginTop="20dp"
                android:text="启动/关闭 Hook 模式"
                android:layout_marginStart="8dp"
                style="@style/OButton.M1.Standard.Primary_Light"/>
            <com.obric.oui.button.OButton
                android:id="@+id/btn_go_task_list"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_marginTop="20dp"
                android:text="查看历史任务"
                style="@style/OButton.M2.Standard.Primary_Light"/>
            <com.obric.oui.button.OButton
                android:id="@+id/btn_go_island"
                android:layout_width="wrap_content"
                android:layout_marginTop="20dp"
                android:text="查看岛"
                style="@style/OButton.M2.Standard.Primary_Light"/>
            <com.obric.oui.button.OButton
                android:id="@+id/btn_personal_search"
                android:layout_width="wrap_content"
                android:layout_marginTop="20dp"
                android:text="个人画像查询"
                style="@style/OButton.M2.Standard.Primary_Light"/>
            <com.obric.oui.button.OButton
                android:id="@+id/add_old_timer_task"
                android:layout_width="wrap_content"
                android:layout_marginTop="20dp"
                android:text="创建一个老版定时任务"
                style="@style/OButton.M2.Standard.Primary_Light"/>
            <com.obric.oui.button.OButton
                android:id="@+id/clear_script_block_cache"
                android:layout_width="wrap_content"
                android:layout_marginTop="20dp"
                android:text="清除剧本错误历史"
                style="@style/OButton.M2.Standard.Primary_Light"/>
            <com.obric.oui.button.OButton
                android:id="@+id/set_script_failure_count"
                android:layout_width="wrap_content"
                android:layout_marginTop="20dp"
                android:text="设置剧本失败次数"
                style="@style/OButton.M2.Standard.Primary_Light"/>
            <com.obric.oui.button.OButton
                android:id="@+id/clear_guide_keva"
                android:layout_width="wrap_content"
                android:layout_marginTop="20dp"
                android:text="清除快捷图标引导记录"
                style="@style/OButton.M2.Standard.Primary_Light"/>
            <com.obric.oui.button.OButton
                android:id="@+id/btn_test_cloud_config"
                android:layout_width="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Test Cloud Config Read"
                style="@style/OButton.M2.Standard.Primary_Light"/>
            <com.obric.oui.button.OButton
                android:id="@+id/btn_test_power_monitor_config"
                android:layout_width="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Test Power Monitor Config"
                style="@style/OButton.M2.Standard.Primary_Light"/>
            <com.obric.oui.button.OButton
                android:id="@+id/btn_test_cpu_exception_config"
                android:layout_width="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Test CPU Exception Config"
                style="@style/OButton.M2.Standard.Primary_Light"/>
            <com.obric.oui.button.OButton
                android:id="@+id/btn_mock_pre_check_performance"
                android:layout_width="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Mock pre-check performance event track"
                style="@style/OButton.M2.Standard.Primary_Light"/>
            <FrameLayout
                android:paddingLeft="16dp"
                android:paddingTop="26dp"
                android:paddingRight="26dp"
                android:paddingBottom="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.text.OTextView
                    android:textColor="@color/TextPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="开启个人记忆（仅用于调试）"/>
                <com.obric.oui.oswitch.OSwitch
                    android:layout_gravity="right"
                    android:id="@+id/enable_memory_search"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/tv_resource_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                style="@style/Label_S"/>
            <com.obric.oui.button.OButton
                android:id="@+id/clear_script_resource"
                android:layout_width="wrap_content"
                android:layout_marginTop="20dp"
                android:text="删除本地剧本资源"
                style="@style/OButton.M2.Standard.Red_Light"/>
            <com.obric.oui.button.OButton
                android:id="@+id/clear_script_engine_resource"
                android:layout_width="wrap_content"
                android:layout_marginTop="20dp"
                android:text="删除本地引擎资源"
                style="@style/OButton.M2.Standard.Red_Light"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/tv_device_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                style="@style/Label_S"/>
        </LinearLayout>
    </ScrollView>
    <FrameLayout
        android:id="@+id/progress_bar_container"
        android:background="@color/oui_bg_base_1"
        android:padding="30dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
