<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:oFloatingTitleBar_centerTitle="@string/instruction_knowledge_read_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oui_widgetFitInsetTop="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/knowledge_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="110dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent">
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/auto_learn_item"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginStart="-12dp"
            android:layout_marginEnd="-12dp"
            app:ocardlistitem_defaultCustomEnd="end_switch"
            app:ocardlistitem_showCustomEnd="true"
            app:ocardlistitem_title="@string/instruction_knowledge_auto_learn_title"/>
        <com.obric.oui.text.OTextView
            android:textSize="12sp"
            android:textColor="@color/oui_basic_text_3"
            android:id="@+id/knowledge_detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/instruction_knowledge_detail_title"
            android:layout_marginStart="20dp"
            style="@style/Body_2_Regular"/>
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/knowledge_input_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="-12dp"
            android:layout_marginEnd="-12dp"
            app:ocardlistitem_cardType="type_container"/>
        <com.obric.oui.text.OTextView
            android:textSize="12sp"
            android:textColor="@color/oui_basic_text_3"
            android:id="@+id/auto_learn_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/instruction_knowledge_auto_learn_desc"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
    </LinearLayout>
    <com.obric.oui.actionbar.v2.OBottomActionBarFloating
        android:id="@+id/knowledge_bottom_button_group"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/OStyleV2.OBottomActionBar.Floating"/>
</androidx.constraintlayout.widget.ConstraintLayout>
