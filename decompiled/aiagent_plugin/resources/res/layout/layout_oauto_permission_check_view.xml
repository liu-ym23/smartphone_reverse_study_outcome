<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.layout.OUILinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/permission_check_root_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp"
    app:oui_radius="@dimen/oui_r_l1">
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_text_1"
        android:ellipsize="end"
        android:id="@+id/tv_hint_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/oauto_permission_require_tips"
        android:maxLines="1"
        android:layout_weight="1"
        android:layout_marginStart="20dp"
        style="@style/Body_M"/>
    <com.obric.oui.button.OButton
        android:textColor="@color/oui_accent_6_bg"
        android:id="@+id/btn_enable"
        android:text="@string/oauto_permission_enable"
        android:layout_marginEnd="8dp"
        style="@style/OButton.M1.Trans.Primary"/>
</com.obric.oui.layout.OUILinearLayout>
