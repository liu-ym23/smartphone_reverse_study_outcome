<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/condition_location_recycler_view_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/blur_mask">
        <com.obric.oui.orecyclerview.widget.RecyclerView
            android:id="@+id/condition_location_recycler_view"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/blur_mask">
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_3"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="160dp"
            android:text="无搜索结果"
            style="@style/Title_3_Medium"/>
    </FrameLayout>
    <com.obric.oui.blur.OBlurMaskView
        android:id="@+id/blur_mask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:oBlurMask_blurRadius="8"
        app:oBlurMask_defaultMaskBackground="true"
        app:oui_widgetBlurBlendModes="@array/title_no_blend_modes"
        app:oui_widgetBlurColors="@array/title_no_blend_colors">
        <com.obric.oui.titlebar.OFloatingTitleBar
            android:id="@+id/condition_location_sheet_title_bar"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            app:oFloatingTitleBar_type="window"/>
        <com.obric.oui.layout.OUIFrameLayout
            android:orientation="horizontal"
            android:id="@+id/condition_location_search_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="64dp">
            <com.obric.oui.searchbar.v2.OSearchBar
                android:id="@+id/condition_location_search"
                android:layout_width="match_parent"
                android:layout_marginHorizontal="12dp"
                android:layout_marginVertical="8dp"
                style="@style/OStyleV2.OSearchBar.Float.S"/>
        </com.obric.oui.layout.OUIFrameLayout>
    </com.obric.oui.blur.OBlurMaskView>
</androidx.constraintlayout.widget.ConstraintLayout>
