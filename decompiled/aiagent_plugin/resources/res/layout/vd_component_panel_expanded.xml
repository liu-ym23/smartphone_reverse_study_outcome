<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/expanded_content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/panel_content_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="12dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/header_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingEnd="36dp">
                <ImageView
                    android:id="@+id/iv_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="4dp"/>
                <com.obric.oui.text.OTextView
                    android:textSize="12sp"
                    android:textColor="@color/oui_basic_text_3"
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingEnd="4dp"
                    android:lineHeight="15dp"
                    android:textFontWeight="400"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/content_body_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <ScrollView
                    android:id="@+id/content_scroll_view"
                    android:scrollbars="none"
                    android:fadingEdge="vertical"
                    android:fadingEdgeLength="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:requiresFadingEdge="vertical"
                    app:layout_constrainedHeight="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_max="388dp"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.obric.oui.text.OTextView
                        android:textColor="@color/oui_basic_text_1"
                        android:id="@+id/tv_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        style="@style/Body_1_Regular"/>
                </ScrollView>
                <com.obric.autoaction.vdplayer.components.panel.VDPlayerMarkdownView
                    android:id="@+id/markdown_content_view"
                    android:visibility="gone"
                    android:scrollbars="none"
                    android:fadingEdge="vertical"
                    android:fadingEdgeLength="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:requiresFadingEdge="vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    app:layout_constrainedHeight="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_max="388dp"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/option_group"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"/>
            <View
                android:background="@color/oui_basic_line_1"
                android:layout_width="match_parent"
                android:layout_height="0.6dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/prefix_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.obric.oui.avatar.OCircleImageView
                    android:id="0x7f03002b"
                    android:layout_width="32dp"
                    android:layout_height="32dp"/>
                <com.obric.oui.text.OTextView
                    android:textSize="14dp"
                    android:textColor="@color/oui_basic_text_1"
                    android:ellipsize="end"
                    android:id="@+id/text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/obric_vd_status_preparing"
                    android:maxLines="1"
                    android:layout_marginStart="8dp"
                    android:textFontWeight="500"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/control_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageButton
                android:id="@+id/collapse_button_inline"
                android:background="@android:color/transparent"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_vd_panel_collapse"
                android:scaleType="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:contentDescription="@null"
                android:paddingStart="0dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>
    <ImageButton
        android:layout_gravity="end|top"
        android:id="@+id/collapse_button_floating"
        android:background="@android:color/transparent"
        android:padding="0dp"
        android:visibility="gone"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/ic_vd_panel_collapse"
        android:scaleType="center"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:contentDescription="@null"
        android:layout_marginEnd="12dp"/>
</FrameLayout>
