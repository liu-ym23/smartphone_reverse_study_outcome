<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.layout.OUIConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/skill_shop_banner_card"
    android:background="@color/oui_basic_fill_element_2"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="136dp"
    android:layout_marginTop="0dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:outlineProvider="background"
    android:clipToOutline="true"
    app:oui_radius="20dp">
    <com.facebook.drawee.view.SimpleDraweeView
        android:id="@+id/skill_shop_banner_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.obric.oui.layout.OUIConstraintLayout
        android:id="@+id/skill_shop_banner_content"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.obric.oui.text.OTextView
            android:textSize="24dp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/skill_shop_banner_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:maxLines="1"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="44dp"
            android:lineHeight="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Title_Title_M"/>
        <com.obric.oui.text.OTextView
            android:textSize="14dp"
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/skill_shop_banner_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="44dp"
            android:lineHeight="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/skill_shop_banner_title"
            style="@style/Subtitle_3_Regular"/>
        <com.obric.oui.button.OButton
            android:textColor="#f2ffffff"
            android:ellipsize="end"
            android:id="@+id/skill_shop_banner_button"
            android:background="@drawable/skill_bg_shop_banner_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:minWidth="80dp"
            android:minHeight="32dp"
            android:text="@string/obric_skill_shop_view_now"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:oui_buttonTextStyle="@style/SkillShopBannerButtonText"
            style="@style/OStyleV2.OButton.S.Standard.Neutral"/>
    </com.obric.oui.layout.OUIConstraintLayout>
</com.obric.oui.layout.OUIConstraintLayout>
