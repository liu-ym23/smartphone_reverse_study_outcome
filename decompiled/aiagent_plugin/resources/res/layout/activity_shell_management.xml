<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shell_management_root"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_container"
        android:paddingTop="@dimen/oui_title_bar_mask_height"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/shell_usage_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/shell_usage_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_subTitle="@string/obric_skill_shell_usage_subtitle"
                app:ocardlistitem_title="@string/obric_skill_shell_usage_title"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/shell_clear_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/shell_clear_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_title="@string/obric_skill_shell_clear_title"/>
        </LinearLayout>
    </LinearLayout>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:layout_gravity="top"
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_centerTitle="@string/obric_skill_shell_management_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oui_widgetFitInsetTop="true"/>
</FrameLayout>
