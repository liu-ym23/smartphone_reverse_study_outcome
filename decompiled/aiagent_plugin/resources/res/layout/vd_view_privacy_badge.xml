<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/protection_badge_group"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/security_badge_content"
        android:background="@drawable/vd_panel_privacy_badge_bg"
        android:padding="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.obric.oui.text.OTextView
            android:textSize="12sp"
            android:textColor="#99000000"
            android:gravity="center"
            android:id="@+id/security_badge_icon"
            android:background="@drawable/vd_panel_security_badge_icon_bg"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:text="!"
            android:includeFontPadding="false"
            android:textFontWeight="700"/>
        <com.obric.oui.text.OTextView
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:id="@+id/security_badge_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vd_security_badge_text"
            android:layout_marginStart="2dp"
            android:textFontWeight="400"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/privacy_badge_content"
        android:background="@drawable/vd_panel_privacy_badge_bg"
        android:padding="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/privacy_badge_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/oic_shield_checkmark_fill"/>
        <com.obric.oui.text.OTextView
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:id="@+id/privacy_badge_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/obric_vd_privacy_badge_text"
            android:layout_marginStart="2dp"
            android:textFontWeight="400"/>
    </LinearLayout>
</LinearLayout>
