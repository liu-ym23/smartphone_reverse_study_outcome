<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.layout.OUILinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp"
    app:oui_radius="@dimen/oui_r_l1">
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_text_1"
        android:ellipsize="end"
        android:id="@+id/tv_hint_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/main_menu_add_launcher_icon_tip"
        android:maxLines="1"
        android:layout_weight="1"
        android:layout_marginStart="20dp"
        style="@style/Title_1_Regular"/>
    <com.obric.oui.button.OButton
        android:textColor="@color/oui_functional_blue_6"
        android:id="@+id/add_icon_confirm"
        android:background="@color/oui_fill_element_2"
        android:text="@string/main_menu_add_launcher_icon_tip_confirm"
        android:layout_marginEnd="8dp"
        style="@style/OStyleV2.OButton.S.Standard.Neutral"/>
    <com.obric.oui.button.OIconButton
        android:layout_gravity="center_vertical"
        android:id="@+id/add_icon_cancel"
        android:src="@drawable/ic_back"
        android:text="@string/oauto_permission_enable"
        android:layout_marginEnd="8dp"
        style="@style/OStyleV2.OIconButton.S.Trans.Neutral"/>
</com.obric.oui.layout.OUILinearLayout>
