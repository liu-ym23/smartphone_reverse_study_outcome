<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.layout.OUIConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/example_content"
    android:background="@color/oui_advanced_fill_list_item_card"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="60dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:outlineProvider="background"
    android:clipToOutline="true"
    app:oui_radius="20dp">
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_basic_text_1"
        android:id="@+id/example_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/example_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Body_1_Regular"/>
    <com.obric.oui.image.OImage
        android:id="@+id/example_arrow"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/oui_icon_oic_arrow_right"
        android:tint="@color/oui_basic_text_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:oui_imageStrokeEnabled="false"/>
</com.obric.oui.layout.OUIConstraintLayout>
