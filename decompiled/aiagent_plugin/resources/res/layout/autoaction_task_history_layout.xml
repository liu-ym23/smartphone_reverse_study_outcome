<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.status.OPageStatus
        android:layout_gravity="center"
        android:id="@+id/lp_empty_state_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:opagestatus_type="status_content"/>
    <com.obric.oui.status.OPageStatus
        android:layout_gravity="center_horizontal"
        android:id="@+id/empty_search"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="260dp"
        app:opagestatus_type="status_content"/>
    <com.obric.autoaction.app.launcherpage.module.view.AutoActionTaskList
        android:id="@+id/lp_task_list"
        android:paddingTop="@dimen/oui_title_bar_mask_height"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:layout_gravity="top"
        android:id="@+id/lp_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_centerTitle="@string/main_menu_history"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oui_widgetFitInsetTop="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/searchbar_container"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">
        <com.obric.oui.searchbar.v2.OSearchBar
            android:id="@+id/searchbar"
            android:layout_width="0dp"
            android:layout_weight="1"
            style="@style/OStyleV2.OSearchBar.Float.S"/>
        <com.obric.oui.button.OIconButtonFloating
            android:id="@+id/cancel_button"
            android:layout_marginStart="8dp"
            app:oui_widgetIcon="@drawable/ic_back"
            style="@style/OStyleV2.OButtonFloating.S.Standard.Icon"/>
    </LinearLayout>
</FrameLayout>
