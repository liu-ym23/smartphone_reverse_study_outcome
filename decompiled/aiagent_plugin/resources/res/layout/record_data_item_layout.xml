<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.layout.OUILinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.oui.sectiontitlebar.OSectionTitleBar
        android:gravity="center_vertical"
        android:id="@+id/section_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        app:sectionTitle_titleText="@string/donation_header_data_list_title"
        style="@style/Subtitle_2_Medium"/>
    <com.obric.oui.layout.OUIConstraintLayout
        android:background="@color/oui_advanced_fill_list_item_card"
        android:paddingTop="17dp"
        android:paddingBottom="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:layout_marginHorizontal="12dp"
        app:oui_radius="16dp">
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_basic_text_1"
            android:id="@+id/step_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Title_1_Regular"/>
        <View
            android:id="0x7f03000f"
            android:background="@color/oui_basic_line_1"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="2px"
            android:layout_marginTop="13dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/step_tv"
            app:layout_constraintTop_toBottomOf="@+id/step_tv"/>
        <com.obric.oui.layout.OUIFrameLayout
            android:id="@+id/screen_img_container"
            android:layout_width="72dp"
            android:layout_height="160dp"
            android:layout_marginTop="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="0x7f03000f"
            app:oui_radius="10dp">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/screen_img"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:shapeAppearanceOverlay="@style/RecordDataItem.ScreenImg"
                app:strokeColor="@color/oui_basic_line_1"
                app:strokeWidth="1dp"/>
            <com.obric.oui.layout.OUIFrameLayout
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="62dp"
                app:oui_radius="17.5dp">
                <ImageView
                    android:id="@+id/app_icon"
                    android:visibility="gone"
                    android:layout_width="35dp"
                    android:layout_height="35dp"/>
            </com.obric.oui.layout.OUIFrameLayout>
        </com.obric.oui.layout.OUIFrameLayout>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_basic_text_1"
            android:ellipsize="end"
            android:id="@+id/thought_tv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/screen_img_container"
            app:layout_constraintTop_toTopOf="@+id/screen_img_container"
            style="@style/Body_1_Regular"/>
        <com.obric.oui.button.OIconButton
            android:id="@+id/modify_btn"
            android:src="@drawable/oic_pen_with_horizontal_line"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/step_tv"
            app:layout_constraintEnd_toStartOf="@+id/delete"
            app:layout_constraintTop_toTopOf="@+id/step_tv"
            style="@style/OStyleV2.OIconButton.S.Trans.Neutral"/>
        <com.obric.oui.button.OIconButton
            android:id="@+id/delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_delete"
            android:tint="@color/oui_red_6"
            app:layout_constraintBottom_toBottomOf="@+id/step_tv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/step_tv"
            style="@style/OStyleV2.OIconButton.S.Trans.Neutral"/>
    </com.obric.oui.layout.OUIConstraintLayout>
</com.obric.oui.layout.OUILinearLayout>
