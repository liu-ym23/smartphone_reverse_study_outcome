<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:background="@drawable/obric_item_bg_no_radius"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp_16"
    android:paddingVertical="@dimen/dp_12">
    <ImageView
        android:id="0x7f03002b"
        android:layout_width="@dimen/assistant_card_dp_36"
        android:layout_height="@dimen/assistant_card_dp_36"
        android:layout_marginTop="@dimen/assistant_card_dp_2"
        android:layout_marginBottom="@dimen/assistant_card_dp_2"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="@dimen/assistant_card_dp_16"
        android:textColor="@color/assistant_card_neutral_100"
        android:id="0x7f0300ea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/assistant_card_dp_12"
        android:layout_toEndOf="0x7f03002b"/>
    <TextView
        android:textSize="@dimen/assistant_card_dp_12"
        android:textColor="@color/assistant_card_neutral_100"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/assistant_card_dp_2"
        android:layout_below="0x7f0300ea"
        android:layout_alignStart="0x7f0300ea"/>
    <Switch
        android:id="@+id/btn_switch_checked"
        android:layout_width="@dimen/assistant_card_dp_52"
        android:layout_height="@dimen/assistant_card_dp_32"
        android:checked="true"
        android:thumb="@drawable/obric_card_item_bg_switch_thumb"
        android:layout_alignTop="0x7f03002b"
        android:layout_alignBottom="0x7f03002b"
        android:track="@drawable/obric_card_item_bg_switch_track"
        android:layout_alignParentEnd="true"/>
    <Switch
        android:id="@+id/btn_switch_unchecked"
        android:layout_width="@dimen/assistant_card_dp_52"
        android:layout_height="@dimen/assistant_card_dp_32"
        android:checked="false"
        android:thumb="@drawable/obric_card_item_bg_switch_thumb"
        android:layout_alignTop="0x7f03002b"
        android:layout_alignBottom="0x7f03002b"
        android:track="@drawable/obric_card_item_bg_switch_track"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
