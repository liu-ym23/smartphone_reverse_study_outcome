<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.layout.OUIConstraintLayout
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="0x7f03002b"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/oic_hand_right_ai_fill"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/oui_basic_text_1"
            android:gravity="center"
            android:id="0x7f0300ea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/obric_input_window_title"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="0x7f03002b"
            style="@style/Title_Title_M"/>
        <ScrollView
            android:id="@+id/contentScroll"
            android:scrollbars="none"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="22dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxHeight="96dp"
            android:requiresFadingEdge="vertical"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintHeight_max="96dp"
            app:layout_constraintTop_toBottomOf="0x7f0300ea">
            <TextView
                android:gravity="center"
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Title_Title_M_Thick"/>
        </ScrollView>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/contentScroll">
            <com.obric.autoaction.presentation.view.PrefixLabelEditText
                android:id="@+id/input_content"
                android:background="@drawable/global_query_input_stroke"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="54dp"
                android:layout_marginHorizontal="12dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="9dp"
                app:layout_constraintEnd_toStartOf="@+id/send_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.obric.oui.button.OButton
                android:id="@+id/cancel_button"
                android:layout_width="0dp"
                android:layout_marginTop="16dp"
                android:text="取消"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintEnd_toStartOf="@+id/send_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/input_content"
                style="@style/OButton.L1.Standard.Neutral"/>
            <com.obric.oui.button.OButton
                android:id="@+id/send_button"
                android:background="@drawable/auto_task_send_enable"
                android:layout_width="0dp"
                android:layout_marginTop="16dp"
                android:text="完成"
                android:layout_marginEnd="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/cancel_button"
                app:layout_constraintTop_toBottomOf="@+id/input_content"
                style="@style/OButton.L1.Standard.Primary"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.obric.oui.layout.OUIConstraintLayout>
</FrameLayout>
