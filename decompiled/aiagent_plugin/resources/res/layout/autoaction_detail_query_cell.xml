<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_basic_text_3"
        android:id="@+id/detail_query_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/condition_event_desc"
        android:layout_marginStart="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/event_detail_title_bar"
        style="@style/Subtitle_2_Medium"/>
    <com.obric.autoaction.app.launcherpage.ui.NestedScrollableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/detail_query_input_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:ocardlistitem_cardPosition="position_single"
            app:ocardlistitem_cardType="type_container"/>
    </com.obric.autoaction.app.launcherpage.ui.NestedScrollableLayout>
</LinearLayout>
