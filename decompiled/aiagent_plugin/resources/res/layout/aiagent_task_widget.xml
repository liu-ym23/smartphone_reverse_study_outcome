<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_layout"
    android:background="@drawable/widget_bg_waiting"
    android:layout_width="312dp"
    android:layout_height="144dp">
    <ImageView
        android:id="@+id/title_line_end_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="22dp"
        android:src="@drawable/ic_widget_waiting"
        android:layout_marginEnd="22dp"
        android:layout_alignParentEnd="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/title_and_description_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_alignParentTop="true"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/title_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="0x7f03002b"
                android:layout_width="23dp"
                android:layout_height="32dp"
                android:src="@drawable/widget_text_ai"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:textColor="#d9000000"
                android:ellipsize="end"
                android:id="0x7f0300ea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="220dp"
                android:text="@string/obric_widget_title"
                android:maxLines="1"
                style="@style/Title_Title_L"/>
            <TextView
                android:textColor="#4d000000"
                android:ellipsize="end"
                android:id="@+id/widget_deprecated"
                android:background="@drawable/bg_widget_deprecated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="220dp"
                android:text="@string/obric_widget_deprecated_notice"
                android:maxLines="1"
                android:layout_marginStart="7dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                style="@style/Label_S"/>
        </LinearLayout>
        <TextView
            android:textColor="#ffa64d"
            android:ellipsize="end"
            android:id="@+id/line_text_primary"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/obric_widget_wait_in_line"
            android:maxLines="2"
            android:layout_below="@+id/title_layout"
            android:layout_centerHorizontal="true"
            style="@style/Label_M"/>
        <TextView
            android:textColor="#73000000"
            android:gravity="center"
            android:id="@+id/line_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/obric_widget_wait_in_line_deprecated"
            android:layout_below="@+id/title_layout"
            android:layout_centerHorizontal="true"
            style="@style/Label_S_Thin"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/task_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:layout_alignParentBottom="true">
        <RelativeLayout
            android:gravity="center"
            android:id="@+id/publish_task_button"
            android:background="@drawable/bg_button_gradient_round"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/widget_text_publish"
                android:layout_alignParentStart="true"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_widget_publish_arrow"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/timer_task_button"
            android:background="@drawable/widget_timer_btn_bg"
            android:clickable="true"
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"/>
        <TextView
            android:textColor="#d9000000"
            android:gravity="center"
            android:id="@+id/cancel_task_button"
            android:background="@drawable/bg_button_gradient_round_grey"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/obric_widget_cancel_task"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            style="@style/Body_M_Thick"/>
        <RelativeLayout
            android:id="@+id/task_query_group"
            android:background="@drawable/bg_query_gradient_round"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="18dp">
            <TextView
                android:textColor="#ffa64d"
                android:ellipsize="end"
                android:id="@+id/task_query_group_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@+id/task_query_group_icon"
                android:layout_alignParentStart="true"
                style="@style/Body_M_Thick"/>
            <ImageView
                android:id="@+id/task_query_group_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_widget_arrow_right"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
