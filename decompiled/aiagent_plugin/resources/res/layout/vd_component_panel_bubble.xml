<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_root"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    android:minWidth="48dp">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/bubble_content"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingStart="13dp"
        android:paddingEnd="16dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/bubble_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null"/>
        <com.obric.oui.text.OTextView
            android:textSize="16sp"
            android:textColor="@color/oui_basic_text_1"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/bubble_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="6dp"
            android:textFontWeight="500"/>
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/bubble_trailing_button"
            android:background="@android:color/transparent"
            android:padding="0dp"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="center"
            android:contentDescription="@null"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/bubble_top_handle"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="24dp"
        android:layout_height="10dp"
        android:importantForAccessibility="no">
        <View
            android:id="@+id/bubble_top_handle_line_top"
            android:background="@drawable/vd_collapsed_panel_handle_line"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="16dp"
            android:layout_height="1.5dp"
            android:layout_marginTop="4dp"
            android:alpha="0.06"
            android:importantForAccessibility="no"
            android:layout_marginStart="4dp"/>
        <View
            android:id="@+id/bubble_top_handle_line_bottom"
            android:background="@drawable/vd_collapsed_panel_handle_line"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="16dp"
            android:layout_height="1.5dp"
            android:layout_marginTop="7dp"
            android:alpha="0.06"
            android:importantForAccessibility="no"
            android:layout_marginStart="4dp"/>
    </FrameLayout>
</FrameLayout>
