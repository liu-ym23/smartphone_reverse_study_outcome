<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.bouncelayout.OScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/skill_form_scroll"
    android:scrollbars="none"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:isScrollContainer="true">
    <com.obric.oui.layout.OUILinearLayout
        android:orientation="vertical"
        android:id="@+id/skill_form_content"
        android:paddingTop="18dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <com.obric.oui.layout.OUIFrameLayout
            android:id="@+id/skill_form_icon_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="108dp">
            <com.obric.oui.layout.OUIFrameLayout
                android:layout_gravity="center"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="72dp"
                android:layout_height="72dp">
                <com.obric.oui.layout.OUIFrameLayout
                    android:id="@+id/skill_form_icon_box"
                    android:background="@color/oui_advanced_fill_list_item_card"
                    android:focusable="true"
                    android:clickable="true"
                    android:clipChildren="true"
                    android:clipToPadding="true"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:outlineProvider="background"
                    android:clipToOutline="true"
                    app:oui_layout_borderColor="@color/oui_basic_line_1"
                    app:oui_layout_borderWidth="0.6dp"
                    app:oui_radius="20dp">
                    <com.facebook.drawee.view.SimpleDraweeView
                        android:id="@+id/skill_form_cover"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <ImageView
                        android:id="@+id/skill_form_placeholder_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/skill_default_logo"
                        android:scaleType="fitXY"/>
                </com.obric.oui.layout.OUIFrameLayout>
                <com.obric.oui.layout.OUIFrameLayout
                    android:layout_gravity="end|bottom"
                    android:id="@+id/skill_form_icon_add"
                    android:background="@color/oui_accent_6_bg"
                    android:clipChildren="true"
                    android:clipToPadding="true"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginBottom="-6dp"
                    android:layout_marginEnd="-6dp"
                    android:outlineProvider="background"
                    android:clipToOutline="true"
                    app:oui_radius="12dp">
                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/skill_ic_create_form_plus"/>
                </com.obric.oui.layout.OUIFrameLayout>
                <FrameLayout
                    android:gravity="center"
                    android:layout_gravity="start|top"
                    android:id="@+id/skill_form_icon_edit_target"
                    android:focusable="true"
                    android:visibility="gone"
                    android:clickable="true"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="42dp"
                    android:layout_marginStart="42dp">
                    <com.obric.oui.layout.OUIFrameLayout
                        android:layout_gravity="center"
                        android:id="@+id/skill_form_icon_edit"
                        android:background="@color/oui_functional_graphite_5"
                        android:focusable="false"
                        android:clickable="false"
                        android:clipChildren="true"
                        android:clipToPadding="true"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:outlineProvider="background"
                        android:clipToOutline="true"
                        app:oui_radius="12dp">
                        <ImageView
                            android:layout_gravity="center"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/skill_ic_create_form_edit"/>
                    </com.obric.oui.layout.OUIFrameLayout>
                </FrameLayout>
            </com.obric.oui.layout.OUIFrameLayout>
        </com.obric.oui.layout.OUIFrameLayout>
        <com.obric.oui.layout.OUIFrameLayout
            android:id="@+id/skill_form_file_after_cover"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_basic_text_3"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:text="@string/obric_skill_form_name_label"
            android:paddingStart="20dp"
            android:paddingEnd="12dp"
            style="@style/Subtitle_2_Medium"/>
        <com.obric.oui.layout.OUIFrameLayout
            android:background="@color/oui_advanced_fill_list_item_card"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:oui_radius="20dp">
            <com.obric.oui.forms.OInputLayout
                android:id="@+id/skill_form_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:inputType="text"
                app:oinput_hint="@string/obric_skill_form_name_hint"
                app:oinput_limitCount="30"
                app:oinput_showInputBackground="false"
                app:oinput_showLabel="false"
                app:oinput_showLimit="true"
                app:oinput_type="0"/>
        </com.obric.oui.layout.OUIFrameLayout>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_basic_text_3"
            android:gravity="center_vertical"
            android:id="@+id/skill_form_description_label"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:text="@string/obric_skill_form_description_label"
            android:paddingStart="20dp"
            android:paddingEnd="12dp"
            style="@style/Subtitle_2_Medium"/>
        <com.obric.oui.layout.OUIFrameLayout
            android:background="@color/oui_advanced_fill_list_item_card"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:oui_radius="20dp">
            <com.obric.oui.forms.OInputLayout
                android:id="@+id/skill_form_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                app:oinput_autoChangeWithLimit="true"
                app:oinput_hint="示例：支持交互设计师处理交互规范、专项优化、团队知识库、设计评审、重点业务需求、用户反馈和行业新闻分析。"
                app:oinput_limitCount="300"
                app:oinput_maxHeight="206dp"
                app:oinput_minHeight="86dp"
                app:oinput_showInputBackground="false"
                app:oinput_showLabel="false"
                app:oinput_showLimit="true"
                app:oinput_showTip="false"
                app:oinput_tip="超出字数上限"
                app:oinput_type="1"/>
        </com.obric.oui.layout.OUIFrameLayout>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_basic_text_3"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:text="@string/obric_skill_form_body_label"
            android:paddingStart="20dp"
            android:paddingEnd="12dp"
            style="@style/Subtitle_2_Medium"/>
        <com.obric.oui.layout.OUIFrameLayout
            android:background="@color/oui_advanced_fill_list_item_card"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:oui_radius="20dp">
            <com.obric.oui.forms.OInputLayout
                android:id="@+id/skill_form_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                app:oinput_hint="用于指导模型调用了该技能时，按照什么样的流程和说明来执行"
                app:oinput_maxHeight="224dp"
                app:oinput_minHeight="104dp"
                app:oinput_showInputBackground="false"
                app:oinput_showLabel="false"
                app:oinput_showLimit="false"
                app:oinput_type="1"/>
        </com.obric.oui.layout.OUIFrameLayout>
        <com.obric.oui.layout.OUIFrameLayout
            android:id="@+id/skill_form_file_after_body"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>
        <Space
            android:id="@+id/skill_form_ime_scroll_spacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
    </com.obric.oui.layout.OUILinearLayout>
</com.obric.oui.bouncelayout.OScrollView>
