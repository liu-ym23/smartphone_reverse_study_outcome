<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.layout.OUILinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/oui_fill_list_item_card"
    android:paddingTop="16dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp">
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_3"
            android:id="@+id/txt_tli_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Label_M"/>
        <View
            android:id="@+id/sep_bef_tli_duration"
            android:background="@color/oui_line_2"
            android:layout_width="1dp"
            android:layout_height="10dp"
            android:layout_marginHorizontal="8dp"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_3"
            android:id="@+id/txt_tli_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Label_M"/>
    </LinearLayout>
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_text_1"
        android:id="@+id/txt_tli_task_query"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:layout_marginHorizontal="4dp"
        style="@style/Title_Title_M"/>
    <com.obric.autoaction.app.launcherpage.module.view.StarStripView
        android:id="@+id/star_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="12dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <com.obric.oui.button.OButton
            android:id="@+id/btn_history"
            android:text="@string/repeat_task_management_cell_history"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/OButton.M1.Standard.Neutral"/>
        <com.obric.oui.oswitch.OSwitch
            android:id="@+id/btn_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.obric.oui.layout.OUILinearLayout>
