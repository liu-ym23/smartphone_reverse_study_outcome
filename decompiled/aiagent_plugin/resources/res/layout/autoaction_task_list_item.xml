<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/task_view_root_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="16dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/first_line_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="4dp"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_1"
            android:ellipsize="end"
            android:id="0x7f0300ea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:maxLines="2"
            android:layout_marginHorizontal="4dp"
            style="@style/Title_1_Regular"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_3"
            android:ellipsize="end"
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="2"
            android:layout_marginHorizontal="4dp"
            style="@style/Subtitle_2_Regular"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <com.obric.oui.button.OIconButton
                android:id="@+id/btn_tli_task_feedback"
                android:src="@drawable/o_ic_feedback"
                android:paddingHorizontal="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/OStyleV2.OIconButton.S.Standard.Neutral"/>
            <com.obric.oui.button.OIconButton
                android:id="@+id/btn_tli_task_share"
                android:src="@drawable/oic_rectangle_portrait_arrowtriangle_up"
                android:text="@string/task_cell_btn_share"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/btn_tli_task_feedback"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/OStyleV2.OIconButton.S.Standard.Neutral"/>
            <com.obric.oui.button.OButton
                android:id="@+id/btn_tli_task_relaunch"
                android:text="@string/tli_action_relaunch_task"
                android:drawableLeft="@drawable/oic_arrowtriangle_2_refresh_rotate_45_new"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/OStyleV2.OButton.S.Standard.Neutral"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</RelativeLayout>
