<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/BGPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OCTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/oui_title_bar_height"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:oui_title_text="个人画像查询"
        app:oui_useBackIcon="true"/>
    <com.obric.oui.layout.OUILinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar">
        <com.obric.oui.layout.OUILinearLayout
            android:orientation="vertical"
            android:background="@color/oui_blueish_gray_1"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:oui_radius="16dp">
            <com.obric.oui.text.OTextView
                android:textColor="@color/TextPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="�� 查询内容"
                style="@style/Label_M"/>
            <com.obric.oui.forms.OInputView
                android:id="@+id/input_query"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="请输入您想查询的个人画像内容..."
                android:maxLines="3"
                android:minLines="2"
                android:inputType="textMultiLine"
                app:oui_inputHeight="80dp"
                app:oui_inputMode="text"
                app:oui_inputSingleLine="false"
                app:oui_showLabel="false"/>
            <com.obric.oui.button.OButton
                android:id="@+id/btn_search"
                android:layout_width="match_parent"
                android:text="�� 开始查询"
                style="@style/OButton.M2.Standard.Primary"/>
        </com.obric.oui.layout.OUILinearLayout>
        <com.obric.oui.layout.OUILinearLayout
            android:orientation="vertical"
            android:background="@color/oui_blueish_gray_1"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:oui_radius="16dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">
                <com.obric.oui.text.OTextView
                    android:textColor="@color/TextPrimary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="�� 查询结果"
                    android:layout_weight="1"
                    style="@style/Label_M"/>
                <com.obric.oui.text.OTextView
                    android:textColor="@color/oui_text_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="长按可复制"
                    style="@style/Label_S"/>
            </LinearLayout>
            <ScrollView
                android:id="@+id/scroll_result"
                android:background="@color/oui_blueish_gray_3"
                android:padding="12dp"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <com.obric.oui.text.OTextView
                    android:textColor="@color/TextSecondary"
                    android:id="@+id/tv_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="暂无查询结果，请输入查询内容并点击查询按钮"
                    android:lineSpacingMultiplier="1.2"
                    android:textIsSelectable="true"
                    style="@style/Body_M"/>
            </ScrollView>
        </com.obric.oui.layout.OUILinearLayout>
        <com.obric.oui.button.OButton
            android:id="@+id/btn_generate"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_marginTop="16dp"
            android:text="�� AI智能分析"
            style="@style/OButton.M2.Standard.Primary_Light"/>
    </com.obric.oui.layout.OUILinearLayout>
    <FrameLayout
        android:id="@+id/progress_container"
        android:background="#80000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/progress_bar"
                android:layout_width="48dp"
                android:layout_height="48dp"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/TextPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="正在处理中..."
                style="@style/Label_M"/>
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
