<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/query_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ocardlistitem_defaultTailIcon="tail_arrow"
        app:ocardlistitem_showSubTitle="true"
        app:ocardlistitem_showTailIcon="true"
        app:ocardlistitem_titleColor="@color/oui_text_1"/>
    <com.obric.oui.sectiontitlebar.OSectionSupportiveText
        android:id="@+id/bottom_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        app:section_des_text="@string/auto_event_task_tips"/>
</LinearLayout>
