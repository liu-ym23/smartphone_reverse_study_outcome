<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.layout.OUIFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/skill_management_root"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/my_content"
        android:background="@color/oui_basic_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/my_body"
            android:background="@color/oui_basic_bg_base_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <com.obric.oui.orecyclerview.widget.RecyclerView
                android:id="@+id/my_list"
                android:paddingTop="64dp"
                android:paddingBottom="68dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.obric.oui.status.OPageStatus
                android:layout_gravity="center"
                android:id="@+id/my_empty"
                android:visibility="gone"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:translationY="10dp"
                app:opagestatus_title="@string/obric_skill_management_empty"
                app:opagestatus_type="status_content"/>
        </FrameLayout>
    </LinearLayout>
    <com.obric.oui.blur.OBlurMaskView
        android:id="@+id/my_top_mask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oBlurMask_blurRadius="8"
        app:oBlurMask_defaultMaskBackground="true"
        app:oui_widgetBlurType="1"
        app:oui_widgetFitInsetTop="true">
        <com.obric.oui.titlebar.OFloatingTitleBar
            android:id="@+id/my_title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:oFloatingTitleBar_centerTitle=""
            app:oFloatingTitleBar_maskBlurRadius="0"/>
    </com.obric.oui.blur.OBlurMaskView>
    <com.obric.oui.button.OIconButtonFloating
        android:layout_gravity="end|bottom"
        android:id="@+id/my_create"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="20dp"
        android:contentDescription="@string/obric_skill_common_create"
        android:layout_marginEnd="20dp"
        app:oui_widgetEnableMaterial="true"
        app:oui_widgetIcon="@drawable/skill_ic_add"
        app:oui_widgetRadius="24dp"
        style="@style/OStyleV2.OButtonFloating.M.Primary.Icon"/>
</com.obric.oui.layout.OUIFrameLayout>
