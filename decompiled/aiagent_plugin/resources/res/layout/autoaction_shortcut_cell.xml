<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.lisitem.OUICardConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_launcherpage_instruction_card"
    android:paddingTop="12dp"
    android:paddingBottom="16dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    app:oui_shadowCornerRadius="20dp">
    <ImageView
        android:id="@+id/semantic_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="2dp"
        android:src="@drawable/oic_text_a_circle_fill"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.obric.oui.button.OIconButton
        android:id="@+id/play"
        android:background="@drawable/bg_launcherpage_instruction_icon"
        android:padding="8dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/oic_player_triangle_right_fill"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:oui_radius="99dp"
        style="@style/OStyleV2.OIconButton.S.Standard.Neutral"/>
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_basic_text_1"
        android:ellipsize="end"
        android:id="0x7f0300ea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/play"
        style="@style/Title_1_Regular"/>
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_basic_text_3"
        android:ellipsize="end"
        android:id="@+id/sub_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="0x7f0300ea"
        style="@style/Subtitle_2_Regular"/>
</com.obric.oui.lisitem.OUICardConstraintLayout>
