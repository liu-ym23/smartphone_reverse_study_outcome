<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/skill_extension_settings_root"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_container"
        android:paddingTop="@dimen/oui_title_bar_mask_height"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/skill_extension_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:ocardlistitem_defaultCustomEnd="end_switch"
            app:ocardlistitem_showCustomEnd="true"
            app:ocardlistitem_title="@string/obric_skill_extension_item_title"/>
        <com.obric.oui.sectiontitlebar.OSectionTitleBar
            android:id="@+id/open_app_management_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="24dp"
            app:sectionTitle_titleText="@string/obric_skill_open_app_management_title"
            style="@style/OSectionTitleBar.S"/>
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/open_app_management_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ocardlistitem_cardPosition="position_single"
            app:ocardlistitem_defaultTailIcon="tail_arrow"
            app:ocardlistitem_icon="@drawable/feishu_icon"
            app:ocardlistitem_showIcon="true"
            app:ocardlistitem_showSubTitle="true"
            app:ocardlistitem_showTailIcon="true"
            app:ocardlistitem_subTitle="@string/obric_skill_open_app_feishu_subtitle"
            app:ocardlistitem_title="@string/obric_skill_open_app_feishu_title"/>
        <com.obric.oui.sectiontitlebar.OSectionTitleBar
            android:id="@+id/shell_management_title"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="24dp"
            app:sectionTitle_titleText="@string/obric_skill_shell_management_section_title"
            style="@style/OSectionTitleBar.S"/>
        <com.obric.oui.lisitem.OCardListItem
            android:id="@+id/shell_management_item"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:ocardlistitem_cardPosition="position_single"
            app:ocardlistitem_defaultTailIcon="tail_arrow"
            app:ocardlistitem_showSubTitle="false"
            app:ocardlistitem_showTailIcon="true"
            app:ocardlistitem_title="@string/obric_skill_shell_management_entry_title"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/unavailable_state_container"
        android:background="@color/oui_basic_bg_base_1"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_basic_text_3"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/unavailable_state_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/obric_skill_extension_unavailable"
            style="@style/Title_3_Bold"/>
    </FrameLayout>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:layout_gravity="top"
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_centerTitle="@string/obric_skill_extension_settings_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oui_widgetFitInsetTop="true"/>
</FrameLayout>
