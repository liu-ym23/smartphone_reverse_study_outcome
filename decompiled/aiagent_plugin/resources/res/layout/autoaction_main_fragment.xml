<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.obric.autoaction.app.launcherpage.widget.OAutoTipContainer
        android:id="@+id/tip_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="88dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:oui_shadowCornerRadius="99dp"
        app:oui_shadow_style="@style/OUIShadow.Oui_Shadow_Thick"/>
    <com.obric.oui.segmentedtab.OBottomNavigationBar
        android:id="@+id/bottom_tab_layout"
        android:visibility="visible"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bar_color="@color/oui_basic_bg_base_3_high_elevation"
        app:bar_stroke_color="@color/Transparent"
        app:indicator_anim_enable="true"
        app:indicator_color="@color/oui_fill_element_2"
        app:indicator_corner_radius="@dimen/oui_r_m2"
        app:indicator_height="56dp"
        app:indicator_spacing="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:mask_blur_radius="36dp"
        app:oui_widgetBlurRadius="8"
        app:oui_widgetFitInsetBottom="true"
        app:shadow_normal="@style/OStyleV2.OButtonFloatingShadowStyleNormal"
        app:shadow_pressed="@style/OStyleV2.OButtonFloatingShadowStylePressed"
        app:tab_textSelectColor="@color/oui_text_1"
        app:tab_textSize="10sp"
        app:tab_textUnselectColor="@color/oui_text_3b"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_startTitle="@string/launcher_page_main_fragment_title"
        app:oui_widgetFitInsetTop="true"/>
</androidx.constraintlayout.widget.ConstraintLayout>
