<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.layout.OUIFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/skill_search_root"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/skill_search_body"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.obric.oui.orecyclerview.widget.RecyclerView
            android:id="@+id/skill_search_list"
            android:paddingTop="64dp"
            android:paddingBottom="32dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.obric.oui.status.OPageStatus
            android:layout_gravity="center"
            android:id="@+id/skill_search_empty"
            android:paddingTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:opagestatus_message="搜索技能"
            app:opagestatus_title="输入关键词搜索"
            app:opagestatus_type="status_content"/>
    </FrameLayout>
    <com.obric.oui.blur.OBlurMaskView
        android:id="@+id/skill_search_top_mask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oBlurMask_blurRadius="8"
        app:oBlurMask_defaultMaskBackground="true"
        app:oui_widgetBlurType="1"
        app:oui_widgetFitInsetTop="true">
        <com.obric.oui.titlebar.OFloatingTitleBar
            android:id="@+id/skill_search_title_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:oFloatingTitleBar_centerTitle=""
            app:oFloatingTitleBar_maskBlurRadius="0"/>
        <com.obric.oui.searchbar.v2.OSearchBar
            android:layout_gravity="start|center_vertical"
            android:id="@+id/skill_search_bar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="@string/obric_skill_search_hint"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="60dp"
            style="@style/OStyleV2.OSearchBar.Default.S"/>
    </com.obric.oui.blur.OBlurMaskView>
</com.obric.oui.layout.OUIFrameLayout>
