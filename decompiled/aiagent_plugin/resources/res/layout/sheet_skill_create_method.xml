<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.layout.OUILinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/create_skill_method_sheet"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/create_skill_method_import_file"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ocardlistitem_cardPosition="position_top"
        app:ocardlistitem_cardType="type_large"
        app:ocardlistitem_defaultTailIcon="tail_arrow"
        app:ocardlistitem_icon="@drawable/skill_ic_create_file"
        app:ocardlistitem_showCardBg="true"
        app:ocardlistitem_showDivider="false"
        app:ocardlistitem_showIcon="true"
        app:ocardlistitem_showSubTitle="true"
        app:ocardlistitem_showTailIcon="true"
        app:ocardlistitem_showTitle="true"
        app:ocardlistitem_subTitle="@string/obric_skill_create_method_import_file_description"
        app:ocardlistitem_title="@string/obric_skill_create_method_import_file_title"/>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/create_skill_method_import_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ocardlistitem_cardPosition="position_middle"
        app:ocardlistitem_cardType="type_large"
        app:ocardlistitem_defaultTailIcon="tail_arrow"
        app:ocardlistitem_icon="@drawable/skill_ic_create_link"
        app:ocardlistitem_showCardBg="true"
        app:ocardlistitem_showDivider="false"
        app:ocardlistitem_showIcon="true"
        app:ocardlistitem_showSubTitle="true"
        app:ocardlistitem_showTailIcon="true"
        app:ocardlistitem_showTitle="true"
        app:ocardlistitem_subTitle="@string/obric_skill_create_method_import_link_description"
        app:ocardlistitem_title="@string/obric_skill_create_method_import_link_title"/>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/create_skill_method_custom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ocardlistitem_cardPosition="position_bottom"
        app:ocardlistitem_cardType="type_large"
        app:ocardlistitem_defaultTailIcon="tail_arrow"
        app:ocardlistitem_icon="@drawable/skill_ic_create_custom"
        app:ocardlistitem_showCardBg="true"
        app:ocardlistitem_showDivider="false"
        app:ocardlistitem_showIcon="true"
        app:ocardlistitem_showSubTitle="true"
        app:ocardlistitem_showTailIcon="true"
        app:ocardlistitem_showTitle="true"
        app:ocardlistitem_subTitle="@string/obric_skill_create_method_custom_description"
        app:ocardlistitem_title="@string/obric_skill_create_method_custom_title"/>
</com.obric.oui.layout.OUILinearLayout>
