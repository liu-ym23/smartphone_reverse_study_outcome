<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shadow"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.obric.oui.layout.OUIConstraintLayout
        android:id="@+id/popup_root"
        android:background="@drawable/vd_component_app_history_popup_bg"
        android:paddingTop="8dp"
        android:paddingBottom="19dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:oui_radius="20dp">
        <com.obric.oui.text.OTextView
            android:textSize="12sp"
            android:textColor="@color/oui_basic_text_3"
            android:ellipsize="end"
            android:id="@+id/popup_title"
            android:padding="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textFontWeight="400"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/popup_divider"
            android:background="@color/oui_basic_line_1"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/popup_title"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/popup_list_recycler"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:overScrollMode="never"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_max="316dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/popup_divider"/>
    </com.obric.oui.layout.OUIConstraintLayout>
</FrameLayout>
