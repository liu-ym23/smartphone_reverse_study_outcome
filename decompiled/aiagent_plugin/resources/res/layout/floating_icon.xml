<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/floating_icon_layout"
        android:background="@drawable/floating_bg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.obric.oui.avatar.OCircleImageView
            android:layout_gravity="center"
            android:id="0x7f03002b"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/float_expand_icon"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/expanded_content"
        android:background="@drawable/float_expanded_status_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="46dp"
        android:paddingEnd="46dp">
        <com.obric.oui.avatar.OCircleImageView
            android:id="@+id/icon_expanded"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/float_expand_icon"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/oui_basic_text_0"
            android:id="@+id/expanded_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_floating_expand_init"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</FrameLayout>
