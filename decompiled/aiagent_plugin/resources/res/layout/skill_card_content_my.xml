<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.layout.OUIConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/skill_item_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="72dp">
    <com.obric.oui.layout.OUIFrameLayout
        android:id="@+id/skill_icon_box"
        android:background="@color/oui_advanced_fill_list_item_card"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:oui_layout_borderColor="@color/oui_basic_line_1"
        app:oui_layout_borderWidth="0.6dp"
        app:oui_radius="14dp">
        <com.facebook.drawee.view.SimpleDraweeView
            android:id="@+id/skill_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.obric.oui.layout.OUIFrameLayout>
    <com.obric.oui.layout.OUILinearLayout
        android:orientation="vertical"
        android:id="@+id/skill_texts"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/skill_switch_container"
        app:layout_constraintStart_toEndOf="@+id/skill_icon_box"
        app:layout_constraintTop_toTopOf="parent">
        <com.obric.oui.text.OTextView
            android:textSize="16sp"
            android:textColor="@color/oui_basic_text_1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/skill_name"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:maxLines="1"
            style="@style/Subtitle_2_Regular"/>
        <com.obric.oui.text.OTextView
            android:textSize="12sp"
            android:textColor="@color/oui_basic_text_3"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/skill_description"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            style="@style/Label_S"/>
        <com.obric.oui.layout.OUILinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/skill_source_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:minHeight="14dp">
            <com.obric.oui.layout.OUIFrameLayout
                android:id="@+id/skill_source_avatar_box"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:layout_width="14dp"
                android:layout_height="14dp"
                app:oui_layout_borderColor="@color/oui_basic_line_1"
                app:oui_layout_borderWidth="0.3dp"
                app:oui_radius="7dp">
                <com.facebook.drawee.view.SimpleDraweeView
                    android:id="@+id/skill_source_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.obric.oui.layout.OUIFrameLayout>
            <com.obric.oui.text.OTextView
                android:textSize="10sp"
                android:textColor="@color/oui_basic_text_3"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/skill_source"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                style="@style/Label_S"/>
        </com.obric.oui.layout.OUILinearLayout>
    </com.obric.oui.layout.OUILinearLayout>
    <com.obric.oui.layout.OUIFrameLayout
        android:id="@+id/skill_switch_container"
        android:layout_width="52dp"
        android:layout_height="0dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.obric.oui.oswitch.OSwitch
            android:layout_gravity="center"
            android:id="@+id/skill_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:id="@+id/skill_switch_guard"
            android:background="@android:color/transparent"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.obric.oui.layout.OUIFrameLayout>
</com.obric.oui.layout.OUIConstraintLayout>
