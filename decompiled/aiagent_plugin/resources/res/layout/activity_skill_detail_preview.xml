<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.layout.OUIFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/skill_detail_preview_root"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.layout.OUIFrameLayout
        android:id="@+id/detail_page"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.obric.oui.bouncelayout.OScrollView
            android:id="@+id/detail_scroll"
            android:paddingBottom="118dp"
            android:visibility="gone"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <com.obric.oui.layout.OUILinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/detail_content"
                android:paddingBottom="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.obric.oui.header.HeaderInfoView
                        android:id="@+id/skill_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <com.obric.oui.layout.OUIFrameLayout
                        android:layout_gravity="top|center_horizontal"
                        android:background="@color/oui_advanced_fill_list_item_card"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_marginTop="120dp"
                        app:oui_layout_borderColor="@color/oui_basic_line_1"
                        app:oui_layout_borderWidth="0.6dp"
                        app:oui_radius="20dp">
                        <com.obric.oui.layout.OUIFrameLayout
                            android:layout_gravity="center"
                            android:clipChildren="true"
                            android:clipToPadding="true"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:oui_radius="20dp">
                            <com.facebook.drawee.view.SimpleDraweeView
                                android:layout_gravity="center"
                                android:id="@+id/skill_icon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:importantForAccessibility="no"/>
                        </com.obric.oui.layout.OUIFrameLayout>
                    </com.obric.oui.layout.OUIFrameLayout>
                </FrameLayout>
                <com.obric.oui.text.OTextView
                    android:textSize="14sp"
                    android:textColor="@color/oui_basic_text_1"
                    android:gravity="start"
                    android:id="@+id/skill_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/skill_detail_description_section_spacing"
                    android:lineSpacingMultiplier="1.6"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    style="@style/Body_1_Regular"/>
                <com.obric.aiagent.skill.manager.impl.ui.SkillDescriptionMarkdownView
                    android:id="@+id/skill_description_markdown"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/skill_detail_description_section_spacing"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="16dp"/>
                <com.obric.oui.text.OTextView
                    android:textColor="@color/oui_basic_text_3"
                    android:id="@+id/skill_related_info"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    style="@style/Label_L"/>
                <com.obric.oui.text.OTextView
                    android:textColor="@color/oui_basic_text_3"
                    android:id="@+id/skill_security_info"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    style="@style/Label_L"/>
                <com.obric.oui.sectiontitlebar.OSectionTitleBar
                    android:id="@+id/example_section_title"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="@dimen/skill_detail_description_section_spacing"
                    android:paddingStart="20dp"
                    android:paddingEnd="12dp"
                    app:sectionTitle_titleText="@string/obric_skill_common_usage_examples"
                    style="@style/OSectionTitleBar.M"/>
                <com.obric.oui.layout.OUILinearLayout
                    android:orientation="vertical"
                    android:id="@+id/example_list"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"/>
            </com.obric.oui.layout.OUILinearLayout>
        </com.obric.oui.bouncelayout.OScrollView>
        <com.obric.oui.status.OPageStatus
            android:layout_gravity="center"
            android:id="@+id/detail_loading_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:opagestatus_loadingResult="@string/obric_skill_detail_loading_description"
            app:opagestatus_showLoading="true"
            app:opagestatus_type="vertical_loading"/>
        <com.obric.oui.blur.OBlurMaskView
            android:id="@+id/detail_top_mask"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:oBlurMask_blurRadius="8"
            app:oBlurMask_defaultMaskBackground="true"
            app:oui_widgetBlurType="1"
            app:oui_widgetFitInsetTop="true">
            <com.obric.oui.titlebar.OFloatingTitleBar
                android:id="@+id/detail_title_bar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                app:oFloatingTitleBar_centerTitle=""
                app:oFloatingTitleBar_maskBlurRadius="0"/>
        </com.obric.oui.blur.OBlurMaskView>
        <com.obric.oui.actionbar.v2.OBottomActionBarNormalHorizontal
            android:layout_gravity="bottom"
            android:id="@+id/detail_bottom_bar"
            android:background="@color/oui_basic_bg_base_1"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:oui_widgetFitInsetBottom="true"/>
    </com.obric.oui.layout.OUIFrameLayout>
</com.obric.oui.layout.OUIFrameLayout>
