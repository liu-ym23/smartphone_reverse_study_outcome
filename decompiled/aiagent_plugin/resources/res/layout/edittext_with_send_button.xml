<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.layout.OUIConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/input_layout"
    android:background="@color/black_6"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginTop="28dp"
    android:layout_marginRight="16dp"
    android:layout_marginBottom="16dp"
    android:minHeight="48dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/title_layout"
    app:oui_radius="16dp">
    <EditText
        android:textSize="14sp"
        android:textColor="@color/oui_basic_text_1"
        android:textColorHighlight="@color/autoaction_task_input_window_selection"
        android:textColorHint="@color/oui_basic_text_4"
        android:id="@+id/input_text"
        android:background="@android:color/transparent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/auto_create_task_hint"
        android:maxLines="3"
        android:textSelectHandleLeft="@color/autoaction_task_input_window_cursor"
        android:textSelectHandleRight="@color/autoaction_task_input_window_cursor"
        android:textCursorDrawable="@drawable/global_input_window_text_cursor"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/send_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.obric.oui.button.OIconButton
        android:id="@+id/send_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:src="@drawable/ai_send_icon"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</com.obric.oui.layout.OUIConstraintLayout>
