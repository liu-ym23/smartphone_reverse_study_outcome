<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_basic_text_3"
        android:id="@+id/detail_model_extra_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginVertical="8dp"
        style="@style/Subtitle_2_Medium"/>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/detail_model_select_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ocardlistitem_defaultCustomEnd="end_detail"
        app:ocardlistitem_showCustomEnd="true"
        app:ocardlistitem_showTailIcon="true"
        app:ocardlistitem_title="@string/omni_mode_select_title"/>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/detail_frequency_control_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ocardlistitem_defaultCustomEnd="end_switch"
        app:ocardlistitem_showCustomEnd="true"
        app:ocardlistitem_title="@string/detail_frequency_control_des"/>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/detail_run_history_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ocardlistitem_defaultCustomEnd="end_detail"
        app:ocardlistitem_showCustomEnd="true"
        app:ocardlistitem_showTailIcon="true"
        app:ocardlistitem_title="@string/repeat_task_management_cell_history"/>
</LinearLayout>
