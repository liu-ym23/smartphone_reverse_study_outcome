<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="start"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:paddingHorizontal="10dp">
    <com.obric.oui.lisitem.OListItemCheck
        android:id="@+id/check1"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="4dp"
        app:oui_list_item_title="@string/userreport_sheet_task_success"/>
    <com.obric.oui.lisitem.OListItemCheck
        android:id="@+id/check2"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="4dp"
        app:oui_list_item_title="@string/userreport_sheet_task_almost_success"/>
    <com.obric.oui.lisitem.OListItemCheck
        android:id="@+id/check3"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginVertical="4dp"
        app:oui_list_item_title="@string/userreport_sheet_task_failed"/>
    <com.obric.oui.forms.OInputView
        android:gravity="top"
        android:id="@+id/tv_user_suggestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:hint="@string/userreport_sheet_your_suggest"
        android:cursorVisible="true"
        app:oui_inputHeight="50dp"
        app:oui_inputLabel="@string/userreport_sheet_your_suggest"
        app:oui_inputMode="text"
        app:oui_inputSingleLine="false"
        app:oui_showLabel="false"
        app:oui_showLabelIcon="false"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="6dp">
        <com.obric.oui.checkbox.OCheckBox
            android:id="@+id/chk_report_screenshot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_1"
            android:id="@+id/chk_report_screenshot_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/userreport_sheet_privacy_notice"
            android:layout_marginStart="14dp"
            app:oui_textSpec="P2"
            style="@style/Label_L"/>
    </LinearLayout>
</LinearLayout>
