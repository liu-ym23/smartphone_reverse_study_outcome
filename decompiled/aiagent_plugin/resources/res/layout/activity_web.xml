<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/main_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.button.OIconButton
        android:id="@+id/web_btnBack"
        android:layout_marginTop="16dp"
        android:src="@drawable/o_ic_titlebar_back"
        android:scaleType="center"
        android:layout_marginStart="16dp"
        android:layout_alignParentStart="true"
        style="@style/OButton.M1.Standard"/>
    <com.obric.oui.button.OIconButton
        android:id="@+id/web_btnShare"
        android:layout_marginTop="16dp"
        android:src="@drawable/icon_share"
        android:scaleType="center"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"
        style="@style/OButton.M1.Standard"/>
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/oui_text_1"
        android:id="@+id/web_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/web_title"
        android:layout_centerHorizontal="true"/>
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        android:layout_below="@+id/web_title"/>
    <ProgressBar
        android:id="@+id/web_progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"/>
    <TextView
        android:textColor="@color/oui_text_3b"
        android:gravity="center"
        android:id="@+id/web_errorTip"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/web_error_tip"
        android:layout_centerInParent="true"
        style="@style/Title_Title_M"/>
</RelativeLayout>
