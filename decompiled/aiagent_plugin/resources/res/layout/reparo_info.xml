<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/reparo_error_msg"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="reparo not init!"
        android:textAlignment="center"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/reparo_info_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="id"/>
            <TextView
                android:gravity="center"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="version"/>
            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="install_dir"
                android:layout_weight="1"/>
        </LinearLayout>
        <ListView
            android:id="@+id/reparo_info_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:orientation="horizontal"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/reparo_fetch_patchs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="20dp"
                android:text="fetch patchs"/>
            <Button
                android:id="@+id/reparo_clear_patchs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="clear patchs and restart"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
