<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/skill_open_app_management_root"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_container"
        android:paddingTop="@dimen/oui_title_bar_mask_height"
        android:paddingBottom="96dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/account_info_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/feishu_account_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_title="@string/obric_skill_open_app_feishu_account_title"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/feishu_app_id_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_title="@string/obric_skill_open_app_feishu_app_id_title"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/debug_entry_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/feishu_config_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_title="@string/obric_skill_open_app_config_feishu_title"/>
        </LinearLayout>
    </LinearLayout>
    <com.obric.oui.button.OButton
        android:textColor="@color/oui_functional_red_6"
        android:layout_gravity="bottom"
        android:id="@+id/feishu_logout_button"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/obric_skill_open_app_feishu_logout"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:oui_widgetFitInsetBottom="true"
        style="@style/OStyleV2.OButton.L.Standard.Neutral"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:layout_gravity="top"
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_centerTitle="@string/obric_skill_open_app_feishu_management_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oui_widgetFitInsetTop="true"/>
</FrameLayout>
