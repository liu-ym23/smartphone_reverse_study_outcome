<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:background="@drawable/obric_item_bg_no_radius"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp_16"
    android:paddingVertical="@dimen/dp_12">
    <ImageView
        android:id="0x7f03002b"
        android:layout_width="@dimen/assistant_card_dp_36"
        android:layout_height="@dimen/assistant_card_dp_36"
        android:layout_marginTop="@dimen/assistant_card_dp_2"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"/>
    <ImageView
        android:id="@+id/icon_cover"
        android:layout_width="@dimen/assistant_card_dp_16"
        android:layout_height="@dimen/assistant_card_dp_16"
        android:scaleType="centerCrop"
        android:layout_alignBottom="0x7f03002b"
        android:layout_marginStart="@dimen/assistant_card_dp_24"
        android:layout_alignStart="0x7f03002b"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/assistant_card_dp_12"
        android:layout_toEndOf="0x7f03002b"
        android:layout_alignParentEnd="true">
        <TextView
            android:textSize="@dimen/assistant_card_dp_16"
            android:textColor="@color/assistant_card_neutral_100"
            android:ellipsize="end"
            android:id="0x7f0300ea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_toLeftOf="0x7f0300e9"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/assistant_card_dp_12"
            android:textColor="@color/assistant_card_neutral_70"
            android:ellipsize="end"
            android:id="@+id/second_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/assistant_card_dp_2"
            android:maxLines="2"
            android:layout_below="0x7f0300ea"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="@dimen/assistant_card_dp_12"
            android:textColor="@color/assistant_card_neutral_70"
            android:gravity="center_vertical"
            android:id="0x7f0300e9"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="0x7f0300ea"
            android:layout_alignBottom="0x7f0300ea"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>
