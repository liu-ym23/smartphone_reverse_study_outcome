<?xml version="1.0" encoding="utf-8"?>
<com.obric.autoaction.presentation.view.NoTransparentRegionRoot xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageView
        android:id="@+id/trackIcon"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/auto_range_icon"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:id="@+id/iv_center_icon"
        android:background="@color/oui_basic_bg_base_1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/surfaceview_bg_default_repeat"
            android:scaleType="fitXY"/>
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:src="@drawable/oic_hand_right_ai_fill"
            android:scaleType="center"
            app:layout_constraintBottom_toTopOf="@+id/bg_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_basic_text_1"
            android:id="@+id/bg_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/auto_start_introduce_title"
            android:textFontWeight="640"
            app:layout_constraintBottom_toTopOf="@+id/bg_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/Title_Headline"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_basic_text_3"
            android:gravity="center"
            android:id="@+id/bg_content"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="98dp"
            android:text="@string/auto_start_introduce_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bg_title"
            app:layout_constraintVertical_bias="0.5"
            style="@style/Label_L"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.obric.design.edgeglow.AiScreenEdgeEffectView
        android:id="@+id/effect"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:id="@+id/shadowLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:paddingVertical="27dp">
        <com.obric.autoaction.presentation.view.TouchAwareConstraintLayout
            android:id="@+id/cardLayout"
            android:background="@drawable/card_bg_with_border_normal"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:oui_radius="28dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardContentGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/top_icon_group"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/top_icon"
                        android:background="@drawable/autoaction_ai_gradient_a3_light"
                        android:padding="12dp"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/oic_hand_right_ai_fill"/>
                    <TextView
                        android:textColor="@color/oui_text_1"
                        android:id="@+id/top_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="请手动操作"
                        style="@style/Label_L_Thin"/>
                </LinearLayout>
                <com.obric.autoaction.presentation.view.LockableScrollView
                    android:id="@+id/tvCardTitleContainer"
                    android:scrollbars="none"
                    android:fadingEdge="vertical"
                    android:fadingEdgeLength="22dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxHeight="132dp"
                    android:requiresFadingEdge="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_max="132dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/top_icon_group">
                    <com.obric.autoaction.presentation.view.GradientTextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/green_text_color"
                        android:id="@+id/tvCardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="waiting"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"/>
                </com.obric.autoaction.presentation.view.LockableScrollView>
                <com.obric.autoaction.presentation.view.LockableScrollView
                    android:id="@+id/tvCardContentContainer"
                    android:scrollbars="none"
                    android:fadingEdge="vertical"
                    android:fadingEdgeLength="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxHeight="84dp"
                    android:requiresFadingEdge="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_max="84dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvCardTitleContainer">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/oui_text_3"
                        android:id="@+id/tvCardContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"/>
                </com.obric.autoaction.presentation.view.LockableScrollView>
                <FrameLayout
                    android:id="@+id/userOperation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvCardContentContainer">
                    <com.obric.oui.button.OButton
                        android:textSize="16sp"
                        android:id="@+id/userExecuteButton"
                        android:background="@drawable/bg_button_gradient"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_marginTop="12dp"
                        android:text="@string/auto_execute_by_user"
                        android:textFontWeight="500"
                        app:oui_radius="12dp"
                        style="@style/OButton.L1.Standard.Neutral"/>
                    <com.obric.oui.button.OButton
                        android:textSize="16sp"
                        android:id="@+id/assistClarfiyBtn"
                        android:background="@drawable/bg_button_gradient"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_marginTop="12dp"
                        android:text="告诉豆包"
                        android:textFontWeight="500"
                        app:oui_radius="12dp"
                        style="@style/OButton.L1.Standard.Neutral"/>
                    <ViewStub
                        android:id="@+id/inputContent"
                        android:layout="@layout/edittext_with_send_button"
                        android:inflatedId="@+id/clarify_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvCardContentContainer"/>
                </FrameLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/action_btn_group"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/userOperation">
                    <com.obric.oui.button.OButton
                        android:id="@+id/option1"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/oui_h_l1"
                        android:layout_weight="1"
                        style="@style/OButton.L1.Standard.Neutral"/>
                    <com.obric.oui.button.OButton
                        android:id="@+id/option2"
                        android:background="@drawable/bg_button_gradient"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/oui_h_l1"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        style="@style/OButton.L1.Standard.Neutral"/>
                </LinearLayout>
                <com.obric.oui.button.OButton
                    android:id="@+id/exitCallUserButton"
                    android:background="@color/color_light_magenta"
                    android:visibility="gone"
                    android:layout_marginTop="16dp"
                    android:text="@string/auto_card_task_continue"
                    android:drawableLeft="@drawable/auto_play_icon_button"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/userOperation"
                    style="@style/OButton.M1.Standard.Neutral"/>
                <LinearLayout
                    android:id="@+id/loadingLayout"
                    android:background="@drawable/auto_loading_bg"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/oui_h_m1"
                    android:layout_marginTop="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/userOperation">
                    <com.obric.oui.progress.ODownloadProgressView
                        android:layout_gravity="start|center_vertical"
                        android:id="@+id/progress_view_processing_3"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="12dp"
                        app:oui_progress_view_size="small"/>
                    <TextView
                        android:layout_gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_card_user_addition"
                        android:fontFamily="sans-serif"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="12dp"
                        style="@style/BtnLabel_M1"/>
                </LinearLayout>
                <com.obric.oui.button.OButton
                    android:id="@+id/btn_clarify_adding"
                    android:visibility="gone"
                    android:layout_marginTop="16dp"
                    android:text="其他想法"
                    android:drawableStart="@drawable/auto_icon_adding_lead_surface"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/action_btn_group"
                    style="@style/OButton.M1.Standard.Neutral"/>
                <com.obric.oui.button.OButton
                    android:id="@+id/btnAdding"
                    android:visibility="gone"
                    android:layout_marginTop="16dp"
                    android:text="@string/auto_card_user_addition"
                    android:drawableStart="@drawable/auto_icon_adding_lead_surface"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/action_btn_group"
                    style="@style/OButton.M1.Standard.Neutral"/>
                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/addingBarrier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:barrierDirection="end"
                    app:constraint_referenced_ids="loadingLayout,btnAdding"/>
                <com.obric.oui.button.OButton
                    android:id="@+id/userTakeOver"
                    android:visibility="gone"
                    android:layout_marginTop="16dp"
                    android:text="@string/auto_card_user_takeover"
                    android:drawableStart="@drawable/oui_right_hand_point_up_surface"
                    android:layout_marginStart="4dp"
                    app:layout_constraintLeft_toRightOf="@+id/addingBarrier"
                    app:layout_constraintTop_toBottomOf="@+id/action_btn_group"
                    style="@style/OButton.M1.Standard.Neutral"/>
                <com.obric.oui.button.OButton
                    android:textStyle="normal"
                    android:id="@+id/btnCheckAll"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_marginTop="16dp"
                    android:text="@string/obric_widget_check_all"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/action_btn_group"
                    style="@style/OButton.M1.Standard.Neutral"/>
                <com.obric.oui.button.OButton
                    android:id="@+id/btnStop"
                    android:layout_marginTop="16dp"
                    android:text="@string/auto_card_task_stop"
                    android:drawableLeft="@drawable/auto_icon_delete"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/action_btn_group"
                    style="@style/OButton.M1.Standard.Neutral"/>
                <com.obric.oui.button.OButton
                    android:textStyle="normal"
                    android:id="@+id/btnFeedback"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_marginTop="16dp"
                    android:text="@string/auto_card_task_feedback"
                    android:drawableLeft="@drawable/auto_icon_feedback"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/action_btn_group"
                    style="@style/OButton.M1.Standard.Neutral"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.obric.autoaction.presentation.view.TouchAwareConstraintLayout>
    </LinearLayout>
    <com.obric.oui.layout.OUIFrameLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/closeButtonContainer"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        app:oui_shadowCornerRadius="@dimen/oui_r_m1"
        style="@style/ShadowInFloatedButton">
        <com.obric.oui.button.OButton
            android:textColor="@color/oui_basic_text_1"
            android:gravity="center"
            android:id="@+id/closeButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/oui_h_m2"
            android:text="@string/surface_activity_close"
            android:drawableStart="@drawable/icon_close_down_arrow"
            android:drawableTint="@color/oui_advanced_fill_icon_as_action"
            style="@style/OButton.M2.Floated"/>
    </com.obric.oui.layout.OUIFrameLayout>
    <com.obric.autoaction.presentation.view.PlayerBubble
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/floating_icon_layout"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginBottom="100dp"/>
</com.obric.autoaction.presentation.view.NoTransparentRegionRoot>
