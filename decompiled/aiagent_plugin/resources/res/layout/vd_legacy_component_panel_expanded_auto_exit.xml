<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp">
    <RelativeLayout
        android:id="@+id/title_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/id_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_vd_auto_exit_dialog_operate_phone"
            android:tint="@color/oui_basic_text_3b"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/oui_basic_text_3"
            android:id="0x7f0300ea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/obric_vd_auto_exit_title"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@+id/id_icon"/>
    </RelativeLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/oui_basic_text_1"
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:text="@string/obric_vd_auto_exit_content"
        android:layout_below="@+id/title_layout"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"/>
    <Button
        android:textSize="16sp"
        android:textColor="@color/oui_basic_text_1"
        android:id="@+id/exit_button"
        android:background="@drawable/vd_background_exit_dialog_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/obric_vd_action_quit"
        android:layout_below="@+id/content"/>
</RelativeLayout>
