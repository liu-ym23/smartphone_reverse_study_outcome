<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/skill_shop_root"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/discovery_content"
        android:background="@color/oui_basic_bg_base_1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/discovery_view_pager"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/app_function_panel"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.obric.oui.orecyclerview.widget.RecyclerView
                android:id="@+id/app_function_list"
                android:paddingTop="112dp"
                android:paddingBottom="68dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.obric.oui.status.OPageStatus
                android:layout_gravity="center"
                android:id="@+id/app_function_empty"
                android:visibility="gone"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                app:opagestatus_title="@string/obric_skill_app_function_empty"
                app:opagestatus_type="status_content"/>
        </FrameLayout>
    </FrameLayout>
    <com.obric.oui.blur.OBlurMaskView
        android:id="@+id/discovery_top_mask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oBlurMask_blurRadius="8"
        app:oBlurMask_defaultMaskBackground="true"
        app:oui_widgetBlurType="1"
        app:oui_widgetFitInsetTop="true">
        <com.obric.oui.layout.OUILinearLayout
            android:orientation="vertical"
            android:id="@+id/discovery_top_content"
            android:paddingBottom="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.titlebar.OFloatingTitleBar
                android:id="@+id/discovery_floating_title_bar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                app:oFloatingTitleBar_centerTitle="@string/obric_skill_shop_title"
                app:oFloatingTitleBar_maskBlurRadius="0"/>
            <com.obric.oui.tab.OTabLayout
                android:id="@+id/discovery_primary_tabs"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:tabGravity="fill"
                app:tabMode="fixed"
                style="@style/OTabTextV2.Background.Light">
                <com.obric.oui.tab.OTabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/obric_skill_shop_featured_tab"/>
                <com.obric.oui.tab.OTabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/obric_skill_app_function_tab"/>
            </com.obric.oui.tab.OTabLayout>
            <com.obric.oui.tab.OTabLayout
                android:id="@+id/discovery_tabs"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:tabGravity="fill"
                app:tabMode="scrollable"
                app:tab_edgeFadeEnabled="false"
                style="@style/OTabTextV2.NoBackground.ChipsTab"/>
        </com.obric.oui.layout.OUILinearLayout>
    </com.obric.oui.blur.OBlurMaskView>
    <com.obric.oui.button.OIconButtonFloating
        android:layout_gravity="end|bottom"
        android:id="@+id/discovery_create"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/obric_skill_common_create"
        android:layout_marginEnd="20dp"
        app:oui_widgetEnableMaterial="true"
        app:oui_widgetIcon="@drawable/skill_ic_add"
        app:oui_widgetRadius="28dp"
        style="@style/OStyleV2.OButtonFloating.M.Primary.Icon"/>
</FrameLayout>
