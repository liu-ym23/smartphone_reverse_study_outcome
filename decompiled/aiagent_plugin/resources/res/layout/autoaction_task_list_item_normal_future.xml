<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.layout.OUILinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/oui_fill_list_item_card"
    android:paddingTop="16dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/first_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp"/>
    <com.obric.autoaction.app.launcherpage.module.view.ExpandableTextLayout
        android:textColor="@color/oui_text_1"
        android:id="@+id/txt_tli_task_query"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="4dp"
        style="@style/Title_1_Regular"/>
</com.obric.oui.layout.OUILinearLayout>
