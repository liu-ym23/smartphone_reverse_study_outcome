<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <EditText
        android:textSize="14sp"
        android:textColor="@color/oui_text_1"
        android:textColorHighlight="@color/autoaction_task_input_window_selection"
        android:id="@+id/edit"
        android:background="@android:color/transparent"
        android:fadingEdge="vertical"
        android:fadingEdgeLength="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:maxHeight="104dp"
        android:textSelectHandleLeft="@color/autoaction_task_input_window_cursor"
        android:textSelectHandleRight="@color/autoaction_task_input_window_cursor"
        android:textCursorDrawable="@drawable/global_input_window_text_cursor"
        android:requiresFadingEdge="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/oui_basic_text_4"
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBaseline_toBaselineOf="@+id/edit"
        app:layout_constraintStart_toStartOf="@+id/edit"
        style="@style/Body_M"/>
</androidx.constraintlayout.widget.ConstraintLayout>
