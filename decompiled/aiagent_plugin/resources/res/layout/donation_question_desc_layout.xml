<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:paddingTop="94dp"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_action_container">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.coachmark.OCoachmarkTipView
                android:textColor="@color/oui_basic_text_1"
                android:id="@+id/reward_desc"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:src="@drawable/oic_coachmark_tip"
                android:text="@string/reward_desc_text"
                android:layout_marginHorizontal="15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:oui_cmTipBackgroundColor="@color/oui_basic_bg_base_3"/>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:gravity="center_vertical"
                android:id="@+id/query_title"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginHorizontal="28dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/reward_desc"
                app:layout_goneMarginTop="8dp"
                app:sectionTitle_titleText="@string/donation_task_query"
                style="@style/Subtitle_2_Medium"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/target_input_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/query_title"
                app:ocardlistitem_cardType="type_container"/>
            <com.obric.oui.markdown.OMarkdownView
                android:textColor="@color/oui_text_2"
                android:id="@+id/process_introduction_desc_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginHorizontal="28dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/target_input_card"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/bottom_action_container"
        android:background="@color/oui_basic_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <View
            android:id="@+id/border"
            android:background="@color/oui_basic_line_2"
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:layout_marginBottom="16dp"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_basic_text_3"
            android:id="@+id/license_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/donation_license_tip"
            android:layout_marginHorizontal="28dp"
            style="@style/Label_M_Thin"/>
        <com.obric.oui.button.OButton
            android:layout_gravity="center"
            android:id="@+id/start_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:text="@string/start_to_record"
            android:layout_marginHorizontal="20dp"
            style="@style/OStyleV2.OButton.L.Standard.Primary"/>
    </LinearLayout>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        app:oFloatingTitleBar_centerTitle="@string/data_donation_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oui_widgetFitInsetTop="true"/>
</RelativeLayout>
