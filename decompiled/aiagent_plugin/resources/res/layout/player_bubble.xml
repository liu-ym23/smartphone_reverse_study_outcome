<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:visibility="gone"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    android:minWidth="48dp"
    android:minHeight="48dp"
    android:clipToOutline="false">
    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="-30dp"
        android:layout_marginBottom="-30dp"
        android:src="@drawable/float_expanded_status_bg"
        android:scaleType="fitXY"
        android:layout_alignTop="@+id/floating_icon_content"
        android:layout_alignBottom="@+id/floating_icon_content"
        android:layout_marginStart="-27dp"
        android:layout_marginEnd="-27dp"
        android:layout_alignStart="@+id/floating_icon_content"
        android:layout_alignEnd="@+id/floating_icon_content"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/floating_icon_content"
        android:paddingLeft="12dp"
        android:paddingTop="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.obric.oui.avatar.OCircleImageView
            android:id="@+id/floating_icon_img"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/floating_play_icon"/>
        <com.obric.oui.text.OTextView
            android:textSize="14sp"
            android:textColor="@color/oui_basic_text_1"
            android:layout_gravity="center_vertical"
            android:id="@+id/floating_icon_expanded_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:textFontWeight="480"/>
    </LinearLayout>
</merge>
