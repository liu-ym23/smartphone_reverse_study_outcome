<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingTop="@dimen/express_more_group_item_padding_top"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/express_more_aty_left_right_padding"
    android:paddingEnd="@dimen/express_more_aty_left_right_padding">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="28dp">
        <com.obric.oui.sectiontitlebar.OSectionTitleBar
            android:gravity="center_vertical"
            android:id="@+id/express_item_header_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/OSectionTitleBar.S"/>
    </LinearLayout>
</LinearLayout>
