<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/travel_notification_remote_view_layout"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">
            <ImageView
                android:id="@+id/travel_notification_remote_view_header_icon"
                android:layout_width="@dimen/travel_icon_size"
                android:layout_height="@dimen/travel_icon_size"/>
            <TextView
                android:textColor="@color/oui_basic_text_1"
                android:id="@+id/travel_notification_remote_view_header_travel_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="6dp"
                style="@style/Subtitle_3_Medium"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <TextView
                android:textColor="@color/oui_basic_text_3"
                android:id="@+id/travel_notification_remote_view_header_right_info"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/Subtitle_2_Regular"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/travel_notification_remote_view_info_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-1dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/travel_notification_remote_view_info_0"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/travel_notification_remote_view_title_text_size"
                    android:textColor="@color/oui_basic_text_1"
                    android:gravity="center_vertical"
                    android:id="@+id/travel_notification_remote_view_info_title_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:lineHeight="@dimen/travel_notification_remote_view_title_line_height"
                    style="@style/Title_4_Medium"/>
                <TextView
                    android:textColor="@color/oui_basic_text_3"
                    android:id="@+id/travel_notification_remote_view_info_summary_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    style="@style/Subtitle_1_Regular"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/travel_notification_remote_view_info_1"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/travel_notification_remote_view_info_margin_start">
                <TextView
                    android:textSize="@dimen/travel_notification_remote_view_title_text_size"
                    android:textColor="@color/oui_basic_text_1"
                    android:gravity="center_vertical"
                    android:layout_gravity="end"
                    android:id="@+id/travel_notification_remote_view_info_title_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:lineHeight="@dimen/travel_notification_remote_view_title_line_height"
                    style="@style/Title_4_Medium"/>
                <TextView
                    android:textColor="@color/oui_basic_text_3"
                    android:layout_gravity="end"
                    android:id="@+id/travel_notification_remote_view_info_summary_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    style="@style/Subtitle_1_Regular"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/travel_notification_remote_view_status_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/oui_functional_red_7"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/travel_notification_remote_view_status_layout_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/Body_1_Medium"/>
        </LinearLayout>
        <Button
            android:layout_gravity="center_vertical"
            android:id="@+id/travel_notification_remote_view_btn_taxi"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/travel_notification_taxi"
            android:maxLines="1"
            style="@style/AndroidButton.M.Neutral"/>
    </LinearLayout>
</FrameLayout>
