<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/travel_card_item_bottom_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/travel_card_item_divider_layout"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:background="@drawable/travel_card_item_divider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="9dp"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/travel_card_item_bottom_layout_guide_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.3333"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/travel_card_item_bottom_layout_guide_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.6666"/>
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="vertical"
        android:id="@+id/travel_card_item_bottom_layout_left"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="18dp"
        app:layout_constraintEnd_toStartOf="@+id/travel_card_item_bottom_layout_guide_1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/travel_card_item_divider_layout">
        <com.obric.oui.text.OBaseTextView
            android:textColor="@color/oui_basic_text_3"
            android:ellipsize="end"
            android:id="@+id/travel_card_item_bottom_layout_left_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/travel_card_item_layout_empty_info_str"
            android:maxLines="1"
            style="@style/Subtitle_1_Regular"/>
        <com.obric.oui.text.OBaseTextView
            android:textColor="@color/oui_basic_text_1"
            android:ellipsize="end"
            android:id="@+id/travel_card_item_bottom_layout_left_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/travel_card_item_bottom_layout_title_margin_summary"
            android:text="@string/travel_card_item_layout_empty_info_str"
            android:maxLines="1"
            style="@style/Body_1_Medium"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/travel_card_item_bottom_layout_middle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="9dp"
        app:layout_constraintEnd_toEndOf="@+id/travel_card_item_bottom_layout_guide_2"
        app:layout_constraintStart_toStartOf="@+id/travel_card_item_bottom_layout_guide_1"
        app:layout_constraintTop_toBottomOf="@+id/travel_card_item_divider_layout">
        <com.obric.oui.text.OBaseTextView
            android:textColor="@color/oui_basic_text_3"
            android:ellipsize="end"
            android:id="@+id/travel_card_item_bottom_layout_middle_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/travel_card_item_layout_empty_info_str"
            android:maxLines="1"
            style="@style/Subtitle_1_Regular"/>
        <com.obric.oui.text.OBaseTextView
            android:textColor="@color/oui_basic_text_1"
            android:ellipsize="end"
            android:id="@+id/travel_card_item_bottom_layout_middle_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/travel_card_item_bottom_layout_title_margin_summary"
            android:text="@string/travel_card_item_layout_empty_info_str"
            android:maxLines="1"
            style="@style/Body_1_Medium"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="end|center_vertical"
        android:orientation="vertical"
        android:id="@+id/travel_card_item_bottom_layout_right"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/travel_card_item_bottom_layout_guide_2"
        app:layout_constraintTop_toBottomOf="@+id/travel_card_item_divider_layout">
        <com.obric.oui.text.OBaseTextView
            android:textColor="@color/oui_basic_text_3"
            android:ellipsize="end"
            android:id="@+id/travel_card_item_bottom_layout_right_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/travel_card_item_layout_empty_info_str"
            android:maxLines="1"
            style="@style/Subtitle_1_Regular"/>
        <com.obric.oui.text.OBaseTextView
            android:textColor="@color/oui_basic_text_1"
            android:ellipsize="end"
            android:id="@+id/travel_card_item_bottom_layout_right_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/travel_card_item_bottom_layout_title_margin_summary"
            android:text="@string/travel_card_item_layout_empty_info_str"
            android:maxLines="1"
            style="@style/Body_1_Medium"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
