<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/widget_real_content"
        android:background="@drawable/widget_real_content_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:layout_width="@dimen/circle_clock_size"
                android:layout_height="@dimen/circle_clock_size"
                android:layout_marginHorizontal="10dp">
                <ImageView
                    android:layout_width="@dimen/circle_clock_size"
                    android:layout_height="@dimen/circle_clock_size"
                    android:src="@drawable/square_dial"
                    android:scaleType="fitXY"/>
                <TextView
                    android:ellipsize="end"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/square_clock_analog_name"
                    android:paddingTop="30dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:paddingHorizontal="32dp"
                    style="@style/Subtitle_2_Regular"/>
                <com.obric.clockwidgets.ui.SquareClockView
                    android:id="@+id/square_clock_analog"
                    android:layout_width="@dimen/circle_clock_size"
                    android:layout_height="@dimen/circle_clock_size"
                    app:drawDial="false"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingEnd="12dp"
                android:paddingVertical="12dp">
                <com.obric.clockwidgets.ui.OUINoPressLinearLayout
                    app:oui_radius="@dimen/oui_r_l1_rect"
                    style="@style/square_clock_large_container">
                    <TextView
                        android:id="@+id/square_city_time_2"
                        style="@style/square_clock_large_title"/>
                    <TextView
                        android:id="@+id/square_city_offset_2"
                        style="@style/square_clock_large_subtitle"/>
                </com.obric.clockwidgets.ui.OUINoPressLinearLayout>
                <com.obric.clockwidgets.ui.OUINoPressLinearLayout
                    android:layout_marginTop="8dp"
                    app:oui_radius="@dimen/oui_r_l1_rect"
                    style="@style/square_clock_large_container">
                    <TextView
                        android:id="@+id/square_city_time_3"
                        style="@style/square_clock_large_title"/>
                    <TextView
                        android:id="@+id/square_city_offset_3"
                        style="@style/square_clock_large_subtitle"/>
                </com.obric.clockwidgets.ui.OUINoPressLinearLayout>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <TextView
        android:id="@+id/widget_tip_view"
        style="@style/widget_tip_text"/>
</FrameLayout>
