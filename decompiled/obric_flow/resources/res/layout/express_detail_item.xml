<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/rl_left"
        android:paddingTop="6dp"
        android:layout_width="50dp"
        android:layout_height="78dp"
        android:layout_alignParentLeft="true">
        <ImageView
            android:id="@+id/detail_circle"
            android:background="@drawable/express_shape_circle_logistics_gray"
            android:layout_width="@dimen/express_jd_detail_circle"
            android:layout_height="@dimen/express_jd_detail_circle"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/detail_line_bottom"
            android:layout_width="@dimen/express_jd_detail_line"
            android:layout_height="match_parent"
            android:src="@color/express_detail_line_color"
            android:layout_below="@+id/detail_circle"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/express_detail_default_color"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/detail_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_toRightOf="@+id/rl_left"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/express_detail_default_color"
        android:gravity="center_vertical"
        android:id="@+id/detail_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/rl_left"
        android:layout_below="@+id/detail_status"/>
</RelativeLayout>
