<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.obric.oui.progress.ODownloadProgressView
        android:id="@+id/status_loading"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        app:oui_progress_view_size="small"/>
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_basic_text_3"
        android:ellipsize="end"
        android:id="@+id/status_loading_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Title_1_Regular"/>
</LinearLayout>
