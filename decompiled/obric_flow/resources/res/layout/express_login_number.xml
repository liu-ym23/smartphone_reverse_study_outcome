<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.sectiontitlebar.OSectionTitleBar
        android:id="@+id/bind_phone_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/aty_info_layout_margin_start_end"
        android:layout_marginEnd="@dimen/aty_info_layout_margin_start_end"
        app:sectionTitle_titleText="@string/express_bind_phone_numnbers"
        style="@style/OSectionTitleBar.S"/>
    <com.obric.oui.orecyclerview.widget.RecyclerView
        android:id="@+id/bind_phone_info_contents"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/bind_phone_info"
        android:overScrollMode="never"/>
    <com.obric.oui.sectiontitlebar.OSectionSupportiveText
        android:id="@+id/priavte_statement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/oui_padding_16dp"
        android:layout_below="@+id/bind_phone_info_contents"
        android:layout_marginStart="@dimen/aty_info_layout_margin_start_end"
        android:layout_marginEnd="@dimen/aty_info_layout_margin_start_end"
        app:section_des_text="@string/express_privacy_tips"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/bind_phone_nubmer_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/priavte_statement"
        android:layout_marginStart="@dimen/aty_info_layout_margin_start_end"
        android:layout_marginEnd="@dimen/aty_info_layout_margin_start_end">
        <com.obric.oui.sectiontitlebar.OSectionSupportiveText
            android:id="@+id/bind_phone_nubmer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            app:section_des_text="@string/express_bind_number"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/oui_padding_8dp"
        android:layout_below="@+id/bind_phone_nubmer_layout">
        <com.obric.oui.button.OButton
            android:gravity="center"
            android:id="@+id/login_commit_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/express_bind_phone_button"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            style="@style/OStyleV2.OButton.L.Standard.Primary"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/data_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <include layout="@layout/express_login_data_source_layout"/>
    </LinearLayout>
</RelativeLayout>
