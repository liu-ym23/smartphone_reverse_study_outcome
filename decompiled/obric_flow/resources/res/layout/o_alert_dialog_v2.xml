<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="bottom"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/bannerPanel"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/oui_dialog_header_container_padding_h"
            android:paddingVertical="@dimen/oui_dialog_header_container_padding_v">
            <FrameLayout
                android:id="@+id/iconPanel"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.obric.oui.text.OTextView
                android:textSize="16sp"
                android:textColor="@color/oui_basic_text_1"
                android:gravity="center"
                android:id="@+id/textTitle"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="22sp"
                android:lineSpacingExtra="0dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:lastBaselineToBottomHeight="8sp"
                android:lineHeight="22sp"
                android:textFontWeight="@integer/oui_font_weight_bold"/>
            <com.obric.oui.text.OTextView
                android:textSize="14sp"
                android:textColor="@color/oui_basic_text_1"
                android:gravity="start|center_vertical"
                android:id="@+id/textSubTitle"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="21sp"
                android:lineSpacingExtra="0dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:lastBaselineToBottomHeight="6.2sp"
                android:lineHeight="21sp"
                android:textFontWeight="@integer/oui_font_weight_regular"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/body_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
