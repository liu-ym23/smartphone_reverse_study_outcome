<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="24dp">
    <com.obric.oui.text.OBaseTextView
        android:textColor="@color/oui_basic_text_3b"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/express_data_source"
        style="@style/Subtitle_1_Regular"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <com.obric.oui.image.OImage
            android:layout_width="@dimen/express_source_info_icon_size"
            android:layout_height="@dimen/express_source_info_icon_size"
            android:src="@drawable/pic_cainiao"
            app:oui_imageStrokeEnabled="false"/>
        <com.obric.oui.text.OBaseTextView
            android:textColor="@color/oui_basic_text_3b"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/express_data_source_one"
            android:layout_marginStart="@dimen/express_source_info_icon_text_padding"
            style="@style/Subtitle_1_Regular"/>
        <com.obric.oui.image.OImage
            android:visibility="gone"
            android:layout_width="@dimen/express_source_info_icon_size"
            android:layout_height="@dimen/express_source_info_icon_size"
            android:src="@drawable/pic_jingdong"
            android:layout_marginStart="@dimen/express_source_info_icon_margin_start"
            app:oui_imageStrokeEnabled="false"/>
        <com.obric.oui.text.OBaseTextView
            android:textColor="@color/oui_basic_text_3b"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/express_data_source_two"
            android:layout_marginStart="@dimen/express_source_info_icon_text_padding"
            style="@style/Subtitle_1_Regular"/>
        <com.obric.oui.image.OImage
            android:layout_width="@dimen/express_source_info_icon_size"
            android:layout_height="@dimen/express_source_info_icon_size"
            android:src="@drawable/pic_sf"
            android:layout_marginStart="@dimen/express_source_info_icon_margin_start"
            app:oui_imageStrokeEnabled="false"/>
        <com.obric.oui.text.OBaseTextView
            android:textColor="@color/oui_basic_text_3b"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/express_data_source_three"
            android:layout_marginStart="@dimen/express_source_info_icon_text_padding"
            style="@style/Subtitle_1_Regular"/>
    </LinearLayout>
</LinearLayout>
