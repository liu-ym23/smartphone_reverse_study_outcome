<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/express_detail_no_internet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/express_detail_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="16sp"
            android:textColor="#e6000000"
            android:id="@+id/express_detail_mailno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/express_mail_no"
            android:paddingStart="20dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#70000000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/express_jd_tips"
            android:paddingStart="20dp"/>
        <View
            android:background="@color/express_line_color"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="10dp"
            android:layout_marginStart="20dp"/>
        <Button
            android:textSize="14sp"
            android:textColor="#ff1c9fdb"
            android:layout_gravity="center"
            android:id="@+id/express_look_goods_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:text="@string/express_look_good"/>
        <include layout="@layout/group_divider"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <ImageView
                android:background="@drawable/express_jd_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="13dp"
                android:layout_marginStart="@dimen/express_more_search_container_padding"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#8a000000"
                android:gravity="center_horizontal"
                android:paddingTop="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/express_jd_info"
                android:paddingStart="16dp"/>
        </LinearLayout>
        <View
            android:background="@color/express_line_color"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginBottom="5dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="@dimen/express_more_search_container_padding"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/expres_detail_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginRight="@dimen/express_more_search_container_padding"
                android:overScrollMode="never"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
