<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_list_item_root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.oui.layout.OUIFrameLayout
        android:id="@+id/card_container"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.obric.oui.swipeaction.OSwipeLayout
            android:gravity="center_vertical"
            android:id="@+id/swipe_layout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:oui_show_mode="pull_out">
            <FrameLayout
                android:id="@+id/swip_container"
                android:visibility="gone"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <FrameLayout
                android:id="@+id/swipe_surface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.lisitem.OUICardConstraintLayout
                    android:gravity="center_vertical"
                    android:id="@+id/content_container"
                    android:background="@drawable/o_card_list_item_content_bg"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingEnd="4dp">
                    <FrameLayout
                        android:id="@+id/custom_start_container"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <FrameLayout
                        android:id="@+id/icon_container"
                        android:padding="10dp"
                        android:visibility="gone"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/custom_start_container"
                        app:layout_constraintTop_toTopOf="parent">
                        <ImageView
                            android:id="@+id/icon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"/>
                    </FrameLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/title_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp"
                        android:paddingVertical="10dp"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/custom_end_container"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintStart_toEndOf="@+id/icon_container"
                        app:layout_constraintTop_toTopOf="parent">
                        <com.obric.oui.text.OTextView
                            android:textColor="@color/oui_basic_text_1"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:id="@+id/title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="22sp"
                            android:lineSpacingExtra="0dp"
                            style="@style/Title_1_Regular"/>
                        <com.obric.oui.text.OTextView
                            android:textColor="@color/oui_basic_text_3"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:id="@+id/sub_title"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:minHeight="16sp"
                            android:lineSpacingExtra="0dp"
                            android:lastBaselineToBottomHeight="4sp"
                            style="@style/Subtitle_2_Regular"/>
                    </LinearLayout>
                    <androidx.constraintlayout.widget.Barrier
                        android:id="@+id/start_zone_barrier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:barrierDirection="end"
                        app:constraint_referenced_ids="title_container"/>
                    <FrameLayout
                        android:id="@+id/custom_end_container"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/tail_icon"
                        app:layout_constraintHorizontal_bias="1"
                        app:layout_constraintStart_toEndOf="@+id/start_zone_barrier"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth="wrap_content_constrained"
                        app:layout_constraintWidth_max="wrap"
                        app:layout_constraintWidth_min="wrap"/>
                    <ImageView
                        android:id="@+id/tail_icon"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="1"
                        app:layout_constraintStart_toEndOf="@+id/start_zone_barrier"
                        app:layout_constraintTop_toTopOf="parent"/>
                </com.obric.oui.lisitem.OUICardConstraintLayout>
            </FrameLayout>
        </com.obric.oui.swipeaction.OSwipeLayout>
    </com.obric.oui.layout.OUIFrameLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/card_divider"
        android:background="@color/oui_basic_line_1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.6dp"/>
</FrameLayout>
