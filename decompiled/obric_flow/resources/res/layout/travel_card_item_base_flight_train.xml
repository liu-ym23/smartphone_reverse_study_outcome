<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.oui.text.OBaseTextView
        android:textColor="@color/oui_basic_text_3"
        android:id="@+id/travel_card_item_from_station"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/travel_card_item_flight_train_margin_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Subtitle_2_Medium"/>
    <com.obric.oui.text.OBaseTextView
        android:textColor="@color/oui_basic_text_1"
        android:id="@+id/travel_card_item_from_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/travel_card_item_flight_train_from_time_margin_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/travel_card_item_from_station"
        style="@style/Title_4_Medium"/>
    <com.obric.oui.text.OBaseTextView
        android:textColor="@color/oui_basic_text_3"
        android:id="@+id/travel_card_item_plan_or_real_from_time_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/travel_card_item_flight_train_from_time_info_margin_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/travel_card_item_from_time"
        style="@style/Subtitle_1_Regular"/>
    <com.obric.oui.text.OBaseTextView
        android:textColor="@color/oui_basic_text_3"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/travel_card_item_to_station"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/travel_card_item_flight_train_margin_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Subtitle_2_Medium"/>
    <com.obric.oui.text.OBaseTextView
        android:textColor="@color/oui_basic_text_1"
        android:layout_gravity="top"
        android:id="@+id/travel_card_item_to_time_offset_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/travel_card_item_to_station"
        style="@style/Subtitle_1_Regular"/>
    <com.obric.oui.text.OBaseTextView
        android:textColor="@color/oui_basic_text_1"
        android:id="@+id/travel_card_item_to_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/travel_card_item_flight_train_from_time_margin_top"
        app:layout_constraintEnd_toStartOf="@+id/travel_card_item_to_time_offset_date"
        app:layout_constraintTop_toBottomOf="@+id/travel_card_item_to_station"
        style="@style/Title_4_Medium"/>
    <com.obric.oui.text.OBaseTextView
        android:textColor="@color/oui_basic_text_3"
        android:id="@+id/travel_card_item_plan_or_real_to_time_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/travel_card_item_flight_train_from_time_info_margin_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/travel_card_item_to_time"
        style="@style/Subtitle_1_Regular"/>
    <FrameLayout
        android:id="@+id/travel_card_item_travel_line_layout"
        android:layout_width="@dimen/travel_card_item_travel_line_width"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/travel_card_item_from_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/travel_card_item_from_time">
        <com.obric.oui.image.OImage
            android:layout_gravity="center_vertical"
            android:id="@+id/travel_card_item_travel_line_img"
            android:layout_width="@dimen/travel_card_item_travel_line_width"
            android:layout_height="@dimen/travel_card_item_travel_line_height"
            android:src="@drawable/travel_card_item_line_flight_status_plan"
            app:oui_imageStrokeEnabled="false"/>
        <com.obric.oui.image.OImage
            android:layout_gravity="center"
            android:id="@+id/travel_card_item_travel_line_icon"
            android:layout_width="@dimen/travel_card_item_line_icon_size"
            android:layout_height="@dimen/travel_card_item_line_icon_size"
            android:src="@drawable/travel_card_item_line_flight_icon_plan"
            app:oui_imageStrokeEnabled="false"/>
    </FrameLayout>
    <com.obric.oui.text.OBaseTextView
        android:textColor="@color/oui_functional_blue_5"
        android:id="@+id/travel_card_item_company"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/travel_flight_company"
        app:layout_constraintBottom_toTopOf="@+id/travel_card_item_travel_line_layout"
        app:layout_constraintEnd_toEndOf="@+id/travel_card_item_travel_line_layout"
        app:layout_constraintStart_toStartOf="@+id/travel_card_item_travel_line_layout"
        style="@style/Subtitle_1_Medium"/>
    <com.obric.oui.text.OBaseTextView
        android:textColor="@color/oui_functional_blue_5"
        android:id="@+id/travel_card_item_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/travel_state_plan"
        app:layout_constraintEnd_toEndOf="@+id/travel_card_item_travel_line_layout"
        app:layout_constraintStart_toStartOf="@+id/travel_card_item_travel_line_layout"
        app:layout_constraintTop_toBottomOf="@+id/travel_card_item_travel_line_layout"
        style="@style/Subtitle_1_Medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
