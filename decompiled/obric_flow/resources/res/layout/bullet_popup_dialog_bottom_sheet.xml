<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bullet_popup_bottom_sheet_container"
    android:fitsSystemWindows="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/bullet_popup_bottom_sheet_coordinator"
        android:background="@color/transparent"
        android:fitsSystemWindows="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/bullet_popup_bottom_sheet_touch_outside"
            android:fitsSystemWindows="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:soundEffectsEnabled="false"
            android:importantForAccessibility="no"/>
        <FrameLayout
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/bullet_popup_bottom_sheet"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="com.bytedance.ies.bullet.container.popup.ui.draggable.BottomSheetBehavior"
            style="?attr/bottomSheetStyle"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</FrameLayout>
