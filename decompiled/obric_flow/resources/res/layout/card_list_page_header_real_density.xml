<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.flow.cardlistpage.ui.view.NoFocusView
        android:id="@+id/view_gradient_card_scrolled"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.obric.oui.searchbar.v2.OSearchBar
        android:layout_gravity="top|left"
        android:id="@+id/btn_search_bar"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:hint="@string/card_top_search_hint"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_gen_card"
        app:layout_constraintEnd_toStartOf="@+id/btn_gen_card"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_gen_card"
        app:layout_constraintVertical_bias="0"
        app:oui_search_prefixView="@layout/layout_search_icon_view"
        app:oui_widgetMaterial="@string/oui_material_bg_overlay_search_dark"
        app:oui_widgetMaterialSrcType="backdrop_view"
        style="@style/OStyleV2.OSearchBar.Float.Dark"/>
    <com.obric.oui.button.OIconButtonFloating
        android:id="@+id/btn_gen_card"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/btn_settings"
        app:layout_constraintTop_toTopOf="parent"
        app:oui_widgetIcon="@drawable/btn_gen_card"
        app:oui_widgetMaterialSrcType="backdrop_view"
        style="@style/SearchOverlayButtonFloatingIcon"/>
    <com.obric.oui.button.OIconButtonFloating
        android:id="@+id/btn_settings"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:oui_widgetIcon="@drawable/ic_settings_22"
        app:oui_widgetMaterialSrcType="backdrop_view"
        style="@style/SearchOverlayButtonFloatingIcon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
