<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/card_header"
    android:paddingTop="@dimen/card_header_padding_top"
    android:paddingBottom="@dimen/card_header_padding_bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/card_header_title_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.obric.oui.image.OImage
                android:id="@+id/card_header_icon"
                android:layout_width="@dimen/card_header_title_drawable_size"
                android:layout_height="@dimen/card_header_title_drawable_size"
                android:layout_marginEnd="@dimen/card_header_title_drawable_padding"
                app:oui_imageStrokeEnabled="false"/>
            <com.obric.oui.text.OBaseTextView
                android:textColor="@color/oui_basic_text_1"
                android:gravity="center_vertical"
                android:id="@+id/card_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                style="@style/Subtitle_3_Medium"/>
            <com.obric.oui.image.OImage
                android:id="@+id/card_header_title_right_indicator"
                android:visibility="gone"
                android:layout_width="@dimen/card_header_option_size"
                android:layout_height="@dimen/card_header_option_size"
                android:src="@drawable/o_ic_chevron_right"
                android:layout_marginStart="4dp"
                app:oui_imageStrokeEnabled="false"/>
        </LinearLayout>
        <View
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <FrameLayout
            android:id="@+id/card_header_option"
            android:background="@drawable/card_header_option_layout_bg"
            android:visibility="gone"
            android:layout_width="@dimen/card_header_option_layout_size"
            android:layout_height="match_parent"
            android:layout_marginEnd="-4dp">
            <com.obric.oui.image.OImage
                android:id="@+id/card_header_option_bg_img"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:oui_imageStrokeEnabled="false"/>
            <com.obric.oui.image.OImage
                android:layout_gravity="center"
                android:id="@+id/card_header_option_img"
                android:layout_width="@dimen/card_header_option_size"
                android:layout_height="@dimen/card_header_option_size"
                android:src="@drawable/oui_icon_oic_magnifier_search"
                android:tint="@color/oui_advanced_fill_icon_as_action"
                android:tintMode="src_in"
                app:oui_imageStrokeEnabled="false"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
