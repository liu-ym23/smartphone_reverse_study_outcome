<?xml version="1.0" encoding="utf-8"?>
<com.zte.miboard.cards.express.ExpressListItem xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/express_list_item"
    android:layout_width="match_parent"
    android:layout_height="@dimen/express_list_item_height">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/express_list_item_bg_layout"
        android:background="@drawable/express_more_aty_item_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="2dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/express_list_item_divider_height_in_more_aty"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/express_list_item_delete_layout"
            android:layout_width="@dimen/express_list_item_delete_layout_width"
            android:layout_height="match_parent"
            android:paddingEnd="0dp"
            android:layout_marginStart="4dp">
            <com.obric.oui.image.OImage
                android:layout_gravity="center"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@color/oui_functional_red_6"
                android:radius="20dp"
                app:oui_imageStrokeEnabled="false"/>
            <com.obric.oui.image.OImage
                android:layout_gravity="center"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/oui_icon_oic_minus_bold"
                android:tint="@color/oui_on_accent_default"
                android:tintMode="src_in"
                app:oui_imageStrokeEnabled="false"/>
        </FrameLayout>
        <com.obric.oui.image.OImage
            android:id="@+id/express_list_item_icon"
            android:layout_width="@dimen/express_list_item_icon_size"
            android:layout_height="@dimen/express_list_item_icon_size"
            android:src="@drawable/express_company_logo"
            android:layout_marginStart="@dimen/express_list_item_icon_margin_start_in_icon"
            android:layout_marginEnd="@dimen/express_list_item_icon_margin_start_in_icon"
            app:oui_imageStrokeEnabled="false"/>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/express_list_item_info_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/express_list_item_phone_end_number_2"
                android:layout_centerInParent="true">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/express_state_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.obric.oui.text.OBaseTextView
                        android:textColor="@color/express_state_text_color"
                        android:gravity="center_vertical"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/express_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        style="@style/Body_1_Regular"/>
                    <com.obric.oui.tag.OTextTag
                        android:ellipsize="end"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/express_state_send_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/express_send"
                        android:maxLines="1"
                        android:layout_marginStart="4dp"
                        style="@style/OTag.Text.S.Primary.Light"/>
                    <com.obric.oui.tag.OTextTag
                        android:ellipsize="end"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/express_state_error"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/express_error_tips"
                        android:maxLines="1"
                        android:layout_marginStart="5dp"
                        style="@style/OTag.Text.S.Red.Light"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp">
                    <com.obric.oui.text.OBaseTextView
                        android:textColor="@color/oui_basic_text_3"
                        android:ellipsize="end"
                        android:id="@+id/express_sj"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        style="@style/Subtitle_1_Regular"/>
                    <View
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <com.obric.oui.text.OBaseTextView
                        android:textColor="@color/oui_basic_text_3"
                        android:ellipsize="end"
                        android:id="@+id/express_list_item_phone_end_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        style="@style/Subtitle_1_Regular"/>
                </LinearLayout>
            </LinearLayout>
            <com.obric.oui.text.OBaseTextView
                android:textColor="@color/oui_basic_text_3"
                android:ellipsize="end"
                android:id="@+id/express_list_item_phone_end_number_2"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:maxLines="1"
                android:layout_centerInParent="true"
                android:layout_marginStart="@dimen/oui_padding_16dp"
                android:layout_marginEnd="10dp"
                android:layout_alignParentEnd="true"
                style="@style/Subtitle_1_Regular"/>
        </RelativeLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:id="@+id/express_list_item_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/express_list_item_divider_height_in_more_aty"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="10dp">
        <com.obric.oui.divider.ODivider
            android:background="@color/oui_basic_line_1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/oui_divider_line_height"/>
    </LinearLayout>
</com.zte.miboard.cards.express.ExpressListItem>
