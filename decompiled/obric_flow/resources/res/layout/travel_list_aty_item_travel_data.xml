<?xml version="1.0" encoding="utf-8"?>
<com.zte.miboard.cards.travel.TravelListItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">
        <com.obric.oui.image.OImage
            android:id="@+id/travel_list_aty_item_travel_data_icon"
            android:layout_width="@dimen/travel_icon_size"
            android:layout_height="@dimen/travel_icon_size"
            android:layout_marginEnd="6dp"
            app:oui_imageStrokeEnabled="false"/>
        <com.obric.oui.text.OBaseTextView
            android:textColor="@color/oui_basic_text_1"
            android:ellipsize="end"
            android:id="@+id/travel_list_aty_item_travel_data_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/Body_1_Medium"/>
    </LinearLayout>
    <com.obric.oui.text.OBaseTextView
        android:textColor="@color/oui_basic_text_3"
        android:ellipsize="end"
        android:id="@+id/travel_list_aty_item_travel_data_summary_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        style="@style/Body_1_Medium"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp">
        <com.obric.oui.text.OBaseTextView
            android:textColor="@color/oui_basic_text_3"
            android:ellipsize="end"
            android:id="@+id/travel_list_aty_item_travel_data_summary_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginEnd="@dimen/oui_padding_8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/travel_list_aty_item_travel_data_source_and_update_time"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Subtitle_2_Regular"/>
        <com.obric.oui.text.OBaseTextView
            android:textColor="@color/oui_basic_text_3b"
            android:ellipsize="end"
            android:id="@+id/travel_list_aty_item_travel_data_source_and_update_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Subtitle_1_Regular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>
</com.zte.miboard.cards.travel.TravelListItemView>
