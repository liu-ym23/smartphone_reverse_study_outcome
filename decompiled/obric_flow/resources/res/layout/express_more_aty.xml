<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/express_more_search_layout"
        android:paddingTop="@dimen/oui_padding_8dp"
        android:paddingBottom="@dimen/oui_padding_8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/oui_p_list_item_1"
        android:paddingEnd="@dimen/oui_p_list_item_1">
        <LinearLayout
            android:gravity="center_vertical"
            android:background="@drawable/express_more_search_layout_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/oui_h_m2">
            <LinearLayout
                android:gravity="center"
                android:layout_width="@dimen/oui_h_m2"
                android:layout_height="@dimen/oui_h_m2">
                <com.obric.oui.image.OImage
                    android:layout_width="@dimen/card_header_title_drawable_size"
                    android:layout_height="@dimen/card_header_title_drawable_size"
                    android:src="@drawable/oui_icon_oic_magnifier_search"
                    android:tint="@color/oui_basic_text_3"
                    android:tintMode="src_in"
                    app:oui_imageStrokeEnabled="false"/>
            </LinearLayout>
            <com.obric.oui.text.OBaseTextView
                android:textColor="@color/express_more_aty_search_tips_color"
                android:ellipsize="end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/express_search_tips"
                android:maxLines="1"
                android:layout_marginEnd="30dp"
                style="@style/Title_1_Regular"/>
        </LinearLayout>
    </LinearLayout>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/express_more_aty_bind_phone_number_ocard_list_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        app:ocardlistitem_cardType="type_large"
        app:ocardlistitem_defaultTailIcon="tail_arrow"
        app:ocardlistitem_icon="@drawable/express_bind_phone_icon"
        app:ocardlistitem_showCardBg="false"
        app:ocardlistitem_showDivider="true"
        app:ocardlistitem_showIcon="true"
        app:ocardlistitem_showSubTitle="true"
        app:ocardlistitem_showTailIcon="true"
        app:ocardlistitem_subTitle="@string/express_bind_phone_real_number"
        app:ocardlistitem_title="@string/express_bind_phone"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/express_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.obric.oui.orecyclerview.widget.RecyclerView
            android:id="@+id/express_more_aty_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"/>
    </LinearLayout>
</LinearLayout>
