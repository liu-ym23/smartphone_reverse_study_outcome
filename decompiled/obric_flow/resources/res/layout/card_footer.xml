<?xml version="1.0" encoding="utf-8"?>
<com.zte.miboard.cards.common.views.CardFooter xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/card_footer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/oui_padding_10dp"
    android:layout_marginBottom="@dimen/miboard_card_padding_left_right">
    <View
        android:id="@+id/card_footer_title_left_middle_space"
        android:visibility="gone"
        android:layout_width="56dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.obric.oui.button.OButton
        android:id="@+id/card_footer_title_left"
        android:visibility="gone"
        android:layout_width="@dimen/card_footer_btn_width"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/card_footer_title_middle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/OStyleV2.OButton.M.Standard.Neutral"/>
    <View
        android:id="@+id/card_footer_divider_left"
        android:background="@color/transparent"
        android:visibility="gone"
        android:layout_width="@dimen/card_footer_part_line_width"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/card_footer_title_middle"
        app:layout_constraintStart_toEndOf="@+id/card_footer_title_left"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.obric.oui.button.OButton
        android:id="@+id/card_footer_title_middle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/option_more"
        android:layout_marginStart="@dimen/card_footer_margin_start"
        app:layout_constraintEnd_toStartOf="@+id/card_footer_title_right"
        app:layout_constraintStart_toEndOf="@+id/card_footer_title_left"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/OStyleV2.OButton.M.Standard.Neutral"/>
    <View
        android:id="@+id/card_footer_divider_middle"
        android:background="@color/transparent"
        android:visibility="gone"
        android:layout_width="@dimen/card_footer_part_line_width"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/card_footer_title_right"
        app:layout_constraintStart_toEndOf="@+id/card_footer_title_middle"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.obric.oui.button.OButton
        android:id="@+id/card_footer_title_right"
        android:layout_width="@dimen/card_footer_btn_width"
        android:layout_height="wrap_content"
        android:text="@string/option_more"
        android:layout_marginStart="@dimen/card_footer_margin_start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/card_footer_title_middle"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/OStyleV2.OButton.M.Standard.Neutral"/>
</com.zte.miboard.cards.common.views.CardFooter>
