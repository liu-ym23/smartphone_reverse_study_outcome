<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="7dp">
        <com.obric.oui.text.OBaseTextView
            android:textColor="@color/oui_basic_text_3"
            android:id="@+id/travel_card_item_hotel_check_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/travel_card_item_hotel_margin_top"
            android:text="@string/travel_hotel_check_in"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Subtitle_2_Medium"/>
        <com.obric.oui.text.OBaseTextView
            android:textColor="@color/oui_basic_text_1"
            android:id="@+id/travel_card_item_hotel_from_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/travel_card_item_hotel_check_in"
            style="@style/Title_4_Medium"/>
        <com.obric.oui.text.OBaseTextView
            android:textColor="@color/oui_basic_text_3"
            android:id="@+id/travel_card_item_hotel_check_out"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/travel_card_item_hotel_margin_top"
            android:text="@string/travel_hotel_check_out"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Subtitle_2_Medium"/>
        <com.obric.oui.text.OBaseTextView
            android:textColor="@color/oui_basic_text_1"
            android:id="@+id/travel_card_item_hotel_to_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/travel_card_item_hotel_check_out"
            style="@style/Title_4_Medium"/>
        <FrameLayout
            android:id="@+id/travel_card_item_hotel_travel_line_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:forceDarkAllowed="false"
            app:layout_constraintBottom_toBottomOf="@+id/travel_card_item_hotel_from_date"
            app:layout_constraintEnd_toStartOf="@+id/travel_card_item_hotel_to_date"
            app:layout_constraintStart_toEndOf="@+id/travel_card_item_hotel_from_date"
            app:layout_constraintTop_toTopOf="@+id/travel_card_item_hotel_from_date">
            <com.obric.oui.image.OImage
                android:layout_gravity="center_vertical"
                android:id="@+id/travel_card_item_hotel_travel_line_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/travel_card_item_hotel_travel_line_img"
                app:oui_imageStrokeEnabled="false"/>
            <com.obric.oui.text.OBaseTextView
                android:textSize="9dp"
                android:textColor="@color/travel_hotel_title_color"
                android:layout_gravity="center"
                android:id="@+id/travel_card_item_hotel_travel_line_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:lineHeight="9dp"
                android:textFontWeight="@integer/oui_font_weight_medium"/>
        </FrameLayout>
        <com.obric.oui.text.OBaseTextView
            android:textColor="@color/oui_basic_text_3"
            android:ellipsize="end"
            android:id="@+id/travel_card_item_hotel_room_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/travel_card_item_hotel_from_date"
            style="@style/Body_1_Medium"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
