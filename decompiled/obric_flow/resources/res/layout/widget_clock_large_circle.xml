<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/widget_real_content"
        android:background="@drawable/widget_real_content_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="14dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.obric.clockwidgets.ui.CircleClockView
                    android:id="@+id/circle_clock_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/circle_clock_size_4_2_horizontal_margin"/>
                <TextView
                    android:id="@+id/city_name_1"
                    style="@style/circle_clock_large_title"/>
                <TextView
                    android:id="@+id/city_offset_1"
                    style="@style/circle_clock_large_subtitle"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/circle_clock_margin_4_2">
                <com.obric.clockwidgets.ui.CircleClockView
                    android:id="@+id/circle_clock_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/circle_clock_size_4_2_horizontal_margin"/>
                <TextView
                    android:id="@+id/city_name_2"
                    style="@style/circle_clock_large_title"/>
                <TextView
                    android:id="@+id/city_offset_2"
                    style="@style/circle_clock_large_subtitle"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/circle_clock_margin_4_2">
                <com.obric.clockwidgets.ui.CircleClockView
                    android:id="@+id/circle_clock_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/circle_clock_size_4_2_horizontal_margin"/>
                <TextView
                    android:id="@+id/city_name_3"
                    style="@style/circle_clock_large_title"/>
                <TextView
                    android:id="@+id/city_offset_3"
                    style="@style/circle_clock_large_subtitle"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    <TextView
        android:id="@+id/widget_tip_view"
        style="@style/widget_tip_text"/>
</FrameLayout>
