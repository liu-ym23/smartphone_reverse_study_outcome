<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/oui_bg_base_1"
    android:padding="0dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.obric.oui.titlebar.OCTitleBar
            android:id="@+id/debug_company_scene_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:oui_title_text="@string/debug_company_scene_title"
            app:oui_useBackIcon="true"/>
        <ImageButton
            android:layout_gravity="end|center_vertical"
            android:id="@+id/btn_upload"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_upload_bold"
            android:contentDescription="@string/debug_company_upload_desc"/>
    </FrameLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/o_background_list_item"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginHorizontal="15dp">
                <TextView
                    android:id="@+id/tv_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/debug_company_top_hint"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/card_scene_select"
                android:background="@drawable/o_background_list_item"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginHorizontal="15dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RadioButton
                        android:id="@+id/rb_home_arrive"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/debug_scene_home_arrive"
                        android:layout_weight="1"/>
                    <RadioButton
                        android:id="@+id/rb_company_arrive"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/debug_scene_company_arrive"
                        android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <RadioButton
                        android:id="@+id/rb_home_leave"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/debug_scene_home_leave"
                        android:layout_weight="1"/>
                    <RadioButton
                        android:id="@+id/rb_company_leave"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/debug_scene_company_leave"
                        android:layout_weight="1"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp">
                <com.obric.oui.button.OButton
                    android:textSize="18sp"
                    android:id="@+id/btn_start"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:text="@string/debug_company_start_collect_text"
                    style="@style/OButton.M2.Standard.Neutral"/>
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:id="@+id/tv_tag_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/debug_company_tag_subtitle"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/card_tags"
                android:background="@drawable/o_background_list_item"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginHorizontal="15dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/layout_floor_container"
                    android:paddingBottom="5dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/debug_company_floor_label"/>
                    <EditText
                        android:id="@+id/et_floor"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:maxLength="2"
                        android:digits="0123456789"
                        android:inputType="number"
                        android:imeOptions="actionDone"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>
                <com.obric.oui.button.OButton
                    android:textSize="18sp"
                    android:textColor="#ff3b30"
                    android:id="@+id/btn_end"
                    android:paddingTop="6dp"
                    android:paddingBottom="5dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:text="@string/debug_company_end_button_text"
                    style="@style/OButton.M2.Standard.Neutral"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
