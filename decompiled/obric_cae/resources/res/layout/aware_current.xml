<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OCTitleBar
        android:id="@+id/aware_current_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oui_title_text="@string/user_aware_scenario_current"
        app:oui_useBackIcon="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/o_background_list_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp">
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_2"
            android:id="@+id/learning_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/user_aware_aware_learning_details"
            android:layout_marginHorizontal="20dp"
            style="@style/Body_M"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_2"
            android:id="@+id/enter_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/user_aware_enter_time"
            android:layout_marginHorizontal="20dp"
            style="@style/Body_M"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_2"
            android:id="@+id/geofence_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/user_aware_gps_info"
            android:layout_marginHorizontal="20dp"
            style="@style/Body_M"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_2"
            android:id="@+id/wifi_rssi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/user_aware_wifi_rssi"
            android:layout_marginHorizontal="20dp"
            style="@style/Body_M"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_2"
            android:id="@+id/neighbor_wifi_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="@string/user_aware_neighbor_wifi_info"
            android:layout_marginHorizontal="20dp"
            style="@style/Body_M"/>
    </LinearLayout>
    <com.obric.oui.button.OButton
        android:id="@+id/aware_correction_button"
        android:visibility="visible"
        android:clickable="true"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:text="@string/user_aware_scene_correction"
        android:layout_centerInParent="true"
        android:letterSpacing="0.1"
        style="@style/OButton.ListItem.Center"/>
    <com.obric.oui.oswitch.OSwitch
        android:id="@+id/predictSwitch"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:text="@string/user_aware_predict_switch"/>
</LinearLayout>
