<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/view"
        android:background="@color/Transparent"
        android:layout_width="match_parent"
        android:layout_height="58dp"/>
    <com.obric.oui.dialog.alert.view.RadiusLayout
        android:id="@+id/header_container"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:oui_cornerRadiusLeftTop="36dp"
        app:oui_cornerRadiusRightTop="36dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <com.obric.oui.titlebar.OFloatingTitleBar
                android:id="@+id/header_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:oFloatingTitleBar_centerTitle="@string/device_select"/>
            <com.obric.oui.sectiontitlebar.OSectionTitleBar
                android:id="@+id/btn_titlebar"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintTop_toBottomOf="@+id/header_view"
                app:sectionTitle_titleText="@string/bwdl_drop_devices_on_range"
                style="@style/OSectionTitleBar.S"/>
            <ListView
                android:id="@+id/discoveryResultList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@color/Transparent"
                app:layout_constraintBottom_toTopOf="@+id/discovering"
                app:layout_constraintTop_toBottomOf="@+id/btn_titlebar"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/discovering"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/discoveryResultList"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_container"
                app:ocardlistitem_customStart="@layout/layout_card_list_item_discovering"
                app:ocardlistitem_showCardBg="true"/>
            <com.obric.oui.sectiontitlebar.OSectionSupportiveText
                android:id="@+id/title_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="32dp"
                app:layout_constraintTop_toBottomOf="@+id/discovering"
                app:section_des_text="@string/bwdl_drop_discovered_after_turn_on"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.obric.oui.dialog.alert.view.RadiusLayout>
</LinearLayout>
