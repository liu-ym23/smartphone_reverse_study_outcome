<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RadioGroup
        android:orientation="vertical"
        android:id="@+id/radioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RadioButton
            android:id="@+id/enter_home_radio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="进家门"/>
        <RadioButton
            android:id="@+id/exit_home_radio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="出家门"/>
        <RadioButton
            android:id="@+id/enter_company_radio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="进公司"/>
        <RadioButton
            android:id="@+id/exit_company_radio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="出公司"/>
    </RadioGroup>
    <Button
        android:id="@+id/submit_records_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="提交"/>
</LinearLayout>
