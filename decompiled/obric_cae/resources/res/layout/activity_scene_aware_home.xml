<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OCTitleBar
        android:id="@+id/scene_aware_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oui_title_text="@string/user_aware_scene_aware_title"
        app:oui_useBackIcon="true"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/scene_home_aware"
        android:background="@drawable/o_background_list_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        app:oui_list_item_title="@string/user_aware_scenario_title"
        app:oui_list_item_trailing_text=""/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/scene_har_status"
        android:background="@drawable/o_background_list_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="15dp"
        app:oui_list_item_title="@string/user_aware_har_title"
        app:oui_list_item_trailing_text=""/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/scene_subway_status"
        android:background="@drawable/o_background_list_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="15dp"
        app:oui_list_item_title="@string/user_aware_subway_title"
        app:oui_list_item_trailing_text=""/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/scene_near_elevator"
        android:background="@drawable/o_background_list_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="15dp"
        app:oui_list_item_title="@string/user_aware_near_elevator_title"
        app:oui_list_item_trailing_text=""/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/scene_zpp_model"
        android:background="@drawable/o_background_list_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="15dp"
        app:oui_list_item_title="@string/user_aware_zpp_model_title"/>
    <com.obric.oui.lisitem.OListItemSettings
        android:id="@+id/scene_poi_arrival"
        android:background="@drawable/o_background_list_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="15dp"
        app:oui_list_item_title="@string/user_aware_poi_arrival_title"/>
</LinearLayout>
