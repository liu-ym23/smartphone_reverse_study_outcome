<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="24sp"
        android:textStyle="bold"
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="电梯附近识别"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ScrollView
        android:id="@+id/scroll_view"
        android:padding="16dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/buttons_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.75"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_text">
        <TextView
            android:textColor="@android:color/black"
            android:gravity="start"
            android:id="@+id/content_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="这里将显示电梯附近识别的相关信息"/>
    </ScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/new_buttons_layout"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="3"
        app:layout_constraintBottom_toTopOf="@+id/buttons_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scroll_view">
        <Button
            android:id="@+id/load_model_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="加载模型"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"/>
        <Button
            android:id="@+id/identify_error_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="识别错误"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/buttons_layout"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <Button
            android:id="@+id/clear_anchor_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="清空锚点"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"/>
        <Button
            android:id="@+id/create_anchor_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="创建锚点"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"/>
        <Button
            android:id="@+id/check_elevator_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="开始识别"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
