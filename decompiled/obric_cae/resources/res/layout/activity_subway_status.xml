<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OCTitleBar
        android:id="@+id/subway_current_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oui_title_text="记录地铁状态"
        app:oui_useBackIcon="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/date_filter_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/subway_current_title"
        android:layout_marginHorizontal="16dp">
        <com.obric.oui.text.OTextView
            android:textSize="14sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="日期筛选："/>
        <com.obric.oui.text.OTextView
            android:textSize="14sp"
            android:gravity="center_vertical"
            android:id="@+id/date_filter_textview"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:hint="点击选择日期"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="12dp"/>
    </LinearLayout>
    <com.obric.oui.oswitch.OSwitch
        android:id="@+id/subway_feedback_switch"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="16dp"
        android:text="@string/user_aware_subway_feedback_switch"
        android:layout_below="@+id/date_filter_layout"/>
    <ListView
        android:id="@+id/list_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="1dp"
        android:layout_below="@+id/subway_feedback_switch"/>
    <com.obric.oui.text.OTextView
        android:textSize="16sp"
        android:id="@+id/empty_state_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="暂无记录"
        android:layout_centerInParent="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottom_action_bar"
        android:background="@android:color/white"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:elevation="4dp">
        <com.obric.oui.button.OButton
            android:textColor="@color/white"
            android:id="@+id/btn_correct"
            android:background="@color/green_3fc730_100"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="正确"
            android:layout_weight="1"/>
        <com.obric.oui.button.OButton
            android:textColor="@color/white"
            android:id="@+id/btn_incorrect"
            android:background="@color/red_f24c38_40"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="错误"
            android:layout_weight="1"/>
        <com.obric.oui.button.OButton
            android:textColor="@color/black"
            android:id="@+id/btn_cancel"
            android:background="@color/oui_blueish_gray_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="取消"
            android:layout_weight="1"/>
    </LinearLayout>
</RelativeLayout>
