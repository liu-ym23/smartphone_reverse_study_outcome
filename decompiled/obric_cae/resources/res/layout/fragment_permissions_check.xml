<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/oui_bg_base_1"
        android:paddingTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/o_background_list_item"
            android:paddingLeft="16dp"
            android:paddingTop="10dp"
            android:paddingRight="16dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginHorizontal="15dp">
            <TextView
                android:id="@+id/tv_bt_permission"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/debug_perm_bt_label"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/btn_request_bt_permission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/debug_perm_go_authorize"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/o_background_list_item"
            android:paddingLeft="16dp"
            android:paddingTop="10dp"
            android:paddingRight="16dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginHorizontal="15dp">
            <TextView
                android:id="@+id/tv_location_permission"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/debug_perm_location_label"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/btn_request_location_permission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/debug_perm_go_authorize"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/o_background_list_item"
            android:paddingLeft="16dp"
            android:paddingTop="10dp"
            android:paddingRight="16dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginHorizontal="15dp">
            <TextView
                android:id="@+id/tv_mic_permission"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/debug_perm_mic_label"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/btn_request_mic_permission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/debug_perm_go_authorize"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="8dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/o_background_list_item"
            android:paddingLeft="16dp"
            android:paddingTop="10dp"
            android:paddingRight="16dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginHorizontal="15dp">
            <TextView
                android:id="@+id/tv_bt_switch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/debug_switch_bt_label"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/btn_open_bt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/debug_company_go_settings"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/o_background_list_item"
            android:paddingLeft="16dp"
            android:paddingTop="10dp"
            android:paddingRight="16dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginHorizontal="15dp">
            <TextView
                android:id="@+id/tv_location_switch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/debug_switch_location_label"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/btn_open_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/debug_company_go_settings"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/o_background_list_item"
            android:paddingLeft="16dp"
            android:paddingTop="10dp"
            android:paddingRight="16dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginHorizontal="15dp">
            <TextView
                android:id="@+id/tv_wifi_switch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/debug_switch_wifi_label"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/btn_open_wifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/debug_company_go_settings"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp"/>
        <com.obric.oui.button.OButton
            android:enabled="false"
            android:id="@+id/btn_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/debug_perm_enter_entry"
            android:layout_marginHorizontal="15dp"
            style="@style/OButton.M2.Standard.Neutral"/>
    </LinearLayout>
</ScrollView>
