<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OCTitleBar
        android:id="@+id/poi_arrival_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oui_title_text="@string/user_aware_poi_arrival_title"
        app:oui_useBackIcon="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/poi_arrival_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">
        <Button
            android:id="@+id/register_near_poi_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/user_aware_poi_arrival_register"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"/>
        <Button
            android:enabled="false"
            android:id="@+id/unregister_near_poi_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/user_aware_poi_arrival_unregister"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">
        <Button
            android:id="@+id/poi_debug_trigger_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/user_aware_poi_detect_trigger_location"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"/>
        <Button
            android:id="@+id/poi_debug_bypass_near_poi_check"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/user_aware_poi_detect_bypass_near_poi_check_off"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_aware_poi_stationary_delay_label"/>
        <EditText
            android:id="@+id/poi_stationary_delay_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/user_aware_poi_stationary_delay_hint"
            android:maxLines="1"
            android:singleLine="true"
            android:layout_weight="1"
            android:inputType="number"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
        <Button
            android:id="@+id/poi_apply_stationary_delay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_aware_poi_stationary_delay_apply"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/poi_detect_state_container"
        android:background="@color/oui_bg_base_1"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:id="@+id/poi_detect_state_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/user_aware_poi_detect_state_title"/>
        <LinearLayout
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="@android:color/black"
                android:id="@+id/poi_detect_state_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/user_aware_poi_detect_state_unknown"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@android:color/darker_gray"
                android:id="@+id/poi_detect_state_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12sp"
                android:textColor="@android:color/darker_gray"
                android:id="@+id/poi_detect_category_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/user_aware_poi_detect_category_title"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@android:color/black"
                android:id="@+id/poi_detect_category_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/user_aware_poi_detect_category_unknown"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12sp"
                android:textColor="@android:color/darker_gray"
                android:id="@+id/poi_detect_stationary_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/user_aware_poi_detect_stationary_title"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@android:color/black"
                android:id="@+id/poi_detect_stationary_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/user_aware_poi_detect_state_unknown"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:paddingTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/user_aware_poi_detect_state_debug_title"/>
        <LinearLayout
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/poi_debug_state_stopped"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/user_aware_poi_detect_state_stopped"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"/>
            <Button
                android:id="@+id/poi_debug_state_inside"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/user_aware_poi_detect_state_inside"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"/>
            <Button
                android:id="@+id/poi_debug_state_monitoring"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/user_aware_poi_detect_state_monitoring"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/poi_debug_state_sit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/user_aware_poi_detect_state_energy_saving_sit"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"/>
            <Button
                android:id="@+id/poi_debug_state_walk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/user_aware_poi_detect_state_energy_saving_walk"
                android:layout_weight="1"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>
    <ScrollView
        android:id="@+id/poi_arrival_scroll_view"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/poi_arrival_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:textColor="@android:color/black"
                android:id="@+id/poi_arrival_empty_text"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/user_aware_poi_arrival_empty"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
