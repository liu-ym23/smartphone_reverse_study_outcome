<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OCTitleBar
        android:id="@+id/store_arrival_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oui_title_text="@string/user_aware_store_arrival_title"
        app:oui_useBackIcon="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/store_arrival_date_filter_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="日期筛选："/>
        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:gravity="center_vertical"
            android:id="@+id/store_arrival_date_filter_text"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:hint="点击选择日期"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="12dp"/>
    </LinearLayout>
    <ScrollView
        android:id="@+id/store_arrival_scroll_view"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/store_arrival_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:textColor="@android:color/black"
                android:id="@+id/store_arrival_empty_text"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/user_aware_store_arrival_empty"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
