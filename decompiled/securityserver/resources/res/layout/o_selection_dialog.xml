<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/oui_dialog_header_container_padding_h"
            android:paddingVertical="@dimen/oui_dialog_header_container_padding_v">
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_basic_text_1"
                android:gravity="center"
                android:id="@+id/selection_dialog_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                style="@style/Title_1_Bold"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_basic_text_1"
                android:gravity="center"
                android:id="@+id/selection_dialog_sub_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="2"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                style="@style/Body_1_Regular"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/selection_dialog_body_container"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"/>
    <FrameLayout
        android:id="@+id/selection_dialog_btn_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/o_dialog_button_horizontal"/>
    </FrameLayout>
</LinearLayout>
