<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.layout.OUILinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/searchbar_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/left_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"/>
    <com.obric.oui.forms.OEditText
        android:textColor="@color/oui_basic_text_1"
        android:textColorHint="@color/oui_basic_text_4"
        android:gravity="center_vertical"
        android:id="@+id/input_view"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:layout_weight="1"
        android:textCursorDrawable="@drawable/oui_searchbar_cursor"
        app:layout_goneMarginEnd="0dp"
        app:layout_goneMarginStart="0dp"
        style="@style/Title_1_Medium"/>
    <FrameLayout
        android:id="@+id/clear_action_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/oic_xmark_circle_fill"
            app:tint="@color/oui_basic_text_4"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/right_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"/>
</com.obric.oui.layout.OUILinearLayout>
