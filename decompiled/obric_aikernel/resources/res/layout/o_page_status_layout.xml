<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/content_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="30dp">
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_basic_text_3"
            android:ellipsize="end"
            android:id="@+id/status_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/Title_3_Medium"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_basic_text_3b"
            android:ellipsize="end"
            android:id="@+id/status_message"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            style="@style/Subtitle_3_Regular"/>
        <com.obric.oui.button.OButton
            android:id="@+id/status_button"
            android:visibility="gone"
            android:clickable="true"
            android:layout_marginTop="20dp"
            style="@style/OStyleV2.OButton.S.Standard.Neutral"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/loading_container"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</merge>
