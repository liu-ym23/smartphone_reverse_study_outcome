<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.dialog.alert.view.RadiusLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_constraint"
    android:background="@color/oui_bg_base_2_1_low_elevation"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:oui_cornerRadiusLeftTop="@dimen/oui_r_l2"
    app:oui_cornerRadiusRightTop="@dimen/oui_r_l2">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/scaffold_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.obric.oui.sheet.OSheetContentFrameLayout
            android:id="@+id/body_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/footer_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</com.obric.oui.dialog.alert.view.RadiusLayout>
