<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.layout.OUILinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/list_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:paddingStart="12dp"
    android:paddingEnd="4dp">
    <FrameLayout
        android:id="@+id/list_leading_element"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingVertical="10dp">
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_1"
            android:ellipsize="end"
            android:id="@+id/list_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/Title_1_Regular"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_text_3"
            android:ellipsize="end"
            android:id="@+id/list_item_subtitle"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            style="@style/Subtitle_2_Regular"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/list_trailing_element"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</com.obric.oui.layout.OUILinearLayout>
