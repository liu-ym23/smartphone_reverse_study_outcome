<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_list_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.oui.swipeaction.OSwipeLayout
        android:gravity="center_vertical"
        android:id="@+id/swipe_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oui_show_mode="pull_out">
        <FrameLayout
            android:id="@+id/swip_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/swipe_surface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/card_container"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.layout.OUILinearLayout
                    android:gravity="center_vertical"
                    android:id="@+id/content_container"
                    android:background="@drawable/o_card_list_item_content_bg"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingEnd="4dp">
                    <FrameLayout
                        android:id="@+id/custom_start_container"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <FrameLayout
                        android:id="@+id/icon_container"
                        android:padding="10dp"
                        android:visibility="gone"
                        android:layout_width="48dp"
                        android:layout_height="48dp">
                        <ImageView
                            android:id="@+id/icon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"/>
                    </FrameLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/title_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp"
                        android:paddingVertical="10dp"
                        app:layout_constrainedWidth="true">
                        <com.obric.oui.text.OTextView
                            android:textColor="@color/oui_basic_text_1"
                            android:ellipsize="end"
                            android:id="@+id/title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textFontWeight="400"
                            style="@style/Title_1_Regular"/>
                        <com.obric.oui.text.OTextView
                            android:textColor="@color/oui_basic_text_3"
                            android:ellipsize="end"
                            android:id="@+id/sub_title"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:maxLines="3"
                            style="@style/Subtitle_2_Regular"/>
                    </LinearLayout>
                    <FrameLayout
                        android:id="@+id/custom_end_container"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <ImageView
                        android:id="@+id/tail_icon"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </com.obric.oui.layout.OUILinearLayout>
            </FrameLayout>
        </FrameLayout>
    </com.obric.oui.swipeaction.OSwipeLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/card_divider"
        android:background="@color/ShadowInverse"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.6dp"/>
</FrameLayout>
