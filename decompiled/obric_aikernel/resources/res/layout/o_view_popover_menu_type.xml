<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <com.obric.oui.popover.MaxHeightNestedScrollView
        android:scrollbarThumbVertical="@drawable/o_popover_scrollbar_thumb"
        android:id="@+id/popover_scroll"
        android:scrollbars="vertical"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="@dimen/oui_popover_max_height"
        android:fillViewport="true"
        android:fadeScrollbars="true"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/top_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:gravity="start"
                android:orientation="vertical"
                android:id="@+id/popover_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </com.obric.oui.popover.MaxHeightNestedScrollView>
</merge>
