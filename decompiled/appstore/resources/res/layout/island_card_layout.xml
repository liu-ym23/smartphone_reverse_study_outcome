<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:id="@+id/island_card"
    android:background="@drawable/island_card_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/dp_16"
    android:paddingVertical="@dimen/dp_16">
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/island_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_4">
            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="@dimen/dp_18"
                android:layout_height="@dimen/dp_18"
                android:src="@drawable/island_prompt"
                android:scaleType="centerInside"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="@string/island_tip"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/island_icon"
                android:layout_width="@dimen/dp_56"
                android:layout_height="@dimen/dp_56"
                android:scaleType="centerInside"
                android:layout_centerVertical="true"/>
            <FrameLayout
                android:id="@+id/island_action_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true">
                <Button
                    android:textStyle="bold"
                    android:textColor="@color/island_accent_default"
                    android:gravity="center"
                    android:id="@+id/island_action"
                    android:background="@drawable/island_button_bg_accent_6"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_32"
                    android:paddingHorizontal="@dimen/dp_12"
                    android:paddingVertical="@dimen/dp_6"/>
                <Button
                    android:textStyle="bold"
                    android:textColor="@color/island_accent_6"
                    android:gravity="center"
                    android:id="@+id/island_action_disable"
                    android:background="@drawable/island_button_bg_accent_2"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_32"
                    android:alpha="0.3"
                    android:paddingHorizontal="@dimen/dp_12"
                    android:paddingVertical="@dimen/dp_6"/>
                <Button
                    android:textStyle="bold"
                    android:textColor="@color/island_text_2"
                    android:gravity="center"
                    android:id="@+id/island_action_error"
                    android:background="@drawable/island_button_bg_fill_element_2"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_32"
                    android:paddingHorizontal="@dimen/dp_12"
                    android:paddingVertical="@dimen/dp_6"/>
                <ProgressBar
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/island_progress"
                    android:background="@drawable/island_progress_paused_bg"
                    android:layout_width="@dimen/dp_36"
                    android:layout_height="@dimen/dp_36"
                    android:indeterminate="false"
                    style="@style/island_progress"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_56"
                android:layout_toLeftOf="@+id/island_action_container"
                android:layout_toRightOf="@+id/island_icon"
                android:layout_marginHorizontal="@dimen/dp_12">
                <TextView
                    android:textSize="@dimen/textSize16"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:id="@+id/island_app_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="@dimen/textSize12"
                        android:textColor="#73ffffff"
                        android:ellipsize="end"
                        android:id="@+id/island_app_category"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"/>
                    <TextView
                        android:textSize="@dimen/textSize12"
                        android:textColor="#ff3333"
                        android:id="@+id/island_fail_des"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent">
                            <ImageView
                                android:id="@+id/island_app_score_star_1"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/island_star_filled_yellow"
                                android:layout_weight="1"/>
                            <ImageView
                                android:id="@+id/island_app_score_star_2"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/island_star_filled_yellow"
                                android:layout_weight="1"/>
                            <ImageView
                                android:id="@+id/island_app_score_star_3"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/island_star_filled_yellow"
                                android:layout_weight="1"/>
                            <ImageView
                                android:id="@+id/island_app_score_star_4"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/island_star_filled_yellow_half"
                                android:layout_weight="1"/>
                            <ImageView
                                android:id="@+id/island_app_score_star_5"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/island_star_filled_gray"
                                android:layout_weight="1"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="@dimen/textSize10"
                            android:textStyle="bold"
                            android:textColor="#ccffffff"
                            android:id="@+id/island_app_score"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp_4"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</FrameLayout>
