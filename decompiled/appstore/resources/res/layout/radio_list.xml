<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.segmentedtab.OTabSegmentedLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/radiogroup"
        android:layout_width="match_parent"
        android:layout_height="@dimen/oui_h_m2"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="20dp"
        app:bar_color="@color/oui_fill_sunken_variable"
        app:bar_stroke_color="@color/Transparent"
        app:indicator_anim_enable="true"
        app:indicator_color="@color/oui_bg_base_3_high_elevation"
        app:indicator_corner_radius="@dimen/oui_r_m1"
        app:indicator_height="@dimen/oui_h_m1"
        app:indicator_spacing="4dp"
        app:tab_textBold="SELECT"
        app:tab_textSelectColor="@color/oui_text_1"
        app:tab_textSize="14dp"
        app:tab_textUnselectColor="@color/oui_text_3"/>
    <com.obric.oui.divider.ODivider
        android:id="@+id/line"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.66dp"
        android:layout_below="@+id/radiogroup"/>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/line"/>
</RelativeLayout>
