<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/ll_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="18dp">
    <com.bytedanceos.appstore.buss.widget.VideoView
        android:id="@+id/iv_video"
        android:layout_width="@dimen/tv_item_horizontal_width"
        android:layout_height="@dimen/tv_item_sub_video_height"
        android:layout_marginLeft="@dimen/tv_app_item_padding_left"
        android:layout_marginRight="@dimen/tv_app_item_padding_left"/>
    <com.bytedanceos.appstore.buss.widget.app.item.ItemSubView
        android:id="@+id/tv_sub_view_in_video"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/tv_app_item_padding_left"
        android:layout_marginRight="@dimen/tv_app_item_padding_left"/>
</LinearLayout>
