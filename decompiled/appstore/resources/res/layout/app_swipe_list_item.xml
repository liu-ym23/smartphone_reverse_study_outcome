<?xml version="1.0" encoding="utf-8"?>
<com.bytedanceos.common.ui.widget.SwipeItemView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:minHeight="64dp"
    android:importantForAccessibility="no">
    <RelativeLayout
        android:id="@+id/myapp_lay"
        android:background="@color/oui_bg_base_1"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/checkBoxFrame"
            android:visibility="gone"
            android:layout_width="@dimen/swipe_item_checkbox_width"
            android:layout_height="match_parent">
            <CheckBox
                android:layout_gravity="center_vertical"
                android:id="@+id/checkBox"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/checkbox_margin"
                android:button="@drawable/checkbox"/>
        </FrameLayout>
        <com.obric.oui.layout.OUIRelativeLayout
            android:id="@+id/forground_layout"
            android:paddingRight="12dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:oui_radius="@dimen/oui_r_l3_rect">
            <com.bytedanceos.common.network.widget.NetworkImageView
                android:id="@+id/appIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="12dp"
                android:src="@drawable/oui_default_app_icon"
                android:contentDescription="@null"
                style="@style/app_list_icon_style"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:layout_toLeftOf="@+id/appStatusLay"
                android:layout_toRightOf="@+id/appIcon"
                android:layout_centerVertical="true"
                android:layout_marginVertical="8dp">
                <TextView
                    android:textColor="@color/oui_text_0"
                    android:ellipsize="end"
                    android:id="@+id/appName"
                    android:paddingTop="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    style="@style/Label_L"/>
                <TextView
                    android:textColor="@color/oui_text_2"
                    android:ellipsize="end"
                    android:id="@+id/appCategory"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    style="@style/Label_M_Thin"/>
                <ImageView
                    android:id="@+id/appRate"
                    style="@style/oui_app_list_brief_rate_style"/>
                <TextView
                    android:textColor="@color/oui_text_3"
                    android:ellipsize="end"
                    android:id="@+id/appBrief"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxWidth="@dimen/app_item_name_max_width"
                    android:maxLines="1"
                    style="@style/Label_S_Thin"/>
                <TextView
                    android:textColor="@color/oui_text_3b"
                    android:ellipsize="end"
                    android:id="@+id/appVersionName"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="12dp"
                    android:maxWidth="@dimen/app_item_name_max_width"
                    android:maxLines="1"
                    style="@style/Label_S_Thin"/>
            </LinearLayout>
            <com.bytedanceos.common.ui.widget.oui.OUIAppStatusView
                android:id="@+id/appStatusLay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="32dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
            <com.obric.oui.divider.ODivider
                android:layout_width="match_parent"
                android:layout_height="0.66dp"
                android:layout_toRightOf="@+id/appIcon"
                android:layout_alignParentBottom="true"/>
        </com.obric.oui.layout.OUIRelativeLayout>
    </RelativeLayout>
</com.bytedanceos.common.ui.widget.SwipeItemView>
