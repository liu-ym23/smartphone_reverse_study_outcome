<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/inline_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_inline_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/coachmark_icon_oic_info_circle"
            app:tint="@color/oui_text_3"/>
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_basic_text_3"
            android:ellipsize="end"
            android:id="@+id/tv_inline_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            style="@style/Body_1_Regular"/>
        <com.obric.oui.button.OButton
            android:id="@+id/btn_inline_action"
            android:visibility="gone"
            android:layout_width="66dp"
            android:layout_height="@dimen/oui_h_m1"
            android:minWidth="@dimen/oui_mw_button_m1"
            android:minHeight="0dp"
            android:text="Action"
            android:layout_marginStart="8dp"
            style="@style/OStyleV2.OButton.S.Trans.Primary"/>
        <com.obric.oui.button.OIconButton
            android:id="@+id/btn_inline_dismiss"
            android:padding="7dp"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="@dimen/oui_h_m1"
            android:src="@drawable/coachmark_icon_oic_xmark"
            android:tint="@color/oui_fill_icon_as_action"
            android:minWidth="@dimen/oui_mw_button_m1"
            android:contentDescription="@string/oui_iv_close_desc"
            android:layout_marginStart="8dp"
            style="@style/OIconButton.M1.Trans.Understated"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/multi_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/multi_leading_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_multi_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/coachmark_icon_oic_info_circle"
                app:tint="@color/oui_text_3"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/multi_text_group"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp">
                <com.obric.oui.text.OTextView
                    android:textColor="@color/oui_basic_text_3"
                    android:id="@+id/tv_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Body_1_Regular"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:id="@+id/multi_actions"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="8dp">
            <com.obric.oui.button.OButton
                android:id="@+id/btn_multi_dismiss"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/oui_h_m1"
                android:minWidth="@dimen/oui_mw_button_m1"
                android:minHeight="0dp"
                android:text="Dismiss"
                style="@style/OStyleV2.OButton.S.Trans.Neutral"/>
            <com.obric.oui.button.OButton
                android:id="@+id/btn_multi_action"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/oui_h_m1"
                android:minWidth="@dimen/oui_mw_button_m1"
                android:minHeight="0dp"
                android:text="Action"
                android:layout_marginStart="12dp"
                style="@style/OStyleV2.OButton.S.Trans.Primary"/>
        </LinearLayout>
    </LinearLayout>
</merge>
