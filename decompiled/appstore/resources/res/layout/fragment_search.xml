<?xml version="1.0" encoding="utf-8"?>
<com.bytedanceos.common.ui.widget.VerticalScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="8dp"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="always">
    <RelativeLayout
        android:id="@+id/search_history_ly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedanceos.common.ui.widget.AppGroupView
            android:id="@+id/rv_search_hot_apps"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.obric.oui.divider.ODivider
            android:id="@+id/div_line_1"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.66dp"
            android:layout_below="@+id/rv_search_hot_apps"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="16dp"/>
        <com.bytedanceos.common.ui.widget.FlowLayout
            android:textColor="@android:color/white"
            android:id="@+id/flow_pop_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/search_recommend_flow_layout_margin_left"
            android:layout_marginTop="@dimen/search_recommend_flow_layout_vertical_margin"
            android:layout_marginRight="@dimen/search_recommend_flow_layout_margin_right"
            android:layout_marginBottom="@dimen/search_recommend_flow_layout_vertical_margin"
            android:layout_below="@+id/div_line_1"
            app:flChildSpacing="@dimen/search_recommend_flow_layout_child_space"
            app:flChildSpacingForLastRow="align"
            app:flMinChildSpacing="@dimen/search_recommend_flow_layout_min_child_space"
            app:flRowSpacing="@dimen/search_recommend_flow_layout_row_space"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/flow_layout_container"
            android:paddingLeft="@dimen/search_recommend_flow_layout_margin_left"
            android:paddingTop="@dimen/search_recommend_flow_layout_vertical_margin"
            android:paddingRight="@dimen/search_recommend_flow_layout_margin_right"
            android:paddingBottom="@dimen/search_recommend_flow_layout_vertical_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_below="@+id/flow_pop_layout">
            <com.bytedanceos.common.ui.widget.FlowLayout
                android:textColor="@android:color/white"
                android:id="@+id/flow_layout"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:flChildSpacing="@dimen/search_recommend_flow_layout_child_space"
                app:flChildSpacingForLastRow="align"
                app:flMinChildSpacing="@dimen/search_recommend_flow_layout_min_child_space"
                app:flRowSpacing="@dimen/search_recommend_flow_layout_row_space"/>
            <ImageView
                android:id="@+id/clear_history"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="11dp"
                android:src="@drawable/oui_icon_close"
                android:contentDescription="@string/delete_search_history"/>
        </LinearLayout>
        <com.obric.oui.divider.ODivider
            android:id="@+id/div_line_3"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.66dp"
            android:layout_below="@+id/flow_layout_container"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="16dp"/>
        <com.bytedanceos.common.ui.widget.AppGroupView
            android:id="@+id/search_group1"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/div_line_3"/>
        <com.obric.oui.divider.ODivider
            android:id="@+id/div_line_4"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.66dp"
            android:layout_below="@+id/search_group1"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="16dp"/>
        <com.bytedanceos.common.ui.widget.AppGroupView
            android:id="@+id/search_group2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/div_line_4"/>
        <com.obric.oui.divider.ODivider
            android:id="@+id/div_line_5"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.66dp"
            android:layout_below="@+id/search_group2"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="16dp"/>
        <com.bytedanceos.common.ui.widget.AppGroupView
            android:id="@+id/search_group3"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/div_line_5"/>
    </RelativeLayout>
</com.bytedanceos.common.ui.widget.VerticalScrollView>
