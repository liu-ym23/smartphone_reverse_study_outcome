<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="18dp"
    android:paddingRight="18dp"
    android:layout_width="match_parent"
    android:layout_height="76dp">
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/downloading_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <TextView
            android:textSize="12.5dp"
            android:textColor="#aaaaaa"
            android:id="@+id/auto_downloading_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"/>
        <TextView
            android:textColor="#aaaaaa"
            android:id="@+id/auto_progress_des"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_progress_des"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <ProgressBar
        android:id="@+id/auto_progressbar"
        android:layout_width="match_parent"
        android:layout_height="49px"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:max="100"
        android:layout_weight="1"
        android:layout_below="@+id/downloading_view"
        style="?android:attr/progressBarStyleHorizontal"/>
</RelativeLayout>
