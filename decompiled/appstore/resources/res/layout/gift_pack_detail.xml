<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedanceos.common.network.widget.NetworkImageView
                android:id="@+id/gift_logo"
                android:layout_margin="@dimen/gift_detail_icon_margin"
                android:contentDescription="@null"
                style="@style/appinfo_header_icon_style"/>
            <TextView
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/gift_name"
                android:layout_marginTop="@dimen/gift_detail_icon_margin"
                android:singleLine="true"
                android:layout_toRightOf="@+id/gift_logo"
                style="@style/appinfo_header_name_style"/>
            <TextView
                android:id="@+id/game_count"
                android:singleLine="true"
                android:layout_below="@+id/gift_name"
                android:layout_alignLeft="@+id/gift_name"
                style="@style/appinfo_header_category_style"/>
            <ImageView
                android:id="@+id/game_line"
                android:background="@drawable/line"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@+id/gift_logo"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/game_des"
                android:background="@drawable/game_gift_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/game_line">
                <RelativeLayout
                    android:id="@+id/game_time_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="30dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginRight="30dp">
                    <ImageView
                        android:id="@+id/game_time_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/game_gift_time"
                        android:scaleType="fitXY"/>
                    <TextView
                        android:id="@+id/game_time_title"
                        android:text="@string/gift_expiry_data"
                        android:layout_toRightOf="@+id/game_time_icon"
                        style="@style/game_gift_title_style"/>
                    <TextView
                        android:id="@+id/game_time_content"
                        android:layout_below="@+id/game_time_title"
                        android:layout_alignLeft="@+id/game_time_title"
                        style="@style/game_gift_content_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/game_gift_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="30dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="30dp">
                    <ImageView
                        android:id="@+id/game_gift_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/game_gift_content"
                        android:scaleType="fitXY"/>
                    <TextView
                        android:id="@+id/game_gift_title"
                        android:text="@string/gift_summary"
                        android:layout_toRightOf="@+id/game_gift_icon"
                        style="@style/game_gift_title_style"/>
                    <TextView
                        android:id="@+id/game_gift_content"
                        android:layout_below="@+id/game_gift_title"
                        android:layout_alignLeft="@+id/game_gift_title"
                        style="@style/game_gift_content_style"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="30dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="30dp"
                    android:layout_marginBottom="20dp">
                    <ImageView
                        android:id="@+id/game_instuction_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/game_gift_instuction"
                        android:scaleType="fitXY"/>
                    <TextView
                        android:id="@+id/game_instuction_title"
                        android:text="@string/gift_instructions"
                        android:layout_toRightOf="@+id/game_instuction_icon"
                        style="@style/game_gift_title_style"/>
                    <TextView
                        android:id="@+id/game_instuction_content"
                        android:layout_below="@+id/game_instuction_title"
                        android:layout_alignLeft="@+id/game_instuction_title"
                        style="@style/game_gift_content_style"/>
                </RelativeLayout>
            </LinearLayout>
        </RelativeLayout>
    </ScrollView>
</RelativeLayout>
