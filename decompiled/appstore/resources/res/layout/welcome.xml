<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/ll_welcome_bottom"
        android:overScrollMode="never"
        android:paddingHorizontal="8dp"/>
    <ImageView
        android:background="@drawable/icon_welcome_bottom_shadow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/ll_welcome_bottom"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_welcome_bottom"
        android:background="@color/oui_bg_base_2_1_low_elevation"
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:layout_alignParentBottom="true">
        <com.obric.oui.actionbar.OBottomActionBar
            android:id="@+id/btn_install"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:oui_buttonLastPrimary="true"
            app:oui_buttonStyle="l1-primary"/>
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.checkbox.OCheckBox
                android:id="@+id/checkbox_auto_update"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="7dp"
                app:oui_checkedState="checked"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:text="@string/open_auto_update_of_wlan"
                style="@style/Label_L"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
