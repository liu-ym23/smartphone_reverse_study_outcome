<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_main"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_nav"
        android:background="#ededed"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/divider"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="@+id/search_bar"
        app:layout_constraintTop_toBottomOf="@+id/search_bar"/>
    <View
        android:id="@+id/divider"
        android:background="#dfdfdf"
        android:layout_width="@dimen/tv_nav_width"
        android:layout_height="0.67dp"
        app:layout_constraintBottom_toTopOf="@+id/iv_setting_layout"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <FrameLayout
        android:id="@+id/iv_setting_layout"
        android:background="#f7f7f7"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_48"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="@+id/recycler_view_nav">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_setting"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:src="@drawable/lkp_setting"
            android:tint="#66000000"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/fl_container"
        android:background="#fafafa"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/recycler_view_nav"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ViewFlipper
        android:id="@+id/vf_search"
        android:paddingLeft="@dimen/dp_42"
        android:paddingRight="@dimen/dp_42"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_30"
        android:inAnimation="@anim/push_up_in"
        android:outAnimation="@anim/push_up_out"
        android:flipInterval="4000"
        android:elevation="@dimen/dp_40"
        app:layout_constraintBottom_toBottomOf="@+id/search_bar"
        app:layout_constraintLeft_toLeftOf="@+id/search_bar"
        app:layout_constraintRight_toRightOf="@+id/search_bar"
        app:layout_constraintTop_toTopOf="@+id/search_bar"/>
    <View
        android:id="@+id/line_view"
        android:background="@color/black_60"
        android:layout_width="@dimen/tv_nav_line_view_w"
        android:layout_height="@dimen/dp_0"
        android:alpha="0.1"
        android:elevation="@dimen/dp_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/fl_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/imageView8"
        android:background="@drawable/lkp_appstore_toolbar_shadow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <View
        android:id="@+id/default_toolbar"
        android:background="@drawable/title_bar_bg"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_48"
        app:layout_constraintEnd_toEndOf="parent"/>
</FrameLayout>
