<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:bytedance="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/lkp_setting_background"
    android:paddingTop="@dimen/dp_20"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never">
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/activity_list_content_item"
        android:paddingBottom="@dimen/dp_14"
        android:layout_width="@dimen/lkp_setting_width"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/tv_user_info"
            layout="@layout/tv_item_setting_user_info"/>
        <TextView
            android:textSize="@dimen/textSize14"
            android:textColor="#80000000"
            android:paddingLeft="@dimen/dp_30"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginBottom="@dimen/dp_6"
            android:text="@string/settings_options"/>
        <TextView
            android:textSize="@dimen/textSize14"
            android:textColor="#80000000"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            android:layout_marginBottom="@dimen/dp_16"
            android:text="@string/receive_notification"/>
        <TextView
            android:textSize="@dimen/textSize14"
            android:textColor="#80000000"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            android:layout_marginBottom="16dp"
            android:text="@string/new_version_notification"/>
        <TextView
            android:textSize="@dimen/textSize14"
            android:textColor="#80000000"
            android:gravity="center"
            android:id="@+id/enable_events_sender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            android:layout_marginBottom="@dimen/dp_16"
            android:text="@string/settings_show_image_alert"/>
    </LinearLayout>
</ScrollView>
