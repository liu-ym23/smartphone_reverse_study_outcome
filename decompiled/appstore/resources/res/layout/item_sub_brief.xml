<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:background="@color/recommend_page_bkgcolor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/appinfo_des_text_size"
        android:textColor="@color/appinfo_des_color"
        android:ellipsize="end"
        android:id="@+id/tv_brief"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/item_padding_hor"
        android:layout_marginTop="16dp"
        android:layout_marginRight="@dimen/item_padding_hor"
        android:layout_marginBottom="16dp"
        android:maxLines="4"
        android:includeFontPadding="false"
        android:lineSpacingExtra="3dp"/>
</LinearLayout>
