<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="@dimen/dp_90"
        android:layout_height="@dimen/dp_90"
        android:layout_marginTop="@dimen/dp_22"
        android:scaleType="fitXY"
        android:layout_marginStart="@dimen/tv_app_item_padding_left"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/textSize17"
        android:textStyle="bold"
        android:textColor="#cc000000"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        app:layout_constraintLeft_toRightOf="@+id/iv_logo"
        app:layout_constraintStart_toEndOf="@+id/iv_logo"
        app:layout_constraintTop_toTopOf="@+id/iv_logo"/>
    <TextView
        android:textSize="@dimen/textSize12"
        android:textStyle="bold"
        android:textColor="#5079d9"
        android:gravity="center"
        android:id="@+id/tv_company"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_1"
        app:layout_constraintLeft_toLeftOf="@+id/tv_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"/>
    <ImageView
        android:id="@+id/iv_rating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tv_size"
        app:layout_constraintLeft_toLeftOf="@+id/tv_name"
        app:layout_constraintTop_toTopOf="@+id/tv_size"/>
    <View
        android:id="@+id/line_view"
        android:background="#1a000000"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_marginLeft="7dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_size"
        app:layout_constraintLeft_toRightOf="@+id/iv_rating"
        app:layout_constraintTop_toTopOf="@+id/tv_size"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_app_rate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="iv_rating,line_view"/>
    <TextView
        android:textSize="@dimen/textSize10"
        android:textColor="#66000000"
        android:id="@+id/tv_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_5"
        android:layout_marginStart="@dimen/dp_8"
        app:layout_constraintLeft_toRightOf="@+id/line_view"
        app:layout_constraintTop_toBottomOf="@+id/tv_company"
        app:layout_goneMarginStart="0dp"/>
    <TextView
        android:textSize="@dimen/textSize10"
        android:textColor="#3965cc"
        android:gravity="center_vertical"
        android:id="@+id/tv_play"
        android:background="@drawable/tv_app_detail_type_shape"
        android:paddingLeft="@dimen/dp_8"
        android:paddingRight="@dimen/dp_8"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_7"
        app:layout_constraintLeft_toLeftOf="@+id/tv_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_size"/>
    <TextView
        android:id="@+id/label_1"
        android:layout_marginLeft="@dimen/label_interval"
        android:layout_marginEnd="@dimen/tv_app_item_padding_left"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_name"
        style="@style/app_list_first_pub_style"/>
    <TextView
        android:id="@+id/label_0"
        android:layout_marginRight="3.75dp"
        app:layout_constraintBottom_toBottomOf="@+id/label_1"
        app:layout_constraintRight_toLeftOf="@+id/label_1"
        app:layout_constraintTop_toTopOf="@+id/label_1"
        style="@style/app_list_first_pub_style"/>
    <com.bytedanceos.common.ui.widget.AppStatusView
        android:id="@+id/appStatusLay"
        android:layout_width="@dimen/app_navigation_install_btn_width"
        app:layout_constraintBottom_toBottomOf="@+id/tv_play"
        app:layout_constraintRight_toRightOf="parent"
        style="@style/app_list_item_style"/>
    <View
        android:id="@+id/fg_app_detail_line_view1"
        android:background="#14000000"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_23"
        android:layout_marginEnd="@dimen/dp_24"
        app:layout_constraintLeft_toLeftOf="@+id/iv_logo"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_play"/>
</androidx.constraintlayout.widget.ConstraintLayout>
