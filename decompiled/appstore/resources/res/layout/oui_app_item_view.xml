<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_list_item"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <TextView
        android:textColor="@color/oui_text_0"
        android:gravity="center"
        android:id="@+id/app_index"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Label_L"/>
    <com.bytedanceos.common.network.widget.NetworkImageView
        android:id="@+id/appIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="12dp"
        android:src="@drawable/oui_default_app_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/app_index"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/appInfoContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/appStatusLay"
        app:layout_constraintLeft_toRightOf="@+id/appIcon"
        app:layout_constraintRight_toLeftOf="@+id/appStatusLay"
        app:layout_constraintStart_toEndOf="@+id/appIcon"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="@color/oui_text_1"
            android:ellipsize="end"
            android:id="@+id/appName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/app_item_name_max_width"
            android:maxLines="1"
            android:includeFontPadding="false"
            style="@style/Label_L"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/oui_text_2"
                android:ellipsize="end"
                android:id="@+id/appCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/app_item_name_max_width"
                android:maxLines="1"
                android:includeFontPadding="false"
                style="@style/Label_M_Thin"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/app_tag_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
        </LinearLayout>
        <TextView
            android:textColor="@color/oui_text_3b"
            android:ellipsize="end"
            android:id="@+id/appBrief"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/app_item_name_max_width"
            android:maxLines="1"
            android:includeFontPadding="false"
            style="@style/Label_S_Thin"/>
        <ImageView
            android:id="@+id/appRate"
            style="@style/oui_app_list_brief_rate_style"/>
    </LinearLayout>
    <com.bytedanceos.common.ui.widget.oui.OUIAppStatusView
        android:id="@+id/appStatusLay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="8dp"
        android:minWidth="52dp"
        android:minHeight="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.obric.oui.divider.ODivider
        android:id="@+id/line"
        android:layout_width="0dp"
        android:layout_height="0.66dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/appIcon"
        app:layout_constraintStart_toEndOf="@+id/appIcon"/>
</merge>
