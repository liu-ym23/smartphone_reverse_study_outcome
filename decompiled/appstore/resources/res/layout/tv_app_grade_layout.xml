<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/tv_item_horizontal_width"
    android:layout_height="@dimen/dp_79"
    android:layout_marginLeft="@dimen/dp_24">
    <FrameLayout
        android:id="@+id/common_grade_layout"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <TextView
            android:textSize="@dimen/textSize14"
            android:textColor="#66000000"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_no_comment_tip"
            android:visibility="gone"
            android:layout_width="@dimen/tv_comment_grade_layout_default"
            android:layout_height="wrap_content"
            android:text="@string/no_comment_tip"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/grade_layout"
            android:layout_width="@dimen/tv_comment_grade_layout_default"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/textSize36"
                android:textStyle="bold"
                android:textColor="#99000000"
                android:id="@+id/tv_point"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/iv_comment_rating"
                android:layout_width="@dimen/dp_75"
                android:layout_height="@dimen/dp_12"
                android:layout_marginStart="@dimen/dp_10"
                app:layout_constraintBottom_toTopOf="@+id/tv_comment_num"
                app:layout_constraintLeft_toRightOf="@+id/tv_point"
                app:layout_constraintTop_toTopOf="@+id/tv_point"
                app:layout_constraintVertical_chainStyle="packed"/>
            <TextView
                android:textSize="@dimen/textSize10"
                android:textColor="#000000"
                android:gravity="center"
                android:id="@+id/tv_comment_num"
                android:layout_width="@dimen/dp_75"
                android:layout_height="wrap_content"
                android:alpha="0.4"
                android:layout_marginStart="@dimen/dp_10"
                app:layout_constraintBottom_toBottomOf="@+id/tv_point"
                app:layout_constraintLeft_toRightOf="@+id/tv_point"
                app:layout_constraintTop_toBottomOf="@+id/iv_comment_rating"
                app:layout_constraintVertical_chainStyle="packed"/>
            <ImageView
                android:id="@+id/iv_rating_1"
                android:layout_width="@dimen/dp_38"
                android:layout_height="@dimen/dp_6"
                android:layout_marginLeft="@dimen/dp_8"
                android:src="@drawable/lkp_grey_rate_5"
                app:layout_constraintBottom_toTopOf="@+id/iv_rating_2"
                app:layout_constraintLeft_toRightOf="@+id/tv_comment_num"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>
            <ProgressBar
                android:layout_gravity="center_horizontal"
                android:id="@+id/progress1"
                android:layout_width="@dimen/dp_135"
                android:layout_height="@dimen/dp_2"
                android:progressDrawable="@drawable/tv_app_detail_progress_shape"
                android:layout_marginStart="@dimen/dp_8"
                android:indeterminateTintMode="src_atop"
                app:layout_constraintBottom_toBottomOf="@+id/iv_rating_1"
                app:layout_constraintLeft_toRightOf="@+id/iv_rating_1"
                app:layout_constraintTop_toTopOf="@+id/iv_rating_1"
                style="@android:style/Widget.ProgressBar.Horizontal"/>
            <ImageView
                android:id="@+id/iv_rating_2"
                android:layout_width="@dimen/dp_38"
                android:layout_height="@dimen/dp_6"
                android:src="@drawable/lkp_grey_rate_4"
                app:layout_constraintBottom_toTopOf="@+id/iv_rating_3"
                app:layout_constraintLeft_toLeftOf="@+id/iv_rating_1"
                app:layout_constraintTop_toBottomOf="@+id/iv_rating_1"/>
            <ProgressBar
                android:layout_gravity="center_horizontal"
                android:id="@+id/progress2"
                android:layout_width="@dimen/dp_135"
                android:layout_height="@dimen/dp_2"
                android:progressDrawable="@drawable/tv_app_detail_progress_shape"
                android:layout_marginStart="@dimen/dp_8"
                android:indeterminateTintMode="src_atop"
                app:layout_constraintBottom_toBottomOf="@+id/iv_rating_2"
                app:layout_constraintLeft_toRightOf="@+id/iv_rating_2"
                app:layout_constraintTop_toTopOf="@+id/iv_rating_2"
                style="@android:style/Widget.ProgressBar.Horizontal"/>
            <ImageView
                android:id="@+id/iv_rating_3"
                android:layout_width="@dimen/dp_38"
                android:layout_height="@dimen/dp_6"
                android:src="@drawable/lkp_grey_rate_3"
                app:layout_constraintBottom_toTopOf="@+id/iv_rating_4"
                app:layout_constraintLeft_toLeftOf="@+id/iv_rating_2"
                app:layout_constraintTop_toBottomOf="@+id/iv_rating_2"/>
            <ProgressBar
                android:layout_gravity="center_horizontal"
                android:id="@+id/progress3"
                android:layout_width="@dimen/dp_135"
                android:layout_height="@dimen/dp_2"
                android:progressDrawable="@drawable/tv_app_detail_progress_shape"
                android:layout_marginStart="@dimen/dp_8"
                android:indeterminateTintMode="src_atop"
                app:layout_constraintBottom_toBottomOf="@+id/iv_rating_3"
                app:layout_constraintLeft_toRightOf="@+id/iv_rating_3"
                app:layout_constraintTop_toTopOf="@+id/iv_rating_3"
                style="@android:style/Widget.ProgressBar.Horizontal"/>
            <ImageView
                android:id="@+id/iv_rating_4"
                android:layout_width="@dimen/dp_38"
                android:layout_height="@dimen/dp_6"
                android:src="@drawable/lkp_grey_rate_2"
                app:layout_constraintBottom_toTopOf="@+id/iv_rating_5"
                app:layout_constraintLeft_toLeftOf="@+id/iv_rating_3"
                app:layout_constraintTop_toBottomOf="@+id/iv_rating_3"/>
            <ProgressBar
                android:layout_gravity="center_horizontal"
                android:id="@+id/progress4"
                android:layout_width="@dimen/dp_135"
                android:layout_height="@dimen/dp_2"
                android:progressDrawable="@drawable/tv_app_detail_progress_shape"
                android:layout_marginStart="@dimen/dp_8"
                android:indeterminateTintMode="src_atop"
                app:layout_constraintBottom_toBottomOf="@+id/iv_rating_4"
                app:layout_constraintLeft_toRightOf="@+id/iv_rating_4"
                app:layout_constraintTop_toTopOf="@+id/iv_rating_4"
                style="@android:style/Widget.ProgressBar.Horizontal"/>
            <ImageView
                android:id="@+id/iv_rating_5"
                android:layout_width="@dimen/dp_38"
                android:layout_height="@dimen/dp_6"
                android:src="@drawable/lkp_grey_rate_1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="@+id/iv_rating_4"
                app:layout_constraintTop_toBottomOf="@+id/iv_rating_4"/>
            <ProgressBar
                android:layout_gravity="center_horizontal"
                android:id="@+id/progress5"
                android:layout_width="@dimen/dp_135"
                android:layout_height="@dimen/dp_2"
                android:progressDrawable="@drawable/tv_app_detail_progress_shape"
                android:layout_marginStart="@dimen/dp_8"
                android:indeterminateTintMode="src_atop"
                app:layout_constraintBottom_toBottomOf="@+id/iv_rating_5"
                app:layout_constraintLeft_toRightOf="@+id/iv_rating_5"
                app:layout_constraintTop_toTopOf="@+id/iv_rating_5"
                style="@android:style/Widget.ProgressBar.Horizontal"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <ImageView
        android:id="@+id/iv_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/item_arrow"
        android:layout_toRightOf="@+id/common_grade_layout"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/dp_18"/>
</RelativeLayout>
