<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.layout.OUIRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/game_gift_pack_item"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:minHeight="64dp"
    android:paddingHorizontal="20dp"
    app:oui_radius="16dp">
    <com.bytedanceos.common.network.widget.NetworkImageView
        android:id="@+id/game_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/oui_default_app_icon"
        android:layout_centerVertical="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/game_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_toLeftOf="@+id/game_btn"
        android:layout_toRightOf="@+id/game_icon"
        android:layout_centerVertical="true">
        <TextView
            android:textColor="@color/oui_text_1"
            android:ellipsize="end"
            android:id="@+id/game_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/app_item_name_max_width"
            android:maxLines="1"
            android:includeFontPadding="false"
            style="@style/Label_L"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/oui_text_2"
                android:ellipsize="end"
                android:id="@+id/game_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/app_item_name_max_width"
                android:maxLines="1"
                android:includeFontPadding="false"
                style="@style/Label_M_Thin"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/app_tag_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
        </LinearLayout>
        <TextView
            android:textColor="@color/oui_text_3b"
            android:ellipsize="end"
            android:id="@+id/game_des"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/app_item_name_max_width"
            android:maxLines="1"
            android:includeFontPadding="false"
            style="@style/Label_S_Thin"/>
        <ImageView
            android:id="@+id/appRate"
            style="@style/oui_app_list_brief_rate_style"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/oui_text_2"
        android:id="@+id/game_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        style="@style/Label_M"/>
    <com.obric.oui.divider.ODivider
        android:id="@+id/game_item_line"
        android:layout_width="match_parent"
        android:layout_height="0.66dp"
        android:layout_alignLeft="@+id/game_content"
        android:layout_alignParentBottom="true"/>
</com.obric.oui.layout.OUIRelativeLayout>
