<?xml version="1.0" encoding="utf-8"?>
<com.bytedanceos.common.ui.widget.ParentView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/ranking_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/ranking_tab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            layout="@layout/ranking_tab"/>
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/ranking_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/ranking_tab"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/appinfo_replace"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</com.bytedanceos.common.ui.widget.ParentView>
