<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@color/oui_bg_base_1"
    android:paddingTop="8dp"
    android:paddingBottom="24dp"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <com.obric.oui.layout.OUIConstraintLayout
        android:id="@+id/entrance_rank_list"
        android:background="@color/oui_fill_list_item_card"
        android:layout_width="0dp"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/entrance_app"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:oui_radius="12dp">
        <ImageView
            android:id="@+id/entrance_ic_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/entrance_icon_list"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/entrance_txt_1"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/oui_text_1"
            android:id="@+id/entrance_txt_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/entrance_rank_title"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/entrance_ic_1"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Title_Title_M"/>
    </com.obric.oui.layout.OUIConstraintLayout>
    <com.obric.oui.layout.OUIConstraintLayout
        android:id="@+id/entrance_app"
        android:background="@color/oui_fill_list_item_card"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/entrance_game"
        app:layout_constraintStart_toEndOf="@+id/entrance_rank_list"
        app:layout_constraintTop_toTopOf="parent"
        app:oui_radius="12dp">
        <ImageView
            android:id="@+id/entrance_ic_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/entrance_icon_app"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/entrance_txt_2"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/oui_text_1"
            android:id="@+id/entrance_txt_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/entrance_app_title"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/entrance_ic_2"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Title_Title_M"/>
    </com.obric.oui.layout.OUIConstraintLayout>
    <com.obric.oui.layout.OUIConstraintLayout
        android:id="@+id/entrance_game"
        android:background="@color/oui_fill_list_item_card"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/entrance_app"
        app:layout_constraintTop_toTopOf="parent"
        app:oui_radius="12dp">
        <ImageView
            android:id="@+id/entrance_ic_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/entrance_icon_game"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/entrance_txt_3"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/oui_text_1"
            android:id="@+id/entrance_txt_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/entrance_game_title"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/entrance_ic_3"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Title_Title_M"/>
    </com.obric.oui.layout.OUIConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
