<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedanceos.appstore.buss.widget.recyclerview.CommonRecyclerView
            android:id="@+id/recycler_view_hot_app"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"/>
        <View
            android:id="@+id/line_view_1"
            android:background="#14000000"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="@dimen/tv_app_item_padding_left"
            android:layout_marginRight="@dimen/tv_app_item_padding_left"/>
        <com.bytedanceos.common.ui.widget.FlowLayout
            android:id="@+id/fl_hot_keyword"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="17dp"
            android:layout_marginEnd="17dp"
            app:flChildSpacing="@dimen/search_recommend_flow_layout_child_space"
            app:flChildSpacingForLastRow="align"
            app:flMinChildSpacing="@dimen/search_recommend_flow_layout_min_child_space"
            app:flRowSpacing="@dimen/search_recommend_flow_layout_row_space"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_search_history_container"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="17dp"
            android:layout_marginEnd="17dp">
            <com.bytedanceos.common.ui.widget.FlowLayout
                android:id="@+id/fl_search_history"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:flChildSpacing="@dimen/search_recommend_flow_layout_child_space"
                app:flChildSpacingForLastRow="align"
                app:flMinChildSpacing="@dimen/search_recommend_flow_layout_min_child_space"
                app:flRowSpacing="@dimen/search_recommend_flow_layout_row_space"/>
            <ImageView
                android:id="@+id/iv_history_clear"
                android:visibility="gone"
                android:layout_width="@dimen/dp_30"
                android:layout_height="@dimen/dp_30"
                android:layout_marginLeft="@dimen/dp_4"
                android:src="@drawable/search_history_remove"/>
        </LinearLayout>
        <View
            android:id="@+id/line_view_2"
            android:background="#14000000"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="@dimen/tv_app_item_padding_left"
            android:layout_marginTop="@dimen/dp_18"
            android:layout_marginRight="@dimen/tv_app_item_padding_left"/>
        <com.bytedanceos.appstore.buss.widget.recyclerview.CommonRecyclerView
            android:id="@+id/recycler_view_recommend"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
