<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.viewpager2.widget.ViewPager2
        android:orientation="horizontal"
        android:id="@+id/viewPager"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/search_history_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/section_title_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/oui_h_m1"
            android:layout_marginHorizontal="8dp">
            <TextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/section_bar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_title_search_history"
                android:layout_marginStart="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Label_L"/>
            <ImageView
                android:id="@+id/section_bar_right_btn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/oui_icon_trash"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.bytedanceos.common.ui.widget.FlowLayout
            android:textColor="@android:color/white"
            android:id="@+id/search_history_flow_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="20dp"
            app:flChildSpacing="@dimen/search_recommend_flow_layout_child_space"
            app:flChildSpacingForLastRow="align"
            app:flMinChildSpacing="@dimen/search_recommend_flow_layout_min_child_space"
            app:flRowSpacing="@dimen/search_recommend_flow_layout_row_space"/>
    </LinearLayout>
</FrameLayout>
