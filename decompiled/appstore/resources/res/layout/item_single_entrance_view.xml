<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/single_entrance_view"
    android:background="@color/oui_fill_list_item_card"
    android:layout_width="104dp"
    android:layout_height="56dp"
    app:oui_radius="12dp">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/entrance_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="20dp"/>
    <TextView
        android:textColor="@color/oui_text_1"
        android:ellipsize="end"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/entrance_name"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginEnd="24dp"
        android:textFontWeight="500"
        style="@style/Title_Title_M_Thin"/>
</merge>
