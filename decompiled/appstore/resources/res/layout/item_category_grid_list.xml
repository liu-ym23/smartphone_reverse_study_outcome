<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp">
    <com.obric.oui.paneltitlebar.OPanelTitleBar
        android:id="@+id/category_list_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:layout_marginVertical="1dp"
        app:oui_panel_type="regular"/>
    <View
        android:id="@+id/category_list_divider"
        android:layout_width="match_parent"
        android:layout_height="8dp"/>
    <GridLayout
        android:id="@+id/category_grid_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:paddingHorizontal="16dp"/>
</LinearLayout>
