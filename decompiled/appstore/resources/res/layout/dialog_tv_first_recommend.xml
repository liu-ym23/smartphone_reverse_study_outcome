<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/first_recommend_dialog_shape_round"
    android:padding="@dimen/dp_2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/dp_20"
    android:layout_marginBottom="@dimen/dp_20">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/fl_first_recommend_title_container"
            android:background="@drawable/first_recommend_title_shape_round"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_first_recommend_title"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_50"
                android:text="@string/tnt_title_recommended_apps"
                app:layout_constraintTop_toTopOf="parent"/>
            <Button
                android:textSize="13.5sp"
                android:textColor="#ffffff"
                android:layout_gravity="center"
                android:id="@+id/btn_cancel"
                android:background="@drawable/btn_button_selector"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/dp_8"
                android:minWidth="@dimen/dp_60"
                android:minHeight="@dimen/dp_30"
                android:text="@string/btn_jump"/>
        </FrameLayout>
        <com.bytedanceos.appstore.buss.widget.recyclerview.CommonRecyclerView
            android:id="@+id/tv_first_recommend_recycler_view"
            android:background="@drawable/bg_shadow"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_first_recommend_install"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fl_first_recommend_title_container"/>
        <Button
            android:textSize="@dimen/welcome_app_install_size"
            android:textStyle="bold"
            android:textColor="@color/welcome_app_install"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_first_recommend_install"
            android:background="@drawable/selector_welcome_btn_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_2"
            android:text="@string/buy_all"
            app:layout_constraintBottom_toTopOf="@+id/cb_auto_update"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_first_recommend_recycler_view"/>
        <CheckBox
            android:textSize="@dimen/welcome_app_auto_update_size"
            android:textColor="@color/welcome_text_color_checkbox_auto_update"
            android:layout_gravity="center_horizontal"
            android:id="@+id/cb_auto_update"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/welcome_btn_install_margin_bottom"
            android:checked="true"
            android:button="@null"
            android:text="@string/open_auto_update_of_wlan"
            android:drawableLeft="@drawable/selector_check_box_blue"
            android:drawablePadding="@dimen/welcome_auto_update_drawable_padding"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_first_recommend_install"/>
        <ImageView
            android:id="@+id/tv_first_recommend_shadow"
            android:layout_below="@+id/fl_first_recommend_title_container"
            android:contentDescription="@null"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/fl_first_recommend_title_container"
            style="@style/appstore_shadow_style"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
