<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/game_gift_pack_item"
    android:layout_width="@dimen/tv_app_item_horizontal_width"
    android:layout_height="@dimen/dp_79"
    android:paddingStart="@dimen/tv_app_item_padding_left">
    <ImageView
        android:id="@+id/iv_icon"
        android:background="@drawable/game_gift_icon_no_gap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/textSize17"
        android:textStyle="bold"
        android:textColor="#cc000000"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="left"
        android:id="@+id/tv_name"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_12"
        android:singleLine="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_content"
        app:layout_constraintLeft_toRightOf="@+id/iv_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_icon"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="@dimen/textSize10"
        android:textColor="#80000000"
        android:ellipsize="end"
        android:id="@+id/tv_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:maxLines="1"
        android:maxEms="15"
        android:singleLine="false"
        app:layout_constraintLeft_toLeftOf="@+id/tv_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="@dimen/textSize12"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_get"
        android:background="@drawable/info_btn_selector"
        android:layout_width="@dimen/dp_70"
        android:layout_height="wrap_content"
        android:lines="1"
        android:scaleX="1.1"
        app:layout_constraintBottom_toTopOf="@+id/tv_count"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="@dimen/textSize10"
        android:textColor="#3f000000"
        android:gravity="center"
        android:id="@+id/tv_count"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/tv_get"
        app:layout_constraintRight_toRightOf="@+id/tv_get"
        app:layout_constraintTop_toBottomOf="@+id/tv_get"
        app:layout_constraintVertical_chainStyle="packed"/>
    <View
        android:background="#14000000"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/iv_icon"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
