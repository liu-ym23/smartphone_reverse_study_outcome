<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/appinfo_comment_header"
        layout="@layout/appinfo_comment_header"/>
    <View
        android:id="@+id/middle"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/appinfo_comment_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/appinfo_comment_header"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/addComment"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="5dp"
        android:text="@string/add_comment"
        android:singleLine="true"
        android:layout_toLeftOf="@+id/middle"
        android:layout_below="@+id/appinfo_comment_container"
        android:layout_alignParentLeft="true"
        style="@style/appinfo_comment_btn_style"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/loadComment"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="18dp"
        android:text="@string/load_comments"
        android:singleLine="true"
        android:layout_toRightOf="@+id/middle"
        android:layout_below="@+id/appinfo_comment_container"
        android:layout_alignParentRight="true"
        style="@style/appinfo_comment_btn_style"/>
</RelativeLayout>
