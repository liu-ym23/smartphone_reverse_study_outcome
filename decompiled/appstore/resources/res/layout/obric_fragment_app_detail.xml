<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_layout"
        android:background="@color/Transparent"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp">
        <FrameLayout
            android:id="@+id/appinfo_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            app:layout_scrollFlags="snap|exitUntilCollapsed|scroll">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/shrink_locator"
                android:background="@android:color/holo_red_dark"
                android:paddingTop="4dp"
                android:paddingBottom="12dp"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="68dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <View
                    android:id="@+id/collapse_locator_appIcon"
                    android:background="@android:color/background_light"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.bytedanceos.common.ui.widget.MarqueeTextView
                    android:textColor="@color/oui_text_1"
                    android:ellipsize="marquee"
                    android:id="@+id/collapse_locator_appName"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintBottom_toTopOf="@+id/collapse_locator_appSize"
                    app:layout_constraintEnd_toStartOf="@+id/collapse_locator_appButton"
                    app:layout_constraintStart_toEndOf="@+id/collapse_locator_appIcon"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"
                    style="@style/Label_L"/>
                <TextView
                    android:textColor="@color/oui_text_3b"
                    android:id="@+id/collapse_locator_appSize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:maxLines="1"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/collapse_locator_appButton"
                    app:layout_constraintStart_toStartOf="@+id/collapse_locator_appName"
                    app:layout_constraintTop_toBottomOf="@+id/collapse_locator_appName"
                    style="@style/Label_M_Thin"/>
                <com.obric.oui.button.OButton
                    android:id="@+id/collapse_locator_appButton"
                    android:layout_width="64dp"
                    android:layout_height="32dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/OButton.M1.Standard.Primary_Light"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.bytedanceos.common.network.widget.NetworkImageView
                    android:id="@+id/appIcon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/oui_default_app_icon"
                    android:contentDescription="@null"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintBottom_toBottomOf="@+id/appDeveloper"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/appName"/>
                <com.obric.appstore.common.core.ui.view.ObricAppStatusView
                    android:id="@+id/appStatusLay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:minHeight="32dp"
                    app:layout_constraintBottom_toBottomOf="@+id/appDeveloper"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/appName"/>
                <com.bytedanceos.common.ui.widget.MarqueeTextView
                    android:textColor="@color/oui_text_1"
                    android:ellipsize="marquee"
                    android:id="@+id/appName"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxLines="2"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintEnd_toStartOf="@+id/appStatusLay"
                    app:layout_constraintStart_toEndOf="@+id/appIcon"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Title_Title_L"/>
                <com.bytedanceos.common.ui.widget.MarqueeTextView
                    android:textColor="@color/oui_text_1"
                    android:ellipsize="marquee"
                    android:id="@+id/appNameOneliner"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxLines="2"
                    android:alpha="0"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="20dp"
                    android:textFontWeight="640"
                    app:layout_constraintEnd_toStartOf="@+id/appStatusLay"
                    app:layout_constraintStart_toEndOf="@+id/appIcon"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Label_L"/>
                <TextView
                    android:textColor="@color/oui_text_3b"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/appSize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:maxLines="1"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintEnd_toStartOf="@+id/appStatusLay"
                    app:layout_constraintStart_toStartOf="@+id/appName"
                    app:layout_constraintTop_toBottomOf="@+id/appName"
                    style="@style/Label_M_Thin"/>
                <com.obric.oui.text.OTextView
                    android:textColor="@color/oui_text_3"
                    android:ellipsize="end"
                    android:id="@+id/appDeveloper"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintEnd_toStartOf="@+id/appStatusLay"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="@+id/appName"
                    app:layout_constraintTop_toBottomOf="@+id/appSize"
                    style="@style/Label_M_Thin"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
        <com.obric.oui.segmentedtab.OTabSegmentedLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/appinfo_tab"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/oui_h_m2"
            android:layout_marginTop="4dp"
            android:layout_marginHorizontal="20dp"
            app:bar_color="@color/oui_fill_sunken_variable"
            app:bar_stroke_color="@color/Transparent"
            app:indicator_anim_enable="true"
            app:indicator_color="@color/oui_bg_base_3_high_elevation"
            app:indicator_corner_radius="@dimen/oui_r_m1"
            app:indicator_height="@dimen/oui_h_m1"
            app:indicator_spacing="4dp"
            app:layout_scrollFlags="noScroll"
            app:tab_textBold="SELECT"
            app:tab_textSelectColor="@color/oui_text_1"
            app:tab_textSize="14dp"
            app:tab_textUnselectColor="@color/oui_text_3"/>
    </com.google.android.material.appbar.AppBarLayout>
    <com.obric.oui.bouncelayout.ONestedScrollView
        android:id="@+id/appinfo_scrollview"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <View
                android:id="@+id/margin_view"
                android:layout_width="match_parent"
                android:layout_height="104dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <com.obric.appstore.common.core.ui.view.ObricAppItemView
                    android:id="@+id/app_info_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.obric.oui.chip.OChipGroup
                    android:id="@+id/category_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:layout_marginHorizontal="16dp"
                    app:oui_item_space="8dp"
                    app:oui_line_space="8dp"/>
            </LinearLayout>
            <com.obric.oui.bouncelayout.OHorizontalScrollView
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="276dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/images_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:divider="@drawable/divider_w_8"
                    android:showDividers="middle"
                    android:paddingHorizontal="16dp"/>
            </com.obric.oui.bouncelayout.OHorizontalScrollView>
            <RelativeLayout
                android:id="@+id/app_des_layout"
                android:descendantFocusability="blocksDescendants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="32dp"
                android:layout_marginHorizontal="16dp">
                <ImageView
                    android:id="@+id/app_des_more"
                    android:clickable="false"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginLeft="12dp"
                    android:src="@drawable/oui_app_info_more_icon"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/oui_text_3"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/app_des"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:layout_toLeftOf="@+id/app_des_more"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:lineSpacingMultiplier="1.2"/>
            </RelativeLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:layout_marginHorizontal="16dp">
                <com.obric.oui.text.OTextView
                    android:textSize="14sp"
                    android:textColor="@color/oui_text_3"
                    android:id="@+id/tv_version"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tv_privacy_agreement"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.obric.oui.text.OTextView
                    android:textSize="14sp"
                    android:textColor="@color/oui_functional_blue_6"
                    android:layout_gravity="right"
                    android:id="@+id/tv_privacy_agreement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_detail_tv_privacy_agreement"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tv_permissions"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.obric.oui.text.OTextView
                    android:textSize="14sp"
                    android:textColor="@color/oui_functional_blue_6"
                    android:id="@+id/tv_permissions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_detail_tv_permissions"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <include
                android:id="@+id/relation_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                layout="@layout/common_item_view_pager_app_horizontal"/>
            <include
                android:id="@+id/classic_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                layout="@layout/common_item_view_pager_app_horizontal"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="18dp"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.ONestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
