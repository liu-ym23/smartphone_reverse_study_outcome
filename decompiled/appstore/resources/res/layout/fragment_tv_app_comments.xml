<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedanceos.appstore.buss.widget.app.item.ItemHorizontalView
        android:id="@+id/tv_app_item_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/tv_item_le_ri"/>
    <com.bytedanceos.appstore.buss.widget.AppGradeView
        android:id="@+id/grade_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <View
        android:id="@+id/line_view"
        android:background="#14000000"
        android:visibility="gone"
        android:layout_width="@dimen/tv_item_horizontal_width"
        android:layout_height="@dimen/dp_1"
        android:layout_marginLeft="@dimen/tv_item_le_ri"/>
    <com.bytedanceos.appstore.buss.widget.recyclerview.CommonRecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"/>
</LinearLayout>
