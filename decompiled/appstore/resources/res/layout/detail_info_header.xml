<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:tileMode="repeat">
    <include
        android:id="@+id/appinfo_header_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/appinfo_header"/>
    <com.obric.oui.segmentedtab.OTabSegmentedLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/appinfo_table_below"
        android:layout_width="match_parent"
        android:layout_height="@dimen/oui_h_m2"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="@dimen/oui_p_title_bar_default"
        android:layout_below="@+id/appinfo_header_detail"
        android:layout_marginHorizontal="@dimen/oui_p_container_3"
        app:bar_color="@color/oui_fill_sunken_variable"
        app:bar_stroke_color="@color/Transparent"
        app:indicator_anim_enable="true"
        app:indicator_color="@color/oui_bg_base_3_high_elevation"
        app:indicator_corner_radius="@dimen/oui_r_m1"
        app:indicator_height="@dimen/oui_h_m1"
        app:indicator_spacing="4dp"
        app:tab_textBold="SELECT"
        app:tab_textSelectColor="@color/oui_text_1"
        app:tab_textSize="14dp"
        app:tab_textUnselectColor="@color/oui_text_3"/>
    <com.obric.oui.divider.ODivider
        android:id="@+id/line"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0.66dp"
        android:layout_below="@+id/appinfo_table_below"/>
</RelativeLayout>
