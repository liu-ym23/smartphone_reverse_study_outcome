<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pages_must_apps"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedanceos.common.ui.widget.ScrollGridView
        android:id="@+id/gv_pages_must_apps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp"
        android:listSelector="@color/Transparent"
        android:horizontalSpacing="2dp"
        android:verticalSpacing="0dp"
        android:paddingHorizontal="17dp"/>
    <com.obric.oui.button.OButton
        android:id="@+id/btn_install_all_apps"
        android:padding="13dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:text="@string/buy_all"
        android:layout_below="@+id/gv_pages_must_apps"
        android:layout_marginHorizontal="20dp"
        style="@style/OButton.L1.Standard.Neutral"/>
    <com.obric.oui.divider.ODivider
        android:layout_width="match_parent"
        android:layout_height="0.66dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="8dp"
        android:layout_below="@+id/btn_install_all_apps"
        android:layout_marginHorizontal="20dp"/>
</RelativeLayout>
