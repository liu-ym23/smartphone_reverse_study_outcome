<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="68dp"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="64dp"
        android:layout_centerInParent="true">
        <ViewStub
            android:layout_gravity="center"
            android:id="@+id/downloadViewStub"
            android:visibility="visible"
            android:layout="@layout/obric_app_status_download_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.obric.oui.layout.OUIConstraintLayout
            android:id="@+id/appStatusButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:maxWidth="120dp"
            android:minWidth="64dp"
            android:paddingHorizontal="8dp"
            app:oui_radius="@dimen/oui_r_m1">
            <ImageView
                android:id="@+id/appStatusButtonIc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/oic_download_continue"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/appStatusButtonText"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/appStatusButtonText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginHorizontal="0dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/appStatusButtonIc"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Button_1_Medium"/>
        </com.obric.oui.layout.OUIConstraintLayout>
    </FrameLayout>
</merge>
