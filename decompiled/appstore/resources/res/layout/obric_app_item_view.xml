<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_list_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_min="68dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.obric.oui.layout.OUIConstraintLayout
        android:id="@+id/press_container"
        android:focusable="false"
        android:clickable="false"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="2.66dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textColor="@color/oui_text_0"
            android:gravity="center"
            android:id="@+id/app_index"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Title_1_Regular"/>
        <com.bytedanceos.common.network.widget.NetworkImageView
            android:id="@+id/appIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/oui_default_app_icon"
            android:scaleType="centerCrop"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/app_index"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginLeft="0dp"
            app:oui_imageShape="standard"/>
        <TextView
            android:textColor="@color/oui_text_1"
            android:ellipsize="end"
            android:id="@+id/appName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/score_and_app_size_container"
            app:layout_constraintEnd_toStartOf="@+id/appStatusLay"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/appIcon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/Title_1_Regular"/>
        <ImageView
            android:id="@+id/appRate"
            android:visibility="gone"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toTopOf="@+id/appBrief"
            app:layout_constraintEnd_toStartOf="@+id/appStatusLay"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/appIcon"
            app:layout_constraintTop_toBottomOf="@+id/appName"
            style="@style/app_item_rate_style"/>
        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/score_and_app_size_container"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:constraint_referenced_ids="app_score,score_divider,app_size"
            app:flow_horizontalBias="0"
            app:flow_horizontalGap="5dp"
            app:flow_horizontalStyle="packed"
            app:flow_verticalGap="2dp"
            app:flow_wrapMode="chain"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/appBrief"
            app:layout_constraintEnd_toStartOf="@+id/appStatusLay"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/appIcon"
            app:layout_constraintTop_toBottomOf="@+id/appName"/>
        <TextView
            android:textColor="@color/oui_text_3"
            android:id="@+id/app_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            style="@style/Label_M_Thin"/>
        <View
            android:id="@+id/score_divider"
            android:background="@color/oui_basic_text_4"
            android:layout_width="1dp"
            android:layout_height="10dp"/>
        <TextView
            android:textColor="@color/oui_text_3"
            android:ellipsize="end"
            android:id="@+id/app_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            style="@style/Label_M_Thin"/>
        <TextView
            android:textColor="@color/oui_text_3"
            android:ellipsize="end"
            android:id="@+id/appBrief"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/appStatusLay"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/appIcon"
            app:layout_constraintTop_toBottomOf="@+id/score_and_app_size_container"
            app:layout_goneMarginTop="2dp"
            style="@style/Subtitle_2_Regular"/>
        <com.obric.appstore.common.core.ui.view.ObricAppStatusView
            android:id="@+id/appStatusLay"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.obric.oui.layout.OUIConstraintLayout>
    <com.obric.oui.divider.ODivider
        android:id="@+id/line"
        android:layout_width="0dp"
        android:layout_height="0.66dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</merge>
