<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/banner_lay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/lay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20sp"
            android:textColor="#b2000000"
            android:id="@+id/dev_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="21dp"
            android:layout_marginRight="20dp"/>
        <TextView
            android:textSize="13.5sp"
            android:textColor="#66000000"
            android:id="@+id/dev_des"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="20dp"
            android:layout_below="@+id/dev_title"/>
        <com.bytedanceos.common.network.widget.NetworkImageView
            android:id="@+id/dev_banner"
            android:layout_width="match_parent"
            android:layout_height="98dp"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="14dp"
            android:layout_marginRight="14dp"
            android:scaleType="fitXY"
            android:layout_below="@+id/dev_des"
            android:contentDescription="@null"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/my_app_list_title_size"
        android:textColor="@color/my_app_list_title_color"
        android:gravity="center_vertical"
        android:background="@drawable/developer_bar"
        android:paddingLeft="@dimen/my_app_list_title_left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/perfect_apps"
        android:layout_below="@+id/lay"/>
</RelativeLayout>
