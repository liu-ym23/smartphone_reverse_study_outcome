<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/suppose_app_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/suppose_app_layout_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-2px"
        android:layout_below="@+id/iv_triangle">
        <TextView
            android:textSize="@dimen/suppose_app_layout_title_size"
            android:gravity="center_vertical"
            android:id="@+id/tv_layout_title"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/suppose_app_layout_title_height"
            android:layout_marginLeft="@dimen/suppose_app_layout_title_margin_left"
            android:maxLines="1"/>
        <View
            android:background="@color/suppose_app_item_divider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/suppose_app_div_line_height"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/container_suppose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/suppose_app_item_margin_left"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_triangle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/suppose_app_triangle_margin_left"
        android:src="@drawable/suppose_triangle"/>
</RelativeLayout>
