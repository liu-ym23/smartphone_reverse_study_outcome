<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <com.obric.oui.progress.ODownloadProgressView
            android:layout_gravity="center"
            android:id="@+id/appStatusDownloadView"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:oui_progress_view_size="medium"/>
        <Button
            android:textSize="14sp"
            android:textColor="@color/oui_text_2"
            android:layout_gravity="center"
            android:id="@+id/appStatusButton"
            android:background="@drawable/btn_appstatus_bg"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:foreground="@drawable/btn_appstatus_fg"
            android:minWidth="52dp"
            android:text="@string/install"
            android:layout_marginVertical="2dp"
            style="@style/OButton.M1.Standard"/>
    </FrameLayout>
    <TextView
        android:textSize="8sp"
        android:textColor="@color/oui_text_3b"
        android:gravity="center"
        android:id="@+id/appCategorySize"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_below="@+id/container"
        android:layout_centerHorizontal="true"/>
</merge>
