<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedanceos.appstore.buss.widget.MaxHeightRelativeLayout
        android:layout_gravity="center"
        android:id="@+id/relative_layout"
        android:padding="@dimen/dp_2"
        android:layout_width="480dp"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginBottom="@dimen/dp_20"
        android:adjustViewBounds="true"
        android:layout_centerInParent="true"
        app:mhs_maxHeight="@dimen/lkp_dialog_max_height">
        <TextView
            android:textSize="@dimen/textSize20"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:background="@drawable/tv_app_feedback_shape_round_top"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40"
            android:text="@string/feedback_title"/>
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_alignTop="@+id/tv_title"
            android:layout_alignBottom="@+id/tv_title"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:layout_below="@+id/tv_title">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/setting_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/textSize13"
                    android:textStyle="bold"
                    android:textColor="#80000000"
                    android:paddingLeft="@dimen/dp_30"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_14"
                    android:layout_marginBottom="@dimen/dp_6"
                    android:text="@string/feedback_type"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <ImageView
            android:background="@drawable/titlebar_shadow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_title"/>
    </com.bytedanceos.appstore.buss.widget.MaxHeightRelativeLayout>
    <ImageView
        android:id="@+id/iv_stroke"
        android:background="@drawable/level2_winframe_bg_normal_state"
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:maxHeight="640dp"
        android:layout_alignTop="@+id/relative_layout"
        android:layout_alignBottom="@+id/relative_layout"
        android:layout_centerInParent="true"/>
</RelativeLayout>
