<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/headerContentView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="20dp">
        <com.bytedanceos.common.network.widget.NetworkImageView
            android:id="@+id/appIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/oui_default_app_icon"
            android:contentDescription="@null"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.bytedanceos.common.ui.widget.MarqueeTextView
                    android:textColor="@color/oui_text_1"
                    android:ellipsize="marquee"
                    android:id="@+id/appName"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lines="1"
                    android:includeFontPadding="false"
                    style="@style/Title_Title_L"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/app_tag_container"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="1"
                    android:paddingVertical="4dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/appRate_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="2dp">
                <ImageView
                    android:id="@+id/appRate"
                    android:layout_width="60dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="0dp"
                    android:contentDescription="@null"/>
                <TextView
                    android:textColor="@color/oui_text_3b"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/appSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    style="@style/Label_S_Thin"/>
            </LinearLayout>
            <TextView
                android:textColor="@color/oui_text_3"
                android:ellipsize="marquee"
                android:id="@+id/appDeveloper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:includeFontPadding="false"
                style="@style/Label_M_Thin"/>
        </LinearLayout>
        <com.bytedanceos.common.ui.widget.oui.OUIAppStatusView
            android:layout_gravity="center_vertical"
            android:id="@+id/appStatusLay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:minHeight="32dp"/>
    </LinearLayout>
    <com.obric.oui.layout.OUIFrameLayout
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="20dp">
        <TextView
            android:textColor="@color/oui_text_2"
            android:ellipsize="end"
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/appCategory"
            android:background="@drawable/appinfo_local_category_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:drawableRight="@drawable/oui_icon_right_arrow"
            android:drawablePadding="2dp"
            android:backgroundTint="@color/oui_fill_element_2"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            style="@style/BtnLabel_M1"/>
    </com.obric.oui.layout.OUIFrameLayout>
</LinearLayout>
