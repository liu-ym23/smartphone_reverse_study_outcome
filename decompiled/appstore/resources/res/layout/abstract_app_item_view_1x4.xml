<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/base_app_list_item"
    android:layout_width="match_parent"
    android:layout_height="@dimen/app_list_height_1X4">
    <RelativeLayout
        android:id="@+id/app_no_layout"
        android:visibility="gone"
        android:layout_width="@dimen/app_number_width"
        android:layout_height="@dimen/app_list_height_1X4"
        android:layout_marginLeft="@dimen/app_number_margin_left">
        <TextView
            android:id="@+id/appNo"
            android:visibility="visible"
            android:text="@string/number_text"
            style="@style/app_recommend_list_no_style"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/appIcon"
        android:src="@drawable/oui_default_app_icon"
        android:layout_toRightOf="@+id/app_no_layout"
        android:contentDescription="@null"
        style="@style/app_list_icon_style"/>
    <com.bytedanceos.common.ui.widget.AppStatusView
        android:id="@+id/appStatusLay"
        style="@style/base_app_item_status_view_large_style"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/app_name_margin_left"
        android:layout_toLeftOf="@+id/appStatusLay"
        android:layout_toRightOf="@+id/appIcon"
        android:layout_centerVertical="true">
        <TextView
            android:id="@+id/appName"
            android:paddingTop="@dimen/app_name_padding_top_1X4"
            android:maxWidth="@dimen/app_item_name_max_width"
            android:text="@string/long_text"
            style="@style/app_list_name_style"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/categoryLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/app_category_padding_top_1X4">
            <TextView
                android:id="@+id/appCategory"
                android:paddingRight="@dimen/label_interval"
                android:layout_marginLeft="@dimen/app_category_margin_left"
                android:text="@string/long_text"
                style="@style/app_list_category_style"/>
            <TextView
                android:id="@+id/label_0"
                android:background="@drawable/tag_ad_bg"
                android:layout_marginLeft="@dimen/label_padding"
                android:layout_marginRight="@dimen/label_margin_right"
                android:text="@string/label_ads"
                style="@style/app_list_first_pub_style"/>
            <TextView
                android:id="@+id/label_1"
                android:background="@drawable/tag_ad_bg"
                android:layout_marginLeft="@dimen/label_padding"
                android:text="@string/label_ads"
                style="@style/app_list_first_pub_style"/>
        </LinearLayout>
        <TextView
            android:id="@+id/appBrief"
            android:layout_marginTop="@dimen/app_category_padding_top_1X4"
            android:text="@string/long_text"
            style="@style/app_list_brief_style"/>
        <ImageView
            android:id="@+id/appRate"
            android:layout_marginTop="@dimen/app_category_padding_top_1X4"
            style="@style/app_list_brief_rate_style"/>
        <TextView
            android:id="@+id/appSource"
            style="@style/app_list_source_style"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/app_list_space"
        android:background="@drawable/line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
