<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.bytedanceos.appstore.buss.widget.MaxHeightRelativeLayout
        android:layout_gravity="center"
        android:id="@+id/relative_layout"
        android:padding="@dimen/dp_2"
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginBottom="@dimen/dp_20"
        android:adjustViewBounds="true"
        android:layout_centerInParent="true"
        app:mhs_maxHeight="@dimen/lkp_dialog_max_height">
        <TextView
            android:textSize="@dimen/textSize20"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:background="@drawable/tv_app_feedback_shape_round_top"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40"/>
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_alignTop="@+id/tv_title"
            android:layout_alignBottom="@+id/tv_title"/>
        <ScrollView
            android:background="@drawable/setting_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:layout_below="@+id/tv_title">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:id="@+id/constraint_layout"
                android:paddingLeft="@dimen/dp_14"
                android:paddingTop="@dimen/dp_12"
                android:paddingRight="@dimen/dp_14"
                android:paddingBottom="@dimen/dp_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/iv_logo"
                    android:layout_width="@dimen/dp_96"
                    android:layout_height="@dimen/dp_96"
                    android:layout_margin="@dimen/dp_12"
                    android:contentDescription="@null"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/textSize18"
                    android:textStyle="bold"
                    android:textColor="#cc000000"
                    android:id="@+id/tv_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_12"
                    app:layout_constraintLeft_toRightOf="@+id/iv_logo"
                    app:layout_constraintTop_toTopOf="@+id/iv_logo"/>
                <TextView
                    android:textSize="@dimen/textSize14"
                    android:textColor="#66000000"
                    android:id="@+id/tv_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    app:layout_constraintLeft_toLeftOf="@+id/tv_name"
                    app:layout_constraintTop_toBottomOf="@+id/tv_name"/>
                <ImageView
                    android:id="@+id/game_line"
                    android:background="@drawable/line"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1"
                    android:layout_marginTop="@dimen/dp_10"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/iv_logo"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/content_layout"
                    android:background="@drawable/game_gift_bg"
                    android:paddingTop="@dimen/dp_16"
                    android:paddingBottom="@dimen/dp_16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/dp_60"
                    android:paddingEnd="@dimen/dp_60"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/game_line">
                    <TextView
                        android:textSize="@dimen/textSize15"
                        android:textColor="#cc000000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/gift_expiry_data"
                        android:drawableLeft="@drawable/game_gift_time"
                        android:drawablePadding="@dimen/dp_8"/>
                    <TextView
                        android:textSize="@dimen/textSize13"
                        android:textColor="#660c0000"
                        android:id="@+id/tv_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_8"
                        android:layout_marginStart="@dimen/dp_24"/>
                    <TextView
                        android:textSize="@dimen/textSize15"
                        android:textColor="#cc000000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_8"
                        android:text="@string/gift_summary"
                        android:drawableLeft="@drawable/game_gift_content"
                        android:drawablePadding="@dimen/dp_8"/>
                    <TextView
                        android:textSize="@dimen/textSize13"
                        android:textColor="#660c0000"
                        android:id="@+id/tv_content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_8"
                        android:layout_marginStart="@dimen/dp_24"/>
                    <TextView
                        android:textSize="@dimen/textSize15"
                        android:textColor="#cc000000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_8"
                        android:text="@string/gift_instructions"
                        android:drawableLeft="@drawable/game_gift_instuction"
                        android:drawablePadding="@dimen/dp_8"/>
                    <TextView
                        android:textSize="@dimen/textSize13"
                        android:textColor="#660c0000"
                        android:id="@+id/tv_instruction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_8"
                        android:layout_marginStart="@dimen/dp_24"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/textSize16"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/tv_use"
                    android:paddingTop="@dimen/dp_10"
                    android:paddingBottom="@dimen/dp_10"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_60"
                    android:layout_marginTop="@dimen/dp_18"
                    android:layout_marginStart="@dimen/dp_60"
                    android:layout_marginEnd="@dimen/dp_60"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/content_layout"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
        <ImageView
            android:background="@drawable/titlebar_shadow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_title"/>
    </com.bytedanceos.appstore.buss.widget.MaxHeightRelativeLayout>
    <ImageView
        android:id="@+id/iv_stroke"
        android:background="@drawable/level2_winframe_bg_normal_state"
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/relative_layout"
        android:layout_alignBottom="@+id/relative_layout"
        android:layout_centerInParent="true"/>
</RelativeLayout>
