<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <CheckBox
        android:textColor="@color/oui_basic_text_1"
        android:gravity="center"
        android:id="@+id/check_record"
        android:background="@null"
        android:padding="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:button="@drawable/dialog_checkbox_bg_selector"
        android:text="@string/alert_data_flow_tip"
        style="@style/Body_1_Regular"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/option_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:layout_below="@+id/check_record">
        <com.obric.oui.button.OButton
            android:id="@+id/negative_btn"
            android:layout_width="0dp"
            android:text="@string/cancel"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:oui_radius="@dimen/oui_r_l1"
            style="@style/OButton.L1.Standard.Neutral"/>
        <com.obric.oui.button.OButton
            android:id="@+id/positive_btn"
            android:background="@color/oui_accent_6_bg"
            android:layout_width="0dp"
            android:text="@string/done"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            app:oui_radius="@dimen/oui_r_l1"
            style="@style/OButton.L1.Standard.Primary"/>
    </LinearLayout>
</RelativeLayout>
