<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="15sp"
        android:textColor="#e6313131"
        android:id="@+id/popular_relate"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="17dp"
        android:text="@string/popular_relate_app"/>
    <com.bytedanceos.common.ui.widget.ScrollGridView
        android:id="@+id/popular_relate_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:listSelector="#00000000"
        android:numColumns="4"
        android:layout_below="@+id/popular_relate"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#e6313131"
        android:id="@+id/onestep_support"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="17dp"
        android:text="@string/onestep_support_apps"
        android:layout_below="@+id/popular_relate_content"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#cc000000"
        android:gravity="center_vertical"
        android:id="@+id/onestep_more"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="18dp"
        android:text="@string/info_more"
        android:drawableRight="@drawable/icon_feedback_arrow"
        android:layout_alignBaseline="@+id/onestep_support"
        android:layout_alignParentRight="true"/>
    <com.bytedanceos.common.ui.widget.ScrollGridView
        android:id="@+id/onestep_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:listSelector="#00000000"
        android:numColumns="4"
        android:layout_below="@+id/onestep_support"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_below="@+id/onestep_content"/>
</RelativeLayout>
