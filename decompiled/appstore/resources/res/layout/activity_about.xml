<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/main"
    android:fitsSystemWindows="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/toolbar"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.obric.oui.bouncelayout.ONestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:tileMode="repeat"
        android:overScrollMode="always"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.image.OImageAppIcon
                android:id="@+id/app_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="8dp"
                android:src="@drawable/app_store_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_basic_text_1"
                android:id="@+id/app_store"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/app_name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/app_icon"
                style="@style/Title_4_Bold"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_basic_text_1"
                android:id="@+id/app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/app_store"
                style="@style/Body_1_Regular"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/list_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:layout_constraintBottom_toTopOf="@+id/icp_view"
                app:layout_constraintTop_toBottomOf="@+id/app_version"
                app:layout_constraintVertical_bias="0">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/privacy_policy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="5dp"
                    app:ocardlistitem_bgColor="@color/oui_fill_list_item_card"
                    app:ocardlistitem_cardPosition="position_top"
                    app:ocardlistitem_defaultCustomEnd="end_detail"
                    app:ocardlistitem_defaultTailIcon="tail_arrow"
                    app:ocardlistitem_showCardBg="true"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showTailIcon="true"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/permission_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="5dp"
                    app:ocardlistitem_bgColor="@color/oui_fill_list_item_card"
                    app:ocardlistitem_cardPosition="position_middle"
                    app:ocardlistitem_defaultCustomEnd="end_detail"
                    app:ocardlistitem_defaultTailIcon="tail_arrow"
                    app:ocardlistitem_showCardBg="true"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showTailIcon="true"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/user_agreement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="5dp"
                    app:ocardlistitem_bgColor="@color/oui_fill_list_item_card"
                    app:ocardlistitem_cardPosition="position_middle"
                    app:ocardlistitem_defaultCustomEnd="end_detail"
                    app:ocardlistitem_defaultTailIcon="tail_arrow"
                    app:ocardlistitem_showCardBg="true"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showTailIcon="true"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/permission_manager"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="5dp"
                    app:ocardlistitem_bgColor="@color/oui_fill_list_item_card"
                    app:ocardlistitem_cardPosition="position_bottom"
                    app:ocardlistitem_defaultCustomEnd="end_detail"
                    app:ocardlistitem_defaultTailIcon="tail_arrow"
                    app:ocardlistitem_showCardBg="true"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showDivider="false"
                    app:ocardlistitem_showTailIcon="true"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/icp_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="49dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/list_content">
                <com.obric.oui.text.OTextView
                    android:textSize="12sp"
                    android:textColor="@color/oui_text_3b"
                    android:id="@+id/icp_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/icp_no"/>
                <ImageView
                    android:id="@+id/icp_go"
                    android:layout_width="8dp"
                    android:layout_height="16dp"
                    android:src="@drawable/oui_icon_chevron_text_link"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.obric.oui.bouncelayout.ONestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
