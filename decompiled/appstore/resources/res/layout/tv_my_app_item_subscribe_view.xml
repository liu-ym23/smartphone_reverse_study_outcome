<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/subscribe_app_layout"
    android:layout_width="@dimen/tv_app_item_horizontal_width"
    android:layout_height="@dimen/dp_79">
    <ImageView
        android:id="@+id/iv_subscribe_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_12"
        android:layout_marginRight="@dimen/dp_12"
        android:src="@drawable/reserved_game"
        android:scaleType="fitCenter"
        android:layout_centerVertical="true"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/textSize14"
        android:textStyle="bold"
        android:textColor="#666666"
        android:id="@+id/tv_subscribe_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reserved_games"
        app:layout_constraintBottom_toBottomOf="@+id/iv_subscribe_icon"
        app:layout_constraintLeft_toRightOf="@+id/iv_subscribe_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_subscribe_icon"/>
    <TextView
        android:textSize="@dimen/textSize11"
        android:textStyle="bold"
        android:textColor="#999999"
        android:gravity="center"
        android:id="@+id/tv_subscribe_number"
        android:background="@drawable/tv_my_app_number_shape"
        android:paddingLeft="@dimen/dp_7"
        android:paddingRight="@dimen/dp_7"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_15"
        android:layout_marginLeft="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="@+id/iv_subscribe_icon"
        app:layout_constraintLeft_toRightOf="@+id/tv_subscribe_desc"
        app:layout_constraintTop_toTopOf="@+id/iv_subscribe_icon"/>
    <ImageView
        android:id="@+id/iv_subscribe_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dp_24"
        android:src="@drawable/item_arrow"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="@+id/iv_subscribe_icon"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_subscribe_icon"/>
    <ImageView
        android:background="@drawable/line"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:layout_marginStart="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
