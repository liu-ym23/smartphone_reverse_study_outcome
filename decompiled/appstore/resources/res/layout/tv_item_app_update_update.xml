<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/update_all_layout"
    android:visibility="gone"
    android:layout_width="@dimen/tv_app_item_horizontal_width"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/textSize16"
        android:textStyle="bold"
        android:textColor="#cc000000"
        android:gravity="center"
        android:id="@+id/tv_update_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableLeft="@drawable/update_icon"
        android:drawablePadding="@dimen/dp_12"
        android:layout_marginStart="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/dp_13"
        android:textStyle="bold"
        android:textColor="#99000000"
        android:gravity="center"
        android:id="@+id/tv_all_update"
        android:background="@drawable/app_status_view_bg_selector"
        android:paddingLeft="@dimen/dp_0"
        android:paddingRight="@dimen/dp_0"
        android:layout_width="@dimen/dp_77"
        android:layout_height="wrap_content"
        android:text="@string/update_all"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/tv_update_amount"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_update_amount"/>
    <View
        android:id="@+id/update_all_tips"
        android:background="@drawable/btn_update_all_tip"
        android:layout_width="@dimen/dp_4"
        android:layout_height="@dimen/dp_4"
        android:layout_marginTop="@dimen/dp_15"
        android:layout_marginRight="@dimen/dp_7"
        app:layout_constraintRight_toRightOf="@+id/tv_all_update"
        app:layout_constraintTop_toTopOf="@+id/tv_all_update"/>
    <View
        android:id="@+id/line_view2"
        android:background="#14000000"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/dp_1"
        app:layout_constraintLeft_toLeftOf="@+id/tv_update_amount"
        app:layout_constraintRight_toRightOf="@+id/tv_all_update"
        app:layout_constraintTop_toBottomOf="@+id/tv_update_amount"/>
</androidx.constraintlayout.widget.ConstraintLayout>
