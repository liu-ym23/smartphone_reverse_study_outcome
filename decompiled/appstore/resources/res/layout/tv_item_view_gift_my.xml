<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/tv_item_horizontal_width"
    android:layout_height="@dimen/tv_item_horizontal_height">
    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="@dimen/tv_app_icon_size"
        android:layout_height="@dimen/tv_app_icon_size"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/tv_app_item_name_size"
        android:textStyle="bold"
        android:textColor="@color/tv_app_item_name_color"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_name"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/tv_app_item_horizontal_name_padding_icon"
        android:layout_marginRight="@dimen/tv_app_item_horizontal_name_padding_icon"
        android:maxLines="1"
        android:maxEms="10"
        app:layout_constraintBottom_toTopOf="@+id/tv_category"
        app:layout_constraintLeft_toRightOf="@+id/iv_icon"
        app:layout_constraintRight_toLeftOf="@+id/tv_gift_use"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="@dimen/tv_app_item_horizontal_category_size"
        android:textColor="@color/tv_app_item_category_color"
        android:gravity="start"
        android:id="@+id/tv_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/tv_app_time"
        app:layout_constraintLeft_toLeftOf="@+id/tv_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"/>
    <TextView
        android:id="@+id/tv_app_time"
        android:layout_marginTop="@dimen/app_category_row_space"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/tv_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_category"
        style="@style/app_list_brief_style"/>
    <TextView
        android:textStyle="bold"
        android:id="@+id/tv_gift_use"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/normal_app_btn_style"/>
    <ImageView
        android:id="@+id/tv_bottom_space"
        android:background="@drawable/line"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
