<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:bytedance="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:fitsSystemWindows="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/toolbar"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_title_bar_height"
        bytedance:oFloatingTitleBar_defaultMaskBackground="true"/>
    <com.obric.oui.bouncelayout.ONestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_below="@+id/toolbar"
        android:tileMode="repeat"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/activity_list_content_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp">
            <TextView
                android:textColor="@color/oui_basic_text_3"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:text="@string/setting_section_app_update"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="24dp"
                style="@style/Subtitle_2_Medium"/>
            <com.obric.oui.lisitem.OListItemGeneral
                android:id="@+id/userinfo"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                bytedance:oui_list_item_title="@string/login_txt"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/autoUpdateSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/showUpdatedCountSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.obric.oui.lisitem.OListItemGeneral
                android:id="@+id/showTabBottomUpdatedCountSwitch"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                bytedance:oui_list_item_title="@string/tab_bottom_auto_show_updated_count_options"/>
            <com.obric.oui.lisitem.OListItemGeneral
                android:id="@+id/showRecommendMesage"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                bytedance:oui_list_item_subtitle="@string/receive_notification"
                bytedance:oui_list_item_title="@string/settings_recommend_message_push"/>
            <TextView
                android:textColor="@color/oui_basic_text_3"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="16dp"
                android:text="@string/setting_section_reminder"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="24dp"
                style="@style/Subtitle_2_Medium"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/show_update_notification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.obric.oui.lisitem.OListItemGeneral
                android:id="@+id/showImageSwitch"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                bytedance:oui_list_item_subtitle="@string/settings_show_image_alert"
                bytedance:oui_list_item_title="@string/settings_show_image_options"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/showPrivacyPolicy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.ONestedScrollView>
</RelativeLayout>
