<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.layout.OUIFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_suggest_item"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:paddingHorizontal="20dp">
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/search_suggest_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/oui_text_0"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:id="@+id/search_suggest_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="278dp"
            android:maxLines="1"
            android:layout_centerVertical="true"
            android:textFontWeight="@integer/font_weight_480"
            style="@style/Label_L"/>
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="22dp"
            android:src="@drawable/oui_icon_search_3b"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <com.obric.oui.divider.ODivider
        android:layout_gravity="bottom"
        android:id="@+id/search_suggest_divider"
        android:layout_width="match_parent"
        android:layout_height="0.66dp"/>
</com.obric.oui.layout.OUIFrameLayout>
