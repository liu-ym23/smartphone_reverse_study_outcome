<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/topic_banner_desc_layout"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="@dimen/recommend_topic_top_banner_h"
        android:layout_margin="8dp">
        <TextView
            android:id="@+id/topic_banner_desc"
            android:layout_marginLeft="@dimen/topic_header_banner_margin"
            android:layout_marginRight="@dimen/topic_header_banner_margin"
            style="@style/topic_desc_style"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/topic_header_banner_margin"
            android:layout_marginTop="6dp"
            android:layout_marginRight="@dimen/topic_header_banner_margin"
            android:layout_marginBottom="@dimen/topic_header_banner_margin"
            app:cardCornerRadius="10dp"
            app:cardElevation="3dp">
            <com.bytedanceos.common.network.widget.NetworkImageView
                android:id="@+id/topic_banner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:contentDescription="@null"/>
        </androidx.cardview.widget.CardView>
    </RelativeLayout>
    <TextView
        android:textSize="13.5dp"
        android:textColor="#66000000"
        android:id="@+id/head_info"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="6dp"
        android:layout_below="@+id/topic_banner_desc_layout"
        android:lineSpacingExtra="6dp"/>
    <ImageView
        android:background="@drawable/line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:contentDescription="@null"/>
</RelativeLayout>
