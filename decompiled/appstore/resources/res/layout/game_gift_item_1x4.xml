<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/game_gift_pack_item"
    android:background="@drawable/app_list_selector"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="@dimen/app_list_height_1X4"
    android:minHeight="@dimen/app_list_height_1X4">
    <com.bytedanceos.common.network.widget.NetworkImageView
        android:id="@+id/game_icon"
        android:layout_marginRight="16.5dp"
        android:contentDescription="@null"
        style="@style/app_list_icon_style"/>
    <TextView
        android:id="@+id/game_btn"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        style="@style/app_recommend_list_status_text_view_style"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/game_content"
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_list_height_1X4"
        android:layout_toLeftOf="@+id/game_btn"
        android:layout_toRightOf="@+id/game_icon">
        <TextView
            android:id="@+id/game_name"
            android:paddingTop="@dimen/app_name_padding_top_1X4"
            style="@style/app_list_name_style"/>
        <TextView
            android:id="@+id/game_category"
            android:paddingTop="@dimen/app_rate_padding_top_1X4"
            android:layout_marginLeft="0.3dp"
            android:layout_marginRight="5dp"
            style="@style/app_list_category_style"/>
        <TextView
            android:id="@+id/game_des"
            android:paddingTop="@dimen/app_rate_padding_top_1X4"
            android:paddingBottom="@dimen/app_rate_padding_bottom_1X4"
            android:maxWidth="250dp"
            style="@style/app_list_brief_style"/>
        <ImageView
            android:id="@+id/appRate"
            android:paddingTop="@dimen/app_rate_padding_top_1X4"
            android:paddingBottom="@dimen/app_rate_padding_bottom_1X4"
            style="@style/app_list_brief_rate_style"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/game_item_line"
        android:background="@drawable/line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
