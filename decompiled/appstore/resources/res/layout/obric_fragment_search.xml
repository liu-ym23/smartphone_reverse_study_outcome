<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/search_history_container"
        android:paddingLeft="@dimen/search_recommend_flow_layout_margin_left"
        android:paddingTop="@dimen/oui_p_button_m1"
        android:paddingRight="@dimen/search_recommend_flow_layout_margin_right"
        android:paddingBottom="@dimen/oui_p_button_m1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedanceos.common.ui.widget.FlowLayout
            android:textColor="@android:color/white"
            android:id="@+id/search_history_flow_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:flChildSpacing="@dimen/search_recommend_flow_layout_child_space"
            app:flChildSpacingForLastRow="align"
            app:flMinChildSpacing="@dimen/search_recommend_flow_layout_min_child_space"
            app:flRowSpacing="@dimen/search_recommend_flow_layout_row_space"/>
        <ImageView
            android:id="@+id/clear_history"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="11dp"
            android:src="@drawable/oui_icon_close"
            android:contentDescription="@string/delete_search_history"/>
    </LinearLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        layout="@layout/common_fragment_base_listview"/>
</LinearLayout>
