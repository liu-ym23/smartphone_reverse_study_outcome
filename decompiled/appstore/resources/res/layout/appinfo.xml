<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/appinfo_root"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/appinfo_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        layout="@layout/detail_info_header"/>
    <com.bytedanceos.common.ui.widget.AppDetailScrollView
        android:id="@+id/appinfo_scrollview"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/scrollview_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/appinfo_image_hsv"
                layout="@layout/appinfo_image_hsv"/>
            <RelativeLayout
                android:id="@+id/app_des_layout"
                android:descendantFocusability="blocksDescendants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp">
                <ImageView
                    android:id="@+id/app_des_more"
                    android:clickable="false"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginLeft="12dp"
                    android:src="@drawable/oui_icon_right_arrow"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textColor="@color/oui_text_3"
                    android:ellipsize="end"
                    android:id="@+id/app_des"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:maxLines="2"
                    android:layout_toLeftOf="@+id/app_des_more"
                    android:layout_alignParentLeft="true"
                    style="@style/Body_S"/>
            </RelativeLayout>
            <include
                android:id="@+id/app_comments_layout"
                layout="@layout/appinfo_comment_header"/>
            <include
                android:id="@+id/appinfo_gift_pack"
                layout="@layout/appinfo_gift_pack"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/appinfo_relative_apps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/appinfo_classis_apps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </com.bytedanceos.common.ui.widget.AppDetailScrollView>
</LinearLayout>
