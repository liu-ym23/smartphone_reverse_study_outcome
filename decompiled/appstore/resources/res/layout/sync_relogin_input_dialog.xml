<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:scrollbars="none"
    android:fadingEdge="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/relogin_notice_text_size"
            android:gravity="left"
            android:id="@+id/relogin_notice_for_dialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/relogin_notice_margin_left"
            android:layout_marginTop="@dimen/relogin_notice_margin_top"
            android:layout_marginRight="@dimen/relogin_notice_margin_right"
            android:layout_marginBottom="@dimen/relogin_notice_margin_bottom"
            android:text="@string/relogin_notice_dialog"
            android:lineSpacingMultiplier="1.1"/>
        <obric.widget.PasswordEditText
            android:id="@+id/input_pwd_edittext_for_dialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/input_pwd_edittext_margin_left"
            android:layout_marginRight="@dimen/input_pwd_edittext_margin_right"
            android:hint="@string/loginPassword"
            android:layout_below="@+id/relogin_notice_for_dialog"
            style="@style/passwordEditTextStyle"/>
        <RelativeLayout
            android:id="@+id/account_verification_code"
            android:background="@drawable/edit_text_verification_code"
            android:paddingLeft="@dimen/relogin_account_verification_padding_left"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/relogin_notice_margin_left"
            android:layout_marginTop="@dimen/relogin_account_verification_margin_top"
            android:layout_marginRight="@dimen/relogin_notice_margin_right"
            android:layout_below="@+id/input_pwd_edittext_for_dialog">
            <EditText
                android:id="@+id/verification_code"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/loginVerificationCode"
                android:maxLength="10"
                android:layout_centerVertical="true"
                style="@style/editAccountInfoTextStyle"/>
            <ImageButton
                android:id="@+id/refresh"
                android:background="@drawable/relogin_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/relogin_refresh_margin_right"
                android:layout_alignParentRight="true"/>
            <ImageView
                android:id="@+id/verification_code_icon"
                android:layout_width="@dimen/relogin_verification_code_icon_width"
                android:layout_height="@dimen/relogin_verification_code_icon_height"
                android:layout_toLeftOf="@+id/refresh"
                android:layout_centerVertical="true"
                android:contentDescription="@null"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/bottom_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/relogin_bottom_layout_margin_top"
            android:layout_below="@+id/account_verification_code"/>
    </RelativeLayout>
</ScrollView>
