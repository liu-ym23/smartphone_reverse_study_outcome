<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ll_apps_update"
        android:paddingLeft="@dimen/tv_app_item_padding_left"
        android:paddingRight="@dimen/dp_12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_79">
        <TextView
            android:textSize="@dimen/app_manager_title_text_size"
            android:textColor="@color/color_6"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_uninstall_number"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:drawableLeft="@drawable/update_icon"
            android:layout_weight="1"/>
        <TextView
            android:textStyle="bold"
            android:textColor="#99000000"
            android:gravity="center"
            android:id="@+id/tv_update_all"
            android:background="@drawable/btn_selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/buy_all"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_apps_edit"
        android:paddingLeft="@dimen/tv_app_item_padding_left"
        android:paddingRight="@dimen/dp_12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_79">
        <CheckBox
            android:id="@+id/cb_check_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@drawable/checkbox"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#99000000"
            android:id="@+id/tv_select_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/checkbox_title_margin"
            android:text="@string/all_selected"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/textSize14"
            android:textColor="#99000000"
            android:gravity="center"
            android:id="@+id/tv_download_select"
            android:background="@drawable/btn_install_selected_selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/install"/>
        <TextView
            android:textSize="@dimen/textSize14"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_delete_select"
            android:background="@drawable/btn_delete_selected_selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/header_delete_btn"/>
    </LinearLayout>
    <include layout="@layout/common_recycler_view_wrap"/>
</LinearLayout>
