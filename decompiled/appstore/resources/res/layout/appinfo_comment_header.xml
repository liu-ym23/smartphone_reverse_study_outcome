<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp"
    android:paddingVertical="12dp">
    <TextView
        android:textSize="13.5sp"
        android:textColor="#66000000"
        android:id="@+id/no_comment_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/comments_header_margin_left"
        android:layout_marginTop="@dimen/comments_header_margin_top"
        android:layout_marginRight="@dimen/comments_header_margin_left"
        android:layout_marginBottom="@dimen/comments_header_margin_top"
        android:text="@string/no_comment_tip"/>
    <RelativeLayout
        android:id="@+id/app_comment_layout"
        android:layout_width="match_parent"
        android:layout_height="58dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/scoreLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/oui_text_2"
                android:gravity="top"
                android:id="@+id/appScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-8dp"
                android:text="@string/default_score"
                android:maxLines="1"
                style="@style/Title_Display"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/appRate_1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="16dp"
            android:src="@drawable/oui_star"
            android:contentDescription="@null"
            android:layout_marginStart="61dp"/>
        <TextView
            android:textColor="@color/oui_text_3b"
            android:ellipsize="end"
            android:gravity="bottom"
            android:id="@+id/appCommentsNum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_alignParentBottom="true"
            style="@style/Label_M"/>
        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="54dp"
            android:layout_height="10dp"
            android:layout_marginLeft="112dp"
            android:src="@drawable/oui_grey_rate_5"
            android:contentDescription="@null"/>
        <com.obric.oui.progress.OProgressView
            android:id="@+id/comment_rate5_progress"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginLeft="8dp"
            android:layout_toLeftOf="@+id/right_arrow"
            android:layout_toRightOf="@+id/imageView2"
            android:layout_alignTop="@+id/imageView2"
            app:oui_progress="45"
            app:oui_progress_color="@color/oui_text_3"/>
        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="54dp"
            android:layout_height="10dp"
            android:layout_marginTop="2dp"
            android:src="@drawable/oui_grey_rate_4"
            android:layout_below="@+id/imageView2"
            android:contentDescription="@null"
            android:layout_alignStart="@+id/imageView2"/>
        <com.obric.oui.progress.OProgressView
            android:id="@+id/comment_rate4_progress"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginLeft="8dp"
            android:layout_toLeftOf="@+id/right_arrow"
            android:layout_toRightOf="@+id/imageView3"
            android:layout_alignTop="@+id/imageView3"
            android:contentDescription="@null"
            app:oui_progress="45"
            app:oui_progress_color="@color/oui_text_3"/>
        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="54dp"
            android:layout_height="10dp"
            android:layout_marginTop="2dp"
            android:src="@drawable/oui_grey_rate_3"
            android:layout_below="@+id/imageView3"
            android:contentDescription="@null"
            android:layout_alignStart="@+id/imageView2"/>
        <com.obric.oui.progress.OProgressView
            android:id="@+id/comment_rate3_progress"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginLeft="8dp"
            android:layout_toLeftOf="@+id/right_arrow"
            android:layout_toRightOf="@+id/imageView4"
            android:layout_alignTop="@+id/imageView4"
            android:contentDescription="@null"
            app:oui_progress="45"
            app:oui_progress_color="@color/oui_text_3"/>
        <ImageView
            android:id="@+id/imageView5"
            android:layout_width="54dp"
            android:layout_height="10dp"
            android:layout_marginTop="2dp"
            android:src="@drawable/oui_grey_rate_2"
            android:layout_below="@+id/imageView4"
            android:contentDescription="@null"
            android:layout_alignStart="@+id/imageView2"/>
        <com.obric.oui.progress.OProgressView
            android:id="@+id/comment_rate2_progress"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginLeft="8dp"
            android:layout_toLeftOf="@+id/right_arrow"
            android:layout_toRightOf="@+id/imageView5"
            android:layout_alignTop="@+id/imageView5"
            android:contentDescription="@null"
            app:oui_progress="45"
            app:oui_progress_color="@color/oui_text_3"/>
        <ImageView
            android:id="@+id/imageView6"
            android:layout_width="54dp"
            android:layout_height="10dp"
            android:layout_marginTop="2dp"
            android:src="@drawable/oui_grey_rate_1"
            android:layout_below="@+id/imageView5"
            android:contentDescription="@null"
            android:layout_alignStart="@+id/imageView2"/>
        <com.obric.oui.progress.OProgressView
            android:id="@+id/comment_rate1_progress"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginLeft="8dp"
            android:layout_toLeftOf="@+id/right_arrow"
            android:layout_toRightOf="@+id/imageView6"
            android:layout_alignTop="@+id/imageView6"
            android:contentDescription="@null"
            app:oui_progress="45"
            app:oui_progress_color="@color/oui_text_3"/>
        <ImageView
            android:id="@+id/right_arrow"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginLeft="12dp"
            android:src="@drawable/oui_icon_right_arrow"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</RelativeLayout>
