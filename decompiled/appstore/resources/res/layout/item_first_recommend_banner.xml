<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.bytedanceos.common.network.widget.NetworkImageView
        android:id="@+id/niv_cover"
        android:visibility="visible"
        android:layout_width="@dimen/welcome_header_img_width"
        android:layout_height="@dimen/welcome_header_img_height"
        android:layout_marginTop="@dimen/welcome_header_padding_top"
        android:layout_marginBottom="@dimen/welcome_header_padding_bottom"
        android:scaleType="fitXY"
        android:layout_marginHorizontal="@dimen/welcome_header_padding_left_right"/>
</LinearLayout>
