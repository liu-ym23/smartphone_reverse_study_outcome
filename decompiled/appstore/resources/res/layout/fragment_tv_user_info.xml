<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/lkp_setting_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:gravity="center_horizontal"
        android:id="@+id/user_info_container"
        android:layout_width="@dimen/lkp_setting_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/user_info_container_margin"
        android:layout_marginBottom="@dimen/user_info_container_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_icon"
            android:background="@drawable/avator_profile_default"
            android:layout_width="@dimen/dp_52"
            android:layout_height="@dimen/dp_52"
            android:layout_marginTop="@dimen/user_icon_margin"
            android:scaleType="fitCenter"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/textSize15"
            android:textColor="#b3000000"
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginBottom="@dimen/dp_10"
            android:text="log in"
            android:layout_below="@+id/iv_icon"
            android:layout_centerHorizontal="true"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/head_content"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/lkp_setting_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/user_info_container"/>
    <FrameLayout
        android:id="@+id/nickname_content"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/lkp_setting_width"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/user_name_modify_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/head_content"/>
    <TextView
        android:textSize="@dimen/textSize18"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/account_logout"
        android:background="@drawable/tv_user_setting_logout_selector"
        android:layout_width="@dimen/lkp_setting_width"
        android:layout_height="@dimen/dp_60"
        android:layout_marginTop="@dimen/logout_btn_margin"
        android:text="@string/logout_account"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nickname_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>
