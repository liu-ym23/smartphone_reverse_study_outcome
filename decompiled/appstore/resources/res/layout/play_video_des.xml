<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/frameLayout"
    android:background="@color/video_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <VideoView
        android:layout_gravity="center"
        android:id="@+id/videoView"
        android:background="@android:color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:id="@+id/video_contral_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/video_control_header"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"/>
        <Button
            android:id="@+id/video_play_mid_btn"
            android:background="@drawable/icon_video_play"
            android:visibility="gone"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_centerInParent="true"/>
        <RelativeLayout
            android:id="@+id/video_control_footer"
            android:background="@drawable/video_bottom_bitmap"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="51dp"
            android:layout_alignParentBottom="true">
            <ImageView
                android:id="@+id/video_play_footer_btn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/video_ic_vidcontrol_pause"
                android:scaleType="centerInside"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <ProgressBar
            android:id="@+id/video_progressBar"
            android:visibility="gone"
            android:layout_centerInParent="true"
            style="@style/image_detail_progress_style"/>
    </RelativeLayout>
</FrameLayout>
