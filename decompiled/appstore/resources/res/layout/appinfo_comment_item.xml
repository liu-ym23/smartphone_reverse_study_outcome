<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp"
    android:paddingVertical="12dp">
    <TextView
        android:textStyle="bold"
        android:textColor="@color/oui_text_3"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/comment_item_user"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:maxWidth="@dimen/comments_list_user_name_max_width"
        android:singleLine="true"
        android:layout_toLeftOf="@+id/comment_item_support_click"
        android:layout_alignParentLeft="true"
        style="@style/Label_M"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/comment_item_support_click"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_alignTop="@+id/comment_item_user"
        android:layout_alignParentRight="true">
        <TextView
            android:textColor="@color/oui_text_3b"
            android:id="@+id/comment_item_support_times"
            android:layout_width="16dp"
            android:layout_height="16dp"
            style="@style/Label_L_Thin"/>
        <ImageView
            android:id="@+id/comment_item_support_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:src="@drawable/oui_icon_chevron"
            android:layout_marginVertical="2dp"
            style="@style/appinfo_comment_support_icon_style"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/comment_time_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/comment_item_user"
        android:layout_alignParentLeft="true">
        <ImageView
            android:id="@+id/comment_item_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null"/>
        <TextView
            android:textColor="@color/oui_text_3b"
            android:id="@+id/comment_item_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            style="@style/Label_S_Thin"/>
        <com.obric.oui.divider.ODivider
            android:id="@+id/dev_line"
            android:layout_width="0.66dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="4dp"
            android:layout_marginVertical="2dp"/>
        <TextView
            android:textColor="@color/oui_text_3b"
            android:ellipsize="end"
            android:id="@+id/comment_item_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/comments_list_beta_max_width"
            android:singleLine="true"
            style="@style/Label_S_Thin"/>
    </LinearLayout>
    <TextView
        android:textColor="@color/oui_text_1"
        android:gravity="center_vertical"
        android:id="@+id/comment_item_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/comment_time_layout"
        android:lineSpacingMultiplier="1.15"
        style="@style/Body_M"/>
</RelativeLayout>
