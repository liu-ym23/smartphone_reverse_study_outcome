<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/category_divider"
        android:background="@drawable/app_list_space"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:contentDescription="@null"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#e6313131"
        android:gravity="center_vertical"
        android:id="@+id/category_title"
        android:background="@drawable/app_list_selector"
        android:paddingLeft="10dp"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_below="@+id/category_divider"/>
    <ImageView
        android:id="@+id/app_list_space"
        android:background="@drawable/line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
