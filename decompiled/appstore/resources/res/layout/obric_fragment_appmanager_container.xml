<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.segmentedtab.OTabSegmentedLayout
        android:layout_gravity="center_horizontal"
        android:id="@+id/tab_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/oui_h_m2"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="@dimen/oui_p_container_3"
        app:bar_color="@color/oui_fill_sunken_variable"
        app:bar_stroke_color="@color/Transparent"
        app:indicator_anim_enable="true"
        app:indicator_color="@color/oui_fill_seg_selected"
        app:indicator_corner_radius="@dimen/oui_r_m2"
        app:indicator_height="@dimen/oui_h_m1"
        app:indicator_spacing="4dp"
        app:tab_textBold="SELECT"
        app:tab_textSelectColor="@color/oui_text_1"
        app:tab_textSize="14dp"
        app:tab_textUnselectColor="@color/oui_text_3"/>
    <androidx.viewpager2.widget.ViewPager2
        android:orientation="horizontal"
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.obric.oui.blur.OBlurMaskView
        android:layout_width="match_parent"
        android:layout_height="152dp"
        app:oBlurMask_blurRadius="8"
        app:oBlurMask_statusBarImmersion="true"/>
    <com.obric.oui.layout.OUILinearLayout
        android:layout_gravity="center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="92dp"
        android:layout_marginHorizontal="12dp"
        android:paddingVertical="12dp">
        <com.obric.oui.tab.OTabLayout
            android:id="@+id/app_manager_tab_layout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp"
            app:tabGravity="fill"
            app:tabMode="auto"
            app:tab_edgeFadeEnabled="false"
            style="@style/OTabTextV2.NoBackground.ChipsTab">
            <com.obric.oui.tab.OTabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/myapp_update"/>
            <com.obric.oui.tab.OTabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/third_party_apps"/>
            <com.obric.oui.tab.OTabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sys_app"/>
        </com.obric.oui.tab.OTabLayout>
    </com.obric.oui.layout.OUILinearLayout>
</FrameLayout>
