<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ListView
        android:id="@+id/fragment_game_reservation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:listSelector="@null"
        android:divider="@null"
        android:overScrollMode="always"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/blank"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp">
        <ImageView
            android:background="@drawable/oui_icon_time"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:backgroundTint="@color/oui_text_3b"/>
        <TextView
            android:textColor="@color/oui_text_3b"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/no_reserved_game_main"
            style="@style/Title_Title_L_Alt"/>
        <TextView
            android:textColor="@color/oui_text_3b"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/no_reserved_game_sub"
            style="@style/Title_Title_M_Thin"/>
    </LinearLayout>
</FrameLayout>
