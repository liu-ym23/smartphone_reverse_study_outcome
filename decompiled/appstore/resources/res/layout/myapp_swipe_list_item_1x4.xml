<?xml version="1.0" encoding="utf-8"?>
<com.bytedanceos.common.ui.widget.MyAppSwipeItemView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="@dimen/app_list_height_1X4"
    android:minHeight="@dimen/app_list_height_1X4">
    <RelativeLayout
        android:orientation="horizontal"
        android:id="@+id/myapp_lay"
        android:background="@drawable/myapp_list_selector"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/checkBoxFrame"
            android:layout_width="@dimen/swipe_item_checkbox_width"
            android:layout_height="match_parent">
            <CheckBox
                android:layout_gravity="center_vertical"
                android:id="@+id/checkBox"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/checkbox_margin"
                android:button="@drawable/checkbox"/>
        </FrameLayout>
        <RelativeLayout
            android:id="@+id/forground_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.bytedanceos.common.network.widget.NetworkImageView
                android:id="@+id/appIcon"
                android:src="@drawable/oui_default_app_icon"
                android:contentDescription="@null"
                style="@style/app_list_icon_style"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16.5dp"
                android:layout_marginRight="3dp"
                android:layout_toLeftOf="@+id/appStatusLay"
                android:layout_toRightOf="@+id/appIcon"
                android:layout_centerVertical="true">
                <TextView
                    android:id="@+id/appName"
                    android:paddingTop="0dp"
                    style="@style/app_list_name_style"/>
                <TextView
                    android:id="@+id/appCategory"
                    android:layout_marginTop="@dimen/app_category_margin_top"
                    style="@style/app_list_category_style"/>
                <TextView
                    android:id="@+id/appBrief"
                    android:layout_marginTop="@dimen/app_category_margin_top"
                    style="@style/app_list_brief_style"/>
                <TextView
                    android:id="@+id/appVersionName"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="@dimen/app_category_margin_top"
                    style="@style/app_list_update_style"/>
                <ImageView
                    android:id="@+id/appRate"
                    android:layout_marginTop="@dimen/app_category_margin_top"
                    style="@style/app_list_rate_style"/>
            </LinearLayout>
            <com.bytedanceos.common.ui.widget.AppStatusView
                android:id="@+id/appStatusLay"
                style="@style/app_list_item_style_large"/>
        </RelativeLayout>
        <ImageView
            android:background="@drawable/line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:contentDescription="@null"/>
    </RelativeLayout>
</com.bytedanceos.common.ui.widget.MyAppSwipeItemView>
