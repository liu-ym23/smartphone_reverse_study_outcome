<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/oui_bg_base_1"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="220dp">
    <com.bytedanceos.common.ui.widget.CircleLightAnimationView
        android:id="@+id/light_beam"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="205dp"
        android:layout_marginTop="-75dp"
        android:scaleType="fitXY"/>
    <RelativeLayout
        android:id="@+id/apps_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_alignParentBottom="true">
        <com.bytedanceos.common.ui.widget.RankingAppView
            android:id="@+id/app2"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="42dp"
            android:layout_alignParentLeft="true"
            android:layout_alignParentBottom="true"/>
        <com.bytedanceos.common.ui.widget.RankingAppView
            android:id="@+id/app3"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="42dp"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"/>
        <com.bytedanceos.common.ui.widget.RankingAppView
            android:id="@+id/app1"
            android:layout_width="68dp"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/app3"
            android:layout_toRightOf="@+id/app2"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="40dp"/>
    </RelativeLayout>
</RelativeLayout>
