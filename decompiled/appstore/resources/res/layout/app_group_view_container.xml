<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ViewStub
        android:id="@+id/app_group_name_stub"
        android:layout="@layout/app_group_title_name"
        android:inflatedId="@+id/app_group_name"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginLeft="8dp"
        android:layout_alignParentLeft="true"/>
    <ViewStub
        android:id="@+id/app_group_more_stub"
        android:layout="@layout/app_group_title_more"
        android:inflatedId="@+id/app_group_more"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_toRightOf="@+id/app_group_name_stub"
        android:layout_alignParentRight="true"/>
    <com.bytedanceos.common.ui.widget.BaseViewPager
        android:id="@+id/app_group_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/app_group_name"/>
</merge>
