<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/appinfo_scrollview"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/margin_view"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.obric.appstore.common.core.ui.view.ObricAppItemView
                android:id="@+id/appinfo_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/margin_view"/>
            <com.obric.oui.paneltitlebar.OPanelTitleBar
                android:id="@+id/brief_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="-4dp"
                app:layout_constraintTop_toBottomOf="@+id/appinfo_item"
                app:oui_panel_title="@string/summary"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/brief_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintTop_toBottomOf="@+id/brief_title"
                style="@style/Body_S"/>
            <com.obric.oui.paneltitlebar.OPanelTitleBar
                android:id="@+id/new_feature_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="-4dp"
                app:layout_constraintTop_toBottomOf="@+id/brief_detail"
                app:oui_panel_title="@string/features"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/new_feature_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintTop_toBottomOf="@+id/new_feature_title"
                style="@style/Body_S"/>
            <com.obric.oui.paneltitlebar.OPanelTitleBar
                android:id="@+id/appinfo_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="-4dp"
                app:layout_constraintTop_toBottomOf="@+id/new_feature_detail"
                app:oui_panel_title="@string/info"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:gravity="center"
                android:id="@+id/category_title"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="@string/info_category"
                android:maxLines="1"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/appinfo_title"
                style="@style/Body_S"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:gravity="center"
                android:id="@+id/category_detail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/category_title"
                app:layout_constraintTop_toTopOf="@+id/category_title"
                style="@style/Body_S"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:gravity="center"
                android:id="@+id/update_title"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/info_update"
                android:maxLines="1"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/category_title"
                style="@style/Body_S"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:gravity="center"
                android:id="@+id/update_detail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/update_title"
                app:layout_constraintTop_toTopOf="@+id/update_title"
                style="@style/Body_S"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:gravity="center"
                android:id="@+id/version_title"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/info_version"
                android:maxLines="1"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/update_title"
                style="@style/Body_S"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:gravity="center"
                android:id="@+id/version_detail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/version_title"
                app:layout_constraintTop_toTopOf="@+id/version_title"
                style="@style/Body_S"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:gravity="center"
                android:id="@+id/developer_title"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/info_developers"
                android:maxLines="1"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/version_title"
                style="@style/Body_S"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_3"
                android:gravity="center"
                android:id="@+id/developer_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/developer_title"
                app:layout_constraintTop_toTopOf="@+id/developer_title"
                style="@style/Body_S"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:gravity="center"
                android:id="@+id/icp_title"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/icp_number_title"
                android:maxLines="1"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/developer_title"
                style="@style/Body_S"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_3"
                android:gravity="center"
                android:id="@+id/icp_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/icp_title"
                app:layout_constraintTop_toTopOf="@+id/icp_title"
                style="@style/Body_S"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:gravity="center"
                android:id="@+id/source_title"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/info_from"
                android:maxLines="1"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/icp_title"
                style="@style/Body_S"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:gravity="center"
                android:id="@+id/source_detail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/source_title"
                app:layout_constraintTop_toTopOf="@+id/source_title"
                style="@style/Body_S"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:gravity="center"
                android:id="@+id/permission_title"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/permission_detail"
                android:maxLines="1"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/source_title"
                style="@style/Body_S"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_text_3"
                android:gravity="center"
                android:id="@+id/permission_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/view_all_permissions"
                android:maxLines="1"
                android:layout_marginEnd="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/permission_title"
                app:layout_constraintTop_toTopOf="@+id/permission_title"
                style="@style/Body_S"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.obric.oui.bouncelayout.OScrollView>
</LinearLayout>
