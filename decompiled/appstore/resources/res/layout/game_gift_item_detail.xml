<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/game_gift_pack_item"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:minHeight="64dp">
    <ImageView
        android:id="@+id/game_icon"
        android:background="@drawable/game_gift_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="20dp"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/game_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_toLeftOf="@+id/game_btn"
        android:layout_toRightOf="@+id/game_icon"
        android:layout_centerVertical="true">
        <TextView
            android:textColor="@color/oui_text_1"
            android:ellipsize="end"
            android:id="@+id/game_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/app_item_name_max_width"
            android:maxLines="1"
            android:includeFontPadding="false"
            style="@style/Label_L"/>
        <TextView
            android:textColor="@color/oui_text_2"
            android:ellipsize="end"
            android:id="@+id/game_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/app_item_name_max_width"
            android:maxLines="2"
            android:includeFontPadding="false"
            style="@style/Label_M_Thin"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/appinfo_gift_item_btn_size"
        android:textColor="#ffffff"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/game_btn"
        android:background="@drawable/info_btn_selector"
        android:layout_width="@dimen/appinfo_gift_item_btn_width"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:lines="1"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <TextView
        android:gravity="center"
        android:id="@+id/game_des"
        android:layout_width="@dimen/appinfo_gift_item_btn_width"
        android:layout_height="match_parent"
        android:lines="1"
        android:layout_below="@+id/game_btn"
        android:layout_alignParentRight="true"
        style="@style/app_list_brief_style"/>
</RelativeLayout>
