<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_list_item"
    android:background="@drawable/app_list_selector"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="79dp">
    <com.bytedanceos.common.network.widget.NetworkImageView
        android:id="@+id/appIcon"
        android:src="@drawable/oui_default_app_icon"
        android:contentDescription="@null"
        style="@style/top_ad_app_list_icon_style"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/app_recommend_list_item_content_area"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16.5dp"
        android:minHeight="@dimen/top_ad_app_icon_size"
        android:layout_toLeftOf="@+id/appStatusLay"
        android:layout_toRightOf="@+id/appIcon"
        android:layout_centerVertical="true">
        <TextView
            android:id="@+id/appName"
            android:paddingTop="0dp"
            style="@style/app_list_name_style"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/categoryLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/app_category_margin_top">
            <TextView
                android:id="@+id/appCategory"
                android:layout_width="0dp"
                android:layout_marginLeft="0.3dp"
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                style="@style/app_list_category_style"/>
            <TextView
                android:layout_gravity="center_vertical"
                android:id="@+id/adCategory"
                style="@style/app_list_first_pub_style"/>
        </LinearLayout>
    </LinearLayout>
    <com.bytedanceos.common.ui.widget.AppStatusView
        android:id="@+id/appStatusLay"
        android:layout_marginRight="@dimen/checkbox_margin"
        android:maxWidth="@dimen/status_textview_max_width"
        android:minWidth="@dimen/status_textview_min_width"
        style="@style/base_app_item_status_view_style"/>
    <ImageView
        android:id="@+id/div_line"
        android:background="@drawable/app_list_space"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
