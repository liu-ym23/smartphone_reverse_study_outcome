<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/relative_layout"
        android:padding="@dimen/dp_2"
        android:layout_width="480dp"
        android:layout_height="640dp"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginBottom="@dimen/dp_20"
        android:adjustViewBounds="true"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="@dimen/textSize20"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:background="@drawable/tv_app_feedback_shape_round_top"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_40"
            android:text="@string/permission_detail"/>
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_alignTop="@+id/tv_title"
            android:layout_alignBottom="@+id/tv_title"/>
        <androidx.core.widget.NestedScrollView
            android:background="@drawable/setting_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:layout_below="@+id/tv_title">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:id="@+id/constraint_layout"
                android:paddingLeft="@dimen/dp_14"
                android:paddingTop="@dimen/dp_12"
                android:paddingRight="@dimen/dp_14"
                android:paddingBottom="@dimen/dp_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/iv_logo"
                    android:layout_width="@dimen/dp_53"
                    android:layout_height="@dimen/dp_53"
                    android:src="@drawable/titlebar_shadow"
                    android:scaleType="centerCrop"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/textSize15"
                    android:textColor="#cc000000"
                    android:id="@+id/tv_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_12"
                    android:singleLine="true"
                    app:layout_constraintBottom_toTopOf="@+id/tv_version"
                    app:layout_constraintLeft_toRightOf="@+id/iv_logo"
                    app:layout_constraintTop_toTopOf="@+id/iv_logo"
                    app:layout_constraintVertical_chainStyle="packed"/>
                <TextView
                    android:textSize="@dimen/textSize12"
                    android:textColor="#9a000000"
                    android:id="@+id/tv_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:singleLine="true"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_logo"
                    app:layout_constraintLeft_toLeftOf="@+id/tv_name"
                    app:layout_constraintTop_toBottomOf="@+id/tv_name"
                    app:layout_constraintVertical_chainStyle="packed"/>
                <TextView
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="#cc000000"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_permission_brief"
                    android:paddingLeft="@dimen/dp_26"
                    android:paddingTop="@dimen/dp_12"
                    android:paddingBottom="@dimen/dp_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/permissions_desc"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/iv_logo"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/permission_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_permission_brief"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
        <ImageView
            android:background="@drawable/titlebar_shadow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_title"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/iv_stroke"
        android:background="@drawable/level2_winframe_bg_normal_state"
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/relative_layout"
        android:layout_alignBottom="@+id/relative_layout"
        android:layout_centerInParent="true"/>
</RelativeLayout>
