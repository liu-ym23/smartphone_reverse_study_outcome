<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/main_header"
        android:background="@drawable/titlebar_bg"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="51dp">
        <TextView
            android:visibility="visible"
            android:text="@string/nickname_title"
            style="@style/header_title_style"/>
        <Button
            android:textSize="13.5sp"
            android:textColor="#ffffff"
            android:id="@+id/nickname_cancel"
            android:background="@drawable/button"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="6dp"
            android:text="@string/cancel"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/view_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:layout_below="@+id/main_header">
        <EditText
            android:id="@+id/nickname"
            android:background="@drawable/edit_text_verification_code"
            android:padding="10dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:hint="@string/nickname_input"
            android:inputType="textEmailAddress"
            style="@style/login_input_text_style"/>
        <TextView
            android:textSize="13.5sp"
            android:textColor="#828287"
            android:id="@+id/nickname_alert"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nickname_alert"
            android:layout_below="@+id/nickname"/>
    </RelativeLayout>
</RelativeLayout>
