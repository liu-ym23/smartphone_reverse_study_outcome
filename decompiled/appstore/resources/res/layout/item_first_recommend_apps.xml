<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="80dp"
    android:layout_height="96dp">
    <com.bytedanceos.common.network.widget.NetworkImageView
        android:id="@+id/iv_logo"
        android:layout_width="@dimen/welcome_app_img_size"
        android:layout_height="@dimen/welcome_app_img_size"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="12dp"/>
    <com.obric.oui.checkbox.OCheckBox
        android:id="@+id/iv_select"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="7dp"
        android:layout_marginRight="11dp"
        android:layout_alignParentRight="true"
        android:layout_marginVertical="7dp"/>
    <com.obric.oui.text.OTextView
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_below="@+id/iv_logo"
        android:layout_centerHorizontal="true"
        android:layout_marginVertical="8dp"
        style="@style/Label_M"/>
</RelativeLayout>
