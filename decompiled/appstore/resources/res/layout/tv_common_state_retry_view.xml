<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_state_retry_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/tv_ic_status_no_network"/>
    <TextView
        android:textSize="@dimen/textSize19"
        android:textStyle="bold"
        android:textColor="#33000000"
        android:id="@+id/tv_state_retry_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"/>
    <TextView
        android:textSize="@dimen/textSize15"
        android:textStyle="bold"
        android:textColor="#1f000000"
        android:id="@+id/tv_state_retry_sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_3"/>
    <TextView
        android:textSize="@dimen/textSize14"
        android:textStyle="bold"
        android:textColor="#99000000"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_state_retry"
        android:background="@drawable/app_status_view_bg_selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
