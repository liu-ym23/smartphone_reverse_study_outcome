<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.layout.OUIRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/title_default"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginHorizontal="8dp"
    app:oui_radius="@dimen/oui_r_l3_rect">
    <ImageView
        android:id="@+id/title_icon"
        android:padding="18dp"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="fitCenter"
        android:layout_centerVertical="true"
        android:contentDescription="@null"/>
    <TextView
        android:textColor="@color/oui_text_1"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/right_arrow"
        android:layout_toRightOf="@+id/title_icon"
        android:layout_centerVertical="true"
        style="@style/BtnLabel_M2"/>
    <ImageView
        android:id="@+id/right_arrow"
        android:padding="4dp"
        android:layout_width="18dp"
        android:layout_height="28dp"
        android:layout_marginRight="12dp"
        android:src="@drawable/oui_icon_right_arrow"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"/>
    <com.obric.oui.divider.ODivider
        android:id="@+id/divider_line"
        android:layout_width="match_parent"
        android:layout_height="0.66dp"
        android:layout_alignLeft="@+id/title_icon"
        android:layout_alignParentBottom="true"/>
</com.obric.oui.layout.OUIRelativeLayout>
