<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/summary_scroll"
    android:paddingTop="12dp"
    android:scrollbars="none"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.obric.oui.sectiontitlebar.OSectionTitleBar
            android:id="@+id/app_summary_title"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginLeft="4dp"/>
        <TextView
            android:textColor="@color/oui_text_3"
            android:gravity="center_vertical"
            android:id="@+id/feedback"
            android:focusable="false"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginRight="20dp"
            android:text="@string/feedback"
            android:drawableRight="@drawable/oui_icon_right_arrow"
            android:layout_alignBaseline="@+id/app_summary_title"
            android:layout_alignParentRight="true"
            style="@style/Label_L"/>
        <TextView
            android:textColor="@color/oui_text_3"
            android:id="@+id/appSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/app_summary_title"
            android:paddingHorizontal="20dp"
            style="@style/Body_S"/>
        <com.obric.oui.sectiontitlebar.OSectionTitleBar
            android:id="@+id/app_feature_title"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginLeft="4dp"
            android:layout_marginTop="16dp"
            android:layout_below="@+id/appSummary"/>
        <TextView
            android:textColor="@color/oui_text_3"
            android:id="@+id/appFeatures"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/app_feature_title"
            android:paddingHorizontal="20dp"
            style="@style/Body_S"/>
        <RelativeLayout
            android:id="@+id/appInfoContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_below="@+id/appFeatures"
            android:paddingHorizontal="20dp">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/oui_text_3"
                android:id="@+id/textView3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/info"
                style="@style/Label_L"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/appinfo_aliasLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/info_aliasname"
                android:layout_below="@+id/textView3"
                android:layout_alignLeft="@+id/textView3"
                style="@style/Label_M_Thin"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/appinfo_aliasName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBaseline="@+id/appinfo_aliasLabel"
                android:layout_alignLeft="@+id/appinfo_update"
                style="@style/Label_M_Thin"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/info_category"
                android:layout_below="@+id/appinfo_aliasLabel"
                android:layout_alignLeft="@+id/textView3"
                style="@style/Label_M_Thin"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/appinfo_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBaseline="@+id/textView4"
                android:layout_alignLeft="@+id/appinfo_update"
                style="@style/Label_M_Thin"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/textView6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/info_update"
                android:layout_below="@+id/textView4"
                android:layout_alignLeft="@+id/textView3"
                style="@style/Label_M_Thin"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/appinfo_update"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="55dp"
                android:layout_toRightOf="@+id/textView6"
                android:layout_alignBaseline="@+id/textView6"
                style="@style/Label_M_Thin"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/textView8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/info_version"
                android:layout_below="@+id/textView6"
                android:layout_alignLeft="@+id/textView3"
                style="@style/Label_M_Thin"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/appinfo_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBaseline="@+id/textView8"
                android:layout_alignLeft="@+id/appinfo_update"
                style="@style/Label_M_Thin"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/textView12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/info_developers"
                android:layout_below="@+id/textView8"
                android:layout_alignLeft="@+id/textView3"
                style="@style/Label_M_Thin"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/appinfo_developers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBaseline="@+id/textView12"
                android:layout_alignLeft="@+id/appinfo_update"
                style="@style/Label_M_Thin"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/textView14"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/info_compatibility"
                android:layout_below="@+id/textView12"
                android:layout_alignLeft="@+id/textView3"
                style="@style/Label_M_Thin"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/appinfo_compatibility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBaseline="@+id/textView14"
                android:layout_alignLeft="@+id/appinfo_update"
                style="@style/Label_M_Thin"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/appinfo_fromLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/info_from"
                android:layout_below="@+id/textView14"
                android:layout_alignLeft="@+id/textView3"
                style="@style/Label_M_Thin"/>
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/textView14"
                android:layout_alignLeft="@+id/appinfo_update">
                <com.bytedanceos.common.network.widget.NetworkImageView
                    android:id="@+id/appinfo_fromImage"
                    android:visibility="gone"
                    android:layout_width="13sp"
                    android:layout_height="13sp"
                    android:layout_marginRight="4dp"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textColor="@color/oui_text_3"
                    android:id="@+id/appinfo_from"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="4dp"
                    android:layout_toRightOf="@+id/appinfo_fromImage"
                    android:layout_centerVertical="true"
                    style="@style/Label_M_Thin"/>
            </RelativeLayout>
            <TextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/appinfo_special_support"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/special_support"
                android:layout_below="@+id/appinfo_fromLabel"
                android:layout_alignLeft="@+id/textView3"
                style="@style/Label_M_Thin"/>
            <RelativeLayout
                android:id="@+id/onestep_label"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/comments_appinfo_space"
                android:layout_below="@+id/appinfo_fromLabel"
                android:layout_alignLeft="@+id/appinfo_update">
                <TextView
                    android:textColor="@color/oui_text_3"
                    android:id="@+id/drag_one_step"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/info_onestep_margin"
                    android:text="@string/onestep_drag"
                    style="@style/Label_M_Thin"/>
                <TextView
                    android:textColor="@color/oui_text_3"
                    android:id="@+id/find_more"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/find_more"
                    android:layout_toRightOf="@+id/drag_one_step"
                    android:layout_centerVertical="true"
                    style="@style/Label_M_Thin"/>
            </RelativeLayout>
            <TextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/tv_permessions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/permission_detail"
                android:layout_below="@+id/onestep_label"
                android:layout_alignLeft="@+id/textView3"
                style="@style/Label_M_Thin"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/tv_view_permessions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/comments_list_rate_left"
                android:text="@string/view_all_permissions"
                android:layout_alignBaseline="@+id/tv_permessions"
                android:layout_alignLeft="@+id/appinfo_update"
                style="@style/Label_M_Thin"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/tv_icp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icp"
                android:layout_below="@+id/tv_permessions"
                android:layout_alignLeft="@+id/textView3"
                style="@style/Label_M_Thin"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:id="@+id/tv_view_icp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/comments_list_rate_left"
                android:text="@string/view_all_permissions"
                android:layout_alignBaseline="@+id/tv_icp"
                android:layout_alignLeft="@+id/appinfo_update"
                style="@style/Label_M_Thin"/>
        </RelativeLayout>
    </RelativeLayout>
</ScrollView>
