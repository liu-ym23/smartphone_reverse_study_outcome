<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/tv_app_item_vertical_width"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/appIcon"
        android:layout_width="@dimen/tv_app_firstrecommend_item_vertical_width"
        android:layout_height="@dimen/tv_app_firstrecommend_item_vertical_width"
        android:layout_marginLeft="@dimen/dp_10"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginRight="@dimen/dp_10"
        android:src="@drawable/oui_default_app_icon"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_select"
        android:layout_width="@dimen/dp_36"
        android:layout_height="@dimen/dp_36"
        android:src="@drawable/selector_recommend_check_box"
        app:layout_constraintCircle="@+id/appIcon"
        app:layout_constraintCircleAngle="-20"
        app:layout_constraintCircleRadius="@dimen/dp_80"/>
    <TextView
        android:textSize="14sp"
        android:ellipsize="end"
        android:id="@+id/appName"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginBottom="@dimen/dp_12"
        android:maxLines="1"
        android:maxEms="5"
        app:layout_constraintLeft_toLeftOf="@+id/appIcon"
        app:layout_constraintRight_toRightOf="@+id/appIcon"
        app:layout_constraintTop_toBottomOf="@+id/appIcon"
        style="@style/normal_app_name_style"/>
</androidx.constraintlayout.widget.ConstraintLayout>
