<?xml version="1.0" encoding="utf-8"?>
<com.obric.oui.layout.OUIFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="156dp"
    android:layout_height="match_parent"
    app:oui_layout_borderColor="@color/oui_line_1"
    app:oui_layout_borderWidth="1dp"
    app:oui_radius="16dp">
    <com.bytedanceos.common.network.widget.NetworkImageView
        android:id="@+id/app_video_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:layout_centerInParent="true"
        android:contentDescription="@null"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/app_video_play"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_video_play"
        android:scaleType="centerCrop"/>
</com.obric.oui.layout.OUIFrameLayout>
