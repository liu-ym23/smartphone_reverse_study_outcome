<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <HorizontalScrollView
        android:id="@+id/images_hsv"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        style="@style/appinfo_image_hsv_style">
        <LinearLayout
            android:orientation="horizontal"
            android:paddingLeft="@dimen/video_landscape_margin"
            android:paddingRight="20dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/app_video_des"
                android:background="@drawable/screenshot_border"
                android:padding="1dp"
                android:layout_width="153dp"
                android:layout_height="272dp"
                android:layout_marginLeft="8dp">
                <com.bytedanceos.common.network.widget.NetworkImageView
                    android:id="@+id/app_video_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:layout_centerInParent="true"
                    android:contentDescription="@null"/>
                <ImageView
                    android:id="@+id/app_video_play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_video_play"
                    android:scaleType="centerCrop"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
            <FrameLayout
                android:background="@drawable/screenshot_border"
                android:padding="1dp"
                android:layout_width="153dp"
                android:layout_height="272dp"
                android:layout_marginLeft="8dp">
                <com.bytedanceos.common.network.widget.NetworkImageView
                    android:id="@+id/appImage1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/app_image_des_4"/>
            </FrameLayout>
            <FrameLayout
                android:background="@drawable/screenshot_border"
                android:padding="1dp"
                android:layout_width="153dp"
                android:layout_height="272dp"
                android:layout_marginLeft="8dp">
                <com.bytedanceos.common.network.widget.NetworkImageView
                    android:id="@+id/appImage2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/app_image_des_4"/>
            </FrameLayout>
            <FrameLayout
                android:background="@drawable/screenshot_border"
                android:padding="1dp"
                android:layout_width="153dp"
                android:layout_height="272dp"
                android:layout_marginLeft="8dp">
                <com.bytedanceos.common.network.widget.NetworkImageView
                    android:id="@+id/appImage3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/app_image_des_4"/>
            </FrameLayout>
            <FrameLayout
                android:background="@drawable/screenshot_border"
                android:padding="1dp"
                android:layout_width="153dp"
                android:layout_height="272dp"
                android:layout_marginLeft="8dp">
                <com.bytedanceos.common.network.widget.NetworkImageView
                    android:id="@+id/appImage4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/app_image_des_4"/>
            </FrameLayout>
            <FrameLayout
                android:background="@drawable/screenshot_border"
                android:padding="1dp"
                android:layout_width="153dp"
                android:layout_height="272dp"
                android:layout_marginLeft="8dp">
                <com.bytedanceos.common.network.widget.NetworkImageView
                    android:id="@+id/appImage5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/app_image_des_4"/>
            </FrameLayout>
        </LinearLayout>
    </HorizontalScrollView>
</RelativeLayout>
