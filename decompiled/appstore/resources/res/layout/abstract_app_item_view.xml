<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/base_app_list_item"
    android:layout_width="match_parent"
    android:layout_height="@dimen/oui_app_list_height">
    <RelativeLayout
        android:id="@+id/app_no_layout"
        android:visibility="gone"
        android:layout_width="@dimen/app_number_width"
        android:layout_height="@dimen/oui_app_list_height"
        android:layout_marginLeft="@dimen/app_number_margin_left">
        <TextView
            android:id="@+id/appNo"
            android:visibility="visible"
            android:text="@string/number_text"
            style="@style/app_recommend_list_no_style"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/appIcon"
        android:src="@drawable/oui_default_app_icon"
        android:layout_toRightOf="@+id/app_no_layout"
        android:contentDescription="@null"
        style="@style/oui_app_list_icon_style"/>
    <com.bytedanceos.common.ui.widget.AppStatusView
        android:id="@+id/appStatusLay"
        android:clickable="true"
        android:descendantFocusability="blocksDescendants"
        android:layout_height="@dimen/oui_app_list_height"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        style="@style/base_app_item_status_view_style"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/info_layout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_toLeftOf="@+id/appStatusLay"
        android:layout_toRightOf="@+id/appIcon"
        android:layout_centerVertical="true"
        android:layout_marginVertical="8dp"
        android:paddingHorizontal="@dimen/app_name_margin_left">
        <TextView
            android:ellipsize="end"
            android:id="@+id/appName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/app_item_name_max_width"
            android:text="@string/long_text"
            android:singleLine="true"
            style="@style/Label_L"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/categoryLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:ellipsize="end"
                android:id="@+id/appCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/app_item_name_max_width"
                android:text="@string/long_text"
                android:singleLine="true"
                style="@style/Label_M_Thin"/>
            <TextView
                android:id="@+id/label_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/label_padding"
                android:text="@string/label_ads"
                style="@style/OTag.Text.Small.RoundedRectangle.Accent.Light"/>
            <TextView
                android:id="@+id/label_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/label_padding"
                android:text="@string/label_ads"
                style="@style/OTag.Text.Small.RoundedRectangle.Accent.Light"/>
        </LinearLayout>
        <TextView
            android:ellipsize="end"
            android:id="@+id/appBrief"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/app_item_name_max_width"
            android:text="@string/long_text"
            android:singleLine="true"
            style="@style/Label_S_Thin"/>
        <ImageView
            android:id="@+id/appRate"
            style="@style/oui_app_list_brief_rate_style"/>
        <TextView
            android:id="@+id/appSource"
            style="@style/app_list_source_style"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/app_list_space"
        android:background="@drawable/line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignLeft="@+id/info_layout"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
