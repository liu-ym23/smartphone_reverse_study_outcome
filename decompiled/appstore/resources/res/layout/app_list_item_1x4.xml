<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_list_item"
    android:background="@drawable/app_list_selector"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="@dimen/app_list_height_1X4"
    android:minHeight="@dimen/app_list_height_1X4">
    <RelativeLayout
        android:id="@+id/app_no_layout"
        android:visibility="gone"
        android:layout_width="52dp"
        android:layout_height="@dimen/app_list_height_1X4">
        <TextView
            android:id="@+id/appNo"
            style="@style/app_recommend_list_no_style"/>
    </RelativeLayout>
    <com.bytedanceos.common.network.widget.NetworkImageView
        android:id="@+id/appIcon"
        android:src="@drawable/oui_default_app_icon"
        android:layout_toRightOf="@+id/app_no_layout"
        android:contentDescription="@null"
        style="@style/app_list_icon_style"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/recommend_list_item_content"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="16.5dp"
        android:layout_toLeftOf="@+id/appStatusLay"
        android:layout_toRightOf="@+id/appIcon">
        <TextView
            android:id="@+id/appName"
            android:paddingTop="@dimen/app_name_padding_top_1X4"
            style="@style/app_list_name_style"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/categoryLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/app_category_padding_top_1X4">
            <TextView
                android:id="@+id/appCategory"
                android:layout_width="0dp"
                android:layout_marginLeft="0.3dp"
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                style="@style/app_list_category_style"/>
            <TextView
                android:layout_gravity="center_vertical"
                android:id="@+id/label_0"
                android:layout_marginRight="5dp"
                style="@style/app_list_first_pub_style"/>
            <TextView
                android:layout_gravity="center_vertical"
                android:id="@+id/label_1"
                style="@style/app_list_first_pub_style"/>
        </LinearLayout>
        <FrameLayout
            android:paddingTop="@dimen/app_rate_padding_top_1X4"
            android:paddingBottom="@dimen/app_rate_padding_bottom_1X4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/appBrief"
                style="@style/app_list_brief_style"/>
            <ImageView
                android:id="@+id/appRate"
                android:layout_marginTop="2dp"
                style="@style/app_list_brief_rate_style"/>
        </FrameLayout>
        <TextView
            android:id="@+id/appSource"
            style="@style/app_list_source_style"/>
    </LinearLayout>
    <com.bytedanceos.common.ui.widget.AppStatusView
        android:id="@+id/appStatusLay"
        style="@style/app_list_item_style_large"/>
    <ImageView
        android:id="@+id/app_list_space"
        android:background="@drawable/line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
