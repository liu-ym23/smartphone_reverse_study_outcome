<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_list_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_first"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/app_list_item_content"
        android:layout_marginStart="@dimen/checkbox_margin"
        android:layout_alignStart="@+id/app_list_item_content"/>
    <ImageView
        android:id="@+id/iv_second"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/iv_first"
        android:layout_marginStart="@dimen/app_list_item_images_horizontal_interval"
        android:layout_toEndOf="@+id/iv_first"/>
    <ImageView
        android:id="@+id/iv_third"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/iv_second"
        android:layout_marginStart="@dimen/app_list_item_images_horizontal_interval"
        android:layout_marginEnd="@dimen/checkbox_margin"
        android:layout_toEndOf="@+id/iv_second"/>
    <ImageView
        android:id="@+id/app_list_space_with_images"
        android:background="@drawable/line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/app_list_item_images_vertical_interval"
        android:layout_below="@+id/iv_first"/>
</merge>
