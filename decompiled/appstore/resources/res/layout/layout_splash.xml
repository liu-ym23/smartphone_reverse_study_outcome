<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_ad"
        android:background="@drawable/bg_splash"
        android:layout_width="match_parent"
        android:layout_height="684dp"
        android:scaleType="centerCrop"/>
    <TextView
        android:textSize="@dimen/splash_ad_skip_size"
        android:textColor="@color/splash_ad_skip_text"
        android:gravity="center"
        android:id="@+id/tv_skip"
        android:background="@drawable/bg_splash_skip"
        android:visibility="gone"
        android:layout_width="@dimen/splash_ad_skip_width"
        android:layout_height="@dimen/splash_ad_skip_height"
        android:layout_marginTop="@dimen/splash_ad_skip_margin_top"
        android:layout_marginRight="@dimen/splash_ad_skip_margin_right"
        android:includeFontPadding="false"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/layout_logo"
        android:background="@color/splash_ad_logo_bg"
        android:paddingTop="26dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/iv_ad"
        android:layout_alignParentBottom="true">
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="@dimen/splash_ad_logo_side"
            android:layout_height="@dimen/splash_ad_logo_side"
            android:src="@drawable/logo_splash"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/splash_ad_logo_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="1dp">
            <TextView
                android:textColor="@color/oui_text_1"
                android:gravity="center_vertical"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/splash_ad_title"
                style="@style/Title_Title_M"/>
            <TextView
                android:textColor="@color/oui_text_3"
                android:gravity="center_vertical"
                android:id="@+id/tv_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/splash_ad_desc"
                style="@style/Label_M_Thin"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
