<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/gl_pager_line_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/tv_item_le_ri"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/gl_pager_line_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/tv_item_le_ri"/>
    <TextView
        android:textSize="@dimen/textSize15"
        android:textStyle="bold"
        android:textColor="@color/tv_app_item_group_title_color"
        android:gravity="center_vertical"
        android:id="@+id/tv_category_title"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/tv_item_le_ri"
        android:maxLines="1"
        app:layout_constraintLeft_toLeftOf="@+id/gl_pager_line_left"
        app:layout_constraintRight_toRightOf="@+id/gl_pager_line_right"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/textSize12"
        android:textStyle="bold"
        android:textColor="@color/tv_app_item_brief_color"
        android:gravity="center"
        android:id="@+id/tv_next"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/dp_10"
        android:text="全部应用"
        app:layout_constraintBottom_toBottomOf="@+id/tv_category_title"
        app:layout_constraintRight_toLeftOf="@+id/iv_next"
        app:layout_constraintTop_toTopOf="@+id/tv_category_title"/>
    <ImageView
        android:id="@+id/iv_next"
        android:paddingRight="@dimen/dp_15"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/item_arrow"
        app:layout_constraintBottom_toBottomOf="@+id/tv_next"
        app:layout_constraintRight_toRightOf="@+id/gl_pager_line_right"
        app:layout_constraintTop_toTopOf="@+id/tv_next"/>
    <TextView
        android:textSize="@dimen/textSize12"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_group_download_all"
        android:background="@drawable/lkp_install_all_round"
        android:visibility="gone"
        android:layout_width="@dimen/dp_68"
        android:layout_height="@dimen/dp_25"
        android:text="@string/buy_all"
        app:layout_constraintBottom_toBottomOf="@+id/tv_category_title"
        app:layout_constraintRight_toRightOf="@+id/gl_pager_line_right"
        app:layout_constraintTop_toTopOf="@+id/tv_category_title"/>
    <ImageView
        android:id="@+id/tv_pager_title_space"
        android:background="@drawable/line"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="@+id/gl_pager_line_left"
        app:layout_constraintRight_toRightOf="@+id/gl_pager_line_right"
        app:layout_constraintTop_toBottomOf="@+id/tv_category_title"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_category_title"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_category_title,tv_pager_title_space"/>
</merge>
