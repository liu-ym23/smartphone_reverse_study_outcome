<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/title_update_header"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:paddingHorizontal="20dp">
    <TextView
        android:textColor="@color/oui_text_1"
        android:id="@+id/update_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_toLeftOf="@+id/update_all_layout"
        android:layout_centerVertical="true"
        style="@style/Title_Title_L_Alt"/>
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/update_all_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true">
        <TextView
            android:textColor="@color/oui_blue_fg"
            android:gravity="center"
            android:id="@+id/update_all_btn"
            android:background="@drawable/oui_search_chips_background"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/update_all"
            android:layout_centerVertical="true"
            android:backgroundTint="@color/oui_b_blue_bg_light"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            style="@style/BtnLabel_M1"/>
        <View
            android:id="@+id/update_all_tips"
            android:background="@drawable/oui_search_chips_background"
            android:visibility="gone"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_alignTop="@+id/update_all_btn"
            android:layout_alignRight="@+id/update_all_btn"
            android:backgroundTint="@color/oui_red_7"/>
    </RelativeLayout>
</RelativeLayout>
