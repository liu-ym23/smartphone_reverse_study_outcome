<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/tv_item_horizontal_width"
    android:layout_height="@dimen/tv_item_horizontal_height">
    <CheckBox
        android:id="@+id/cb_check"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:button="@drawable/checkbox"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tv_app_rank"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#66000000"
        android:gravity="center"
        android:id="@+id/tv_app_rank"
        android:background="@drawable/circle_num"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/cb_check"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="@dimen/tv_app_icon_size"
        android:layout_height="@dimen/tv_app_icon_size"
        android:layout_marginLeft="@dimen/dp_12"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/tv_app_rank"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginLeft="0dp"/>
    <TextView
        android:textSize="@dimen/tv_app_item_name_size"
        android:textStyle="bold"
        android:textColor="@color/tv_app_item_name_color"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_name"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/tv_app_item_horizontal_name_padding_icon"
        android:layout_marginRight="@dimen/tv_app_item_horizontal_name_padding_icon"
        android:maxLines="1"
        android:maxEms="10"
        app:layout_constraintBottom_toTopOf="@+id/tv_category"
        app:layout_constraintLeft_toRightOf="@+id/iv_icon"
        app:layout_constraintRight_toLeftOf="@+id/app_status_view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="@dimen/tv_app_item_horizontal_category_size"
        android:textColor="@color/tv_app_item_category_color"
        android:gravity="start"
        android:id="@+id/tv_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/tv_brief"
        app:layout_constraintLeft_toLeftOf="@+id/tv_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"/>
    <TextView
        android:textSize="@dimen/tv_app_item_horizontal_brief_size"
        android:textColor="@color/tv_app_item_brief_color"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tv_brief"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/tv_app_item_horizontal_name_padding_icon"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/tv_name"
        app:layout_constraintRight_toLeftOf="@+id/app_status_view"
        app:layout_constraintTop_toBottomOf="@+id/tv_category"/>
    <TextView
        android:textSize="@dimen/tv_app_item_horizontal_category_size"
        android:textColor="@color/app_item_source_color"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/app_source"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/tv_app_item_horizontal_name_padding_icon"
        android:text="@string/other_source_item_desc"
        android:maxLines="1"
        android:drawableLeft="@drawable/list_yyb"
        android:drawablePadding="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/tv_name"
        app:layout_constraintRight_toLeftOf="@+id/app_status_view"
        app:layout_constraintTop_toBottomOf="@+id/tv_category"/>
    <ImageView
        android:id="@+id/iv_rate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_1"
        android:src="@drawable/rate_none"
        app:layout_constraintLeft_toLeftOf="@+id/tv_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_category"/>
    <TextView
        android:textSize="8sp"
        android:gravity="center"
        android:id="@+id/tv_label_0"
        android:background="@drawable/tag_first_bg"
        android:focusable="false"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="@+id/tv_category"
        app:layout_constraintLeft_toRightOf="@+id/tv_category"
        app:layout_constraintTop_toTopOf="@+id/tv_category"/>
    <TextView
        android:textSize="8sp"
        android:gravity="center"
        android:id="@+id/tv_label_1"
        android:background="@drawable/tag_ads_bg"
        android:focusable="false"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="@+id/tv_category"
        app:layout_constraintLeft_toRightOf="@+id/tv_label_0"
        app:layout_constraintTop_toTopOf="@+id/tv_category"/>
    <com.bytedanceos.common.ui.widget.AppStatusView
        android:id="@+id/app_status_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/tv_bottom_space"
        android:background="@drawable/line"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
