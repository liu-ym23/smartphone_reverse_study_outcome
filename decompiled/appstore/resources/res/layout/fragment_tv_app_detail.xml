<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/layout_app_detail_header"
        layout="@layout/tv_item_app_detail_header"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.bytedanceos.appstore.buss.widget.recyclerview.CommonRecyclerView
                android:id="@+id/recycler_view_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_marginEnd="@dimen/dp_12"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/fg_app_detail_line_view1"
                android:background="#14000000"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_1"
                android:layout_marginTop="@dimen/dp_24"
                android:layout_marginStart="@dimen/dp_24"
                android:layout_marginEnd="@dimen/dp_24"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/recycler_view_image"/>
            <TextView
                android:textSize="@dimen/textSize12"
                android:textColor="#66000000"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_desc"
                android:layout_width="@dimen/tv_app_item_horizontal_width"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:maxLines="2"
                android:singleLine="false"
                android:drawableRight="@drawable/item_arrow"
                android:drawablePadding="@dimen/dp_18"
                android:lineSpacingExtra="@dimen/dp_2"
                android:paddingStart="@dimen/tv_app_item_padding_left"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/fg_app_detail_line_view1"/>
            <View
                android:id="@+id/fg_app_detail_line_view3"
                android:background="#14000000"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_1"
                android:layout_marginTop="@dimen/dp_15"
                app:layout_constraintLeft_toLeftOf="@+id/fg_app_detail_line_view1"
                app:layout_constraintRight_toRightOf="@+id/fg_app_detail_line_view1"
                app:layout_constraintTop_toBottomOf="@+id/tv_desc"/>
            <com.bytedanceos.appstore.buss.widget.AppGradeView
                android:id="@+id/grade_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/fg_app_detail_line_view3"/>
            <View
                android:id="@+id/fg_app_detail_line_view4"
                android:background="#14000000"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_1"
                app:layout_constraintLeft_toLeftOf="@+id/fg_app_detail_line_view1"
                app:layout_constraintRight_toRightOf="@+id/fg_app_detail_line_view1"
                app:layout_constraintTop_toBottomOf="@+id/grade_view"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_comment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="grade_view,fg_app_detail_line_view4"/>
            <com.bytedanceos.appstore.buss.widget.recyclerview.CommonRecyclerView
                android:id="@+id/recycler_view_gift"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/fg_app_detail_line_view4"/>
            <com.bytedanceos.appstore.buss.widget.recyclerview.CommonRecyclerView
                android:id="@+id/recycler_view_recommend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/recycler_view_gift"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
