<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.bytedanceos.appstore.buss.widget.app.item.ItemHorizontalView
        android:id="@+id/tv_now_app"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/tv_item_le_ri"/>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tv_brief_hint"
                android:text="@string/summary"
                android:layout_marginStart="@dimen/dp_24"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/tv_app_brief_tv_title_hint"/>
            <TextView
                android:textSize="@dimen/textSize12"
                android:textStyle="bold"
                android:textColor="#66000000"
                android:id="@+id/tv_feedback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/dp_24"
                android:text="@string/feedback"
                android:drawableRight="@drawable/item_arrow"
                android:drawablePadding="@dimen/dp_12"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_brief_hint"/>
            <View
                android:id="@+id/line_view2"
                android:background="#1a000000"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_1"
                android:layout_marginTop="@dimen/dp_8"
                android:layout_marginEnd="@dimen/dp_24"
                app:layout_constraintLeft_toLeftOf="@+id/tv_brief_hint"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_brief_hint"/>
            <TextView
                android:textSize="@dimen/textSize12"
                android:textColor="#66000000"
                android:id="@+id/tv_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                android:maxEms="30"
                android:lineSpacingExtra="@dimen/dp_10"
                app:layout_constraintLeft_toLeftOf="@+id/tv_brief_hint"
                app:layout_constraintTop_toBottomOf="@+id/line_view2"/>
            <View
                android:id="@+id/line_view3"
                android:background="#1a000000"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_1"
                android:layout_marginTop="@dimen/dp_8"
                app:layout_constraintLeft_toLeftOf="@+id/tv_brief_hint"
                app:layout_constraintRight_toRightOf="@+id/line_view2"
                app:layout_constraintTop_toBottomOf="@+id/tv_desc"/>
            <TextView
                android:id="@+id/tv_update_hint"
                android:text="@string/features"
                app:layout_constraintLeft_toLeftOf="@+id/tv_brief_hint"
                app:layout_constraintTop_toBottomOf="@+id/line_view3"
                style="@style/tv_app_brief_tv_title_hint"/>
            <View
                android:id="@+id/line_view4"
                android:background="#1a000000"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_1"
                android:layout_marginTop="@dimen/dp_8"
                app:layout_constraintLeft_toLeftOf="@+id/tv_brief_hint"
                app:layout_constraintRight_toRightOf="@+id/line_view2"
                app:layout_constraintTop_toBottomOf="@+id/tv_update_hint"/>
            <TextView
                android:textSize="@dimen/textSize12"
                android:textColor="#66000000"
                android:id="@+id/tv_update"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                android:lineSpacingExtra="@dimen/dp_10"
                app:layout_constraintLeft_toLeftOf="@+id/tv_brief_hint"
                app:layout_constraintTop_toBottomOf="@+id/line_view4"/>
            <View
                android:id="@+id/line_view5"
                android:background="#1a000000"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_1"
                android:layout_marginTop="@dimen/dp_8"
                app:layout_constraintLeft_toLeftOf="@+id/tv_brief_hint"
                app:layout_constraintRight_toRightOf="@+id/line_view2"
                app:layout_constraintTop_toBottomOf="@+id/tv_update"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_feature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tv_update_hint,line_view4,tv_update,line_view5"/>
            <TextView
                android:id="@+id/tv_app_info_hint"
                android:text="@string/info"
                app:layout_constraintLeft_toLeftOf="@+id/tv_brief_hint"
                app:layout_constraintTop_toBottomOf="@+id/line_view5"
                style="@style/tv_app_brief_tv_title_hint"/>
            <View
                android:id="@+id/line_view6"
                android:background="#1a000000"
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_1"
                android:layout_marginTop="@dimen/dp_8"
                android:layout_marginBottom="@dimen/dp_24"
                app:layout_constraintLeft_toLeftOf="@+id/tv_brief_hint"
                app:layout_constraintRight_toRightOf="@+id/line_view2"
                app:layout_constraintTop_toBottomOf="@+id/tv_app_info_hint"/>
            <TextView
                android:id="@+id/tv_alias_hint"
                android:visibility="gone"
                android:text="@string/info_aliasname"
                app:layout_constraintLeft_toLeftOf="@+id/tv_brief_hint"
                app:layout_constraintTop_toBottomOf="@+id/line_view6"
                style="@style/tv_app_brief_tv_app_info_hint"/>
            <TextView
                android:id="@+id/tv_alias"
                app:layout_constraintLeft_toRightOf="@+id/tv_alias_hint"
                app:layout_constraintTop_toTopOf="@+id/tv_alias_hint"
                style="@style/tv_app_brief_tv_app_info"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_alias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tv_alias_hint,tv_alias"/>
            <TextView
                android:id="@+id/tv_type_hint"
                android:text="@string/info_category"
                app:layout_constraintLeft_toLeftOf="@+id/tv_brief_hint"
                app:layout_constraintTop_toBottomOf="@+id/tv_alias_hint"
                style="@style/tv_app_brief_tv_app_info_hint"/>
            <TextView
                android:id="@+id/tv_type"
                app:layout_constraintLeft_toRightOf="@+id/tv_type_hint"
                app:layout_constraintTop_toTopOf="@+id/tv_type_hint"
                style="@style/tv_app_brief_tv_app_info"/>
            <TextView
                android:id="@+id/tv_app_update_hint"
                android:text="@string/info_update"
                app:layout_constraintLeft_toLeftOf="@+id/tv_brief_hint"
                app:layout_constraintTop_toBottomOf="@+id/tv_type_hint"
                style="@style/tv_app_brief_tv_app_info_hint"/>
            <TextView
                android:id="@+id/tv_app_update"
                app:layout_constraintLeft_toRightOf="@+id/tv_app_update_hint"
                app:layout_constraintTop_toTopOf="@+id/tv_app_update_hint"
                style="@style/tv_app_brief_tv_app_info"/>
            <TextView
                android:id="@+id/tv_version_hint"
                android:text="@string/info_version"
                app:layout_constraintLeft_toLeftOf="@+id/tv_brief_hint"
                app:layout_constraintTop_toBottomOf="@+id/tv_app_update_hint"
                style="@style/tv_app_brief_tv_app_info_hint"/>
            <TextView
                android:id="@+id/tv_version"
                app:layout_constraintLeft_toRightOf="@+id/tv_version_hint"
                app:layout_constraintTop_toTopOf="@+id/tv_version_hint"
                style="@style/tv_app_brief_tv_app_info"/>
            <TextView
                android:id="@+id/tv_developers_hint"
                android:text="@string/info_developers"
                app:layout_constraintLeft_toLeftOf="@+id/tv_brief_hint"
                app:layout_constraintTop_toBottomOf="@+id/tv_version_hint"
                style="@style/tv_app_brief_tv_app_info_hint"/>
            <TextView
                android:id="@+id/tv_developer"
                app:layout_constraintLeft_toRightOf="@+id/tv_developers_hint"
                app:layout_constraintTop_toTopOf="@+id/tv_developers_hint"
                style="@style/tv_app_brief_tv_app_info"/>
            <TextView
                android:id="@+id/tv_system_hint"
                android:text="@string/info_compatibility"
                app:layout_constraintLeft_toLeftOf="@+id/tv_brief_hint"
                app:layout_constraintTop_toBottomOf="@+id/tv_developers_hint"
                style="@style/tv_app_brief_tv_app_info_hint"/>
            <TextView
                android:id="@+id/tv_system"
                app:layout_constraintLeft_toRightOf="@+id/tv_system_hint"
                app:layout_constraintTop_toTopOf="@+id/tv_system_hint"
                style="@style/tv_app_brief_tv_app_info"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_system"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tv_system_hint,tv_system"/>
            <TextView
                android:id="@+id/tv_source_hint"
                android:text="@string/info_from"
                app:layout_constraintLeft_toLeftOf="@+id/tv_brief_hint"
                app:layout_constraintTop_toBottomOf="@+id/tv_system_hint"
                style="@style/tv_app_brief_tv_app_info_hint"/>
            <ImageView
                android:id="@+id/iv_from_logo"
                android:paddingTop="@dimen/dp_9"
                android:visibility="gone"
                android:layout_width="@dimen/dp_13"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/tv_source"
                app:layout_constraintLeft_toRightOf="@+id/tv_source_hint"
                app:layout_constraintTop_toTopOf="@+id/tv_source"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tv_source"
                android:layout_marginLeft="@dimen/dp_4"
                android:drawablePadding="2dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_source_hint"
                app:layout_constraintLeft_toRightOf="@+id/iv_from_logo"
                app:layout_constraintTop_toTopOf="@+id/tv_source_hint"
                app:layout_goneMarginLeft="0dp"
                style="@style/tv_app_brief_tv_app_info"/>
            <TextView
                android:id="@+id/appinfo_special_support"
                android:text="@string/special_support"
                android:layout_below="@+id/appinfo_fromLabel"
                android:layout_alignLeft="@+id/textView3"
                app:layout_constraintStart_toStartOf="@+id/tv_brief_hint"
                app:layout_constraintTop_toBottomOf="@+id/tv_source_hint"
                style="@style/tv_app_brief_tv_app_info_hint"/>
            <TextView
                android:id="@+id/drag_one_step"
                android:text="@string/onestep_drag"
                app:layout_constraintBottom_toBottomOf="@+id/appinfo_special_support"
                app:layout_constraintStart_toEndOf="@+id/appinfo_special_support"
                app:layout_constraintTop_toTopOf="@+id/appinfo_special_support"
                style="@style/tv_app_brief_tv_app_info"/>
            <TextView
                android:id="@+id/find_more"
                android:text="@string/find_more"
                android:layout_toRightOf="@+id/drag_one_step"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@+id/drag_one_step"
                app:layout_constraintBottom_toBottomOf="@+id/drag_one_step"
                app:layout_constraintStart_toEndOf="@+id/drag_one_step"
                app:layout_constraintTop_toTopOf="@+id/drag_one_step"
                style="@style/tv_app_brief_tv_app_info"/>
            <TextView
                android:id="@+id/tv_permission_hint"
                android:text="@string/permission_detail"
                app:layout_constraintLeft_toLeftOf="@+id/tv_brief_hint"
                app:layout_constraintTop_toBottomOf="@+id/appinfo_special_support"
                style="@style/tv_app_brief_tv_app_info_hint"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tv_permission"
                android:visibility="visible"
                android:text="@string/view_all_permissions"
                android:drawablePadding="2dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_permission_hint"
                app:layout_constraintLeft_toRightOf="@+id/tv_permission_hint"
                app:layout_constraintTop_toTopOf="@+id/tv_permission_hint"
                style="@style/tv_app_brief_tv_app_info"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_permission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tv_permission_hint,tv_permission"/>
            <View
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_20"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_permission_hint"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</LinearLayout>
