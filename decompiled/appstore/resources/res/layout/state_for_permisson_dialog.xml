<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/state_rl"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/state_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <com.obric.oui.progress.ODownloadProgressView
            android:id="@+id/loading_progressbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:oui_progress_view_size="medium"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/state_retry"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <TextView
            android:id="@+id/nodata_alert"
            android:layout_marginTop="0dp"
            style="@style/empty_alert_style"/>
        <TextView
            android:id="@+id/retry_connection"
            android:layout_marginTop="5dp"
            android:layout_below="@+id/nodata_alert"
            style="@style/retry_connection_style"/>
        <TextView
            android:id="@+id/refresh_btn"
            android:layout_marginTop="23dp"
            android:text="@string/refresh"
            android:layout_below="@+id/retry_connection"
            style="@style/refresh_btn_style"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/state_empty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/empty_logo"
            android:layout_marginTop="0dp"
            android:contentDescription="@null"
            style="@style/empty_logo_style"/>
        <TextView
            android:id="@+id/empty_message"
            android:layout_below="@+id/empty_logo"
            style="@style/empty_message_style"/>
        <TextView
            android:id="@+id/empty_description"
            android:layout_below="@+id/empty_message"
            style="@style/empty_description_style"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/state_login"
        android:background="@color/grey"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/app_logo"
            android:visibility="gone"
            android:contentDescription="@null"
            style="@style/myapp_list_app_logo_style"/>
        <TextView
            android:id="@+id/login_alert"
            android:layout_below="@+id/app_logo"
            style="@style/myapp_list_login_alert_style"/>
        <TextView
            android:id="@+id/login_btn"
            android:layout_below="@+id/login_alert"
            style="@style/myapp_list_login_btn_style"/>
    </RelativeLayout>
</RelativeLayout>
