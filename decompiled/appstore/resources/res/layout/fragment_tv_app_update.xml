<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="never">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.bytedanceos.appstore.buss.widget.AppItemTitleView
            android:id="@+id/title_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/textSize14"
            android:textStyle="bold"
            android:textColor="@color/color_6"
            android:gravity="center_vertical"
            android:id="@+id/tv_disk"
            android:paddingLeft="@dimen/tv_app_item_padding_left"
            android:visibility="gone"
            android:layout_width="@dimen/tv_app_item_horizontal_width"
            android:layout_height="@dimen/dp_79"
            android:text="磁盘空间已满"/>
        <include layout="@layout/tv_item_app_update_empty"/>
        <include layout="@layout/tv_item_app_update_update"/>
        <com.bytedanceos.appstore.buss.widget.recyclerview.CommonRecyclerView
            android:id="@+id/recycler_view_update"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <include layout="@layout/tv_item_app_update_ignore"/>
        <com.bytedanceos.appstore.buss.widget.recyclerview.CommonRecyclerView
            android:id="@+id/recycler_view_recommend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
