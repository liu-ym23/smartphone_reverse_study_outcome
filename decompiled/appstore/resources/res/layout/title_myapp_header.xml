<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true"
    android:duplicateParentState="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.oui.layout.OUIRelativeLayout
        android:id="@+id/history_layout_enter"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="8dp"
        app:oui_radius="@dimen/oui_r_l3_rect">
        <ImageView
            android:id="@+id/show_history_icon"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="18dp"
            android:src="@drawable/oui_icon_people_circle"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true"
            android:contentDescription="@null"/>
        <TextView
            android:textColor="@color/oui_text_1"
            android:id="@+id/show_install_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/show_history_icon"
            android:layout_centerVertical="true"
            style="@style/BtnLabel_M2"/>
        <TextView
            android:id="@+id/history_numbers"
            android:layout_toRightOf="@+id/show_install_history"
            style="@style/myapp_count_style"/>
        <ImageView
            android:id="@+id/history_bottom_arrow"
            android:padding="4dp"
            android:layout_width="18dp"
            android:layout_height="28dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/oui_icon_right_arrow"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <com.obric.oui.divider.ODivider
            android:layout_width="match_parent"
            android:layout_height="0.66dp"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="12dp"/>
    </com.obric.oui.layout.OUIRelativeLayout>
    <com.obric.oui.layout.OUIRelativeLayout
        android:id="@+id/game_reservation_layout_enter"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="10dp"
        android:layout_marginHorizontal="8dp"
        app:oui_radius="@dimen/oui_r_l3_rect">
        <ImageView
            android:id="@+id/game_reservation_icon"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="18dp"
            android:src="@drawable/oui_icon_time_0_7"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true"
            android:contentDescription="@null"/>
        <TextView
            android:textColor="@color/oui_text_1"
            android:id="@+id/show_reserved_games"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reserved_games"
            android:layout_toRightOf="@+id/game_reservation_icon"
            android:layout_centerVertical="true"
            style="@style/BtnLabel_M2"/>
        <TextView
            android:id="@+id/game_reservation_numbers"
            android:layout_toRightOf="@+id/show_reserved_games"
            style="@style/myapp_count_style"/>
        <ImageView
            android:id="@+id/game_reservation_bottom_arrow"
            android:padding="4dp"
            android:layout_width="18dp"
            android:layout_height="28dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/oui_icon_right_arrow"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <com.obric.oui.divider.ODivider
            android:layout_width="match_parent"
            android:layout_height="0.66dp"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="12dp"/>
    </com.obric.oui.layout.OUIRelativeLayout>
</LinearLayout>
