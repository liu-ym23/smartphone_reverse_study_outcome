<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:clipChildren="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/dp_20"
    app:cardPreventCornerOverlap="true"
    app:cardUseCompatPadding="true">
    <TextView
        android:textSize="@dimen/textSize20"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/tv_dialog_title"
        android:background="@drawable/tv_dialog_shape_round_top"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:text="评价"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <RatingBar
            android:id="@+id/rb_dialog_rate"
            android:clickable="false"
            android:layout_marginLeft="@dimen/dp_18"
            android:layout_marginTop="@dimen/dp_18"
            android:progressDrawable="@drawable/rating_bar_style"
            android:minHeight="@dimen/dp_32"
            android:rating="0"
            android:stepSize="1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/dialog_comment_rate_style"/>
        <TextView
            android:textSize="@dimen/textSize10"
            android:textColor="#cccccc"
            android:gravity="center_horizontal"
            android:id="@+id/tv_dialog_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_comment_desc"
            app:layout_constraintBottom_toBottomOf="@+id/rb_dialog_rate"
            app:layout_constraintLeft_toRightOf="@+id/rb_dialog_rate"
            app:layout_constraintTop_toTopOf="@+id/rb_dialog_rate"/>
        <EditText
            android:textColorHint="@color/tv_app_comment_edit_hint_color"
            android:gravity="start"
            android:id="@+id/et_dialog_comment"
            android:background="#08000000"
            android:paddingLeft="@dimen/dp_12"
            android:paddingTop="@dimen/dp_10"
            android:paddingRight="@dimen/dp_12"
            android:paddingBottom="@dimen/dp_10"
            android:layout_width="480dp"
            android:layout_height="123dp"
            android:layout_marginLeft="@dimen/dp_18"
            android:layout_marginTop="@dimen/dp_18"
            android:layout_marginRight="@dimen/dp_18"
            android:layout_marginBottom="@dimen/dp_14"
            android:hint="@string/add_comment_context"
            android:maxLength="800"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rb_dialog_rate"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48">
        <TextView
            android:textColor="#99000000"
            android:gravity="center"
            android:id="@+id/tv_dialog_cancel"
            android:background="@drawable/tv_dialog_shape_round_bottom_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/cancel"
            android:layout_weight="1"/>
        <TextView
            android:textColor="#3965cc"
            android:gravity="center"
            android:id="@+id/tv_dialog_confirm"
            android:background="@drawable/tv_dialog_shape_round_bottom_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="确认"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
