<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/status_bar_latest_event_content"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <FrameLayout
        android:layout_width="@dimen/notification_large_icon_width"
        android:layout_height="@dimen/notification_large_icon_height">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/icon"
            android:layout_width="@dimen/notification_large_icon_inner_width"
            android:layout_height="@dimen/notification_large_icon_inner_height"
            android:src="@drawable/stat_sys_download_done"
            android:scaleType="fitCenter"
            android:contentDescription="@null"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="fill_vertical"
        android:orientation="vertical"
        android:paddingLeft="8dp"
        android:paddingTop="2dp"
        android:paddingRight="7dp"
        android:paddingBottom="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/notification_large_icon_width"
        android:minHeight="@dimen/notification_large_icon_height"
        android:paddingStart="8dp"
        android:paddingEnd="7dp"
        android:layout_marginStart="@dimen/notification_large_icon_width">
        <TextView
            android:textAppearance="@style/NotificationTitle_White"
            android:textSize="@dimen/notification_template_base_title_text_size"
            android:textColor="@color/notification_line1_for_white"
            android:ellipsize="marquee"
            android:gravity="center_vertical"
            android:id="@+id/title"
            android:fadingEdge="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <ViewStub
            android:id="@+id/subtitle"
            android:layout="@layout/notification_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ViewStub
            android:id="@+id/subpiclayout"
            android:layout="@layout/notification_subpic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</FrameLayout>
