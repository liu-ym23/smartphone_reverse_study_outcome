<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/splash_ad_skip_size"
        android:textColor="@color/splash_ad_skip_text"
        android:gravity="center"
        android:id="@+id/tv_skip"
        android:background="@drawable/bg_splash_skip"
        android:visibility="gone"
        android:layout_width="@dimen/splash_ad_skip_width"
        android:layout_height="@dimen/splash_ad_skip_height"
        android:layout_marginTop="@dimen/splash_ad_skip_margin_top"
        android:layout_marginRight="@dimen/splash_ad_skip_margin_right"
        android:includeFontPadding="false"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:elevation="2dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.github.chrisbanes.photoview.PhotoView
        android:id="@+id/iv_bg"
        android:background="@drawable/tv_splash_default_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp_24"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toTopOf="@+id/iv_logo"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="@dimen/dp_60"
        android:layout_height="@dimen/dp_60"
        android:layout_marginBottom="@dimen/dp_24"
        android:src="@drawable/icon_store_launcher"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tv_title"/>
    <TextView
        android:textSize="@dimen/textSize18"
        android:textStyle="bold"
        android:textColor="@color/splash_ad_logo_title"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_24"
        android:text="@string/splash_ad_title"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toTopOf="@+id/tv_desc"
        app:layout_constraintLeft_toRightOf="@+id/iv_logo"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_logo"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="12.5sp"
        android:textColor="@color/splash_ad_logo_desc"
        android:id="@+id/tv_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:text="@string/splash_ad_desc"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="@+id/iv_logo"
        app:layout_constraintLeft_toLeftOf="@+id/tv_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
