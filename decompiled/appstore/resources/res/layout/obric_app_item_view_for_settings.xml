<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_list_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.oui.layout.OUIFrameLayout
        android:id="@+id/appIconBox"
        android:duplicateParentState="false"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/oui_default_app_icon"
        android:scaleType="centerCrop"
        android:layout_marginStart="10dp"
        android:layout_marginVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.obric.oui.image.OImageAppIcon
            android:id="@+id/appIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/oui_default_app_icon"
            android:scaleType="centerCrop"/>
    </com.obric.oui.layout.OUIFrameLayout>
    <TextView
        android:textColor="@color/oui_basic_text_1"
        android:ellipsize="end"
        android:id="@+id/appName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/appStatusLay"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/appIconBox"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Title_1_Regular"/>
    <com.obric.appstore.common.core.ui.view.ObricAppStatusView
        android:id="@+id/appStatusLay"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:maxWidth="120dp"
        android:minWidth="64dp"
        android:minHeight="32dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
