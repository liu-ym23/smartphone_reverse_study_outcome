<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#ffffff"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/phone_back_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_ui_dp_16"
        android:layout_marginTop="@dimen/common_ui_dp_16"
        android:layout_marginBottom="@dimen/common_ui_dp_16"
        android:src="@drawable/account_ic_back_left"/>
    <TextView
        android:textSize="@dimen/common_ui_dp_24"
        android:textStyle="bold"
        android:textColor="#040a1a"
        android:layout_gravity="center_horizontal"
        android:id="@+id/phone_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/common_ui_dp_21"
        android:text="@string/account_ask_for_number_title"/>
    <TextView
        android:textSize="@dimen/common_ui_dp_16"
        android:textColor="#6d717a"
        android:layout_gravity="center_horizontal"
        android:id="@+id/phone_sub_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/common_ui_dp_8"
        android:text="@string/account_ask_for_number_subtitle"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/phone_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/common_ui_dp_40"
            android:layout_marginTop="@dimen/common_ui_dp_27"
            android:layout_marginRight="@dimen/common_ui_dp_30"
            android:paddingEnd="@dimen/common_ui_dp_12">
            <LinearLayout
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/click_country_picker"
                android:background="@drawable/account_bg_country_picker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/common_ui_dp_9"
                android:paddingVertical="@dimen/common_ui_dp_10">
                <TextView
                    android:textSize="@dimen/common_ui_dp_16"
                    android:textColor="#3a3a3c"
                    android:id="@+id/country_code_picker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+86"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/common_ui_dp_2"
                    android:src="@drawable/account_ic_arrow_down"/>
            </LinearLayout>
            <EditText
                android:textSize="@dimen/common_ui_dp_16"
                android:textColorHighlight="#3a3a3c"
                android:textColorHint="#cccccc"
                android:layout_gravity="center_vertical"
                android:id="@+id/phone_number"
                android:background="@drawable/account_bg_phone_edit"
                android:paddingLeft="@dimen/common_ui_dp_9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/common_ui_dp_8"
                android:hint="@string/account_phone_number_placeholder"
                android:maxLines="1"
                android:inputType="number"
                android:textCursorDrawable="@drawable/account_cursor_shape"
                android:autofillHints="phone"/>
        </LinearLayout>
    </FrameLayout>
    <Button
        android:textSize="@dimen/common_ui_dp_16"
        android:textColor="@color/common_ui_white"
        android:id="@+id/bt_next"
        android:background="@drawable/account_bg_bt_next_selector"
        android:layout_width="match_parent"
        android:layout_height="@dimen/common_ui_dp_40"
        android:layout_marginLeft="@dimen/common_ui_dp_30"
        android:layout_marginTop="@dimen/common_ui_dp_90"
        android:layout_marginRight="@dimen/common_ui_dp_30"
        android:text="@string/account_send_code"
        android:textAllCaps="false"
        android:stateListAnimator="@null"/>
</LinearLayout>
