<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#ffffff"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/country_pick_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/common_ui_dp_16"
        android:src="@drawable/account_ic_close"
        android:layout_marginStart="@dimen/common_ui_dp_16"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/common_ui_dp_17"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/country_pick_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/account_phone_select_country_region"
        app:layout_constraintBottom_toBottomOf="@+id/country_pick_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/country_pick_close"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_country_code_list"
        android:background="@drawable/account_bg_country_code"
        android:layout_width="match_parent"
        android:layout_height="@dimen/common_ui_dp_0"
        android:layout_marginTop="@dimen/common_ui_dp_12"
        android:layout_marginStart="@dimen/common_ui_dp_16"
        android:layout_marginEnd="@dimen/common_ui_dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/country_pick_close"/>
    <com.obric.matrix.account.ui.SideIndexBar
        android:id="@+id/slide_index_bar"
        android:layout_width="@dimen/common_ui_dp_30"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/common_ui_dp_169"
        android:layout_marginBottom="@dimen/common_ui_dp_169"
        app:layout_constraintBottom_toBottomOf="@+id/rv_country_code_list"
        app:layout_constraintLeft_toRightOf="@+id/rv_country_code_list"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/rv_country_code_list"/>
    <com.obric.matrix.account.ui.CenterTextView
        android:id="@+id/center_text_view"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
