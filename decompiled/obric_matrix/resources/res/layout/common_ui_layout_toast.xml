<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:background="@drawable/common_ui_toast_background"
        android:paddingLeft="@dimen/common_ui_dp_20"
        android:paddingRight="@dimen/common_ui_dp_20"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_ui_dp_16"
        android:layout_marginTop="@dimen/common_ui_dp_72"
        android:layout_marginRight="@dimen/common_ui_dp_16"
        android:layout_marginBottom="@dimen/common_ui_dp_16"
        android:elevation="@dimen/common_ui_dp_5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="@dimen/common_ui_dp_24"
            android:layout_height="@dimen/common_ui_dp_24"
            android:layout_marginTop="@dimen/common_ui_dp_15"
            android:layout_marginRight="@dimen/common_ui_dp_8"
            android:layout_marginBottom="@dimen/common_ui_dp_15"/>
        <TextView
            android:textSize="@dimen/common_ui_sp_17"
            android:textStyle="normal"
            android:textColor="@color/common_ui_black"
            android:gravity="center"
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/common_ui_dp_17"
            android:layout_marginBottom="@dimen/common_ui_dp_17"
            android:textFontWeight="500"/>
    </LinearLayout>
</merge>
