<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/google_login_loading_bar"
        android:background="@drawable/account_bg_account_loading"
        android:visibility="visible"
        android:layout_width="@dimen/common_ui_dp_80"
        android:layout_height="@dimen/common_ui_dp_80"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/loading_page"
            android:layout_width="@dimen/common_ui_dp_30"
            android:layout_height="@dimen/common_ui_dp_30"
            android:indeterminateTint="@color/common_ui_black"
            style=""/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
