<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#ffffff"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/back_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_ui_dp_16"
        android:layout_marginTop="@dimen/common_ui_dp_16"
        android:layout_marginBottom="@dimen/common_ui_dp_16"
        android:src="@drawable/account_ic_back_left"/>
    <TextView
        android:textSize="@dimen/common_ui_dp_24"
        android:textStyle="bold"
        android:textColor="#040a1a"
        android:layout_gravity="center_horizontal"
        android:id="@+id/account_login_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/common_ui_dp_21"
        android:text="@string/account_login_title"/>
    <TextView
        android:textSize="@dimen/common_ui_dp_16"
        android:textColor="#6d717a"
        android:layout_gravity="center_horizontal"
        android:id="@+id/account_login_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/common_ui_dp_8"
        android:text="@string/account_login_subtitle"/>
    <TextView
        android:textSize="@dimen/common_ui_dp_16"
        android:textColor="#2761f2"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/account_larksso_loading"
        android:background="@drawable/account_bg_larksso_loading"
        android:layout_width="@dimen/common_ui_dp_220"
        android:layout_height="@dimen/common_ui_dp_40"
        android:layout_marginTop="@dimen/common_ui_dp_198"
        android:text="@string/account_larksso_loading"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <Space
            android:id="@+id/left_space"
            android:layout_width="@dimen/common_ui_dp_63"
            android:layout_height="@dimen/common_ui_dp_20"
            android:layout_marginBottom="@dimen/common_ui_dp_23_5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"/>
        <Space
            android:id="@+id/right_space"
            android:layout_width="@dimen/common_ui_dp_64"
            android:layout_height="@dimen/common_ui_dp_20"
            android:layout_marginBottom="@dimen/common_ui_dp_23"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/select_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/right_space"
            app:layout_constraintLeft_toRightOf="@+id/left_space"
            app:layout_constraintRight_toLeftOf="@+id/right_space">
            <CheckBox
                android:layout_gravity="center"
                android:id="@+id/select_privacy_circle_view"
                android:background="@android:color/transparent"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:button="@drawable/account_select_circle_view"
                android:layout_marginEnd="@dimen/common_ui_dp_4"/>
            <com.obric.matrix.common_ui.widget.UrlSpanTextView
                android:textSize="@dimen/common_ui_dp_12"
                android:textColor="#000000"
                android:gravity="center_horizontal"
                android:layout_gravity="center"
                android:id="@+id/privacy_policy_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_privacy_select"
                android:maxLines="1"
                android:includeFontPadding="false"
                app:common_ui_linkColor="@color/black"
                app:common_ui_linkUnderLine="false"
                app:layout_constraintBottom_toBottomOf="@+id/select_privacy_circle_view"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
