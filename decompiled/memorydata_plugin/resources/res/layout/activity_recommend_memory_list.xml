<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/oui_basic_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OCTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="always"
        app:oui_title_text="@string/recommend_memory_settings_data_title"/>
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_memory"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="3.5dp"
        app:tabIndicatorHeight="0dp"
        app:tabMinWidth="59dp"
        app:tabMode="scrollable"
        app:tabRippleColor="@null"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager_memory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
