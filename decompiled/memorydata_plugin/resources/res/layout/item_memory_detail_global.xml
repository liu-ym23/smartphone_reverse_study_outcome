<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/header_container"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="192dp"
        android:layout_marginBottom="20dp">
        <com.obric.oui.layout.OUIFrameLayout
            android:layout_gravity="center"
            android:id="@+id/shadow_view"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:oui_shadowCornerRadius="20dp">
            <com.obric.oui.layout.OUIFrameLayout
                android:id="@+id/shadow_wrapper"
                android:background="@color/oui_basic_bg_base_2_2_low_elevation"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:oui_radius="20dp">
                <ImageView
                    android:id="@+id/image_source"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"/>
            </com.obric.oui.layout.OUIFrameLayout>
        </com.obric.oui.layout.OUIFrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/tv_source_content_container"
            android:paddingTop="16dp"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="20dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/oui_basic_text_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/memory_card_source_content_title"
                android:lineHeight="21dp"
                android:textFontWeight="500"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/oui_basic_text_3"
                android:id="@+id/tv_source_content"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:lineHeight="21dp"
                android:textFontWeight="400"/>
            <com.obric.memorydata.memory.ui.detail.ChatListView
                android:id="@+id/chat_list_view"
                android:scrollbars="none"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:overScrollMode="never"/>
        </LinearLayout>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/view_overlay"
            android:background="@drawable/fg_detail_card"
            android:layout_width="match_parent"
            android:layout_height="37dp"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/line"
            android:background="@drawable/fg_detail_line"
            android:layout_width="match_parent"
            android:layout_height="0.6dp"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/shadow_cover"
            android:background="@color/oui_basic_bg_base_1"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginBottom="-16dp"/>
        <View
            android:id="@+id/top_overlay"
            android:background="@color/Transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">
        <TextView
            android:textSize="20sp"
            android:textColor="@color/oui_basic_text_1"
            android:id="@+id/title_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:lineHeight="26dp"
            android:textFontWeight="600"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/meta_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="8dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/memory_source_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/oui_text_3"
                android:id="@+id/memory_source_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:lineHeight="18dp"
                android:textFontWeight="400"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/memory_source_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginStart="0dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/oui_text_3"
                android:id="@+id/tv_view_source"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/memory_card_view_original_source"
                android:drawableEnd="@drawable/ic_more_right"
                android:textFontWeight="480"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.obric.memorydata.memory.ui.list.FlowLayout
            android:orientation="horizontal"
            android:id="@+id/capsule_linear_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingHorizontal="8dp"
            app:horizontalSpacing="8dp"
            app:verticalSpacing="8dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/summary_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:paddingHorizontal="8dp">
        <com.obric.oui.text.OTextView
            android:theme="@style/MemoryDetailCardSummaryTip"
            android:textSize="18sp"
            android:textColor="@color/oui_basic_text_1"
            android:id="@+id/summary_text_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/memory_card_memory_summary_title"
            android:lineHeight="23dp"
            android:textFontWeight="600"/>
        <com.larus.business.markdown.impl.markwon.MarkdownTextView
            android:theme="@style/MemoryDetailCardSummaryText"
            android:textColor="@color/oui_basic_text_1"
            android:id="@+id/summary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/failed_container"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_memory_large_model_failed"
                android:layout_marginVertical="1.5dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/oui_basic_text_1"
                android:id="@+id/tv_failed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginStart="4dp"
                android:textFontWeight="500"/>
        </LinearLayout>
        <com.obric.memorydata.memory.ui.list.FlowLayout
            android:orientation="horizontal"
            android:id="@+id/tags_linear_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            app:horizontalSpacing="6dp"
            app:verticalSpacing="6dp"/>
    </LinearLayout>
</LinearLayout>
