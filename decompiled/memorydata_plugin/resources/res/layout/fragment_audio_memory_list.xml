<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/layout_empty"
        android:visibility="visible"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.obric.oui.text.OTextView
            android:textSize="20sp"
            android:textColor="@color/oui_basic_text_3b"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="26sp"
            android:text="@string/smart_memory_no_data_title"
            android:textFontWeight="500"/>
        <com.obric.oui.text.OTextView
            android:textSize="14sp"
            android:textColor="@color/oui_basic_text_3b"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_empty_description"
            android:layout_width="wrap_content"
            android:layout_height="18sp"
            android:layout_marginTop="8dp"
            android:text="@string/smart_memory_no_data_description"
            android:textFontWeight="400"/>
    </LinearLayout>
    <View
        android:id="@+id/list_time_line"
        android:background="@color/widget_memory_time_line_color"
        android:visibility="gone"
        android:layout_width="1.5dp"
        android:layout_height="match_parent"
        android:layout_marginTop="215dp"
        android:layout_marginStart="21dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.obric.oui.orecyclerview.widget.RecyclerView
        android:id="@+id/rv_memory_list"
        android:paddingLeft="16dp"
        android:paddingRight="12dp"
        android:paddingBottom="92dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
