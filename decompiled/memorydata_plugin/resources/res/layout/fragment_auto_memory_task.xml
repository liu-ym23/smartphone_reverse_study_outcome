<?xml version="1.0" encoding="utf-8"?>
<com.obric.memorydata.memory.ui.automemory.AutoMemoryTaskRootLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/guide_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="324dp"
        android:src="@drawable/auto_memory_task_guide_bg"
        android:scaleType="fitXY"
        android:contentDescription="@null"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.obric.oui.viewpager2.widget.ViewPager2
            android:id="@+id/memory_tab_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/guide_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.obric.oui.bouncelayout.ONestedScrollView
                android:id="@+id/guide_scroll"
                android:saveEnabled="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:fillViewport="false"
                android:paddingHorizontal="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/guide_content"
                    android:paddingTop="@dimen/memory_task_guide_content_top_padding"
                    android:paddingBottom="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="720dp">
                    <ImageView
                        android:id="@+id/guide_image"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:src="@drawable/ic_auto_memory_task_guide_header"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"/>
                    <com.obric.oui.text.OTextView
                        android:textColor="@color/oui_basic_text_1"
                        android:gravity="center"
                        android:id="@+id/guide_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/memory_task_guide_title"
                        android:maxLines="2"
                        style="@style/Title_4_Bold"/>
                    <com.obric.oui.text.OTextView
                        android:textSize="14sp"
                        android:textColor="@color/oui_basic_text_3"
                        android:gravity="center"
                        android:id="@+id/guide_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/memory_task_guide_subtitle"
                        android:lineSpacingExtra="2dp"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/guide_feature_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="48dp">
                        <com.obric.oui.lisitem.OCardListItem
                            android:id="@+id/guide_feature_custom"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:ocardlistitem_cardPosition="position_top"
                            app:ocardlistitem_cardType="type_large"
                            app:ocardlistitem_icon="@drawable/ic_auto_memory_task_guide_custom"
                            app:ocardlistitem_showCardBg="true"
                            app:ocardlistitem_showCustomEnd="false"
                            app:ocardlistitem_showDivider="false"
                            app:ocardlistitem_showIcon="true"
                            app:ocardlistitem_showSubTitle="true"
                            app:ocardlistitem_showTailIcon="false"
                            app:ocardlistitem_showTitle="true"/>
                        <com.obric.oui.lisitem.OCardListItem
                            android:id="@+id/guide_feature_auto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:ocardlistitem_cardPosition="position_middle"
                            app:ocardlistitem_cardType="type_large"
                            app:ocardlistitem_icon="@drawable/ic_auto_memory_task_guide_auto"
                            app:ocardlistitem_showCardBg="true"
                            app:ocardlistitem_showCustomEnd="false"
                            app:ocardlistitem_showDivider="false"
                            app:ocardlistitem_showIcon="true"
                            app:ocardlistitem_showSubTitle="true"
                            app:ocardlistitem_showTailIcon="false"
                            app:ocardlistitem_showTitle="true"/>
                        <com.obric.oui.lisitem.OCardListItem
                            android:id="@+id/guide_feature_qa"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:ocardlistitem_cardPosition="position_bottom"
                            app:ocardlistitem_cardType="type_large"
                            app:ocardlistitem_icon="@drawable/ic_auto_memory_task_guide_qa"
                            app:ocardlistitem_showCardBg="true"
                            app:ocardlistitem_showCustomEnd="false"
                            app:ocardlistitem_showDivider="false"
                            app:ocardlistitem_showIcon="true"
                            app:ocardlistitem_showSubTitle="true"
                            app:ocardlistitem_showTailIcon="false"
                            app:ocardlistitem_showTitle="true"/>
                    </LinearLayout>
                    <FrameLayout
                        android:id="@+id/guide_action_bar"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="38dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">
                        <com.obric.oui.button.OButton
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/guide_start_button"
                            android:layout_width="184dp"
                            android:layout_height="48dp"
                            android:text="@string/memory_task_guide_start"
                            android:textAllCaps="false"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            style="@style/OStyleV2.OButton.L.Standard.Primary"/>
                    </FrameLayout>
                </LinearLayout>
            </com.obric.oui.bouncelayout.ONestedScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.obric.oui.blur.OBlurMaskView
        android:id="@+id/task_title_tab_mask"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="142dp"
        app:oBlurMask_blurRadius="72"
        app:oBlurMask_defaultMaskBackground="true"
        app:oBlurMask_statusBarImmersion="false">
        <FrameLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.obric.memorydata.memory.ui.automemory.AutoMemoryTaskTabLayout
                android:id="@+id/task_tab_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="62dp"
                android:layout_marginHorizontal="12dp"
                app:indicator_anim_enable="true"
                app:tabGravity="fill"
                app:tab_textSelectedStyle="@style/AutoMemoryTaskTabTextSelected"
                app:tab_textStyle="@style/AutoMemoryTaskTabTextUnselected"
                style="@style/OTabTextV2.Background.Gray"/>
        </FrameLayout>
    </com.obric.oui.blur.OBlurMaskView>
    <com.obric.oui.button.OFloatingActionButton
        android:layout_gravity="end|bottom"
        android:id="@+id/task_add_button"
        android:visibility="gone"
        android:layout_marginBottom="104dp"
        android:contentDescription="@string/memory_create_memory_collection"
        android:layout_marginEnd="24dp"
        style="@style/AutoMemoryTaskAddButton"/>
    <com.obric.oui.blur.OBlurMaskView
        android:id="@+id/task_title_bar_mask"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oBlurMask_blurRadius="72"
        app:oBlurMask_defaultMaskBackground="true"
        app:oBlurMask_statusBarImmersion="false">
        <com.obric.oui.titlebar.OFloatingTitleBar
            android:id="@+id/title_bar"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:oFloatingTitleBar_enableFloatingTransition="true"
            app:oFloatingTitleBar_statusBarImmersion="false"/>
    </com.obric.oui.blur.OBlurMaskView>
    <FrameLayout
        android:id="@+id/task_loading_overlay"
        android:background="@color/oui_advanced_scrim_sheet"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/task_loading_sheet"
            android:background="@drawable/bg_auto_memory_task_loading_sheet"
            android:paddingTop="32dp"
            android:layout_width="match_parent"
            android:layout_height="163dp"
            android:layout_marginBottom="8dp"
            android:elevation="24dp"
            android:layout_marginHorizontal="8dp">
            <com.obric.oui.progress.ODownloadProgressView
                android:id="@+id/task_loading_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:oui_progress_view_size="large"
                app:oui_progressing_action_color="@color/oui_basic_text_1"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_basic_text_1"
                android:gravity="center"
                android:id="@+id/task_loading_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/memory_task_loading"
                android:maxLines="1"
                style="@style/Title_1_Bold"/>
            <com.obric.oui.text.OTextView
                android:textColor="@color/oui_basic_text_1"
                android:gravity="center"
                android:id="@+id/task_loading_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/memory_task_loading_subtitle"
                android:maxLines="1"
                style="@style/Body_1_Regular"/>
        </LinearLayout>
    </FrameLayout>
</com.obric.memorydata.memory.ui.automemory.AutoMemoryTaskRootLayout>
