<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/oui_basic_bg_base_1"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.oui.layout.OUIFrameLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/view_guide_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:oui_radius="18dp">
        <ImageView
            android:id="@+id/iv_guide_screen_memory"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_guide_screen_memory"/>
    </com.obric.oui.layout.OUIFrameLayout>
    <TextView
        android:textSize="24sp"
        android:textColor="@color/oui_basic_text_1"
        android:id="@+id/view_guide_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/screen_observation_guide_title"
        android:lineHeight="32sp"
        android:textFontWeight="500"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/oui_basic_text_1"
        android:id="@+id/view_guide_desc"
        android:paddingLeft="100px"
        android:paddingRight="100px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/screen_observation_guide_desc"
        android:lineSpacingExtra="4dp"/>
</LinearLayout>
