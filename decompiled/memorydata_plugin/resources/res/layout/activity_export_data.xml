<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/exportScrollView"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="28dp">
                <TextView
                    android:textSize="24sp"
                    android:textColor="@color/oui_basic_text_1"
                    android:gravity="center"
                    android:id="@+id/tv_app_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/data_transport_data_export_activity_title"
                    android:textFontWeight="600"/>
                <com.obric.oui.text.OTextView
                    android:textSize="14sp"
                    android:textColor="@color/oui_basic_text_1"
                    android:gravity="center_horizontal"
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/data_transport_data_export_activity_description"
                    android:lineHeight="21sp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/oui_basic_text_2"
                    android:gravity="center"
                    android:id="@+id/tvProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text=""/>
            </LinearLayout>
            <com.obric.oui.button.OButton
                android:id="@+id/btnExport"
                android:layout_width="match_parent"
                android:layout_marginTop="32dp"
                android:text="@string/data_transport_data_export_start"
                android:layout_marginHorizontal="24dp"
                style="@style/OStyleV2.OButton.L.Standard.Primary"/>
            <com.obric.oui.button.OButton
                android:id="@+id/btnShare"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:text="@string/data_transport_data_export_share_to_lark"
                android:layout_marginHorizontal="24dp"
                style="@style/OStyleV2.OButton.L.Standard.Neutral"/>
            <com.obric.oui.button.OButton
                android:id="@+id/btnImport"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:text="@string/data_transport_data_export_start_import"
                android:layout_marginHorizontal="24dp"
                style="@style/OStyleV2.OButton.L.Standard.Neutral"/>
            <com.obric.oui.button.OButton
                android:id="@+id/btnTestZip"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:text="@string/data_transport_data_export_test_zip"
                android:layout_marginHorizontal="24dp"
                style="@style/OStyleV2.OButton.L.Standard.Neutral"/>
            <com.obric.oui.button.OButton
                android:textColor="@color/oui_functional_red_6"
                android:id="@+id/btnClean"
                android:layout_width="match_parent"
                android:layout_marginTop="32dp"
                android:text="@string/data_transport_data_export_clean_export_files"
                android:layout_marginHorizontal="24dp"
                style="@style/OStyleV2.OButton.L.Standard.Neutral"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/exportStatisticsContainer"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingHorizontal="32dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/oui_basic_text_1"
                    android:id="@+id/tvExportStatisticsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/data_transport_export_statistics_title"
                    android:textFontWeight="600"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/databaseStatisticsSection"
                    android:background="@drawable/bg_export_statistics_card"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/oui_basic_text_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/data_transport_export_statistics_database_title"
                        android:textFontWeight="600"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:textColor="@color/oui_basic_text_2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/data_transport_export_statistics_category"
                            android:layout_weight="1"/>
                        <TextView
                            android:textColor="@color/oui_basic_text_2"
                            android:gravity="end"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="@string/data_transport_export_statistics_scanned"/>
                        <TextView
                            android:textColor="@color/oui_basic_text_2"
                            android:gravity="end"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="@string/data_transport_export_statistics_success"/>
                        <TextView
                            android:textColor="@color/oui_basic_text_2"
                            android:gravity="end"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="@string/data_transport_export_statistics_failure"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/databaseStatisticsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/attachmentStatisticsSection"
                    android:background="@drawable/bg_export_statistics_card"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/oui_basic_text_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/data_transport_export_statistics_attachment_title"
                        android:textFontWeight="600"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:textColor="@color/oui_basic_text_2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/data_transport_export_statistics_category"
                            android:layout_weight="1"/>
                        <TextView
                            android:textColor="@color/oui_basic_text_2"
                            android:gravity="end"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="@string/data_transport_export_statistics_scanned"/>
                        <TextView
                            android:textColor="@color/oui_basic_text_2"
                            android:gravity="end"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="@string/data_transport_export_statistics_success"/>
                        <TextView
                            android:textColor="@color/oui_basic_text_2"
                            android:gravity="end"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="@string/data_transport_export_statistics_failure"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/attachmentStatisticsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/oui_functional_red_6"
                    android:id="@+id/tvExportWarnings"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <View
        android:layout_gravity="top"
        android:id="@+id/cut_off"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="96dp"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</FrameLayout>
