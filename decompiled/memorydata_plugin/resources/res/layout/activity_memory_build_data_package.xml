<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="always"/>
    <ScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="24sp"
                android:textColor="@color/oui_basic_text_1"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/data_transport_memory_build_package_title"
                android:paddingHorizontal="28dp"
                android:textFontWeight="600"/>
            <com.obric.oui.text.OTextView
                android:textSize="14sp"
                android:textColor="@color/oui_basic_text_1"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/data_transport_memory_build_package_description"
                android:paddingHorizontal="22dp"
                android:lineHeight="21sp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/oui_basic_text_2"
                android:gravity="center"
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/data_transport_ready_prepared"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/oui_basic_text_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/data_transport_memory_build_package_latest_title"
                android:layout_marginHorizontal="22dp"
                android:textFontWeight="600"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/oui_basic_text_2"
                android:id="@+id/tvLatestPackageSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/data_transport_memory_build_package_latest_empty"
                android:layout_marginHorizontal="22dp"
                android:lineHeight="20sp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/oui_basic_text_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/data_transport_memory_build_package_time_filter"
                android:layout_marginHorizontal="22dp"
                android:textFontWeight="600"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/oui_basic_text_2"
                android:id="@+id/tvTimeRangeSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/data_transport_memory_build_package_time_filter_empty"
                android:layout_marginHorizontal="22dp"
                android:lineHeight="20sp"/>
            <com.obric.oui.button.OButton
                android:id="@+id/btnSelectStartTime"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:text="@string/data_transport_memory_build_package_select_start_time"
                android:layout_marginHorizontal="22dp"
                style="@style/OStyleV2.OButton.L.Standard.Neutral"/>
            <com.obric.oui.button.OButton
                android:id="@+id/btnSelectEndTime"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="@string/data_transport_memory_build_package_select_end_time"
                android:layout_marginHorizontal="22dp"
                style="@style/OStyleV2.OButton.L.Standard.Neutral"/>
            <com.obric.oui.button.OButton
                android:id="@+id/btnClearTimeRange"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="@string/data_transport_memory_build_package_clear_time_filter"
                android:layout_marginHorizontal="22dp"
                style="@style/OStyleV2.OButton.L.Standard.Neutral"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/oui_basic_text_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/data_transport_memory_build_package_export_scope"
                android:layout_marginHorizontal="22dp"
                android:textFontWeight="600"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="22dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/oui_basic_text_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/data_transport_memory_build_package_raw_observation_only"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/oui_basic_text_2"
                        android:id="@+id/tvExportScopeSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/data_transport_memory_build_package_export_scope_off"
                        android:lineHeight="20sp"/>
                </LinearLayout>
                <com.obric.oui.oswitch.OSwitch
                    android:id="@+id/switchOnlyRawObservation"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:layout_marginStart="16dp"/>
            </LinearLayout>
            <com.obric.oui.button.OButton
                android:id="@+id/btnExportPackage"
                android:layout_width="match_parent"
                android:layout_marginTop="24dp"
                android:text="@string/data_transport_memory_build_package_export"
                android:layout_marginHorizontal="22dp"
                style="@style/OStyleV2.OButton.L.Standard.Primary"/>
            <com.obric.oui.button.OButton
                android:id="@+id/btnImportLatestPackage"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:text="@string/data_transport_memory_build_package_import_latest"
                android:layout_marginHorizontal="22dp"
                style="@style/OStyleV2.OButton.L.Standard.Neutral"/>
            <com.obric.oui.button.OButton
                android:id="@+id/btnSharePackage"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:text="@string/data_transport_memory_build_package_share_latest"
                android:layout_marginHorizontal="22dp"
                style="@style/OStyleV2.OButton.L.Standard.Neutral"/>
            <com.obric.oui.button.OButton
                android:id="@+id/btnCopyPackagePath"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:text="@string/data_transport_memory_build_package_copy_latest_path"
                android:layout_marginHorizontal="22dp"
                style="@style/OStyleV2.OButton.L.Standard.Neutral"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/oui_basic_text_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/data_transport_run_log"
                android:layout_marginHorizontal="22dp"
                android:textFontWeight="600"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_memory_build_data_package_log"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="22dp">
                <ScrollView
                    android:id="@+id/scrollViewLog"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/oui_basic_text_1"
                        android:id="@+id/tvLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </ScrollView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
