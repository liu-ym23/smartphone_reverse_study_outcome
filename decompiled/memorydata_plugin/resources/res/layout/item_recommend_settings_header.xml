<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/recommend_banner_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:clipToOutline="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/recommend_banner_container"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.memorydata.ui.banner.OBannerTouchHost
                android:id="@+id/recommend_settings_banner_touch_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToOutline="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.obric.oui.banner.OBanner
                    android:id="@+id/recommend_settings_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToOutline="false"/>
            </com.obric.memorydata.ui.banner.OBannerTouchHost>
            <com.obric.oui.indicator.OCarouselIndicator
                android:id="@+id/recommend_banner_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/recommend_settings_banner_touch_host"
                app:layout_constraintStart_toStartOf="@+id/recommend_settings_banner_touch_host"
                app:layout_constraintTop_toBottomOf="@+id/recommend_settings_banner_touch_host"
                app:oui_dotsColor="@color/oui_basic_text_4"
                app:oui_dotsHeight="4dp"
                app:oui_dotsSpacing="2dp"
                app:oui_dotsStrokeWidth="0dp"
                app:oui_dotsWidth="4dp"
                app:oui_selectedDotColor="@color/oui_basic_text_1"
                app:oui_type="normal"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/oui_basic_text_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/recommend_settings_usage_title"
        android:layout_marginHorizontal="12dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:lineHeight="16sp"
        android:textFontWeight="400"/>
    <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
        android:id="@+id/screen_observation_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/MemoryListGroupGap"
        app:ocardlistitem_cardPosition="position_single"
        app:ocardlistitem_cardType="type_normal"
        app:ocardlistitem_defaultCustomEnd="end_switch"
        app:ocardlistitem_showCustomEnd="true"
        app:ocardlistitem_showIcon="false"
        app:ocardlistitem_showSubTitle="false"
        app:ocardlistitem_showTailIcon="false"
        app:ocardlistitem_showTitle="true"
        app:ocardlistitem_title="@string/recommend_settings_switch_title"/>
    <TextView
        android:id="@+id/screen_observation_temporarily_disabled_tips"
        android:visibility="gone"
        style="@style/SettingItemTipsStyle"/>
    <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
        android:id="@+id/recommend_memory"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="?attr/MemoryListGroupGap"
        app:ocardlistitem_cardPosition="position_single"
        app:ocardlistitem_cardType="type_normal"
        app:ocardlistitem_defaultTailIcon="tail_arrow"
        app:ocardlistitem_showIcon="false"
        app:ocardlistitem_showSubTitle="false"
        app:ocardlistitem_showTailIcon="true"
        app:ocardlistitem_showTitle="true"
        app:ocardlistitem_title="@string/recommend_memory_title"/>
</LinearLayout>
