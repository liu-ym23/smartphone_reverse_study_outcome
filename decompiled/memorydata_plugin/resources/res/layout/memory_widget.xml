<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_vertical"
    android:id="@+id/widget_container"
    android:background="@drawable/widget_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="14sp"
        android:textColor="#f53f3f"
        android:id="@+id/widget_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="14.5dp"
        android:layout_marginBottom="10dp"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2sp"
        android:translationY="-0.77sp"
        android:fontFamily="Olasans-sc-compact"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:fontVariationSettings="&apos;wght&apos; 600, &apos;wdth&apos; 100"/>
    <ListView
        android:id="@+id/widget_items"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@android:color/transparent"
        android:dividerHeight="4dp"
        android:layout_below="@+id/widget_title"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/widget_empty"
        android:paddingTop="27dp"
        android:paddingBottom="27dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_widget_empty"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/oui_basic_text_3b"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginTop="4dp"
            android:text="@string/memory_widget_empty_title"
            android:fontFamily="Olasans-sc-compact"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/oui_basic_text_3b"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text="@string/memory_widget_empty_content"
            android:fontFamily="Olasans-sc-compact"/>
    </LinearLayout>
</RelativeLayout>
