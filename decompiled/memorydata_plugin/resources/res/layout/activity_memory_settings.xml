<?xml version="1.0" encoding="utf-8"?>
<com.obric.memorydata.ui.banner.BannerFriendlyFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.ONestedScrollView
        android:id="@+id/memory_settings_container"
        android:paddingTop="16dp"
        android:paddingBottom="@dimen/oui_h_title_bar_window"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/oui_h_title_bar_window"
        android:fillViewport="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToOutline="true">
            <FrameLayout
                android:id="@+id/memory_banner_container"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:clipToOutline="true">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/memory_settings_banner_wrapper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.obric.memorydata.memory.ui.settings.ForceTouchOBanner
                        android:id="@+id/memory_settings_banner_inner_wrapper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToOutline="false"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.obric.oui.indicator.OCarouselIndicator
                        android:id="@+id/memory_banner_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/memory_settings_banner_inner_wrapper"
                        app:layout_constraintStart_toStartOf="@+id/memory_settings_banner_inner_wrapper"
                        app:layout_constraintTop_toBottomOf="@+id/memory_settings_banner_inner_wrapper"
                        app:oui_dotsColor="@color/oui_basic_text_4"
                        app:oui_dotsHeight="4dp"
                        app:oui_dotsSpacing="2dp"
                        app:oui_dotsStrokeWidth="0dp"
                        app:oui_dotsWidth="4dp"
                        app:oui_selectedDotColor="@color/oui_basic_text_1"
                        app:oui_type="normal"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/memoryData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/MemoryListGroupGap"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_large"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/memory_settings_switch_title"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/pinIcon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/memory_settings_icon"/>
            <TextView
                android:id="@+id/memoryMethodTitle"
                android:layout_marginTop="?attr/MemoryListGroupGap"
                android:text="@string/memory_settings_memory_source_summary"
                android:layout_marginHorizontal="12dp"
                style="@style/SettingItemTipsStyle"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/activeMemory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_large"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/memory_settings_active_memory_sub_title"
                app:ocardlistitem_title="@string/memory_settings_active_memory_title"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/smartMemory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_large"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/memory_settings_smart_memory_sub_title"
                app:ocardlistitem_title="@string/memory_settings_smart_memory_title"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/contextAwareness"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_large"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/context_awareness_title"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/voice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_large"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/memory_settings_voice_sub_title"
                app:ocardlistitem_title="@string/memory_settings_voice_title"/>
            <TextView
                android:id="@+id/memoryAppTitle"
                android:layout_marginTop="?attr/MemoryListGroupGap"
                android:text="@string/memory_usage_app_title"
                android:layout_marginHorizontal="12dp"
                style="@style/SettingItemTipsStyle"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/proactiveUi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_large"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/memory_settings_ai_proactive_agent_title"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/lifelogApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_large"
                app:ocardlistitem_customEnd="@layout/item_memory_settings_usage_app_tailview"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/memory_usage_lifelog_app_name"/>
            <TextView
                android:layout_marginTop="?attr/MemoryListGroupGap"
                android:text="@string/data_and_privacy_tip_text"
                android:layout_marginHorizontal="12dp"
                style="@style/SettingItemTipsStyle"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/authSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_large"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/memory_settings_auth_sub_title"
                app:ocardlistitem_title="@string/memory_settings_auth_title"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/commonLocationManager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_large"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/memory_settings_location_manager_sub_title"
                app:ocardlistitem_title="@string/memory_settings_location_manager_title"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/uxp_switch"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/MemoryListGroupGap"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_large"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/memory_settings_uxp_summary"
                app:ocardlistitem_title="@string/memory_settings_uxp_title"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/privacy_policy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/MemoryListGroupGap"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/memory_settings_global_memory_privacy_policy"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/ai_lab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/ailab_settings"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/data_export"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/memory_settings_data_export_sub_title"
                app:ocardlistitem_title="@string/memory_settings_data_export"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/memory_build_data_package"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/memory_settings_memory_build_data_package_sub_title"
                app:ocardlistitem_title="@string/memory_settings_memory_build_data_package"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.ONestedScrollView>
    <View
        android:id="@+id/cut_off"
        android:background="@color/oui_basic_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="96dp"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_centerTitle="@string/memory_settings_title"
        app:oFloatingTitleBar_enableFloatingTransition="true"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</com.obric.memorydata.ui.banner.BannerFriendlyFrameLayout>
