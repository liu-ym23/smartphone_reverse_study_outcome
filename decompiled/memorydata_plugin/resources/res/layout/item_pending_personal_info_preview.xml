<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="12dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp">
    <View
        android:id="@+id/pending_stack_back"
        android:background="@drawable/bg_pending_personal_info_stack"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="23dp"
        android:translationY="12dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="34dp"
        android:layout_marginEnd="33dp"
        android:backgroundTint="@color/memory_pending_stack_back"
        app:layout_constraintBottom_toBottomOf="@+id/pending_front"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.obric.oui.layout.OUIFrameLayout
        android:id="@+id/pending_stack_middle"
        android:background="@drawable/bg_pending_personal_info_stack"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="23dp"
        android:translationY="@dimen/memory_pending_stack_middle_offset"
        android:importantForAccessibility="no"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="14dp"
        android:backgroundTint="@color/memory_pending_stack_middle"
        app:layout_constraintBottom_toBottomOf="@+id/pending_front"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:oui_shadowCornerRadius="20dp"/>
    <com.obric.oui.layout.OUIFrameLayout
        android:id="@+id/pending_front_shadow"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/pending_front"
        app:layout_constraintEnd_toEndOf="@+id/pending_front"
        app:layout_constraintStart_toStartOf="@+id/pending_front"
        app:layout_constraintTop_toTopOf="@+id/pending_front"
        app:oui_shadowCornerRadius="20dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pending_front"
        android:background="@drawable/bg_pending_personal_info_section"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipToOutline="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/bg_pending_personal_info_art"
            android:scaleType="fitXY"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/pending_view_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?android:attr/selectableItemBackground"
                android:minHeight="40dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:layout_marginEnd="6dp"
                    app:srcCompat="@drawable/oic_rectangle_stack_ai"
                    app:tint="@color/oui_basic_text_1"/>
                <com.obric.oui.text.OTextView
                    android:textSize="14sp"
                    android:textColor="@color/oui_basic_text_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/memory_pending_personal_info_title"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:lineHeight="19sp"
                    android:textFontWeight="500"/>
                <com.obric.oui.text.OTextView
                    android:textSize="12sp"
                    android:textColor="@color/oui_basic_text_3"
                    android:id="@+id/pending_view_all_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:lineHeight="16sp"
                    android:textFontWeight="500"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:layout_marginStart="4dp"
                    app:srcCompat="@drawable/ic_more_right"/>
            </LinearLayout>
            <include
                android:id="@+id/pending_card"
                layout="@layout/item_pending_personal_info_card"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
