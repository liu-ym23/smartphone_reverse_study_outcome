<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="168px"
    android:layout_weight="1">
    <com.obric.oui.layout.OUIFrameLayout
        android:id="@+id/memory_date_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_max="168px"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="168px"
        app:oui_radius="84px">
        <com.obric.memorydata.memory.ui.view.MemoryDateTextView
            android:textSize="54px"
            android:textColor="@color/oui_basic_text_1"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/memory_date_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:fontFamily="Olasans-sc-compact"
            android:letterSpacing="0"/>
        <View
            android:layout_gravity="bottom|center_horizontal"
            android:id="@+id/memory_not_empty_point"
            android:background="@drawable/bg_memory_date_point"
            android:layout_width="20px"
            android:layout_height="20px"
            android:layout_marginBottom="5dp"/>
    </com.obric.oui.layout.OUIFrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
