<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/search_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.obric.oui.orecyclerview.widget.RecyclerView
                android:id="@+id/address_search_result_recycler_view"
                android:paddingTop="160dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <com.obric.oui.text.OTextView
                android:textSize="18sp"
                android:textColor="@color/oui_basic_text_3b"
                android:layout_gravity="center"
                android:id="@+id/search_empty_view"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search_empty_text"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/address_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.obric.oui.orecyclerview.widget.RecyclerView
                android:id="@+id/address_recycler_view"
                android:paddingTop="160dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/address_empty_view"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.obric.oui.text.OTextView
                    android:textSize="18sp"
                    android:textColor="@color/oui_basic_text_3b"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/address_empty_text"/>
            </LinearLayout>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:layout_gravity="top"
        android:id="@+id/cut_off"
        android:background="@color/oui_basic_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="96dp"/>
    <com.obric.oui.blur.OBlurMaskView
        android:id="@+id/address_header_mask"
        android:paddingBottom="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oBlurMask_blurRadius="8"
        app:oBlurMask_defaultMaskBackground="true"
        app:oBlurMask_statusBarImmersion="false">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/address_header_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.titlebar.OFloatingTitleBar
                android:id="@+id/title_bar"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:oFloatingTitleBar_statusBarImmersion="true"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/search_bar_container"
                android:paddingTop="8dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp">
                <com.obric.oui.searchbar.v2.OSearchBar
                    android:id="@+id/search_bar"
                    android:layout_width="0dp"
                    android:hint="@string/search_address_hint"
                    android:layout_weight="1"
                    style="@style/OStyleV2.OSearchBar.Default.S"/>
                <com.obric.oui.button.OIconButtonFloating
                    android:id="@+id/search_cancel_button"
                    android:visibility="gone"
                    android:layout_marginStart="8dp"
                    app:oui_widgetIcon="@drawable/o_floating_title_bar_icon_close"
                    style="@style/OStyleV2.OButtonFloating.S.Standard.Icon"/>
            </LinearLayout>
        </LinearLayout>
    </com.obric.oui.blur.OBlurMaskView>
</FrameLayout>
