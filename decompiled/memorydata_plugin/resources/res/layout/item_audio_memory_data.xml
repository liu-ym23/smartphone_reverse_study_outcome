<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/memory_generalization"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/oui_basic_text_1"
        android:ellipsize="end"
        android:id="@+id/audio_memory_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="3"
        android:textAlignment="textStart"
        android:lineHeight="22sp"
        android:textFontWeight="400"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/memory_source_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/audio_memory_title">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="0.5dp"
            android:src="@drawable/audio_memory_tab_select_icon"
            android:layout_marginEnd="4dp"
            app:tint="@color/oui_basic_text_3"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/oui_text_3"
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/memory_list_source_voice"
            android:layout_weight="1"
            android:lineHeight="16dp"
            android:textFontWeight="400"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/oui_text_3"
            android:layout_gravity="center_vertical"
            android:id="@+id/audio_memory_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineHeight="16dp"
            android:textFontWeight="400"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
