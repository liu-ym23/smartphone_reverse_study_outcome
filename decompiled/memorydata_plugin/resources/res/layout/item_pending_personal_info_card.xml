<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_pending_personal_info_card"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <com.obric.oui.text.OTextView
        android:textSize="16sp"
        android:textColor="@color/oui_basic_text_1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/pending_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="32dp"
        android:maxLines="3"
        android:includeFontPadding="false"
        android:lineHeight="22sp"
        android:textFontWeight="400"/>
    <LinearLayout
        android:gravity="top"
        android:orientation="horizontal"
        android:id="@+id/pending_source_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingStart="2dp">
        <View
            android:background="@drawable/bg_pending_source_indicator"
            android:layout_width="1.5dp"
            android:layout_height="12sp"
            android:layout_marginTop="2sp"
            android:importantForAccessibility="no"/>
        <com.obric.oui.text.OTextView
            android:textSize="12sp"
            android:textColor="@color/oui_basic_text_3"
            android:ellipsize="end"
            android:id="@+id/pending_source"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:lineHeight="16sp"
            android:textFontWeight="400"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <com.obric.oui.button.OButton
            android:id="@+id/pending_ignore"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="@string/memory_pending_personal_info_ignore"
            android:layout_weight="1"
            app:OUI_alpha_disabled="1"
            app:oui_buttonTextStyle="@style/PendingPersonalInfoButtonText"
            app:oui_widgetDisableAlpha="1"
            style="@style/OButton.M1.Standard.Neutral"/>
        <Space
            android:layout_width="12dp"
            android:layout_height="1dp"/>
        <com.obric.oui.button.OButton
            android:textColor="@color/oui_accent_fg"
            android:id="@+id/pending_confirm"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="@string/memory_pending_personal_info_confirm"
            android:layout_weight="1"
            app:OUI_alpha_disabled="1"
            app:oui_buttonTextStyle="@style/PendingPersonalInfoButtonText"
            app:oui_widgetDisableAlpha="1"
            style="@style/OButton.M1.Standard.Neutral"/>
    </LinearLayout>
</LinearLayout>
