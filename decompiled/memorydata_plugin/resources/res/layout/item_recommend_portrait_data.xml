<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/memory_generalization"
    android:background="@drawable/bg_recommend_memory_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14.5dp">
    <TextView
        android:textSize="12.5sp"
        android:textColor="@color/oui_basic_text_3"
        android:id="@+id/tag_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="9.5dp"
        android:lineHeight="16sp"
        android:textFontWeight="500"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/oui_basic_text_1"
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineHeight="22sp"
        android:textFontWeight="500"/>
    <TextView
        android:textSize="12.5sp"
        android:textColor="@color/oui_basic_text_3"
        android:id="@+id/observation_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineHeight="16sp"
        android:textFontWeight="400"/>
    <TextView
        android:textSize="12.5sp"
        android:textColor="@color/oui_basic_text_3"
        android:id="@+id/update_time_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineHeight="16sp"
        android:textFontWeight="400"/>
    <TextView
        android:textSize="12.5sp"
        android:textColor="@color/oui_basic_text_3"
        android:id="@+id/create_time_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineHeight="16sp"
        android:textFontWeight="400"/>
    <TextView
        android:textSize="12.5sp"
        android:textColor="@color/oui_basic_text_3"
        android:id="@+id/profile_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineHeight="16sp"
        android:textFontWeight="400"/>
</LinearLayout>
