<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_proactive_more_menu"
    android:layout_width="148dp"
    android:layout_height="wrap_content"
    android:paddingVertical="6dp">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/proactive_text_primary"
        android:gravity="center"
        android:id="@+id/btn_feedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/proactive_menu_feedback"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:textFontWeight="500"/>
    <View
        android:background="@color/proactive_line_tertiary"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/proactive_text_primary"
        android:gravity="center"
        android:id="@+id/btn_close_proactive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/proactive_menu_close"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:textFontWeight="500"/>
</LinearLayout>
