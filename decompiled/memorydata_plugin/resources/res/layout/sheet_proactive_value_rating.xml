<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ai_proactive_demo_sheet_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/drag_handle"
        android:background="@drawable/shape_proactive_top_line"
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.obric.aiproactive.ui.util.ProactiveTopBarIconButton
        android:id="@+id/btn_close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:contentDescription="@string/proactive_value_close"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/drag_handle"
        app:oui_widgetIcon="@drawable/ic_proactive_close"
        style="@style/Widget.ProactiveUi.TopBarFloatingButton"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/ai_proactive_demo_text_primary"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/proactive_value_question"
        app:layout_constraintBottom_toBottomOf="@+id/btn_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_close"/>
    <com.obric.oui.forms.OInputLayout
        android:id="@+id/input_custom_amount"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:digits="0123456789"
        android:inputType="number"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_close"
        app:oinput_customStart="@layout/view_proactive_value_currency_prefix"
        app:oinput_hint="@string/proactive_value_custom_hint"
        app:oinput_showClear="false"
        app:oinput_showCustomEnd="false"
        app:oinput_showCustomStart="true"
        app:oinput_showInputBackground="true"
        app:oinput_showLabel="false"
        app:oinput_showLimit="false"
        app:oinput_showTip="false"
        app:oinput_type="0"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/ai_proactive_demo_text_disabled"
        android:id="@+id/tv_input_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/proactive_value_custom_range_hint"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_custom_amount"/>
    <com.obric.oui.button.OButton
        android:id="@+id/btn_submit"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="24dp"
        android:text="@string/proactive_value_submit"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_input_hint"
        style="@style/OStyleV2.OButton.L.Standard.Primary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
