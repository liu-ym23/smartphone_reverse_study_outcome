<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.ONestedScrollView
        android:id="@+id/context_awareness_container"
        android:paddingTop="16dp"
        android:paddingBottom="@dimen/oui_h_title_bar_window"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/oui_h_title_bar_window"
        android:fillViewport="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/source_section_title"
                android:text="@string/context_awareness_source_section"
                android:layout_marginHorizontal="12dp"
                style="@style/SettingItemTipsStyle"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/screen_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_large"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/context_awareness_screen_subtitle"
                app:ocardlistitem_title="@string/context_awareness_screen_title"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/ambient_voice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_large"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/context_awareness_voice_subtitle"
                app:ocardlistitem_title="@string/context_awareness_voice_title"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/system_app_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_large"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showCustomEnd="false"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/context_awareness_system_app_subtitle"
                app:ocardlistitem_title="@string/context_awareness_system_app_title"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/smart_glasses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_large"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/context_awareness_glasses_subtitle"
                app:ocardlistitem_title="@string/context_awareness_glasses_title"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/motion_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_large"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/context_awareness_motion_subtitle"
                app:ocardlistitem_title="@string/context_awareness_motion_title"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_large"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/context_awareness_location_subtitle"
                app:ocardlistitem_title="@string/context_awareness_location_title"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/notification_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_large"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/context_awareness_notification_subtitle"
                app:ocardlistitem_title="@string/context_awareness_notification_title"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/device_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_large"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/context_awareness_device_state_subtitle"
                app:ocardlistitem_title="@string/context_awareness_device_state_title"/>
            <TextView
                android:id="@+id/data_management_section_title"
                android:layout_marginTop="16dp"
                android:text="@string/context_awareness_data_management_section"
                android:layout_marginHorizontal="12dp"
                style="@style/SettingItemTipsStyle"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/cellular_upload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_large"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/context_awareness_cellular_upload_title"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/enhanced_timeliness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_large"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/context_awareness_enhanced_timeliness_title"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/block_rules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_large"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showCustomEnd="false"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/context_awareness_block_rules_title"/>
            <TextView
                android:id="@+id/debug_section_title"
                android:visibility="gone"
                android:layout_marginTop="16dp"
                android:text="@string/context_awareness_debug_section"
                android:layout_marginHorizontal="12dp"
                style="@style/SettingItemTipsStyle"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/recorder_ambient_voice_collection_debug"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_large"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/context_awareness_recorder_ambient_voice_collection_debug_title"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.ONestedScrollView>
    <View
        android:layout_gravity="top"
        android:id="@+id/cut_off"
        android:background="@color/oui_basic_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="96dp"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="always"
        app:oFloatingTitleBar_centerTitle="@string/context_awareness_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</FrameLayout>
