<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.ONestedScrollView
        android:id="@+id/layout_waiting_for_scan"
        android:paddingBottom="@dimen/oui_h_title_bar_window"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToOutline="true">
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/oui_basic_text_1"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/memory_data_transfer_waiting_scan_title"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/oui_basic_text_2"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/memory_data_transfer_waiting_scan_subtitle"/>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="114dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/oui_basic_text_3"
                    android:id="@+id/tv_device_name_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/memory_data_transfer_device_name_label"/>
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/oui_basic_text_1"
                    android:id="@+id/tv_device_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Phone Name"/>
                <FrameLayout
                    android:background="@drawable/bg_memory_card"
                    android:layout_width="198dp"
                    android:layout_height="198dp"
                    android:layout_marginTop="12dp"
                    android:clipToOutline="true">
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/iv_qr_code"
                        android:layout_width="174dp"
                        android:layout_height="174dp"
                        android:scaleType="fitXY"/>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </com.obric.oui.bouncelayout.ONestedScrollView>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/layout_connecting"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.obric.oui.status.OPageStatus
            android:id="@+id/page_status_connecting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:opagestatus_showLoading="true"
            app:opagestatus_type="vertical_loading"/>
        <com.obric.oui.text.OTextView
            android:textSize="20sp"
            android:textColor="@color/oui_basic_text_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="21dp"
            android:text="@string/memory_data_transfer_connecting_title"
            android:textFontWeight="500"/>
        <com.obric.oui.text.OTextView
            android:textSize="14sp"
            android:textColor="@color/oui_basic_text_3b"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/memory_data_transfer_connecting_subtitle"/>
    </LinearLayout>
    <com.obric.oui.status.OPageStatus
        android:layout_gravity="center"
        android:id="@+id/page_status_restoring"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:opagestatus_showLoading="true"
        app:opagestatus_type="vertical_loading"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_generic_status"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_center_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="186dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/iv_status_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"/>
            <com.obric.oui.text.OTextView
                android:textSize="24sp"
                android:textColor="@color/oui_basic_text_1"
                android:gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="24dp"
                android:textFontWeight="600"/>
            <com.obric.oui.text.OTextView
                android:textSize="14sp"
                android:textColor="@color/oui_basic_text_1"
                android:gravity="center"
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="24dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_encrypting_status"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp">
                <com.obric.oui.progress.ODownloadProgressView
                    android:id="@+id/small_loading_view"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    app:oui_progress_view_size="small"/>
                <com.obric.oui.text.OTextView
                    android:textSize="16sp"
                    android:textColor="@color/oui_basic_text_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/memory_data_transfer_encrypting_progress_text"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_progress_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:layout_marginHorizontal="32dp">
                <com.obric.oui.progress.OProgressView
                    android:id="@+id/progress_bar"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    app:oui_progress_background_color="@color/oui_line_2"
                    app:oui_progressing_action_color="@color/oui_blue_6"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">
                    <com.obric.oui.text.OTextView
                        android:textSize="12sp"
                        android:textColor="@color/oui_basic_text_3"
                        android:id="@+id/tv_transferred_size"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <com.obric.oui.text.OTextView
                        android:textSize="12sp"
                        android:textColor="@color/oui_basic_text_3"
                        android:id="@+id/tv_progress_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <com.obric.oui.button.OButton
            android:id="@+id/btn_action"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginBottom="24dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/OStyleV2.OButton.L.Standard.Primary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</FrameLayout>
