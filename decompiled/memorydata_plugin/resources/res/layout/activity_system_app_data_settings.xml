<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.ONestedScrollView
        android:id="@+id/system_app_data_container"
        android:paddingTop="16dp"
        android:paddingBottom="@dimen/oui_h_title_bar_window"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/oui_h_title_bar_window"
        android:fillViewport="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/system_app_sms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/context_awareness_system_app_sms"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/system_app_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/context_awareness_system_app_phone"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/system_app_recorder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/context_awareness_system_app_recorder"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/system_app_calendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/context_awareness_system_app_calendar"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/system_app_alarm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/context_awareness_system_app_alarm"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/system_app_gallery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/context_awareness_system_app_gallery"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/system_app_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/context_awareness_system_app_note"/>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/system_app_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/context_awareness_system_app_file"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.ONestedScrollView>
    <View
        android:layout_gravity="top"
        android:id="@+id/cut_off"
        android:background="@color/oui_basic_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="96dp"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="always"
        app:oFloatingTitleBar_centerTitle="@string/context_awareness_system_app_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</FrameLayout>
