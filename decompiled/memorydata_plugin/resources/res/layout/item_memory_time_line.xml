<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/time_line_up_background_view"
        android:background="@color/oui_basic_bg_base_1"
        android:visibility="invisible"
        android:layout_width="1.5dp"
        android:layout_height="0dp"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toTopOf="@+id/time_line_point"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/time_line_up"
        android:background="@drawable/widget_memory_time_line_bottom_round"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/time_line_up_background_view"
        app:layout_constraintEnd_toEndOf="@+id/time_line_up_background_view"
        app:layout_constraintStart_toStartOf="@+id/time_line_up_background_view"
        app:layout_constraintTop_toTopOf="@+id/time_line_up_background_view"/>
    <View
        android:id="@+id/time_line_down_background_view"
        android:background="@color/oui_basic_bg_base_1"
        android:layout_width="1.5dp"
        android:layout_height="0dp"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/time_line_point"/>
    <View
        android:id="@+id/time_line_down"
        android:background="@drawable/widget_memory_time_line_top_round"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/time_line_down_background_view"
        app:layout_constraintEnd_toEndOf="@+id/time_line_down_background_view"
        app:layout_constraintStart_toStartOf="@+id/time_line_down_background_view"
        app:layout_constraintTop_toTopOf="@+id/time_line_down_background_view"/>
    <View
        android:id="@+id/time_line_point"
        android:background="@drawable/memory_time_line_point_icon"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginTop="1dp"
        android:layout_marginStart="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_memory_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_memory_time"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/oui_basic_text_1"
        android:id="@+id/tv_memory_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="17.5dp"
        android:lineHeight="22sp"
        android:textFontWeight="500"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
