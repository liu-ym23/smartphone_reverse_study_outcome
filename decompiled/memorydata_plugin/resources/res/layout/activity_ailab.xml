<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/about_root_view"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/scroll_content"
        android:paddingBottom="@dimen/oui_h_title_bar_window"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/oui_h_title_bar_window">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/header_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/logo_img"
                    android:layout_width="252px"
                    android:layout_height="252px"
                    android:src="@drawable/ai_lab_settings_logo"/>
                <TextView
                    android:textSize="84px"
                    android:textColor="@color/oui_text_1"
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="70px"
                    android:text="@string/ailab_settings_info"
                    android:textFontWeight="600"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/oui_basic_text_1"
                    android:id="@+id/sub_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/ailab_settings_sub_info"
                    android:lineHeight="21sp"
                    android:textFontWeight="400"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/oui_basic_text_3"
                    android:layout_width="296dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/ailab_settings_tips"
                    android:lineHeight="16dp"
                    android:textFontWeight="400"
                    style="@style/TextViewStyle"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/feature_list_container"
                android:background="@drawable/o_background_list_item"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="42dp"
                android:layout_marginHorizontal="12dp">
                <com.obric.oui.lisitem.OListItemGeneral
                    android:id="@+id/screen_memory_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:oui_list_item_show_background="false"
                    app:oui_list_item_subtitle="@string/ailab_settings_screen_memory_desc"
                    app:oui_list_item_title="@string/ailab_settings_screen_memory"/>
                <com.obric.oui.lisitem.OListItemGeneral
                    android:id="@+id/voice_memory_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:oui_list_item_show_background="false"
                    app:oui_list_item_subtitle="@string/ailab_settings_voice_memory_desc"
                    app:oui_list_item_title="@string/ailab_settings_voice_memory"/>
                <com.obric.oui.lisitem.OListItemGeneral
                    android:id="@+id/auto_memory_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:oui_list_item_show_background="false"
                    app:oui_list_item_subtitle="@string/memory_settings_auto_memory_notice_message"
                    app:oui_list_item_title="@string/memory_settings_auto_memory_pro_title"/>
                <com.obric.oui.lisitem.OListItemGeneral
                    android:id="@+id/ai_proactive_agent_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:oui_list_item_show_background="false"
                    app:oui_list_item_subtitle="@string/memory_settings_ai_proactive_agent_content"
                    app:oui_list_item_title="@string/memory_settings_ai_proactive_agent_title"/>
            </LinearLayout>
            <com.obric.oui.text.OTextView
                android:textSize="12sp"
                android:textColor="@color/oui_text_3"
                android:paddingTop="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ailab_settings_approval_desc"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginHorizontal="8dp"
                android:paddingHorizontal="@dimen/oui_p_list_item_3"
                android:textFontWeight="480"/>
            <com.obric.oui.text.OTextView
                android:textSize="12sp"
                android:textColor="@color/oui_text_3"
                android:paddingTop="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/ailab_settings_note_title"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginHorizontal="8dp"
                android:paddingHorizontal="@dimen/oui_p_list_item_3"
                android:textFontWeight="480"/>
            <com.obric.oui.text.OTextView
                android:textSize="12sp"
                android:textColor="@color/oui_text_3"
                android:paddingTop="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ailab_settings_note_1"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginHorizontal="8dp"
                android:paddingHorizontal="@dimen/oui_p_list_item_3"
                android:textFontWeight="480"/>
            <com.obric.oui.text.OTextView
                android:textSize="12sp"
                android:textColor="@color/oui_text_3"
                android:paddingTop="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ailab_settings_note_2"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginHorizontal="8dp"
                android:paddingHorizontal="@dimen/oui_p_list_item_3"
                android:textFontWeight="480"/>
            <com.obric.oui.text.OTextView
                android:textSize="12sp"
                android:textColor="@color/oui_text_3"
                android:paddingTop="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ailab_settings_note_3"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginHorizontal="8dp"
                android:paddingHorizontal="@dimen/oui_p_list_item_3"
                android:textFontWeight="480"/>
            <com.obric.oui.text.OTextView
                android:textSize="12sp"
                android:textColor="@color/oui_text_3"
                android:paddingTop="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ailab_settings_note_4"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginHorizontal="8dp"
                android:paddingHorizontal="@dimen/oui_p_list_item_3"
                android:textFontWeight="480"/>
            <com.obric.oui.text.OTextView
                android:textSize="12sp"
                android:textColor="@color/oui_text_3"
                android:gravity="center_horizontal"
                android:id="@+id/ailab_systeminfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="8dp"
                android:paddingHorizontal="@dimen/oui_p_list_item_3"
                android:paddingVertical="4dp"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.OScrollView>
    <View
        android:layout_gravity="top"
        android:id="@+id/cut_off"
        android:background="@color/oui_basic_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="96dp"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</FrameLayout>
