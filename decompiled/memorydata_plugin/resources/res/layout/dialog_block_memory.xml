<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/simple_form_body_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">
            <com.obric.oui.forms.OInputLayout
                android:id="@+id/block_content_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:oinput_showClear="true"
                app:oui_inputLabel="label"
                app:oui_inputMode="text"
                app:oui_inputSingleLine="true"
                app:oui_showLabel="false"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_delete_memory"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="4dp">
                <com.obric.oui.checkbox.OCheckBox
                    android:id="@+id/cb_delete_memory"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:oui_checkedState="checked"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/oui_text_1"
                    android:id="@+id/tv_delete_memory_confirm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/screen_memory_block_dialog_delete_memory"
                    android:layout_marginStart="8dp"
                    android:textFontWeight="400"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/simple_form_footer_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">
            <com.obric.oui.button.OButton
                android:id="@+id/block_memory_cancel"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="@string/screen_memory_block_dialog_cancel"
                android:lines="1"
                android:layout_weight="1"
                style="@style/OStyleV2.OButton.L.Standard.Neutral"/>
            <com.obric.oui.button.OButton
                android:id="@+id/block_memory_confirm"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="@string/screen_memory_block_dialog_confirm"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                style="@style/OStyleV2.OButton.L.Standard.Primary_Light"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
