<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/openAll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ocardlistitem_cardPosition="position_top"
        app:ocardlistitem_cardType="type_normal"
        app:ocardlistitem_defaultCustomEnd="end_mark"
        app:ocardlistitem_showCustomEnd="true"
        app:ocardlistitem_showIcon="false"
        app:ocardlistitem_showSubTitle="false"
        app:ocardlistitem_showTailIcon="false"
        app:ocardlistitem_showTitle="true"
        app:ocardlistitem_title="@string/screen_observation_new_app_open_all"/>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/openCustom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ocardlistitem_cardPosition="position_middle"
        app:ocardlistitem_cardType="type_normal"
        app:ocardlistitem_defaultCustomEnd="end_mark"
        app:ocardlistitem_showCustomEnd="true"
        app:ocardlistitem_showIcon="false"
        app:ocardlistitem_showSubTitle="false"
        app:ocardlistitem_showTailIcon="false"
        app:ocardlistitem_showTitle="true"
        app:ocardlistitem_title="@string/screen_observation_new_app_open_custom"/>
    <com.obric.oui.lisitem.OCardListItem
        android:id="@+id/openNone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:ocardlistitem_cardPosition="position_bottom"
        app:ocardlistitem_cardType="type_normal"
        app:ocardlistitem_defaultCustomEnd="end_mark"
        app:ocardlistitem_showCustomEnd="true"
        app:ocardlistitem_showIcon="false"
        app:ocardlistitem_showSubTitle="false"
        app:ocardlistitem_showTailIcon="false"
        app:ocardlistitem_showTitle="true"
        app:ocardlistitem_title="@string/screen_observation_new_app_open_none"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/oui_basic_text_3"
        android:id="@+id/app_category_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/screen_observation_new_app_category_desc"
        android:layout_marginHorizontal="12dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:lineHeight="16sp"
        android:textFontWeight="500"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/openNone"/>
</LinearLayout>
