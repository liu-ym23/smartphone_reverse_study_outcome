<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_calendar"
    android:background="@drawable/bg_memory_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">
    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_island_calendar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_calendar_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_action"
        app:layout_constraintStart_toEndOf="@+id/iv_icon"
        app:layout_constraintTop_toTopOf="parent">
        <com.obric.oui.text.OTextView
            android:textSize="16sp"
            android:textColor="@color/oui_basic_text_1"
            android:ellipsize="end"
            android:id="@+id/tv_calendar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:textFontWeight="@integer/oui_font_weight_semi_prominent"/>
        <com.obric.oui.text.OTextView
            android:textSize="12sp"
            android:textColor="@color/oui_basic_text_3"
            android:id="@+id/tv_calendar_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textFontWeight="@integer/oui_font_weight_regular"/>
    </LinearLayout>
    <com.obric.oui.button.OButton
        android:textStyle="bold"
        android:id="@+id/btn_action"
        android:minWidth="94dp"
        android:text="@string/memory_calendar_action"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/OButton.M1.Standard.Primary_Light"/>
</androidx.constraintlayout.widget.ConstraintLayout>
