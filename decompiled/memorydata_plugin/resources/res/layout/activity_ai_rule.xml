<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ai_rule_root"
    android:background="@drawable/bg_ai_proactive_demo_page"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/rule_content_container"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_nav_inset_spacer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.obric.oui.orecyclerview.widget.RecyclerView
            android:id="@+id/rv_rules"
            android:paddingTop="120dp"
            android:paddingBottom="16dp"
            android:clipChildren="true"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="always"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/layout_empty"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="20sp"
                android:textStyle="normal"
                android:textColor="@color/ai_proactive_demo_text_secondary"
                android:id="@+id/tv_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_proactive_rule_empty_title"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/ai_proactive_demo_text_tertiary"
                android:gravity="center"
                android:id="@+id/tv_empty_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ai_proactive_rule_empty_subtitle"
                android:paddingHorizontal="40dp"/>
            <include
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="149dp"
                android:layout_marginTop="24dp"
                android:layout_marginHorizontal="12dp"
                layout="@layout/layout_guided_preference_entry_card_preference"/>
        </LinearLayout>
    </FrameLayout>
    <View
        android:id="@+id/bottom_nav_inset_spacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.obric.oui.blur.OBlurMaskView
        android:id="@+id/top_blur_view"
        android:layout_width="0dp"
        android:layout_height="120dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:oBlurMask_blurRadius="72"
        app:oBlurMask_defaultMaskBackground="false"
        app:oBlurMask_statusBarImmersion="true"/>
    <View
        android:id="@+id/top_cut_off"
        android:background="@drawable/bg_ai_proactive_demo_top_overlay"
        android:layout_width="0dp"
        android:layout_height="120dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.obric.aiproactive.ui.util.ProactiveTopBarIconButton
        android:id="@+id/btn_back_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:contentDescription="返回"
        android:layout_marginStart="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:oui_widgetIcon="@drawable/o_floating_title_bar_icon_back"
        style="@style/Widget.ProactiveUi.TopBarFloatingButton"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/ai_proactive_demo_text_primary"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="偏好"
        android:fontFamily="Ola Sans VFE SC"
        android:elevation="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_back_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_back_container"/>
    <com.obric.aiproactive.ui.util.ProactiveTopBarIconButton
        android:id="@+id/btn_add_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:contentDescription="添加偏好"
        android:layout_marginEnd="24dp"
        app:iconSize="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:oui_widgetIcon="@drawable/o_ic_plus"
        style="@style/Widget.ProactiveUi.TopBarFloatingButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
