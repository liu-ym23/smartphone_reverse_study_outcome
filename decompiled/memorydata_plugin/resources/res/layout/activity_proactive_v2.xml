<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_feed"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/title_blur"
            android:background="@drawable/bg_proactive_scroll_overlay"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:alpha="0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/title_container"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="@dimen/proactive_page_horizontal_padding"
            android:layout_marginEnd="@dimen/proactive_page_horizontal_padding"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/title_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="28dp"
                    android:textColor="@color/proactive_text_primary"
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/proactive_title_now"
                    android:paddingStart="8dp"
                    android:textFontWeight="500"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:id="@+id/bottom_blur"
            android:background="@drawable/bg_proactive_scroll_overlay_bottom"
            android:layout_width="0dp"
            android:layout_height="61dp"
            android:alpha="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <FrameLayout
            android:id="@+id/bottom_more_handle"
            android:layout_width="match_parent"
            android:layout_height="61dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/proactive_more_bg"
                android:scaleType="fitXY"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/iv_more_handle"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/ic_proactive_chevron_up"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
