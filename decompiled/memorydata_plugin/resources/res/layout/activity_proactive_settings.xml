<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.ONestedScrollView
        android:id="@+id/content_scroll"
        android:paddingBottom="32dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/feature_header"
                android:paddingTop="12dp"
                android:paddingBottom="22dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">
                <com.obric.oui.layout.OUIFrameLayout
                    android:id="@+id/feature_icon_shadow"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    app:oui_shadowCornerRadius="20dp"
                    app:oui_shadow_style="@style/OUIShadow.1">
                    <com.obric.oui.layout.OUIFrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:oui_radius="20dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_proactive_app_icon"
                            android:scaleType="fitXY"
                            android:contentDescription="@string/proactive_settings_app_icon_description"/>
                    </com.obric.oui.layout.OUIFrameLayout>
                </com.obric.oui.layout.OUIFrameLayout>
                <com.obric.oui.text.OTextView
                    android:textColor="@color/oui_basic_text_1"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/proactive_settings_header"
                    style="@style/Title_4_Bold"/>
                <com.obric.oui.text.OTextView
                    android:textColor="@color/oui_basic_text_2"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/proactive_settings_description"
                    style="@style/Body_1_Regular"/>
            </LinearLayout>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/proactive_feature_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/proactive_settings_feature_switch_description"
                app:ocardlistitem_title="@string/proactive_settings_feature_switch"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/desktop_shortcut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/MemoryListGroupGap"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/proactive_settings_desktop_shortcut"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/initiative_level"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/MemoryListGroupGap"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_detail"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/proactive_settings_initiative_level"/>
            <TextView
                android:layout_marginTop="16dp"
                android:text="@string/proactive_settings_information_section"
                android:layout_marginHorizontal="12dp"
                style="@style/SettingItemTipsStyle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/local_data_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/proactive_settings_local_data_search"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/global_memory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/proactive_settings_global_memory"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/context_awareness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/proactive_settings_context_awareness"/>
            <TextView
                android:layout_marginTop="16dp"
                android:text="@string/proactive_settings_capabilities_section"
                android:layout_marginHorizontal="12dp"
                style="@style/SettingItemTipsStyle"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/phone_operation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/proactive_settings_phone_operation"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/all_skills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/proactive_settings_all_skills"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/locked_screen_use_assistant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/proactive_settings_locked_screen_use_assistant"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/all_tools"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/proactive_settings_all_tools"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.ONestedScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_maskBlurRadius="36"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</FrameLayout>
