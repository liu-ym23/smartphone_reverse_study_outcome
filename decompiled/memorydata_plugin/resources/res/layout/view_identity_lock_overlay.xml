<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/identity_lock_overlay_root"
    android:background="@color/oui_basic_bg_base_1"
    android:focusable="true"
    android:fitsSystemWindows="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">
        <ImageView
            android:id="@+id/identity_lock_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_lock_memory"
            android:contentDescription="@null"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/oui_basic_text_3"
            android:id="@+id/identity_lock_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/memory_identity_lock_title"
            android:textFontWeight="500"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/oui_basic_text_3b"
            android:gravity="center"
            android:id="@+id/identity_lock_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/memory_identity_lock_subtitle"
            android:textFontWeight="400"/>
        <com.obric.oui.button.OButton
            android:layout_gravity="center"
            android:id="@+id/identity_lock_action"
            android:layout_marginTop="20dp"
            android:text="@string/memory_identity_lock_action"
            style="@style/OStyleV2.OButton.S.Standard.Neutral"/>
    </LinearLayout>
</FrameLayout>
