<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.ONestedScrollView
        android:id="@+id/address_settings_container"
        android:paddingTop="16dp"
        android:paddingBottom="@dimen/oui_h_title_bar_window"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/oui_h_title_bar_window"
        android:fillViewport="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToOutline="true">
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/auto_learn_switch"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/memory_activity_address_setting_ocardlistitem_title"
                style="@style/SettingsItemSettingsStyle"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                    android:id="@+id/home_address_item"
                    android:focusable="true"
                    android:clickable="false"
                    app:ocardlistitem_cardPosition="position_top"
                    app:ocardlistitem_cardType="type_normal"
                    app:ocardlistitem_defaultCustomEnd="end_detail"
                    app:ocardlistitem_defaultTailIcon="tail_arrow"
                    app:ocardlistitem_endDetailText="@string/address_not_set_text"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="false"
                    app:ocardlistitem_showTailIcon="false"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_subTitle="@string/auto_learn_address_text"
                    app:ocardlistitem_title="@string/memory_activity_address_setting_ocardlistitem_title_2"
                    style="@style/SettingsItemSettingsStyle"/>
                <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                    android:id="@+id/company_address_item"
                    android:focusable="true"
                    android:clickable="false"
                    app:ocardlistitem_cardPosition="position_bottom"
                    app:ocardlistitem_cardType="type_normal"
                    app:ocardlistitem_defaultCustomEnd="end_detail"
                    app:ocardlistitem_defaultTailIcon="tail_arrow"
                    app:ocardlistitem_endDetailText="@string/address_not_set_text"
                    app:ocardlistitem_showCustomEnd="true"
                    app:ocardlistitem_showIcon="false"
                    app:ocardlistitem_showSubTitle="false"
                    app:ocardlistitem_showTailIcon="false"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_subTitle="@string/auto_learn_address_text"
                    app:ocardlistitem_title="@string/memory_activity_address_setting_ocardlistitem_title_3"
                    style="@style/SettingsItemSettingsStyle"/>
            </LinearLayout>
        </LinearLayout>
    </com.obric.oui.bouncelayout.ONestedScrollView>
    <View
        android:layout_gravity="top"
        android:id="@+id/cut_off"
        android:background="@color/oui_basic_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="96dp"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="always"
        app:oFloatingTitleBar_centerTitle="@string/memory_settings_location_manager_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</FrameLayout>
