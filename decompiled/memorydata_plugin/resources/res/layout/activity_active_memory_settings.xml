<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.ONestedScrollView
        android:id="@+id/active_memory_settings_container"
        android:paddingBottom="40dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/oui_h_title_bar_window">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ll_active_memory_1"
                android:background="@drawable/bg_active_memory_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:clipToOutline="true">
                <ImageView
                    android:id="@+id/iv_active_memory_1"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/bg_active_memory_1_n1"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"
                    app:layout_constraintDimensionRatio="1176:707"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:background="@color/oui_basic_line_1"
                    android:layout_width="0dp"
                    android:layout_height="0.6dp"
                    android:layout_marginTop="5.4dp"
                    android:layout_marginHorizontal="?attr/OBannerDividerMarginHorizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/iv_active_memory_1"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/active_key_memory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/active_memory_tip_1"
                app:ocardlistitem_title="@string/memory_settings_active_memory_key"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ll_active_memory_2"
                android:background="@drawable/bg_active_memory_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="12dp"
                android:clipToOutline="true">
                <ImageView
                    android:id="@+id/iv_active_memory_2"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/bg_active_memory_2"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"
                    app:layout_constraintDimensionRatio="1176:707"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:background="@color/oui_basic_line_1"
                    android:layout_width="0dp"
                    android:layout_height="0.6dp"
                    android:layout_marginTop="5.4dp"
                    android:layout_marginHorizontal="?attr/OBannerDividerMarginHorizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/iv_active_memory_2"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/active_gesture_memory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/active_memory_tip_2"
                app:ocardlistitem_title="@string/memory_settings_active_memory_gesture"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ll_active_memory_3"
                android:background="@drawable/bg_active_memory_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="12dp"
                android:clipToOutline="true">
                <ImageView
                    android:id="@+id/iv_active_memory_3"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/bg_active_memory_3"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"
                    app:layout_constraintDimensionRatio="1176:707"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:background="@color/oui_basic_line_1"
                    android:layout_width="0dp"
                    android:layout_height="0.6dp"
                    android:layout_marginTop="5.4dp"
                    android:layout_marginHorizontal="?attr/OBannerDividerMarginHorizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/iv_active_memory_3"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/active_screen_memory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/active_memory_tip_3"
                app:ocardlistitem_title="@string/memory_settings_active_memory_screen"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ll_active_memory_4"
                android:background="@drawable/bg_active_memory_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="12dp"
                android:clipToOutline="true">
                <ImageView
                    android:id="@+id/iv_active_memory_4"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/bg_active_memory_4"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"
                    app:layout_constraintDimensionRatio="1176:707"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:background="@color/oui_basic_line_1"
                    android:layout_width="0dp"
                    android:layout_height="0.6dp"
                    android:layout_marginTop="5.4dp"
                    android:layout_marginHorizontal="?attr/OBannerDividerMarginHorizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/iv_active_memory_4"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.obric.memorydata.ui.custom.DeviceAdaptiveCardListItem
                android:id="@+id/active_text_memory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/active_memory_tip_4"
                app:ocardlistitem_title="@string/memory_settings_active_memory_text"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.ONestedScrollView>
    <View
        android:layout_gravity="top"
        android:id="@+id/cut_off"
        android:background="@color/oui_basic_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="96dp"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_centerTitle="@string/memory_settings_active_memory_title"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</FrameLayout>
