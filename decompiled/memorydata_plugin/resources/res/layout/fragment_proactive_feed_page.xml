<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.aiproactive.ui.widget.VerticalNestedScrollableHost
        android:id="@+id/nested_host"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/app_bar"
                android:background="@android:color/transparent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="0dp"
                app:elevation="0dp">
                <com.google.android.material.appbar.CollapsingToolbarLayout
                    android:id="@+id/collapsing_toolbar"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    app:layout_scrollFlags="exitUntilCollapsed|scroll">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/avatar_container"
                        android:paddingBottom="32dp"
                        android:visibility="gone"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="90dp"
                        app:layout_collapseMode="parallax">
                        <Space
                            android:id="@+id/video_placeholder"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:layout_marginTop="220dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <com.obric.aiproactive.ui.widget.GradientTextView
                            android:textSize="20sp"
                            android:textColor="@color/ai_proactive_demo_text_secondary"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:id="@+id/tv_avatar_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="32dp"
                            android:text="休眠中"
                            android:maxLines="1"
                            android:lineSpacingExtra="0sp"
                            android:layout_marginHorizontal="24dp"
                            android:textFontWeight="500"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/video_placeholder"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/ai_proactive_demo_text_tertiary"
                            android:gravity="center"
                            android:id="@+id/tv_avatar_subtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="唤醒后，豆包会主动理解你的当前情境，并在恰当时间给出你当下最需要关注的内容。"
                            android:layout_marginHorizontal="36dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_avatar_title"/>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:id="@+id/ll_single_event"
                            android:visibility="gone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:layout_marginStart="24dp"
                            android:layout_marginEnd="24dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_avatar_title">
                            <LinearLayout
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <TextSwitcher
                                    android:gravity="center"
                                    android:id="@+id/ts_single_event"
                                    android:layout_width="wrap_content"
                                    android:layout_height="18dp"/>
                                <ImageView
                                    android:layout_gravity="center_vertical"
                                    android:id="@+id/iv_single_event_direction"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/o_section_titlebar_tail_icon_arrow"
                                    android:contentDescription="@null"
                                    android:layout_marginStart="0dp"/>
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.appbar.CollapsingToolbarLayout>
            </com.google.android.material.appbar.AppBarLayout>
            <com.obric.oui.orecyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="always"
                app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
            <com.obric.aiproactive.ui.widget.FixedFocusOverlayLayout
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <View
                    android:id="@+id/top_cut_off"
                    android:background="@drawable/bg_proactive_history_overlay"
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="132dp"
                    android:alpha="0"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.obric.oui.blur.OBlurMaskView
                    android:id="@+id/top_blur_view"
                    android:visibility="visible"
                    android:layout_width="0dp"
                    android:layout_height="132dp"
                    android:alpha="0"
                    android:elevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:oBlurMask_blurRadius="72"
                    app:oBlurMask_defaultMaskBackground="false"
                    app:oBlurMask_statusBarImmersion="true"/>
                <com.obric.aiproactive.ui.widget.ProactiveAvatarView
                    android:id="@+id/video_container"
                    android:background="@drawable/bg_ai_proactive_avatar_container"
                    android:visibility="gone"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginTop="220dp"
                    android:translationZ="0dp"
                    android:elevation="0dp"
                    android:clipToOutline="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.obric.aiproactive.ui.util.ProactiveTopBarIconButton
                    android:id="@+id/btn_history_container"
                    android:visibility="gone"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="56dp"
                    android:contentDescription="历史"
                    android:layout_marginEnd="64dp"
                    app:iconSize="22dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:oui_widgetIcon="@drawable/oui_icon_oic_clock"
                    style="@style/Widget.ProactiveUi.TopBarFloatingButton"/>
                <com.obric.aiproactive.ui.util.ProactiveTopBarIconButton
                    android:id="@+id/btn_more_container"
                    android:visibility="gone"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="56dp"
                    android:contentDescription="更多"
                    android:layout_marginEnd="12dp"
                    app:iconSize="22dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:oui_widgetIcon="@drawable/oui_icon_oic_ellipsis_3"
                    style="@style/Widget.ProactiveUi.TopBarFloatingButton"/>
                <View
                    android:id="@+id/requirement_composer_backdrop"
                    android:background="@drawable/bg_proactive_sticky_overlay"
                    android:focusable="false"
                    android:visibility="gone"
                    android:clickable="false"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/ai_proactive_requirement_composer_backdrop_default_height"
                    android:importantForAccessibility="no"
                    android:elevation="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/ai_proactive_demo_text_secondary"
                    android:id="@+id/tv_user_requirement_voice_tip"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/ai_proactive_voice_release_to_send"
                    android:fontFamily="Olasans-sc-compact"
                    app:layout_constraintBottom_toTopOf="@+id/requirement_composer_container"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                <com.obric.aiproactive.ui.widget.RequirementComposerSurface
                    android:id="@+id/requirement_composer_container"
                    android:visibility="gone"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ai_proactive_requirement_composer_bottom_margin"
                    android:minHeight="@dimen/ai_proactive_requirement_composer_min_height"
                    android:layout_marginStart="@dimen/ai_proactive_requirement_composer_horizontal_margin"
                    android:layout_marginEnd="@dimen/ai_proactive_requirement_composer_horizontal_margin"
                    android:elevation="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:oui_radius="@dimen/ai_proactive_requirement_composer_radius"
                    style="@style/Widget_ProactiveUi_RequirementComposer">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:background="@android:color/transparent"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/ai_proactive_requirement_composer_min_height"
                        android:paddingStart="@dimen/ai_proactive_requirement_composer_text_start"
                        android:paddingEnd="@dimen/ai_proactive_requirement_send_end_margin">
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/user_requirement_content_column"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ai_proactive_requirement_composer_content_vertical_padding"
                            android:layout_marginBottom="@dimen/ai_proactive_requirement_composer_content_vertical_padding"
                            android:layout_marginEnd="@dimen/ai_proactive_requirement_content_send_gap"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/btn_user_requirement_send"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">
                            <com.obric.oui.forms.OInputLayout
                                android:id="@+id/input_user_requirement"
                                android:background="@android:color/transparent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="4"
                                app:oinput_maxHeight="88dp"
                                app:oinput_minHeight="22dp"
                                app:oinput_showClear="false"
                                app:oinput_showInputBackground="false"
                                app:oinput_showLabel="false"
                                app:oinput_type="1"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/ai_proactive_demo_text_primary"
                            android:gravity="center"
                            android:id="@+id/tv_user_requirement_voice_hold"
                            android:visibility="gone"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:text="@string/ai_proactive_voice_hold_to_talk"
                            android:fontFamily="Olasans-sc-compact"
                            android:letterSpacing="0"
                            android:textFontWeight="600"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <com.obric.aiproactive.ui.widget.RequirementVoiceVisualizerView
                            android:id="@+id/voice_requirement_visualizer"
                            android:visibility="gone"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/ai_proactive_requirement_voice_visualizer_height"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <com.obric.oui.button.OIconButton
                            android:id="@+id/btn_user_requirement_send"
                            android:padding="@dimen/ai_proactive_requirement_send_icon_padding"
                            android:layout_width="@dimen/ai_proactive_requirement_send_size"
                            android:layout_height="@dimen/ai_proactive_requirement_send_size"
                            android:layout_marginBottom="@dimen/ai_proactive_requirement_send_bottom_margin"
                            android:src="@drawable/ic_ai_proactive_requirement_send"
                            android:contentDescription="@string/ai_proactive_user_requirement_send"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            style="@style/OStyleV2.OIconButton.S.Standard.Primary"/>
                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/btn_user_requirement_input_mode"
                            android:background="@null"
                            android:padding="4dp"
                            android:layout_width="@dimen/ai_proactive_requirement_send_size"
                            android:layout_height="@dimen/ai_proactive_requirement_send_size"
                            android:layout_marginBottom="@dimen/ai_proactive_requirement_send_bottom_margin"
                            android:src="@drawable/ic_ai_proactive_voice_input"
                            android:scaleType="centerInside"
                            android:contentDescription="@string/ai_proactive_voice_switch_to_voice"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>
                        <ImageView
                            android:id="@+id/iv_user_requirement_sending"
                            android:visibility="gone"
                            android:layout_width="@dimen/ai_proactive_requirement_send_icon_size"
                            android:layout_height="@dimen/ai_proactive_requirement_send_icon_size"
                            android:src="@drawable/o_ic_progress_processing"
                            android:contentDescription="@null"
                            app:layout_constraintBottom_toBottomOf="@+id/btn_user_requirement_send"
                            app:layout_constraintEnd_toEndOf="@+id/btn_user_requirement_send"
                            app:layout_constraintStart_toStartOf="@+id/btn_user_requirement_send"
                            app:layout_constraintTop_toTopOf="@+id/btn_user_requirement_send"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.obric.aiproactive.ui.widget.RequirementComposerSurface>
                <com.obric.oui.button.OButton
                    android:id="@+id/btn_wake_up"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="74dp"
                    android:text="唤醒豆包"
                    android:layout_marginHorizontal="105dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    style="@style/OStyleV2.OButton.S.Standard.Primary"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/ai_proactive_demo_text_secondary"
                    android:id="@+id/tv_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/proactive_loading"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/empty_container"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:id="@+id/iv_empty"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_proactive_app_icon"
                        app:layout_constraintBottom_toTopOf="@+id/tv_empty_title"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed"/>
                    <TextView
                        android:textSize="20sp"
                        android:textColor="@color/ai_proactive_demo_text_secondary"
                        android:id="@+id/tv_empty_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/proactive_empty_title"
                        android:textAlignment="center"
                        android:lineHeight="26dp"
                        android:textFontWeight="500"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/iv_empty"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/ai_proactive_demo_text_tertiary"
                        android:id="@+id/tv_empty_subtitle_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/proactive_empty_subtitle_line1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_empty_title"/>
                    <com.obric.oui.button.OButton
                        android:gravity="center"
                        android:id="@+id/btn_empty_history"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="20dp"
                        android:text="@string/proactive_empty_action_view_history"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_empty_subtitle_1"
                        style="@style/OStyleV2.OButton.S.Standard.Neutral"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.obric.aiproactive.ui.widget.FixedFocusOverlayLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </com.obric.aiproactive.ui.widget.VerticalNestedScrollableHost>
    <com.obric.aiproactive.ui.widget.RequirementVoiceOverlayView
        android:id="@+id/requirement_voice_overlay"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="noHideDescendants"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
