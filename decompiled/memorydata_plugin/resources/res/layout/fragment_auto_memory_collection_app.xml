<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:background="@color/oui_bg_base_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_gravity="top"
        android:id="@+id/cut_off"
        android:background="@color/oui_basic_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="96dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.obric.oui.titlebar.OFloatingTitleBar
            android:layout_gravity="top"
            android:id="@+id/title_bar"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/content_scroll"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/content_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="12dp">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/oui_text_3"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_rec_label"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:text="@string/memory_recommend_apps"
                        android:layout_weight="1"
                        android:textFontWeight="500"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/oui_blue_6"
                        android:gravity="center_vertical"
                        android:id="@+id/all_open"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:text="@string/memory_recommend_apps_all_open"
                        android:textFontWeight="500"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/card_rec_apps"
                    android:background="@drawable/bg_memory_card"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/oui_text_3"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_all_label"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_marginTop="22dp"
                    android:text="@string/memory_all_apps"
                    android:paddingStart="20dp"
                    android:textFontWeight="500"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/card_all_apps"
                    android:background="@drawable/bg_memory_card"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <FrameLayout
            android:id="@+id/bottom_bar"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <com.obric.oui.button.OButton
                android:gravity="center"
                android:id="@+id/save_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:textAllCaps="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                style="@style/OStyleV2.OButton.L.Standard.Primary"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
