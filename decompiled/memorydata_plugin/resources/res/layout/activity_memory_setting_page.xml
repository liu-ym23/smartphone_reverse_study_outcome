<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/header_linear_layout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/arrow_back_image_hot_area"
            android:layout_width="47dp"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp"
                app:srcCompat="@drawable/arrow_back"/>
        </FrameLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="16sp"
            android:textColor="#040a1a"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/memory_activity_memory_setting_page_text"/>
    </LinearLayout>
    <com.obric.oui.divider.ODivider
        android:id="@+id/divider_navigation"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toBottomOf="@+id/header_linear_layout"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textColor="#2761f2"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/memory_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Memory"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider_navigation"/>
    <FrameLayout
        android:id="@+id/switch_container_global_memory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@+id/memory_title">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="24sp"
            android:textColor="@color/TextPrimary"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/text_global_memory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/memory_activity_memory_setting_page_text_2"/>
        <com.obric.oui.oswitch.OSwitch
            android:layout_gravity="end|center_vertical"
            android:id="@+id/switch_global_memory"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="15sp"
        android:textColor="#737373"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/global_memory_swtich_desc_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:text="@string/memory_activity_memory_setting_page_text_3"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/switch_container_global_memory"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/global_memory_swtich_desc_text">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/sub_switch_linear_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="24dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="20sp"
                    android:textColor="#000000"
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/text_instant_entity_index"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/memory_activity_memory_setting_page_text_4"/>
                <com.obric.oui.oswitch.OSwitch
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/switch_instant_entity_index"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="20sp"
                    android:textColor="#000000"
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/text_on_screen_use_client_ocr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/memory_activity_memory_setting_page_text_5"/>
                <com.obric.oui.oswitch.OSwitch
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/switch_on_screen_use_client_ocr"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="20sp"
                    android:textColor="#000000"
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/text_personal_context_kg_app_use"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/memory_activity_memory_setting_page_text_6"/>
                <com.obric.oui.oswitch.OSwitch
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/switch_personal_context_kg_use"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"/>
            </FrameLayout>
            <FrameLayout
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="20sp"
                    android:textColor="#000000"
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/text_recommend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/memory_activity_memory_setting_page_text_7"/>
                <com.obric.oui.oswitch.OSwitch
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/switch_recommend"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
            <FrameLayout
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="20sp"
                    android:textColor="#000000"
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/text_recommend_tts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/memory_activity_memory_setting_page_text_8"/>
                <com.obric.oui.oswitch.OSwitch
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/switch_recommend_tts"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
