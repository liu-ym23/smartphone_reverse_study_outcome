<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xiphias.browser.scanner.ScannerContainerView
        android:id="@+id/scanner_page"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.xiphias.browser.scanner.util.AutoFitSurfaceView
            android:id="@+id/barcode_scanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.xiphias.browser.scanner.ScannerMaskView
            android:id="@+id/scanner_mask"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.obric.oui.button.OIconButtonFloating
            android:layout_gravity="end|top"
            android:id="@+id/exit_barcode_scan"
            android:layout_marginTop="60dp"
            android:layout_marginEnd="@dimen/oui_dimen_12_dp"
            app:oui_widgetIcon="@drawable/osui_ic_cross"
            app:oui_widgetMaterialSrcType="backdrop_window"
            app:oui_widgetTintColor="@color/white"
            style="@style/OStyleV2.OButtonFloating.S.Standard.Icon.ForceDark"/>
        <HorizontalScrollView
            android:layout_gravity="bottom"
            android:id="@+id/scanner_mode_scroll"
            android:visibility="gone"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="116dp"
            android:fillViewport="true">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/scanner_mode_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <Button
                    android:id="@+id/mode_barcode"
                    android:text="@string/scanner_mode_barcode"
                    style="@style/ScannerModeButton"/>
                <Button
                    android:id="@+id/mode_document"
                    android:text="@string/scanner_mode_document"
                    style="@style/ScannerModeButton"/>
                <Button
                    android:id="@+id/mode_general"
                    android:text="@string/scanner_mode_general"
                    style="@style/ScannerModeButton"/>
                <Button
                    android:id="@+id/mode_question"
                    android:text="@string/scanner_mode_question"
                    style="@style/ScannerModeButton"/>
                <Button
                    android:id="@+id/mode_translate"
                    android:text="@string/scanner_mode_translate"
                    style="@style/ScannerModeButton"/>
                <Button
                    android:id="@+id/mode_extract_text"
                    android:text="@string/scanner_mode_extract_text"
                    style="@style/ScannerModeButton"/>
                <Button
                    android:id="@+id/mode_goods"
                    android:text="@string/scanner_mode_goods"
                    style="@style/ScannerModeButton"/>
            </LinearLayout>
        </HorizontalScrollView>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="bottom"
            android:id="@+id/scanner_action_container"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/oui_title_bar_height"
            android:paddingStart="@dimen/osui_dimen_48_dp"
            android:paddingEnd="@dimen/osui_dimen_48_dp">
            <com.obric.oui.button.OIconButtonFloating
                android:id="@+id/select_picture"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:oui_widgetIcon="@drawable/osui_ic_select_picture"
                app:oui_widgetMaterialSrcType="backdrop_window"
                app:oui_widgetTintColor="@color/white"
                style="@style/OStyleV2.OButtonFloating.M.Standard.Icon.ForceDark"/>
            <View
                android:id="@+id/capture_visual_search"
                android:background="@drawable/aiscan_shutter"
                android:visibility="gone"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@string/vision_capture"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.obric.oui.button.OIconButtonFloating
                android:id="@+id/toggle_flashlight"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:oui_widgetMaterialSrcType="backdrop_window"
                app:oui_widgetTintColor="@color/white"
                style="@style/OStyleV2.OButtonFloating.M.Standard.Icon.ForceDark"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.xiphias.browser.scanner.ScannerContainerView>
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_on_dark_text_1"
        android:id="@+id/barcode_scan_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/same_network_hint"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.68"
        style="@style/ScannerHintText"/>
    <com.xiphias.browser.scanner.ScannerContainerView
        android:id="@+id/inactive_page"
        android:background="@color/black"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="12.5sp"
            android:textColor="@color/oui_on_dark_text_1"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wake_up_screen"
            android:drawablePadding="28dp"
            android:textAlignment="center"
            app:drawableTopCompat="@drawable/osui_ic_scan_inactive"/>
    </com.xiphias.browser.scanner.ScannerContainerView>
</androidx.constraintlayout.widget.ConstraintLayout>
