<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.obric.oui.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager_memory"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.obric.oui.actionbar.v2.OBottomActionBarFloating
            android:layout_gravity="bottom"
            android:id="@+id/memory_operation_container"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/OStyleV2.OBottomActionBar.Floating">
            <com.obric.oui.button.OButtonFloating
                android:layout_gravity="center"
                android:id="@+id/memory_delete"
                app:oui_widgetText="@string/memory_card_menu_delete_text"
                app:oui_widgetTextColor="@color/oui_dark_functional_red_6"
                style="@style/OStyleV2.OButtonFloating.M.PrimaryLight.Text"/>
        </com.obric.oui.actionbar.v2.OBottomActionBarFloating>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/cut_off"
        android:background="@color/oui_basic_bg_base_1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.obric.oui.blur.OBlurMaskView
        android:id="@+id/title_bar_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:oBlurMask_blurRadius="72"
        app:oBlurMask_defaultMaskBackground="true"
        app:oBlurMask_statusBarImmersion="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/title_bar_layout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.titlebar.OFloatingTitleBar
                    android:id="@+id/view_title_normal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:oFloatingTitleBar_enableFloatingTransition="true"/>
            </FrameLayout>
            <com.obric.oui.layout.OUILinearLayout
                android:orientation="horizontal"
                android:id="@+id/source_filter_group"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="12dp">
                <com.obric.oui.button.OIconButtonFloating
                    android:id="@+id/btn_source_filter"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="12dp"
                    app:oui_widgetEnableMaterial="true"
                    app:oui_widgetIcon="@drawable/o_ic_tablayout_leading"
                    app:oui_widgetMaterial="@string/oui_material_bg_floating_fill"
                    app:oui_widgetPaddingB="6dp"
                    app:oui_widgetPaddingL="6dp"
                    app:oui_widgetPaddingR="6dp"
                    app:oui_widgetPaddingT="6dp"
                    app:oui_widgetRadius="16dp"/>
                <com.obric.oui.tab.OTabLayout
                    android:id="@+id/rv_source_filter"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:tabGravity="fill"
                    app:tabMode="scrollable"
                    style="@style/MemoryOTabTextV2NoBackgroundChipsTab"/>
            </com.obric.oui.layout.OUILinearLayout>
        </LinearLayout>
    </com.obric.oui.blur.OBlurMaskView>
</androidx.constraintlayout.widget.ConstraintLayout>
