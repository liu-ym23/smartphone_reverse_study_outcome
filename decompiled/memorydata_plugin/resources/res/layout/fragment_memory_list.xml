<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_empty"
        android:visibility="gone"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.obric.oui.text.OTextView
            android:textSize="20sp"
            android:textColor="@color/oui_basic_text_3b"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="26sp"
            android:text="@string/smart_memory_no_data_title"
            android:textFontWeight="500"/>
        <com.obric.oui.text.OTextView
            android:textSize="14sp"
            android:textColor="@color/oui_basic_text_3b"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="18sp"
            android:layout_marginTop="8dp"
            android:text="@string/smart_memory_no_data_description"
            android:textFontWeight="400"/>
    </LinearLayout>
    <com.obric.oui.orecyclerview.widget.RecyclerView
        android:id="@+id/rv_memory_list"
        android:paddingTop="148dp"
        android:paddingBottom="92dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="12dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
