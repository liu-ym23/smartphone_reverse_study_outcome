<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_dark_basic_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/img_guided_bg"
        android:layout_width="0dp"
        android:layout_height="202dp"
        android:src="@drawable/img_guided_preference_interview_bg"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_guided_bg_scrim"
        android:background="@drawable/bg_guided_preference_interview_scrim"
        android:layout_width="0dp"
        android:layout_height="202dp"
        app:layout_constraintEnd_toEndOf="@+id/img_guided_bg"
        app:layout_constraintStart_toStartOf="@+id/img_guided_bg"
        app:layout_constraintTop_toTopOf="@+id/img_guided_bg"/>
    <com.obric.oui.bouncelayout.ONestedScrollView
        android:id="@+id/scroll_guided_content"
        android:paddingTop="152dp"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:overScrollMode="always"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/layout_guided_scroll_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_guided_topbar"
                android:background="@drawable/bg_guided_preference_topbar"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/oui_dark_basic_text_1"
                    android:id="@+id/tv_guided_progress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="24sp"
                    android:textColor="@color/oui_dark_basic_text_0"
                    android:id="@+id/tv_guided_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_guided_progress"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/oui_dark_basic_text_3b"
                    android:id="@+id/tv_guided_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_guided_title"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <FrameLayout
                android:id="@+id/layout_guided_option_group"
                android:background="@drawable/bg_guided_preference_option_group"
                android:padding="8dp"
                android:layout_width="336dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">
                <com.obric.oui.orecyclerview.widget.RecyclerView
                    android:id="@+id/rv_guided_options"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:nestedScrollingEnabled="false"/>
            </FrameLayout>
        </LinearLayout>
    </com.obric.oui.bouncelayout.ONestedScrollView>
    <com.obric.oui.blur.OBlurMaskView
        android:id="@+id/view_guided_keyboard_blur"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="@dimen/guided_preference_keyboard_mask_height"
        android:alpha="0"
        app:layout_constraintEnd_toEndOf="@+id/img_guided_bg"
        app:layout_constraintStart_toStartOf="@+id/img_guided_bg"
        app:layout_constraintTop_toTopOf="@+id/img_guided_bg"
        app:oBlurMask_blurRadius="40"
        app:oBlurMask_defaultMaskBackground="false"
        app:oBlurMask_statusBarImmersion="true"
        app:oui_widgetBlurBlendModes="@array/oui_titlebar_blur_blend_modes_dark"
        app:oui_widgetBlurColors="@array/oui_titlebar_blur_colors_dark"/>
    <com.obric.oui.button.OButton
        android:id="@+id/btn_guided_primary"
        android:layout_width="150dp"
        android:layout_height="48dp"
        android:layout_marginBottom="31dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/OStyleV2.OButton.L.Standard.Primary"/>
    <com.obric.aiproactive.ui.util.ProactiveTopBarIconButton
        android:id="@+id/btn_guided_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:contentDescription="返回"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:oui_widgetIcon="@drawable/ic_guided_preference_back"
        style="@style/Widget.ProactiveUi.GuidedInterviewImageButton"/>
    <com.obric.aiproactive.ui.util.ProactiveTopBarIconButton
        android:id="@+id/btn_guided_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:contentDescription="关闭"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:oui_widgetIcon="@drawable/ic_guided_preference_close"
        style="@style/Widget.ProactiveUi.GuidedInterviewImageButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
