<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_container"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="96dp"
        android:fillViewport="true"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/item_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:textSize="20sp"
        android:textColor="@color/oui_basic_text_3"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/empty_text"
        android:visibility="gone"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="392dp"
        android:text="@string/memory_info_section_empty_scene"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/scene_container"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="96dp">
        <FrameLayout
            android:id="@+id/desc_input_layer"
            android:layout_width="match_parent"
            android:layout_height="274dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">
            <com.obric.oui.forms.OInputLayout
                android:id="@+id/desc_input"
                android:background="@drawable/bg_memory_card"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:oinput_autoChangeWithLimit="true"
                app:oinput_limitCount="2000"
                app:oinput_showClear="false"
                app:oinput_showInputBackground="false"
                app:oinput_showLabel="false"
                app:oinput_showLimit="true"/>
        </FrameLayout>
    </LinearLayout>
    <View
        android:layout_gravity="top"
        android:id="@+id/cut_off"
        android:background="@color/oui_basic_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="96dp"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</FrameLayout>
