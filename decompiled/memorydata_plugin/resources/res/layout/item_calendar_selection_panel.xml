<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="28dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_todo"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/ic_calendar_todo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_event"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="1dp"
            android:src="@drawable/ic_calendar_event"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toStartOf="@+id/checkbox_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.obric.oui.text.OTextView
            android:textSize="16sp"
            android:textColor="@color/oui_basic_text_1"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:lineHeight="21sp"
            android:textFontWeight="400"/>
        <com.obric.oui.text.OTextView
            android:textSize="12sp"
            android:textColor="@color/oui_basic_text_3"
            android:id="@+id/tv_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="28dp"
            android:lineHeight="16sp"
            android:textFontWeight="400"/>
        <com.obric.oui.text.OTextView
            android:textSize="12sp"
            android:textColor="@color/oui_basic_text_3"
            android:id="@+id/tv_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="28dp"
            android:lineHeight="16dp"
            android:textFontWeight="400"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/checkbox_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.obric.oui.checkbox.OCheckBox
            android:id="@+id/o_checkbox"
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:oui_checkedState="unchecked"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
