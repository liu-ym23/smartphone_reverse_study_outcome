<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_proactive_card_now"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp">
    <FrameLayout
        android:id="@+id/fl_badge"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="26dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="24sp"
            android:textColor="@color/ai_proactive_demo_text_primary"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_badge_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_badge_icon"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"/>
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textColor="@color/ai_proactive_demo_text_primary"
        android:id="@+id/tv_content"
        android:clickable="true"
        android:longClickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/proactive_card_content_gap"
        android:lineSpacingExtra="6dp"
        android:textIsSelectable="true"
        android:textFontWeight="500"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_badge"/>
    <FrameLayout
        android:id="@+id/content_slot"
        android:background="@color/ai_proactive_demo_action_bg"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/proactive_card_content_gap"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="13sp"
            android:textColor="@color/ai_proactive_demo_text_secondary"
            android:id="@+id/tv_subtitle"
            android:clickable="true"
            android:longClickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textIsSelectable="true"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_artifacts"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/proactive_card_content_gap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content_slot"/>
    <LinearLayout
        android:gravity="start"
        android:orientation="vertical"
        android:id="@+id/ll_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/proactive_card_content_gap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_artifacts">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_action_items"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.obric.oui.button.OButton
            android:gravity="center"
            android:id="@+id/btn_ignore"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/proactive_action_button_height"
            android:layout_marginTop="@dimen/proactive_action_button_gap"
            android:text="忽略"
            app:oui_radius="@dimen/proactive_action_button_radius"
            style="@style/OStyleV2.OButton.M.Standard.Neutral"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
