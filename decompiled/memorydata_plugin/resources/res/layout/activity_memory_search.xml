<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_empty"
            android:visibility="gone"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.obric.oui.text.OTextView
                android:textSize="18sp"
                android:textColor="@color/oui_basic_text_3b"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/memory_search_no_data_title"
                android:lineHeight="24sp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/layout_loading"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.obric.oui.progress.ODownloadProgressView
                android:layout_gravity="center_vertical"
                android:id="@+id/progress_view_processing_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:oui_progress_view_size="small"
                app:oui_progressing_action_color="@color/oui_text_3"/>
            <com.obric.oui.text.OTextView
                android:textSize="18sp"
                android:textColor="@color/oui_basic_text_3b"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/memory_searching_title"
                android:layout_marginStart="4dp"
                android:lineHeight="24sp"
                android:textFontWeight="480"/>
        </LinearLayout>
        <com.obric.oui.orecyclerview.widget.RecyclerView
            android:id="@+id/rv_memory_list"
            android:paddingTop="112dp"
            android:paddingBottom="40dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="12dp"/>
        <com.obric.oui.actionbar.v2.OBottomActionBarFloating
            android:layout_gravity="bottom"
            android:id="@+id/memory_operation_container"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/OStyleV2.OBottomActionBar.Floating">
            <com.obric.oui.button.OButtonFloating
                android:layout_gravity="center"
                android:id="@+id/memory_delete"
                app:oui_widgetText="@string/memory_card_menu_delete_text"
                app:oui_widgetTextColor="@color/oui_dark_functional_red_6"
                style="@style/OStyleV2.OButtonFloating.M.PrimaryLight.Text"/>
        </com.obric.oui.actionbar.v2.OBottomActionBarFloating>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/cut_off"
        android:background="@color/oui_basic_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="96dp"/>
    <FrameLayout
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.obric.oui.blur.OBlurMaskView
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:oBlurMask_blurRadius="8"
            app:oBlurMask_defaultMaskBackground="true"
            app:oBlurMask_statusBarImmersion="true">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/search_header_container"
                android:paddingTop="8dp"
                android:paddingBottom="12dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/memory_search_bar_container"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp">
                    <com.obric.oui.searchbar.v2.OSearchBar
                        android:id="@+id/memory_search_bar"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        style="@style/OStyleV2.OSearchBar.Default.S">
                        <requestFocus/>
                    </com.obric.oui.searchbar.v2.OSearchBar>
                    <com.obric.oui.button.OIconButtonFloating
                        android:id="@+id/memory_search_cancel"
                        android:layout_marginLeft="8dp"
                        app:oui_widgetIcon="@drawable/o_floating_title_bar_icon_close"
                        style="@style/OStyleV2.OButtonFloating.S.Standard.Icon"/>
                </LinearLayout>
                <com.obric.oui.layout.OUILinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/search_tab_group"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginHorizontal="12dp">
                    <com.obric.oui.tab.OTabLayout
                        android:id="@+id/search_tab_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:tabGravity="fill"
                        app:tabMode="scrollable"
                        style="@style/MemoryOTabTextV2NoBackgroundChipsTab"/>
                </com.obric.oui.layout.OUILinearLayout>
            </LinearLayout>
        </com.obric.oui.blur.OBlurMaskView>
        <com.obric.oui.titlebar.OFloatingTitleBar
            android:id="@+id/view_title_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:oFloatingTitleBar_maskBlurRadius="8"
            app:oFloatingTitleBar_statusBarImmersion="true"/>
    </FrameLayout>
</FrameLayout>
