<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_proactive_tip"
    android:paddingTop="16dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="14dp"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:layout_marginStart="@dimen/proactive_page_horizontal_padding"
    android:layout_marginEnd="@dimen/proactive_page_horizontal_padding">
    <ImageView
        android:id="@+id/iv_tip"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_proactive_info"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/proactive_text_secondary"
        android:id="@+id/tv_tip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/proactive_tip"
        android:singleLine="false"
        android:layout_marginStart="8dp"
        android:lineHeight="21sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_tip"
        app:layout_constraintTop_toTopOf="@+id/iv_tip"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#007aff"
        android:id="@+id/btn_known"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/proactive_known"
        android:textFontWeight="500"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_tip"/>
</androidx.constraintlayout.widget.ConstraintLayout>
