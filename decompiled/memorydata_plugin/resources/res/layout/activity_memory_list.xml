<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/memory_tab_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/cut_off_bottom"
        android:background="@color/oui_basic_bg_base_1"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <com.obric.oui.segmentedtab.OBottomNavigationBar
        android:layout_gravity="center_horizontal"
        android:id="@+id/memory_container_tab_view"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:bar_color="@color/oui_basic_bg_base_3_high_elevation"
        app:bar_stroke_color="@color/Transparent"
        app:divider_color="@android:color/transparent"
        app:indicator_anim_enable="true"
        app:indicator_color="@color/oui_fill_element_2"
        app:indicator_corner_radius="@dimen/oui_r_m2"
        app:indicator_height="56dp"
        app:indicator_spacing="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:oui_widgetBlurRadius="5"
        app:shadow_normal="@style/OStyleV2.OButtonFloatingShadowStyleNormal"
        app:shadow_pressed="@style/OStyleV2.OButtonFloatingShadowStylePressed"
        app:tab_textSelectColor="@color/oui_text_1"
        app:tab_textUnselectColor="@color/oui_text_3b"/>
    <com.obric.oui.titlebar.OFloatingTitleBarActionHost
        android:id="@+id/floating_title_bar_action_host"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
