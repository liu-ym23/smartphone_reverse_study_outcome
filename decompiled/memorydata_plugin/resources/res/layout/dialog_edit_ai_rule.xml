<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/simple_form_body_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="280dp"
                app:cardBackgroundColor="@color/ai_proactive_demo_action_bg"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">
                <com.obric.oui.forms.OInputLayout
                    android:id="@+id/edit_rule_input"
                    android:scrollbars="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:oinput_showClear="true"
                    app:oui_inputMode="text"
                    app:oui_inputSingleLine="false"
                    app:oui_showLabel="false"/>
            </androidx.cardview.widget.CardView>
            <TextView
                android:textSize="10sp"
                android:textColor="#ff3333"
                android:gravity="start"
                android:id="@+id/tv_over_limit_warning"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="已超过100字数限制，请修改"
                android:paddingHorizontal="12dp"/>
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/simple_form_footer_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">
            <com.obric.oui.button.OButton
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="取消"
                android:layout_weight="1"
                style="@style/OStyleV2.OButton.L.Standard.Neutral"/>
            <com.obric.oui.button.OButton
                android:id="@+id/btn_confirm"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:text="确认"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                style="@style/OStyleV2.OButton.L.Standard.Primary_Light"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
