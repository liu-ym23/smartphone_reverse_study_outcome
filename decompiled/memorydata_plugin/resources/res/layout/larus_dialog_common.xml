<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@drawable/larus_bg_round_full"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/dp_18"
        android:textColor="@color/larus_neutral_100"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/dp_20"
        android:layout_marginEnd="@dimen/dp_20"
        android:textFontWeight="600"/>
    <TextView
        android:textSize="@dimen/dp_15"
        android:textColor="@color/larus_neutral_70"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/dp_20"
        android:layout_marginEnd="@dimen/dp_20"
        android:textFontWeight="400"/>
    <View
        android:background="@drawable/larus_item_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0_5"
        android:layout_marginTop="@dimen/dp_24"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48">
        <TextView
            android:textSize="@dimen/dp_16"
            android:textColor="@color/larus_neutral_100"
            android:gravity="center"
            android:id="@+id/cancel"
            android:background="@drawable/larus_bg_leftdown_selector"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="@string/larus_bot_profile_pic_crop_cancel"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="400"/>
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/divider"
            android:background="@drawable/larus_item_divider"
            android:layout_width="@dimen/dp_0_5"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="@dimen/dp_16"
            android:textColor="@color/larus_neutral_100"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/confirm"
            android:background="@drawable/larus_bg_rightdown_selector"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="@string/larus_bot_profile_pic_crop_save"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textFontWeight="500"/>
    </LinearLayout>
</LinearLayout>
