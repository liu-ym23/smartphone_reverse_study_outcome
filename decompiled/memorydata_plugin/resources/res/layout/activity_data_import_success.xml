<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_center_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="178dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/iv_status_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_transfer_success"/>
            <com.obric.oui.text.OTextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/oui_basic_text_1"
                android:gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/memory_data_transfer_success_import_title"
                android:layout_marginHorizontal="24dp"/>
            <com.obric.oui.text.OTextView
                android:textSize="14sp"
                android:textColor="@color/oui_basic_text_1"
                android:gravity="center"
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/memory_data_transfer_success_import_subtitle"
                android:layout_marginHorizontal="24dp"/>
        </LinearLayout>
        <com.obric.oui.button.OButton
            android:id="@+id/btn_action"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginBottom="24dp"
            android:text="@string/memory_activity_data_import_success_text"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/OStyleV2.OButton.L.Standard.Primary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
