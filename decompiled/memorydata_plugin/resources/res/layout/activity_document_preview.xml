<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.OScrollView
        android:id="@+id/scroll_markdown"
        android:paddingTop="@dimen/proactive_document_preview_top_inset"
        android:paddingBottom="@dimen/proactive_document_preview_bottom_inset"
        android:visibility="gone"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="always">
        <com.larus.business.markdown.impl.markwon.MarkdownTextView
            android:textSize="16sp"
            android:textColor="@color/oui_basic_text_1"
            android:id="@+id/tv_markdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:lineSpacingExtra="6dp"
            android:layout_marginHorizontal="@dimen/proactive_document_preview_horizontal_padding"/>
    </com.obric.oui.bouncelayout.OScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_html"
        android:paddingTop="@dimen/proactive_document_preview_top_inset"
        android:paddingBottom="@dimen/proactive_document_preview_bottom_inset"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.obric.oui.text.OTextView
            android:textColor="@color/oui_basic_text_3"
            android:id="@+id/tv_html_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/proactive_document_preview_html_notice"
            android:layout_marginHorizontal="@dimen/proactive_document_preview_horizontal_padding"
            style="@style/Label_M_Thin"/>
        <WebView
            android:id="@+id/web_html"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:importantForAutofill="noExcludeDescendants"/>
    </LinearLayout>
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_basic_text_3"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/proactive_document_preview_loading"
        android:layout_marginHorizontal="32dp"
        style="@style/Label_M_Thin"/>
    <com.obric.oui.button.OButton
        android:layout_gravity="bottom"
        android:id="@+id/btn_open_external"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="24dp"
        android:text="@string/proactive_document_preview_open_external"
        android:layout_marginHorizontal="@dimen/proactive_document_preview_horizontal_padding"
        style="@style/OStyleV2.OButton.M.Standard.Neutral"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</FrameLayout>
