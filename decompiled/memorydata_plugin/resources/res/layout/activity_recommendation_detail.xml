<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/fl_scroll_container"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.obric.oui.bouncelayout.ONestedScrollView
            android:id="@+id/scroll_content"
            android:paddingTop="96dp"
            android:paddingBottom="40dp"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="ifContentScrolls">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_scrollable_content"
                android:paddingTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/bg_ai_proactive_demo_detail_main_card"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">
                    <FrameLayout
                        android:id="@+id/fl_detail_badge"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="26dp">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="24sp"
                            android:textColor="@color/ai_proactive_demo_text_primary"
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/tv_detail_badge_emoji"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"/>
                        <ImageView
                            android:layout_gravity="center"
                            android:id="@+id/iv_detail_badge_icon"
                            android:visibility="gone"
                            android:layout_width="18dp"
                            android:layout_height="18dp"/>
                    </FrameLayout>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="16sp"
                        android:textColor="@color/ai_proactive_demo_text_primary"
                        android:id="@+id/tv_main"
                        android:clickable="true"
                        android:longClickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/proactive_card_content_gap"
                        android:lineSpacingExtra="2dp"
                        android:textIsSelectable="true"
                        android:textFontWeight="400"/>
                    <FrameLayout
                        android:id="@+id/fl_detail_slot"
                        android:background="@drawable/bg_proactive_detail_slot"
                        android:padding="10dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/proactive_card_content_gap"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_detail_artifacts"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/proactive_card_content_gap"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/ll_detail_action_items"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/card_meta"
                    android:background="@drawable/bg_ai_proactive_demo_detail_card"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingVertical="16dp">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/ai_proactive_demo_text_secondary"
                            android:id="@+id/tv_score_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/proactive_recommend_score"
                            android:textFontWeight="500"/>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/ai_proactive_demo_text_primary"
                            android:id="@+id/tv_score_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textFontWeight="500"/>
                    </LinearLayout>
                    <View
                        android:background="@color/ai_proactive_demo_line_subtle"
                        android:layout_width="1dp"
                        android:layout_height="match_parent"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/ai_proactive_demo_text_secondary"
                            android:id="@+id/tv_status_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/proactive_recommend_state"
                            android:textFontWeight="500"/>
                        <TextView
                            android:textSize="16sp"
                            android:textColor="@color/ai_proactive_demo_text_primary"
                            android:id="@+id/tv_status_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textFontWeight="500"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/card_reason"
                    android:background="@drawable/bg_ai_proactive_demo_detail_card"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <ImageView
                        android:visibility="gone"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_proactive_info"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/ai_proactive_demo_text_primary"
                        android:id="@+id/tv_reason_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/proactive_recommend_reason"
                        android:textFontWeight="400"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="14sp"
                        android:textColor="@color/ai_proactive_demo_text_secondary"
                        android:id="@+id/tv_reason_content"
                        android:clickable="true"
                        android:longClickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="2dp"
                        android:textIsSelectable="true"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/card_evidence"
                    android:background="@drawable/bg_ai_proactive_demo_detail_card"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <ImageView
                        android:visibility="gone"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/ic_proactive_info"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/ai_proactive_demo_text_primary"
                        android:id="@+id/tv_evidence_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/proactive_recommend_evidence"
                        android:textFontWeight="400"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="14sp"
                        android:textColor="@color/ai_proactive_demo_text_secondary"
                        android:id="@+id/tv_evidence_content"
                        android:clickable="true"
                        android:longClickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="2dp"
                        android:textIsSelectable="true"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_sources_group"
                    android:background="@drawable/bg_ai_proactive_demo_detail_card"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/ai_proactive_demo_text_primary"
                        android:id="@+id/tv_sources_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/proactive_data_source"
                        android:textFontWeight="400"/>
                    <HorizontalScrollView
                        android:id="@+id/hsv_sources"
                        android:scrollbars="none"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:overScrollMode="never">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@+id/ll_sources"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </HorizontalScrollView>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/card_value_rating"
                    android:background="@drawable/bg_ai_proactive_demo_detail_card"
                    android:padding="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/ai_proactive_demo_text_primary"
                        android:id="@+id/tv_value_rating_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/proactive_value_entry_title"
                        android:textFontWeight="400"/>
                    <com.obric.oui.tab.OTabLayout
                        android:id="@+id/value_quick_tabs"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="14dp"
                        app:tabGravity="fill"
                        app:tabMinWidth="0dp"
                        app:tabMode="fixed"
                        app:tabPaddingEnd="4dp"
                        app:tabPaddingStart="4dp"
                        style="@style/OTabTextV2.Background.Gray"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/ai_proactive_demo_text_tertiary"
                            android:gravity="center"
                            android:id="@+id/tv_value_rating_status"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:includeFontPadding="false"/>
                        <com.obric.oui.button.OButton
                            android:textSize="14sp"
                            android:id="@+id/btn_value_other"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="@string/proactive_value_input_other_action"
                            android:includeFontPadding="false"
                            style="@style/OStyleV2.OButton.S.Trans.Primary"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.obric.oui.bouncelayout.ONestedScrollView>
        <View
            android:layout_gravity="bottom"
            android:background="@drawable/bg_proactive_bottom_fade"
            android:layout_width="match_parent"
            android:layout_height="32dp"/>
    </FrameLayout>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</FrameLayout>
