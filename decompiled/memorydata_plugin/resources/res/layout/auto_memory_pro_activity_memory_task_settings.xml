<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.ONestedScrollView
        android:id="@+id/scroll_container"
        android:paddingBottom="@dimen/oui_h_title_bar_window"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="96dp"
        android:layout_marginBottom="88dp"
        android:fillViewport="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/oui_basic_text_3"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/memory_task_settings_section_name"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"
                android:layout_marginHorizontal="12dp"/>
            <FrameLayout
                android:background="@drawable/bg_memory_card"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp">
                <com.obric.oui.forms.OInputLayout
                    android:id="@+id/name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    app:oinput_hint="@string/memory_task_settings_name_hint"
                    app:oinput_showClear="false"
                    app:oinput_showInputBackground="false"
                    app:oinput_showLabel="false"
                    app:oinput_showLimit="false"/>
            </FrameLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/oui_basic_text_3"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/memory_task_settings_section_info"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"
                android:layout_marginHorizontal="12dp"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_payment_behavior"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_large"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/memory_task_settings_payment_behavior"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_payment_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_middle"
                app:ocardlistitem_cardType="type_large"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/memory_task_settings_payment_info"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_update_rule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_large"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/memory_task_settings_update_rule"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/oui_basic_text_3"
                android:id="@+id/label_display"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/memory_task_settings_section_display"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"
                android:layout_marginHorizontal="12dp"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_title_format"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_top"
                app:ocardlistitem_cardType="type_large"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/memory_task_settings_title_format"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_subtitle_format"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_bottom"
                app:ocardlistitem_cardType="type_large"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/memory_task_settings_subtitle_format"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/oui_basic_text_3"
                android:id="@+id/tv_client_model_section"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/memory_task_settings_section_debug"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"
                android:layout_marginHorizontal="12dp"/>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/item_use_client_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_normal"
                app:ocardlistitem_defaultCustomEnd="end_switch"
                app:ocardlistitem_showCustomEnd="true"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="false"
                app:ocardlistitem_showTailIcon="false"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_title="@string/memory_task_settings_use_client_model"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.ONestedScrollView>
    <View
        android:layout_gravity="top"
        android:id="@+id/cut_off"
        android:background="@color/oui_basic_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="96dp"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_centerTitle="@string/memory_task_settings_title"
        app:oFloatingTitleBar_enableFloatingTransition="true"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/bottom_bar"
        android:background="@color/oui_basic_bg_base_1"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <com.obric.oui.button.OButton
            android:gravity="center"
            android:id="@+id/btn_create"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/memory_create"
            android:textAllCaps="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            style="@style/OStyleV2.OButton.L.Standard.Primary"/>
        <com.obric.oui.progress.ODownloadProgressView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/create_progress"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="110dp"
            app:oui_progress_background_color="@color/oui_basic_line_2_dark_on_image"
            app:oui_progressing_action_color="@color/oui_dark_basic_text_0"/>
    </FrameLayout>
</FrameLayout>
