<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.viewpager2.widget.ViewPager2
        android:id="@+id/personal_fragment_container"
        android:padding="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/cut_off"
        android:background="@color/oui_basic_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.obric.oui.blur.OBlurMaskView
        android:id="@+id/title_bar_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:oBlurMask_blurRadius="72"
        app:oBlurMask_defaultMaskBackground="true"
        app:oBlurMask_statusBarImmersion="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/title_bar_layout"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.titlebar.OFloatingTitleBar
                    android:id="@+id/view_title_normal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:oFloatingTitleBar_enableFloatingTransition="true"/>
            </FrameLayout>
            <FrameLayout
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.layout.OUILinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/tags_container_collapse"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginHorizontal="12dp">
                    <com.obric.oui.tab.OTabLayout
                        android:id="@+id/memory_personal_tags_scrollable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:tabGravity="fill"
                        app:tabMode="scrollable"
                        style="@style/MemoryOTabTextV2NoBackgroundChipsTab"/>
                </com.obric.oui.layout.OUILinearLayout>
            </FrameLayout>
        </LinearLayout>
    </com.obric.oui.blur.OBlurMaskView>
    <com.obric.oui.actionbar.v2.OBottomActionBarFloating
        android:layout_gravity="bottom"
        android:id="@+id/memory_operation_container"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/OStyleV2.OBottomActionBar.Floating">
        <com.obric.oui.button.OButtonFloating
            android:layout_gravity="center"
            android:id="@+id/memory_delete"
            app:oui_widgetText="@string/memory_card_menu_delete_text"
            app:oui_widgetTextColor="@color/oui_dark_functional_red_6"
            style="@style/OStyleV2.OButtonFloating.M.PrimaryLight.Text"/>
    </com.obric.oui.actionbar.v2.OBottomActionBarFloating>
</androidx.constraintlayout.widget.ConstraintLayout>
