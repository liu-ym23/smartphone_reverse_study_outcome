<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/ll_root"
    android:background="@drawable/o_background_list_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:minHeight="64dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/iv_content_img"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_margin="16dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/cl_content_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:layout_weight="1"
        android:paddingVertical="@dimen/oui_g_list_item_2">
        <com.obric.oui.text.OTextView
            android:textStyle="bold"
            android:textColor="@color/oui_text_1"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_content_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="200dp"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Title_Title_M"/>
        <com.obric.oui.oswitch.OSwitch
            android:layout_gravity="center_vertical"
            android:id="@+id/enable_switch"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
