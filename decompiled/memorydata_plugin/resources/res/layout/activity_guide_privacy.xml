<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.ONestedScrollView
        android:id="@+id/guide_privacy_container"
        android:paddingTop="@dimen/oui_h_title_bar_window"
        android:paddingBottom="108dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_privacy_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="8dp"
                android:src="@drawable/screen_observation_guide_privacy_icon"/>
            <TextView
                android:textSize="24sp"
                android:textColor="@color/oui_basic_text_1"
                android:id="@+id/tv_privacy_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/screen_observation_guide_privacy_title"
                android:lineHeight="32sp"
                android:textFontWeight="500"/>
            <com.obric.oui.layout.OUILinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_privacy_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                app:oui_radius="20dp">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/list_item_first"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_top"
                    app:ocardlistitem_cardType="type_large"
                    app:ocardlistitem_icon="@drawable/screen_observation_guide_privacy_first_icon"
                    app:ocardlistitem_showIcon="true"
                    app:ocardlistitem_showSubTitle="true"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_subTitle="@string/screen_observation_guide_privacy_first_desc"
                    app:ocardlistitem_title="@string/screen_observation_guide_privacy_first_title"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/list_item_second"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_middle"
                    app:ocardlistitem_cardType="type_large"
                    app:ocardlistitem_icon="@drawable/screen_observation_guide_privacy_second_icon"
                    app:ocardlistitem_showIcon="true"
                    app:ocardlistitem_showSubTitle="true"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_subTitle="@string/screen_observation_guide_privacy_second_desc"
                    app:ocardlistitem_title="@string/screen_observation_guide_privacy_second_title"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/list_item_third"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_middle"
                    app:ocardlistitem_cardType="type_large"
                    app:ocardlistitem_icon="@drawable/screen_observation_guide_privacy_third_icon"
                    app:ocardlistitem_showIcon="true"
                    app:ocardlistitem_showSubTitle="true"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_subTitle="@string/screen_observation_guide_privacy_third_desc"
                    app:ocardlistitem_title="@string/screen_observation_guide_privacy_third_title"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/list_item_fourth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_bottom"
                    app:ocardlistitem_cardType="type_large"
                    app:ocardlistitem_icon="@drawable/screen_observation_guide_privacy_fourth_icon"
                    app:ocardlistitem_showIcon="true"
                    app:ocardlistitem_showSubTitle="true"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_subTitle="@string/screen_observation_guide_privacy_fourth_desc"
                    app:ocardlistitem_title="@string/screen_observation_guide_privacy_fourth_title"/>
            </com.obric.oui.layout.OUILinearLayout>
            <com.obric.oui.lisitem.OCardListItem
                android:id="@+id/privacy_policy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:ocardlistitem_cardPosition="position_single"
                app:ocardlistitem_cardType="type_large"
                app:ocardlistitem_defaultTailIcon="tail_arrow"
                app:ocardlistitem_showIcon="false"
                app:ocardlistitem_showSubTitle="true"
                app:ocardlistitem_showTailIcon="true"
                app:ocardlistitem_showTitle="true"
                app:ocardlistitem_subTitle="@string/screen_observation_guide_privacy_accept_tips_desc"
                app:ocardlistitem_title="@string/screen_observation_guide_privacy_accept_tips_title"/>
        </LinearLayout>
    </com.obric.oui.bouncelayout.ONestedScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:oFloatingTitleBar_maskBlurRadius="36"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <com.obric.oui.actionbar.v2.OBottomActionBarNormalHorizontal
        android:layout_gravity="bottom"
        android:id="@+id/bar_guide_next"
        android:background="@color/oui_basic_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"/>
</FrameLayout>
