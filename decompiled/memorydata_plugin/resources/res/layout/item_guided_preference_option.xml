<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp">
    <androidx.cardview.widget.CardView
        android:id="@+id/option_container"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/option_content"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="0dp"
            android:paddingEnd="0dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/option_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="4dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingEnd="8dp">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/oui_dark_basic_text_1"
                        android:id="@+id/tv_option_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/oui_dark_basic_text_3"
                        android:id="@+id/tv_option_description"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <com.obric.oui.checkbox.OCheckBox
                    android:layout_gravity="center_vertical"
                    android:id="@+id/cb_option"
                    android:padding="0dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:layout_marginEnd="9dp"
                    app:oui_checkBoxButton="@drawable/selector_guided_preference_checkbox"
                    app:oui_checkedState="unchecked"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_option_mark"
                    android:padding="0dp"
                    android:focusable="true"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="32dp"
                    android:layout_height="24dp"
                    android:src="@drawable/o_ic_radio_tick_checked"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:layout_marginEnd="9dp"/>
            </LinearLayout>
            <com.obric.aiproactive.ui.preference.GuidedPreferenceInputEditText
                android:textSize="16sp"
                android:textColor="#e5ffffff"
                android:textColorHint="#66ffffff"
                android:gravity="center_vertical"
                android:id="@+id/input_option"
                android:background="@drawable/bg_guided_preference_input"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:hint="@string/guided_preference_other_input_hint"
                android:maxLines="1"
                android:minLines="1"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:inputType="textCapSentences"
                android:windowSoftInputMode="adjustResize"
                android:textCursorDrawable="@drawable/shape_guided_preference_input_cursor"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <View
        android:id="@+id/option_divider"
        android:background="@color/oui_dark_basic_line_1"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
</LinearLayout>
