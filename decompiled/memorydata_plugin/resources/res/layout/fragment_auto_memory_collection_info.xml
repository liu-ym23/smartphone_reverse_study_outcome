<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_gravity="top"
        android:id="@+id/cut_off"
        android:background="@color/oui_basic_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="96dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.obric.oui.titlebar.OFloatingTitleBar
            android:layout_gravity="top"
            android:id="@+id/title_bar"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:oFloatingTitleBar_enableFloatingTransition="true"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/content_scroll"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/content_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/oui_text_3"
                    android:id="@+id/desc_label"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/memory_create_memory_task_section"
                    android:paddingStart="20dp"
                    android:paddingEnd="12dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"/>
                <FrameLayout
                    android:id="@+id/desc_input_layer"
                    android:layout_width="match_parent"
                    android:layout_height="282dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp">
                    <com.obric.oui.forms.OInputLayout
                        android:id="@+id/desc_input"
                        android:background="@drawable/bg_memory_card"
                        android:paddingTop="8dp"
                        android:paddingBottom="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        app:oinput_autoChangeWithLimit="false"
                        app:oinput_hint="@string/memory_create_memory_task_desc_hint"
                        app:oinput_limitCount="2000"
                        app:oinput_showClear="false"
                        app:oinput_showInputBackground="false"
                        app:oinput_showLabel="false"
                        app:oinput_showLimit="false"
                        app:oinput_type="1"/>
                    <TextView
                        android:textSize="10sp"
                        android:textColor="@color/oui_basic_text_3"
                        android:layout_gravity="end|bottom"
                        android:id="@+id/desc_input_counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:layout_marginEnd="12dp"/>
                    <com.obric.oui.status.OPageStatus
                        android:id="@+id/page_status_vertical_loading"
                        android:background="@drawable/bg_memory_card"
                        android:focusable="true"
                        android:visibility="gone"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:opagestatus_loadingResult="Loading..."
                        app:opagestatus_showLoading="true"
                        app:opagestatus_type="vertical_loading"/>
                </FrameLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <FrameLayout
            android:id="@+id/bottom_bar"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <LinearLayout
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:id="@+id/next_button_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.obric.oui.button.OButton
                    android:gravity="center"
                    android:id="@+id/next_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:textAllCaps="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    style="@style/OStyleV2.OButton.L.Standard.Primary"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:id="@+id/generate_loading_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp">
                <com.obric.oui.progress.ODownloadProgressView
                    android:id="@+id/generate_progress"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="6dp"
                    app:oui_progress_background_color="@color/oui_basic_line_2_dark_on_image"
                    app:oui_progressing_action_color="@color/oui_dark_basic_text_0"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/oui_dark_basic_text_0"
                    android:id="@+id/generate_loading_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAllCaps="false"/>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
