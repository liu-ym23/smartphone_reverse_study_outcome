<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.orecyclerview.widget.RecyclerView
        android:id="@+id/recycler_steps"
        android:paddingTop="96dp"
        android:paddingBottom="32dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.obric.oui.text.OTextView
        android:textColor="@color/oui_basic_text_3"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_empty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ai_proactive_agent_activity_empty"
        android:layout_marginHorizontal="32dp"
        style="@style/Label_M_Thin"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/run_controls"
        android:background="@android:color/transparent"
        android:paddingTop="8dp"
        android:paddingBottom="28dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="0dp"
        android:paddingHorizontal="16dp">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.obric.oui.button.OButton
                android:id="@+id/btn_stop"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="132dp"
                android:text="@string/ai_proactive_agent_run_stop"
                style="@style/OStyleV2.OButton.M.Standard.HighLight"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
