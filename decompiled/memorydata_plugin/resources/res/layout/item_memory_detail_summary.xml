<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_memory_card"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp">
    <com.obric.oui.text.OTextView
        android:theme="@style/MemoryDetailCardSummaryTip"
        android:id="@+id/summary_text_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/memory_card_memory_summary_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/failed_container"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/summary_text_tip">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_memory_large_model_failed"
            android:layout_marginVertical="1.5dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/oui_basic_text_1"
            android:id="@+id/tv_failed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.5"
            android:layout_marginStart="4dp"
            android:textFontWeight="500"/>
    </LinearLayout>
    <com.larus.business.markdown.impl.markwon.MarkdownTextView
        android:theme="@style/MemoryDetailCardSummaryText"
        android:textColor="@color/oui_basic_text_1"
        android:id="@+id/summary_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/summary_text_tip"/>
    <com.obric.memorydata.memory.ui.list.FlowLayout
        android:orientation="horizontal"
        android:id="@+id/tags_linear_layout"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        app:horizontalSpacing="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/summary_text"
        app:verticalSpacing="6dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
