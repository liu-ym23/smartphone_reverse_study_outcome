<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/auto_memory_pro_content"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/oui_basic_text_1"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/auto_memory_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:lineHeight="22dp"
        android:textFontWeight="400"
        app:layout_constraintEnd_toStartOf="@+id/auto_memory_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/oui_basic_text_3"
        android:gravity="end"
        android:id="@+id/auto_memory_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:lineHeight="16dp"
        android:textFontWeight="400"
        app:layout_constraintBaseline_toBaselineOf="@+id/auto_memory_title"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/oui_basic_text_3"
        android:ellipsize="end"
        android:id="@+id/auto_memory_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:lineSpacingMultiplier="1.2"
        android:textFontWeight="400"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/auto_memory_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
