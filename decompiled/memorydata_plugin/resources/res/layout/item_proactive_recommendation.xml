<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_ai_proactive_demo_history_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp">
    <FrameLayout
        android:id="@+id/ll_status_chip"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="26dp"
        android:foregroundGravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/img_status"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/oic_ai_color"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="24sp"
            android:textColor="@color/ai_proactive_demo_text_primary"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_status_emoji"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"/>
    </FrameLayout>
    <TextView
        android:id="@+id/tv_not_recommend"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <View
        android:id="@+id/basic_line"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <TextView
        android:id="@+id/tv_meta"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <com.larus.business.markdown.impl.markwon.MarkdownTextView
        android:textSize="16sp"
        android:textColor="@color/ai_proactive_demo_text_primary"
        android:id="@+id/tv_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/proactive_card_content_gap"
        android:includeFontPadding="false"
        android:lineSpacingExtra="6dp"
        android:textFontWeight="500"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_status_chip"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_artifacts"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/proactive_card_content_gap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_content"/>
    <LinearLayout
        android:gravity="start"
        android:orientation="vertical"
        android:id="@+id/ll_actions"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/proactive_card_content_gap"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_artifacts"/>
</androidx.constraintlayout.widget.ConstraintLayout>
