<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.orecyclerview.widget.RecyclerView
        android:id="@+id/rv_memory_list"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="always"/>
    <com.obric.oui.actionbar.v2.OBottomActionBarFloating
        android:layout_gravity="bottom"
        android:id="@+id/bottom_action_bar"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/OStyleV2.OBottomActionBar.Floating">
        <com.obric.oui.button.OButtonFloating
            android:layout_gravity="center"
            android:id="@+id/memory_delete"
            app:oui_widgetText="@string/memory_card_menu_delete_text"
            app:oui_widgetTextColor="@color/oui_dark_functional_red_6"
            style="@style/OStyleV2.OButtonFloating.M.PrimaryLight.Text"/>
    </com.obric.oui.actionbar.v2.OBottomActionBarFloating>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/empty_view"
        android:paddingTop="96dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.obric.oui.status.OPageStatus
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:opagestatus_message="@string/memory_not_has_memory_content_subtitle"
            app:opagestatus_title="@string/memory_not_has_memory_content"
            app:opagestatus_type="status_content"/>
    </LinearLayout>
    <View
        android:layout_gravity="top"
        android:id="@+id/cut_off"
        android:background="@color/oui_bg_base_1"
        android:layout_width="match_parent"
        android:layout_height="96dp"/>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/normal_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_enableFloatingTransition="true"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</FrameLayout>
