<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/oui_basic_bg_base_1"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.obric.oui.bouncelayout.ONestedScrollView
        android:id="@+id/scroll_container"
        android:paddingBottom="@dimen/oui_h_title_bar_window"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="always">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToOutline="true">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/iv_illustration"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_move_data"/>
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/oui_basic_text_1"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/memory_data_migration_page_title"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/oui_basic_text_2"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/memory_data_migration_page_subtitle"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp">
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/btn_export"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_top"
                    app:ocardlistitem_cardType="type_large"
                    app:ocardlistitem_defaultTailIcon="tail_arrow"
                    app:ocardlistitem_icon="@drawable/ic_export_data"
                    app:ocardlistitem_showIcon="true"
                    app:ocardlistitem_showSubTitle="true"
                    app:ocardlistitem_showTailIcon="true"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_subTitle="@string/memory_data_migration_export_subtitle"
                    app:ocardlistitem_title="@string/memory_data_migration_export_title"/>
                <com.obric.oui.lisitem.OCardListItem
                    android:id="@+id/btn_import"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:ocardlistitem_cardPosition="position_bottom"
                    app:ocardlistitem_cardType="type_large"
                    app:ocardlistitem_defaultTailIcon="tail_arrow"
                    app:ocardlistitem_icon="@drawable/ic_import_data"
                    app:ocardlistitem_showIcon="true"
                    app:ocardlistitem_showSubTitle="true"
                    app:ocardlistitem_showTailIcon="true"
                    app:ocardlistitem_showTitle="true"
                    app:ocardlistitem_subTitle="@string/memory_data_migration_import_subtitle"
                    app:ocardlistitem_title="@string/memory_data_migration_import_title"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/oui_basic_text_3"
                android:id="@+id/tv_instruction_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="@string/memory_data_migration_instruction_title"
                android:layout_marginHorizontal="32dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_instruction_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="32dp">
                <LinearLayout
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/oui_basic_text_3"
                        android:layout_width="16dp"
                        android:layout_height="wrap_content"
                        android:text="1."/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/oui_basic_text_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/memory_data_migration_instruction_item_1"
                        android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/oui_basic_text_3"
                        android:layout_width="16dp"
                        android:layout_height="wrap_content"
                        android:text="2."/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/oui_basic_text_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/memory_data_migration_instruction_item_2"
                        android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/oui_basic_text_3"
                        android:layout_width="16dp"
                        android:layout_height="wrap_content"
                        android:text="3."/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/oui_basic_text_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/memory_data_migration_instruction_item_3"
                        android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/oui_basic_text_3"
                        android:layout_width="16dp"
                        android:layout_height="wrap_content"
                        android:text="4."/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/oui_basic_text_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/memory_data_migration_instruction_item_4"
                        android:layout_weight="1"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.obric.oui.bouncelayout.ONestedScrollView>
    <com.obric.oui.titlebar.OFloatingTitleBar
        android:id="@+id/view_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:oFloatingTitleBar_maskBlurRadius="8"
        app:oFloatingTitleBar_statusBarImmersion="true"/>
</FrameLayout>
