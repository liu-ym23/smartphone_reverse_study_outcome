<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@null"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@null"
    android:elevation="0dp"
    android:stateListAnimator="@null">
    <View
        android:id="@+id/step_connector_top"
        android:background="@color/oui_basic_line_2"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_marginBottom="2dp"
        android:layout_marginStart="27.5dp"
        app:layout_constraintBottom_toTopOf="@+id/step_marker_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/step_connector_bottom"
        android:background="@color/oui_basic_line_2"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_marginStart="27.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/step_marker_container"/>
    <FrameLayout
        android:id="@+id/step_marker_container"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="16dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_step_marker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:importantForAccessibility="no"/>
        <com.obric.oui.progress.ODownloadProgressView
            android:id="@+id/progress_step_marker"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            app:oui_progress_view_size="small"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/step_content"
        android:paddingBottom="12dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.obric.oui.lisitem.OListItemGeneral
            android:id="@+id/step_header"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="@null"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            app:oui_list_item_show_background="false"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/artifact_reference_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/mobile_child_container"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ai_proactive_agent_secondary_list_parent_gap"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
