<?xml version="1.0" encoding="utf-8"?>
<com.mcxtzhang.swipemenulib.SwipeMenuLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipe_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="2dp">
    <LinearLayout
        android:id="@+id/card_wrapper"
        android:background="@drawable/bg_recommend_memory_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ViewStub
            android:id="@+id/card_content_vs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">
        <FrameLayout
            android:layout_gravity="start|center_vertical"
            android:id="@+id/delete_memory"
            android:background="@drawable/bg_recommend_delete_icon"
            android:layout_width="65dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp">
            <ImageView
                android:layout_gravity="center"
                android:background="@drawable/bg_recommend_delete_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_memory_list_menu_delete"/>
        </FrameLayout>
    </LinearLayout>
</com.mcxtzhang.swipemenulib.SwipeMenuLayout>
