<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/calendar_bar_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:layout_constraintTop_toBottomOf="@+id/title_bar_container">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/memory_calendar_week_day"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginLeft="24px"
        android:layout_marginRight="24px"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:text="@string/memory_calendar_week_monday"
            style="@style/MemoryCalendarWeekDayText"/>
        <TextView
            android:text="@string/memory_calendar_week_tuesday"
            style="@style/MemoryCalendarWeekDayText"/>
        <TextView
            android:text="@string/memory_calendar_week_wednesday"
            style="@style/MemoryCalendarWeekDayText"/>
        <TextView
            android:text="@string/memory_calendar_week_thursday"
            style="@style/MemoryCalendarWeekDayText"/>
        <TextView
            android:text="@string/memory_calendar_week_friday"
            style="@style/MemoryCalendarWeekDayText"/>
        <TextView
            android:text="@string/memory_calendar_week_saturday"
            style="@style/MemoryCalendarWeekDayText"/>
        <TextView
            android:text="@string/memory_calendar_week_sunday"
            style="@style/MemoryCalendarWeekDayText"/>
    </LinearLayout>
    <com.obric.oui.orecyclerview.widget.RecyclerView
        android:id="@+id/memory_calendar_top_date_list"
        android:layout_width="match_parent"
        android:layout_height="168px"
        android:layout_marginTop="4dp"
        android:overScrollMode="always"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/memory_calendar_week_day"/>
    <View
        android:id="@+id/memory_calendar_top_date_list_disable_mask"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/memory_calendar_top_date_list"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/memory_calendar_top_date_list"/>
</androidx.constraintlayout.widget.ConstraintLayout>
