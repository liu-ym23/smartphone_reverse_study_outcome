    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ai_proactive_demo_action_bg"/>
            <corners android:radius="20dp"/>
            <stroke
                android:width="1dp"
                android:color="#00000000"/>
        </shape>
    </item>
</selector>
